#!/usr/bin/env bash
# pre-commit: the same crypto-key scan as pre-push, on the staged diff, so a
# key is caught before it is in a commit at all (removing it from a commit
# means rewriting history; removing it from the index is `git reset <file>`).
# Bypass for a confirmed false positive: git commit --no-verify
set -u
# The committing worktree's scanner, and this hook's own copy when it differs (core.hooksPath may point every worktree at
# one checkout's .githooks; a refusal by either refuses), as .githooks/pre-push does.
here="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
root="$(git rev-parse --show-toplevel)"
scanners=()
if [ -f "$root/.githooks/scan-crypto-keys.py" ]; then scanners+=("$root/.githooks/scan-crypto-keys.py"); fi
if [ -f "$here/scan-crypto-keys.py" ] && { [ "${#scanners[@]}" -eq 0 ] || ! cmp -s "$here/scan-crypto-keys.py" "${scanners[0]}"; }; then
  scanners+=("$here/scan-crypto-keys.py")
fi
# no scanner at all is a refusal, never a silent pass (the hook used to call its own copy unconditionally)
if [ "${#scanners[@]}" -eq 0 ]; then
  echo "pre-commit: no crypto-key scanner found (neither $root/.githooks/scan-crypto-keys.py nor $here/scan-crypto-keys.py): COMMIT REFUSED" >&2
  exit 1
fi
for sc in "${scanners[@]}"; do
  python3 "$sc" --staged || {
    echo "pre-commit: COMMIT REFUSED (confirmed false positive: git commit --no-verify)" >&2
    exit 1
  }
done
exit 0
