#!/usr/bin/env bash
# pre-push: refuse to push commits that carry cryptocurrency private keys or
# other secrets. This is the actual block - GitHub's free-plan push protection
# only knows provider tokens (AWS, Stripe, GitHub...), never a raw Ethereum or
# Bitcoin key, and the CI scan runs AFTER the push, when the key is already
# public. Installed by `npm install` (package.json "prepare" sets
# core.hooksPath=.githooks) or by hand: git config core.hooksPath .githooks
#
# Every commit in every pushed range is scanned (a key added in one commit and
# removed in the next is still in history). Two scanners:
#   1. scan-crypto-keys.py  - always; WIF/xprv/BIP39 (checksum-verified),
#                             labelled/known Ethereum keys, keystore JSON
#   2. gitleaks (if found)  - provider tokens + .gitleaks.toml crypto rules
# Confirmed false positive? git push --no-verify (and say so in the commit).
#
# WHICH config and scanner (fixed 2026-09-25): core.hooksPath may be an ABSOLUTE path into one checkout's .githooks, so
# every linked worktree runs THIS file, whatever branch that checkout holds. The config that governs a push is therefore
# taken from the commit being pushed (<sha>:.gitleaks.toml, exactly the file CI scans with), then the pushing worktree's
# file, and only then the one beside this hook; each push says which it used. A pushed config that gitleaks cannot load
# is never a way around the scan: the range is scanned again with the config beside this hook. The crypto-key scanner is
# the pushing worktree's .githooks/scan-crypto-keys.py, AND this hook's own copy when the two differ (a refusal by either
# refuses). Regression checks: .githooks/gitleaks-selftest.py (the config finds generated keys) and
# .githooks/hook-selftest.py (a real push from a linked worktree is judged by the pushed commit's config).
set -u
remote="$1"
here="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
root="$(git rev-parse --show-toplevel)"
z40=0000000000000000000000000000000000000000

gitleaks_bin=""
for c in "${GITLEAKS:-}" "$(command -v gitleaks 2>/dev/null || true)" "$HOME/.local/bin/gitleaks"; do
  if [ -n "$c" ] && [ -x "$c" ]; then gitleaks_bin="$c"; break; fi
done
# the crypto-key scanners: the pushing worktree's, and this hook's own when it differs (the stricter union)
scanners=()
if [ -f "$root/.githooks/scan-crypto-keys.py" ]; then scanners+=("$root/.githooks/scan-crypto-keys.py"); fi
if [ -f "$here/scan-crypto-keys.py" ] && { [ "${#scanners[@]}" -eq 0 ] || ! cmp -s "$here/scan-crypto-keys.py" "${scanners[0]}"; }; then
  scanners+=("$here/scan-crypto-keys.py")
fi
hook_cfg=""
if [ -f "$here/../.gitleaks.toml" ]; then hook_cfg="$(cd "$here/.." && pwd)/.gitleaks.toml"; fi
# every temporary file is made HERE, in this shell (never in a subshell, whose additions the EXIT cleanup would not see),
# and named pre-push.* so a leftover would be recognisable
tmpfiles=()
cleanup() { if [ "${#tmpfiles[@]}" -gt 0 ]; then rm -f "${tmpfiles[@]}"; fi; }
trap cleanup EXIT
newtmp() { local f; f="$(mktemp "${TMPDIR:-/tmp}/pre-push.XXXXXXXX")" || return 1; tmpfiles+=("$f"); tmp_made="$f"; }
# config_for <pushed sha>: sets cfg_path and cfg_what. Called directly, NOT in $(...) or <(...): a subshell's tmpfiles+=
# would be lost and its temporary copy of the pushed config left behind.
cfg_path=""; cfg_what=""; tmp_made=""
config_for() {
  newtmp || { cfg_path="$hook_cfg"; cfg_what="the hook's own .gitleaks.toml (no temporary file could be made)"; return; }
  if git show "$1:.gitleaks.toml" >"$tmp_made" 2>/dev/null && [ -s "$tmp_made" ]; then cfg_path="$tmp_made"; cfg_what="the pushed commit's .gitleaks.toml (${1:0:12})"; return; fi
  if [ -f "$root/.gitleaks.toml" ]; then cfg_path="$root/.gitleaks.toml"; cfg_what="the worktree's .gitleaks.toml ($root)"; return; fi
  if [ -n "$hook_cfg" ]; then cfg_path="$hook_cfg"; cfg_what="the hook's own .gitleaks.toml ($hook_cfg)"; return; fi
  cfg_path=""; cfg_what="no .gitleaks.toml (gitleaks default rules only)"
}
# run_gitleaks <config path or empty> <range> <log>: 0 clean, 1 leaks found, 2 could not run
run_gitleaks() {
  local c=() rc
  if [ -n "$1" ]; then c=(--config "$1"); fi
  if "$gitleaks_bin" git "$root" "${c[@]}" --log-opts="$2" --no-banner --redact=60 --exit-code 1 -v >"$3" 2>&1; then return 0; fi
  if grep -q 'leaks found' "$3"; then return 1; fi
  return 2
}

fail=0
scanned=0
while read -r local_ref local_sha remote_ref remote_sha; do
  if [ -z "${local_sha:-}" ] || [ "$local_sha" = "$z40" ]; then continue; fi   # nothing / deleting a remote ref
  if [ "$remote_sha" = "$z40" ] || ! git cat-file -e "$remote_sha^{commit}" 2>/dev/null; then
    range="$local_sha --not --remotes=$remote"      # new branch or unknown base: everything not already on the remote
  else
    range="$remote_sha..$local_sha"
  fi
  scanned=$((scanned + 1))

  # no scanner at all is a refusal, never a silent pass (the hook used to call its own copy unconditionally)
  if [ "${#scanners[@]}" -eq 0 ]; then
    echo "pre-push: no crypto-key scanner found (neither $root/.githooks/scan-crypto-keys.py nor $here/scan-crypto-keys.py): the push cannot be checked" >&2
    fail=1
  fi
  for sc in "${scanners[@]}"; do
    # shellcheck disable=SC2086  # $range is intentionally word-split
    if ! python3 "$sc" --range $range; then fail=1; fi
  done

  if [ -n "$gitleaks_bin" ]; then
    config_for "$local_sha"
    echo "pre-push: gitleaks config: $cfg_what" >&2
    if newtmp; then log="$tmp_made"; else log=/dev/null; fi
    run_gitleaks "$cfg_path" "$range" "$log"; rc=$?
    if [ "$rc" -eq 2 ] && [ -n "$hook_cfg" ] && [ "$cfg_path" != "$hook_cfg" ]; then
      { echo "pre-push: that config did not load (CI will fail on it too):"; tail -n 2 "$log"; echo "pre-push: scanning again with the hook's own config ($hook_cfg)"; } >&2
      run_gitleaks "$hook_cfg" "$range" "$log"; rc=$?
    fi
    if [ "$rc" -eq 1 ]; then
      fail=1
      { echo; echo "gitleaks: secrets in the commits being pushed ($range):"; grep -E '^(Finding|Secret|RuleID|File|Line|Commit):' "$log"; } >&2
    elif [ "$rc" -eq 2 ]; then
      { echo "pre-push: gitleaks could not run - provider-token rules skipped (the crypto-key scan still ran):"; tail -n 3 "$log"; } >&2
    fi
  fi
done

if [ "$scanned" -gt 0 ] && [ -z "$gitleaks_bin" ]; then
  { echo "pre-push: gitleaks not installed - provider-token rules skipped (the crypto-key scan still ran)."
    echo "          install: https://github.com/gitleaks/gitleaks/releases -> ~/.local/bin/gitleaks"; } >&2
fi
if [ "$fail" -ne 0 ]; then
  { echo; echo "pre-push: PUSH REFUSED - remove the secret from history before pushing."
    echo "          (confirmed false positive: git push --no-verify)"; } >&2
  exit 1
fi
exit 0
