.env
*.log
node_modules/
__pycache__/
*.pyc
# root Cloud Provider-config.yml exists only in release-tag commits (generated from
# enclaves/<flavor>/Cloud Provider-config.yml by the release workflows); never commit
# a stray local copy to main
/Cloud Provider-config.yml
# in-tree wasm app crates: build artifacts + cargo-component's generated bindings
wasm/apps/*/target/
wasm/apps/*/src/bindings.rs
wasm/apps/*/assets/
