node_modules/
.env
*.log
node_modules/
__pycache__/
*.pyc
# root tinfoil-config.yml exists only in release-tag commits (generated from
# enclaves/<flavor>/tinfoil-config.yml by the release workflows); never commit
# a stray local copy to main
/tinfoil-config.yml
# in-tree wasm app crates: build artifacts + cargo-component's generated bindings
wasm/apps/*/target/
wasm/apps/*/src/bindings.rs
wasm/apps/*/assets/
# but keep the small embedded config (source, not a fetched artifact)
!wasm/apps/*/assets/app-config.json
# wasi-nn host shims: sources are tracked, the .so is built into the
# Wasmtime Toolchain image (never committed)
wasm/*-shim/*.so
# enclave CLI: bundled single-file build (cli/install.sh or npm run build)
cli/dist/
# SET-relaxed wasm-tools for the upload gateway (scripts/build-wasm-tools-set.sh
# rebuilds it reproducibly from a pinned tag + wasm/wasmparser-set-relax.patch)
/dist/
# Foundry build artifacts (test-only toolchain; forge-std under
# contracts/foundry/lib IS committed - vendored, no submodules)
contracts/foundry/out/
contracts/foundry/cache/
# site: bundled output (built by scripts/build-site.mjs; deploy.sh ships it)
site/dist/
# privy bundle build workspace (scripts/build-privy.mjs; its output site/privy/ IS committed)
scripts/.privy-build/
# same-origin vendor bundles build workspace (scripts/build-vendor.mjs; its output site/vendor/ IS committed)
scripts/.vendor-build/
# rolling archive of hashed site chunks (deploy.sh ships the union so cached
# entries keep resolving their chunks across deploys)
site/.chunk-archive/
# playwright artifacts + per-run stack state
e2e/node_modules/
e2e/.data/
e2e/.stack.json
e2e/test-results/
e2e/playwright-report/

# Key material never belongs in this tree. Nothing tracked matches these, and
# the one file the docs tell you to create with a raw private key in it
# (metal/config.json — registryKey, fleetSecret, tunnelToken) is already
# ignored by metal/.gitignore. This is the belt to that pair of braces: a
# committed key cannot be un-committed, only rotated.
*.key
*.pem
*.pkcs8
*.p12
# ...but AMD's PUBLIC per-product root chains are test DATA, not key material:
# snp-ark-pin.test.mjs verifies our pinned ARK against them, so a runner that
# cannot see them fails a test that passes on every developer's machine.
!test/fixtures/amd/*.pem
*.pfx

# playwright-cli session artifacts (snapshots, traces); .playwright/ config IS committed
.playwright-cli/

# impeccable live-mode runtime state; only the config and design sidecar are tracked
.impeccable/**
!.impeccable/design.json
!.impeccable/live/
!.impeccable/live/config.json
