node_modules/
.env
*.log
node_modules/
__pycache__/
*.pyc
# root tinfoil-config.yml exists only in release-tag commits (generated from
# enclaves/<flavor>/tinfoil-config.yml by the release workflows); never commit
# a stray local copy to main
/tinfoil-config.yml
# in-tree wasm app crates: build artifacts + cargo-component's generated bindings
wasm/apps/*/target/
wasm/apps/*/src/bindings.rs
wasm/apps/*/assets/
# but keep the small embedded config (source, not a fetched artifact)
!wasm/apps/*/assets/app-config.json
# wasi-nn host shims: sources are tracked, the .so is built into the
# Wasmtime Toolchain image (never committed)
wasm/*-shim/*.so
# enclave CLI: bundled single-file build (cli/install.sh or npm run build)
cli/dist/
# SET-relaxed wasm-tools for the upload gateway (scripts/build-wasm-tools-set.sh
# rebuilds it reproducibly from a pinned tag + wasm/wasmparser-set-relax.patch)
/dist/
# Foundry build artifacts (test-only toolchain; forge-std under
# contracts/foundry/lib IS committed - vendored, no submodules)
contracts/foundry/out/
contracts/foundry/cache/
# site: bundled output (built by scripts/build-site.mjs; deploy.sh ships it)
site/dist/
# privy bundle build workspace (scripts/build-privy.mjs; its output site/privy/ IS committed)
scripts/.privy-build/
# same-origin vendor bundles build workspace (scripts/build-vendor.mjs; its output site/vendor/ IS committed)
scripts/.vendor-build/
# rolling archive of hashed site chunks (deploy.sh ships the union so cached
# entries keep resolving their chunks across deploys)
site/.chunk-archive/
# playwright artifacts + per-run stack state
e2e/node_modules/
e2e/.data/
e2e/.stack.json
e2e/test-results/
e2e/playwright-report/

# Key material never belongs in this tree. Nothing tracked matches these, and
# the one file the docs tell you to create with a raw private key in it
# (metal/config.json — registryKey, fleetSecret, tunnelToken) is already
# ignored by metal/.gitignore. This is the belt to that pair of braces: a
# committed key cannot be un-committed, only rotated.
*.key
*.pem
*.pkcs8
*.p12
# ...but AMD's PUBLIC per-product root chains are test DATA, not key material:
# snp-ark-pin.test.mjs verifies our pinned ARK against them, so a runner that
# cannot see them fails a test that passes on every developer's machine.
!test/fixtures/amd/*.pem
# ...and AMD's PUBLIC fTPM EK root chain is the relay's pinned trust anchor for
# Windows VBS nodes (vbs-policy.mjs default METAL_VBS_EK_ROOTS): a runtime fixture.
!relay/fixtures/tpm-roots.pem
*.pfx

# playwright-cli session artifacts (snapshots, traces); .playwright/ config IS committed
.playwright-cli/

# impeccable live-mode runtime state; only the config and design sidecar are tracked
.impeccable/**
!.impeccable/design.json
!.impeccable/live/
!.impeccable/live/config.json

# The shielded backend is compiled from source during the image build
# (metal/build-image.mjs); a committed binary is exactly what that replaced.
metal/shielded-overlay/*.so
wasm/ggml-shielded/*.so
metal/.update-state.json

# gemma vocab trim (2026-09-14): corpus, venv and the trimmed model are not repo content
/trim/corpus/
/trim/.venv/
/trim/logs/
/trim/download.log
/trim/artifacts/*.npy
/trim/artifacts/token_frequency.tsv
/trim/artifacts/keep_reasons.tsv
/trim/artifacts/tokenizer.model.candidate
/gemma-4-E2B-it-en-code/
/trim/artifacts/id_map_old_to_new.json
/trim/artifacts/*.tsv.gz

# the in-enclave app runtime's build trees: cargo target dirs, hundreds of MB of
# rlibs (including a rebuilt libcore for the no_std enclave build)
windows/enclave-rt/target/
windows/enclave-rt/precompile/target/
windows/enclave-rt/*.lib
windows/enclave-rt/*.exe
windows/enclave-rt/*.cwasm
windows/enclave-app-hello/target/

# isolation: the monitor is built by isolation/m3/build-domain.sh into a temporary tree, and a bare
# `go build` in monitor/ leaves this behind. It is reproducible output: two builds with the flags the
# build script uses (-trimpath -buildvcs=false -ldflags='-s -w -buildid=') are byte-identical, which
# test-m3.sh check 0 also asserts for the image as a whole. Narrow on purpose - the .go sources beside it
# are tracked.
/isolation/m3/monitor/monitor

# --- shared-checkout cleanup, 2026-09-23 (coordinator: isolation session) ------------------------------
# Every rule here is narrow and names a class already established above, or a class the repo never tracks:
# models, dependency wheels, build backups and regenerable outputs. Nothing here hides source.

# The -104k trim variant of the model already ignored above. model.safetensors alone is 6.9 GB.
/gemma-4-E2B-it-en-code-104k/

# Dependency wheels dropped at the repo root by pip. Third-party, reproducible from the package index.
/*.whl

# Keepset builds for other feature thresholds, same file classes as /trim/artifacts/* above:
# build_keepset_f.py regenerates all of them. keepset_summary.json is ~1 KB and IS tracked, because it is
# the compact record of what a run produced.
/trim/artifacts-f*/keep_ids.npy
/trim/artifacts-f*/keep_reasons.tsv
/trim/artifacts-f*/id_map_old_to_new.json

# A backup of metal's build output. metal/dist itself is untracked build output (0 tracked files), so a
# dated copy of it is not repo content either; 279 MB of initramfs plus a kernel.
/metal/dist.backup-*/

# isolation/m4 builds the contract's bundle tool into the tree; it is reproducible output
/isolation/m4/.bundle

# the release lab's per-run pins (isolation/m2/lab-release/run-lab.sh): generated, never committed
isolation/m2/release/labpins/
