+// Native control routes (network/native-control-routes.mjs): the real service-index reader over two in-process RPC stand-ins
+// that agree (or do not), the strict platform host policy rule, the failure-domain exclusion, and real TLS handshakes under a
+// throwaway native CA (openssl, minted per run). The probe's socket is routed to loopback servers by address; the verifier,
+// SNI and hostname check are Node's own.
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import fs from 'node:fs';
+import os from 'node:os';
+import path from 'node:path';
+import net from 'node:net';
+import tls from 'node:tls';
+import { execFileSync } from 'node:child_process';
+import { keccak256 } from 'viem';
+import { SERVICE_KINDS, KIND_NAMES, AD_VERSION, readServiceIndex } from '../network/service-index.mjs';
+import { discoverControlRoutes, cachedControlRoutes, controlEndpointAddress, controlRoutesFromEnv, proveControlEndpoint, CONTROL_NAMES } from '../network/native-control-routes.mjs';
+
+const API = 'api.enclavehost.eth', MCP = 'mcp.enclavehost.eth';
+const DO = ['134.199.235.187', '134.209.248.172', '165.245.191.129', '146.190.246.39'];
+const ZERO32 = '0x' + '0'.repeat(64), ZERO_ADDR = '0x' + '0'.repeat(40);
+const op = (n) => '0x' + n.toString(16).padStart(40, '0');
+const stamp = (ms) => new Date(ms).toISOString().replace(/[-:T]/g, '').slice(0, 14) + 'Z';
+
+// ---- a throwaway native CA, a rogue CA and their leaves ----------------------------------------------------------------
+const dir = fs.mkdtempSync(path.join(os.tmpdir(), 'native-control-'));
