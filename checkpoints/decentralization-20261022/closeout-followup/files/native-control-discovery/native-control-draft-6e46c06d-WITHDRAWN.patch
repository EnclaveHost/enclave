--- /dev/null
+++ b/network/native-control-routes.mjs
@@ -0,0 +1,181 @@
+// Native CONTROL routes (relay/native-discovery.mjs): where api.enclavehost.eth and mcp.enclavehost.eth are served, found the
+// way designated lease relays are found (network/lease-relay-discovery.mjs), with no fixed fleet address and no fallback.
+//
+// What an endpoint must prove before its address is served for a control name (each step refuses that endpoint only):
+//   1. it is ADVERTISED: a `native-control` ad in the pinned EnclaveServiceIndex, read at ONE block on which two of the
+//      operator's RPCs agree (readServiceIndex) - an untrusted candidate, nothing more. Operators the configuration names
+//      (`operators`) are read directly in the same snapshot, so listing spam cannot hide them, and are probed first;
+//   2. when the platform host policy is on, its operator is EXPLICITLY ADMITTED by it now (judgeRelayOperators: admit ===
+//      true, which includes the deliberate "not-activated" admit before the administrator anchors a policy; a ban, an
+//      allowlist miss, "behind", an unreadable authority, a missing decision or a throwing decider all refuse). An admin
+//      ban withdraws the operator's routes at the next refresh (routes live at most `routeTtlMs`);
+//   3. its endpoint is exactly `https://<public IPv4>/` (port 443, the port the native route names) and OUTSIDE every
+//      failure domain the configuration names (the DigitalOcean transport fleet): excluded, and named in the evidence;
+//   4. it AUTHENTICATES AS THE NAME: a TLS handshake to <address>:443 with SNI <name>, verified by Node/OpenSSL's own
+//      verifier against the native CA only (the CA whose fingerprint native discovery already publishes) with the
+//      default hostname check. The certificate is the CA holder's authorization of that key for that name; the handshake
+//      proves the endpoint holds the key. No HTTP request is sent and nothing the endpoint says is trusted.
+// A route lives no longer than the ad, the endpoint's certificate and `routeTtlMs` (default 60 s, as an app route record).
+// A name with no endpoint passing every step has NO route: native discovery answers "unavailable", never another address.
+import tls from "node:tls";
+import { X509Certificate } from "node:crypto";
+import { readServiceIndex, publicIPv4, validateIndexPin } from "./service-index.mjs";
+import { classifyEndpoint, judgeRelayOperators, relayPolicyDecider } from "./lease-relay-discovery.mjs";
+import { rpcPeers } from "./policy-carriers.mjs";
+import { createHostPolicyRuntime, resolveHostPolicyConfig } from "./host-policy-runtime.mjs";
+import { PRODUCTION_BOOK } from "./platform-host-policy-config.mjs";
+
+export const NATIVE_ROOT = "enclavehost.eth";
+export const CONTROL_NAMES = Object.freeze(["api", "mcp"].map((s) => `${s}.${NATIVE_ROOT}`));
+export const CONTROL_KIND = "native-control";
+const lc = (s) => String(s || "").toLowerCase();
+
+/** An advertised control endpoint -> its IPv4 address: exactly https://<public IPv4>/ (port 443, no path). Throws otherwise. */
+export function controlEndpointAddress(endpoint) {
+  let u; try { u = new URL(endpoint); } catch { throw new Error("not a URL"); }
+  if (u.protocol !== "https:") throw new Error("a native control endpoint must be https");
+  if (u.port !== "" && u.port !== "443") throw new Error("a native control endpoint must be port 443");
+  if (u.username || u.password || u.search || u.hash || u.pathname !== "/") throw new Error("a native control endpoint is a bare https origin");
+  if (!publicIPv4(u.hostname)) throw new Error("a native control endpoint must be a public IPv4 literal");
+  return u.hostname;
+}
+
+/**
+ * TLS proof that `address`:443 holds a certificate for `name` issued under `caPem` (and only it). -> { validTo } (ms).
+ * connect: tls.connect's signature (tests route the socket to a loopback server; the verifier is unchanged).
+ */
+export function proveControlEndpoint({ address, name, caPem, timeoutMs = 4000, connect = tls.connect }) {
+  return new Promise((resolve, reject) => {
+    let done = false, socket = null;
+    const finish = (err, v) => { if (done) return; done = true; clearTimeout(timer); socket?.destroy(); if (err) reject(err); else resolve(v); };
+    const timer = setTimeout(() => finish(new Error(`TLS proof timed out after ${timeoutMs} ms`)), timeoutMs);
+    timer.unref?.();
+    try {
+      socket = connect({ host: address, port: 443, servername: name, ca: caPem, rejectUnauthorized: true, ALPNProtocols: ["http/1.1"] });
+    } catch (e) { return finish(e); }
+    socket.once("secureConnect", () => {
+      if (!socket.authorized) return finish(new Error(`certificate not authorized: ${socket.authorizationError || "unknown"}`));
+      const raw = socket.getPeerCertificate()?.raw;
+      if (!raw) return finish(new Error("no peer certificate"));
+      const validTo = Date.parse(new X509Certificate(raw).validTo);
+      if (!Number.isFinite(validTo)) return finish(new Error("peer certificate has no valid expiry"));
+      finish(null, { validTo });
+    });
+    socket.once("error", (e) => finish(new Error(String(e?.message || e).slice(0, 200))));
+    socket.once("close", () => finish(new Error("connection closed before the TLS handshake finished")));
+  });
+}
+
+/**
+ * -> { routes: { [name]: { addresses, expiresAt } }, verified: [{ name, address, operator, expiresAt }], excluded, rejected,
+ *      refusedByPolicy, policy, index: { status, blockNumber, blockHash } }.
+ * decide: an operator decider (lease-relay-discovery.mjs relayPolicyDecider), judged STRICTLY; null only when the platform host
+ * policy is explicitly off. Throws when the index cannot be read by an agreeing quorum (no route is then served at all).
+ */
+export async function discoverControlRoutes({ peers, clients, indexPin, caPem, decide, operators = [], failureDomains = [], names = CONTROL_NAMES,
+  resolve = async () => { throw new Error("native control endpoints are IPv4 literals"); }, prove = proveControlEndpoint, connect, probeTimeoutMs = 4000,
+  maxProbes = 32, maxAddresses = 8, routeTtlMs = 60_000, now = Date.now, readOptions = {}, readIndex = readServiceIndex }) {
+  if (decide === undefined) throw new Error("native control routes: a platform host policy decider is required (null only when the policy is explicitly off)");
+  if (typeof caPem !== "string" || !caPem.includes("BEGIN CERTIFICATE")) throw new Error("native control routes: the native CA certificate is required");
+  const read = await readIndex({ peers, clients, pin: indexPin, kinds: [CONTROL_KIND], lookups: operators.map((operator) => ({ operator })), ...readOptions });
+  // named operators first (read directly, so spam cannot push them out of the probe budget), then the listing; an incomplete
+  // listing still yields valid candidates: each is proven on its own, and nothing here concludes anything from an absence
+  const seen = new Set(), candidates = [];
+  for (const c of [...(read.lookups || []).filter((l) => l.state === "listed").map((l) => l.candidate), ...(read.candidates || [])]) {
+    const key = `${lc(c.operator)}/${c.slot}`;
+    if (c.kindName === CONTROL_KIND && !seen.has(key)) { seen.add(key); candidates.push(c); }
+  }
+  const judged = decide ? await judgeRelayOperators(candidates.map((c) => c.operator), decide) : null;
+  const refusedByPolicy = [], excluded = [], rejected = [], probes = [];
+  for (const c of candidates) {
+    if (judged && !judged.admitted.has(lc(c.operator))) {
+      const r = judged.refused.find((x) => x.operator === lc(c.operator));
+      refusedByPolicy.push({ operator: lc(c.operator), slot: c.slot, status: r?.status || "undecided", reason: r?.reason || "no decision" }); continue;
+    }
+    for (const endpoint of c.endpoints) {
+      let address;
+      try { address = controlEndpointAddress(endpoint); } catch (e) { rejected.push({ endpoint, operator: lc(c.operator), reason: e.message }); continue; }
+      const k = await classifyEndpoint(endpoint, failureDomains, resolve);
+      if (k.excluded) { excluded.push({ endpoint, operator: lc(c.operator), domain: k.domain, reason: k.reason }); continue; }
+      for (const name of names) probes.push({ name, address, operator: lc(c.operator), adExpiresAt: c.expiresAt * 1000 });
+    }
+  }
+  const budget = probes.slice(0, maxProbes);
+  for (const p of probes.slice(maxProbes)) rejected.push({ endpoint: `https://${p.address}/`, operator: p.operator, name: p.name, reason: `probe budget (${maxProbes}) exhausted` });
+  const verified = [];
+  await Promise.all(budget.map(async (p) => {
+    try {
+      const { validTo } = await prove({ address: p.address, name: p.name, caPem, timeoutMs: probeTimeoutMs, ...(connect ? { connect } : {}) });
+      verified.push({ name: p.name, address: p.address, operator: p.operator, expiresAt: Math.min(p.adExpiresAt, validTo) });
+    } catch (e) { rejected.push({ endpoint: `https://${p.address}/`, operator: p.operator, name: p.name, reason: String(e.message).slice(0, 200) }); }
+  }));
+  const at = now(), routes = {};
+  for (const name of names) {
+    const ok = budget.map((p) => verified.find((v) => v.name === name && v.address === p.address && v.operator === p.operator))
+      .filter((v) => v && v.expiresAt > at);
+    const addresses = [...new Set(ok.map((v) => v.address))].slice(0, maxAddresses);
+    if (addresses.length) routes[name] = { addresses, expiresAt: Math.min(at + routeTtlMs, ...ok.filter((v) => addresses.includes(v.address)).map((v) => v.expiresAt)) };
+  }
+  return { routes, verified, excluded, rejected, refusedByPolicy, policy: !judged ? "not applied" : judged.unreadable ? "unreadable" : "applied",
+    index: { status: read.status, blockNumber: read.blockNumber, blockHash: read.blockHash } };
+}
+
+/**
+ * A single-flight cache of the control route map for native discovery: the map is reused until its earliest route expires
+ * (at most routeTtlMs), refreshed in the background after half of that, and a failed refresh is remembered for `retryMs` so
+ * a burst of requests cannot turn into a burst of chain reads and probes. No authority outlives a route's own expiry.
+ */
+export function cachedControlRoutes(discover, { retryMs = 10_000, log = () => {}, now = Date.now } = {}) {
+  let last = null, failed = null, inflight = null;
+  const refresh = () => {
+    if (!inflight) inflight = Promise.resolve().then(discover).then((r) => {
+      const at = now(), exp = Object.values(r.routes).map((x) => x.expiresAt);
+      last = { at, until: exp.length ? Math.min(...exp) : at + retryMs, map: { routes: r.routes } }; failed = null;
+      log(`[native-discovery] control routes at block ${r.index.blockNumber}: ${Object.entries(r.routes).map(([n, x]) => `${n}=${x.addresses.length}`).join(" ") || "none"} (policy ${r.policy}, ${r.excluded.length} excluded, ${r.rejected.length} rejected, ${r.refusedByPolicy.length} refused)`);
+      return last.map;
+    }, (e) => { failed = { at: now(), error: e }; log(`[native-discovery] control route discovery failed: ${String(e?.message || e).slice(0, 300)}`); throw e; })
+      .finally(() => { inflight = null; });
+    return inflight;
+  };
+  return async () => {
+    const t = now();
+    if (last && last.until > t) { if (t - last.at > (last.until - last.at) / 2) refresh().catch(() => {}); return last.map; }
+    if (failed && t - failed.at < retryMs && !inflight) throw failed.error;
+    return refresh();
+  };
+}
+
+const list = (v) => String(v || "").split(",").map((x) => x.trim()).filter(Boolean);
+/**
+ * The deployed discovery's control-route source, from its environment -> getControlRoutes() | null (not configured: every
+ * control name answers unavailable; there is no fleet default).
+ *   NATIVE_CONTROL_SERVICE_INDEX  <index address>@<runtime code hash> (the pinned EnclaveServiceIndex on Base 8453)
+ *   NATIVE_CONTROL_RPCS           two or more Base RPC URLs of distinct providers (the index read's agreeing quorum)
+ *   NATIVE_CONTROL_EXCLUDE        REQUIRED failure domain: IPv4 addresses and DNS names never served (the DigitalOcean fleet)
+ *   NATIVE_CONTROL_OPERATORS      optional operator addresses read directly (probed first; listing spam cannot hide them)
+ *   ENCLAVE_PLATFORM_HOST_POLICY* the unchanged platform host policy resolution (production by default; "off" only explicitly)
+ */
+export function controlRoutesFromEnv(env, { caPem, log = () => {}, fetch = globalThis.fetch, now = Date.now } = {}) {
+  const raw = String(env.NATIVE_CONTROL_SERVICE_INDEX || "").trim();
+  if (!raw) { log("[native-discovery] NATIVE_CONTROL_SERVICE_INDEX is not set: control names answer unavailable (no fleet default)"); return null; }
+  const m = /^(0x[0-9a-fA-F]{40})@(0x[0-9a-fA-F]{64})$/.exec(raw);
+  if (!m) throw new Error("NATIVE_CONTROL_SERVICE_INDEX must be <index address>@<runtime code hash> (the pinned EnclaveServiceIndex)");
+  const indexPin = validateIndexPin({ chainId: 8453, address: m[1], codeHash: m[2].toLowerCase() });
+  const rpcs = list(env.NATIVE_CONTROL_RPCS);
+  if (rpcs.length < 2 || rpcs.length > 16) throw new Error("NATIVE_CONTROL_RPCS: two to sixteen Base RPC URLs of distinct providers");
+  const peers = rpcPeers(rpcs);
+  const exclude = list(env.NATIVE_CONTROL_EXCLUDE), addresses = [], names = [];
+  if (!exclude.length) throw new Error("NATIVE_CONTROL_EXCLUDE is required: the failure domain (the DigitalOcean fleet's addresses) control routes must never use");
+  for (const x of exclude) {
+    if (/^(\d{1,3}\.){3}\d{1,3}$/.test(x)) addresses.push(x);
+    else if (/^(?=.{1,253}$)([a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?\.)+[a-z][a-z0-9-]{0,62}$/i.test(x)) names.push(x.toLowerCase());
+    else throw new Error(`NATIVE_CONTROL_EXCLUDE: ${x.slice(0, 80)} is neither an IPv4 address nor a DNS name`);
+  }
+  const operators = list(env.NATIVE_CONTROL_OPERATORS);
+  if (operators.length > 32 || operators.some((o) => !/^0x[0-9a-fA-F]{40}$/.test(o))) throw new Error("NATIVE_CONTROL_OPERATORS: up to 32 operator addresses");
+  const runtime = createHostPolicyRuntime(resolveHostPolicyConfig({ env, chainId: 8453, book: PRODUCTION_BOOK }), { fetch, log });
+  if (!runtime) log("[native-discovery] platform host policy is EXPLICITLY OFF: control operators are not judged (not a production configuration)");
+  const decide = runtime ? relayPolicyDecider(runtime.gate) : null;
+  const failureDomains = [{ name: "excluded", addresses, names }];
+  return cachedControlRoutes(() => discoverControlRoutes({ peers, indexPin, caPem, decide, operators, failureDomains, now }), { log, now });
+}
