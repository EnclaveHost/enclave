Date: Thu, 22 Oct 2026 17:41:13 -0700
Subject: [PATCH 1/4] opstack: v4 blocks topic, refuse undecodable txs, refuse
 local execution under unimplemented Base rules

---
 common/src/fork_schedule.rs             | 10 +++++++++
 opstack/src/config.rs                   | 25 +++++++++++++++++++--
 opstack/src/consensus.rs                | 29 ++++++++++++++++++++++++-
 opstack/src/evm.rs                      |  7 ++++++
 opstack/src/server/net/block_handler.rs | 16 +++++++++++++-
 5 files changed, 83 insertions(+), 4 deletions(-)

diff --git a/common/src/fork_schedule.rs b/common/src/fork_schedule.rs
index 56376030c3c468c40755398205b3c496b8913a68..18155c068e2e424a727311a03bd98c8da7e7e0bb 100644
--- a/common/src/fork_schedule.rs
+++ b/common/src/fork_schedule.rs
@@ -37,6 +37,15 @@ pub struct ForkSchedule {
     pub holocene_timestamp: u64,
     pub isthmus_timestamp: u64,
     pub jovian_timestamp: u64,
+
+    /// Local EVM execution (eth_call, eth_estimateGas, eth_createAccessList) is refused for blocks at or after this
+    /// timestamp: the chain runs execution rules this build does not implement. u64::MAX = never.
+    #[serde(default = "never")]
+    pub execution_unsupported_from_timestamp: u64,
+}
+
+fn never() -> u64 {
+    u64::MAX
 }
 
 impl Default for ForkSchedule {
@@ -76,6 +85,7 @@ impl Default for ForkSchedule {
             holocene_timestamp: u64::MAX,
             isthmus_timestamp: u64::MAX,
             jovian_timestamp: u64::MAX,
+            execution_unsupported_from_timestamp: u64::MAX,
         }
     }
 }
