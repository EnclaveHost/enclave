--- a/opstack/src/consensus.rs
+++ b/opstack/src/consensus.rs
@@ -293,7 +293,8 @@ fn payload_to_block(value: ExecutionPayload) -> Result<Block<Transaction>> {
         .map(|(i, tx_bytes)| {
             let tx_bytes = tx_bytes.to_vec();
             let mut tx_bytes_slice = tx_bytes.as_slice();
-            let tx_envelope = OpTxEnvelope::decode(&mut tx_bytes_slice).unwrap();
+            let tx_envelope = OpTxEnvelope::decode(&mut tx_bytes_slice)
+                .map_err(|e| eyre!("unsupported or malformed transaction {i} in block {}: {e}", value.block_number))?;
             let base_fee = tx_envelope.effective_gas_price(Some(value.base_fee_per_gas.to()));
             let recovered = tx_envelope.try_into_recovered()?;
 
@@ -404,6 +405,32 @@ mod tests {
         }
     }
 
+    #[test]
+    fn unsupported_transaction_type_is_an_error_not_a_panic() {
+        // Base EIP-8130 (type 0x79, base/base 5476069f tx_type.rs) is not an OpTxEnvelope variant in
+        // op-alloy-consensus 2.0.0; an unknown type byte must refuse the block instead of panicking the client.
+        for ty in [0x79u8, 0x7d, 0x03, 0x05, 0x80] {
+            let mut payload = payload_with_logs_bloom(Bloom::ZERO);
+            let tx: crate::types::Transaction = ssz_types::VariableList::new(vec![ty, 0xc0]).unwrap();
+            payload.transactions = ssz_types::VariableList::new(vec![tx]).unwrap();
+            let res = std::panic::catch_unwind(|| payload_to_block(payload));
+            let res = res.expect("payload_to_block must not panic");
+            assert!(res.is_err(), "type {ty:#x} must be refused");
+        }
+    }
+
+    #[test]
+    fn base_schedules_refuse_execution_from_azul() {
+        use crate::config::{Network, NetworkConfig};
+        let base = NetworkConfig::from(Network::Base).chain.forks;
+        assert_eq!(base.isthmus_timestamp, 1746806401);
+        assert_eq!(base.execution_unsupported_from_timestamp, 1779991200);
+        let sepolia = NetworkConfig::from(Network::BaseSepolia).chain.forks;
+        assert_eq!(sepolia.execution_unsupported_from_timestamp, 1776708000);
+        let op = NetworkConfig::from(Network::OpMainnet).chain.forks;
+        assert_eq!(op.execution_unsupported_from_timestamp, u64::MAX);
+    }
+
     #[test]
     fn preserves_payload_logs_bloom() {
         for bloom in [
