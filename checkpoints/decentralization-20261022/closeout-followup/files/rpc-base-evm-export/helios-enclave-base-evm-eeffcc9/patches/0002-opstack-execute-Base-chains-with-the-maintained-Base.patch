+                break result.map(|res| (res, mem::take(&mut db.state.accounts)));
             }
         };
 
         tx_res.map_err(|err| EvmError::Generic(format!("generic: {err}")))
     }
 
+    /// One execution attempt against proof-backed state. Base chains run the maintained Base EVM
+    /// (base_backend.rs); every other OP Stack chain runs op-revm.
+    fn execute<D: revm::Database>(
+        &self,
+        tx: &OpTransactionRequest,
+        block: &Block<Transaction>,
+        validate_tx: bool,
+        db: &mut D,
+    ) -> Result<ExecutionResult<OpHaltReason>, String> {
+        if BASE_CHAIN_IDS.contains(&self.chain_id) {
+            #[cfg(not(target_arch = "wasm32"))]
+            return base_backend::transact(
+                db,
+                base_backend::BaseCall {
+                    chain_id: self.chain_id,
+                    timestamp: block.header.timestamp,
+                    block: Self::base_block_env(block),
+                    tx: Self::base_tx_env(tx, self.chain_id),
+                    validate_tx,
+                },
+            );
+            #[cfg(target_arch = "wasm32")]
+            return Err("Base execution rules are not available in this build".to_string());
+        }
+        let context = self.get_context(tx, block, validate_tx);
+        let mut evm = context.with_db(LegacyDb(db)).build_op();
+        evm.replay()
+            .map(|res| execution_result(res.result))
+            .map_err(|err| err.to_string())
