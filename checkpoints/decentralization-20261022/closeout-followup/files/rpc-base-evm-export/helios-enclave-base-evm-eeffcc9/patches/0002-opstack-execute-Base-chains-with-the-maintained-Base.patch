@@ -30,9 +30,14 @@ use helios_revm_utils::proof_db::ProofDB;
 
 use crate::spec::OpStack;
 
+#[cfg(not(target_arch = "wasm32"))]
+mod base_backend;
 mod revm_compat;
 use revm_compat::{execution_result, LegacyDb};
 
+/// Chains whose execution rules are Base's own (Azul+ = Osaka + Base precompiles), never op-revm's.
+const BASE_CHAIN_IDS: [u64; 2] = [8453, 84532];
+
 pub struct OpStackEvm<E: ExecutionProvider<OpStack>> {
     execution: Arc<E>,
     chain_id: u64,
@@ -103,31 +108,86 @@ impl<E: ExecutionProvider<OpStack>> OpStackEvm<E> {
                     .map_err(|e| EvmError::Generic(e.to_string()))?;
             }
 
-            // Create EVM after any async operations
-            let context = self.get_context(tx, &block, validate_tx);
-
-            // Execute in a scope to ensure EVM is dropped before any potential async operations
-            let (result, needs_update) = {
-                let mut evm = context.with_db(LegacyDb(&mut db)).build_op();
-                let res = evm.replay();
-                drop(evm);
-                let needs_update = db.state.needs_update();
-                (res, needs_update)
-            };
+            // Create the EVM after any async operations; it is dropped inside execute()
+            let result = self.execute(tx, &block, validate_tx, &mut db);
+            let needs_update = db.state.needs_update();
 
             if result.is_ok() || !needs_update {
-                break result.map(|res| {
-                    (
-                        execution_result(res.result),
