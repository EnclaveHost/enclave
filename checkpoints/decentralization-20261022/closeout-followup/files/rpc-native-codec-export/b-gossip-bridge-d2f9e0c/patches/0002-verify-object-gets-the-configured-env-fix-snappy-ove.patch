+  assert.throws(() => snappyRawDecode(Uint8Array.from([0x03, 0x00, 0x41])), /shorter/);                        // ends early
   assert.throws(() => snappyRawDecode(Uint8Array.from([0x80])), /truncated/);
   assert.deepEqual([...snappyRawDecode(Uint8Array.from([0x00]))], []);
   // literal "ab" then an overlapping copy (offset 2, len 4) -> "ababab"
