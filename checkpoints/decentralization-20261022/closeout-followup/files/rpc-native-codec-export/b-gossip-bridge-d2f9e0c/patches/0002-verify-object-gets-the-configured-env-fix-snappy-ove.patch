       execFile(o.listenerPath, ['verify-object', '--signer', signer, '--file', file],
-        { timeout: LIMITS.verifyTimeoutMs, maxBuffer: LIMITS.verifyOutputBytes, killSignal: 'SIGKILL', env: { PATH: '/usr/bin:/bin' } },
+        { timeout: LIMITS.verifyTimeoutMs, maxBuffer: LIMITS.verifyOutputBytes, killSignal: 'SIGKILL', env: { PATH: '/usr/bin:/bin', ...o.extraEnv } },
         (err, stdout) => {
           if (err) return resolve({ ok: false, why: err.killed ? 'verify-timeout' : 'verify-refused' });
           try { const v = JSON.parse(stdout.trim()); resolve(v && v.ok === true ? { ok: true, v } : { ok: false, why: 'verify-refused' }); }
