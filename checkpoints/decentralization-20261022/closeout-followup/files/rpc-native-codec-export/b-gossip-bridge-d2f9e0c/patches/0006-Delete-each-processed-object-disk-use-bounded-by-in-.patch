diff --git a/network/gossip-head-source.mjs b/network/gossip-head-source.mjs
index 1aac0c4b4ae629d2c32f54089161553d8c608693..57c3d2fc319e361ccaca4ea129855e5634b1b0b2 100644
--- a/network/gossip-head-source.mjs
+++ b/network/gossip-head-source.mjs
@@ -224,7 +224,10 @@ export function createGossipHeadSource(options) {
     s.queued++;
     // Heads already read from this session finish processing before its directory is removed (endSession awaits this
     // chain), so stop() resolves only after the last delivery; nothing is delivered after stop() returns.
-    processing = processing.then(() => processHead(s, r)).finally(() => { s.queued--; });
+    // Each object file is deleted as soon as it was processed (accepted or not): disk use stays bounded by in-flight
+    // objects, and the optional archive hook already received the bytes in memory.
+    const done = () => { s.queued--; if (SHA.test(r?.objectSha256 || '')) return rm(path.join(s.objects, `${r.objectSha256}.v4.snappy`), { force: true }).catch(() => {}); };
+    processing = processing.then(() => processHead(s, r)).finally(done);
   }
 
   function attachStdout(s) {
