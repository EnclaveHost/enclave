+  if (!h || h.platformHostPolicy === 'off') return null;
+  return { ENCLAVE_PLATFORM_HOST_POLICY: typeof h.platformHostPolicy === 'string' ? h.platformHostPolicy : JSON.stringify(h.platformHostPolicy),
