+const TMP = fs.mkdtempSync(path.join(process.env.TEST_TMP || '/tmp', 'win-verifier-'));
+const SEQ_KEY = '0x' + '5e'.repeat(32), seqSigner = privateKeyToAccount(SEQ_KEY).address;
+const OUT = path.join(REPO, 'contracts/foundry/out');
