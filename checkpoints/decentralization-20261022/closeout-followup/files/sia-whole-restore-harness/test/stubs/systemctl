#!/usr/bin/env python3
"""Test stub for systemctl: `show UNIT -p ...` prints the state the systemd-run stub kept; other verbs are recorded."""
import json
import os
import sys

d = os.environ['STUB_DIR']
args = [a for a in sys.argv[1:] if a != '--user']
n = len([x for x in os.listdir(d) if x.startswith('systemctl-')])
with open(os.path.join(d, 'systemctl-%03d.json' % n), 'w') as f:
    json.dump({'argv': sys.argv[1:]}, f)
if args and args[0] == 'show':
    try:
        state = json.load(open(os.path.join(d, 'units', args[1] + '.json')))
    except OSError:
        state = {'ActiveState': 'inactive', 'LoadState': 'not-found', 'InvocationID': ''}
    for k, v in state.items():
        print('%s=%s' % (k, v))
