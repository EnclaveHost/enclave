+# v5: the SAME fetch as apphealth.fetch (byte-equivalent request and returns; tests/test_gate_v5.py compares them), except that it
+# keeps the exception apphealth.fetch swallows, so a failed check can be classified. apphealth.check (the health definition) is
+# untouched and calls this through its module global.
+MAX_RESETS = 1
+LAST_ERROR = {}
+def _fetch_recording(url, timeout=12):
+    req = urllib.request.Request(url, headers={'user-agent': 'enclave-activation-health/1', 'cache-control': 'no-cache'})
+    LAST_ERROR[url] = None
+    try:
+        with urllib.request.urlopen(req, timeout=timeout, context=apphealth.CTX) as r:
+            return r.status, (r.headers.get('content-type') or '').lower(), r.read(1 << 20)
+    except urllib.error.HTTPError as e: return e.code, '', b''
+    except Exception as e: LAST_ERROR[url] = e; return None, '', type(e).__name__.encode()
+apphealth.fetch = _fetch_recording
+
+TRANSIENT = (TimeoutError, ConnectionRefusedError, ConnectionResetError, ConnectionAbortedError, socket.gaierror)
+def is_transient(e):
+    """No HTTP response at all, for a transport reason. Never TLS/certificate (ssl.SSLError is an OSError; urllib wraps it in
+    URLError), never an HTTP status (HTTPError is answered by apphealth.fetch as a status, not an exception)."""
+    if isinstance(e, urllib.error.HTTPError) or e is None: return False
+    inner = e.reason if isinstance(e, urllib.error.URLError) else e
+    if isinstance(inner, ssl.SSLError) or isinstance(e, ssl.SSLError): return False
+    return isinstance(inner, TRANSIENT)
+
