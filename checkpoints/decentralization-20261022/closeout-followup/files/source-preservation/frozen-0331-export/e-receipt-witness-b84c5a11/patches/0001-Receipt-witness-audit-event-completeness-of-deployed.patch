diff --git a/probe/bloom-density.mjs b/probe/bloom-density.mjs
new file mode 100644
index 0000000000000000000000000000000000000000..6b07f715bc50430d845558c5a9cc497d188e95e5
--- /dev/null
+++ b/probe/bloom-density.mjs
@@ -0,0 +1,68 @@
+#!/usr/bin/env node
+// Bounded, read-only sizing of Base logsBloom saturation and Enclave-log density (ONE public endpoint).
+//   node bloom-density.mjs OUT.json [N_BLOCKS<=29]
+// Per sampled block: popcount of the 2048-bit logsBloom and whether it admits each Enclave contract address (a
+// complete scan can only skip blocks whose bloom does NOT admit the address: blooms have no false negatives).
+// One eth_getLogs over the same range gives the true positives; every true-positive block must be bloom-positive,
+// which checks the bloom code. Bounds: <= 32 requests, 20 s each, 8 MiB per response, chainId 8453.
+// The data is single-provider and unverified: a sizing measurement only.
+import { writeFileSync } from 'node:fs'
+const VIEM = process.env.VIEM_DIR
+const { keccak256, hexToBytes } = await import(`${VIEM}/_esm/index.js`)
+
+const URL = process.env.RPC_URL || 'https://mainnet.base.org'
+const ADDRS = { // live Enclave contracts (outputs/contract-change-audit/live.json book entries)
+  deployments: '0xb1783b61e1fdee6a6163dc3cdac27bf32e7d117b', registry: '0x868eb7fc5b5a84b2ff082eafc9bf40b7aac5ccac',
+  appCatalog: '0x18419ca2b502d423a8de6269aeee171a378626e3', connectivity: '0x5f8b636e0768e84bd47b736652030b65db615111',
+  proofOfTime: '0x6f462d77727f10f05a3e660650e7dcc9cc60e6b2', addressBook: '0xab214342d5a490150a4a977063a2f88e21f80907',
+}
+let calls = 0
+async function rpc(method, params) {
+  if (++calls > 32) throw new Error('request bound')
+  await new Promise(r => setTimeout(r, Number(process.env.PACE_MS || 2000)))  // paced: shared egress with production
+  const r = await fetch(URL, { method: 'POST', headers: { 'content-type': 'application/json', 'user-agent': 'enclave-bloom-sizing/1' },
+    body: JSON.stringify({ jsonrpc: '2.0', id: calls, method, params }), signal: AbortSignal.timeout(20000) })
+  const text = await r.text()
+  if (text.length > 8 << 20) throw new Error('response bound')
+  const out = JSON.parse(text)
+  if (out.error) throw new Error(JSON.stringify(out.error))
+  return out.result
+}
+// Yellow paper M3:2048 — three 11-bit indices from the first three byte pairs of keccak256(item); as a big-endian
+// 2048-bit integer, bit `idx` is set (geth core/types/bloom9.go bloomValues).
+const bits = (itemHex) => { const h = hexToBytes(keccak256(itemHex)); return [0, 2, 4].map(i => ((h[i] << 8) | h[i + 1]) & 2047) }
+const admits = (bloom, itemHex) => bits(itemHex).every(b => (bloom >> BigInt(b)) & 1n)
+const popcount = (x) => { let n = 0; while (x) { n += Number(x & 1n); x >>= 1n } return n }
+
+const [out, nArg] = process.argv.slice(2)
+const n = Math.min(Number(nArg || 29), 29)
+if (Number(await rpc('eth_chainId', [])) !== 8453) throw new Error('not Base mainnet')
+const head = Number(await rpc('eth_blockNumber', [])) - 5
+const rows = []
+for (let k = 0; k < n; k++) {
+  let b
+  try { b = await rpc('eth_getBlockByNumber', ['0x' + (head - k).toString(16), false]) }
+  catch (e) { writeFileSync(out, JSON.stringify({ stopped: String(e.message), rows }, null, 1) + '\n'); console.log('STOPPED', e.message, rows.length); process.exit(3) }
+  const bloom = BigInt(b.logsBloom)
+  rows.push({ number: Number(b.number), txs: b.transactions.length, bloomBitsSet: popcount(bloom),
+    admits: Object.fromEntries(Object.entries(ADDRS).map(([k2, a]) => [k2, admits(bloom, a)])) })
+}
+const lo = head - n + 1
+const logs = await rpc('eth_getLogs', [{ fromBlock: '0x' + lo.toString(16), toBlock: '0x' + head.toString(16), address: Object.values(ADDRS) }])
+const trueBlocks = {}
+for (const lg of logs) (trueBlocks[lg.address.toLowerCase()] ??= new Set()).add(Number(lg.blockNumber))
+for (const [k2, a] of Object.entries(ADDRS)) for (const bn of trueBlocks[a] ?? []) {
+  const row = rows.find(r => r.number === bn)
+  if (row && !row.admits[k2]) throw new Error(`bloom code wrong: block ${bn} has a ${k2} log but the bloom does not admit it`)
+}
+const set = rows.map(r => r.bloomBitsSet)
+const summary = {
+  endpoint: URL, generatedAt: new Date().toISOString(), blocks: [lo, head], requests: calls,
+  bloomBitsSet: { min: Math.min(...set), max: Math.max(...set), mean: set.reduce((a, b) => a + b, 0) / set.length },
+  txsPerBlockMean: rows.reduce((a, r) => a + r.txs, 0) / rows.length,
+  bloomPositiveBlocks: Object.fromEntries(Object.keys(ADDRS).map(k2 => [k2, rows.filter(r => r.admits[k2]).length])),
+  truePositiveBlocks: Object.fromEntries(Object.entries(ADDRS).map(([k2, a]) => [k2, trueBlocks[a]?.size ?? 0])),
+  logsReturned: logs.length, sampled: rows.length,
+}
+writeFileSync(out, JSON.stringify({ summary, rows }, null, 1) + '\n')
+console.log(JSON.stringify(summary))
diff --git a/probe/capture.mjs b/probe/capture.mjs
new file mode 100644
index 0000000000000000000000000000000000000000..48e5a1ecd5bae672dae03fb3b7939b49450f2066
--- /dev/null
+++ b/probe/capture.mjs
@@ -0,0 +1,58 @@
+#!/usr/bin/env node
+// Capture UNTRUSTED raw inputs for the offline receipt-witness verifier (one public endpoint, paced, bounded).
+//   RPC_URL=… node capture.mjs OUT.json
+// 1. eth_getLogs over the last 1000 blocks for the deployment ledger's lease events; pick the newest one: its
+//    deployment id X and block E.
+// 2. Every header E..A (A = head - 2) as returned by eth_getBlockByNumber(n, false).
+// 3. Full receipts (eth_getBlockReceipts) for E and for every block whose logsBloom admits BOTH the ledger address
+//    and the topic X (a block whose bloom does not admit both cannot hold a ledger log carrying X).
+// Nothing here is trusted: the verifier recomputes every hash and root. Bounds: window <= 120 blocks, <= 190 requests,
+// PACE_MS between requests (default 2500), 20 s per request, 16 MiB per response, chainId 8453.
+import { writeFileSync } from 'node:fs'
+const { keccak256, hexToBytes, toEventSelector } = await import(`${process.env.VIEM_DIR}/_esm/index.js`)
+const URL = process.env.RPC_URL
+const LEDGER = '0xb1783b61e1fdee6a6163dc3cdac27bf32e7d117b'
+const SIG = {
+  Claimed: 'Claimed(bytes32,bytes32,address,uint64,uint256)', Renewed: 'Renewed(bytes32,bytes32,uint64,uint256)',
+  Released: 'Released(bytes32,bytes32,uint256)',
+}
+const TOPIC = Object.fromEntries(Object.entries(SIG).map(([k, s]) => [k, toEventSelector(s)]))
+let calls = 0
+async function rpc(method, params) {
+  if (++calls > 190) throw new Error('request bound')
+  await new Promise(r => setTimeout(r, Number(process.env.PACE_MS || 2500)))
+  const r = await fetch(URL, { method: 'POST', headers: { 'content-type': 'application/json', 'user-agent': 'enclave-witness-capture/1' },
+    body: JSON.stringify({ jsonrpc: '2.0', id: calls, method, params }), signal: AbortSignal.timeout(20000) })
+  const text = await r.text()
+  if (text.length > 16 << 20) throw new Error('response bound')
+  const out = JSON.parse(text)
+  if (out.error) throw new Error(`${method}: ${JSON.stringify(out.error)}`)
+  return out.result
+}
+const bits = (itemHex) => { const h = hexToBytes(keccak256(itemHex)); return [0, 2, 4].map(i => ((h[i] << 8) | h[i + 1]) & 2047) }
+const admits = (bloomHex, itemHex) => { const b = BigInt(bloomHex); return bits(itemHex).every(i => (b >> BigInt(i)) & 1n) }
+const hex = (n) => '0x' + n.toString(16)
+
+const out = process.argv[2]
+if (Number(await rpc('eth_chainId', [])) !== 8453) throw new Error('not Base mainnet')
+const head = Number(await rpc('eth_blockNumber', [])) - 2
+const logs = await rpc('eth_getLogs', [{ fromBlock: hex(head - 999), toBlock: hex(head), address: LEDGER,
+  topics: [[TOPIC.Claimed, TOPIC.Renewed, TOPIC.Released]] }])
+if (!logs.length) throw new Error('no lease event in the last 1000 blocks')
+const last = logs.reduce((a, l) => (Number(l.blockNumber) > Number(a.blockNumber) ||
+  (l.blockNumber === a.blockNumber && Number(l.logIndex) > Number(a.logIndex)) ? l : a))
+const X = last.topics[1], E = Number(last.blockNumber)
+if (head - E > 120) throw new Error(`window ${head - E} > 120 blocks`)
+const headers = []
+for (let n = E; n <= head; n++) headers.push(await rpc('eth_getBlockByNumber', [hex(n), false]))
+const receipts = {}
+for (const h of headers) {
+  const n = Number(h.number)
+  if (n === E || (admits(h.logsBloom, LEDGER) && admits(h.logsBloom, X))) receipts[n] = await rpc('eth_getBlockReceipts', [hex(n)])
+}
+writeFileSync(out, JSON.stringify({ format: 'enclave-receipt-witness-fixture/v1', endpoint: URL, capturedAt: new Date().toISOString(),
+  untrusted: true, ledger: LEDGER, deploymentId: X, eventBlock: E, anchorBlock: head, requests: calls,
+  lastEvent: { blockNumber: last.blockNumber, transactionHash: last.transactionHash, logIndex: last.logIndex, topic0: last.topics[0] },
+  headers, receipts }) + '\n')
+console.log(JSON.stringify({ deploymentId: X, eventBlock: E, anchorBlock: head, window: head - E + 1,
+  receiptBlocks: Object.keys(receipts).length, requests: calls, bytes: JSON.stringify(receipts).length }))
diff --git a/silent-writers.py b/silent-writers.py
new file mode 100644
index 0000000000000000000000000000000000000000..9b37e17ce26b6b92e7026c33143283565a723784
--- /dev/null
+++ b/silent-writers.py
@@ -0,0 +1,25 @@
+"""Heuristic first pass (then read by hand): per external/public function, does its body (and private helpers it
+calls, one level) assign storage and emit nothing? Output feeds the manual audit; it is not the audit."""
+import re, sys
+src = open(sys.argv[1]).read()
+src = re.sub(r'//[^\n]*', '', src); src = re.sub(r'/\*.*?\*/', '', src, flags=re.S)
+funcs = {}
+for m in re.finditer(r'\bfunction\s+(\w+)\s*\(([^)]*)\)([^{;]*)\{', src):
+    i, depth = m.end(), 1
+    while depth and i < len(src):
+        depth += {'{': 1, '}': -1}.get(src[i], 0); i += 1
+    funcs.setdefault(m.group(1), []).append((m.group(3), src[m.end():i - 1]))
+state = set(re.findall(r'^\s*(?:mapping\s*\(.*?\)|[\w\[\]\.]+)\s+(?:public\s+|private\s+|internal\s+)?(\w+)\s*(?:=[^;]*)?;', src, re.M))
+def writes(body):
+    return sorted({w for w in re.findall(r'\b(_?\w+)\s*(?:\[[^\]]*\])*(?:\.\w+)*\s*(?:=(?!=)|\+=|-=|\+\+|--)', body) if w in state} |
+                  {w for w in re.findall(r'\bdelete\s+(_?\w+)', body) if w in state} | {w for w in re.findall(r'\b(\w+)\.push\(', body) if w in state})
+for name, defs in funcs.items():
+    for mods, body in defs:
+        if re.search(r'\b(view|pure)\b', mods): continue
+        ext = re.search(r'\b(external|public)\b', mods) or name == 'constructor'
+        w = writes(body); emits = re.findall(r'emit\s+(\w+)', body)
+        calls = [c for c in re.findall(r'\b(_\w+)\s*\(', body) if c in funcs]
+        for c in calls:
+            for cm, cb in funcs[c]: w = sorted(set(w) | set(writes(cb))); emits += re.findall(r'emit\s+(\w+)', cb)
+        if ext and w and not emits: print(f'SILENT  {name}: writes {w}')
+        elif ext and w: print(f'emits   {name}: writes {w} emits {sorted(set(emits))}')
