+        require(bytes(slug).length > 0 && bytes(slug).length <= MAX_SLUG, "slug length");
+        require(bytes(name).length > 0 && bytes(name).length <= MAX_NAME, "name length");
+        require(bytes(description).length <= MAX_DESC, "desc length");
