+	// the default limits leave the real proof exactly as before
+	v, err := VerifyWithLimits(fixtureOf(t, m), anchor, DefaultLimits)
+	if err != nil || v.LeaseUntil == nil || *v.LeaseUntil != 1792721679 || v.ReceiptsVerified != 1824 {
