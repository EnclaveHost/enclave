+	d := lg["data"].(string)
+	lg["data"] = d[:len(d)-1] + map[bool]string{true: "1", false: "0"}[d[len(d)-1] == '0'] // a later leaseUntil/burn
+	refused(t, m, anchor, "receipts root")
