+        require(cpuMilli > 0 && cpuMilli <= 1000, "range");
+        require(gpuMilli <= 1000, "range");
+        require(appPort > 0, "range");
+        require(bytes(ports).length <= MAX_PORTS, "length");
+        require(bytes(configCid).length <= MAX_CFG, "length");
+    }
