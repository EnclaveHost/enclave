+"""Bridge tests with real sockets: the inside Bridge (loopback TCP -> AF_UNIX) and the outside Bridge (AF_UNIX -> TCP)
+of runner.py relay between real clients and real "host" servers. Run by run-tests.sh INSIDE `unshare -rn` (loopback
+only; 203.0.113.5 carries the inside listeners as in a restore namespace, 127.0.0.3 the hosts). No mocks: every byte
+goes through the kernel, and every assertion is about what a client or a host actually received."""
+import gc
+import hashlib
+import importlib.util
+import os
+import shutil
+import socket
+import struct
+import tempfile
+import threading
+import time
+import unittest
+from pathlib import Path
+
+HERE = Path(__file__).resolve().parent
+spec = importlib.util.spec_from_file_location('runner', HERE.parent / 'runner.py')
+runner = importlib.util.module_from_spec(spec)
+spec.loader.exec_module(runner)
+INSIDE_IP, HOST_IP = '203.0.113.5', '127.0.0.3'
+BLOCK = hashlib.shake_256(b'bridge-test').digest(1 << 20)
+
+
+def pieces(seed, n):
+    """n generated bytes in 64 KiB pieces, different per seed and position."""
+    i = 0
+    while n > 0:
+        off = (seed * 7919 + i * 104729) % (len(BLOCK) - 65536)
+        p = (struct.pack('>QQ', seed, i) + BLOCK[off:off + 65520])[:n]
+        yield p
+        n -= len(p)
+        i += 1
+
+
+def data(seed, n):
+    return b''.join(pieces(seed, n))
+
+
+def send_stream(c, seed, n):
+    for p in pieces(seed, n):
+        c.sendall(p)
+
+
+def digest(seed, n):
+    h = hashlib.sha256()
+    for p in pieces(seed, n):
+        h.update(p)
+    return h.digest()
+
+
+def recv_all(s, limit=1 << 30):
+    out = bytearray()
+    while len(out) < limit:
+        d = s.recv(1 << 16)
+        if not d:
+            break
+        out += d
+    return bytes(out)
+
+
+def rss_anon_kib():
+    for line in open('/proc/self/status'):
+        if line.startswith('RssAnon:'):
+            return int(line.split()[1])
+    return 0
