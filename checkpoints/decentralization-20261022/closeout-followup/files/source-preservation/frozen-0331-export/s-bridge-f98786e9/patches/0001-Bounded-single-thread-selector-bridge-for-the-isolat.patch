+    # -- churn: memory and descriptors return to a plateau --
+    def test_connect_churn_plateau(self):
+        body = data(4, 200 << 10)
+        host = self.host(lambda c: c.sendall(body), inline=True)  # one host thread: the process RSS is the bridges'
+        p = self.pair(host, endpoints=4)
+
+        errors = []
+
+        def cycle(k):
+            try:
+                one(k)
+            except (OSError, AssertionError) as e:
+                errors.append(repr(e))
+
+        def one(k):
+            s = p.connect(k % 4)
+            if k % 3 == 0:
+                s.close()  # gone before the status byte
+            elif k % 3 == 1:
+                s.recv(1 << 12)  # abort mid-response with unread data: RST
+                s.setsockopt(socket.SOL_SOCKET, socket.SO_LINGER, struct.pack('ii', 1, 0))
+                s.close()
+            else:
+                if recv_all(s) != body:
+                    raise AssertionError('short or wrong response')
+                s.close()
+        marks = []
+        for rnd in range(4):
+            ts = [threading.Thread(target=lambda r=rnd: [cycle(r * 1000 + k) for k in range(250)]) for _ in range(4)]
+            for t in ts:
+                t.start()
+            for t in ts:
+                t.join(120)
+            self.assertEqual(p.wait_live((0, 0), secs=20), (0, 0))
+            gc.collect()
+            marks.append(rss_anon_kib())
+        si, so = self.assert_clean_stop(p, host)
+        self.assertEqual(errors, [])
+        self.assertEqual(si['accepted'], 4000)
+        self.assertLess(marks[-1] - marks[0], 4 << 10, 'anon memory after 4000 connections: %s KiB' % marks)
+        self.assertLessEqual(si['buffersAllocated'] + so['buffersAllocated'], 2 * (si['maxLive'] + so['maxLive']))
+
+    def run(self, result=None):
+        gc.collect()
+        self.anon0 = rss_anon_kib()
+        return super().run(result)
+
+
+def recv_exactly(s, n):
+    out = bytearray()
+    while len(out) < n:
+        d = s.recv(min(n - len(out), 1 << 16))
+        if not d:
+            raise ConnectionAbortedError('eof after %d of %d' % (len(out), n))
+        out += d
+    return bytes(out)
+
