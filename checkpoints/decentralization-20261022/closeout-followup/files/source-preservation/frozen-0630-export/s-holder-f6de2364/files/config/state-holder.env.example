# Enclave Base execution-state holder: configuration TEMPLATE (not deployed, not deployable until the RESULT.md §6
# prerequisites are met). It is an overlay on base/base v1.5.1's own operator entrypoint
# (etc/scripts/node/execution-entrypoint, sha256 ea98be1b…), whose defaults must NOT be used as-is here:
#   - they bind RPC/WS/authrpc to 0.0.0.0 with CORS "*";
#   - .env.mainnet ships a sample engine JWT.
# The HOLDER_* and RETH_EXTRA_ARGS names are inputs for an Enclave launcher that is NOT written yet. The upstream
# entrypoint hard-codes 0.0.0.0 and cannot consume them. RETH_* and BASE_NODE_* keep their upstream meanings.
# The holder is an UNTRUSTED availability source. Every proof it returns is checked by the Enclave verifier against the
# sequencer-signed head from enclave-base-head-listener, so a wrong or stale holder fails closed.
# There is no public-RPC fallback in this file. The L1 endpoints below are a separate, declared dependency (RESULT §5).

RETH_CHAIN=base
BASE_NODE_NETWORK=base
# State, headers and minimum history (RESULT §3: state ≈ 761 GB at block 52962126). Restore with
#   base-reth-node download --minimal --chain base
# then verify against an independent root (RESULT §7, step 3).
# The datadir must NOT be on the existing NVMe drives (direct human constraint).
RETH_DATA_DIR=/srv/enclave-base-holder/data            # placeholder: the device is a root/human decision (RESULT §6)
# Proofs at the signed head need a few blocks of slack. The default window is 0 (latest only); 1800 blocks = 1 h before
# Denim, 6 min after it. UNVERIFIED: whether the --minimal profile keeps enough changesets for a window of this size.
# If it does not, use --full (keeps 10,064 blocks).
RETH_EXTRA_ARGS="--rpc.eth-proof-window=1800"
# Keep the historical-proofs ExEx off (+872 GB in Base's snapshot; not needed for fresh witnesses).
RETH_HISTORICAL_PROOFS=false

# RPC: loopback only, minimum API set. The Enclave witness gateway is the only client.
HOLDER_HTTP_ADDR=127.0.0.1
HOLDER_HTTP_PORT=8545
HOLDER_HTTP_API=eth,net,web3            # eth_getProof, eth_getBlockByNumber, eth_getCode, eth_getStorageAt, eth_sendRawTransaction
HOLDER_AUTHRPC_ADDR=127.0.0.1
HOLDER_ENGINE_JWT_FILE=/srv/enclave-base-holder/engine.jwt   # 32 random bytes generated locally at install; never the sample

# Submission: Base is the sole orderer. The node forwards raw txs to the hosted sequencer. The only alternative is an
# L1 OptimismPortal deposit. Broadcast is not inclusion (RESULT §5).
RETH_SEQUENCER_HTTP=https://mainnet-sequencer.base.org

# Consensus (derivation): REQUIRED by base-consensus (crates/consensus/cli/src/l1.rs: l1_eth_rpc and l1_beacon have no
# usable default).
BASE_NODE_L1_ETH_RPC=<L1 execution endpoint: declared dependency, RESULT §5>
BASE_NODE_L1_BEACON=<L1 beacon endpoint (blob sidecars): declared dependency, RESULT §5>
BASE_NODE_L1_TRUST_RPC=false
BASE_NODE_L2_ENGINE_RPC=ws://127.0.0.1:8551
