+/// Local payload attributes builder for Base.
+#[derive(Debug)]
+pub struct BaseLocalPayloadAttributesBuilder {
+    chain_spec: Arc<BaseChainSpec>,
+}
+
+impl BaseLocalPayloadAttributesBuilder {
+    /// Creates a new builder.
