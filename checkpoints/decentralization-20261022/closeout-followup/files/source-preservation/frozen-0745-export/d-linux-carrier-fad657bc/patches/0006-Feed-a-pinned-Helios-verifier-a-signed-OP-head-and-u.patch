+  const exit = await Promise.race([h.exited, sleep(8000).then(() => null)]);
+  t.diagnostic(`stock verifier after a 0x79 head: ${exit ? JSON.stringify(exit) : 'still running'}; log tail: ${h.log.slice(-300).replace(/\s+/g, ' ')}`);
