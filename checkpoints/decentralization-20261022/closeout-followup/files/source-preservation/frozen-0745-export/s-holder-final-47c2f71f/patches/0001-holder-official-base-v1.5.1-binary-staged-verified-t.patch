+
+      --shadow-indexer.retention-interval <SHADOW_INDEXER_RETENTION_INTERVAL>
+          Delay between shadow block retention sweeps
+          
+          [env: SHADOW_INDEXER_RETENTION_INTERVAL=]
+          [default: 1h]
+
+      --l1-eth-rpc <L1_ETH_RPC>
