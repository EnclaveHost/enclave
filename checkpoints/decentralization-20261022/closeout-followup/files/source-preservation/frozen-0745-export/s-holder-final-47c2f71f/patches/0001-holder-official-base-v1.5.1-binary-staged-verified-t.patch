+
+      --shadow-indexer.db-user <SHADOW_INDEXER_DB_USER>
+          Role to authenticate to the shadow indexer database as
+          
+          [env: SHADOW_INDEXER_DB_USER=]
+          [default: app]
+
+      --shadow-indexer.max-connections <SHADOW_INDEXER_MAX_CONNECTIONS>
