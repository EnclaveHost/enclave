+          
+          [env: SHADOW_INDEXER_CONNECTION_TIMEOUT=]
+          [default: 30s]
+
+      --shadow-indexer.retention <SHADOW_INDEXER_RETENTION>
+          Age at which persisted shadow blocks are deleted, measured from their last write
+          
+          [env: SHADOW_INDEXER_RETENTION=]
