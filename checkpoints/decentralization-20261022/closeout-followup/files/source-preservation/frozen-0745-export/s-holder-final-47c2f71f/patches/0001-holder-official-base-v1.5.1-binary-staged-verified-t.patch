+          [env: BASE_NODE_P2P_NO_DISCOVERY=]
+
+      --p2p.priv.path <PRIV_PATH>
+          Read the hex-encoded 32-byte private key for the peer ID from this txt file. Created if not already exists. Important to persist to keep the same network identity after restarting, maintaining the previous advertised identity
+          
+          [env: BASE_NODE_P2P_PRIV_PATH=]
+
+      --p2p.priv.raw <PRIVATE_KEY>
+          The hex-encoded 32-byte private key for the peer ID
+          
+          [env: BASE_NODE_P2P_PRIV_RAW=]
+
+      --p2p.advertise.ip <ADVERTISE_IP>
+          IP address or DNS hostname to advertise to external peers from Discv5. Optional argument. Use the `p2p.listen.ip` if not set. Accepts either an IP address (e.g., "1.2.3.4") or a DNS hostname (e.g., "node1.example.com"). DNS hostnames are resolved to IP addresses at startup.
+          
+          Technical note: if this argument is set, the dynamic ENR updates from the discovery layer will be disabled. This is to allow the advertised IP to be static (to use in a network behind a NAT for instance).
+          
+          [env: BASE_NODE_P2P_ADVERTISE_IP=]
+
+      --p2p.advertise.tcp <ADVERTISE_TCP_PORT>
+          TCP port to advertise to external peers from the discovery layer. Same as `p2p.listen.tcp` if set to zero
+          
+          [env: BASE_NODE_P2P_ADVERTISE_TCP_PORT=]
+
+      --p2p.advertise.udp <ADVERTISE_UDP_PORT>
+          UDP port to advertise to external peers from the discovery layer. Same as `p2p.listen.udp` if set to zero
+          
+          [env: BASE_NODE_P2P_ADVERTISE_UDP_PORT=]
+
+      --p2p.listen.ip <LISTEN_IP>
+          IP address or DNS hostname to bind LibP2P/Discv5 to. Accepts either an IP address (e.g., "0.0.0.0") or a DNS hostname (e.g., "node1.example.com"). DNS hostnames are resolved to IP addresses at startup
+          
+          [env: BASE_NODE_P2P_LISTEN_IP=]
+          [default: 0.0.0.0]
+
+      --p2p.listen.tcp <LISTEN_TCP_PORT>
+          TCP port to bind `LibP2P` to. Any available system port if set to 0
+          
+          [env: BASE_NODE_P2P_LISTEN_TCP_PORT=]
+          [default: 9222]
+
+      --p2p.listen.udp <LISTEN_UDP_PORT>
+          UDP port to bind Discv5 to. Same as TCP port if left 0
+          
+          [env: BASE_NODE_P2P_LISTEN_UDP_PORT=]
+          [default: 9223]
+
+      --p2p.peers.hi <PEERS_HI>
+          High-tide peer count. The node starts pruning peer connections slowly after reaching this number
+          
+          [env: BASE_NODE_P2P_PEERS_HI=]
+          [default: 30]
+
+      --p2p.max-pending-outgoing <MAX_PENDING_OUTGOING>
+          Maximum number of outbound libp2p connections that may be pending at once
+          
+          [env: BASE_NODE_P2P_MAX_PENDING_OUTGOING=]
+          [default: 16]
+
+      --p2p.identify.peerstore.size <IDENTIFY_PEERSTORE_SIZE>
+          Maximum number of peers to retain identify metadata for
+          
+          [env: BASE_NODE_P2P_IDENTIFY_PEERSTORE_SIZE=]
+          [default: 1024]
+
+      --p2p.peers.grace <PEERS_GRACE>
+          Grace period to keep a newly connected peer around, if it is not misbehaving
+          
+          [env: BASE_NODE_P2P_PEERS_GRACE=]
+          [default: 30]
+
+      --p2p.gossip.mesh.d <GOSSIP_MESH_D>
+          Configure `GossipSub` topic stable mesh target count. Aka: The desired outbound degree (numbers of peers to gossip to)
+          
+          [env: BASE_NODE_P2P_GOSSIP_MESH_D=]
+          [default: 8]
+
+      --p2p.gossip.mesh.lo <GOSSIP_MESH_DLO>
+          Configure `GossipSub` topic stable mesh low watermark. Aka: The lower bound of outbound degree
+          
+          [env: BASE_NODE_P2P_GOSSIP_MESH_DLO=]
+          [default: 6]
+
+      --p2p.gossip.mesh.dhi <GOSSIP_MESH_DHI>
+          Configure `GossipSub` topic stable mesh high watermark. Aka: The upper bound of outbound degree (additional peers will not receive gossip)
+          
+          [env: BASE_NODE_P2P_GOSSIP_MESH_DHI=]
+          [default: 12]
+
+      --p2p.gossip.mesh.dlazy <GOSSIP_MESH_DLAZY>
+          Configure `GossipSub` gossip target. Aka: The target degree for gossip only (not messaging like p2p.gossip.mesh.d, just announcements of IHAVE)
+          
+          [env: BASE_NODE_P2P_GOSSIP_MESH_DLAZY=]
+          [default: 6]
+
+      --p2p.gossip.mesh.floodpublish
+          Configure `GossipSub` to publish messages to all known peers on the topic, outside of the mesh. Also see Dlazy as less aggressive alternative
+          
+          [env: BASE_NODE_P2P_GOSSIP_FLOOD_PUBLISH=]
+
+      --p2p.scoring <SCORING>
+          Sets the peer scoring strategy for the P2P stack. Can be one of: none or light
+          
+          [env: BASE_NODE_P2P_SCORING=]
+          [default: light]
+
+      --p2p.ban.peers
+          Allows to ban peers based on their score.
+          
+          Peers are banned based on a ban threshold (see `p2p.ban.threshold`). If a peer's score is below the threshold, it gets automatically banned.
+          
+          [env: BASE_NODE_P2P_BAN_PEERS=]
+
+      --p2p.ban.threshold <BAN_THRESHOLD>
+          The threshold used to ban peers.
+          
+          For peers to be banned, the `p2p.ban.peers` flag must be set to `true`. By default, peers are banned if their score is below -100. This follows the reference node default `<https://github.com/ethereum-optimism/optimism/blob/09a8351a72e43647c8a96f98c16bb60e7b25dc6e/op-node/flags/p2p_flags.go#L123-L130>`.
+          
+          [env: BASE_NODE_P2P_BAN_THRESHOLD=]
+          [default: -100]
+
+      --p2p.ban.duration <BAN_DURATION>
+          The duration in minutes to ban a peer for.
+          
+          For peers to be banned, the `p2p.ban.peers` flag must be set to `true`. By default peers are banned for 1 hour. This follows the reference node default `<https://github.com/ethereum-optimism/optimism/blob/09a8351a72e43647c8a96f98c16bb60e7b25dc6e/op-node/flags/p2p_flags.go#L131-L138>`.
+          
+          [env: BASE_NODE_P2P_BAN_DURATION=]
+          [default: 60]
+
+      --p2p.discovery.interval <consensus_p2p_discovery_interval>
+          The interval in seconds to find peers using the discovery service. Defaults to 5 seconds
+          
+          [env: BASE_NODE_P2P_DISCOVERY_INTERVAL=]
+          [default: 5]
+
+      --p2p.bootstore <BOOTSTORE>
+          The directory to store the bootstore
+          
+          [env: BASE_NODE_P2P_BOOTSTORE=]
+
+      --p2p.no-bootstore
+          Disables the bootstore
+          
+          [env: BASE_NODE_P2P_NO_BOOTSTORE=]
+
+      --p2p.redial <PEER_REDIAL>
+          Peer Redialing threshold is the maximum amount of times to attempt to redial a peer that disconnects. By default, peers are *not* redialed. If set to 0, the peer will be redialed indefinitely
+          
+          [env: BASE_NODE_P2P_REDIAL=]
+          [default: 500]
+
+      --p2p.redial.period <REDIAL_PERIOD>
+          The duration in minutes of the peer dial period. When the last time a peer was dialed is longer than the dial period, the number of peer dials is reset to 0, allowing the peer to be dialed again
+          
+          [env: BASE_NODE_P2P_REDIAL_PERIOD=]
+          [default: 60]
+
+      --p2p.pending-dial.timeout <PENDING_DIAL_TIMEOUT>
+          The duration in seconds before a pending outbound dial is aborted
