 # Private Base state holder: package, storage/cache, L1 trace (RESULT-HOLDER, 2026-10-23 ~05:35Z)
 
+> Superseded in part by RESULT-BINARY-PREFLIGHT.md (official binary validated; `--minimal` removed from argv; root
+> storage fixes `b1b6f184` and `c3efff41` integrated).
+
 **Status: source + offline/loopback tests only. NOT activation-ready.** Nothing was allocated, activated, synced or
 downloaded beyond metadata. This work did no SSH, used no wallet or credentials, made no production change and did not
 push. The live restore and the storage VM were not touched. Bridge `f98786e` was not touched.
@@ -187,6 +190,10 @@ command seams:**
    - It adopts a mount only if `findmnt MAJ:MIN` equals our device's.
    - Anything else is refused and left untouched.
    - `disassemble` and `cache-loss` apply the same identity checks before removing anything.
+     **Correction:** as of `f6de236` this was an overclaim. `disassemble` unmounted BEFORE validating the mapping, and
+     never checked the mount's device. Root's fix `b1b6f184` validates the mapping and the mount's MAJ:MIN before
+     unmount. Root's second fix `c3efff41` makes unwind stop at the first failed cleanup instead of tearing down
+     dependencies. Both are integrated in RESULT-BINARY-PREFLIGHT.md. These are seam tests, not kernel proof.
 2. **Stale cache.**
    - `cache-loss` (holder offline) removes our mapping and **zeroes the cache metadata before the origin is touched**,
      then runs a read-only fsck.
diff --git a/evidence/render-review/holder-storage.sh b/evidence/render-review/holder-storage.sh
index b48191ea134609e897fb1060a9e9e0f14705e3e8..9761be14836a048746665ab4d84e600c8982e3d9 100755
--- a/evidence/render-review/holder-storage.sh
+++ b/evidence/render-review/holder-storage.sh
@@ -41,11 +41,30 @@ CREATED=(); ATTACHED=(); MAPPED=; MOUNTED=
 unwind() {
   local rc=$?
   [ "$rc" -eq 0 ] && return 0
+  trap - EXIT
   set +e
-  [ -n "$MOUNTED" ] && umount "$MNT"
-  [ -n "$MAPPED" ] && dmsetup remove "$NAME"
-  for l in "${ATTACHED[@]}"; do losetup -d "$l"; done
-  for f in "${CREATED[@]}"; do rm -f -- "$f"; done
+  # Ownership alone is not enough: a failed teardown leaves its dependencies live.
+  # Preserve the remaining devices/files for recovery and the original failure code.
+  if [ -n "$MOUNTED" ] && ! umount "$MNT"; then
+    log "cleanup stopped: cannot unmount $MNT; mapping, loops and images kept (original rc=$rc)"
+    exit "$rc"
+  fi
+  if [ -n "$MAPPED" ] && ! dmsetup remove "$NAME"; then
+    log "cleanup stopped: cannot remove mapping $NAME; loops and images kept (original rc=$rc)"
+    exit "$rc"
+  fi
+  for l in "${ATTACHED[@]}"; do
+    if ! losetup -d "$l"; then
+      log "cleanup stopped: cannot detach $l; remaining loops and images kept (original rc=$rc)"
+      exit "$rc"
+    fi
+  done
+  for f in "${CREATED[@]}"; do
+    if ! rm -f -- "$f"; then
+      log "cleanup stopped: cannot remove $f; remaining images kept (original rc=$rc)"
+      exit "$rc"
+    fi
+  done
   log "failed (rc=$rc): undid only what this run created/attached/mapped/mounted"
   exit "$rc"
 }
