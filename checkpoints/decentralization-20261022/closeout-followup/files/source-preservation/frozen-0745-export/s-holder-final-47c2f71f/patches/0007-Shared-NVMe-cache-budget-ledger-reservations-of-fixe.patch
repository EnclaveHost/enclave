+        c['storage'].update(mountPoint=str(d / 'mnt'), nvmeInventoryPath=str(d / 'inv.tsv'), originFreeMarginBytes=0, nvmeFreeMarginBytes=0)
+        c['datadir'] = str(d / 'mnt' / 'data')
