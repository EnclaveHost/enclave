#!/usr/bin/env python3
import sys, time, os
sys.path.insert(0, os.path.dirname(os.path.realpath(__file__)))
from _fake import *
a = sys.argv[1:]; b = beh(); log("docker", *[x if len(x) < 60 else x[:60] + "..." for x in a])
if a[0] == "inspect":
    print("true" if b.get("pg_running", True) else "false"); sys.exit(0)
assert a[0] == "exec"
i = 1
while a[i].startswith("-"): i += 2 if a[i] == "-e" else 1
script = a[i + 3]; rest = a[i + 4:]
if "command -v timeout" in script:
    sys.exit(0 if b.get("timeout_in_container", True) else 1)
if "psql" in script:
    sql = rest[-1]
    if "db_version" in sql: print(b.get("db_version", 26))
    elif "pg_database_size" in sql: print(30000000)
    elif "count(*)" in sql: print(b.get("counts", {}).get(sql.split("FROM", 1)[1].split()[0], 5))   # storage-write-release: per-table counts
    sys.exit(0)
if "pg_dump" in script:
    m = b.get("dump", "ok")
    if m == "fail": print("pg_dump: error: connection to server failed", file=sys.stderr); sys.exit(1)
    if m == "hang": time.sleep(1000)
    if m == "slow": time.sleep(float(b.get("slow_s", 6)))
    if m == "foreign-start": set_running(True)
    if m == "extra-file": open(os.path.join(os.environ["FB_ROOT"], "var/lib/enclave-indexd/fresh-backup", b["run_id"], "foreign.txt"), "w").close()
    if m == "notpgdmp": sys.stdout.buffer.write(b"garbage"); sys.exit(0)
    sys.stdout.buffer.write(b"PGDMP" + b"\x01" * 4096); sys.exit(0)
sys.exit(3)
