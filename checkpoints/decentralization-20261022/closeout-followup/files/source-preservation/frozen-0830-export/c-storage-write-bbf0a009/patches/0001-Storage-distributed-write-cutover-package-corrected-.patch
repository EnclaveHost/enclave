+def pubkey_hex(seed):
+    """ed25519 public key of a 32-byte seed (copied from e2e.py)"""
+    q = 2 ** 255 - 19
+    d = -121665 * pow(121666, q - 2, q) % q
+    I = pow(2, (q - 1) // 4, q)
+
+    def xrecover(y):
+        xx = (y * y - 1) * pow(d * y * y + 1, q - 2, q)
+        x = pow(xx, (q + 3) // 8, q)
+        if (x * x - xx) % q:
+            x = x * I % q
+        return q - x if x % 2 else x
+
+    By = 4 * pow(5, q - 2, q) % q
+    B = (xrecover(By), By, 1, xrecover(By) * By % q)
+
+    def add(P, Q):
+        x1, y1, z1, t1 = P
+        x2, y2, z2, t2 = Q
+        a = (y1 - x1) * (y2 - x2) % q
+        b = (y1 + x1) * (y2 + x2) % q
+        c = t1 * 2 * d * t2 % q
+        dd = z1 * 2 * z2 % q
+        e, f, g, h = b - a, dd - c, dd + c, b + a
+        return (e * f % q, g * h % q, f * g % q, e * h % q)
+
+    def mul(s, P):
+        Rr = (0, 1, 1, 0)
+        while s:
+            if s & 1:
+                Rr = add(Rr, P)
+            P = add(P, P)
+            s >>= 1
+        return Rr
+
+    h = hashlib.sha512(seed).digest()
+    a = 2 ** 254 + sum(2 ** i * ((h[i // 8] >> (i % 8)) & 1) for i in range(3, 254))
+    x, y, z, _ = mul(a, B)
+    zi = pow(z, q - 2, q)
+    x, y = x * zi % q, y * zi % q
+    return (y | ((x & 1) << 255)).to_bytes(32, "little").hex()
+
+
