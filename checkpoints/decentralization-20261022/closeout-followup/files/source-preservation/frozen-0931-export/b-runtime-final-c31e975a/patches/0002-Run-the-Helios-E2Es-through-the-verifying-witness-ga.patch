@@ -61,7 +63,8 @@ const stop = async (p) => { if (p && p.exitCode === null && p.signalCode === nul
 const slotOf = (name, n) => keccak256(encodeAbiParameters([{ type: 'bytes32' }, { type: 'uint256' }], [stringToHex(name, { size: 32 }), n]));
