+
+const { WITNESS_CHECK_BIN, BASE_HEADS_DIR, BASE_FIXTURE_DIR } = process.env;
+const FIX = JSON.parse(fs.readFileSync(new URL('./fixtures/base-headers-52965055-52965106.json', import.meta.url)));
