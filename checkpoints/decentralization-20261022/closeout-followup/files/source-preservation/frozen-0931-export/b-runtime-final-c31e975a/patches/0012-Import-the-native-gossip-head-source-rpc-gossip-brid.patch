+    all(52965076, { mutate: 'truncate' }),
+    all(52965076, { mutate: 'missing' }),
+    all(52965075, { record: { objectBytes: 12345 } }),
+    all(52965075, { record: { objectSha256: 'ab'.repeat(32) } }),
+  ] };
+  const h = harness({ plan });
+  try {
+    await h.src.start();
