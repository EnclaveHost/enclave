+    sys.exit(1)
+st = json.load(open({UNIT_JSON!r}))
+for p in props:
+    print(st.get(p, "") if value else p + "=" + st.get(p, ""))
+""",
+        "pgrep": py + """a = sys.argv[1:]
+while "-u" in a:
+    i = a.index("-u"); del a[i:i + 2]
+os.execv("/usr/bin/pgrep", ["pgrep", *a])
+"""}
+    for n, t in files.items():
