+}
+
+const OWNER_FN = { topUp: (m, sig) => [m.sessionId, m.amount, m.opNonce, m.signBefore, sig], extend: (m, sig) => [m.sessionId, m.expiresAt, m.opNonce, m.signBefore, sig],
