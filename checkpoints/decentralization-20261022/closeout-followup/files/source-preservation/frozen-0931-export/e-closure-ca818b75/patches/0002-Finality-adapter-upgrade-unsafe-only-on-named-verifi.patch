+
+/**
+ * FINALITY ADAPTER (integration gate, fail closed). Starts from a classifyL2Outcome() result (level 'unsafe': under a
+ * sequencer-signed head) and upgrades it ONLY with evidence from a named verifier:
+ *   l1Evidence: {verifiedBy: 'l1-execution-proof' | 'l1-light-client', blockHash, finalized: true, source} for the
+ *     deposit's L1 block (P's validated reth+Lighthouse pair, or a light client) -> the deposit itself is irrevocable;
+ *   l2Evidence: {verifiedBy: 'base-derivation', blockNumber, blockHash, safe, finalized, source} for the receipt's
+ *     block, from a node that DERIVED it from L1 (S's holder / B's verifier) -> 'safe' / 'finalized'.
+ * Missing or mislabelled evidence leaves the level where it is and names the gate; evidence from the endpoint that
+ * accepted the transaction is refused. Nothing here invents a boolean.
+ */
+export function classifyFinality({ outcome, depositL1BlockHash, l1Evidence, l2Evidence, submittedVia }) {
+  if (!outcome || outcome.state !== 'l2-included' || outcome.level !== 'unsafe') refuse('no-included-outcome');
+  const rc = outcome.receipt;
+  const gates = [];
+  let l1Final = false, level = 'unsafe';
+  if (l1Evidence) {
+    if (!L1_VERIFIERS.includes(l1Evidence.verifiedBy)) refuse('l1-evidence-unverified', String(l1Evidence.verifiedBy));
+    if (submittedVia && l1Evidence.source === submittedVia) refuse('evidence-not-independent', 'from the submission endpoint');
+    if (String(l1Evidence.blockHash).toLowerCase() !== String(depositL1BlockHash).toLowerCase()) refuse('l1-evidence-mismatch', 'not the deposit\'s L1 block');
+    l1Final = l1Evidence.finalized === true;
+    if (!l1Final) gates.push('the deposit\'s L1 block is not finalized yet');
+  } else gates.push('no verified L1 finality evidence (P\'s L1 pair or a light client)');
+  if (l2Evidence) {
+    if (l2Evidence.verifiedBy !== 'base-derivation') refuse('l2-evidence-unverified', String(l2Evidence.verifiedBy));
+    if (submittedVia && l2Evidence.source === submittedVia) refuse('evidence-not-independent', 'from the submission endpoint');
+    if (BigInt(l2Evidence.blockNumber) !== BigInt(rc.blockNumber) || String(l2Evidence.blockHash).toLowerCase() !== String(rc.blockHash).toLowerCase())
+      refuse('l2-evidence-mismatch', 'the derived block is not the receipt\'s block (reorged or wrong)');
+    if (l2Evidence.finalized === true && l1Final) level = 'finalized';
+    else if (l2Evidence.safe === true || l2Evidence.finalized === true) level = 'safe';
+    if (level !== 'finalized') gates.push('L2 block not yet finalized by derivation from finalized L1 data');
+  } else gates.push('no derivation evidence (S\'s holder / B\'s Base verifier)');
+  return { state: outcome.state, level, depositL1Final: l1Final, gates };
+}
