+ * The explicit authority choice shared by config surfaces: ({chainAuthority, chainVerifier}) -> null (the legacy
+ * provider quorum) or the verifier URL. A verifier without chainAuthority 'verifier' is refused as ambiguous.
+ */
+export function chainVerifierOf({ chainAuthority, chainVerifier } = {}, what = 'chain authority') {
+  if (chainAuthority === undefined || chainAuthority === null || chainAuthority === '' || chainAuthority === 'quorum') {
+    if (chainVerifier !== undefined && chainVerifier !== null && chainVerifier !== '') throw new Error(`${what}: a verifier is set but the chain authority is not verifier`);
+    return null;
+  }
+  if (chainAuthority !== 'verifier') throw new Error(`${what}: chainAuthority must be quorum or verifier`);
+  if (!chainVerifier) throw new Error(`${what}: chainAuthority verifier needs chainVerifier (the local verifier URL)`);
+  verifierEndpoint(chainVerifier);                     // local only, refused now rather than at first use
+  return chainVerifier;
+}
diff --git a/test/lease-reader-terminal-snapshot.test.mjs b/test/lease-reader-terminal-snapshot.test.mjs
new file mode 100644
index 0000000000000000000000000000000000000000..9c971b67b952434b2c2b1e8c0542c9764f8d7987
--- /dev/null
+++ b/test/lease-reader-terminal-snapshot.test.mjs
@@ -0,0 +1,57 @@
+// LeaseReader authority 'verifier' with BOTH lifecycle fixes composed: B's whole-operation deadline (62feb3aaf, 8d110101f)
+// and the terminal-snapshot rules root applied to network/verified-chain.mjs (fd6a1762e): a transport answer that arrives
+// after the deadline cannot move the accepted floor, and a retained client refuses EVERY method once its operation has
+// settled - including the ones that send nothing (chain id, block number). Scripted in-process transports, no network.
+import test, { after } from 'node:test';
+import assert from 'node:assert/strict';
+import { pad, toHex } from 'viem';
+import { LeaseReader } from '../network/lease-reader.mjs';
+
+const BOOK = '0x' + '33'.repeat(20), ADDR = '0x' + '44'.repeat(20);
+const HASH = (n) => pad(toHex(BigInt(n) * 1000n + 1n), { size: 32 });
+const sleep = (ms) => new Promise((r) => setTimeout(r, ms));
+const keepAlive = setInterval(() => {}, 1000); after(() => clearInterval(keepAlive));
+function scripted() {
+  const st = { head: 102n, headers: 0, holdSecondHeader: null, signals: [] };
+  const verifier = { request: async (method, params, _ms, signal) => {
+    st.signals.push(signal);
+    if (method === 'eth_chainId') return '0x2105';
+    if (method === 'eth_blockNumber') return toHex(st.head);
+    if (method === 'eth_getBlockByNumber') {
+      const n = BigInt(params[0]);
+      if (++st.headers === 2 && st.holdSecondHeader) await st.holdSecondHeader;   // the re-check header answers late
+      return { number: toHex(n), hash: HASH(n), stateRoot: pad('0x22', { size: 32 }), timestamp: toHex(Math.floor(Date.now() / 1000)) };
+    }
+    if (method === 'eth_getCode') return '0x60';
+    throw new Error('method not supported');
+  } };
+  return { st, verifier };
+}
+const reader = (verifier) => new LeaseReader({ authority: 'verifier', verifier, addressBook: BOOK, confirmations: 2, deadlineMs: 100 });
+
+test('a final header that answers after the deadline cannot advance the accepted floor', { timeout: 5000 }, async () => {
+  const { st, verifier } = scripted(); const r = reader(verifier);
+  let release; st.holdSecondHeader = new Promise((ok) => { release = ok; });
+  await assert.rejects(r.agreed(async () => ({ ok: true })), /deadline/);
+  release(); await sleep(20);
+  assert.equal(r.lastBlock, 0n, 'the timed-out read accepted nothing');
+  st.head = 101n; st.holdSecondHeader = null; st.headers = 0;
+  assert.equal((await r.agreed(async () => ({ ok: true }))).blockNumber, '99', 'an otherwise valid older block still reads');
+  st.head = 98n; st.headers = 0;   // a verifier head below the accepted block 99
+  await assert.rejects(r.agreed(async () => ({ ok: true })), /behind block 99/, 'a really accepted floor is still enforced');
+});
+
+test('a retained client refuses metadata AND RPC methods after success, failure or timeout', { timeout: 5000 }, async () => {
+  for (const outcome of ['success', 'failure', 'timeout']) {
+    const { st, verifier } = scripted(); const r = reader(verifier); let kept;
+    const p = r.agreed(async (c) => { kept = c; if (outcome === 'failure') throw new Error('callback failed'); if (outcome === 'timeout') return new Promise(() => {}); return { ok: true }; });
+    if (outcome === 'success') await p; else await assert.rejects(p);
+    for (const call of [() => kept.getChainId(), () => kept.getBlockNumber(), () => kept.getBlock(), () => kept.getCode({ address: ADDR })])
+      await assert.rejects(call(), /closed|deadline/, outcome);
+    assert.ok(st.signals.length && st.signals.every((s) => s?.aborted), `${outcome}: cancellation reached every request`);
+  }
+  // readAt (pinned history) hands out the same terminal client
+  const { verifier } = scripted(); const r = reader(verifier); let kept;
+  await r.readAt({ blockNumber: 90n }, async (c) => { kept = c; return { ok: true }; });
+  await assert.rejects(kept.getBlockNumber(), /closed/);
+});
diff --git a/test/lease-reader-verifier-deadline.test.mjs b/test/lease-reader-verifier-deadline.test.mjs
new file mode 100644
index 0000000000000000000000000000000000000000..4c92a00b80b60e7a3f542d52f9c6a741b6edca2c
--- /dev/null
+++ b/test/lease-reader-verifier-deadline.test.mjs
@@ -0,0 +1,215 @@
+// LeaseReader authority 'verifier': ONE deadline and ONE closure for each whole operation (agreed/verifiedRead, readAt,
+// blockHashIs), including a caller callback that never settles. Real LeaseReader methods, driven by scripted in-process
+// transports and a real loopback HTTP verifier; no chain, no network beyond 127.0.0.1.
+import test, { after } from 'node:test';
+import assert from 'node:assert/strict';
+import http from 'node:http';
+import { pad, toHex, parseAbi } from 'viem';
+import { LeaseReader } from '../network/lease-reader.mjs';
+
+const BOOK = '0x' + '33'.repeat(20), ADDR = '0x' + '44'.repeat(20);
+const HASH = (n) => pad(toHex(BigInt(n) * 1000n + 1n), { size: 32 });
+const T = { timeout: 5000 };
+const sleep = (ms) => new Promise((r) => setTimeout(r, ms));
+const BAL_ABI = parseAbi(['function balanceOf(address) view returns (uint256)']);
+// Keeps the event loop alive so that, on code WITHOUT a whole-operation deadline (the base-failure control), a
+// never-settling read fails by its own 5 s test timeout instead of draining the loop and cancelling every later test.
+const keepAlive = setInterval(() => {}, 1000);
+after(() => clearInterval(keepAlive));
+
+// A scripted in-process verifier. `hang` lists methods that never answer; every request records its AbortSignal.
+function scripted({ hang = [], head = 100n } = {}) {
+  const st = { calls: [], signals: [] };
+  const verifier = {
+    request: (method, params, _ms, signal) => {
+      st.calls.push(method); st.signals.push(signal);
+      if (hang.includes(method)) return new Promise(() => {});
+      switch (method) {
+        case 'eth_chainId': return Promise.resolve('0x2105');
+        case 'eth_blockNumber': return Promise.resolve(toHex(head));
+        case 'eth_getBlockByNumber': {
+          const n = BigInt(params[0]);
+          return Promise.resolve({ number: toHex(n), hash: HASH(n), stateRoot: pad('0x22', { size: 32 }), timestamp: toHex(Math.floor(Date.now() / 1000)) });
+        }
+        case 'eth_getStorageAt': return Promise.resolve(pad('0x2a', { size: 32 }));
+        case 'eth_getBalance': return Promise.resolve('0x10');
+        case 'eth_call': return Promise.resolve(pad('0x05', { size: 32 }));
+        default: return Promise.reject(new Error('method not supported'));
+      }
+    },
+  };
+  return { st, verifier };
+}
+const reader = (verifier, opts = {}) => new LeaseReader({ authority: 'verifier', verifier, addressBook: BOOK, confirmations: 2, deadlineMs: 100, ...opts });
+const sends = (st) => st.calls.length;
+
+test('a callback that never settles is rejected at the deadline; reader state is untouched', T, async () => {
+  const { st, verifier } = scripted();
+  const r = reader(verifier), failures = [];
+  const t0 = performance.now();
+  await assert.rejects(r.agreed(() => new Promise(() => {}), failures), /no fresh verified chain state: .*deadline/);
+  const took = performance.now() - t0;
+  assert.ok(took >= 90 && took < 300, `rejected after ${Math.round(took)} ms (deadline 100 ms)`);
+  assert.equal(r.lastBlock, 0n);
+  assert.equal(r.lastEvidence, null);
+  assert.equal(failures.length, 1);
+  assert.ok(st.signals.every((s) => s?.aborted), 'every transport signal is aborted when the operation closes');
+});
+
+test('a callback that resolves after the deadline cannot answer, change state or send', T, async () => {
+  const { st, verifier } = scripted();
+  const r = reader(verifier);
+  let late = null;
+  const p = r.agreed(async (c) => {
+    await sleep(250);
+    late = await c.getStorageAt({ address: ADDR, slot: '0x0' }).then(() => 'sent', (e) => e.message);
+    return { ok: true };
+  });
+  await assert.rejects(p, /deadline/);
+  const before = sends(st);
+  await sleep(350);
+  assert.match(late, /closed|deadline/);
+  assert.equal(sends(st), before, 'the late attempt sends nothing');
+  assert.equal(r.lastBlock, 0n);
+  assert.equal(r.lastEvidence, null);
+});
+
+test('a hung RPC inside the callback is bounded and its transport signal is aborted', T, async () => {
+  const { st, verifier } = scripted({ hang: ['eth_getBalance'] });
+  const r = reader(verifier);
+  const t0 = performance.now();
+  await assert.rejects(r.agreed(async (c) => ({ v: String(await c.getBalance({ address: ADDR })) })), /deadline|timed out/);
+  assert.ok(performance.now() - t0 < 300);
+  const i = st.calls.indexOf('eth_getBalance');
+  assert.ok(i >= 0 && st.signals[i].aborted, 'the hung request was told to abort');
+});
+
+test('retained clients cannot send after success, failure or timeout', T, async () => {
+  for (const outcome of ['success', 'failure', 'timeout']) {
+    const { st, verifier } = scripted();
+    const r = reader(verifier);
+    let kept;
+    const p = r.agreed(async (c) => {
+      kept = c;
+      if (outcome === 'failure') throw new Error('callback failed');
+      if (outcome === 'timeout') return new Promise(() => {});
+      return { ok: true };
+    });
+    if (outcome === 'success') assert.equal((await p).ok, true); else await assert.rejects(p);
+    const before = sends(st);
+    await assert.rejects(kept.getStorageAt({ address: ADDR, slot: '0x0' }), /closed|deadline/, outcome);
+    await assert.rejects(kept.readContract({ address: ADDR, abi: BAL_ABI, functionName: 'balanceOf', args: [ADDR] }), /closed|deadline/, outcome);
+    await sleep(5);
+    assert.equal(sends(st), before, `${outcome}: retained client sent nothing`);
+  }
+});
+
+test('the deadline is re-checked when the transport is actually invoked, not only when the request is queued', T, async () => {
+  const { st, verifier } = scripted();
+  const r = reader(verifier);
+  let queued;
+  const p = r.agreed((c) => {
+    queued = c.getStorageAt({ address: ADDR, slot: '0x0' }).then(() => 'sent', (e) => e.message);
+    const until = performance.now() + 130;   // block the event loop past the 100 ms deadline before the microtask runs
+    while (performance.now() < until) { /* busy */ }
+    return { ok: true };
+  });
+  await assert.rejects(p, /deadline/);
+  assert.match(await queued, /deadline|closed/);
+  assert.equal(st.calls.filter((m) => m === 'eth_getStorageAt').length, 0, 'the expired request never reached the transport');
+});
+
+test('normal completion: callback-created pending requests are aborted, no timers stay behind', T, async () => {
+  const { st, verifier } = scripted({ hang: ['eth_getBalance'] });
+  const r = reader(verifier, { deadlineMs: 2000 });
+  const timeouts = () => process.getActiveResourcesInfo().filter((x) => x === 'Timeout').length;
+  const base = timeouts();
+  let orphan;
+  const out = await r.agreed(async (c) => {
+    orphan = c.getBalance({ address: ADDR }).then(() => 'answered', (e) => e.message);   // never awaited by the callback
+    return { v: (await c.getStorageAt({ address: ADDR, slot: '0x0' })).slice(0, 4) };
+  });
+  assert.equal(out.v, '0x00');
+  assert.match(await orphan, /closed|finished/);
+  const i = st.calls.indexOf('eth_getBalance');
+  assert.ok(st.signals[i].aborted, 'the orphaned request was aborted at completion');
+  await sleep(0);
+  assert.equal(timeouts(), base, 'no per-request or deadline timer outlives the operation');
+  assert.equal(r.lastEvidence.tier, 'unsafe');
+});
+
+test('readAt (history) is bounded and closed the same way, and never becomes fresh authority', T, async () => {
+  const { st, verifier } = scripted();
+  const r = reader(verifier);
+  const t0 = performance.now();
+  await assert.rejects(r.readAt({ blockNumber: 98n, blockHash: HASH(98) }, () => new Promise(() => {})), /deadline/);
+  assert.ok(performance.now() - t0 < 300);
+  let kept;
+  const v = await r.readAt({ blockNumber: 98n, blockHash: HASH(98) }, async (c) => { kept = c; return { s: await c.getStorageAt({ address: ADDR, slot: '0x1' }) }; });
+  assert.ok(v.s);
+  const before = sends(st);
+  await assert.rejects(kept.getBalance({ address: ADDR }), /closed/);
+  assert.equal(sends(st), before);
+  assert.equal(r.lastBlock, 0n, 'a history read does not move the accepted block');
+  assert.equal(r.lastEvidence, null, 'a history read is not fresh evidence');
+  await assert.rejects(r.readAt({ blockNumber: 98n, blockHash: HASH(97) }, () => ({})), /no longer canonical/);
+});
+
+test('blockHashIs: true/false as before, a hung verifier answers false within the deadline and is aborted', T, async () => {
+  const ok = scripted();
+  assert.equal(await reader(ok.verifier).blockHashIs(98n, HASH(98)), true);
+  assert.equal(await reader(ok.verifier).blockHashIs(98n, HASH(97)), false);
+  const hung = scripted({ hang: ['eth_getBlockByNumber'] });
+  const t0 = performance.now();
+  assert.equal(await reader(hung.verifier).blockHashIs(98n, HASH(98)), false);
+  assert.ok(performance.now() - t0 < 300);
+  assert.ok(hung.st.signals[0].aborted);
+});
+
+test('the loopback HTTP verifier: a hung request is cancelled on the wire at the deadline', T, async () => {
+  const closedAt = [];
+  const server = http.createServer((req, res) => {
+    let body = '';
+    req.on('data', (d) => { body += d; });
+    req.on('end', () => {
+      const { id, method, params } = JSON.parse(body);
+      const reply = (result) => res.end(JSON.stringify({ jsonrpc: '2.0', id, result }));
+      if (method === 'eth_chainId') return reply('0x2105');
+      if (method === 'eth_blockNumber') return reply('0x64');
+      if (method === 'eth_getBlockByNumber') return reply({ number: params[0], hash: HASH(BigInt(params[0])), stateRoot: pad('0x22', { size: 32 }), timestamp: toHex(Math.floor(Date.now() / 1000)) });
+      res.on('close', () => { if (!res.writableEnded) closedAt.push(performance.now()); });   // eth_call: never answered
+    });
+  });
+  await new Promise((r) => server.listen(0, '127.0.0.1', r));
+  try {
+    const r = new LeaseReader({ authority: 'verifier', verifier: `http://127.0.0.1:${server.address().port}/`, addressBook: BOOK, confirmations: 2, deadlineMs: 200 });
+    const t0 = performance.now();
+    await assert.rejects(r.agreed(async (c) => ({ v: String(await c.readContract({ address: ADDR, abi: BAL_ABI, functionName: 'balanceOf', args: [ADDR] })) })), /deadline|timed out/);
+    await sleep(100);
+    assert.equal(closedAt.length, 1, 'the server saw the hung request aborted');
+    assert.ok(closedAt[0] - t0 < 400, `aborted ${Math.round(closedAt[0] - t0)} ms after start (deadline 200 ms)`);
+  } finally {
+    server.closeAllConnections?.();
+    await new Promise((r) => server.close(r));
+  }
+});
+
+test('the deadline fires even when nothing else keeps the process alive (child process, no keep-alive)', T, async () => {
+  const { spawnSync } = await import('node:child_process');
+  const src = `import { LeaseReader } from ${JSON.stringify(new URL('../network/lease-reader.mjs', import.meta.url).href)};
+    const ts = '0x' + Math.floor(Date.now() / 1000).toString(16), h = '0x' + '11'.repeat(32);
+    const verifier = { request: async (m, p) => m === 'eth_chainId' ? '0x2105' : m === 'eth_blockNumber' ? '0x64'
+      : { number: p[0], hash: h, stateRoot: h, timestamp: ts } };
+    const r = new LeaseReader({ authority: 'verifier', verifier, addressBook: '0x' + '33'.repeat(20), deadlineMs: 100 });
+    try { await r.agreed(() => new Promise(() => {})); console.log('resolved'); } catch (e) { console.log('rejected: ' + e.message); }`;
+  const out = spawnSync(process.execPath, ['--input-type=module', '-e', src], { encoding: 'utf8', timeout: 4000 });
+  assert.equal(out.status, 0, out.stderr);
+  assert.match(out.stdout, /^rejected: no fresh verified chain state: .*deadline of 100 ms has passed/);
+});
+
+test('policy is unchanged: the deadline bound and legacy quorum construction', () => {
+  const { verifier } = scripted();
+  assert.throws(() => reader(verifier, { deadlineMs: 99 }), /invalid chain policy/);
+  assert.throws(() => reader(verifier, { deadlineMs: 300001 }), /invalid chain policy/);
+  assert.equal(reader(verifier, { deadlineMs: 300000 }).deadlineMs, 300000);
+});
diff --git a/test/lease-reader-verifier.test.mjs b/test/lease-reader-verifier.test.mjs
new file mode 100644
index 0000000000000000000000000000000000000000..eec9cf3c1949af1752d9be97bfdd81c298d24124
--- /dev/null
+++ b/test/lease-reader-verifier.test.mjs
@@ -0,0 +1,234 @@
+// LeaseReader authority 'verifier': the reader's semantics (block selection, freshness, monotonicity, reorg, one
+// deadline, pinned proof-backed client, explicit refusals) and REAL consumers driven through it (deployment/lease
+// snapshots, host admission + catalog moderation, admin-directed AddressBook migration, settlement pinned reads), with
+// proof failure, missing witness, stale head and unknown state. The verifier here is an in-process stand-in that
+// answers like the patched Helios (eth_* methods; errors where Helios refuses). Real Helios: lease-reader-verifier.e2e.
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { parseAbi, encodeFunctionResult, decodeFunctionData, pad, toHex, stringToHex } from 'viem';
+import { LeaseReader, chainAuthorityOptions, chainAuthorityFromEnv } from '../network/lease-reader.mjs';
+import { createHostAdmission } from '../network/host-admission-runtime.mjs';
+import { hostAdmissionPolicyHash } from '../network/host-admission-policy.mjs';
+import { USDCBandwidthSettlement } from '../network/usdc-bandwidth.mjs';
+
+const BOOK = '0x' + 'b0'.repeat(20), LEDGER = '0x' + '1e'.repeat(20), LEDGER2 = '0x' + '2e'.repeat(20), CATALOG = '0x' + 'ca'.repeat(20);
+const OWNERSHIP = '0x' + '0e'.repeat(20), REGISTRY = '0x' + 'ee'.repeat(20), METER = '0x' + 'ae'.repeat(20);
+const HOST = '0x' + 'ab'.repeat(32), APP = '0x' + 'ef'.repeat(32), DEP = '0x' + 'cd'.repeat(32), OWNER = '0x' + '44'.repeat(20);
+const fields = [['id','bytes32'],['owner','address'],['appRef','string'],['ports','string'],['configCid','string'],['gpuMilli','uint16'],['cpuMilli','uint16'],['appPort','uint32'],['isPublic','bool'],['active','bool'],['createdAt','uint64'],['rate','uint256'],['balance6','uint256'],['spent6','uint256'],['runner','bytes32'],['runnerOperator','address'],['leaseUntil','uint64']];
+const ABI = {
+  book: parseAbi(['function addr(bytes32) view returns (address)']),
+  ledger: [{ type: 'function', name: 'get', stateMutability: 'view', inputs: [{ type: 'bytes32' }], outputs: [{ type: 'tuple', components: fields.map(([name, type]) => ({ name, type })) }] },
+    ...parseAbi(['function deploymentsSchema() view returns (uint256)'])],
+  ownership: parseAbi(['function registry() view returns (address)', 'function authority(bytes32) view returns (address owner,address pendingOwner,uint64 revision,bytes32 policyHash)']),
+  catalog: parseAbi(['function getApp(bytes32) view returns ((bytes32 appId,address publisher,string slug,string name,string description,uint32 versionCount,uint64 createdAt,uint64 updatedAt,bool active))',
+    'function getVersion(bytes32,uint256) view returns ((string cid,string version,uint32 vramMb,uint32 gpuGflops,uint32 memMb,uint32 cpuGflops,uint64 createdAt,bool verified,bool yanked,string ports,uint8 approval,string config))']),
+  meter: parseAbi(['function bytesServed(bytes32) view returns (uint256)']),
+};
+const NOW = 1_800_000_000_000;
+const hash = (n, salt = 0) => pad(toHex(BigInt(n) * 1000n + BigInt(salt)), { size: 32 });
+
+// A chain the stand-in verifier "proves": state can change at a block (admin repoints the book, moderation yanks).
+function chain() {
+  const st = { head: 100n, now: NOW, salt: new Map(), calls: [], mode: {}, at: {}, bookLedger: [[0n, LEDGER]], yankedFrom: null, deniedFrom: null, bytes: 7n };
+  const numberOf = (h) => { for (let n = 0n; n <= st.head + 5n; n++) if (hash(n, st.salt.get(n) || 0) === h) return n; throw new Error('unknown block hash'); };
+  const block = (n) => ({ number: toHex(n), hash: hash(n, st.salt.get(n) || 0), stateRoot: pad(toHex(n + 7n), { size: 32 }),
+    timestamp: toHex(Math.floor(st.now / 1000) - Number(st.head - n) * 2 + (st.mode.future ? 3600 : 0) - (st.mode.oldBlocks ? 600 : 0)) });
+  const current = (list, n) => list.filter(([from]) => from <= n).at(-1)[1];
+  const answer = (to, data, n) => {
+    const t = to.toLowerCase();
+    const find = (abi) => { const d = decodeFunctionData({ abi, data }); return [abi, d]; };
+    if (t === BOOK) { const [abi] = find(ABI.book); return encodeFunctionResult({ abi, functionName: 'addr', result: current(st.bookLedger, n) }); }
+    if (t === LEDGER || t === LEDGER2) {
+      const [abi, d] = find(ABI.ledger);
+      if (d.functionName === 'deploymentsSchema') return encodeFunctionResult({ abi, functionName: 'deploymentsSchema', result: 15n });
+      return encodeFunctionResult({ abi, functionName: 'get', result: { id: d.args[0], owner: OWNER, appRef: `catalog://${APP}/1`, ports: 'http:8080', configCid: '', gpuMilli: 0, cpuMilli: 100,
+        appPort: 8080, isPublic: true, active: true, createdAt: 1n, rate: 0n, balance6: 5n, spent6: 0n, runner: HOST, runnerOperator: OWNER, leaseUntil: BigInt(Math.floor(st.now / 1000) + 3600) } });
+    }
+    if (t === OWNERSHIP) {
+      const [abi, d] = find(ABI.ownership);
+      if (d.functionName === 'registry') return encodeFunctionResult({ abi, functionName: 'registry', result: REGISTRY });
+      const denied = st.deniedFrom !== null && n >= st.deniedFrom;
+      return encodeFunctionResult({ abi, functionName: 'authority', result: [OWNER, '0x' + '00'.repeat(20), denied ? 2n : 1n, denied ? st.policyHash : pad('0x', { size: 32 })] });
+    }
+    if (t === CATALOG) {
+      const [abi, d] = find(ABI.catalog);
+      if (d.functionName === 'getApp') return encodeFunctionResult({ abi, functionName: 'getApp', result: { appId: APP, publisher: OWNER, slug: 'a', name: 'A', description: '', versionCount: 2, createdAt: 1n, updatedAt: 1n, active: true } });
+      const yanked = st.yankedFrom !== null && n >= st.yankedFrom;
+      return encodeFunctionResult({ abi, functionName: 'getVersion', result: { cid: 'bafy', version: '1', vramMb: 0, gpuGflops: 0, memMb: 64, cpuGflops: 1, createdAt: 1n, verified: false, yanked, ports: 'http:8080', approval: 1, config: '{}' } });
+    }
+    if (t === METER) { const [abi] = find(ABI.meter); return encodeFunctionResult({ abi, functionName: 'bytesServed', result: st.bytes }); }
+    throw new Error('execution reverted');
+  };
+  const verifier = {
+    request: async (method, params) => {
+      st.calls.push({ method, params });
+      if (st.mode.hang) return new Promise(() => {});
+      if (st.mode.down) throw new Error('verifier HTTP 502');
+      switch (method) {
+        case 'eth_chainId': return toHex(st.mode.wrongChain ? 10 : 8453);
+        case 'eth_blockNumber': if (st.mode.stale) throw new Error('verifier: out of sync: 125 seconds behind'); return toHex(st.head);
+        case 'eth_getBlockByNumber': {
+          const n = BigInt(params[0]);
+          if (st.mode.reorgOnce && st.calls.filter((c) => c.method === 'eth_getBlockByNumber').length === 2) { st.salt.set(n, 9); st.mode.reorgOnce = false; }
+          return n <= st.head ? block(n) : null;
+        }
+        case 'eth_call': {
+          if (st.mode.proofFail) throw new Error('verifier: invalid account proof for address ' + params[0].to);
+          if (st.mode.missing) throw new Error('verifier: no witness source answered');
+          assert.ok(params[1]?.blockHash, 'calls are pinned by block hash');
+          return answer(params[0].to, params[0].data, numberOf(params[1].blockHash));
+        }
+        case 'eth_getCode': return '0x6000';
+        case 'eth_getStorageAt': return pad('0x2a', { size: 32 });
+        case 'eth_getBalance': return '0x10';
+        default: throw new Error('method not supported');
+      }
+    },
+  };
+  return { st, verifier };
+}
+const reader = (verifier, opts = {}) => new LeaseReader({ authority: 'verifier', verifier, addressBook: BOOK, now: () => NOW, confirmations: 2, ...opts });
+const T = { timeout: 20000 };
+
+test('construction: the verifier is explicit, local, exclusive, and never mixed with provider clients', () => {
+  const { verifier } = chain();
+  assert.throws(() => new LeaseReader({ verifier, addressBook: BOOK }), /authority is quorum/);
+  assert.throws(() => new LeaseReader({ authority: 'verifier', verifier: 'https://rpc.example.org', addressBook: BOOK }), /local endpoint/);
+  assert.throws(() => new LeaseReader({ authority: 'verifier', addressBook: BOOK }), /verifier endpoint/);
+  // a shared chain config that also lists provider RPCs: they are ignored, no client exists
+  const r = new LeaseReader({ authority: 'verifier', verifier, rpc: ['https://a.example.org', 'https://b.example.org'], addressBook: BOOK });
+  assert.equal(r.clients.length, 0);
+  assert.equal(r.authorityInfo().authority, 'local-verifier');
+  assert.equal(r.authorityInfo().tier, 'unsafe');
+  const q = new LeaseReader({ rpc: ['https://a.example.org', 'https://b.example.org'], addressBook: BOOK });
+  assert.equal(q.authority, 'quorum');
+  assert.equal(q.authorityInfo().independentOfProviders, false);
+  assert.deepEqual(chainAuthorityOptions({}), {});
+  assert.deepEqual(chainAuthorityOptions({ chainAuthority: 'verifier', chainVerifier: 'http://127.0.0.1:8545/' }), { authority: 'verifier', verifier: 'http://127.0.0.1:8545/' });
+  assert.throws(() => chainAuthorityOptions({ chainVerifier: 'http://127.0.0.1:8545/' }), /not verifier/);
+  assert.throws(() => chainAuthorityOptions({ chainAuthority: 'verifier' }), /needs chainVerifier/);
+  assert.deepEqual(chainAuthorityFromEnv({ ENCLAVE_CHAIN_AUTHORITY: 'verifier', ENCLAVE_CHAIN_VERIFIER: 'http://127.0.0.1:1/' }).authority, 'verifier');
+});
+
+test('deployment/lease snapshot: one confirmed block, pinned by hash, fresh, with verified evidence', T, async () => {
+  const { st, verifier } = chain();
+  const r = reader(verifier);
+  const [lease] = await r.refresh([DEP]);
+  assert.equal(lease.id, DEP);
+  assert.equal(lease.blockNumber, '98');
+  assert.equal(lease.blockHash, hash(98n));
+  assert.equal(lease.deployments, LEDGER);
+  assert.equal(r.lastEvidence.stateRoot, pad(toHex(105n), { size: 32 }));
+  for (const c of st.calls.filter((x) => x.method === 'eth_call')) assert.deepEqual(c.params[1], { blockHash: hash(98n) });
+  assert.ok(!st.calls.some((c) => c.method === 'eth_call' && c.params[1] === 'latest'));
+});
+
+test('admin-directed migration: a repointed AddressBook entry is followed at the next fresh read', T, async () => {
+  const { st, verifier } = chain();
+  const r = reader(verifier);
+  assert.equal(await r.bookAddress('deployments'), LEDGER);
+  st.bookLedger.push([101n, LEDGER2]); st.head = 104n;            // the admin repointed at block 101
+  assert.equal(await r.bookAddress('deployments'), LEDGER2);
+  const [lease] = await r.refresh([DEP]);
+  assert.equal(lease.deployments, LEDGER2);
+});
+
+test('freshness, monotonicity, chain, reorganization and the single deadline all refuse', T, async () => {
+  let { st, verifier } = chain();
+  let r = reader(verifier);
+  st.mode.oldBlocks = true;
+  await assert.rejects(r.refresh([DEP]), /stale chain block/);
+  st.mode.oldBlocks = false; st.mode.future = true;
+  await assert.rejects(r.refresh([DEP]), /stale chain block/);
+  st.mode.future = false; st.mode.stale = true;                      // Helios check_head_age: head older than 60 s
+  await assert.rejects(r.refresh([DEP]), /out of sync/);
+  st.mode.stale = false; st.mode.wrongChain = true;
+  await assert.rejects(r.refresh([DEP]), /another chain/);
+  st.mode.wrongChain = false;
+  await r.refresh([DEP]);
+  st.head = 90n;                                                     // a verifier that went backwards
+  await assert.rejects(r.refresh([DEP]), /behind block 98/);
+  ({ st, verifier } = chain()); r = reader(verifier);
+  st.mode.reorgOnce = true;
+  await assert.rejects(r.refresh([DEP]), /reorganized/);
+  ({ st, verifier } = chain()); r = reader(verifier, { deadlineMs: 300 });
+  st.mode.hang = true;
+  const t0 = Date.now();
