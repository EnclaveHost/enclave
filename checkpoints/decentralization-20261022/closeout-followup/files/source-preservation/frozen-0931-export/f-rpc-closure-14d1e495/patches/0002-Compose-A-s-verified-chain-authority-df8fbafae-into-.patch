+  assert.throws(() => chainVerifierOf({ chainAuthority: 'verifier', chainVerifier: 'https://rpc.example.org' }), /local endpoint/);
+  assert.throws(() => chainVerifierOf({ chainAuthority: 'remote' }), /quorum or verifier/);
