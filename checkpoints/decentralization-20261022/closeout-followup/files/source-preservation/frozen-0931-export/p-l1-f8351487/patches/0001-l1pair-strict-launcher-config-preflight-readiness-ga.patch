+    'mount-tmp': ("    for r in ('/tmp', '/var/tmp', '/dev', '/run', '/proc', '/sys', '/vm'):", "    for r in ():"),
+}
+killed = 0
+for name, (a, b) in MUTANTS.items():
+    if SRC.count(a) != 1:
+        print(f'BROKEN {name}: anchor found {SRC.count(a)} times'); sys.exit(2)
+    with tempfile.TemporaryDirectory() as d:
+        m = Path(d) / 'l1pair.py'
