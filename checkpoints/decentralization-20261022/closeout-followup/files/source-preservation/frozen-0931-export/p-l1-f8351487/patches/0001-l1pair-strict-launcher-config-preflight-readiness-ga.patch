+        os.symlink(HERE.parent / 'PINS.json', Path(d) / 'PINS.json'); os.symlink(HERE.parent / 'vendor', Path(d) / 'vendor')
+        r = subprocess.run([sys.executable, '-I', str(HERE / 'test_l1pair.py')], env={'PATH': '/usr/bin:/bin', 'L1PAIR_UNDER_TEST': str(m)},
