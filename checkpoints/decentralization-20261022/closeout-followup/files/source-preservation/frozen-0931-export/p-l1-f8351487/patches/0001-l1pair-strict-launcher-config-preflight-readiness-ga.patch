+def validate_storage(s, c):
+    """Durable data: ONE new ext4 filesystem in ONE new image file on the HDD array, mounted at a dedicated mount point.
+    The optional writethrough NVMe cache is S's dm-cache design; its bytes come out of the SAME 250 GB aggregate and must
+    stay under the 200 GB operational target together with every other declared cache of this work."""
+    only('storage', s, ['layout', 'mountPoint', 'origin', 'cache', 'otherNvmeCacheAllocations', 'nvmeInventoryPath',
+                        'originFreeMarginBytes', 'nvmeFreeMarginBytes'],
+         ['layout', 'mountPoint', 'origin', 'cache', 'otherNvmeCacheAllocations', 'nvmeInventoryPath'])
+    mnt = abspath('storage.mountPoint', s.get('mountPoint'))
+    if mnt.rstrip('/') in FORBIDDEN_MOUNT_ROOTS or mnt.count('/') < 2:
+        fail('storage.mountPoint must be a dedicated directory such as /srv/enclave-l1-pair (never /, a system tree, '
+             'the NVMe /vm tree or the array root)')
+    for r in ('/tmp', '/var/tmp', '/dev', '/run', '/proc', '/sys', '/vm'):
+        if _inside(mnt, r):
+            fail(f'storage.mountPoint must not be inside {r} (RAM/system/NVMe trees never hold durable chain data)')
+    o = s.get('origin') or {}
+    if not isinstance(o, dict) or not str(o.get('imagePath', '')).startswith('/mnt/usb/'):
+        fail('storage.origin.imagePath must be a NEW image file on the HDD array (/mnt/usb/...)')
+    if not isinstance(s.get('otherNvmeCacheAllocations'), list):
+        fail('storage.otherNvmeCacheAllocations must be declared explicitly (e.g. the Base holder cache); [] only if none exist')
+    holder_view = {'datadir': mnt + '/data', 'staticFilesDir': None}
+    out = H.validate_storage(dict(s), holder_view)       # S's reviewed rules: origin size, writethrough-only, cap
+    if _inside(out['origin']['imagePath'], mnt):
+        fail('the origin image must not live inside its own mount point')
+    acct = out['nvmeAccounting']
+    if acct['totalBytes'] > NVME_TARGET:
+        fail(f"planned NVMe cache total {acct['totalBytes']} exceeds the 200,000,000,000-byte operational target (this pair "
+             f"{acct['holderBytes']} + other declared {acct['otherBytes']}): rebalance the shares (root decision) or use "
+             'cache.mechanism none')
+    return out
+
