+            // Ensure we can parse the YAML config to a chain spec.
+            if config.config.preset_base == types::GNOSIS {
+                config.chain_spec::<GnosisEthSpec>().unwrap();
+            } else {
+                config.chain_spec::<MainnetEthSpec>().unwrap();
