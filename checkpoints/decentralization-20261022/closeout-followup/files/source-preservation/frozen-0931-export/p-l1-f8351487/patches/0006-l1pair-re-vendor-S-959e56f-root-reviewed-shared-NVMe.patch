+        if {f['path']: f['bytes'] for f in r['files']} != expected:
+            fail(f'reservation {rid!r} files {[(f["path"], f["bytes"]) for f in r["files"]]} differ from this configuration {sorted(expected.items())}')
+        check_fs(r)
+        for f in r['files']:
+            p = f['path']
