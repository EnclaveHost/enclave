+                size: usize,
+            ) -> AnnouncementAcceptance {
+                self.0.lock().push((tx_type, *hash, size));
+                match tx_type {
+                    0xff => AnnouncementAcceptance::Reject { penalize_peer: true },
+                    1 => AnnouncementAcceptance::Ignore,
+                    _ => AnnouncementAcceptance::Accept,
