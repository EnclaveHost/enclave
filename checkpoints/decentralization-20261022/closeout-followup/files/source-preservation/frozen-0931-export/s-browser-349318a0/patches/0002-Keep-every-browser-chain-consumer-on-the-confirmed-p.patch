index 0000000000000000000000000000000000000000..7a225ad9fe38764309a3d64a27e38ffd0d466753
--- /dev/null
+++ b/test/helpers/browser-rpc-scenario.mjs
@@ -0,0 +1,159 @@
+// One browser RPC routing scenario, in its own process (config.js fixes the profile when it loads): the REAL site modules
+// of <site root> (this tree's, or an older commit's extracted for a control) with browser globals, a fake Base chain
+// behind the profile's RPC origins, an inert wallet provider (generated test address, no key), and a fetch that refuses
+// every other origin the way a blocked public network does. Prints one JSON line: what each call returned and every
+// origin and wallet method the page reached.
+//   node test/helpers/browser-rpc-scenario.mjs <site root> '<scenario json>'
+// Used by test/site-browser-rpc-closure.test.mjs.
+import path from "node:path";
+import { pathToFileURL } from "node:url";
+import { encodeAbiParameters, encodeFunctionResult, decodeFunctionData } from "viem";
+import { VAULT_ABI } from "../../custody/chain.mjs";
+
+const [siteRoot, raw] = process.argv.slice(2);
+const sc = JSON.parse(raw);
+const n = sc.rpcs || 3;
+const RPCS = Array.from({ length: n }, (_, i) => `https://rpc${i}.operator.example`);
+const down = new Set(sc.down || []);
+const BOOK = "0x" + "b0".repeat(20), VAULT = "0x" + "5e".repeat(20), OWNER = "0x" + "9e".repeat(20);
+const contracts = { registry: "0x" + "11".repeat(20), deployments: "0x" + "22".repeat(20), appCatalog: "0x" + "33".repeat(20),
+  proofOfTime: "0x" + "44".repeat(20), enclavePay: "0x" + "00".repeat(20), verificationFees: "0x" + "00".repeat(20),
+  sessionVaultFactory: "0x" + "55".repeat(20), secretVaultV2: "0x" + "00".repeat(20) };
+const profile = { format: "enclave-browser-profile", version: 1, chainId: 8453, rpcs: RPCS, quorum: sc.quorum || 2, confirmations: 0,
+  contractPins: { version: 1, chainId: 8453, contracts }, usdc: "0x" + "66".repeat(20), ...(sc.book ? { addressBook: BOOK } : {}) };
+const text = sc.badProfile ? JSON.stringify({ ...profile, rpcs: [RPCS[0]] }) : JSON.stringify(profile);
+
+const mem = (m = new Map()) => ({ getItem: (k) => (m.has(k) ? m.get(k) : null), setItem: (k, v) => m.set(k, String(v)), removeItem: (k) => m.delete(k) });
+const saved = sc.state === "off" || sc.state === "appeared" ? [] : [["enclave_independent_profile", text]];
+globalThis.localStorage = mem(new Map(saved));
+globalThis.sessionStorage = mem(new Map(sc.state === "on" || sc.state === "changed" ? [["enclave_independent_ack", text]] : []));
+const doc = new EventTarget(); doc.querySelector = () => null; doc.querySelectorAll = () => []; doc.getElementById = () => null;
+globalThis.document = doc;
+globalThis.window = globalThis; globalThis.addEventListener ??= () => {};
+globalThis.location = { hostname: "dashboard.example", origin: "https://dashboard.example", pathname: "/", hash: "", search: "" };
+
+/* ---- the fake chain behind the profile's origins ---- */
+const NOW = Math.floor(Date.now() / 1000), HEAD = 100;
+const word = (v) => BigInt(v).toString(16).padStart(64, "0");
+const ADDR_ABI = [{ type: "function", name: "addr", stateMutability: "view", inputs: [{ type: "bytes32" }], outputs: [{ type: "address" }] }];
+const key = (s) => "0x" + Buffer.from(s).toString("hex").padEnd(64, "0");
+const bookAll = () => encodeAbiParameters([{ type: "bytes32[]" }, { type: "address[]" }],
+  [["registry", "deployments", "appCatalog", "secretVault"].map(key), [contracts.registry, contracts.deployments, contracts.appCatalog, VAULT]]);
+function call({ to, data }){
+  to = String(to).toLowerCase();
+  if (data.startsWith("0x70a08231")) return "0x" + word(42_000000);                 // balanceOf: 42 USDC on the chain
+  if (to === BOOK && data === "0x10c4e8b0") return bookAll();
+  if (to === BOOK && data === "0x8da5cb5b") return "0x" + word(0xad);               // owner(): the book administrator
+  if (to === BOOK){ decodeFunctionData({ abi: ADDR_ABI, data }); return "0x" + word(0); }   // addr(key): unset
+  if (to === VAULT){
+    const { functionName } = decodeFunctionData({ abi: VAULT_ABI, data });
+    const out = { policyOf: [[OWNER, 0, 0, "0x" + "00".repeat(32), false, "0x"]], bundleOf: [[0, 0, "0x"]], book: [BOOK], beneficialOwnerOf: [OWNER] }[functionName];
+    if (!out) throw new Error("unexpected vault read " + functionName);
+    return encodeFunctionResult({ abi: VAULT_ABI, functionName, result: out.length === 1 ? out[0] : out });
+  }
+  try { decodeFunctionData({ abi: ADDR_ABI, data }); return "0x" + word(0); } catch {}
+  return "0x" + word(0);
+}
+function chain(method, params){
+  switch (method){
+    case "eth_chainId": return "0x2105";
+    case "eth_blockNumber": return "0x" + HEAD.toString(16);
+    case "eth_getBlockByNumber": {
+      const b = params[0] === "latest" ? HEAD : Number(params[0]);
+      return { number: "0x" + b.toString(16), hash: "0x" + word(b + 0xb10c), parentHash: "0x" + word(b + 0xb10b), timestamp: "0x" + (NOW - (HEAD - b) * 2).toString(16),
+        baseFeePerGas: "0x1", gasLimit: "0x1c9c380", gasUsed: "0x0", transactions: [], miner: "0x" + "00".repeat(20), difficulty: "0x0", extraData: "0x",
+        logsBloom: "0x" + "00".repeat(256), nonce: "0x0000000000000000", sha3Uncles: "0x" + word(0), size: "0x1", stateRoot: "0x" + word(1), receiptsRoot: "0x" + word(2),
+        transactionsRoot: "0x" + word(3), uncles: [], mixHash: "0x" + word(4) };
+    }
+    case "eth_call": return call(params[0]);
+    case "eth_getBalance": return "0xde0b6b3a7640000";                                   // 1 ETH on the chain
+    case "eth_estimateGas": return "0x5208";
+    case "eth_getCode": return String(params[0]).toLowerCase() === OWNER ? "0x" : "0x6080";
+    case "eth_getTransactionReceipt": return { status: "0x1", transactionHash: params[0], blockNumber: "0x64" };
+    case "eth_getLogs": return [];
+    default: throw new Error("fake chain: no " + method);
+  }
+}
+const reached = [], refused = [], chainErrors = [];
+globalThis.fetch = async (input, init = {}) => {
+  const url = String(input && input.url ? input.url : input);
+  let origin; try { origin = new URL(url).origin; } catch { origin = url; }
+  const body = init.body ? JSON.parse(init.body) : null;
+  const calls = Array.isArray(body) ? body : [body];
+  for (const c of calls) reached.push({ origin, method: c && c.method });
+  if (!RPCS.includes(origin) || down.has(RPCS.indexOf(origin))){
+    if (!RPCS.includes(origin)) refused.push(origin);
+    throw new TypeError("fetch failed (" + (RPCS.includes(origin) ? "endpoint down" : "public network refused") + ")");
+  }
+  const answer = (c) => { try { return { jsonrpc: "2.0", id: c.id, result: chain(c.method, c.params || []) }; }
+    catch (e){ chainErrors.push(c.method + ": " + String(e.message || e).slice(0, 160)); return { jsonrpc: "2.0", id: c.id, error: { code: -32000, message: String(e.message || e) } }; } };
+  const out = Array.isArray(body) ? calls.map(answer) : answer(body);
+  return new Response(JSON.stringify(out), { status: 200, headers: { "content-type": "application/json" } });
+};
+
+/* ---- an inert wallet: answers differently from the chain, so a read it served is visible ---- */
+const walletCalls = [];
+const wallet = { request: async ({ method, params }) => {
+  walletCalls.push(method);
+  switch (method){
+    case "eth_chainId": return "0x2105";
+    case "eth_accounts": case "eth_requestAccounts": return [OWNER];
+    case "eth_call": return "0x" + word(7_000000);                                       // the wallet's RPC says 7 USDC
+    case "eth_getBalance": return "0x1bc16d674ec80000";                                  // and 2 ETH
+    case "eth_estimateGas": return "0x1";
+    case "eth_getCode": return "0x60";
+    case "eth_sendTransaction": wallet.lastTx = params[0]; return "0x" + "ab".repeat(32);
+    case "eth_getTransactionByHash": return null;
+    default: throw Object.assign(new Error("inert wallet: " + method), { code: 4200 });
+  } }, on() {}, removeListener() {} };
+
+const core = (m) => import(pathToFileURL(path.join(siteRoot, "js/core", m)).href);
+const out = {};
+const attempt = async (name, fn) => {
+  const from = reached.length, w = walletCalls.length;
+  try { out[name] = { ok: await fn() }; } catch (e){ out[name] = { error: String((e && e.message) || e) }; }
+  out[name].origins = [...new Set(reached.slice(from).map((r) => r.origin))];
+  out[name].wallet = walletCalls.slice(w);
+};
+const settle = () => new Promise((r) => setTimeout(r, 50));
+
+const { Enclave } = await core("api.js");
+const W = await core("wallet.js");
+const C = await core("chain.js");
+const F = await core("fund.js");
+const CU = await core("custody.js");
+if (sc.book) await core("addressbook.js");            // boot.js loads it: the platform book resolves once at load
+Enclave.provider = wallet; Enclave.address = OWNER; Enclave.chainId = 8453;
+if (sc.book) for (let i = 0; i < 40 && !CU.custodyAvailable(); i++) await settle();   // addressbook.js resolves the book at load
+
+if (sc.debug) out.debugChanged = await (await core("platform-addresses.js")).resolvePlatformAddresses().then((r) => r && r.changed, (e) => "error " + e.message);
+for (const i of sc.downAfterLoad || []) down.add(i);
+if (sc.state === "changed") globalThis.localStorage.setItem("enclave_independent_profile", JSON.stringify({ ...profile, name: "replaced elsewhere" }));
+if (sc.state === "appeared") globalThis.localStorage.setItem("enclave_independent_profile", text);
+
+await attempt("usdcBalance", () => W.usdcBalanceOf(OWNER));
+await attempt("ethBalance", () => W.ethBalanceOf(OWNER));
+await attempt("payerHasCode", () => F.payerHasCode());
+let sent = null;
+await attempt("sendTx", async () => { sent = await W.sendTx(contracts.deployments, "0x6485d678" + word(1) + word(0), "0x0"); return sent; });
+out.sendTx.gas = (wallet.lastTx || {}).gas;
+await attempt("receipt", () => C.waitReceipt("0x" + "ab".repeat(32), 1).then((r) => r.status));
+await attempt("baseRpc", () => C.baseRpc("eth_blockNumber", []));
+if (sc.state !== "off") await attempt("quorumSnapshot", async () => (await (await core("independent-chain.js")).reader().snapshot()).number);
+if (sc.book) await attempt("custody", () => CU.custodyStatus("0x" + "cd".repeat(32)));
+out.custodyAvailable = CU.custodyAvailable();
+if (sc.sessions){
+  // the session store holds a record opened under an independent profile (no relay) with an RPC stored beside it
+  const S = await core("sessions.js");
+  const opened = [];
+  S._useSdkForTests({ IndexedDbStore: class { async load(id){ return id === "sid1" ? { id, relay: "", handle: { chainId: 8453, vault: VAULT, sid: "0x" + "51".repeat(32), owner: OWNER, relay: "", rpc: "https://old-profile.example" } } : null; } async remove(){} },
+    sessionFromRecord: async (rec, opts) => { opened.push(opts && opts.publicClient ? "profile client" : "stored rpc " + rec.handle.rpc); return { handle: rec.handle, status: async () => ({ live: true }) }; } });
+  globalThis.localStorage.setItem("enclave_wallet_session", "sid1");
+  await attempt("currentSession", async () => { const c = await S.currentSession(); return c ? opened.join() : null; });
+  await attempt("endSession", async () => { await S.endSession({ quiet: true }); return globalThis.localStorage.getItem("enclave_wallet_session"); });
+}
+out.refused = [...new Set(refused)];
+out.chainErrors = [...new Set(chainErrors)].slice(0, 6);
+out.rpcs = RPCS;
+process.stdout.write(JSON.stringify(out) + "\n");
+process.exit(0);
diff --git a/test/site-browser-rpc-closure.test.mjs b/test/site-browser-rpc-closure.test.mjs
new file mode 100644
index 0000000000000000000000000000000000000000..d5f430b862664db8cf0d5cfca5684425b453060a
--- /dev/null
+++ b/test/site-browser-rpc-closure.test.mjs
@@ -0,0 +1,162 @@
+// The dashboard's chain consumers under a network profile, on the REAL site modules (config, independent, chain, wallet,
+// fund, custody, sessions, independent-chain, platform-addresses, addressbook and the vendored custody bundle), each
+// profile state in its own process (test/helpers/browser-rpc-scenario.mjs): a fake Base chain behind the profile's RPC
+// origins, an inert wallet provider that answers differently from the chain, and a fetch that refuses every other
+// origin as a blocked public network does.
+//   confirmed profile: reads, estimates, receipts, quorum and custody reads reach only the profile's origins, and the
+//     wallet is asked only to send; one endpoint down fails over; all down (or too few for the quorum) is refused by name;
+//   invalid / unconfirmed profile: no origin and no wallet read at all;
+//   profile changed in another tab after load: every read and transaction refuses until reload (sign-out keeps its key);
+//   hosted mode (no profile): unchanged - wallet-first reads and the public default pool, which this test refuses.
+// A CONTROL runs the same scenarios on e820e2405's site (git archive) and shows where it reached the wallet, used fewer
+// routes or a weaker agreement, kept reading after a profile change, or read through an RPC stored with a session.
+// Not a browser: page rendering, the wallet popover and real wallet extensions are outside it (see
+// test/site-independent-browser.test.mjs for the Chromium run).
+//   run: node --test test/site-browser-rpc-closure.test.mjs
+import test from "node:test";
+import assert from "node:assert/strict";
+import fs from "node:fs";
+import os from "node:os";
+import path from "node:path";
+import { spawn, execFileSync } from "node:child_process";
+import { fileURLToPath } from "node:url";
+
+const REPO = path.resolve(path.dirname(fileURLToPath(import.meta.url)), "..");
+const HELPER = path.join(REPO, "test/helpers/browser-rpc-scenario.mjs");
+const OLD = "e820e2405af91010c18913acf4740f651618c644";
+const HOSTED_POOL = ["https://base-rpc.publicnode.com", "https://base.drpc.org", "https://1rpc.io", "https://mainnet.base.org"];
+
+function run(siteRoot, sc){
+  return new Promise((resolve, reject) => {
+    const p = spawn(process.execPath, [HELPER, siteRoot, JSON.stringify(sc)], { stdio: ["ignore", "pipe", "pipe"] });
+    let out = "", err = "";
+    p.stdout.on("data", (d) => (out += d)); p.stderr.on("data", (d) => (err += d));
+    const t = setTimeout(() => p.kill("SIGKILL"), 60000);
+    p.on("close", (code) => {
+      clearTimeout(t);
+      const line = out.trim().split("\n").pop();
+      if (code !== 0 || !line || !line.startsWith("{")) return reject(new Error("scenario " + JSON.stringify(sc) + " exited " + code + "\n" + err.slice(-2000)));
+      resolve(JSON.parse(line));
+    });
+  });
+}
+const SITE = path.join(REPO, "site");
+const onlyProfile = (r, what) => { for (const o of r[what].origins) assert.ok(r.rpcs.includes(o), what + " reached " + o); };
+const noWalletRead = (r, what) => assert.deepEqual(r[what].wallet.filter((m) => m !== "eth_sendTransaction"), [], what + " asked the wallet");
+const READS = ["usdcBalance", "ethBalance", "payerHasCode", "receipt", "baseRpc"];
+
+test("confirmed profile: every read, estimate and receipt uses only its RPCs; the wallet only broadcasts", async () => {
+  const r = await run(SITE, { state: "on", sessions: true });
+  for (const k of [...READS, "sendTx", "quorumSnapshot"]){ onlyProfile(r, k); noWalletRead(r, k); }
+  assert.equal(r.usdcBalance.ok, 42, "the chain's answer, not the wallet's 7");
+  assert.equal(r.ethBalance.ok, 1);
+  assert.equal(r.payerHasCode.ok, false);
+  assert.deepEqual(r.sendTx.wallet, ["eth_sendTransaction"]);
+  assert.equal(r.sendTx.gas, "0x668a", "the profile's estimate (0x5208) padded 25%, not the wallet's");
+  assert.equal(r.receipt.ok, "0x1");
+  assert.equal(r.quorumSnapshot.ok, 100);
+  assert.deepEqual(r.quorumSnapshot.origins.sort(), [...r.rpcs].sort());
+  assert.equal(r.currentSession.ok, "profile client", "a stored session reads through this profile, not the RPC stored with it");
+  assert.deepEqual(r.refused, []);
+});
+
+test("one configured endpoint down: the reads fail over to the profile's other routes", async () => {
+  const r = await run(SITE, { state: "on", down: [0] });
+  for (const k of [...READS, "sendTx", "quorumSnapshot"]){ onlyProfile(r, k); noWalletRead(r, k); }
+  assert.equal(r.usdcBalance.ok, 42);
+  assert.ok(r.usdcBalance.origins.includes(r.rpcs[1]), "rotated past the dead first origin");
+  assert.equal(r.sendTx.gas, "0x668a");
+  assert.equal(r.quorumSnapshot.ok, 100, "2 of the 3 still agree");
+  assert.deepEqual(r.refused, []);
+});
+
+test("every configured endpoint down: refused by name, nothing sent, no hidden route", async () => {
+  const r = await run(SITE, { state: "on", down: [0, 1, 2] });
+  for (const k of [...READS, "sendTx", "quorumSnapshot"]){ onlyProfile(r, k); assert.deepEqual(r[k].wallet, [], k + " reached the wallet"); assert.ok(r[k].error, k + " answered"); }
+  assert.match(r.sendTx.error, /none of the network profile's RPC endpoints could check this transaction - nothing was sent/);
+  assert.match(r.receipt.error, /none of the network profile's RPC endpoints answered/);
+  assert.match(r.quorumSnapshot.error, /only 0 of 3 chain endpoints answered/);
+  assert.deepEqual(r.refused, []);
+});
+
+for (const [state, sc, why] of [["invalid", { state: "invalid", badProfile: true }, /independent profile is invalid/],
+  ["unconfirmed", { state: "unconfirmed" }, /Confirm the independent profile/]])
+  test(`${state} profile: no origin and no wallet read, never a public default`, async () => {
+    const r = await run(SITE, sc);
+    for (const k of [...READS, "sendTx"]){
+      assert.deepEqual(r[k].origins, [], k + " reached an origin");
+      assert.deepEqual(r[k].wallet, [], k + " reached the wallet");
+      assert.ok(r[k].error, k + " answered");
+    }
+    for (const k of ["usdcBalance", "baseRpc", "receipt"]) assert.match(r[k].error, why);
+    assert.match(r.quorumSnapshot.error, /not active in this tab/);
+    assert.deepEqual(r.refused, []);
+  });
+
+test("profile changed in another tab after load: reads and transactions refuse until reload; sign-out keeps its key", async () => {
+  const r = await run(SITE, { state: "changed", sessions: true });
+  for (const k of [...READS, "sendTx", "quorumSnapshot"]){
+    assert.deepEqual(r[k].origins, [], k + " kept using the old routes");
+    assert.deepEqual(r[k].wallet, [], k + " reached the wallet");
+    assert.match(r[k].error, /network profile changed in another tab/);
+  }
+  assert.equal(r.endSession.ok, "sid1", "the session pointer survives a refused sign-out");
+});
+
+test("hosted mode unchanged: wallet-first reads, the public default pool, and no independent session served", async () => {
+  const r = await run(SITE, { state: "off", sessions: true });
+  assert.equal(r.usdcBalance.ok, 7); assert.deepEqual(r.usdcBalance.wallet, ["eth_call"]);
+  assert.equal(r.ethBalance.ok, 2);
+  assert.equal(r.payerHasCode.ok, true);
+  assert.deepEqual(r.sendTx.wallet, ["eth_estimateGas", "eth_sendTransaction"]);
+  // the hosted defaults are still public RPCs (disclosed until cutover); here the network refuses them
+  assert.deepEqual(r.refused, HOSTED_POOL);
+  assert.equal(r.currentSession.ok, null, "a session an independent profile opened is not served through its stored RPC");
+});
+
+test("a profile saved in another tab stops a hosted tab from sending", async () => {
+  const r = await run(SITE, { state: "appeared" });
+  assert.match(r.sendTx.error, /network profile changed in another tab/);
+  assert.ok(!r.sendTx.wallet.includes("eth_sendTransaction"));
+  assert.match(r.baseRpc.error, /network profile changed/);
+  assert.deepEqual(r.baseRpc.origins, []);
+});
+
+test("custody reads use every profile RPC with the profile's quorum (book-resolved vault)", async () => {
+  const a = await run(SITE, { state: "on", book: true });
+  assert.equal(a.custodyAvailable, true, "the platform book named the vault");
+  assert.equal(a.custody.ok, null, "no policy on the fake vault");
+  onlyProfile(a, "custody"); assert.deepEqual(a.custody.wallet, []);
+  assert.ok(a.sendTx.ok, "the book's current ledger accepts the transaction");
+  const b = await run(SITE, { state: "on", book: true, rpcs: 4, quorum: 3, down: [0] });
+  assert.equal(b.custody.ok, null);
+  assert.ok(b.custody.origins.includes(b.rpcs[3]), "the fourth route is used (not only the first three)");
+  const c = await run(SITE, { state: "on", book: true, rpcs: 4, quorum: 3, downAfterLoad: [0, 1] });
+  assert.match(c.custody.error, /only 2 of 4 RPCs answered \(need 3\)/, "the profile's quorum, not a fixed 2");
+});
+
+const haveGit = (() => { try { execFileSync("git", ["-C", REPO, "cat-file", "-e", OLD + "^{commit}"], { stdio: "ignore" }); return true; } catch { return false; } })();
+test("CONTROL: e820e2405's site fails the same checks", { skip: !haveGit && "needs the repository's git objects" }, async () => {
+  const tmp = fs.mkdtempSync(path.join(os.tmpdir(), "rpc-closure-old-"));
+  try {
+    execFileSync("sh", ["-c", `git -C "${REPO}" archive ${OLD} site network | tar -x -C "${tmp}"`]);
+    const old = path.join(tmp, "site");
+    const fails = [];
+    const on = await run(old, { state: "on", sessions: true });
+    if (on.usdcBalance.ok === 7 && on.usdcBalance.wallet.includes("eth_call")) fails.push("confirmed profile: balance read through the wallet's RPC");
+    if (on.sendTx.wallet.includes("eth_estimateGas")) fails.push("confirmed profile: gas estimated through the wallet's RPC");
+    const inv = await run(old, { state: "invalid", badProfile: true });
+    if (inv.usdcBalance.wallet.length) fails.push("invalid profile: the wallet was still asked for a balance");
+    const ch = await run(old, { state: "changed", sessions: true });
+    if (ch.baseRpc.ok && ch.baseRpc.origins.length) fails.push("profile changed elsewhere: kept reading the old routes");
+    if (ch.sendTx.ok) fails.push("profile changed elsewhere: still sent a transaction");
+    const off = await run(old, { state: "off", sessions: true });
+    if (String(off.currentSession.ok).includes("stored rpc https://old-profile.example")) fails.push("hosted mode: served an independent session through its stored RPC");
+    const c4 = await run(old, { state: "on", book: true, rpcs: 4, quorum: 3, down: [0] });
+    if (!c4.custody.origins.includes(c4.rpcs[3])) fails.push("custody: only the first three routes");
+    const cq = await run(old, { state: "on", book: true, rpcs: 4, quorum: 3, downAfterLoad: [0, 1] });
+    if (!/need 3/.test(cq.custody.error || "")) fails.push("custody: agreement of 2 regardless of the profile's quorum");
+    console.log("old source failures:\n  " + fails.join("\n  "));
+    assert.equal(fails.length, 8, "each check this test makes fails on the old source: " + JSON.stringify(fails));
+  } finally { fs.rmSync(tmp, { recursive: true, force: true }); }
+});
diff --git a/test/site-browser-rpc-routes.test.mjs b/test/site-browser-rpc-routes.test.mjs
new file mode 100644
index 0000000000000000000000000000000000000000..d0c023be784b3b8d6af948c794acb6afe44bf813
--- /dev/null
+++ b/test/site-browser-rpc-routes.test.mjs
@@ -0,0 +1,104 @@
+// Chromium on the independent rig (test/helpers/independent-browser-rig.mjs): the unbundled dashboard under a confirmed
+// profile whose three RPC origins are the rig's local proxies, with every non-loopback origin refused. The WALLET's own
+// RPC is the rig's anvil port (walletScript proxies every wallet request there), so what reaches it is exactly what the
+// page asked the wallet: only signing and broadcast may. Covers the wallet popover's route disclosure, a balance and a real
+// transaction with its receipt through the profile, one origin down, all origins down, and a profile changed in a
+// second tab. Generated anvil keys only; no real wallet, no public network.
+//   run: node --test test/site-browser-rpc-routes.test.mjs     (anvil, openssl, Playwright's Chromium, the Foundry build)
+import test from "node:test";
+import assert from "node:assert/strict";
+import { createRequire } from "node:module";
+import { startRig, haveTools, walletScript } from "./helpers/independent-browser-rig.mjs";
+const require = createRequire(new URL("../e2e/package.json", import.meta.url));
+let chromium; try { ({ chromium } = require("playwright")); } catch {}
+const skip = haveTools() || (!chromium && "needs Playwright (cd e2e && npm ci) and its Chromium");
+const SIGN_OR_SEND = new Set(["eth_sendTransaction", "eth_signTypedData_v4", "personal_sign", "eth_getTransactionByHash"]);
+
+test("browser chain consumers stay on the profile's routes; the wallet only signs and broadcasts", { skip, timeout: 300000 }, async () => {
+  let rig, browser;
+  const forbidden = [], walletRpc = [];
+  try {
+    rig = await startRig();
+    browser = await chromium.launch({ args: ["--disable-gpu", "--disable-dev-shm-usage", "--renderer-process-limit=1", "--disable-extensions",
+      "--disable-features=site-per-process,IsolateOrigins,Translate,OptimizationHints,MediaRouter,AudioServiceOutOfProcess",
+      "--enable-features=NetworkServiceInProcess,NetworkServiceInProcess2", "--js-flags=--max-old-space-size=192"] });
+    const context = await browser.newContext({ ignoreHTTPSErrors: true, reducedMotion: "reduce" });
+    // the public network refuses: any origin that is not this machine
+    await context.route("**/*", (route) => {
+      const u = new URL(route.request().url());
+      if (!["localhost", "127.0.0.1", "[::1]"].includes(u.hostname)){ forbidden.push(u.href); return route.abort("blockedbyclient"); }
+      return route.continue();
+    });
+    context.on("request", (r) => {
+      if (!r.url().startsWith(rig.rpc)) return;
+      try { const b = JSON.parse(r.postData() || "null"); for (const c of [].concat(b)) if (c && c.method) walletRpc.push(c.method); } catch {}
+    });
+    await context.addInitScript(({ profile, address }) => {
+      const text = JSON.stringify(profile);
+      if (!sessionStorage.getItem("enclave_independent_ack")){ localStorage.setItem("enclave_independent_profile", text); sessionStorage.setItem("enclave_independent_ack", text); }
+      localStorage.setItem("enclave_session", JSON.stringify({ address, rdns: "test.local.wallet" }));
+    }, { profile: rig.profile, address: rig.owner });
+    await context.addInitScript({ content: walletScript({ rpc: rig.rpc, address: rig.owner }) });
+    const page = await context.newPage();
+    await page.goto(rig.site + "/dashboard");
+    await page.waitForFunction(async () => !!(await import("/js/core/api.js")).Enclave.address, null, { timeout: 30000 });
+    const usdc6 = await rig.pc.readContract({ address: rig.addresses.usdc, abi: rig.abi.usdc, functionName: "balanceOf", args: [rig.owner] });
+
+    // the popover: the balance through the profile, and a reviewable statement of who broadcasts
+    await page.click("#walletBtn");
+    await page.waitForSelector("#walletPop:not([hidden]) #wpRpc");
+    await page.waitForFunction(() => !/…/.test(document.querySelector("#wpBalUsdc")?.textContent || "…"), null, { timeout: 20000 });
+    assert.equal(await page.textContent("#wpBalUsdc"), (Number(usdc6) / 1e6).toFixed(2) + " USDC");
+    await page.click("#wpRpc");
+    const box = await page.textContent("#wpRpcBox");
+    assert.match(box, /broadcast by your wallet/);
+    for (const u of rig.profile.rpcs) assert.ok(box.includes(u), "the popover names " + u);
+    assert.match(box, /Wallets accept only HTTPS RPCs/, "the rig's loopback routes are plain HTTP: nothing is offered to the wallet");
+    assert.equal(await page.$("#wpRpcOffer"), null);
+    assert.deepEqual(walletRpc, [], "the wallet's RPC answered no read for the popover");
+
+    // one origin down: the balance and an agreed read fail over; a real transaction is broadcast by the wallet and its
+    // receipt is read through the profile
+    rig.rpcModes[0] = "down";
+    const one = await page.evaluate(async ({ owner, usdc }) => {
+      const W = await import("/js/core/wallet.js"), C = await import("/js/core/chain.js"), IC = await import("/js/core/independent-chain.js");
+      const bal = await W.usdcBalanceOf(owner);
+      const snap = await IC.reader().snapshot();
+      const hash = await W.sendTx(usdc, "0x095ea7b3" + owner.slice(2).toLowerCase().padStart(64, "0") + "0".repeat(64), "0x0");
+      const rec = await C.waitReceipt(hash);
+      return { bal, agreed: snap.rpcs.length, status: rec.status };
+    }, { owner: rig.owner, usdc: rig.addresses.usdc });
+    assert.equal(one.bal, Number(usdc6) / 1e6);
+    assert.equal(one.agreed, 2);
+    assert.equal(one.status, "0x1");
+    assert.deepEqual(walletRpc, ["eth_sendTransaction"], "the wallet was asked to broadcast, and for nothing else");
+
+    // every origin down: refused by name, nothing broadcast, no fallback to the wallet's RPC
+    rig.rpcModes[0] = rig.rpcModes[1] = rig.rpcModes[2] = "down";
+    const all = await page.evaluate(async ({ owner, usdc }) => {
+      const W = await import("/js/core/wallet.js");
+      const err = (p) => p.then(() => "answered", (e) => String(e.message || e));
+      return { bal: await err(W.usdcBalanceOf(owner)), send: await err(W.sendTx(usdc, "0x095ea7b3" + "0".repeat(128), "0x0")) };
+    }, { owner: rig.owner, usdc: rig.addresses.usdc });
+    assert.notEqual(all.bal, "answered");
+    assert.match(all.send, /none of the network profile's RPC endpoints could check this transaction - nothing was sent/);
+    assert.deepEqual(walletRpc, ["eth_sendTransaction"], "nothing more reached the wallet");
+    rig.rpcModes[0] = rig.rpcModes[1] = rig.rpcModes[2] = "ok";
+
+    // the profile is replaced in a second tab: this tab stops reading and sending until it reloads
+    const other = await context.newPage();
+    await other.goto(rig.site + "/dashboard");
+    await other.evaluate((profile) => localStorage.setItem("enclave_independent_profile", JSON.stringify({ ...profile, name: "replaced in another tab" })), rig.profile);
+    const stale = await page.evaluate(async ({ owner, usdc }) => {
+      const W = await import("/js/core/wallet.js"), C = await import("/js/core/chain.js");
+      const err = (p) => p.then(() => "answered", (e) => String(e.message || e));
+      return { read: await err(C.baseRpc("eth_blockNumber", [])), send: await err(W.sendTx(usdc, "0x095ea7b3" + "0".repeat(128), "0x0")) };
+    }, { owner: rig.owner, usdc: rig.addresses.usdc });
+    assert.match(stale.read, /network profile changed in another tab/);
+    assert.match(stale.send, /network profile changed in another tab/);
+    assert.deepEqual(walletRpc, ["eth_sendTransaction"]);
+
+    for (const m of walletRpc) assert.ok(SIGN_OR_SEND.has(m), "the wallet's RPC was asked " + m);
+    assert.deepEqual(forbidden, [], "no public origin was attempted");
+  } finally { await browser?.close(); await rig?.stop(); }
+});
diff --git a/test/site-independent-management-unit.test.mjs b/test/site-independent-management-unit.test.mjs
index d5b5a45cf8c9a5be4d848334efe5010d0e8c2d0c..6c27595052799cd6380ef801d512535162036230 100644
--- a/test/site-independent-management-unit.test.mjs
