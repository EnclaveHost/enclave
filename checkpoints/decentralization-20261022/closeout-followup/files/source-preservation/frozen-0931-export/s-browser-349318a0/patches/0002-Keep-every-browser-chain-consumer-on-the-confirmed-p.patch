@@ -44,7 +44,8 @@ async function webKey(){
 
 const world = {};
 function reset(){
-  globalThis.localStorage.m.clear();
+  // per-test state (management floors); the tab's saved profile stays - removing it is a profile change (config.js)
+  for (const k of [...globalThis.localStorage.m.keys()]) if (k !== "enclave_independent_profile") globalThis.localStorage.m.delete(k);
   Object.assign(world, {
     lease: { id: ID, owner: VAULT, runner: RUNNER, runnerOperator: operator.address.toLowerCase(), chainId: 8453, deployments: LEDGER, active: true,
              isPublic: false, leaseUntil: Date.now() + 600e3, validUntil: Date.now() + 90e3, blockNumber: "1234" },
