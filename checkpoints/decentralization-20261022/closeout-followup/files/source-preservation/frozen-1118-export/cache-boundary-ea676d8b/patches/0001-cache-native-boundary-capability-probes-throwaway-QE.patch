+        desc = f"Enclave L1 consensus (official lighthouse {c['consensus']['binary']['release']}, non-validating, loopback API)"
+        order = f'After=network-online.target {NAME}-storage.service enclave-l1-el.service\nWants=enclave-l1-el.service'
