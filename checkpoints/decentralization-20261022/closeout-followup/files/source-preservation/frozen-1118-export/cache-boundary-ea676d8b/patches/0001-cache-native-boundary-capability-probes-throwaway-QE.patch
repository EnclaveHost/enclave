+{
+ "format": "enclave-base-holder/v1",
+ "binary": {
+  "path": "/opt/enclave-base-holder/bin/base",
+  "sha256": "9c44836d3dd41ae92df3c52fe0df7957dc10b77859d8d80cce6d5fb89d35e53f",
+  "release": "v1.5.1",
+  "releaseTarballSha256": "6779c45dbc6041205cc4e52bc2cd9d40746a5a4366a309899bf6533fccebe2b7"
+ },
+ "serviceUser": "enclave-holder",
+ "datadir": "/srv/enclave-base-holder/data",
+ "verifierPort": 8545,
+ "rpc": {
+  "port": 18545,
+  "api": [
+   "eth",
+   "net",
+   "web3"
+  ],
+  "proofWindowBlocks": 1800,
+  "maxConnections": 32
+ },
+ "consensusRpc": {
+  "port": 19545
+ },
+ "p2p": {
+  "listenIp": "0.0.0.0",
+  "executionPort": 30303,
+  "discoveryV5Port": 9200,
+  "consensusTcpPort": 9222,
+  "consensusUdpPort": 9223
