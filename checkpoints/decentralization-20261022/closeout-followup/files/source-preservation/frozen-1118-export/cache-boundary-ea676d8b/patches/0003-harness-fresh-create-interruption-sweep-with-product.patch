+        'fixedTemplate': hashlib.sha256(fixed.encode()).hexdigest(),
         'files': {n: hashlib.sha256(t.encode()).hexdigest() for n, t in files.items()}}
 (OUT / 'seam.json').write_text(json.dumps(seam, indent=1) + '\n')
