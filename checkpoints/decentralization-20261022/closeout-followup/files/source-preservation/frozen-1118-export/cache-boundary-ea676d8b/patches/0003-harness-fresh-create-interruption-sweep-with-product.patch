+  log "assembled: $DEV on $MNT"
+  ;;
+disassemble)
+  trap - EXIT
+  # Validate the complete ownership chain BEFORE the first destructive action.
+  # A configured path alone does not identify the filesystem mounted there.
+  O=$(loopof "$ORIGIN")
