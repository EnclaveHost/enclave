diff --git a/fixes/0002-signals-take-the-unwind-path.patch b/fixes/0002-signals-take-the-unwind-path.patch
new file mode 100644
index 0000000000000000000000000000000000000000..12ee72a82131e4d7d6b82c8f0e8dc0937890693c
--- /dev/null
+++ b/fixes/0002-signals-take-the-unwind-path.patch
@@ -0,0 +1,12 @@
+--- fixes/holder-storage.sh.in (after 0001)	2026-10-23 02:48:26.480483779 -0700
++++ fixes/holder-storage.sh.in	2026-10-23 02:48:26.496672573 -0700
+@@ -52,6 +52,9 @@
+   exit "$rc"
+ }
+ trap unwind EXIT
++# a signal (systemd stop, Ctrl-C, hangup) must take the same unwind path as an error: without these, bash dies on
++# SIGTERM WITHOUT running the EXIT trap and leaves this run's image and loop behind (measured on a real kernel)
++trap 'exit 143' TERM; trap 'exit 130' INT; trap 'exit 129' HUP
+ attach() {   # attach FILE VAR: reuse the loop already bound to FILE, else attach (and own) a new one
+   local l; l=$(loopof "$1")
+   if [ -z "$l" ]; then l=$(losetup --find --show -- "$1"); ATTACHED+=("$l"); fi
diff --git a/fixes/holder-storage.sh.in b/fixes/holder-storage.sh.in
index 423c091f44b3d3755c06ea15a9fde9ab36e58847..88fdcc221457e2bead9577a754f40f3906a11312 100644
--- a/fixes/holder-storage.sh.in
+++ b/fixes/holder-storage.sh.in
@@ -52,6 +52,9 @@ unwind() {
   exit "$rc"
 }
 trap unwind EXIT
+# a signal (systemd stop, Ctrl-C, hangup) must take the same unwind path as an error: without these, bash dies on
+# SIGTERM WITHOUT running the EXIT trap and leaves this run's image and loop behind (measured on a real kernel)
+trap 'exit 143' TERM; trap 'exit 130' INT; trap 'exit 129' HUP
 attach() {   # attach FILE VAR: reuse the loop already bound to FILE, else attach (and own) a new one
   local l; l=$(loopof "$1")
   if [ -z "$l" ]; then l=$(losetup --find --show -- "$1"); ATTACHED+=("$l"); fi
diff --git a/harness/guest.py b/harness/guest.py
index d93f47f924f0c9335656a34fb8afed58333977f0..984b2d78a67ed390832c509eb53821fbc71cf9f1 100644
--- a/harness/guest.py
+++ b/harness/guest.py
@@ -274,6 +274,24 @@ def phase_one():
         attempts.append(a)
         rec('interruption', **a)
     result('interruptions', attempts)
+    # the same interruption against the FIXED template (fixes/0001 + 0002): finer delays across the origin/loop window
+    fixed = str(R / 'pair-storage.fixed.sh'); fx = []
+    for i in range(12):
+        pair_reset()
+        delay = round(0.12 + 0.025 * i, 3)
+        q = subprocess.Popen([fixed, 'create'], env=ENV, stdout=subprocess.PIPE, stderr=subprocess.PIPE, text=True, start_new_session=True)
+        time.sleep(delay)
+        try:
+            os.killpg(q.pid, signal.SIGTERM)
+        except ProcessLookupError:
+            pass
+        o, e = q.communicate(timeout=120)
+        a = {'delay': delay, 'rc': q.returncode, 'completedBeforeSignal': q.returncode == 0, 'stderr': e.strip()[-240:], 'left': state()}
+        if q.returncode:
+            r2 = run(fixed, 'create'); a['recoverFixed'] = {'rc': r2.returncode, 'err': r2.stderr.strip()[-200:]}
+            a['verifyAfterRecoveryRc'] = run(PAIR, 'verify-cap').returncode
+        fx.append(a); rec('interruptionFixed', **a)
+    result('interruptionsFixed', fx)
     pair_reset()
     p = run(PAIR, 'create'); result('pair.recreateAfterInterrupts.rc', p.returncode)
     v = run(PAIR, 'verify-cap'); result('pair.verifyAfterInterrupts.rc', v.returncode)
