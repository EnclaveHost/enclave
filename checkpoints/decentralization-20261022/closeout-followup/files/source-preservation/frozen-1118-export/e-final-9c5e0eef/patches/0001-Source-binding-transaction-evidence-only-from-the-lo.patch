+
+test('nonce/resend tracking binds to the node\'s own transaction: a reverted L1 deposit frees the slot only with minted evidence at the recorded nonce', T, async () => {
+  const key = generatePrivateKey(), from = privateKeyToAccount(key).address;
+  const data = viem.encodeFunctionData({ abi: F.PORTAL_ABI, functionName: 'depositTransaction', args: [from, 0n, 30_000n, false, '0x' + 'ab'.repeat(388)] });
+  const rc = await l1.send(key, { chainId: 1, to: F.BASE_MAINNET.portal, value: 0n, data });
+  assert.equal(rc.status, 'reverted');
+  const ev = (await l1src.receipt(rc.transactionHash)).evidence;
+  const tr = new F.ForcedInclusionTracker();
+  tr.admit('k', '0x01', {});
+  tr.checkL1Send('k', ev.transaction.nonce + 1);
+  assert.throws(() => tr.resolveFailedL1('k', ev.receipt, ev, FIX), (e) => e.code === 'l1-receipt-mismatch', 'not the recorded L1 nonce');
+  const tr2 = new F.ForcedInclusionTracker();
+  tr2.admit('k', '0x01', {}); tr2.checkL1Send('k', ev.transaction.nonce);
+  assert.throws(() => tr2.resolveFailedL1('k', ev.receipt, ev), (e) => e.code === 'l1-receipt-unverified', 'default trust');
+  tr2.resolveFailedL1('k', ev.receipt, ev, FIX);
+  assert.equal(tr2.get('k').state, 'dead');
+});
diff --git a/test/source-binding.test.mjs b/test/source-binding.test.mjs
new file mode 100644
index 0000000000000000000000000000000000000000..78029a10d5dafdd49e7923fc7026e31e014908a8
--- /dev/null
+++ b/test/source-binding.test.mjs
@@ -0,0 +1,71 @@
+// Source-binding CONTROL FLOW against scripted endpoints (labelled stubs, test/support/pair-stubs.mjs): what anvil cannot
+// produce on demand. A reorg between the receipt read and the canonical re-check, a node that answers another
+// transaction, a transaction not in its block, a missing finalized tag. Also why the mainnet identity matters: a
+// stub that reports mainnet genesis + GVR on loopback mints 'local-validated-pair' trust. The trust anchor is the
+// root-configured loopback pair itself, i.e. local full-node validation, never a portable proof.
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { createL1PairSource, MAINNET_L1 } from '../src/l1-source-binding.mjs';
+import { TRUST, isMinted } from '../src/evidence-brand.mjs';
+import { startExecutionStub, startBeaconFixture } from './support/pair-stubs.mjs';
+
+const H = (b) => '0x' + b.repeat(32);
+const now = Math.floor(Date.now() / 1000);
+function chain(over = {}) {
+  const blocks = { 0: { number: '0x0', hash: MAINNET_L1.elGenesisHash, timestamp: '0x0' }, 90: { number: '0x5a', hash: H('90'), timestamp: '0x' + (now - 600).toString(16), transactions: [H('a1')] },
+    100: { number: '0x64', hash: H('64'), timestamp: '0x' + (now - 5).toString(16), transactions: [] } };
+  const st = { blocks, orphans: {}, finalized: 90, safe: 90, latest: 100, reorgAfterReceipt: false, receiptTx: H('a1'), calls: 0, ...over };
+  const tag = (t) => (t === 'latest' ? st.latest : t === 'finalized' ? st.finalized : t === 'safe' ? st.safe : Number(BigInt(t)));
+  const answer = (method, params) => {
+    st.calls++;
+    if (method === 'eth_chainId') return '0x1';
+    if (method === 'eth_syncing') return false;
+    if (method === 'net_peerCount') return '0x5';
+    if (method === 'eth_getBlockByNumber') { const n = tag(params[0]); if (n === null) return null; const b = st.blocks[n]; return b ? { ...b } : null; }
+    if (method === 'eth_getBlockByHash') return Object.values(st.blocks).find((b) => b.hash === params[0]) ?? st.orphans[params[0]] ?? null;
+    if (method === 'eth_getTransactionByHash') return { hash: params[0], blockHash: H('90'), from: '0x' + '11'.repeat(20), to: '0x' + '22'.repeat(20), nonce: '0x7' };
+    if (method === 'eth_getTransactionReceipt') {
+      // the canonical block at 90 changes right after this read; the old one stays retrievable by hash (an orphan), as a real node keeps it
+      if (st.reorgAfterReceipt && !st.orphans[H('90')]) { st.orphans[H('90')] = st.blocks[90]; st.blocks[90] = { ...st.blocks[90], hash: H('91') }; }
+      return { transactionHash: st.receiptTx, blockHash: H('90'), blockNumber: '0x5a', status: '0x1', logs: [], from: '0x' + '11'.repeat(20), to: '0x' + '22'.repeat(20),
+        cumulativeGasUsed: '0x5208', gasUsed: '0x5208', effectiveGasPrice: '0x1', type: '0x2', transactionIndex: '0x0', logsBloom: '0x' + '00'.repeat(256), contractAddress: null };
+    }
+    throw new Error('unsupported ' + method);
+  };
+  return { st, answer };
+}
+async function pair(over = {}, beaconState = {}) {
+  const c = chain(over);
+  const el = await startExecutionStub(c.answer);
+  const cl = await startBeaconFixture({ el: el.url, gvr: MAINNET_L1.clGenesisValidatorsRoot, state: beaconState });
+  return { c, el, cl, src: createL1PairSource({ execution: { url: el.url }, consensus: { url: cl.url } }), close: () => { el.close(); cl.close(); } };
+}
+
+test('a scripted pair reporting MAINNET identity mints local-validated-pair trust: the configured loopback pair IS the trust anchor', async () => {
+  const p = await pair();
+  try {
+    const r = await p.src.receipt(H('a1'));
+    assert.equal(r.state, 'included');
+    assert.equal(isMinted(r.evidence), true);
+    assert.deepEqual([r.evidence.trust, r.evidence.finalized, r.evidence.transaction.nonce], [TRUST.LOCAL_VALIDATED_PAIR, true, 7]);
+  } finally { p.close(); }
+});
+
+test('fail closed: reorg between reads, an answer for another transaction, a transaction not in its block, no finalized tag', async () => {
+  const cases = [
+    [{ reorgAfterReceipt: true }, 'l1-not-canonical'],
+    [{ receiptTx: H('b2') }, 'l1-receipt-mismatch'],
+    [{ blocks: undefined }, null],
+  ];
+  for (const [over, code] of cases.slice(0, 2)) {
+    const p = await pair(over);
+    try { await assert.rejects(p.src.receipt(H('a1')), (e) => e.code === code, code); } finally { p.close(); }
+  }
+  // the block does not list the transaction
+  const p3 = await pair();
+  p3.c.st.blocks[90] = { ...p3.c.st.blocks[90], transactions: [] };
+  try { await assert.rejects(p3.src.receipt(H('a1')), (e) => e.code === 'l1-receipt-mismatch'); } finally { p3.close(); }
+  // no finalized block at all
+  const p4 = await pair({ finalized: null });
+  try { await assert.rejects(p4.src.receipt(H('a1')), (e) => e.code === 'l1-source-not-ready' && /el.finalized/.test(e.message)); } finally { p4.close(); }
+});
diff --git a/test/support/pair-stubs.mjs b/test/support/pair-stubs.mjs
new file mode 100644
index 0000000000000000000000000000000000000000..bf390fac0fa55c1da61fa9d8c9fc62cdc0d6bd99
--- /dev/null
+++ b/test/support/pair-stubs.mjs
@@ -0,0 +1,66 @@
+// LABELLED FIXTURES for the source-binding adapters. None of these validates anything:
+//   startBeaconFixture: a Beacon-API stand-in that answers from an EXECUTION endpoint's own tags (head/finalized payload
+//     = that endpoint's latest/finalized block). A real Lighthouse derives these from consensus; this mirrors them, and
+//     can be told to lie (override) so the adapter's pairing check is exercised.
+//   startRollupFixture: an `optimism_syncStatus` stand-in over a local L2 (heads at chosen numbers) and L1.
+//   startExecutionStub: a scripted execution JSON-RPC for pure control-flow tests (reorg between reads, etc.).
+import http from 'node:http';
+
+const listen = (handler) => new Promise((ok) => { const s = http.createServer(handler); s.listen(0, '127.0.0.1', () => ok({ server: s, url: `http://127.0.0.1:${s.address().port}` })); });
+const body = (req) => new Promise((ok) => { let b = ''; req.on('data', (c) => { b += c; }); req.on('end', () => ok(b)); });
+export async function jrpc(url, method, params = []) {
+  const j = await (await fetch(url, { method: 'POST', headers: { 'content-type': 'application/json' }, body: JSON.stringify({ jsonrpc: '2.0', id: 1, method, params }) })).json();
+  if (j.error) throw new Error(`${method}: ${JSON.stringify(j.error)}`); return j.result;
+}
+
+export async function startBeaconFixture({ el, gvr = '0x' + '7e'.repeat(32), state = {} }) {
+  const st = { syncing: false, optimistic: false, elOffline: false, peers: 3, finalizedOverride: null, ...state };
+  const payload = async (tag) => {
+    if (tag === 'finalized' && st.finalizedOverride) return st.finalizedOverride;
+    const b = await jrpc(el, 'eth_getBlockByNumber', [tag === 'head' ? 'latest' : 'finalized', false]);
+    return { block_number: String(Number(BigInt(b.number))), block_hash: b.hash, slot: String(Number(BigInt(b.number)) + 1000) };
+  };
+  const { server, url } = await listen(async (req, res) => {
+    const send = (d, code = 200) => { res.writeHead(code, { 'content-type': 'application/json' }); res.end(JSON.stringify({ data: d })); };
+    try {
+      if (req.url === '/eth/v1/beacon/genesis') return send({ genesis_validators_root: gvr, genesis_time: '1606824023' });
+      if (req.url === '/eth/v1/node/syncing') return send({ is_syncing: st.syncing, is_optimistic: st.optimistic, el_offline: st.elOffline, head_slot: '1000' });
+      if (req.url === '/eth/v1/node/peer_count') return send({ connected: String(st.peers) });
+      const m = /^\/eth\/v2\/beacon\/blocks\/(head|finalized)$/.exec(req.url);
+      if (m) { const p = await payload(m[1]); return send({ message: { slot: p.slot, body: { execution_payload: { block_number: p.block_number, block_hash: p.block_hash } } } }); }
+      send({ message: 'not found' }, 404);
+    } catch (e) { send({ message: String(e) }, 500); }
+  });
+  return { url, state: st, close: () => server.close() };
+}
+
+export async function startRollupFixture({ l2, l1, state = {} }) {
+  const st = { safeNumber: null, finalizedNumber: null, l1Override: null, ...state };
+  const ref = async (url, n) => { const b = await jrpc(url, 'eth_getBlockByNumber', [n === null ? 'latest' : '0x' + Number(n).toString(16), false]);
+    return { hash: b.hash, number: Number(BigInt(b.number)), parentHash: b.parentHash, timestamp: Number(BigInt(b.timestamp)) }; };
+  const { server, url } = await listen(async (req, res) => {
+    const j = JSON.parse(await body(req));
+    const out = (result) => { res.writeHead(200, { 'content-type': 'application/json' }); res.end(JSON.stringify({ jsonrpc: '2.0', id: j.id, result })); };
+    if (j.method !== 'optimism_syncStatus') return out(null);
+    const unsafe = await ref(l2, null);
+    const l1fin = await jrpc(l1, 'eth_getBlockByNumber', ['finalized', false]);
+    const l1ref = { hash: l1fin.hash, number: Number(BigInt(l1fin.number)), parentHash: l1fin.parentHash, timestamp: Number(BigInt(l1fin.timestamp)) };
+    const cur = st.l1Override ?? (await ref(l1, null));
+    const withOrigin = (r) => ({ ...r, l1origin: { hash: l1ref.hash, number: l1ref.number }, sequenceNumber: 0 });
+    out({ current_l1: cur, current_l1_finalized: l1ref, head_l1: cur, safe_l1: l1ref, finalized_l1: st.l1FinalizedOverride ?? l1ref,
+      unsafe_l2: withOrigin(unsafe), safe_l2: withOrigin(await ref(l2, st.safeNumber ?? 0)), finalized_l2: withOrigin(await ref(l2, st.finalizedNumber ?? 0)) });
+  });
+  return { url, state: st, close: () => server.close() };
+}
+
+/** A scripted execution node: `answer(method, params, call#)` returns the result (or throws). */
+export async function startExecutionStub(answer) {
+  let n = 0;
+  const { server, url } = await listen(async (req, res) => {
+    const j = JSON.parse(await body(req));
+    let result, error;
+    try { result = await answer(j.method, j.params, ++n); } catch (e) { error = { code: -32000, message: String(e.message || e) }; }
+    res.writeHead(200, { 'content-type': 'application/json' }); res.end(JSON.stringify({ jsonrpc: '2.0', id: j.id, ...(error ? { error } : { result }) }));
+  });
+  return { url, close: () => server.close() };
+}
