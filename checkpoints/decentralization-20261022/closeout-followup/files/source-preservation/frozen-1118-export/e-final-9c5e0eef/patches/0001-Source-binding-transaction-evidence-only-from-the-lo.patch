+// Evidence that only the SOURCE-BINDING adapters can mint (src/l1-source-binding.mjs, src/base-source-binding.mjs).
+// A string label ('l1-execution-proof') or caller-supplied JSON is not evidence: the transaction checks in
+// src/forced-inclusion.mjs accept an L1/L2 inclusion or finality claim by default ONLY when the object was produced by
+// an adapter that read it from an explicitly configured, readiness-checked local client pair.
+//
+// Scope of this guarantee: it is an in-process capability (a module-private WeakSet), not cryptography. It stops a
+// caller, a config file or a remote endpoint from asserting evidence; it does not defend against code running in the
+// same process. The TRUST behind a minted object is recorded on it (`trust`): 'local-validated-pair' means "the local
+// full nodes executed/validated this chain and their consensus client finalized it" (local full-node validation
+// trust); it is NOT a portable proof another party can check. 'test-fixture' marks objects from labelled fixtures,
+// which the default checks refuse.
+const MINTED = new WeakSet();
+export const TRUST = Object.freeze({ LOCAL_VALIDATED_PAIR: 'local-validated-pair', TEST_FIXTURE: 'test-fixture' });
+export function mint(obj) { const o = Object.freeze(obj); MINTED.add(o); return o; }
+export const isMinted = (obj) => obj !== null && typeof obj === 'object' && MINTED.has(obj);
