diff --git a/read-minipc.py b/read-minipc.py
new file mode 100644
index 0000000000000000000000000000000000000000..ffbbfe1060f40f5bfac7b217cd80f7d5b1d4b8ff
--- /dev/null
+++ b/read-minipc.py
@@ -0,0 +1,15 @@
+import importlib.util,json
+from pathlib import Path
+from datetime import datetime,timezone
+spec=importlib.util.spec_from_file_location('native', 'work/nucbox-tls-20261021/root-activate-reviewed.py')
+native=importlib.util.module_from_spec(spec);spec.loader.exec_module(native)
+script="""[Console]::OutputEncoding=[Text.UTF8Encoding]::new();
+$o=Get-CimInstance Win32_OperatingSystem -OperationTimeoutSec 15;
+$c=Get-CimInstance Win32_ComputerSystem -OperationTimeoutSec 15;
+$d=@(Get-CimInstance Win32_LogicalDisk -Filter 'DriveType=3' -OperationTimeoutSec 15|ForEach-Object{[ordered]@{drive=$_.DeviceID;filesystem=$_.FileSystem;sizeBytes=[long]$_.Size;freeBytes=[long]$_.FreeSpace}});
+[ordered]@{totalVisibleKiB=[long]$o.TotalVisibleMemorySize;freePhysicalKiB=[long]$o.FreePhysicalMemory;logicalProcessors=[int]$c.NumberOfLogicalProcessors;disks=$d}|ConvertTo-Json -Compress -Depth 4
+"""
+result={'observedAt':datetime.now(timezone.utc).isoformat(),'alias':'minipc','readOnly':True,'inventory':native.ps(script,45),
+ 'scope':'Current capacity only, no VM changes, no filesystem writes or allocation on the remote. Does not prove that HDD array is accessible, native Base compatibility, or available resources for deployment.'}
+Path('outputs/decentralization-audit/rpc-minipc-capacity-20261023.json').write_text(json.dumps(result,indent=2)+'\n')
+print(json.dumps(result))
diff --git a/read-target.py b/read-target.py
new file mode 100644
index 0000000000000000000000000000000000000000..f6758d8b41599f2a41684030a3a3371ed1525c52
--- /dev/null
+++ b/read-target.py
@@ -0,0 +1,4 @@
+import importlib.util,json,pathlib,datetime
+s=importlib.util.spec_from_file_location('n','work/nucbox-tls-20261021/root-activate-reviewed.py');n=importlib.util.module_from_spec(s);s.loader.exec_module(n)
+p=r"""[Console]::OutputEncoding=[Text.UTF8Encoding]::new();$o=Get-CimInstance Win32_OperatingSystem -OperationTimeoutSec 10;$c=Get-CimInstance Win32_ComputerSystem -OperationTimeoutSec 10;$d=@(Get-CimInstance Win32_LogicalDisk -OperationTimeoutSec 10|Select-Object DeviceID,DriveType,FileSystem,Size,FreeSpace);$v=@(Get-VM|Select-Object Name,@{n='state';e={$_.State.ToString()}},MemoryAssigned,MemoryDemand,MemoryStartup,MemoryMinimum,MemoryMaximum,DynamicMemoryEnabled,ProcessorCount);$dsk=@(Get-Disk|Select-Object Number,FriendlyName,BusType,Size,OperationalStatus,PartitionStyle);$h=Invoke-RestMethod -TimeoutSec 5 http://127.0.0.1:9600/v1/host/state;[ordered]@{at=(Get-Date).ToUniversalTime().ToString('o');totalVisibleKiB=[long]$o.TotalVisibleMemorySize;freePhysicalKiB=[long]$o.FreePhysicalMemory;logicalProcessors=[int]$c.NumberOfLogicalProcessors;volumes=$d;disks=$dsk;vms=$v;availability=($h.availability|Select-Object claimEnabled,isolation,attach,apps)}|ConvertTo-Json -Depth 7 -Compress"""
+r=n.ps(p,40);out={'observedAt':datetime.datetime.now(datetime.timezone.utc).isoformat(),'readOnly':True,'target':'minipc / NucBox','inventory':r,'authorization':'User selected NucBox, reports47.9GBfree and allows96GBallocatedtohost; no changesmade; currentphysicalcapacitydistinctfromadvertisedcapacity.'};f=pathlib.Path('outputs/decentralization-audit')/('rpc-nucbox-target-'+datetime.datetime.now(datetime.timezone.utc).strftime('%Y%m%dT%H%M%SZ')+'.json');f.write_text(json.dumps(out,indent=2)+'\n');print(json.dumps(out));print('Saved',f)
