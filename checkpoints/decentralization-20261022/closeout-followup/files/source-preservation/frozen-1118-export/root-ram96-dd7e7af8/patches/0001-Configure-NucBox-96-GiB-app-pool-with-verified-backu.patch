+j='''(async()=>{let o={};for(const [k,u] of Object.entries({availability:'http://127.0.0.1:9600/availability',manager:'http://127.0.0.1:8091/health'})){try{const r=await fetch(u,{signal:AbortSignal.timeout(5000)});const b=await r.json();o[k]={status:r.status,...(k==='manager'?{memory:b.memory,inventory:b.inventory}:{nodeRamGb:b.nodeRamGb,machineRamGb:b.machineRamGb,apps:b.apps,capacity:b.capacity,ramGbFree:b.ramGbFree})}}catch(e){o[k]={error:e.message}}}console.log(JSON.stringify(o))})()'''
