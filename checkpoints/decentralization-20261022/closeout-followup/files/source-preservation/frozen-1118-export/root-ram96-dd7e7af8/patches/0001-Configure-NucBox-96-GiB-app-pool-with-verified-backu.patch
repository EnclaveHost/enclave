+p=r'''try {$base='C:\ProgramData\Enclave';$names=@('node-config.cmd','node-config.local.cmd','shield-config.cmd');$items=@();foreach($n in $names){$p=Join-Path $base $n;$raw=[IO.File]::ReadAllBytes($p);$text=[Text.Encoding]::UTF8.GetString($raw);$rx=[regex]'(?m)^set NODE_APP_RAM_GB=64\r?$';if($rx.Matches($text).Count -ne 1){throw "Expected exactly one 64 GiB setting in $n"};$new=$text -replace '(?m)^set NODE_APP_RAM_GB=64(?=\r?$)','set NODE_APP_RAM_GB=96';$items+=@{path=$p;raw=$raw;text=$new;sha=(FileSha $p)}};$stamp=(Get-Date).ToUniversalTime().ToString('yyyyMMddTHHmmssZ');$done=@();foreach($i in $items){if((FileSha $i.path) -ne $i.sha){throw 'Configuration changed concurrently'};$bak=$i.path+'.pre-ram96-'+$stamp;[IO.File]::Copy($i.path,$bak,$false);$tmp=$i.path+'.ram96-'+$stamp+'.tmp';[IO.File]::WriteAllText($tmp,$i.text,[Text.UTF8Encoding]::new($false));[IO.File]::Replace($tmp,$i.path,($bak+'.replaced'));$read=[IO.File]::ReadAllText($i.path);if(([regex]::Matches($read,'(?m)^set NODE_APP_RAM_GB=96\r?$')).Count -ne 1){throw 'Post-write validation failed'};$done+=@{file=$i.path;backup=$bak;beforeSha=$i.sha;afterSha=(FileSha $i.path);valueGiB=96}};[ordered]@{at=(Get-Date).ToUniversalTime().ToString('o');configured=$done;servicesRestarted=$false;runtimeActivation='pending service restart'}|ConvertTo-Json -Depth 5 -Compress}catch{@{error=$_.Exception.Message}|ConvertTo-Json -Compress}'''
+r=m.ps(p,35);pathlib.Path('work/nucbox-ram96-20261023/configured.json').write_text(json.dumps(r,indent=2));print(json.dumps(r));raise SystemExit(1 if 'error' in r else 0)
