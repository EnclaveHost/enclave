+  [ "$(avail "$ORIGIN")" -ge $(( ORIGIN_BYTES + ORIGIN_FREE_MARGIN )) ] || die "not enough free space for the origin image plus margin"
+  if cached; then
+    for f in "$CDATA" "$CMETA"; do [ "$(rot "$f")" = 0 ] || die "$f must be on NVMe (non-rotational)"; done
+    # A re-run after an interrupted create ADOPTS this reservation's owned cache files (budget admit/allocate), so only
+    # their not-yet-allocated part needs free space. Credit ONLY a regular file (no symlink) that carries an ownership
+    # marker and lives on the SAME filesystem as the CDATA directory measured here; anything else is credited 0. The
+    # budget admit below still refuses a file whose marker is not this reservation's.
+    credit() {   # credit FILE DECLARED_BYTES -> allocated bytes to subtract (<= DECLARED_BYTES)
+      local a
+      if [ -f "$1" ] && [ ! -L "$1" ] && [ -f "$1.enclave-budget-owner" ] && [ ! -L "$1.enclave-budget-owner" ] \
+         && [ "$(stat -c %d -- "$1")" = "$(stat -c %d -- "$(dirname "$CDATA")")" ]; then
+        a=$(( $(stat -c %b -- "$1") * 512 )); [ "$a" -le "$2" ] || a=$2; echo "$a"
+      else
+        echo 0
+      fi
+    }
+    need=$(( CDATA_BYTES + CMETA_BYTES + NVME_FREE_MARGIN - $(credit "$CDATA" "$CDATA_BYTES") - $(credit "$CMETA" "$CMETA_BYTES") ))
+    [ "$(avail "$CDATA")" -ge "$need" ] || die "not enough NVMe free space for the cache plus margin"
+    # the ledger reservation must exist for THIS host and name exactly these files and sizes; present cache files must
+    # be this reservation's own (an interrupted earlier create is adopted, never granted twice)
+    "$PY" -I "$BUDGET_TOOL" admit "$LEDGER" "$RESERVATION" "$CDATA=$CDATA_BYTES" "$CMETA=$CMETA_BYTES" \
+      || die "NVMe cache budget reservation refused"
+  fi
+  # 2. allocate, tracking ownership for unwind
+  CREATED+=("$ORIGIN"); fallocate -l "$ORIGIN_BYTES" -- "$ORIGIN"
