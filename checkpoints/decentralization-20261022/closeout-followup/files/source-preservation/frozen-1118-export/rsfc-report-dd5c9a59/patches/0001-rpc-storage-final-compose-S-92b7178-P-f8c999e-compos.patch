+die() { log "$*"; exit 2; }
+rot() { lsblk -nso ROTA "$(findmnt -no SOURCE --target "$(dirname "$1")")" | tail -1 | tr -d ' '; }
+avail() { df --output=avail -B1 "$(dirname "$1")" | tail -1 | tr -d ' '; }
+mm() { lsblk -dno MAJ:MIN "$1" | tr -d ' '; }
