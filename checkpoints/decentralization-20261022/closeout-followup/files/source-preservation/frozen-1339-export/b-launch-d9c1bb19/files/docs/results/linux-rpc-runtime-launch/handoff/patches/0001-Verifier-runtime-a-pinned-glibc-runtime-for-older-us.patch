+  bad({ glibcRuntime: { ...g, binaries: ['listener'] } }, /helios and\/or witnessCheck/);
+  bad({ glibcRuntime: { ...g, binaries: [] } }, /helios and\/or witnessCheck/);
+  bad({ glibcRuntime: { ...g, files: { ...files, 'libpthread.so.0': 'ab'.repeat(32) } } }, /unknown field/);
