+  await waitTx(await rig.write(rig.wc(KEYS.deployer), rig.addresses.catalog, rig.A.catalog.abi, 'setActive', ['hello', false]));
+  await until(async () => /delisted/.test((await decide(env)).refusal || ''), 60000, 'admin delisting');
