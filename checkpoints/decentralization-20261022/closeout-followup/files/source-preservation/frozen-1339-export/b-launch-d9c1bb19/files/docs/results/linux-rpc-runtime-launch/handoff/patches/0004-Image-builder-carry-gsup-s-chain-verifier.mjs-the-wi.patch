From 60a4f969f6a3f02b1f9aa1a70457e2cb8ed2657d Mon Sep 17 00:00:00 2001
From: SteveDeFacto <5148995+SteveDeFacto@users.noreply.github.com>
Date: Fri, 23 Oct 2026 03:26:31 -0700
Subject: [PATCH 4/7] Image builder: carry gsup's chain-verifier.mjs; the
 wiring pins name the verifier wrapper

gsup.mjs imports ./chain-verifier.mjs, so metal/build-image.mjs, the from-scratch builder, must install it beside gsup as
overlay-control-image.py does; otherwise an image it builds would boot a gsup that cannot load. It installs no verifier
runtime (no /opt/rpc-runtime/IMAGE.json), so an operator's opt-in on such an image refuses in the guest.

The text pins that state gsup's supervisor start and the guest helper lists now name the chain verifier exactly:
withChainVerifierEnv(...) is the outermost wrapper of the reviewed chain, applied once (metal-lease-gas-conduit,
relay-policy-carriers, metal-measured-control), and OPTIONAL_GUEST_FILES / the builder's list end with
'chain-verifier.mjs' (metal-lease-gas-conduit, metal-measured-control, owner-nomination-config).
---
 metal/build-image.mjs                 |  4 +++-
 test/metal-lease-gas-conduit.test.mjs |  4 ++--
 test/metal-measured-control.test.mjs  | 11 +++++++----
 test/owner-nomination-config.test.mjs |  4 ++--
 test/relay-policy-carriers.test.mjs   |  2 +-
 5 files changed, 15 insertions(+), 10 deletions(-)

diff --git a/metal/build-image.mjs b/metal/build-image.mjs
index 51a334366cefdfb290719ef1678c1e4017cd8df7..eeab71ec28467a0a78ecd96e9193f61dfec3df43 100644
--- a/metal/build-image.mjs
+++ b/metal/build-image.mjs
@@ -282,7 +282,9 @@ const md = path.join(ROOT, 'opt/metal'); fs.mkdirSync(md, { recursive: true });
 // the guest half of the shielded tier is trusted code and must be attested. The
 // worker it talks to is not, and is not shipped here: it runs on the host, is
 // assumed hostile, and its address arrives unmeasured over fw_cfg.
-for (const f of ['gsup.mjs', 'host-policy.bundle.mjs', 'lease-gas-conduit.bundle.mjs', 'agent.mjs', 'shielded.mjs', 'shielded-probe.mjs', 'shielded-shm.mjs', 'measured-control.mjs', 'owner-nomination.mjs'])
+// chain-verifier.mjs is gsup's opt-in checker for the local chain verifier. This builder installs no verifier runtime (no
+// /opt/rpc-runtime/IMAGE.json; metal/overlay-control-image.py --chain-verifier-dir does), so an opt-in on its image refuses.
+for (const f of ['gsup.mjs', 'host-policy.bundle.mjs', 'lease-gas-conduit.bundle.mjs', 'agent.mjs', 'shielded.mjs', 'shielded-probe.mjs', 'shielded-shm.mjs', 'measured-control.mjs', 'owner-nomination.mjs', 'chain-verifier.mjs'])
   fs.copyFileSync(path.join(HERE, 'guest', f), path.join(md, f));
 // the hosted independent MCP adapter (docs/network/hosted-mcp.md): a reproducible bundle of mcp/server.mjs and its closure
 // (scripts/build-mcp-guest-bundle.mjs --check), started by gsup only for a bound config with an mcp member
diff --git a/test/metal-lease-gas-conduit.test.mjs b/test/metal-lease-gas-conduit.test.mjs
