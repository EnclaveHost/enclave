From: SteveDeFacto <5148995+SteveDeFacto@users.noreply.github.com>
Date: Thu, 22 Oct 2026 22:34:22 -0700
Subject: [PATCH 18/28] Hold the RPC runtime state lock with a parent-owned
 kernel descriptor

---
 network/runtime-lock.mjs   | 56 ++++++++++++++++++++++++++
 test/lock-child.mjs        |  9 +++++
 test/runtime-lock.test.mjs | 82 ++++++++++++++++++++++++++++++++++++++
 3 files changed, 147 insertions(+)
 create mode 100644 network/runtime-lock.mjs
 create mode 100644 test/lock-child.mjs
 create mode 100644 test/runtime-lock.test.mjs

diff --git a/network/runtime-lock.mjs b/network/runtime-lock.mjs
new file mode 100644
index 0000000000000000000000000000000000000000..76b1e6361f00eec31481df27265fd6f191dbefb1
--- /dev/null
+++ b/network/runtime-lock.mjs
@@ -0,0 +1,56 @@
+// Linux runtime state-directory exclusion. The parent owns the open file
+// description; flock(1) only acquires the kernel lock on an inherited duplicate.
+// Never unlink the lock file: replacing its inode would permit two owners.
+import fs from 'node:fs';
+import path from 'node:path';
+import { spawn } from 'node:child_process';
+
+export async function takeRuntimeLock(file, { flockPath = '/usr/bin/flock', timeoutMs = 5000, signal } = {}) {
+  if (process.platform !== 'linux') throw new Error('runtime lock requires Linux flock');
+  if (!path.isAbsolute(file) || !path.isAbsolute(flockPath)) throw new Error('lock and flock paths must be absolute');
+  if (!Number.isSafeInteger(timeoutMs) || timeoutMs < 1 || timeoutMs > 30000) throw new Error('invalid lock deadline');
+  signal?.throwIfAborted();
+  // The caller must own a private state directory. Do not follow lock symlinks.
+  const fd = fs.openSync(file, fs.constants.O_CREAT | fs.constants.O_RDWR | fs.constants.O_NOFOLLOW, 0o600);
+  let owned = true;
+  const release = () => { if (owned) { owned = false; fs.closeSync(fd); } };
+  try {
+    const before = fs.fstatSync(fd);
+    if (!before.isFile() || before.nlink !== 1) throw new Error('runtime lock must be a regular, unshared file');
+    // Nonempty files belong to a different lock protocol. Do not guess whether
+    // an old PID record is stale, and never remove it while another owner races.
+    if (before.size !== 0) throw new Error('legacy runtime lock: stop the old runtime and review migration first');
+    await new Promise((resolve, reject) => {
+      let child, failure = null, timer;
+      const abort = () => {
+        failure ??= signal?.reason ?? new Error('runtime lock acquisition aborted');
+        child?.kill('SIGKILL');
+      };
+      try {
+        child = spawn(flockPath, ['--exclusive', '--nonblock', '--conflict-exit-code', '73', '3'],
+          { stdio: ['ignore', 'ignore', 'ignore', fd], windowsHide: true });
+      } catch (error) { reject(error); return; }
+      child.on('error', error => { failure ??= error; });
+      child.once('close', (code, sig) => {
+        clearTimeout(timer);
+        signal?.removeEventListener('abort', abort);
+        if (failure) reject(failure);
+        else if (code === 0) resolve();
+        else if (code === 73) reject(new Error('stateDir is in use by a running runtime'));
+        else reject(new Error(`runtime flock failed (${code ?? sig})`));
+      });
+      timer = setTimeout(() => {
+        failure ??= new Error('runtime lock acquisition deadline exceeded');
+        child.kill('SIGKILL');
+      }, timeoutMs);
+      signal?.addEventListener('abort', abort, { once: true });
+      if (signal?.aborted) abort();
+    });
+    signal?.throwIfAborted();
+    const current = fs.lstatSync(file);
+    if (current.dev !== before.dev || current.ino !== before.ino || current.nlink !== 1 || !current.isFile()) {
+      throw new Error('runtime lock inode changed during acquisition');
+    }
+    return release;
+  } catch (error) { release(); throw error; }
+}
diff --git a/test/lock-child.mjs b/test/lock-child.mjs
new file mode 100644
index 0000000000000000000000000000000000000000..52ab26d87b1d4a6d264be562c6fdce3061a6a8e4
--- /dev/null
+++ b/test/lock-child.mjs
@@ -0,0 +1,9 @@
+import { takeRuntimeLock } from '../network/runtime-lock.mjs';
+try {
+  const release = await takeRuntimeLock(process.argv[2]);
+  process.send({ acquired: true });
+  process.on('message', m => {
+    if (m === 'release') { release(); process.exit(0); }
+    if (m === 'try-again') process.send({ acquired: true });
+  });
+} catch (error) { process.send({ acquired: false, error: error.message }, () => process.exit(1)); }
diff --git a/test/runtime-lock.test.mjs b/test/runtime-lock.test.mjs
new file mode 100644
index 0000000000000000000000000000000000000000..3a0c9c39419f274ac67c5a59ecce17efdb0dcddd
--- /dev/null
+++ b/test/runtime-lock.test.mjs
@@ -0,0 +1,82 @@
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import fs from 'node:fs';
+import os from 'node:os';
+import path from 'node:path';
+import { fork } from 'node:child_process';
+import { fileURLToPath } from 'node:url';
+import { takeRuntimeLock } from '../network/runtime-lock.mjs';
+
+const helper = fileURLToPath(new URL('./lock-child.mjs', import.meta.url));
+function area(t) {
+  const dir = fs.mkdtempSync(path.join(os.tmpdir(), 'enclave-kernel-lock-'));
+  t.after(() => fs.rmSync(dir, { recursive: true, force: true }));
+  return path.join(dir, 'runtime.lock');
+}
+function contender(file, t) {
+  const child = fork(helper, [file], { stdio: ['ignore', 'ignore', 'pipe', 'ipc'] });
+  const done = new Promise(resolve => child.once('exit', resolve));
+  const result = new Promise((resolve, reject) => { child.once('message', resolve); child.once('error', reject); });
+  t.after(async () => { if (child.exitCode === null && child.signalCode === null) child.kill('SIGKILL'); await done; });
+  return { child, result, done };
+}
+
+test('real flock child exits, but the parent retains exclusive ownership of an empty file', async t => {
+  const file = area(t), release = await takeRuntimeLock(file); t.after(release);
+  const ino = fs.statSync(file).ino;
+  assert.equal(fs.statSync(file).size, 0);
+  await assert.rejects(takeRuntimeLock(file), /stateDir is in use/);
+  const other = contender(file, t);
+  assert.deepEqual(await other.result, { acquired: false, error: 'stateDir is in use by a running runtime' });
+  release(); release();
+  assert.equal(fs.statSync(file).ino, ino, 'release must not unlink the shared lock inode');
+  const next = contender(file, t); assert.equal((await next.result).acquired, true);
+  next.child.send('release'); await next.done;
+});
+
+test('four real contenders have exactly one owner; owner SIGKILL releases the kernel lock', async t => {
+  const file = area(t), children = Array.from({ length: 4 }, () => contender(file, t));
+  const results = await Promise.all(children.map(c => c.result));
+  assert.equal(results.filter(r => r.acquired).length, 1);
+  const owner = children[results.findIndex(r => r.acquired)];
+  owner.child.kill('SIGKILL'); await owner.done;
+  const next = contender(file, t); assert.equal((await next.result).acquired, true);
+  next.child.send('release'); await next.done;
+});
+
+test('malformed legacy metadata and symlink are refused without changing either target', async t => {
+  const file = area(t);
+  fs.writeFileSync(file, '{');
+  await assert.rejects(takeRuntimeLock(file), /legacy runtime lock/);
+  assert.equal(fs.readFileSync(file, 'utf8'), '{');
+  const link = file + '.link'; fs.symlinkSync(file, link);
+  await assert.rejects(takeRuntimeLock(link), /ELOOP/);
+  assert.equal(fs.readFileSync(file, 'utf8'), '{');
+});
+
+test('missing lock utility releases its parent descriptor; a subsequent real acquisition succeeds', async t => {
+  const file = area(t);
+  await assert.rejects(takeRuntimeLock(file, { flockPath: '/nonexistent/enclave-flock' }), /ENOENT/);
+  const release = await takeRuntimeLock(file); release();
+});
+
+test('pre-aborted acquisition creates no file, and different state directories do not conflict', async t => {
+  const file = area(t);
+  await assert.rejects(takeRuntimeLock(file, { signal: AbortSignal.abort(new Error('cancelled')) }), /cancelled/);
+  assert.equal(fs.existsSync(file), false);
+  const release = await takeRuntimeLock(file), otherRelease = await takeRuntimeLock(file + '.other');
+  release(); otherRelease();
+});
+
+test('a stuck utility is killed on deadline and on cancellation before a retry', async t => {
+  const file = area(t), utility = file + '.utility';
+  // Explicit process-lifecycle seam: this executable delays, it does not emulate
+  // flock. Exclusion itself is tested above using the real installed utility.
+  fs.writeFileSync(utility, `#!${process.execPath}\nsetInterval(() => {}, 1000);\n`, { mode: 0o700 });
+  await assert.rejects(takeRuntimeLock(file, { flockPath: utility, timeoutMs: 100 }), /deadline exceeded/);
+  const controller = new AbortController();
+  const pending = takeRuntimeLock(file, { flockPath: utility, signal: controller.signal });
+  const timer = setTimeout(() => controller.abort(new Error('cancel during acquisition')), 100);
+  try { await assert.rejects(pending, /cancel during acquisition/); } finally { clearTimeout(timer); }
+  const release = await takeRuntimeLock(file); release();
+});
