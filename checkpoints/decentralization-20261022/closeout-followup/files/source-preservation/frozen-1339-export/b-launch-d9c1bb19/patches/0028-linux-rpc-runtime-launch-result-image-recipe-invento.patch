+ network/rpc-runtime-main.mjs |  10 +++-
+ network/rpc-runtime.mjs      | 107 ++++++++++++++++++++++++++++++-----
+ test/rpc-runtime.test.mjs    |  33 +++++++++++
+ 3 files changed, 134 insertions(+), 16 deletions(-)
+
+diff --git a/network/rpc-runtime-main.mjs b/network/rpc-runtime-main.mjs
+index aa294d71a75c0a1d79a3e890f803976ed6dd918f..b5c64b41c968e224630cb1c3133a69e4def9552b 100644
+--- a/network/rpc-runtime-main.mjs
++++ b/network/rpc-runtime-main.mjs
+@@ -9,6 +9,7 @@
+ // unset chainAuthority there (the legacy provider quorum), never a fallback inside this runtime.
+ import fs from 'node:fs';
+ import { createHash } from 'node:crypto';
++import path from 'node:path';
+ import { validateRuntimeConfig, runRpcRuntimeProcess, preflightTools, LABELS, CHAIN_ID } from './rpc-runtime.mjs';
+ 
+ const [cmd, file] = process.argv.slice(2);
+@@ -24,6 +25,12 @@ if (cmd === 'check') {
+     binaries[role] = { path: b.path, pinned: b.sha256, actual: digest, build: b.build, ok: digest === b.sha256 };
+     ok &&= digest === b.sha256;
+   }
++  if (config.glibcRuntime) for (const [n, want] of Object.entries(config.glibcRuntime.files)) {
++    const f = path.join(config.glibcRuntime.dir, n);
++    let digest; try { digest = createHash('sha256').update(fs.readFileSync(f)).digest('hex'); } catch (e) { digest = `unreadable (${e.code || e.message})`; }
++    binaries[`glibc ${n}`] = { path: f, pinned: want, actual: digest, build: config.glibcRuntime.build, ok: digest === want };
++    ok &&= digest === want;
++  }
+   let tools; try { tools = await preflightTools(config.hostTools, { needCurl: !!config.witnessArchive }); } catch (e) { tools = { error: String(e.message || e) }; ok = false; }
+   console.log(JSON.stringify({ ok, chainId: CHAIN_ID, unsafeSigner: config.chain.unsafeSigner, verifierUrl: `http://127.0.0.1:${config.verifier.port}/`,
+     order: ['stateDir kernel lock (flock, parent-held descriptor)', 'witness-check helper (offline)', 'root store (pushed signed heads only)', 'head relay 127.0.0.1:ephemeral',
+@@ -31,7 +38,8 @@ if (cmd === 'check') {
+       'gossip listener (native commitment) -> roots.offer -> relay.offer', 'first fresh verified head', 'Helios 127.0.0.1:' + config.verifier.port, 'ready'],
+     untrustedProofSources: config.proofSources.untrusted.length, witnessCache: 'none',
+     witnessArchive: config.witnessArchive ? { endpoint: config.witnessArchive.endpoint, bucket: config.witnessArchive.bucket, writes: config.witnessArchive.writes } : null,
+-    hostTools: { ...config.hostTools, probed: tools }, binaries, labels: LABELS }, null, 2));
++    hostTools: { ...config.hostTools, probed: tools }, binaryStaging: config.binaryStaging,
++    glibcRuntime: config.glibcRuntime ? { dir: config.glibcRuntime.dir, build: config.glibcRuntime.build, for: config.glibcRuntime.binaries } : null, binaries, labels: LABELS }, null, 2));
+   process.exit(ok ? 0 : 2);
+ }
+ await runRpcRuntimeProcess(raw);   // validated again inside, from the same raw document
+diff --git a/network/rpc-runtime.mjs b/network/rpc-runtime.mjs
+index 8632ddf6896ee2f01ad3f7b6641c12590ed0f21a..2c2de5b3b75b95233263b075a701397f0c40c580 100644
+--- a/network/rpc-runtime.mjs
++++ b/network/rpc-runtime.mjs
+@@ -76,6 +76,22 @@ export const PINNED_BUILDS = Object.freeze({
+   }),
+ });
+ const ROLES = Object.freeze(['listener', 'helios', 'witnessCheck']);
++/**
++ * Exact glibc runtimes a binary may be started under instead of the host's own (sha256 per file, by provenance). For a
++ * userland whose glibc is older than a pinned build needs (the Linux guest base is Debian 12, glibc 2.36; the pinned
++ * Helios needs GLIBC_2.39 and the helper GLIBC_2.38): the binary runs through this runtime's own loader with
++ * --library-path, so only the four files below (the binaries need nothing else) are taken from it. Adding one is a
++ * reviewed source change with test evidence, like PINNED_BUILDS.
++ */
++export const PINNED_GLIBC_RUNTIMES = Object.freeze({
++  'arch glibc 2.44+r50+g1848099f063e-1, gcc-libs 16.2.1+r23+gd564253eb6c8-1 (the build host of the pinned binaries)': Object.freeze({
++    'ld-linux-x86-64.so.2': 'f5e11cc62f8f2c24dff532982559f4303dba3b17e7450551372a88c8e7ea8757',
++    'libc.so.6': '02c8c3d06180beee9c7d0392aa85736c7d19f274a81e7f8f0b3d9e28e0641524',
++    'libm.so.6': '965106704753eefe8c31ae7da6daba3ead3d18c52b19b5fcc41178bcc4aa999d',
++    'libgcc_s.so.1': 'e618cb9c90c2eb3a1dad1cfea5b6c1eebcf2e799ad805976f4ae47bdd61c716a',
++  }),
++});
++const GLIBC_FILES = Object.freeze(['ld-linux-x86-64.so.2', 'libc.so.6', 'libm.so.6', 'libgcc_s.so.1']);
+ const STAGED = Object.freeze({ listener: 'enclave-base-head-listener', helios: 'helios', witnessCheck: 'witness-check' });
