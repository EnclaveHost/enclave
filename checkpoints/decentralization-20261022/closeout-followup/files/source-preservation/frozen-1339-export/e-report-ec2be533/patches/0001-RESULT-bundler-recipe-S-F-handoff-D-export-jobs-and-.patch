+export TMPDIR="$(cd .. && pwd)/tmp"
+export PATH="$HOME/.foundry/bin:$PATH"
+git log -1 --format='HEAD %H'; git status --short | head -40
+sha256sum site/js/core/{profile-broadcast,wallet,chain,passkey-account,account-providers,account-transport}.js "$@"
