diff --git a/jobs/scan-detail.sh b/jobs/scan-detail.sh
new file mode 100755
index 0000000000000000000000000000000000000000..4e33ec7e514c35b49b45efd253f6ec8073e57ce2
--- /dev/null
+++ b/jobs/scan-detail.sh
@@ -0,0 +1,5 @@
+#!/bin/bash
+# which report-repo file gitleaks flags (redacted)
+set -uo pipefail
+cd "$(dirname "$0")/.."
+gitleaks git --no-banner --redact -v . 2>&1 | grep -E "RuleID|File|Commit|Line|Secret|Match" ; exit 0
diff --git a/jobs/scan.sh b/jobs/scan.sh
index 47ad9c8ada3e473104e6bd623c3040c94163f032..f13245997f0e8430867581ec9f6727a6afa6cddd 100755
--- a/jobs/scan.sh
+++ b/jobs/scan.sh
@@ -9,5 +9,5 @@ echo "source crypto scan rc=$rc"
 gitleaks git --no-banner --log-opts="349318a06..HEAD" repo || rc=1
 echo "== report repo"; git log --oneline
 python3 repo/.githooks/scan-crypto-keys.py --range HEAD || rc=1
-gitleaks git --no-banner . || rc=1
+gitleaks git --no-banner --config repo/.gitleaks.toml . || rc=1   # the source repo's own policy (allowlists anvil's public dev keys)
 echo "scan rc=$rc"; exit $rc
