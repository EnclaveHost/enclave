+  snapshot: async () => ({ number: 100, hash: "0x" + "bb".repeat(32), timestamp: 1, baseFeePerGas: 1000n }),
+  code: async () => "0x60", balance: async () => 10n ** 18n,
+  call: async (snap, to, data, opts = {}) => {
