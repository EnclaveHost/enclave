+    fetch: async () => new Response('{}', {status: 404})}), /hostPolicy.endpoint is not this host's registry endpoint/);
+});
+
+test('root: the first indexed batch grants time for the next sync even when no zero-size health was observed', async (t) => {
+  const {cfg, state} = await cfgFor(release()); let reads = 0;
+  const s = replicaStandIn(cfg, () => ({size: ++reads * 2048, complete: reads >= 2}));
