diff --git a/test/helpers/windows-chain-driver.mjs b/test/helpers/windows-chain-driver.mjs
new file mode 100644
index 0000000000000000000000000000000000000000..9046ed081dce84b6ba3493eb598c1ecfb5ed21aa
--- /dev/null
+++ b/test/helpers/windows-chain-driver.mjs
@@ -0,0 +1,50 @@
+// A child process that loads the REAL Windows node chain module (windows/node/chain.mjs, through its shipped admission
+// bundle) under the environment the test gives it, runs the named operations in order and prints one JSON line:
+// { results: [{ op, ok, value | error, code }] }. The chain module reads its authority from the environment when it
+// loads, so each environment is its own process - exactly as on a node.
+//   argv[2]: JSON [{ op, ...args }]; argv[3] (optional): the windows/node directory to load from (a staged closure).
+import path from 'node:path';
+import { pathToFileURL, fileURLToPath } from 'node:url';
+
+const ops = JSON.parse(process.argv[2]);
+const nodeDir = process.argv[3] || path.resolve(path.dirname(fileURLToPath(import.meta.url)), '../../windows/node');
+const load = (f) => import(pathToFileURL(path.join(nodeDir, f)).href);
+const plain = (v) => JSON.parse(JSON.stringify(v, (_k, x) => (typeof x === 'bigint' ? x.toString() : x)));
+const results = [];
+let chain;
+for (const o of ops) {
+  try {
+    chain ||= await load('chain.mjs');
+    let value;
+    switch (o.op) {
+      case 'authority': value = { authority: chain.chainAuthority(), rpcUrls: chain.rpcUrls() }; break;
+      case 'resolveAddresses': value = await chain.resolveAddresses(); break;
+      case 'allDeployments': value = (await chain.allDeployments({ pageSize: o.pageSize || 100 })).map((d) => ({ id: d.id, owner: d.owner, appRef: d.appRef })); break;
+      case 'readDeployment': value = await chain.readDeployment(o.id); break;
+      case 'readEnclave': value = await chain.readEnclave(o.id); break;
+      case 'resolveAppRef': value = await chain.resolveAppRef(o.appRef); break;
+      case 'claimableBy': value = await chain.claimableBy(o.id, o.enclaveId); break;
+      case 'stateTx': value = await chain.publicClient().getTransactionCount({ address: o.address }); break;      // must refuse by name
+      case 'txNonce': value = await chain.transactionClient().getTransactionCount({ address: o.address }); break;
+      case 'txLogs': value = await chain.payoutDeclarations(o.id, BigInt(o.fromBlock || 0)); break;
+      case 'checkEndpoint': {
+        const { chainReader } = await load('chain-reader.mjs');
+        const { checkEndpointOnChain } = await load('host-identity.mjs');
+        value = await checkEndpointOnChain({ endpoint: o.endpoint, operator: o.operator, registry: o.registry, reader: await chainReader({ rpcs: o.rpcs || [] }) });
+        break;
+      }
+      case 'sessionVerify': {
+        const { createSessionApiAuth } = await load('session-api-auth.mjs');
+        const auth = (globalThis.__auth ||= createSessionApiAuth({ pc: chain.publicClient(), snapshot: chain.stateSnapshot(), authorityPins: o.pins,
+          bases: () => [o.base] }));
+        value = await auth.verify({ header: o.header, method: o.method, path: o.path, scope: o.scope || null });
+        value = { vault: value.vault, sid: value.sid, owner: value.owner };
+        break;
+      }
+      default: throw new Error('unknown op ' + o.op);
+    }
+    results.push({ op: o.op, ok: true, value: plain(value) });
+  } catch (e) { results.push({ op: o.op, ok: false, error: String(e?.message || e).slice(0, 800), code: e?.code ?? e?.cause?.code ?? null }); }
+}
+process.stdout.write(JSON.stringify({ results }) + '\n');
+process.exit(0);
diff --git a/test/network-owner-verifier.test.mjs b/test/network-owner-verifier.test.mjs
new file mode 100644
index 0000000000000000000000000000000000000000..8dcb97e7f4cac209e697dd57d6c2c69506ae722d
--- /dev/null
+++ b/test/network-owner-verifier.test.mjs
@@ -0,0 +1,55 @@
+// The network host's owner-signature verification under the explicit local verifier (no pins, no provider clients): a
+// contract-wallet (SessionVault) owner is verified through the authenticated reader at ONE block, with the SessionVault
+// factory read from the admin's address book at that block; a refusing reader answers "not the owner"; an EOA owner needs no
+// chain read. The legacy reader without pins and without RPCs is unchanged (EOA only). The real-chain version of this is
+// test/windows-verifier.e2e.test.mjs (enrollment -> privacy-agent construction -> policyFor on reth + Helios).
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import fs from 'node:fs';
+import os from 'node:os';
+import path from 'node:path';
+import { privateKeyToAccount } from 'viem/accounts';
+import { stringToHex } from 'viem';
+import { createNetworkHost } from '../network/enclave-network-host.mjs';
+import { defaultNetworkPolicy, signNetworkPolicy } from '../network/network-policy.mjs';
+
+const a = (n) => '0x' + n.repeat(40), book = a('1'), factory = a('4'), vault = a('5');
+const id = '0x' + 'b'.repeat(64);
+const owner = privateKeyToAccount('0x' + '11'.repeat(32));
+const FACTORY_KEY = stringToHex('sessionVaultFactory', { size: 32 });
+// the pinned client a verified snapshot hands its callback (block 998)
+const pinned = (st) => ({
+  getCode: async (q) => { assert.equal(q.blockNumber, 998n); return q.address === vault ? '0x01' : '0x'; },
+  readContract: async (q) => {
+    assert.equal(q.blockNumber, 998n);
+    if (q.functionName === 'addr') { assert.equal(q.address, book); assert.equal(q.args[0], FACTORY_KEY); st.bookReads++; return st.factory; }
+    if (q.functionName === 'isValidSignature') return '0xffffffff';
+    if (q.functionName === 'isVault') return q.address === factory;
+    if (q.functionName === 'owner') { assert.equal(q.address, vault); return owner.address; }
+    throw new Error('unexpected ' + q.functionName);
+  },
+});
+const verifierReader = (st) => ({ authority: 'verifier', agreed: async (fn) => { st.snapshots++; if (st.refuse) throw new Error('no fresh verified chain state: stand-in'); return fn(pinned(st), 998n); } });
+
+test('verifier-authority reader: a SessionVault owner policy is admitted at one block, follows the book, and fails closed', async (t) => {
+  const dir = fs.mkdtempSync(path.join(process.env.TEST_TMP || os.tmpdir(), 'owner-verifier-')); t.after(() => fs.rmSync(dir, { recursive: true, force: true }));
+  const config = { relay: 'http://127.0.0.1:9', checkers: [owner.address], apps: 'all', wgBinary: '/bin/true', nodeBinary: process.execPath, workerModule: '/bin/true' };
+  const policy = { ...defaultNetworkPolicy(id), nonce: 1, issuedAt: 1 }; const envelope = await signNetworkPolicy(owner, policy);
+  const host = (leaseReader) => createNetworkHost({ config, directory: fs.mkdtempSync(path.join(dir, 'h-')), addressBook: book, leaseReader, fetch: async () => Response.json({ envelope }) });
+  const st = { factory, bookReads: 0, snapshots: 0, refuse: false };
+  assert.deepEqual(await (await host(verifierReader(st))).policyFor({ deploymentId: id }, { id, owner: vault }), policy);
+  // the directory lookup and the admission each verify the signature: every verification is ONE snapshot that read the factory
+  // from the admin book at its own verified block
+  assert.ok(st.snapshots >= 1); assert.equal(st.bookReads, st.snapshots, 'the factory came from the admin book at the verified block');
+  st.factory = a('9');                                                          // the admin repoints the book's factory
+  await assert.rejects((await host(verifierReader(st))).policyFor({ deploymentId: id }, { id, owner: vault }), /no valid owner policy/);
+  st.factory = factory; st.refuse = true;                                       // stale head / missing proof
+  await assert.rejects((await host(verifierReader(st))).policyFor({ deploymentId: id }, { id, owner: vault }), /no valid owner policy/);
+  const before = st.snapshots;
+  assert.deepEqual(await (await host(verifierReader(st))).policyFor({ deploymentId: id }, { id, owner: owner.address }), policy, 'EOA owner: no chain read');
+  assert.equal(st.snapshots, before);
+  // legacy (provider-quorum) reader without pins and without RPCs: contract owners refused exactly as before
+  const legacy = { authority: 'quorum', agreed: async () => { throw new Error('the legacy path must not use the reader for owners'); } };
+  await assert.rejects((await host(legacy)).policyFor({ deploymentId: id }, { id, owner: vault }), /no valid owner policy/);
+  assert.deepEqual(await (await host(legacy)).policyFor({ deploymentId: id }, { id, owner: owner.address }), policy);
+});
diff --git a/test/node-policy-carriers.test.mjs b/test/node-policy-carriers.test.mjs
new file mode 100644
index 0000000000000000000000000000000000000000..a7af27895e091fe68684c5007238a9c41264a8dc
--- /dev/null
+++ b/test/node-policy-carriers.test.mjs
@@ -0,0 +1,247 @@
+// Platform host policy CARRIERS for the HOST runtimes (windows/node/host-admission.bundle.mjs createHostServiceGate, as imported by
+// the deployed windows/node/host.mjs 9634cb40 and by supervisor.js), on a local policy world (test/helpers/platform-policy-world.mjs:
+// three loopback JSON-RPC origins answering the book owner/anchor/registry, the registry row and host ownership; the admin's
+// key signs real EIP-712 policies; "anchoring" sets the book's two anchor values). No real chain, key, mirror or Enclave
+// service; no DigitalOcean origin anywhere. Run inside tools/make-testtree.sh's tree with --preserve-symlinks.
+//   BUNDLE_UNDER_TEST=live  -> the same file against the INSTALLED bundle 6bef372d: the delivery tests must FAIL (old control)
+import { test } from "node:test";
+import assert from "node:assert/strict";
+import fs from "node:fs";
+import os from "node:os";
+import path from "node:path";
+import http from "node:http";
+import { keccak256, toBytes } from "viem";
+import { generatePrivateKey, privateKeyToAccount } from "viem/accounts";
+import { platformPolicyWorld, BOOK, REGISTRY, OWNERSHIP } from "./helpers/platform-policy-world.mjs";
+import { POLICY_FORMAT, policyTypedData, policyDigest, encodeAnchor } from "../network/platform-host-policy.mjs";
+import * as B from "../windows/node/host-admission.bundle.mjs";
+
+const EP = "https://api.enclave.host/t/carrier-test", HOST = keccak256(toBytes(EP)).toLowerCase();
+const OP = "0x" + "44".repeat(20), Z32 = "0x" + "00".repeat(32), ZA = "0x" + "00".repeat(20);
+const CARRIER_MIRROR = "https://policy-carriers.invalid/platform-policy";
+const tmp = (p) => fs.mkdtempSync(path.join(os.tmpdir(), p));
+const now = () => Math.floor(Date.now() / 1000);
+
+async function world(t) { return platformPolicyWorld(t, { hosts: { [HOST]: { endpoint: EP, operator: OP, owner: "0x" + "55".repeat(20), active: true } } }); }
+/** the admin's document: { digest, entry: {document, signature}, policy }; anchor=true sets the book's anchor to it */
+async function sign(w, { sequence, deny = [], mode = "denylist", admit = [], issuedAt = now() - 5, expiresAt = 0, maxStaleSec = 0, signer = w.admin, anchor = true }) {
+  const p = { format: POLICY_FORMAT, chainId: 8453, book: BOOK, registry: REGISTRY, hostOwnership: OWNERSHIP, sequence, issuedAt, expiresAt, maxStaleSec, previousDigest: Z32, mode, deny, admit };
+  const digest = policyDigest(p), entry = { document: JSON.stringify(p), signature: await signer.signTypedData(policyTypedData(p)) };
+  if (anchor) { const a = encodeAnchor(digest); w.state.hi = a.hi; w.state.lo = a.lo; }
+  return { digest, entry, policy: p };
+}
+const put = (dir, name, entry) => { fs.mkdirSync(dir, { recursive: true }); fs.writeFileSync(path.join(dir, `${name}.json`), JSON.stringify(entry)); };
+// the node's environment: the explicit policy (the world's book), NO mirror at all, the world's RPC quorum, and the carriers
+const envOf = (w, carriers, extra = {}) => ({ ENCLAVE_PLATFORM_HOST_POLICY: JSON.stringify({ book: BOOK, hostOwnership: OWNERSHIP, mirrors: [] }),
+  ENCLAVE_PLATFORM_HOST_POLICY_RPCS: w.rpcs.join(","), ...(carriers ? { ENCLAVE_PLATFORM_HOST_POLICY_CARRIERS: JSON.stringify(carriers) } : {}), ...extra });
+const gateOf = (env, stateDir = tmp("gate-state-"), log = () => {}) => B.createHostServiceGate({ env, chainId: 8453, book: null, endpoint: EP, stateDir, log });
+// the test world's loopback RPCs can refuse one read at a wall-clock second boundary ("rpc_refused"): a check is repeated ONLY
+// while its outcome is that transient one, so no assertion below is ever satisfied by an unreadable chain
+const TRANSIENT = /^(unreadable|undecided|refused-unreadable)$/;
+async function settled(g, tries = 15) { let s; for (let i = 0; i < tries; i++) { s = await g.check(); if (!TRANSIENT.test(String(s.status))) return s; await new Promise((r) => setTimeout(r, 400)); } return s; }
+const persisted = (dir) => { try { return JSON.parse(fs.readFileSync(path.join(dir, "platform-host-admission.json"), "utf8")); } catch { return null; } };
+
+test("unset: the gate is the base gate (no carrier origin, same quorum) and an ANCHORED policy is unreachable without a mirror (the outage)", async (t) => {
+  const w = await world(t); const d = await sign(w, { sequence: 1 });
+  const g = gateOf(envOf(w, null));
