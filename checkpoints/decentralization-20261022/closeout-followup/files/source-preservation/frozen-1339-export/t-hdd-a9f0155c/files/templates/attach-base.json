{
 "format": "enclave-rpc-hdd-attach/v1",
 "role": "base",
 "server": {
  "address": "192.168.8.249",
  "port": 10810,
  "serverName": "enclave-rpc-hdd-base.warden.lan"
 },
 "tls": {
  "dir": "/etc/enclave-rpc-hdd/base/client"
 },
 "placement": {
  "exportName": "enclave-rpc-base",
