  "imagePath": "/mnt/usb/enclave-rpc/base-origin.img",
  "mountTarget": "/mnt/usb",
  "fstype": "ntfs3",
  "requireRotational": true,
  "serverCertSha256": "REPLACE-with-placement.json-serverCertSha256",
  "caCertSha256": "REPLACE-with-placement.json-caCertSha256"
 },
 "device": "/dev/nbd1",
 "filesystem": {
  "label": "enc-rpc-base",
  "uuid": null
 },
 "mountPoint": "/srv/rpc-hdd/base",
 "stateDir": "/run/enclave-rpc-hdd/base",
 "qemuNbd": "/usr/bin/qemu-nbd",
 "qemuImg": "/usr/bin/qemu-img"
}