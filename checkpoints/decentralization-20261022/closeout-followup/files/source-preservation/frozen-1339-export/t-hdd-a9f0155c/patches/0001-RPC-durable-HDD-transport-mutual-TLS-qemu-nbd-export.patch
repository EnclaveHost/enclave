diff --git a/templates/enclave-rpc-hdd-attach@.service b/templates/enclave-rpc-hdd-attach@.service
new file mode 100644
index 0000000000000000000000000000000000000000..b468fbcfa7b49c3a0a17446534c233cefcad8187
--- /dev/null
+++ b/templates/enclave-rpc-hdd-attach@.service
@@ -0,0 +1,26 @@
+# NucBox Linux VM. Template, NOT installed by this repository. Instance: l1 | base.
+# Config: /etc/enclave-rpc-hdd/attach-%i.json (filesystem.uuid filled in after the one explicit first-format).
+# Consumers (P's/B's node units) add:
+#   BindsTo=enclave-rpc-hdd-attach@<role>.service
+#   After=enclave-rpc-hdd-attach@<role>.service
+#   RequiresMountsFor=/srv/rpc-hdd/<role>
+#   ExecStartPre=/usr/bin/python3 -I /opt/enclave-rpc-hdd/transport/hddattach.py verify-mounted /etc/enclave-rpc-hdd/attach-<role>.json
+# None of the systemd behaviour in this file was exercised by the integration test; it is untested.
+[Unit]
+Description=Enclave RPC durable-HDD attach (%i): kernel NBD over mutual TLS
+After=network-online.target
+Wants=network-online.target
+
+[Service]
+Type=oneshot
+RemainAfterExit=yes
+# Root: nbd needs CAP_SYS_ADMIN, and the module is loaded explicitly here, never by the tool.
+ExecStartPre=/usr/sbin/modprobe nbd nbds_max=4
+ExecStart=/usr/bin/python3 -I /opt/enclave-rpc-hdd/transport/hddattach.py attach /etc/enclave-rpc-hdd/attach-%i.json
+ExecStart=/usr/bin/python3 -I /opt/enclave-rpc-hdd/transport/hddattach.py mount /etc/enclave-rpc-hdd/attach-%i.json
+ExecStop=/usr/bin/python3 -I /opt/enclave-rpc-hdd/transport/hddattach.py detach /etc/enclave-rpc-hdd/attach-%i.json
+TimeoutStartSec=180
+TimeoutStopSec=300
+
+[Install]
+WantedBy=multi-user.target
diff --git a/templates/enclave-rpc-hdd-export@.service b/templates/enclave-rpc-hdd-export@.service
new file mode 100644
index 0000000000000000000000000000000000000000..44b4ba111577f1fb45072521b10ce87763a723db
--- /dev/null
+++ b/templates/enclave-rpc-hdd-export@.service
@@ -0,0 +1,34 @@
+# Desktop (the host of the HDD array). Template, NOT installed by this repository.
+# Instance: l1 | base. Config: /etc/enclave-rpc-hdd/export-%i.json.
+# User: the uid the ntfs3 mount maps every file to (/mnt/usb is uid=1000), because the image must be owned by the service
+# user. A dedicated user needs a remount with its uid, which is an operator decision outside this tool.
+[Unit]
+Description=Enclave RPC durable-HDD export (%i) over mutual-TLS NBD
+RequiresMountsFor=/mnt/usb
+After=network-online.target
+Wants=network-online.target
+StartLimitIntervalSec=600
+StartLimitBurst=5
+
+[Service]
+Type=simple
+User=@EXPORT_USER@
+# Every check runs before qemu-nbd is exec'd, so the main PID is qemu-nbd itself. A missing mount refuses with exit 2.
+ExecStart=/usr/bin/python3 -I /opt/enclave-rpc-hdd/transport/hddexport.py serve /etc/enclave-rpc-hdd/export-%i.json
+Restart=on-failure
+RestartSec=10
+KillMode=control-group
+TimeoutStopSec=30
+NoNewPrivileges=yes
+ProtectSystem=strict
+ProtectHome=yes
+PrivateTmp=yes
+PrivateDevices=yes
+ReadWritePaths=/mnt/usb/enclave-rpc /var/lib/enclave-rpc-hdd/%i
+RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
+MemoryMax=512M
+TasksMax=64
+LimitNOFILE=1024
+
+[Install]
+WantedBy=multi-user.target
diff --git a/templates/enclave-rpc-hdd.nft b/templates/enclave-rpc-hdd.nft
new file mode 100644
index 0000000000000000000000000000000000000000..d454a4ea17d91351b08dbf114047799efacb752c
--- /dev/null
+++ b/templates/enclave-rpc-hdd.nft
@@ -0,0 +1,11 @@
+# Desktop nftables fragment. Template, NOT applied by this repository.
+# Only the NucBox LAN address may open a TCP connection to the two exports. This is defence in depth: qemu-nbd also
+# requires the per-role client certificate, the authz DN and TLS before any NBD option.
+# Replace @NUCBOX_LAN_IP@ with the address root reads from NucBox (ROOT-PROBES R4). Load it with: nft -f <file>.
+table inet enclave_rpc_hdd {
+  chain input {
+    type filter hook input priority -10; policy accept;
+    tcp dport { 10809, 10810 } ip saddr @NUCBOX_LAN_IP@ accept
+    tcp dport { 10809, 10810 } drop
+  }
+}
