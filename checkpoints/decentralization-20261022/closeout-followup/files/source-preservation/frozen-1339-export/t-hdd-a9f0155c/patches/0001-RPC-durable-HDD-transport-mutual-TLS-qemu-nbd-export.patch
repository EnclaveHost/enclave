+    rec("s11a-detach-after-disconnect", r[0] == 0, rc=r[0], seconds=r[2], out=r[1][-500:],
+        stillConnected=os.path.exists("/sys/block/nbd1/pid"), mounted=any(" /srv/rpc-hdd/base " in l for l in open("/proc/self/mountinfo")))
