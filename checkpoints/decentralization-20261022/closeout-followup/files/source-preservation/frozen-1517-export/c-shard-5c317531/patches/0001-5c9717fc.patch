+    #[tokio::test]
+    async fn a_replaced_store_sends_nothing_more() {
+        let n = Net::on_disk(65);
+        let c = cluster(std::slice::from_ref(&n), 1).await;
+        let uid = c.create_upload("b", "mp").await.unwrap();
