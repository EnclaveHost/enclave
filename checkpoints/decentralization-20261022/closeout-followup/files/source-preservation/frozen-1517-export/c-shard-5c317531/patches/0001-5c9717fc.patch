+    #[tokio::test]
+    async fn fencing_a_delayed_old_writers_pins_are_refused_once_a_new_writer_installed_its_fence() {
+        let nets = [Net::new(1), Net::new(2), Net::new(3)];
+        let (a, r) = fenced(&nets, &all(3), 2, lease_policy(5), None).await;
+        r.unwrap();
+        settle(&a).await;
+        maintain(&a).await;
+        a.put("b", "k", b"v1".to_vec(), None, &Cond::None).await.unwrap();
+        // A's next PUT is delayed in the network on every indexer (applied later), so A answers nothing for it
+        for n in &nets {
+            n.net.push_fault("pin_object", Fault::Defer);
+        }
+        let late = a.put("b", "k", b"stale".to_vec(), None, &Cond::None);
+        let _ = tokio::time::timeout(Duration::from_secs(20), late).await;
+        // B, a later lease, boots: it installs its fence, then lists; it sees v1
+        let (b, r) = fenced(&nets, &all(3), 2, lease_policy(6), None).await;
+        r.unwrap();
+        maintain(&b).await;
+        assert_eq!(get(&b, "k").await.unwrap(), b"v1");
+        b.delete("b", "k").await.unwrap();
+        // the old writer's delayed pins now reach the indexers: each is checked against the fence at that moment
+        let applied = nets.iter().map(|n| n.net.apply_deferred()).sum::<usize>();
+        assert!(applied >= 2, "{applied}");
+        for n in &nets {
+            let (live, deleted, _) = on_disk(n, "k").await;
+            assert!(live.is_none() && deleted, "the delayed stale PUT was refused, the DELETE stands");
+        }
+        // A learns it was superseded at its next answer, and stops for good
+        assert!(a.fresh().await.unwrap_err().contains("ServiceUnavailable"));
+        assert!(a.superseded().is_some() && !a.ready());
+        assert!(a.put("b", "x", b"y".to_vec(), None, &Cond::None).await.is_err());
+        b.fresh().await.unwrap();
+    }
