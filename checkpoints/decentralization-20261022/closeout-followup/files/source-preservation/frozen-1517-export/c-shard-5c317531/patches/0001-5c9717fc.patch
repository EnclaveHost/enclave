+        // Losers abort asynchronously. Wait for their permits to drop before
+        // inspecting the pool.
+        crate::time::timeout(Duration::from_secs(1), async {
+            while *limiter.inflight.lock().unwrap() != 0 {
+                tokio::task::yield_now().await;
