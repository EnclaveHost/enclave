+    /// The object hosting key `k`'s entry on replica `i` (its data object for an inline key).
+    async fn host_of(c: &Cluster, i: usize, k: &str) -> sia_storage::Hash256 {
+        let s = c.store(i).unwrap();
+        let idx = s.idx.lock().await;
+        let key = idx.keys.get(&("b".to_string(), k.to_string())).unwrap();
+        idx.objs[&key.host].0.id()
+    }
+
+    async fn sdk_of(n: &Net) -> sia_storage::Sdk {
+        n.net.sdk(n.key.clone()).await.unwrap()
+    }
+
+    fn is_withheld(e: &str) -> bool {
+        e.starts_with("UnavailableForLegalReasons")
+    }
