+        p1.put("b", "k", b"v1".to_vec(), None, &Cond::None).await.unwrap();
+        let p1_ceiling = p1.version_ceiling();
+        assert!(p1_ceiling > now_ms() + 3_600_000);
+        nets[1].offline(false);
+        nets[2].offline(false);
