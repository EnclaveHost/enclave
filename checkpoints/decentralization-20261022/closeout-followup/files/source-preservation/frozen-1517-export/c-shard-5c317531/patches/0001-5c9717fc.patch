+    #[tokio::test]
+    async fn c2_the_first_copy_to_reach_a_quorum_wins_and_the_losers_tentative_write_never_surfaces() {
+        let nets = [Net::new(1), Net::new(2), Net::new(3)];
+        let p = c2_booted(&nets).await;
+        let q = clone_of(&p, &nets).await;
+        // Q runs an hour ahead (its version would win any merge). Q's phase-1 pin lands only on r2 (r0 and r1 refuse
+        // it: the host drops Q's traffic there); r2 is Q's from now on, and Q's gate stays shut: 503, nothing committed
+        q.clock.set(now_ms() + 3_600_000);
+        nets[0].net.push_fault("pin_object", Fault::Reject);
+        nets[1].net.push_fault("pin_object", Fault::Reject);
+        assert!(q.put("b", "k", b"from-Q".to_vec(), None, &Cond::IfNoneMatch).await.is_err());
+        assert_eq!(tentative_left(&nets).await, vec![0, 0, 1]);
+        // P reaches r0 and r1 first: acknowledged; r2 refuses P's head, so P forks r2 out and goes on with W = 2
+        p.put("b", "k", b"from-P".to_vec(), None, &Cond::IfNoneMatch).await.unwrap();
+        assert!(p.forked_out(2).is_some() && p.forked_out(0).is_none() && p.forked_out(1).is_none());
+        assert!(p.superseded().is_none());
+        p.fresh().await.unwrap();
+        assert_eq!(get(&p, "k").await.unwrap(), b"from-P");
+        // Q sees r0 and r1 moved: it can confirm nothing and stops
+        assert!(q.fresh().await.is_err() && q.superseded().is_some());
+        // recovery: the acknowledged create; Q's tentative pin on r2 is never taken, and maintenance removes it
+        drop(p);
+        drop(q);
+        let (later, r) = fenced(&nets, &all(3), 2, lease_policy(6), None).await;
+        r.unwrap();
+        maintain(&later).await;
+        assert_eq!(get(&later, "k").await.unwrap(), b"from-P");
+        assert_eq!(tentative_left(&nets).await, vec![0, 0, 0]);
+    }
