+//! Minimal async HTTP/1.1 for an S3 endpoint: keep-alive, Content-Length
+//! request bodies (bounded), `Expect: 100-continue`, and response heads with
+//! either a buffered body or one the caller streams after the head.
+
+use tokio::io::{AsyncReadExt, AsyncWriteExt};
+use tokio::net::TcpStream;
+
+const MAX_HEAD: usize = 64 << 10;
+/// A single PUT larger than the buffered body limit streams to Sia (risc-box saves a ~1 GB disk in one PUT); up to this.
+pub const MAX_STREAM: u64 = 16 << 30;
+
+pub struct Request {
+    pub method: String,
+    /// path exactly as sent (still percent-encoded)
+    pub path: String,
+    /// raw query string, without '?'
+    pub query: String,
+    /// names lowercased
+    pub headers: Vec<(String, String)>,
+    pub body: Vec<u8>,
+    pub keep_alive: bool,
+    /// a streamed PUT: `body` holds the bytes already read, and this many more are still on the socket
+    pub stream: Option<u64>,
+}
+
+impl Request {
+    pub fn header(&self, name: &str) -> Option<&str> {
+        self.headers.iter().find(|(k, _)| k == name).map(|(_, v)| v.as_str())
+    }
+}
+
+pub enum ReadError {
+    Closed,
+    TooLarge,
+    Bad(String),
+}
+
+/// Reads one request. `carry` holds bytes already read past the previous request.
+pub async fn read_request(s: &mut TcpStream, carry: &mut Vec<u8>, max_body: usize) -> Result<Request, ReadError> {
+    let mut buf = std::mem::take(carry);
+    let head_end = loop {
+        if let Some(i) = buf.windows(4).position(|w| w == b"\r\n\r\n") {
+            break i + 4;
+        }
+        if buf.len() > MAX_HEAD {
+            return Err(ReadError::Bad("request head too large".into()));
+        }
+        let mut chunk = [0u8; 16 << 10];
+        let n = s.read(&mut chunk).await.map_err(|e| ReadError::Bad(e.to_string()))?;
+        if n == 0 {
+            return Err(ReadError::Closed);
+        }
+        buf.extend_from_slice(&chunk[..n]);
+    };
+
+    let mut hdrs = [httparse::EMPTY_HEADER; 64];
+    let mut req = httparse::Request::new(&mut hdrs);
+    match req.parse(&buf[..head_end]) {
+        Ok(httparse::Status::Complete(_)) => {}
+        _ => return Err(ReadError::Bad("malformed request head".into())),
+    }
+    let method = req.method.unwrap_or("").to_string();
+    let target = req.path.unwrap_or("/").to_string();
+    let http10 = req.version == Some(0);
+    let headers: Vec<(String, String)> = req
+        .headers
+        .iter()
+        .map(|h| (h.name.to_ascii_lowercase(), String::from_utf8_lossy(h.value).trim().to_string()))
+        .collect();
+    let get = |n: &str| headers.iter().find(|(k, _)| k == n).map(|(_, v)| v.as_str());
+
+    let chunked = match get("transfer-encoding") {
+        None => false,
+        Some(v) if v.eq_ignore_ascii_case("identity") => false,
+        // wasi:http clients (jot, depot) send even an empty DELETE body chunked, and R2 accepts it
+        Some(v) if v.eq_ignore_ascii_case("chunked") => true,
+        Some(_) => return Err(ReadError::Bad("unsupported transfer-encoding".into())),
+    };
+    if chunked {
+        let keep_alive = match get("connection") {
+            Some(v) if v.eq_ignore_ascii_case("close") => false,
+            Some(v) if v.eq_ignore_ascii_case("keep-alive") => true,
+            _ => !http10,
+        };
+        if get("expect").is_some_and(|v| v.eq_ignore_ascii_case("100-continue")) && buf.len() == head_end {
+            s.write_all(b"HTTP/1.1 100 Continue\r\n\r\n").await.map_err(|e| ReadError::Bad(e.to_string()))?;
+        }
+        let mut rest = buf.split_off(head_end);
+        let body = read_chunked(s, &mut rest, max_body).await?;
+        *carry = rest;
+        let (path, query) = match target.split_once('?') {
+            Some((p, q)) => (p.to_string(), q.to_string()),
+            None => (target, String::new()),
+        };
+        return Ok(Request { method, path, query, headers, body, keep_alive, stream: None });
+    }
+    let len: usize = match get("content-length") {
+        Some(v) => v.parse().map_err(|_| ReadError::Bad("bad content-length".into()))?,
+        None => 0,
+    };
+    // only a plain object PUT may stream (not a part, not a copy); everything else stays bounded
+    let streams = len > max_body
+        && method == "PUT"
+        && !target.contains("uploadId=")
+        && get("x-amz-copy-source").is_none()
+        && len as u64 <= MAX_STREAM;
+    if len > max_body && !streams {
+        return Err(ReadError::TooLarge);
+    }
+    let keep_alive = streams.then_some(false).unwrap_or(match get("connection") {
+        Some(v) if v.eq_ignore_ascii_case("close") => false,
+        Some(v) if v.eq_ignore_ascii_case("keep-alive") => true,
+        _ => !http10,
+    });
+    if len > 0 && get("expect").is_some_and(|v| v.eq_ignore_ascii_case("100-continue")) && buf.len() == head_end {
+        s.write_all(b"HTTP/1.1 100 Continue\r\n\r\n").await.map_err(|e| ReadError::Bad(e.to_string()))?;
+    }
+
+    let mut body = buf.split_off(head_end);
+    if streams {
+        body.truncate(len);
+        let rest = (len - body.len()) as u64;
+        let (path, query) = match target.split_once('?') {
+            Some((p, q)) => (p.to_string(), q.to_string()),
+            None => (target, String::new()),
+        };
+        return Ok(Request { method, path, query, headers, body, keep_alive, stream: Some(rest) });
+    }
+    while body.len() < len {
+        let mut chunk = vec![0u8; (len - body.len()).min(256 << 10)];
+        let n = s.read(&mut chunk).await.map_err(|e| ReadError::Bad(e.to_string()))?;
+        if n == 0 {
+            return Err(ReadError::Closed);
+        }
+        body.extend_from_slice(&chunk[..n]);
+    }
+    if body.len() > len {
+        *carry = body.split_off(len);
+    }
+
+    let (path, query) = match target.split_once('?') {
+        Some((p, q)) => (p.to_string(), q.to_string()),
+        None => (target, String::new()),
+    };
+    Ok(Request { method, path, query, headers, body, keep_alive, stream: None })
+}
+
+/// A chunked body, at most `max_body` bytes; `buf` holds bytes already read and keeps any read past the body's end.
+async fn read_chunked(s: &mut TcpStream, buf: &mut Vec<u8>, max_body: usize) -> Result<Vec<u8>, ReadError> {
+    async fn more(s: &mut TcpStream, buf: &mut Vec<u8>) -> Result<(), ReadError> {
+        let mut chunk = [0u8; 16 << 10];
+        let n = s.read(&mut chunk).await.map_err(|e| ReadError::Bad(e.to_string()))?;
+        if n == 0 {
+            return Err(ReadError::Closed);
+        }
+        buf.extend_from_slice(&chunk[..n]);
+        Ok(())
+    }
+    async fn line(s: &mut TcpStream, buf: &mut Vec<u8>) -> Result<String, ReadError> {
+        loop {
+            if let Some(i) = buf.windows(2).position(|w| w == b"\r\n") {
+                let l = String::from_utf8_lossy(&buf[..i]).to_string();
+                buf.drain(..i + 2);
+                return Ok(l);
+            }
+            if buf.len() > 8 << 10 {
+                return Err(ReadError::Bad("chunk size line too long".into()));
+            }
+            more(s, buf).await?;
+        }
+    }
+    let mut body = Vec::new();
+    loop {
+        let size_line = line(s, buf).await?;
+        let hex = size_line.split(';').next().unwrap_or("").trim();
+        let n = usize::from_str_radix(hex, 16).map_err(|_| ReadError::Bad("bad chunk size".into()))?;
+        if n == 0 {
+            // trailers, then the blank line that ends the body
+            while !line(s, buf).await?.is_empty() {}
+            return Ok(body);
+        }
+        if body.len() + n > max_body {
+            return Err(ReadError::TooLarge);
+        }
+        while buf.len() < n + 2 {
+            more(s, buf).await?;
+        }
+        if &buf[n..n + 2] != b"\r\n" {
+            return Err(ReadError::Bad("chunk not followed by CRLF".into()));
+        }
+        body.extend_from_slice(&buf[..n]);
+        buf.drain(..n + 2);
+    }
+}
+
+pub fn reason(status: u16) -> &'static str {
+    match status {
+        200 => "OK",
+        204 => "No Content",
+        206 => "Partial Content",
+        400 => "Bad Request",
+        304 => "Not Modified",
+        403 => "Forbidden",
+        404 => "Not Found",
+        405 => "Method Not Allowed",
+        409 => "Conflict",
+        411 => "Length Required",
+        412 => "Precondition Failed",
+        413 => "Payload Too Large",
+        416 => "Range Not Satisfiable",
+        451 => "Unavailable For Legal Reasons",
+        500 => "Internal Server Error",
+        501 => "Not Implemented",
+        503 => "Service Unavailable",
+        _ => "",
+    }
+}
+
+/// Writes a response head; the body (of `len` bytes) is the caller's to write next.
+pub async fn write_head(s: &mut TcpStream, status: u16, headers: &[(String, String)], len: u64, keep_alive: bool) -> std::io::Result<()> {
+    let mut h = format!("HTTP/1.1 {status} {}\r\nServer: sia-s3\r\nContent-Length: {len}\r\n", reason(status));
+    for (k, v) in headers {
+        h.push_str(&format!("{k}: {v}\r\n"));
+    }
+    h.push_str(if keep_alive { "Connection: keep-alive\r\n\r\n" } else { "Connection: close\r\n\r\n" });
+    s.write_all(h.as_bytes()).await
+}
diff --git a/sia-s3/src/import.rs b/sia-s3/src/import.rs
new file mode 100644
index 0000000000000000000000000000000000000000..ab82ac956da1320021978803b0109dff2ffe9337
--- /dev/null
+++ b/sia-s3/src/import.rs
@@ -0,0 +1,181 @@
+//! Bulk import: `sia-s3 import <bucket> <manifest.json>`
+//!
+//! The manifest is `[{"key", "size", "url"}]`. Each object is fetched from its
+//! URL in ranged chunks (memory stays bounded for multi-GiB files) and streamed
+//! into a packed upload, so many small objects share slabs instead of each
+//! paying for a full one. Objects are pinned per batch with the same metadata
+//! the server writes, so a running sia-s3 sees them after its next index load.
+//! Keys already present with the same size are skipped: re-running resumes.
+//!
+//! With several indexers configured, run it once per replica (`sia-s3 import
+//! <bucket> <manifest> <replica>`) with the same `SIAS3_IMPORT_VERSION_MS`: each
+//! key's version is then identical on every replica (clock from that variable,
+//! write id from the key and its content), so repair has nothing to copy.
+
+use std::time::Instant;
+
+use md5::{Digest, Md5};
+use serde::Deserialize;
+use sha2::Sha256;
+use sia_storage::{PackedUploadOptions, Sdk};
+use tokio::io::AsyncWriteExt;
+
+use crate::store::{Entry, Store};
+
+#[derive(Deserialize, Clone)]
+struct Item {
+    key: String,
+    size: u64,
+    url: String,
+}
+
+const CHUNK: u64 = 32 << 20;
+const BATCH_BYTES: u64 = 512 << 20;
+
+async fn fetch(client: &reqwest_wasi::Client, item: &Item, mut w: tokio::io::DuplexStream) -> Result<String, String> {
+    let mut md5 = Md5::new();
+    let mut off = 0u64;
+    while off < item.size {
+        let end = (off + CHUNK).min(item.size) - 1;
+        let mut tries = 0;
+        let body = loop {
+            let r = client
+                .get(item.url.as_str())
+                .header("range", format!("bytes={off}-{end}"))
+                .timeout(std::time::Duration::from_secs(300))
+                .send()
+                .await;
+            match r {
+                Ok(resp) if resp.status().as_u16() == 206 || (resp.status().as_u16() == 200 && off == 0 && end + 1 == item.size) => {
+                    let b = resp.bytes().await.map_err(|e| e.to_string())?;
+                    if b.len() as u64 == end - off + 1 {
+                        break b;
+                    }
+                }
+                Ok(resp) => eprintln!("[import] {}: HTTP {} for bytes {off}-{end}", item.key, resp.status()),
+                Err(e) => eprintln!("[import] {}: {e}", item.key),
+            }
+            tries += 1;
+            if tries >= 5 {
+                return Err(format!("{}: giving up on bytes {off}-{end}", item.key));
+            }
+            tokio::time::sleep(std::time::Duration::from_secs(2 * tries)).await;
+        };
+        md5.update(&body);
+        w.write_all(&body).await.map_err(|e| e.to_string())?;
+        off = end + 1;
+    }
+    w.shutdown().await.map_err(|e| e.to_string())?;
+    Ok(hex::encode(md5.finalize()))
+}
+
+/// The write id of an imported key: the same key with the same content gets the same id on every replica.
+fn import_wid(bucket: &str, key: &str, etag: &str, size: u64) -> String {
+    let mut h = Sha256::new();
+    for part in [bucket.as_bytes(), key.as_bytes(), etag.as_bytes(), &size.to_be_bytes()] {
+        h.update((part.len() as u64).to_be_bytes());
+        h.update(part);
+    }
+    hex::encode(&h.finalize()[..8])
+}
+
+pub async fn run(sdk: Sdk, bucket: String, manifest: String) -> Result<(), String> {
+    let version_ms: u64 = match std::env::var("SIAS3_IMPORT_VERSION_MS") {
+        Ok(v) => v.parse().map_err(|_| "SIAS3_IMPORT_VERSION_MS must be milliseconds since 1970")?,
+        Err(_) => chrono::Utc::now().timestamp_millis() as u64,
+    };
+    eprintln!("[import] version clock {version_ms} (set SIAS3_IMPORT_VERSION_MS to this for the other replicas)");
+    let items: Vec<Item> = serde_json::from_slice(&std::fs::read(&manifest).map_err(|e| format!("{manifest}: {e}"))?)
+        .map_err(|e| format!("manifest: {e}"))?;
+    let store = Store::load(sdk, 0).await?;
+    let todo: Vec<Item> = {
+        let idx = store.idx.lock().await;
+        items
+            .into_iter()
+            .filter(|i| i.size > 0) // empty objects go through the normal PUT path
+            .filter(|i| idx.keys.get(&(bucket.clone(), i.key.clone())).is_none_or(|k| k.entry.s != i.size))
+            .collect()
+    };
+    let total: u64 = todo.iter().map(|i| i.size).sum();
+    eprintln!("[import] {} objects ({:.2} GiB) to import into {bucket}", todo.len(), total as f64 / (1u64 << 30) as f64);
+    let client = reqwest_wasi::Client::new();
+    let verbose = std::env::var("IMPORT_VERBOSE").is_ok();
+    let started = Instant::now();
+    let mut done_bytes = 0u64;
+    let mut done = 0usize;
+
+    let mut i = 0;
+    while i < todo.len() {
+        // one batch: up to BATCH_BYTES (a single larger object is its own batch)
+        let mut batch = Vec::new();
+        let mut bytes = 0u64;
+        while i < todo.len() && (batch.is_empty() || bytes + todo[i].size <= BATCH_BYTES) {
+            bytes += todo[i].size;
+            batch.push(todo[i].clone());
+            i += 1;
+        }
+        let mut pu = store
+            .sdk
+            .upload_packed(PackedUploadOptions { max_buffered_slabs: Some(1), ..Default::default() })
+            .map_err(|e| e.to_string())?;
+        let mut etags = Vec::with_capacity(batch.len());
+        for item in &batch {
+            let (tx, rx) = tokio::io::duplex(4 << 20);
+            let fetcher = fetch(&client, item, tx);
+            let adder = pu.add(rx);
+            let t0 = Instant::now();
+            let (etag, added) = tokio::join!(fetcher, adder);
+            let etag = etag?;
+            if verbose {
+                eprintln!("[import]   {} ({} B) fetched+packed in {:?}", item.key, item.size, t0.elapsed());
+            }
+            let n = added.map_err(|e| format!("{}: {e}", item.key))?;
+            if n != item.size {
+                return Err(format!("{}: packed {n} bytes, expected {}", item.key, item.size));
+            }
+            etags.push(etag);
+        }
+        if verbose {
+            eprintln!("[import]   finalizing batch of {} objects ({} B)", batch.len(), bytes);
+        }
+        let objs = pu.finalize().await.map_err(|e| e.to_string())?;
+        if objs.len() != batch.len() {
+            return Err(format!("packed upload returned {} objects for {}", objs.len(), batch.len()));
+        }
+        let m = (version_ms / 1000) as i64;
+        for ((item, etag), obj) in batch.iter().zip(etags).zip(objs) {
+            let i = import_wid(&bucket, &item.key, &etag, item.size);
+            let entry = Entry { b: bucket.clone(), k: item.key.clone(), s: item.size, t: etag, m, c: None, x: vec![], h: version_ms, i };
+            // the same placement rules as the server: inline, or a manifest for a key too long for metadata
+            let placement = store.stage_put(&obj, &entry).await.map_err(|e| format!("{}: {e}", item.key))?;
+            store.commit_put(obj, placement, entry, true, None).await.map_err(|e| format!("{}: pin: {e}", item.key))?;
+            done += 1;
+            done_bytes += item.size;
+        }
+        let secs = started.elapsed().as_secs_f64().max(1.0);
+        eprintln!(
+            "[import] {done}/{} objects, {:.2}/{:.2} GiB, {:.1} MiB/s",
+            todo.len(),
+            done_bytes as f64 / (1u64 << 30) as f64,
+            total as f64 / (1u64 << 30) as f64,
+            done_bytes as f64 / (1u64 << 20) as f64 / secs
+        );
+    }
+    eprintln!("[import] done: {done} objects in {:.0}s", started.elapsed().as_secs_f64());
+    Ok(())
+}
+
+#[cfg(test)]
+mod tests {
+    use super::import_wid;
+
+    #[test]
+    fn import_write_ids_depend_only_on_the_key_and_its_content() {
+        let a = import_wid("ipfs", "pins/x", "abc", 3);
+        assert_eq!(a, import_wid("ipfs", "pins/x", "abc", 3));
+        assert_eq!(a.len(), 16);
+        for other in [import_wid("ipfs", "pins/y", "abc", 3), import_wid("ipfs", "pins/x", "abd", 3), import_wid("ipfs", "pins/x", "abc", 4), import_wid("ipfspins/", "x", "abc", 3)] {
+            assert_ne!(a, other);
+        }
+    }
+}
diff --git a/sia-s3/src/main.rs b/sia-s3/src/main.rs
new file mode 100644
index 0000000000000000000000000000000000000000..5cd225a09fe7babbf1a5bec711a7b979e2cc38fc
--- /dev/null
+++ b/sia-s3/src/main.rs
@@ -0,0 +1,409 @@
+//! sia-s3: an S3 endpoint backed by Sia, for enclave.host.
+//!
+//! Data is encrypted and erasure-coded client-side (inside this enclave) by the
+//! Sia SDK and stored on Sia hosts through an indexer (default
+//! https://sia.enclave.host), or replicated across several independent indexers
+//! (replica.rs). The S3 key index lives in the objects' own sealed metadata (see
+//! store.rs), so the app keeps no local state: a restart reloads the index from
+//! the indexers' object feeds.
+//!
+//! The one platform rule: read `ENCLAVE_PORTS` and bind the actual port.
+
+mod config;
+mod fencing;
+mod recovery;
+mod diag;
+mod http;
+mod import;
+mod replica;
+mod s3;
+mod sigv4;
+mod store;
+#[cfg(test)]
+mod real_indexd; // HARNESS-ONLY: real-indexd driver (work/storage-real-indexd), not in main
+#[cfg(test)]
+mod real_fencing; // DRIVER CASES for fence-capable real indexd (all #[ignore])
+#[cfg(all(test, unix))]
+mod clone_privacy; // PATCH (clone privacy review): copies of a running instance (fork) must not reuse keystreams
+
+use std::rc::Rc;
+use std::time::Duration;
+
+use sia_storage::{AppKey, AppMetadata, Builder, Sdk, app_id};
+use tokio::net::TcpListener;
+
+use crate::config::{Config, ReplicaCfg};
+use crate::http::{ReadError, read_request, write_head};
+use crate::replica::Cluster;
+use crate::s3::App;
+
+// Must match the metadata registered for this app key on the indexer.
+const META: AppMetadata = AppMetadata {
+    id: app_id!("5e1a0c3e7f2d4b19a8c6e0d4f3b2a1908e7d6c5b4a3f2e1d0c9b8a7f6e5d4c3b"),
+    name: "sia-s3",
+    description: "S3 over Sia for enclave.host platform storage",
+    service_url: "https://enclave.host",
+    logo_url: None,
+    callback_url: None,
+};
+
+
+/// stderr logger for the SDK's `log` output: warnings and errors always,
+/// everything from sia_* crates at debug when SIAS3_LOG=debug.
+struct Logger { debug: bool }
+impl log::Log for Logger {
+    fn enabled(&self, m: &log::Metadata) -> bool {
+        m.level() <= log::Level::Warn || (self.debug && m.target().starts_with("sia"))
+    }
+    fn log(&self, r: &log::Record) {
+        if self.enabled(r.metadata()) {
+            eprintln!("[{}] {} {}", r.level(), r.target(), r.args());
+        }
+    }
+    fn flush(&self) {}
+}
+
+/// `ENCLAVE_PORTS=http:8000=18321,...` → the actual port for `http:8000`.
+fn port() -> u16 {
+    let default = 8000;
+    let Ok(ports) = std::env::var("ENCLAVE_PORTS") else { return default };
+    for spec in ports.split(',') {
+        let mut it = spec.split(['=', ':']);
+        if let (Some("http"), Some("8000"), Some(actual)) = (it.next(), it.next(), it.next()) {
+            if let Ok(p) = actual.trim().parse() {
+                return p;
+            }
+        }
+    }
+    default
+}
+
+async fn connect(r: &ReplicaCfg) -> Result<Sdk, String> {
+    Builder::new(r.indexer.as_str(), META)
+        .map_err(|e| e.to_string())?
+        .connected(&AppKey::import(r.app_key))
+        .await
+        .map_err(|e| e.to_string())?
+        .ok_or_else(|| format!("the app key is not authorized on {}", r.indexer))
+}
+
+/// Connect to one indexer and load its index, retrying 5 s → 300 s, then join the cluster. Replicas load
+/// independently: one that is down never holds up the others. A listing with blocked objects is left out by the
+/// cluster (replica.rs, "Blocked objects"), which withholds what it may hide; it is listed again here and by
+/// maintenance.
+async fn load_replica(app: Rc<App>, cfg: Rc<Config>, i: usize) {
+    let r = &cfg.replicas[i];
+    let mut wait = 5u64;
+    let store = loop {
+        match async { app.cluster.load(i, connect(r).await?, cfg.compact_max_object, cfg.opts.clone()).await }.await {
+            Ok(()) => match app.cluster.store(i) {
+                Some(s) => break s,
+                None => return,
+            },
+            Err(e) => {
+                // shown on the status page and /healthz: never a signed indexer URL (connect() errors carry them)
+                let e = crate::store::redact(&e);
+                eprintln!("[sia-s3] replica {}: boot: {e}; retrying in {wait}s", r.name);
+                *app.cluster.replicas[i].error.borrow_mut() = Some(format!("boot: {e}"));
+                *app.boot_error.borrow_mut() = Some(format!(
+                    "{} of {} replicas are loaded ({}: {e}){}",
+                    app.cluster.loaded().len(),
+                    app.cluster.n(),
+                    r.name,
+                    app.cluster.ms_reason().map(|m| format!("; {m}")).unwrap_or_default()
+                ));
+                tokio::time::sleep(Duration::from_secs(wait)).await;
+                wait = (wait * 2).min(300);
+            }
+        }
+    };
+    eprintln!("[sia-s3] replica {} loaded ({}/{} loaded)", r.name, app.cluster.loaded().len(), app.cluster.n());
+    *app.boot_error.borrow_mut() = if app.cluster.ready() { None } else { app.cluster.ms_reason() };
+    store.sweep().await;
+}
+
+/// Writer fencing (fencing.rs): connect every replica; once all have connected, or 30 s after the first did, read
+/// their fences, raise one ballot on all of them and list those that installed it (Cluster::fence_boot). Replicas
+/// that connect or answer later get the same ballot (Cluster::fence_join). Nothing is served before the fence is
+/// installed on the acting set's N - W + 1 voters and they are listed. A refused policy or a stale/duplicate ballot
+/// stops for good, with the reason on the status page.
+async fn load_fenced(app: Rc<App>, cfg: Rc<Config>) {
+    if let Err(why) = cfg.fence.check() {
+        eprintln!("[sia-s3] writer fencing refused: {why}");
+        *app.boot_error.borrow_mut() = Some(format!("writer fencing refused: {why}"));
+        return;
+    }
+    let n = cfg.replicas.len();
+    let (tx, mut rx) = tokio::sync::mpsc::unbounded_channel::<(usize, Sdk)>();
+    for i in 0..n {
+        let (tx, cfg, app) = (tx.clone(), cfg.clone(), app.clone());
+        tokio::task::spawn_local(async move {
+            let mut wait = 5u64;
+            loop {
+                match connect(&cfg.replicas[i]).await {
+                    Ok(sdk) => {
+                        let _ = tx.send((i, sdk));
+                        return;
+                    }
+                    Err(e) => {
+                        let e = crate::store::redact(&e);
+                        eprintln!("[sia-s3] replica {}: connect: {e}; retrying in {wait}s", cfg.replicas[i].name);
+                        *app.cluster.replicas[i].error.borrow_mut() = Some(format!("connect: {e}"));
+                        tokio::time::sleep(Duration::from_secs(wait)).await;
+                        wait = (wait * 2).min(300);
+                    }
+                }
+            }
+        });
+    }
+    let mut first = Vec::new();
+    if let Some(x) = rx.recv().await {
+        first.push(x);
+    }
+    let until = tokio::time::Instant::now() + Duration::from_secs(30);
+    while first.len() < n {
+        match tokio::time::timeout_at(until, rx.recv()).await {
+            Ok(Some(x)) => first.push(x),
+            _ => break,
+        }
+    }
+    let mut wait = 5u64;
+    loop {
+        match app.cluster.fence_boot(first.clone(), cfg.compact_max_object, cfg.opts.clone()).await {
+            Ok(()) => break,
+            Err(e) => {
+                *app.boot_error.borrow_mut() = Some(format!("writer fencing: {e}"));
+                if app.cluster.superseded().is_some() {
+                    return;
+                }
+                tokio::time::sleep(Duration::from_secs(wait)).await;
+                wait = (wait * 2).min(300);
+                while let Ok(x) = rx.try_recv() {
+                    first.push(x);
+                }
+            }
+        }
+    }
+    // load-time cleanup, as an unfenced load does (its deletes carry the fence)
+    for (_, s) in app.cluster.loaded() {
+        tokio::task::spawn_local(async move { s.sweep().await });
+    }
+    // replicas of the first set that did not install the ballot, and every later one, join with backoff
+    let loaded: Vec<usize> = app.cluster.loaded().into_iter().map(|(i, _)| i).collect();
+    let pending: Vec<(usize, Sdk)> = first.into_iter().filter(|(i, _)| !loaded.contains(i)).collect();
+    for (i, sdk) in pending {
+        tokio::task::spawn_local(join_fenced(app.clone(), cfg.clone(), i, sdk));
+    }
+    while let Some((i, sdk)) = rx.recv().await {
+        tokio::task::spawn_local(join_fenced(app.clone(), cfg.clone(), i, sdk));
+    }
+}
+
+async fn join_fenced(app: Rc<App>, cfg: Rc<Config>, i: usize, sdk: Sdk) {
+    let mut wait = 5u64;
+    loop {
+        match app.cluster.fence_join(i, sdk.clone(), cfg.compact_max_object, cfg.opts.clone()).await {
+            Ok(()) => {
+                eprintln!("[sia-s3] replica {} fenced and loaded", cfg.replicas[i].name);
+                if let Some(s) = app.cluster.store(i) {
+                    s.sweep().await;
+                }
+                return;
+            }
+            Err(e) => {
+                let e = crate::store::redact(&e);
+                *app.cluster.replicas[i].error.borrow_mut() = Some(format!("fence join: {e}"));
+                if app.cluster.superseded().is_some() {
+                    return;
+                }
+                tokio::time::sleep(Duration::from_secs(wait)).await;
+                wait = (wait * 2).min(300);
+            }
+        }
+    }
+}
+
+async fn boot(app: Rc<App>, cfg: Rc<Config>) {
+    if app.cluster.is_fenced() {
+        tokio::task::spawn_local(load_fenced(app.clone(), cfg.clone()));
+    } else {
+        for (i, r) in cfg.replicas.iter().enumerate() {
+            if i == 0 {
+                eprintln!("[sia-s3] UNFENCED (writerFence off): exactly one writer at a time is the operator's responsibility ({})", r.name);
+            }
+            tokio::task::spawn_local(load_replica(app.clone(), cfg.clone(), i));
+        }
+    }
+    // a membership change that was sealed but not finished, or a set of replicas without membership records, is
+    // finished (committed) before anything is served: maintenance backfills, seals and admits the configured members
+    // while every request answers 503
+    let mut last: Option<std::time::Instant> = None;
+    while !app.cluster.ready() {
+        if app.cluster.finishing() && last.is_none_or(|t| t.elapsed() >= Duration::from_secs(cfg.repair_every_secs.min(60))) {
+            let r = app.cluster.repair(cfg.repair_max_bytes).await;
+            eprintln!("[sia-s3] finishing the membership change: {} copies, {} parts, {} records, {} pending", r.copies, r.parts, r.admitted, r.pending);
+            *app.boot_error.borrow_mut() = app.cluster.ms_reason();
+            last = Some(std::time::Instant::now());
+        }
+        tokio::time::sleep(Duration::from_secs(1)).await;
+    }
+    *app.boot_error.borrow_mut() = None;
+    eprintln!("[sia-s3] ready");
+    // with one indexer too: unknown outcomes are re-read, dead versions purged and tombstones collected
+    tokio::task::spawn_local(repair_loop(app.cluster.clone(), cfg.repair_every_secs, cfg.repair_max_bytes));
+
+    loop {
+        tokio::time::sleep(Duration::from_secs(cfg.compact_every_secs)).await;
+        if app.cluster.superseded().is_some() {
+            continue; // writer fencing stopped this instance: nothing more is written
+        }
+        for (i, store) in app.cluster.loaded() {
+            match store.compact().await {
+                Ok(n) => {
+                    let mut st = store.stats.borrow_mut();
+                    st.compactions += 1;
+                    st.compacted_objects += n as u64;
+                    st.last_compaction = Some(chrono::Utc::now().to_rfc3339());
+                    if n > 0 {
+                        eprintln!("[sia-s3] compactor ({}): repacked {n} objects", cfg.replicas[i].name);
+                    }
+                }
+                Err(e) => {
+                    eprintln!("[sia-s3] compactor ({}): {e}", cfg.replicas[i].name);
+                    store.stats.borrow_mut().last_error = Some(e);
+                }
+            }
+        }
+    }
+}
+
+/// Re-read ambiguous replicas, bring lagging ones up to the merged view, record deletions as floors everywhere and
+/// reclaim the payload they cover.
+async fn repair_loop(cluster: Rc<Cluster>, every: u64, max_bytes: u64) {
+    loop {
+        tokio::time::sleep(Duration::from_secs(every)).await;
+        let r = cluster.repair(max_bytes).await;
+        if r.reconciled + r.purged + r.copies + r.deletes + r.floors + r.reclaimed + r.merged + r.parts + r.admitted + r.ceilings + r.pending > 0 {
+            eprintln!(
+                "[sia-s3] repair: {} re-read, {} dead versions purged, {} copies, {} deletes, {} floors written, {} tombstones reclaimed, {} ledgers merged, {} multipart parts copied, {} membership records, {} version ceilings copied, {} pending",
+                r.reconciled, r.purged, r.copies, r.deletes, r.floors, r.reclaimed, r.merged, r.parts, r.admitted, r.ceilings, r.pending
+            );
+        }
+    }
+}
+
+async fn conn(app: Rc<App>, mut s: tokio::net::TcpStream, max_body: usize) {
+    let mut carry = Vec::new();
+    loop {
+        let req = match read_request(&mut s, &mut carry, max_body).await {
+            Ok(r) => r,
+            Err(ReadError::Closed) => return,
+            Err(ReadError::TooLarge) => {
+                let _ = write_head(&mut s, 413, &[], 0, false).await;
+                return;
+            }
+            Err(ReadError::Bad(e)) => {
+                let body = format!("<?xml version=\"1.0\"?><Error><Code>BadRequest</Code><Message>{e}</Message></Error>");
+                let _ = write_head(&mut s, 400, &[("Content-Type".into(), "application/xml".into())], body.len() as u64, false).await;
+                let _ = tokio::io::AsyncWriteExt::write_all(&mut s, body.as_bytes()).await;
+                return;
+            }
+        };
+        if s3::handle(&app, &req, &mut s).await.is_err() || !req.keep_alive {
+            return;
+        }
+    }
+}
+
+fn main() {
+    let debug = std::env::var("SIAS3_LOG").is_ok_and(|v| v == "debug");
+    if log::set_boxed_logger(Box::new(Logger { debug })).is_ok() {
+        log::set_max_level(if debug { log::LevelFilter::Debug } else { log::LevelFilter::Warn });
+    }
+    let recovery_args: Vec<String> = std::env::args().collect();
+    if recovery_args.get(1).map(String::as_str) == Some("recovery") {
+        let rt = tokio::runtime::Builder::new_current_thread().enable_all().build().expect("runtime");
+        let local = tokio::task::LocalSet::new();
+        if let Err(e) = local.block_on(&rt, recovery::command(&recovery_args[2..])) {
+            eprintln!("[recovery] {e}");
+            std::process::exit(1);
+        }
+        return;
+    }
+    let cfg = match config::load() {
+        Ok(c) => c,
+        Err(e) => {
+            eprintln!("[sia-s3] config: {e}");
+            std::process::exit(2);
+        }
+    };
+    let rt = tokio::runtime::Builder::new_current_thread().enable_all().build().expect("runtime");
+    let local = tokio::task::LocalSet::new();
+
+    // `sia-s3 import <bucket> <manifest.json> [replica]`: bulk-load objects into one indexer, then exit
+    let args: Vec<String> = std::env::args().collect();
+    if args.get(1).map(String::as_str) == Some("import") {
+        let (Some(bucket), Some(manifest)) = (args.get(2).cloned(), args.get(3).cloned()) else {
+            eprintln!("usage: sia-s3 import <bucket> <manifest.json> [replica name]");
+            std::process::exit(2);
+        };
+        let Some(r) = cfg.replicas.iter().find(|r| args.get(4).is_none_or(|n| r.name == *n)).cloned() else {
+            eprintln!("[import] no replica named {:?}", args[4]);
+            std::process::exit(2);
+        };
+        if cfg.replicas.len() > 1 && args.get(4).is_none() {
+            eprintln!("[import] {} replicas are configured: name the one to import into (run once per replica)", cfg.replicas.len());
+            std::process::exit(2);
+        }
+        let res = local.block_on(&rt, async move { import::run(connect(&r).await?, bucket, manifest).await });
+        if let Err(e) = res {
+            eprintln!("[import] FAILED: {e}");
+            std::process::exit(1);
+        }
+        return;
+    }
+
+    local.block_on(&rt, async move {
+        let cluster = Cluster::new(
+            cfg.replicas.iter().map(|r| (r.name.clone(), r.indexer.clone(), r.retiring)).collect(),
+            cfg.write_quorum,
+            cfg.opts.clone(),
+            cfg.timing.clone(),
+        )
+        .fenced(cfg.fence.clone());
+        let app = Rc::new(App {
+            cluster: Rc::new(cluster),
+            buckets: cfg.buckets.clone(),
+            credentials: cfg.credentials.clone(),
+            region: cfg.region.clone(),
+            boot_error: Default::default(),
+        });
+        let p = port();
+        let listener = match TcpListener::bind(("127.0.0.1", p)).await {
+            Ok(l) => l,
+            Err(e) => {
+                eprintln!("[sia-s3] bind 127.0.0.1:{p}: {e}");
+                std::process::exit(1);
+            }
+        };
+        let indexers: Vec<&str> = cfg.replicas.iter().map(|r| r.indexer.as_str()).collect();
+        eprintln!(
+            "[sia-s3] listening on 127.0.0.1:{p}; indexers {indexers:?} (write quorum {}); buckets {:?}",
+            cfg.write_quorum, cfg.buckets
+        );
+        let max_body = cfg.max_body;
+        let cfg = Rc::new(cfg);
+        tokio::task::spawn_local(boot(app.clone(), cfg.clone()));
+        loop {
+            match listener.accept().await {
+                Ok((s, _)) => {
+                    tokio::task::spawn_local(conn(app.clone(), s, max_body));
+                }
+                Err(e) => {
+                    eprintln!("[sia-s3] accept: {e}");
+                    tokio::time::sleep(Duration::from_millis(100)).await;
+                }
+            }
+        }
+    });
+}
diff --git a/sia-s3/src/real_fencing.rs b/sia-s3/src/real_fencing.rs
new file mode 100644
index 0000000000000000000000000000000000000000..e9b285f7cfce82634ecaecd05a2a37d243246148
--- /dev/null
+++ b/sia-s3/src/real_fencing.rs
@@ -0,0 +1,483 @@
+//! DRIVER CASES (not yet runnable): writer fencing against REAL indexd with the fence API (interface v3 section 2),
+//! on the storage-indexd harness (work/storage-real-indexd/harness, control API on loopback). Every test is
+//! #[ignore], and needs an indexd build that implements GET/POST /fence, the receipt and the exact `sf` check:
+//!   SIAS3_REAL_CTL=$(cat <run>/ctl.url) SIAS3_REAL_INDEXD=fence cargo test --offline \
+//!     --target x86_64-unknown-linux-gnu real_fence_ -- --ignored --test-threads=1
+//! They use the harness's /register, /manifest, /hold, /release, /stall-publish and /resume-publish, and print
+//! EVIDENCE lines. Helpers are duplicated from real_indexd.rs (the indexd owner's file is not edited).
+//! The `real_c2_*` cases (PATCH C2) need an indexd with G-C2 v4 (work/indexd-c2-implementation-interface.txt; GET
+//! /fence must list "cas-v4"): run with SIAS3_REAL_INDEXD=c2. They use a FIXTURE lease16 authority (synthetic chain
+//! facts): it proves nothing about the production front/generation binding, which stays an open acceptance item.
+//! The `real_fence_blocked_*` cases (PATCH U1-B) also need /stop, /start and the harness's /block-object and
+//! /unblock-object controls (patches/harness-block-object.patch: indexd's real admin blocklist API); without that
+//! patch they fail at the first /block-object call, never silently.
+
+use std::io::{Read, Write};
+use std::net::TcpStream;
+use std::rc::Rc;
+use std::time::Duration;
+
+use sia_storage::fence::{FenceRaise, FenceToken};
+use sia_storage::{AppKey, Builder, Sdk};
+
+use crate::fencing::{Authority, FenceMode, FencePolicy, Isolation};
+use crate::replica::{Cluster, Timing};
+use crate::store::{Cond, Listing, Opts, Store};
+
+fn ctl(path_and_query: &str) -> serde_json::Value {
+    let base = std::env::var("SIAS3_REAL_CTL").expect("SIAS3_REAL_CTL (the harness's ctl.url) is required");
+    let hostport = base.trim_start_matches("http://").trim_end_matches('/').to_string();
+    assert!(hostport.starts_with("127.0.0.1:"), "control API must be loopback: {hostport}");
+    let mut s = TcpStream::connect(&hostport).expect("connect to the harness");
+    s.set_read_timeout(Some(Duration::from_secs(600))).unwrap();
+    write!(s, "POST {path_and_query} HTTP/1.1\r\nHost: {hostport}\r\nContent-Length: 0\r\nConnection: close\r\n\r\n").unwrap();
+    let mut raw = Vec::new();
+    s.read_to_end(&mut raw).unwrap();
+    let text = String::from_utf8_lossy(&raw).to_string();
+    let (head, body) = text.split_once("\r\n\r\n").unwrap_or((&text, ""));
+    assert!(head.starts_with("HTTP/1.1 200"), "control {path_and_query}: {head} {body}");
+    serde_json::from_str(body.trim()).unwrap_or(serde_json::Value::Null)
+}
+
+fn evidence(what: &str, v: serde_json::Value) {
+    println!("EVIDENCE {what} {}", crate::store::redact(&v.to_string()));
+}
+
+fn urls() -> Vec<String> {
+    let m = ctl("/manifest");
+    m["indexers"].as_array().unwrap().iter().map(|i| i["url"].as_str().unwrap().to_string()).collect()
+}
+
+fn opts() -> Opts {
+    Opts { shards: (3, 9), listing: Listing::Current, meta_timeout: Duration::from_secs(20), upload_timeout: Duration::from_secs(300) }
+}
+
+fn timing() -> Timing {
+    Timing { upload_grace: Duration::from_secs(10), meta_grace: Duration::from_secs(2), stall: Duration::from_secs(60) }
+}
+
+/// One generated, disposable app key for indexers `idx`, registered through the harness (the same key on each, as
+/// sia-s3 deployments may do; each indexer is its own account).
+fn key(idx: &[usize]) -> [u8; 32] {
+    let mut seed = [0u8; 32];
+    getrandom::fill(&mut seed).unwrap();
+    let pk = AppKey::import(seed).public_key();
+    for i in idx {
+        ctl(&format!("/register?idx={i}&pk={pk}"));
+    }
+    seed
+}
+
+async fn sdk(url: &str, seed: [u8; 32]) -> Sdk {
+    Builder::new(url, crate::META).unwrap().connected(&AppKey::import(seed)).await.unwrap().expect("authorized")
+}
+
+fn lease(generation: u64) -> FencePolicy {
+    FencePolicy {
+        mode: FenceMode::Required,
+        authority: Some(Authority::Lease17 { chain_id: 8453, ledger: format!("0x{}", "1".repeat(40)), deployment: format!("0x{}", "2".repeat(64)), generation }),
+        isolation: Some(Isolation::Snp),
+        accept_unevidenced_isolation: false, // PATCH C2: production-shaped; C2 needs no no-clone override
+    }
+}
+
+async fn fenced(urls: &[String], seed: [u8; 32], w: usize, policy: FencePolicy) -> Cluster {
+    let c = Cluster::new((0..urls.len()).map(|i| (format!("r{i}"), urls[i].clone(), false)).collect(), w, opts(), timing()).fenced(policy);
+    let mut sdks = Vec::new();
+    for (i, u) in urls.iter().enumerate() {
+        sdks.push((i, sdk(u, seed).await));
+    }
+    let r = c.fence_boot(sdks, 8 << 20, opts()).await;
+    evidence("fence-boot", serde_json::json!({ "result": format!("{r:?}"), "status": c.fence_status() }));
+    c
+}
+
+async fn settle(c: &Cluster) {
+    for _ in 0..6 {
+        let r = c.repair(1 << 30).await;
+        if r.reconciled + r.purged + r.copies + r.deletes + r.floors + r.reclaimed + r.merged + r.parts + r.admitted + r.ceilings + r.pending == 0 {
+            break;
+        }
+    }
+}
+
+#[tokio::test]
+#[ignore]
+async fn real_fence_endpoint_semantics_exact_receipt_and_refusals() {
+    let u = urls();
+    let seed = key(&[0]);
+    let s = sdk(&u[0], seed).await;
+    let t1 = FenceToken::new((17 << 48) | 1, 1, [1; 16]).unwrap();
+    let FenceRaise::Installed(c1) = s.fence_raise(t1).await.unwrap() else { panic!("first raise installs") };
+    let st = s.fence_state().await.unwrap();
+    evidence("raise-1", serde_json::json!({ "fence": st.fence.map(|f| f.to_hex()), "receiptSha256Present": st.receipt_sha256.is_some() }));
+    assert_eq!(st.fence, Some(t1));
+    assert!(matches!(s.fence_raise(t1).await.unwrap(), FenceRaise::Refused(Some(t)) if t == t1), "an EQUAL raise is refused");
+    let lower = FenceToken::new((17 << 48) | 1, 0, [9; 16]).unwrap();
+    assert!(matches!(s.fence_raise(lower).await.unwrap(), FenceRaise::Refused(Some(_))));
+    // a mutation without sf, and one with the token but a wrong receipt: both 409, nothing applied
+    let unfenced = Store::load_with(sdk(&u[0], seed).await, 8 << 20, opts()).await.unwrap();
+    let e = unfenced.upload(Rc::from(&b"x"[..])).await.unwrap_err();
+    evidence("unfenced-mutation", serde_json::json!({ "error": e }));
+    let wrong = sdk(&u[0], seed).await;
+    wrong.set_fence_credential(Some(sia_storage::fence::FenceCredential { token: t1, receipt: sia_storage::fence::FenceReceipt([0; 16]) }));
+    let wrong = Store::load_with(wrong, 8 << 20, opts()).await.unwrap();
+    assert!(wrong.upload(Rc::from(&b"x"[..])).await.is_err(), "wrong receipt refused");
+    s.set_fence_credential(Some(c1));
+    let ok = Store::load_with(s.clone(), 8 << 20, opts()).await.unwrap();
+    ok.upload(Rc::from(&b"x"[..])).await.unwrap();
+    // a higher raise: new receipt; the old credential is now refused
+    let t2 = FenceToken::new((17 << 48) | 2, 1, [2; 16]).unwrap();
+    assert!(matches!(sdk(&u[0], seed).await.fence_raise(t2).await.unwrap(), FenceRaise::Installed(_)));
+    assert!(ok.upload(Rc::from(&b"y"[..])).await.is_err(), "the superseded credential is refused");
+    evidence("conflict-recorded", serde_json::json!({ "conflict": format!("{:?}", s.fence_conflict()) }));
+}
+
+#[tokio::test]
+#[ignore]
+async fn real_fence_delayed_old_writer_pins_are_refused_after_a_new_install() {
+    let u = urls();
+    let seed = key(&[0, 1, 2]);
+    let a = fenced(&u, seed, 2, lease(5)).await;
+    a.repair(1 << 30).await;
+    settle(&a).await;
+    a.put("b", "k", b"v1".to_vec(), None, &Cond::None).await.unwrap();
+    // hold A's next metadata pin on r1 and r2 (r0 acknowledges): unacknowledged, in flight
+    ctl("/hold?idx=1&method=POST&path=/objects&n=1");
+    ctl("/hold?idx=2&method=POST&path=/objects&n=1");
+    let _ = tokio::time::timeout(Duration::from_secs(30), a.put("b", "k", b"stale".to_vec(), None, &Cond::None)).await;
+    let b = fenced(&u, seed, 2, lease(6)).await;
+    settle(&b).await;
+    b.delete("b", "k").await.unwrap();
+    let r1 = ctl("/release?idx=1");
+    let r2 = ctl("/release?idx=2");
+    evidence("held-old-pins-released", serde_json::json!({ "r1": r1, "r2": r2 }));
+    let b2 = fenced(&u, seed, 2, lease(7)).await;
+    settle(&b2).await;
+    evidence("after", serde_json::json!({ "kVisible": b2.lookup("b", "k").is_some(), "aFresh": format!("{:?}", a.fresh().await) }));
+    assert!(b2.lookup("b", "k").is_none(), "the delayed stale PUT did not undo the DELETE");
+}
+
+#[tokio::test]
+#[ignore]
+async fn real_fence_two_starters_same_counter_one_writer() {
+    let u = urls();
+    let seed = key(&[0, 1, 2]);
+    let (c1, c2) = tokio::join!(fenced(&u, seed, 2, lease(5)), fenced(&u, seed, 2, lease(5)));
+    // a new record-less set serves only after its commit (P1); the earlier run (runs/ifx6) skipped this, so neither
+    // instance had voters and both confirmations failed. Settle each instance that is not yet stopped.
+    for c in [&c1, &c2] {
+        if c.superseded().is_none() {
+            settle(c).await;
+        }
+    }
+    let (f1, f2) = (c1.fresh().await.is_ok(), c2.fresh().await.is_ok());
+    let p1 = c1.put("b", "only", b"one".to_vec(), None, &Cond::IfNoneMatch).await.is_ok();
+    let p2 = c2.put("b", "only", b"two".to_vec(), None, &Cond::IfNoneMatch).await.is_ok();
+    evidence("two-starters", serde_json::json!({ "fresh": [f1, f2], "create": [p1, p2], "s1": c1.fence_status(), "s2": c2.fence_status() }));
+    assert!(!(f1 && f2), "two writers confirmed");
+    assert!(!(p1 && p2), "two put-if-absent creates succeeded");
+    assert!(f1 || f2, "one of them is the writer");
+}
+
+#[tokio::test]
+#[ignore]
+async fn real_fence_listing_after_install_sees_an_unpublished_acknowledged_pin() {
+    let u = urls();
+    let seed = key(&[0]);
+    let a = fenced(&u[..1], seed, 1, lease(5)).await;
+    settle(&a).await;
+    ctl("/stall-publish?idx=0&seconds=60");
+    a.put("b", "k", b"v2".to_vec(), None, &Cond::None).await.unwrap();
+    let b = fenced(&u[..1], seed, 1, lease(6)).await;
+    settle(&b).await;
+    let seen = b.lookup("b", "k").is_some();
+    ctl("/resume-publish?idx=0");
+    evidence("listing-after-install", serde_json::json!({ "kSeen": seen }));
+    assert!(seen);
+}
