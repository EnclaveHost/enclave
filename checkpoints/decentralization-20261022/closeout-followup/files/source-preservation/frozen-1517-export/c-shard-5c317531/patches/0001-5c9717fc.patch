+//! `ENCLAVE_CONFIG` (or `SIAS3_CONFIG` locally), JSON. String values of the
+//! exact form `$NAME` / `${NAME}` resolve from the environment, which is how
+//! deployment secrets arrive (the s3-ipfs-adapter convention).
+//!
+//! ```json
+//! {
+//!   "indexer": "https://sia.enclave.host",
+//!   "appKey": "$SIA_APP_KEY",
+//!   "region": "auto",
+//!   "buckets": ["ipfs"],
+//!   "credentials": [{ "accessKeyId": "$S3_ACCESS_KEY_ID", "secretAccessKey": "$S3_SECRET_ACCESS_KEY" }]
+//! }
+//! ```
+//!
+//! Replicated across independent indexers (replica.rs), `replicas` replaces
+//! `indexer`; each replica's `appKey` defaults to the top-level one. It may also
+//! be one `$NAME` string holding that JSON array, so the owner can change the
+//! set with a secrets update instead of a new catalog version:
+//!
+//! ```json
+//! { "replicas": [ { "name": "minipc", "indexer": "https://sia.enclave.host", "appKey": "$SIA_APP_KEY" },
+//!                 { "name": "b", "indexer": "https://indexd.example.org", "appKey": "$SIA_APP_KEY_B" } ],
+//!   "writeQuorum": 1, ... }
+//! ```
+//!
+//! Changing the set is a migration (replica.rs, "Membership"): a replica that
+//! is leaving stays listed with `"retiring": true` until the new set has been
+//! admitted. It is read from and sealed, but is not a member: `writeQuorum`
+//! counts members only.
+//!
+//! Indexer URLs are canonicalized (scheme, lowercase host without a trailing
+//! dot, port only when not the scheme's default, path without a trailing
+//! slash) and must be distinct. That only stops one endpoint being counted as
+//! two quorum votes by accident: distinct URLs do not show distinct operators
+//! (one operator can run many names), which the deployer has to establish.
+
+use std::time::Duration;
+
+use serde_json::Value;
+
+use crate::replica::Timing;
+use crate::store::Opts;
+
+/// One indexer the data is replicated to.
+#[derive(Clone, PartialEq)]
+pub struct ReplicaCfg {
+    pub name: String,
+    /// canonical form (see the module docs)
+    pub indexer: String,
+    /// 32-byte seed of the app key registered on this indexer
+    pub app_key: [u8; 32],
+    /// leaving the membership: a source and seal holder for the change, never a member of the new set
+    pub retiring: bool,
+}
+
+/// Never prints the seed.
+impl std::fmt::Debug for ReplicaCfg {
+    fn fmt(&self, f: &mut std::fmt::Formatter<'_>) -> std::fmt::Result {
+        f.debug_struct("ReplicaCfg")
+            .field("name", &self.name)
+            .field("indexer", &self.indexer)
+            .field("app_key", &"<redacted>")
+            .field("retiring", &self.retiring)
+            .finish()
+    }
+}
+
+pub struct Config {
+    pub replicas: Vec<ReplicaCfg>,
+    /// members (replicas not retiring) that must commit a write (default: a majority of them)
+    pub write_quorum: usize,
+    pub region: String,
+    pub buckets: Vec<String>,
+    /// (access key id, secret)
+    pub credentials: Vec<(String, String)>,
+    /// largest single PUT / UploadPart body accepted
+    pub max_body: usize,
+    /// objects below this size are written alone, then repacked by the compactor
+    pub compact_max_object: u64,
+    pub compact_every_secs: u64,
+    pub repair_every_secs: u64,
+    /// bytes one repair pass copies at most
+    pub repair_max_bytes: u64,
+    pub opts: Opts,
+    pub timing: Timing,
+    /// writer fencing (fencing.rs): `writerFence` ("required", the default, or "off"), `writerAuthority` (the fact
+    /// the release delivered: an object, or a "$NAME" string holding its JSON), `instanceIsolation` ("snp", "tdx",
+    /// "vbs", "owner-process"), `acceptUnevidencedIsolation` (bool). A missing fact does not fail the config: the
+    /// instance boots NOT READY and says why (fail closed).
+    pub fence: crate::fencing::FencePolicy,
+}
+
+fn key32(hex_key: &str) -> Result<[u8; 32], String> {
+    let key = hex::decode(hex_key.trim()).map_err(|_| "appKey is not hex")?;
+    key.try_into().map_err(|_| "appKey must be 32 bytes".to_string())
+}
+
+/// The canonical form of an indexer URL (module docs). Credentials, a query or a fragment are refused: the SDK
+/// appends API paths to this URL, and a secret in it would be logged and shown on the status page.
+pub fn canonical_indexer(raw: &str) -> Result<String, String> {
+    let u = url::Url::parse(raw.trim()).map_err(|e| format!("not a URL ({e})"))?;
+    let default_port = match u.scheme() {
+        "https" => 443,
+        "http" => 80,
+        s => return Err(format!("scheme {s} is not http or https")),
+    };
+    if !u.username().is_empty() || u.password().is_some() {
+        return Err("credentials do not belong in the URL".into());
+    }
+    if u.query().is_some() || u.fragment().is_some() {
+        return Err("a query or fragment is not allowed".into());
+    }
+    let host = match u.host() {
+        Some(url::Host::Domain(d)) => d.trim_end_matches('.').to_ascii_lowercase(),
+        Some(url::Host::Ipv4(a)) => a.to_string(),
+        Some(url::Host::Ipv6(a)) => format!("[{a}]"),
+        None => return Err("no host".into()),
+    };
+    if host.is_empty() {
+        return Err("no host".into());
+    }
+    let mut out = format!("{}://{host}", u.scheme());
+    match u.port_or_known_default() {
+        Some(p) if p != default_port => out.push_str(&format!(":{p}")),
+        _ => {}
+    }
+    out.push_str(u.path().trim_end_matches('/'));
+    Ok(out)
+}
+
+/// `replicas` (already resolved if it was a `$NAME` string), else the single top-level `indexer`.
+fn replicas(j: &Value, default_key: Option<&str>) -> Result<Vec<ReplicaCfg>, String> {
+    let list = match &j["replicas"] {
+        Value::Null => {
+            let indexer = resolve(&j["indexer"]).unwrap_or_else(|| "https://sia.enclave.host".into());
+            let indexer = canonical_indexer(&indexer).map_err(|e| format!("indexer: {e}"))?;
+            let key = default_key.ok_or("appKey is missing or unresolved")?;
+            return Ok(vec![ReplicaCfg { name: "primary".into(), indexer, app_key: key32(key)?, retiring: false }]);
+        }
+        v @ Value::String(_) => {
+            let raw = resolve(v).ok_or("replicas is unresolved")?;
+            serde_json::from_str::<Value>(&raw).map_err(|e| format!("replicas is not a JSON array: {e}"))?
+        }
+        v => v.clone(),
+    };
+    let arr = list.as_array().filter(|a| !a.is_empty()).ok_or("replicas must be a non-empty array")?;
+    if arr.len() > 16 {
+        return Err("at most 16 replicas".into());
+    }
+    let mut out: Vec<ReplicaCfg> = Vec::new();
+    for (i, r) in arr.iter().enumerate() {
+        let name = r["name"].as_str().map(String::from).unwrap_or_else(|| format!("r{i}"));
+        if name.is_empty() || name.len() > 32 || !name.chars().all(|c| c.is_ascii_alphanumeric() || "-_.".contains(c)) {
+            return Err(format!("bad replica name {name:?}"));
+        }
+        let indexer = resolve(&r["indexer"]).ok_or_else(|| format!("replica {name}: indexer is missing or unresolved"))?;
+        let indexer = canonical_indexer(&indexer).map_err(|e| format!("replica {name}: indexer: {e}"))?;
+        // a replica without a key of its own uses the top-level one; one whose `$NAME` is unset is an error,
+        // never a silent fallback to another indexer's key
+        let key = match &r["appKey"] {
+            Value::Null => default_key.map(String::from),
+            v => resolve(v),
+        }
+        .ok_or_else(|| format!("replica {name}: appKey is missing or unresolved"))?;
+        let retiring = match &r["retiring"] {
+            Value::Null => false,
+            v => v.as_bool().ok_or_else(|| format!("replica {name}: retiring must be true or false"))?,
+        };
+        let rc = ReplicaCfg { name, indexer, app_key: key32(&key).map_err(|e| format!("replica {}: {e}", r["name"]))?, retiring };
+        if out.iter().any(|o| o.name == rc.name) {
+            return Err(format!("duplicate replica name {:?}", rc.name));
+        }
+        if out.iter().any(|o| o.indexer == rc.indexer) {
+            return Err(format!("replica {}: indexer {} is listed twice", rc.name, rc.indexer));
+        }
+        out.push(rc);
+    }
+    if out.iter().all(|r| r.retiring) {
+        return Err("every replica is retiring: at least one must be a member".into());
+    }
+    for r in &out {
+        if r.indexer.starts_with("http://") {
+            // kept for a local or tunnelled indexer: the SDK signs requests with the app key and verifies sealed
+            // objects, but over plain HTTP anyone on the path sees which objects exist and can withhold or replay
+            // the indexer's answers
+            eprintln!("[sia-s3] config: replica {} uses plain HTTP; only for an indexer on a trusted path", r.name);
+        }
+    }
+    Ok(out)
+}
+
+fn resolve(v: &Value) -> Option<String> {
+    let s = v.as_str()?;
+    let name = s
+        .strip_prefix("${")
+        .and_then(|r| r.strip_suffix('}'))
+        .or_else(|| s.strip_prefix('$'));
+    match name {
+        Some(n) if !n.is_empty() && n.chars().all(|c| c.is_ascii_alphanumeric() || c == '_') => {
+            match std::env::var(n) {
+                Ok(val) if !val.is_empty() => {
+                    eprintln!("[sia-s3] config: resolved ${n} from the environment");
+                    Some(val)
+                }
+                _ => {
+                    eprintln!("[sia-s3] config: ${n} is not set in the environment");
+                    None
+                }
+            }
+        }
+        _ => Some(s.to_string()),
+    }
+}
+
+/// The writer-fencing settings (fencing.rs). Malformed values are config errors; absent facts are not.
+fn fence_policy(j: &Value) -> Result<crate::fencing::FencePolicy, String> {
+    use crate::fencing::{Authority, FenceMode, FencePolicy, Isolation};
+    let mode = match &j["writerFence"] {
+        Value::Null => FenceMode::Required,
+        Value::String(s) if s == "required" => FenceMode::Required,
+        Value::String(s) if s == "off" => FenceMode::Off,
+        _ => return Err("writerFence must be \"required\" or \"off\"".into()),
+    };
+    let authority = match &j["writerAuthority"] {
+        Value::Null => None,
+        v @ Value::Object(_) => Some(Authority::parse(v)?),
+        v @ Value::String(_) => match resolve(v) {
+            Some(raw) => Some(Authority::parse(&serde_json::from_str(&raw).map_err(|e| format!("writerAuthority is not JSON: {e}"))?)?),
+            None => None,
+        },
+        _ => return Err("writerAuthority must be an object or a \"$NAME\" string".into()),
+    };
+    let isolation = match &j["instanceIsolation"] {
+        Value::Null => None,
+        v @ Value::String(_) => resolve(v).map(|s| Isolation::parse(&s)).transpose()?,
+        _ => return Err("instanceIsolation must be a string".into()),
+    };
+    let accept_unevidenced_isolation = match &j["acceptUnevidencedIsolation"] {
+        Value::Null => false,
+        Value::Bool(b) => *b,
+        _ => return Err("acceptUnevidencedIsolation must be true or false".into()),
+    };
+    Ok(FencePolicy { mode, authority, isolation, accept_unevidenced_isolation })
+}
+
+pub fn load() -> Result<Config, String> {
+    let raw = std::env::var("ENCLAVE_CONFIG")
+        .or_else(|_| std::env::var("SIAS3_CONFIG"))
+        .map_err(|_| "ENCLAVE_CONFIG is not set".to_string())?;
+    parse(&raw)
+}
+
+pub fn parse(raw: &str) -> Result<Config, String> {
+    let j: Value = serde_json::from_str(raw).map_err(|e| format!("config is not JSON: {e}"))?;
+
+    let default_key = if j["appKey"].is_null() { None } else { resolve(&j["appKey"]) };
+    let replicas = replicas(&j, default_key.as_deref())?;
+    let members = replicas.iter().filter(|r| !r.retiring).count();
+    let write_quorum = match &j["writeQuorum"] {
+        Value::Null => members / 2 + 1,
+        v => v.as_u64().ok_or("writeQuorum must be a number")? as usize,
+    };
+    if !(1..=members).contains(&write_quorum) {
+        return Err(format!("writeQuorum must be 1-{members} (the number of replicas that are not retiring)"));
+    }
+    let secs = |name: &str, default: u64, min: u64| -> Result<u64, String> {
+        match j[name].as_u64() {
+            None if j[name].is_null() => Ok(default),
+            Some(v) if v >= min => Ok(v),
+            _ => Err(format!("{name} must be a number of seconds, at least {min}")),
+        }
+    };
+    let meta_timeout = secs("metadataTimeoutSecs", 120, 5)?;
+
+    let buckets: Vec<String> = j["buckets"]
+        .as_array()
+        .map(|a| a.iter().filter_map(|b| b.as_str().map(String::from)).collect())
+        .unwrap_or_default();
+    if buckets.is_empty() {
+        return Err("buckets must name at least one bucket".into());
+    }
+    for b in &buckets {
+        if b.is_empty() || b.len() > 63 || !b.chars().all(|c| c.is_ascii_lowercase() || c.is_ascii_digit() || c == '-' || c == '.') {
+            return Err(format!("bad bucket name {b:?}"));
+        }
+    }
+
+    let mut credentials = Vec::new();
+    for c in j["credentials"].as_array().into_iter().flatten() {
+        if let (Some(id), Some(secret)) = (resolve(&c["accessKeyId"]), resolve(&c["secretAccessKey"])) {
+            credentials.push((id, secret));
+        }
+    }
+    if credentials.is_empty() {
+        return Err("no usable credentials (every request must be signed)".into());
+    }
+
+    let fence = fence_policy(&j)?;
+
+    Ok(Config {
+        fence,
+        replicas,
+        write_quorum,
+        region: resolve(&j["region"]).unwrap_or_else(|| "auto".into()),
+        buckets,
+        credentials,
+        max_body: j["maxBodyBytes"].as_u64().unwrap_or(64 << 20) as usize,
+        compact_max_object: j["compactMaxObjectBytes"].as_u64().unwrap_or(8 << 20),
+        compact_every_secs: j["compactEverySecs"].as_u64().unwrap_or(1800),
+        repair_every_secs: j["repairEverySecs"].as_u64().unwrap_or(300).max(10),
+        repair_max_bytes: j["repairMaxBytesPerPass"].as_u64().unwrap_or(1 << 30),
+        opts: Opts {
+            listing: crate::store::Listing::Current,
+            shards: (10, 20),
+            meta_timeout: Duration::from_secs(meta_timeout),
+            upload_timeout: Duration::from_secs(secs("uploadTimeoutSecs", 1800, 60)?),
+        },
+        timing: Timing {
+            upload_grace: Duration::from_secs(secs("uploadGraceSecs", 30, 0)?),
+            meta_grace: Duration::from_secs(secs("metadataGraceSecs", 5, 0)?),
+            stall: Duration::from_secs(secs("stallTimeoutSecs", 120, 10)?),
+        },
+    })
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    const K1: &str = "1111111111111111111111111111111111111111111111111111111111111111";
+    const K2: &str = "2222222222222222222222222222222222222222222222222222222222222222";
+
+    fn cfg(extra: &str) -> Result<Config, String> {
+        parse(&format!(r#"{{"buckets":["ipfs"],"credentials":[{{"accessKeyId":"a","secretAccessKey":"s"}}]{extra}}}"#))
+    }
+
+    #[test]
+    fn a_0_1_config_is_one_replica() {
+        let c = cfg(&format!(r#","indexer":"https://sia.enclave.host","appKey":"{K1}""#)).unwrap();
+        assert_eq!(
+            c.replicas,
+            vec![ReplicaCfg { name: "primary".into(), indexer: "https://sia.enclave.host".into(), app_key: [0x11; 32], retiring: false }]
+        );
+        assert_eq!((c.opts.meta_timeout.as_secs(), c.opts.upload_timeout.as_secs(), c.timing.meta_grace.as_secs()), (120, 1800, 5));
+        assert_eq!(c.write_quorum, 1);
+    }
+
+    #[test]
+    fn replicas_default_to_a_majority_and_the_top_level_key() {
+        let c = cfg(&format!(
+            r#","appKey":"{K1}","replicas":[{{"name":"a","indexer":"https://a.example"}},{{"name":"b","indexer":"https://b.example","appKey":"{K2}"}},{{"indexer":"http://c.example:9980"}}]"#
+        ))
+        .unwrap();
+        assert_eq!(c.replicas.len(), 3);
+        assert_eq!(c.write_quorum, 2);
+        assert_eq!((c.replicas[0].app_key, c.replicas[1].app_key), ([0x11; 32], [0x22; 32]));
+        assert_eq!(c.replicas[2].name, "r2");
+    }
+
+    #[test]
+    fn retiring_replicas_are_listed_but_not_members() {
+        let c = cfg(&format!(
+            r#","appKey":"{K1}","replicas":[{{"name":"old","indexer":"https://old.example","retiring":true}},{{"name":"a","indexer":"https://a.example"}},{{"name":"b","indexer":"https://b.example"}},{{"name":"c","indexer":"https://c.example","retiring":false}}]"#
+        ))
+        .unwrap();
+        assert_eq!(c.replicas.iter().map(|r| r.retiring).collect::<Vec<_>>(), [true, false, false, false]);
+        assert_eq!(c.write_quorum, 2, "a majority of the three members");
+        // a retiring replica is still one indexer: listing it twice is refused like any alias
+        let twice = format!(
+            r#","appKey":"{K1}","replicas":[{{"name":"a","indexer":"https://a.example"}},{{"name":"b","indexer":"https://A.example","retiring":true}}]"#
+        );
+        assert!(cfg(&twice).is_err());
+    }
+
+    #[test]
+    fn replicas_may_arrive_as_one_json_string() {
+        let list = format!(r#"[{{"name":"a","indexer":"https://a.example","appKey":"{K1}"}},{{"name":"b","indexer":"https://b.example","appKey":"{K2}"}}]"#);
+        let c = cfg(&format!(r#","replicas":{},"writeQuorum":1"#, serde_json::to_string(&list).unwrap())).unwrap();
+        assert_eq!((c.replicas.len(), c.write_quorum), (2, 1));
+    }
+
+    #[test]
+    fn unsafe_replica_sets_are_refused() {
+        let two = format!(r#","appKey":"{K1}","replicas":[{{"name":"a","indexer":"https://a.example"}},{{"name":"b","indexer":"https://b.example"}}]"#);
+        for bad in [
+            // the same indexer twice would count one operator as two quorum votes
+            format!(r#","appKey":"{K1}","replicas":[{{"name":"a","indexer":"https://a.example"}},{{"name":"b","indexer":"https://A.example/"}}]"#),
+            format!(r#","appKey":"{K1}","replicas":[{{"name":"a","indexer":"https://a.example"}},{{"name":"a","indexer":"https://b.example"}}]"#),
+            format!(r#"{two},"writeQuorum":0"#),
+            format!(r#"{two},"writeQuorum":3"#),
+            format!(r#","replicas":[{{"name":"a","indexer":"https://a.example"}}]"#),
+            format!(r#","appKey":"{K1}","replicas":[{{"name":"a","indexer":"https://a.example","appKey":"$SIAS3_TEST_UNSET_KEY"}}]"#),
+            format!(r#","appKey":"{K1}","replicas":[{{"name":"a","indexer":"ftp://a.example"}}]"#),
+            format!(r#","appKey":"{K1}","replicas":[]"#),
+            format!(r#","appKey":"{K1}","metadataTimeoutSecs":1"#),
+            // a quorum over a retiring replica, or nothing but retiring ones
+            format!(r#","appKey":"{K1}","replicas":[{{"name":"a","indexer":"https://a.example"}},{{"name":"b","indexer":"https://b.example","retiring":true}}],"writeQuorum":2"#),
+            format!(r#","appKey":"{K1}","replicas":[{{"name":"a","indexer":"https://a.example","retiring":true}}]"#),
+            format!(r#","appKey":"{K1}","replicas":[{{"name":"a","indexer":"https://a.example","retiring":"yes"}}]"#),
+        ] {
+            assert!(cfg(&bad).is_err(), "{bad}");
+        }
+    }
+
+    #[test]
+    fn indexer_urls_are_canonical_and_aliases_count_once() {
+        for (raw, want) in [
+            ("https://Sia.Enclave.Host", "https://sia.enclave.host"),
+            ("https://sia.enclave.host.:443/", "https://sia.enclave.host"),
+            ("http://127.0.0.1:80", "http://127.0.0.1"),
+            ("http://127.1:9980/", "http://127.0.0.1:9980"),
+            ("https://[::1]:8443/indexd/", "https://[::1]:8443/indexd"),
+        ] {
+            assert_eq!(canonical_indexer(raw).unwrap(), want, "{raw}");
+        }
+        for bad in ["https://user:pw@a.example", "https://a.example/?k=v", "https://a.example/#x", "ftp://a.example", "a.example", "https://"] {
+            assert!(canonical_indexer(bad).is_err(), "{bad}");
+        }
+        for alias in ["https://A.example.:443", "https://a.example/", "HTTPS://a.example"] {
+            let two = format!(r#","appKey":"{K1}","replicas":[{{"name":"a","indexer":"https://a.example"}},{{"name":"b","indexer":"{alias}"}}]"#);
+            assert!(cfg(&two).is_err(), "{alias} counted as a second indexer");
+        }
+    }
+
+    #[test]
+    fn replica_debug_output_never_shows_the_seed() {
+        let c = cfg(&format!(r#","indexer":"https://sia.enclave.host","appKey":"{K1}""#)).unwrap();
+        let shown = format!("{:?}", c.replicas);
+        assert!(shown.contains("redacted") && !shown.contains("17") && !shown.contains("11, 17"), "{shown}");
+    }
+}
diff --git a/sia-s3/src/diag.rs b/sia-s3/src/diag.rs
new file mode 100644
index 0000000000000000000000000000000000000000..3bad23195c10c72ae439032d54f1c7d61176f796
--- /dev/null
+++ b/sia-s3/src/diag.rs
@@ -0,0 +1,112 @@
+//! `GET /?sia-diag` (SigV4-signed like every request): dial the Sia hosts the
+//! indexer offers through the SAME path uploads use (reqwest_wasi::net, so the
+//! deployment's SOCKS egress front when ENCLAVE_EGRESS is set) and report, per
+//! host, which stage failed and how long it took:
+//!   tcp      - TCP (via the SOCKS front) to the announced siamux address
+//!   mux      - SiaMux handshake, which authenticates the host's key
+//!   settings - an RHP4 settings RPC over the mux
+//! A deployment that can read the indexer but cannot upload ("no more hosts
+//! available") shows here exactly where the dials die.
+
+use std::time::{Duration, Instant};
+
+use serde::Serialize;
+use sia_core::rhp4::protocol::RPCSettings;
+use sia_core::types::v2::Protocol;
+use sia_storage::HostQuery;
+
+use crate::store::Store;
+
+#[derive(Serialize)]
+struct Probe {
+    host: String,
+    addr: String,
+    stage: &'static str,
+    ok: bool,
+    ms: u128,
+    err: Option<String>,
+}
+
+fn egress_summary() -> serde_json::Value {
+    match std::env::var("ENCLAVE_EGRESS") {
+        Ok(u) if !u.is_empty() => {
+            // never echo the credential: scheme + front address only
+            let scheme = u.split("://").next().unwrap_or("");
+            let front = u.rsplit('@').next().unwrap_or("");
+            serde_json::json!({ "set": true, "scheme": scheme, "front": front })
+        }
+        _ => serde_json::json!({ "set": false }),
+    }
+}
+
+async fn probe(pk: [u8; 32], host: String, addr: String, per_dial: Duration) -> Probe {
+    let t = Instant::now();
+    let fail = |stage, e: String| Probe { host: host.clone(), addr: addr.clone(), stage, ok: false, ms: t.elapsed().as_millis(), err: Some(e) };
+    let vk = match ed25519_dalek::VerifyingKey::from_bytes(&pk) {
+        Ok(k) => k,
+        Err(e) => return fail("key", e.to_string()),
+    };
+    let tcp = match tokio::time::timeout(per_dial, reqwest_wasi::net::connect_addr(&addr)).await {
+        Ok(Ok(s)) => s,
+        Ok(Err(e)) => return fail("tcp", e.to_string()),
+        Err(_) => return fail("tcp", format!("timeout after {per_dial:?}")),
+    };
+    let mux = match tokio::time::timeout(per_dial, sia_mux::dial(tcp, &vk)).await {
+        Ok(Ok(m)) => m,
+        Ok(Err(e)) => return fail("mux", e.to_string()),
+        Err(_) => return fail("mux", format!("timeout after {per_dial:?}")),
+    };
+    let res = tokio::time::timeout(per_dial, async {
+        let mut st = mux.dial_stream().map_err(|e| e.to_string())?;
+        let req = RPCSettings::send_request(&mut st).await.map_err(|e| e.to_string())?;
+        req.complete(&mut st).await.map_err(|e| e.to_string())?;
+        Ok::<_, String>(())
+    })
+    .await;
+    match res {
+        Ok(Ok(())) => Probe { host, addr, stage: "settings", ok: true, ms: t.elapsed().as_millis(), err: None },
+        Ok(Err(e)) => fail("settings", e),
+        Err(_) => fail("settings", format!("timeout after {per_dial:?}")),
+    }
+}
+
+pub async fn run(store: &Store, limit: u64, per_dial_secs: u64) -> String {
+    let started = Instant::now();
+    let hosts = match store.sdk.hosts(HostQuery { limit: Some(limit), ..Default::default() }).await {
+        Ok(h) => h,
+        Err(e) => return serde_json::json!({ "egress": egress_summary(), "error": format!("indexer hosts: {e}") }).to_string(),
+    };
+    let per_dial = Duration::from_secs(per_dial_secs);
+    let mut set = tokio::task::JoinSet::new();
+    let mut no_siamux = 0;
+    for h in hosts.iter() {
+        let pk: [u8; 32] = h.public_key.into();
+        let Some(a) = h.addresses.iter().find(|a| a.protocol == Protocol::SiaMux) else {
+            no_siamux += 1;
+            continue;
+        };
+        set.spawn_local(probe(pk, h.public_key.to_string(), a.address.clone(), per_dial));
+    }
+    let mut probes = Vec::new();
+    while let Some(r) = set.join_next().await {
+        if let Ok(p) = r {
+            probes.push(p);
+        }
+    }
+    probes.sort_by(|a, b| b.ok.cmp(&a.ok).then(a.stage.cmp(b.stage)));
+    let ok = probes.iter().filter(|p| p.ok).count();
+    let mut by_stage = std::collections::BTreeMap::new();
+    for p in probes.iter().filter(|p| !p.ok) {
+        *by_stage.entry(p.stage).or_insert(0) += 1;
+    }
+    serde_json::json!({
+        "egress": egress_summary(),
+        "hostsOffered": hosts.len(),
+        "withoutSiamux": no_siamux,
+        "ok": ok,
+        "failedByStage": by_stage,
+        "elapsedMs": started.elapsed().as_millis(),
+        "probes": probes,
+    })
+    .to_string()
+}
diff --git a/sia-s3/src/fencing.rs b/sia-s3/src/fencing.rs
new file mode 100644
index 0000000000000000000000000000000000000000..568c022b38644d92810ad24afe0d3914745e183e
--- /dev/null
+++ b/sia-s3/src/fencing.rs
@@ -0,0 +1,361 @@
+//! Writer fencing (work/storage-writer-fencing-proposal.md; wire contract work/storage-fencing-implementation-interface.txt
+//! v3): which instance may write, and how it proves it at every indexer.
+//!
+//! Every process draws a fresh 16-byte instance id. Its ballot is `gen || counter || iid`, where:
+//!   - gen comes from the WRITER AUTHORITY fact the release delivered (the lease it was released under, or the owner's
+//!     cold recovery), never from the instance itself;
+//!   - counter is one above any installed fence of the same gen.
+//! The ballot is installed on each listed indexer before that indexer is read. Every mutation carries the token and
+//! the indexer's receipt (the SDK adds them), and the indexer applies a mutation only if both equal what it holds.
+//! Every answer to a client waits for a confirmation round, started after the request arrived, that sees our fence on
+//! W voters.
+//!
+//! What this assumes, and refuses without (fail closed):
+//!   - A1 indexers are fail-stop and enforce the fence;
+//!   - A2 a RUNNING instance cannot be duplicated with its memory (a clone holding our credential would be accepted as
+//!     us). This is a property of the runtime, so `instanceIsolation` must name one. Runtimes with no recorded evidence
+//!     are refused unless the operator explicitly accepts the risk.
+//!     A clone made BEFORE our raise is caught: indexers issue a fresh receipt per install, and an equal token is never
+//!     installed twice.
+//!   - A3 the instance runs this code. A holder of the app key outside it has full authority over the data by design
+//!     (that is the owner's authority, distinct from a host replaying or duplicating an instance).
+
+use sia_storage::fence::FenceToken;
+
+/// Generation layout: the authority source in the top 16 bits (below the sign bit), the source's value below.
+pub const GEN_SHIFT: u32 = 48;
+pub const GEN_LEASE16: u64 = 16;
+pub const GEN_LEASE17: u64 = 17;
+
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub enum FenceMode {
+    /// the pre-fencing single-writer behaviour: no fence, no `sf`, no confirmation. Exactly one writer is the
+    /// operator's responsibility. An indexer that holds a fence refuses every unfenced mutation, so an unfenced
+    /// instance stops rather than write a fenced account.
+    Off,
+    /// fenced (the default)
+    Required,
+}
+
+/// Who may preempt the current writer: the fact the release delivered (interface v3 section 5).
+#[derive(Clone, Debug, PartialEq, Eq)]
+pub enum Authority {
+    /// rev 17 ledger: `leaseOf(id).generation` of the lease the secrets were released under
+    Lease17 { chain_id: u64, ledger: String, deployment: String, generation: u64 },
+    /// live rev 16 ledger: the finalized `Claimed` log of that lease
+    Lease16 { chain_id: u64, ledger: String, deployment: String, claim_block: u64, claim_logenindex: u64 },
+    /// the owner's cold recovery: the highest installed gen (preempts the current holder, never a later lease)
+    OwnerCold,
+}
+
+impl Authority {
+    /// The gen this authority fixes (None: owner cold recovery, decided from what is installed).
+    pub fn fixed_gen(&self) -> Option<u64> {
+        match self {
+            Authority::Lease17 { generation, .. } => Some((GEN_LEASE17 << GEN_SHIFT) | generation),
+            Authority::Lease16 { claim_block, claim_logenindex, .. } => Some((GEN_LEASE16 << GEN_SHIFT) | (claim_block << 16) | claim_logenindex),
+            Authority::OwnerCold => None,
+        }
+    }
+
+    pub fn describe(&self) -> String {
+        match self {
+            Authority::Lease17 { chain_id, ledger, deployment, generation } => format!("lease17 chain {chain_id} ledger {ledger} deployment {deployment} generation {generation}"),
+            Authority::Lease16 { chain_id, ledger, deployment, claim_block, claim_logenindex } => {
+                format!("lease16 chain {chain_id} ledger {ledger} deployment {deployment} claim {claim_block}/{claim_logenindex}")
+            }
+            Authority::OwnerCold => "owner-cold".into(),
+        }
+    }
+
+    /// Strict parse of the JSON fact. Unknown sources, missing or extra fields, and out-of-range values are refused.
+    pub fn parse(v: &serde_json::Value) -> Result<Authority, String> {
+        let o = v.as_object().ok_or("writerAuthority must be a JSON object")?;
+        let src = o.get("source").and_then(|s| s.as_str()).ok_or("writerAuthority.source is required")?;
+        let allowed: &[&str] = match src {
+            "lease17" => &["source", "chainId", "ledger", "deployment", "generation"],
+            "lease16" => &["source", "chainId", "ledger", "deployment", "claimBlock", "claimLogIndex"],
+            "owner-cold" => &["source"],
+            other => return Err(format!("writerAuthority.source {other:?} is not lease17, lease16 or owner-cold")),
+        };
+        if let Some(extra) = o.keys().find(|k| !allowed.contains(&k.as_str())) {
+            return Err(format!("writerAuthority has an unknown field {extra:?}"));
+        }
+        let u = |k: &str| o.get(k).and_then(|x| x.as_u64()).ok_or(format!("writerAuthority.{k} must be an unsigned integer"));
+        let hexs = |k: &str, len: usize| -> Result<String, String> {
+            let s = o.get(k).and_then(|x| x.as_str()).ok_or(format!("writerAuthority.{k} is required"))?;
+            let h = s.strip_prefix("0x").ok_or(format!("writerAuthority.{k} must start with 0x"))?;
+            if h.len() != len || !h.bytes().all(|c| c.is_ascii_hexdigit()) {
+                return Err(format!("writerAuthority.{k} must be 0x and {len} hex digits"));
+            }
+            Ok(s.to_ascii_lowercase())
+        };
+        Ok(match src {
+            "lease17" => {
+                let generation = u("generation")?;
+                if generation == 0 || generation >> GEN_SHIFT != 0 {
+                    return Err("writerAuthority.generation must be in 1..2^48 (0 means never claimed)".into());
+                }
+                Authority::Lease17 { chain_id: u("chainId")?, ledger: hexs("ledger", 40)?, deployment: hexs("deployment", 64)?, generation }
+            }
+            "lease16" => {
+                let (claim_block, claim_logenindex) = (u("claimBlock")?, u("claimLogIndex")?);
+                if claim_block == 0 || claim_block >> 32 != 0 || claim_logenindex >> 16 != 0 {
+                    return Err("writerAuthority.claimBlock must be in 1..2^32 and claimLogIndex below 2^16".into());
+                }
+                Authority::Lease16 { chain_id: u("chainId")?, ledger: hexs("ledger", 40)?, deployment: hexs("deployment", 64)?, claim_block, claim_logenindex }
+            }
+            _ => Authority::OwnerCold,
+        })
+    }
+}
+
+/// The runtime an instance runs in, for the no-clone assumption A2.
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub enum Isolation {
+    Snp,
+    Tdx,
+    Vbs,
+    /// an owner-run process (cold recovery): the owner asserts there is no duplicate
+    OwnerProcess,
+}
+
+impl Isolation {
+    pub fn parse(s: &str) -> Result<Isolation, String> {
+        match s {
+            "snp" => Ok(Isolation::Snp),
+            "tdx" => Ok(Isolation::Tdx),
+            "vbs" => Ok(Isolation::Vbs),
+            "owner-process" => Ok(Isolation::OwnerProcess),
+            other => Err(format!("instanceIsolation {other:?} is not snp, tdx, vbs or owner-process")),
+        }
+    }
+
+    /// The recorded no-clone evidence for this runtime (None: none recorded). This is what this workspace has
+    /// examined, not a property of the hardware in general.
+    pub fn evidence(&self) -> Option<&'static str> {
+        match self {
+            Isolation::OwnerProcess => Some("owner assertion (owner authority): no duplicate process"),
+            // VBS type 1: Save-VM was refused once (isolation/m3/VBS-ISOLATION.md, enclave-d1), which the repo itself
+            // records as "not evidence of isolation"; the VBS report did not verify (E2: no report).
+            Isolation::Vbs => None,
+            // SNP / TDX: guest memory is encrypted per VM, but the host's save/restore, migration and snapshot paths
+            // for these guests (and how guest randomness is seeded after one) have not been examined here.
+            Isolation::Snp | Isolation::Tdx => None,
+        }
+    }
+}
+
+/// The fencing configuration and its fail-closed check.
+#[derive(Clone, Debug)]
+pub struct FencePolicy {
+    pub mode: FenceMode,
+    pub authority: Option<Authority>,
+    pub isolation: Option<Isolation>,
+    /// the operator accepts running on a runtime without recorded no-clone evidence (reported on /healthz). PATCH C2:
+    /// not needed by this build: its fenced mode is C2-only, and C2 does not assume no-clone (see `check`). Kept for the
+    /// config's sake and reported when set; it exempts nothing else.
+    pub accept_unevidenced_isolation: bool,
+}
+
+impl Default for FencePolicy {
+    fn default() -> Self {
+        FencePolicy { mode: FenceMode::Required, authority: None, isolation: None, accept_unevidenced_isolation: false }
+    }
+}
+
+impl FencePolicy {
+    /// Ok(warnings) if a fenced instance may start, Err(reason) otherwise. Off mode always passes (and warns).
+    ///
+    /// PATCH C2: the storage protocol of this build's fenced mode (C2: indexer-enforced conditional heads and two-phase
+    /// writes, replica.rs "C2") is safe for copies of a running instance, so it does NOT require no-clone evidence for
+    /// the runtime. That exemption is conditional: `Cluster::fence_boot` verifies the C2 preconditions on the actual
+    /// endpoints before anything is listed (every answering indexer reports "cas-v4", each install enrols with "mode":
+    /// "cas" and reports its head, 2W > N), and the instance is never ready otherwise (fail closed). The authority fact
+    /// and the isolation fact (the measured front's runtime) remain REQUIRED; nothing here waives them.
+    pub fn check(&self) -> Result<Vec<String>, String> {
+        if self.mode == FenceMode::Off {
+            return Ok(vec!["UNFENCED: single-writer discipline required (writerFence off)".into()]);
+        }
+        let mut warn = Vec::new();
+        let Some(auth) = &self.authority else {
+            return Err("writer fencing needs a writerAuthority fact (lease17, lease16 or owner-cold); none was delivered".into());
+        };
+        let Some(iso) = self.isolation else {
+            return Err("writer fencing needs instanceIsolation (snp, tdx, vbs or owner-process); none was delivered".into());
+        };
+        if matches!(auth, Authority::OwnerCold) != (iso == Isolation::OwnerProcess) {
+            return Err("owner-cold authority goes with instanceIsolation owner-process, and only with it".into());
+        }
+        match iso.evidence() {
+            Some(e) => warn.push(format!("isolation {iso:?}: {e}")),
+            None => warn.push(format!(
+                "isolation {iso:?}: no recorded no-clone evidence, and none assumed: C2 (verified at boot on every indexer) keeps storage semantics for copies of this instance"
+            )),
+        }
+        if self.accept_unevidenced_isolation {
+            warn.push("acceptUnevidencedIsolation is set: it is not needed by C2 and exempts nothing".into());
+        }
+        Ok(warn)
+    }
+}
+
+/// A fresh instance id for this process, from the runtime's randomness (WASI random in the guest; the OS natively).
+pub fn fresh_iid() -> [u8; 16] {
+    let mut b = [0u8; 16];
+    getrandom::fill(&mut b).expect("instance randomness");
+    b
+}
+
+/// The ballot to raise: `gen` from the authority (owner cold: the highest installed gen), counter one above every
+/// installed fence of that gen, and `floor_counter` (a re-ballot after a refusal) if higher. Err if an installed
+/// fence has a HIGHER gen (a later lease holds it: this instance is stale and must not preempt).
+pub fn choose_ballot(auth: &Authority, installed: &[FenceToken], iid: [u8; 16], floor_counter: u64) -> Result<FenceToken, String> {
+    let top_gen = installed.iter().map(|t| t.generation()).max();
+    let generation = match auth.fixed_gen() {
+        Some(g) => {
+            if let Some(t) = top_gen.filter(|t| *t > g) {
+                return Err(format!("a fence of a later authority (gen {t:#x}) is installed; this instance (gen {g:#x}) is stale and does not preempt it"));
+            }
+            g
+        }
+        None => top_gen.unwrap_or(0),
+    };
+    let counter = installed.iter().filter(|t| t.generation() == generation).map(|t| t.counter() + 1).max().unwrap_or(1).max(floor_counter);
+    FenceToken::new(generation, counter, iid)
+}
