+        let nets = [Net::new(1), Net::new(2), Net::new(3)];
+        // a committed set first (a NEW record-less set needs every listed replica loaded to commit, P1: a lost raise
+        // answer there blocks the first commit until a restart draws a new ballot; liveness, not safety)
+        let (first, r) = fenced(&nets, &all(3), 2, lease_policy(5), None).await;
