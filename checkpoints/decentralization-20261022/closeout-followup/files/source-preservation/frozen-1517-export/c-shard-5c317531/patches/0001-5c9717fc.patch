+    async fn blocked_an_acknowledged_version_blocked_at_boot_is_not_served_older_from_another_replica_or_repaired() {
+        let nets = [Net::new(1), Net::new(2), Net::new(3)];
+        let c = cluster(&nets, 2).await;
+        maintain(&c).await;
+        c.put("b", "k", b"v1".to_vec(), None, &Cond::None).await.unwrap();
+        c.put("b", "other", b"o".to_vec(), None, &Cond::None).await.unwrap();
+        maintain(&c).await;
+        // v2 is acknowledged by r0 and r1 only; r2 keeps v1 (not repaired: the writer stops)
+        nets[2].offline(true);
+        c.put("b", "k", b"v2".to_vec(), None, &Cond::None).await.unwrap();
+        let v2 = c.lookup("b", "k").unwrap().ver();
+        let blocked = host_of(&c, 1, "k").await;
+        drop(c);
+        nets[2].offline(false);
+        // r1's operator blocks k's v2 object
+        nets[1].net.block_object(blocked, true);
+        // a restart while r0 is down: r1 is left out, r2 alone is not N - W + 1, so v1 is never served
+        nets[0].offline(true);
+        let c = cluster(&nets, 2).await;
+        assert_eq!(c.blocked_objects(1), Some(1));
+        assert!(!c.ready(), "r2 alone would serve v1, an older revision of an acknowledged write");
+        // r0 is back: ready on {r0, r2}; k's newest version is v2, which r1 cannot vouch for: withheld everywhere
+        nets[0].offline(false);
+        c.load(0, sdk_of(&nets[0]).await, 8 << 20, opts()).await.unwrap();
+        assert!(c.ready(), "{:?}", c.ms_reason());
+        let e = c.lookup("b", "k").unwrap();
+        assert_eq!(e.ver(), v2, "the key exists at v2: never nonexistent, never v1");
+        assert!(c.withheld("b", "k", &v2));
+        assert!(is_withheld(&c.servable(&e, 0, e.s).await.unwrap_err()));
+        let mut out = Vec::new();
+        assert!(is_withheld(&c.read(&e, 0, e.s, &mut out).await.unwrap_err()) && out.is_empty(), "not read from r0 either");
+        assert!(is_withheld(&c.copy(("b", "k"), ("b", "k-copy")).await.unwrap_err()), "not copied under another name");
+        assert_eq!(c.check("b", "k", &Cond::IfNoneMatch).unwrap_err(), "PreconditionFailed", "it still exists");
+        // what r1 still vouches for is served as usual
+        assert!(!c.withheld("b", "other", &c.lookup("b", "other").unwrap().ver()));
+        assert_eq!(get(&c, "other").await.unwrap(), b"o");
+        // maintenance never copies v2 to r2 (or anywhere), and never writes to r1: it does not even try (an attempt
+        // would stream it out of r0; Cluster::read refuses that too, a second guard)
+        c.repair(1 << 30).await;
+        let r2_note = c.replicas[2].error.borrow().clone().unwrap_or_default();
+        assert!(!r2_note.contains("repair copy"), "{r2_note}");
+        maintain(&c).await;
+        assert_eq!(on_disk(&nets[2], "k").await.0.map(|v| v < v2), Some(true), "r2 still holds only the older version");
+        assert!(c.store(1).is_none());
+        // the owner overwrites k: the new version is not withheld
+        c.put("b", "k", b"v3".to_vec(), None, &Cond::None).await.unwrap();
+        assert_eq!(get(&c, "k").await.unwrap(), b"v3");
+    }
