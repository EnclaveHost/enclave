+    #[tokio::test]
+    async fn fencing_a_duplicate_ballot_is_refused_and_an_after_raise_clone_is_the_documented_limit() {
+        let nets = [Net::new(1), Net::new(2), Net::new(3)];
+        let (c, r) = fenced(&nets, &all(3), 2, lease_policy(5), Some([9; 16])).await;
+        r.unwrap();
+        settle(&c).await;
+        maintain(&c).await;
+        // a second process with the SAME iid and authority computes counter 2 (one above c's 1): a different ballot, so
+        // a restarted copy is never confused with c; c is preempted, not doubled
+        let (d, r) = fenced(&nets, &all(3), 2, lease_policy(5), Some([9; 16])).await;
+        r.unwrap();
+        assert!(d.ballot().unwrap() > c.ballot().unwrap());
+        assert!(c.fresh().await.is_err() && c.superseded().is_some());
+        // a pre-raise duplicate: an EXACT ballot already installed is never installed again (no idempotent equal raise)
+        let dup = Cluster::new(replica_list(&all(3)), 2, opts(), timing()).fenced_with_iid(lease_policy(5), [9; 16]);
+        let sdk = nets[0].net.sdk(nets[0].key.clone()).await.unwrap();
+        assert!(matches!(sdk.fence_raise_c2(d.ballot().unwrap()).await.unwrap(), sia_storage::fence::FenceRaise::Refused(Some(t)) if t == d.ballot().unwrap()));
+        drop(dup);
+        // a copy made AFTER the raise holds the same credential (and, as a memory copy, the same C2 state): the fence
+        // cannot tell it apart, so its uploads are accepted; C2 (the c2_* tests) is what keeps its OBJECT writes from
+        // being acknowledged beside d's
+        let d_cred = d.store(0).unwrap().sdk.fence_credential().unwrap();
+        let copy_sdk = nets[0].net.sdk(nets[0].key.clone()).await.unwrap();
+        copy_sdk.set_fence_credential(Some(d_cred));
+        copy_sdk.c2_copy_state_from(&d.store(0).unwrap().sdk);
+        let copy = Store::load_with(copy_sdk, 8 << 20, opts()).await.unwrap();
+        assert!(copy.upload(Rc::from(&b"x"[..])).await.is_ok(), "a holder of d's credential uploads as d");
+        // while a copy WITHOUT the receipt (only the token) is refused
+        let guess_sdk = nets[0].net.sdk(nets[0].key.clone()).await.unwrap();
+        guess_sdk.set_fence_credential(Some(sia_storage::fence::FenceCredential { token: d_cred.token, receipt: sia_storage::fence::FenceReceipt([0; 16]) }));
+        let guess = Store::load_with(guess_sdk, 8 << 20, opts()).await.unwrap();
+        assert!(guess.upload(Rc::from(&b"x"[..])).await.is_err(), "the token alone is not enough");
+        d.fresh().await.unwrap();
+    }
