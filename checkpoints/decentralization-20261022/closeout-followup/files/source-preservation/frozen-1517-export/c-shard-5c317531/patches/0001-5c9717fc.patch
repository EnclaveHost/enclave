+    fn replica_list(which: &[(usize, bool)]) -> Vec<(String, String, bool)> {
+        which.iter().map(|(i, r)| (format!("r{i}"), format!("https://indexer-{i}.example"), *r)).collect()
+    }
+
+    /// A fenced cluster over `which` (index, retiring): every reachable net gets a fresh SDK, and the cluster's
+    /// `fence_boot` raises the ballot and lists them. Unreachable nets are simply not given.
+    async fn fenced(nets: &[Net], which: &[(usize, bool)], w: usize, policy: FencePolicy, iid: Option<[u8; 16]>) -> (Cluster, Res<()>) {
+        let c = Cluster::new(replica_list(which), w, opts(), timing());
+        let c = match iid {
+            Some(iid) => c.fenced_with_iid(policy, iid),
+            None => c.fenced(policy),
+        };
+        let mut sdks = Vec::new();
+        for (j, (i, _)) in which.iter().enumerate() {
+            if let Ok(sdk) = nets[*i].net.sdk(nets[*i].key.clone()).await {
+                sdks.push((j, sdk));
+            }
+        }
+        let r = c.fence_boot(sdks, 8 << 20, opts()).await;
+        (c, r)
+    }
+
+    fn all(n: usize) -> Vec<(usize, bool)> {
+        (0..n).map(|i| (i, false)).collect()
+    }
