+    #[tokio::test]
+    async fn c2_two_copies_sending_byte_identical_new_operations_cannot_both_be_acknowledged() {
+        // root's review case: two copies with a copied RNG and clock handle two DISTINCT client requests that produce
+        // byte-identical operations (same op id, same sealed bytes, same head). The indexer applies the first and
+        // answers the second "replayed"; a copy that was sending that operation for the FIRST time must read this as
+        // another holder's operation (a fork), never as its own success
+        let nets = [Net::new(1)];
+        let c = c2_booted(&nets).await;
+        let s = c.store(0).unwrap();
+        let obj = s.upload(Rc::from(&b"identical"[..])).await.unwrap();
+        let sealed = obj.seal(&nets[0].key);
+        let copy = nets[0].net.sdk(nets[0].key.clone()).await.unwrap();
+        copy.set_fence_credential(s.sdk.fence_credential());
+        copy.c2_copy_state_from(&s.sdk);
+        let h = s.sdk.c2_head().unwrap();
+        let x: [u8; 16] = [9; 16];
+        s.sdk.c2_test_force_next_op(x);
+        copy.c2_test_force_next_op(x);
+        s.sdk.c2_test_pin_sealed(&sealed).await.unwrap();
+        let second = copy.c2_test_pin_sealed(&sealed).await;
+        assert!(second.is_err(), "the second copy's identical NEW operation must not be acknowledged: {second:?}");
+        assert!(copy.c2_forked().is_some());
+        assert_eq!(nets[0].net.c2_head().0, h + 1, "applied once");
+        assert!(s.sdk.c2_forked().is_none(), "the first sender is unaffected");
+        // negative control: ONE operation in flight when the snapshot was taken (the copy holds it as an unknown
+        // outcome) is one invocation: both copies settle it as applied, once
+        let obj2 = s.upload(Rc::from(&b"in flight"[..])).await.unwrap();
+        s.sdk.c2_test_pending_pin(&obj2, [10; 16]);
+        let snap = nets[0].net.sdk(nets[0].key.clone()).await.unwrap();
+        snap.set_fence_credential(s.sdk.fence_credential());
+        snap.c2_copy_state_from(&s.sdk);
+        assert!(matches!(s.sdk.c2_check().await.unwrap(), sia_storage::fence::C2Check::Confirmed(_)));
+        assert!(matches!(snap.c2_check().await.unwrap(), sia_storage::fence::C2Check::Confirmed(_)));
+        assert_eq!(nets[0].net.c2_head().0, h + 2);
+        assert_eq!(snap.c2_head(), Some(h + 2));
+    }
