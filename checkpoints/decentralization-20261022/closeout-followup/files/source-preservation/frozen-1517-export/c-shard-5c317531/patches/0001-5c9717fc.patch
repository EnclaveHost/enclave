++pub mod net {
++    //! Outbound TCP for wasip2: through the enclave's SOCKS5 egress front when
++    //! `ENCLAVE_EGRESS` is set, direct otherwise. Names are handed to the
++    //! front unresolved (ATYP DOMAIN) so resolution happens where its SSRF
