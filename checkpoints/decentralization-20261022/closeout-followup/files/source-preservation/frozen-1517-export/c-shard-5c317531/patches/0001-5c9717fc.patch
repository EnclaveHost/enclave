+        for n in &nets {
+            n.net.push_fault("pin_object", Fault::Reject); // phase 1 refused everywhere
+        }
+        assert!(c.put("b", "k", vec![7u8; 1000], None, &Cond::None).await.is_err());
+        assert!(c.lookup("b", "k").is_none(), "nothing was written");
+        for (i, (n, (slabs, bytes))) in nets.iter().zip(before).enumerate() {
+            assert!(n.net.pinned_slabs() > slabs, "r{i}: the refused write's slabs (and keys) reached the indexer");
+            assert!(n.net.sector_bytes().unwrap() > bytes, "r{i}: the refused write's sectors reached the hosts");
+        }
+    }
