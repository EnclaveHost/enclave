+    }
+
+    pub(crate) fn default_client() -> Client {
+        RHP_CLIENT.with(|client| client.clone())
+    }
+
+    #[cfg(test)]
+    mod wasm_tests {
+        use wasm_bindgen_test::wasm_bindgen_test;
