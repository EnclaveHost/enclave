+
+const DEFAULT_API_TIMEOUT: Duration = Duration::from_secs(45);
+const ACCEPT_CBOR: &str = "application/cbor, application/json;q=0.9";
+
+#[derive(Clone)]
+pub(crate) struct Client {
+    client: reqwest::Client,
+    url: Url,
+    /// PATCH (writer fencing): this client's fence credential and the first refusal it saw (one per SDK instance)
+    fence: FenceSlot,
+}
+
+/// A placeholder type that implements serde::Deserialize for endpoints that
+/// return no content.
+struct EmptyResponse;
+
+impl<'de> serde::Deserialize<'de> for EmptyResponse {
+    fn deserialize<D>(_: D) -> Result<Self, D::Error>
+    where
+        D: serde::Deserializer<'de>,
+    {
+        Ok(EmptyResponse)
+    }
+}
+
+impl Client {
+    pub(crate) fn new<U: IntoUrl>(base_url: U) -> Result<Self, Error> {
+        Ok(Self {
+            client: http_client(),
+            url: base_url.into_url()?,
+            fence: FenceSlot::default(),
+        })
+    }
+
+    pub(crate) fn fence_slot(&self) -> &FenceSlot {
+        &self.fence
+    }
+
+    /// PATCH (writer fencing): a 409 whose JSON body names a fence is a fenced refusal: recorded (the first one) and
+    /// returned as `Error::Fenced`.
+    fn note_refusal(&self, e: Error) -> Error {
+        if let Error::Api(status, body) = &e {
+            // PATCH C2 (G-C2 v4.0 section 4): C2 refusals are 412 {"conflict": "seq"|"op"|"mode"}; 409 stays the fence
+            if *status == StatusCode::PRECONDITION_FAILED {
+                return match parse_conflict(body) {
+                    Some((kind, seq)) if kind == "seq" => Error::SeqConflict(seq),
+                    Some((kind, seq)) if kind == "op" => Error::OpConflict(seq),
+                    Some((kind, _)) if kind == "mode" => Error::ModeConflict,
+                    _ => e,
+                };
+            }
+            if *status == StatusCode::CONFLICT {
+                if let Some(current) = parse_refusal(body) {
+                    let mut st = self.fence.lock().unwrap();
+                    if st.conflict.is_none() {
+                        st.conflict = Some(current);
+                    }
+                    return Error::Fenced(current);
+                }
+            }
+        }
+        e
+    }
+
+    /// PATCH (writer fencing): a signed POST of a fenced mutation (carries `sf` when this client holds a credential).
+    async fn post_fenced<S: Serialize, D: DeserializeOwned>(&self, url: Url, signing_key: &PrivateKey, body: Option<&S>) -> Result<D, Error> {
+        let (cred, v4) = self.cred_v4();
+        let body = body.and_then(|body| to_vec(body).ok());
+        let params = sign_c2(signing_key, &url, Method::POST, body.as_deref(), Utc::now() + Duration::from_secs(60), cred.as_ref(), v4);
+        let mut builder = self.client.post(url).timeout(DEFAULT_API_TIMEOUT).query(&params);
+        if let Some(body) = body {
+            builder = builder.body(body);
+        }
+        Client::handle_response(builder.send().await?).await.map_err(|e| self.note_refusal(e))
+    }
+
+    /// PATCH (writer fencing): a signed DELETE of a fenced mutation.
+    async fn delete_fenced(&self, path: &str, app_key: &PrivateKey) -> Result<(), Error> {
+        let url = self.url.join(path)?;
+        let (cred, v4) = self.cred_v4();
+        let params = sign_c2(app_key, &url, Method::DELETE, None, Utc::now() + Duration::from_secs(60), cred.as_ref(), v4);
+        Client::handle_response::<EmptyResponse>(self.client.delete(url).timeout(DEFAULT_API_TIMEOUT).query(&params).send().await?)
+            .await
+            .map(|_| ())
+            .map_err(|e| self.note_refusal(e))
+    }
+
+    /// PATCH C2: the credential, and v4 fields for a NON-advancing fenced route: an enrolled client must send every
+    /// fenced mutation as v4 (G-C2 v4.0 section 1), here with a fresh op and no head precondition.
+    fn cred_v4(&self) -> (Option<FenceCredential>, Option<crate::fence::C2Op>) {
+        let st = self.fence.lock().unwrap();
+        let v4 = match st.c2 {
+            crate::fence::C2State::Off => None,
+            _ => Some(crate::fence::C2Op { op: rand::random(), sq: None }),
+        };
+        (st.cred, v4)
+    }
+
+    /// PATCH C2: a signed head-advancing object mutation (POST /objects with a body, or DELETE /objects/:key) carrying
+    /// `sf` and, when given, the v4 fields. Returns the head the indexer reports ({"seq": n, "replayed": b}; None for
+    /// an empty or null answer).
+    async fn mutate_c2(&self, method: Method, url: Url, signing_key: &PrivateKey, body: Option<Vec<u8>>, v4: Option<crate::fence::C2Op>) -> Result<Option<crate::fence::C2Answer>, Error> {
+        let cred: Option<FenceCredential> = self.fence.lock().unwrap().cred;
+        let params = sign_c2(signing_key, &url, method.clone(), body.as_deref(), Utc::now() + Duration::from_secs(60), cred.as_ref(), v4);
+        let mut builder = self.client.request(method, url).timeout(DEFAULT_API_TIMEOUT).query(&params);
+        if let Some(body) = body {
+            builder = builder.body(body);
+        }
+        let resp = builder.send().await?;
+        if !resp.status().is_success() {
+            let e = Error::Api(resp.status(), resp.text().await?);
+            return Err(self.note_refusal(e));
+        }
+        let raw = resp.bytes().await?;
+        Ok(parse_seq_answer(&raw)?)
+    }
+
+    /// PATCH (writer fencing): `GET /fence` -> {"fence": hex64|null, "receiptSha256": hex64|null}, and (PATCH C2, G-C2
+    /// v4.0 section 5) "seq", "lastOp" (hex32|null), "lastOpDigest" (hex64|null), "mode" ("cas"|null) and
+    /// "capabilities" (absent from older indexers).
+    pub(crate) async fn fence_get(&self, app_key: &PrivateKey) -> Result<FenceState, Error> {
+        #[derive(serde::Deserialize)]
+        struct Wire {
+            fence: Option<String>,
+            #[serde(rename = "receiptSha256")]
+            receipt_sha256: Option<String>,
+            #[serde(default)]
+            seq: Option<u64>,
+            #[serde(rename = "lastOp", default)]
+            last_op: Option<String>,
+            #[serde(rename = "lastOpDigest", default)]
+            last_op_digest: Option<String>,
+            #[serde(default)]
+            mode: Option<String>,
+            #[serde(default)]
+            capabilities: Option<Vec<String>>,
+            #[serde(rename = "opNonce", default)]
+            op_nonce: Option<String>,
+        }
+        let w: Wire = self.get_json::<_, ()>("fence", app_key, None).await?;
+        let fence = w.fence.map(|f| FenceToken::parse_hex(&f)).transpose().map_err(Error::Format)?;
+        let receipt_sha256 = w.receipt_sha256.map(|h| strict_hex::<32>(&h)).transpose().map_err(Error::Format)?;
+        let last_op = w.last_op.map(|h| strict_hex::<16>(&h)).transpose().map_err(Error::Format)?;
+        let last_op_digest = w.last_op_digest.map(|h| strict_hex::<32>(&h)).transpose().map_err(Error::Format)?;
+        // a malformed nonce is refused here (N3); an absent one is refused by the caller that needs it
+        let op_nonce = w.op_nonce.map(|h| strict_hex::<16>(&h)).transpose().map_err(Error::Format)?;
+        Ok(FenceState {
+            fence,
+            receipt_sha256,
+            seq: w.seq,
+            last_op,
+            last_op_digest,
+            cas_mode: w.mode.as_deref() == Some("cas"),
+            capabilities: w.capabilities.unwrap_or_default(),
+            op_nonce,
+        })
+    }
+
+    /// PATCH (writer fencing): `POST /fence {"fence": hex64}` -> 200 {"fence","receipt"} | 409 {"fence"}.
+    /// PATCH C2: with `cas`, the body adds "mode": "cas" (sticky enrolment) and the answer's "seq" is returned; a 412
+    /// {"conflict": "mode"} (a raise without "mode": "cas" on an enrolled account) is `Error::ModeConflict`.
+    pub(crate) async fn fence_raise(&self, app_key: &PrivateKey, token: FenceToken, cas: bool) -> Result<(FenceRaise, Option<u64>), Error> {
+        #[derive(serde::Deserialize)]
+        struct Installed {
+            fence: String,
+            receipt: String,
+            #[serde(default)]
+            seq: Option<u64>,
+        }
+        let url = self.url.join("fence")?;
+        let body = if cas {
+            serde_json::json!({ "fence": token.to_hex(), "mode": "cas" })
+        } else {
+            serde_json::json!({ "fence": token.to_hex() })
+        };
+        match post_json::<_, Installed>(&self.client, url, app_key, Some(&body)).await {
+            Ok(w) => {
+                let installed = FenceToken::parse_hex(&w.fence).map_err(Error::Format)?;
+                if installed != token {
+                    return Err(Error::Format("the indexer installed a different fence than requested".into()));
+                }
+                let receipt = FenceReceipt(strict_hex::<16>(&w.receipt).map_err(Error::Format)?);
+                Ok((FenceRaise::Installed(FenceCredential { token, receipt }), w.seq))
+            }
+            Err(Error::Api(status, body)) if status == StatusCode::PRECONDITION_FAILED => match parse_conflict(&body) {
+                Some((kind, _)) if kind == "mode" => Err(Error::ModeConflict),
+                _ => Err(Error::Api(status, body)),
+            },
+            Err(Error::Api(status, body)) if status == StatusCode::CONFLICT => match parse_refusal(&body) {
+                Some(current) => Ok((FenceRaise::Refused(current), None)),
+                None => Err(Error::Api(status, body)),
+            },
+            Err(e) => Err(e),
+        }
+    }
+
+    /// Checks if the application is authenticated with the indexer. It returns
+    /// true if authenticated, false if not, and an error if the request fails.
+    pub(crate) async fn check_app_authenticated(
+        &self,
+        app_key: &PrivateKey,
+    ) -> Result<bool, Error> {
+        let url = self.url.join("auth/check")?;
+        let query_params = sign(
+            app_key,
+            &url,
+            Method::GET,
+            None,
+            Utc::now() + Duration::from_secs(60),
+        );
+        let resp = self
+            .client
+            .get(url)
+            .timeout(DEFAULT_API_TIMEOUT)
+            .query(&query_params)
+            .send()
+            .await?;
+        match resp.status() {
+            StatusCode::UNAUTHORIZED => Ok(false),
+            StatusCode::NO_CONTENT => Ok(true),
+            _ => Err(Error::Api(resp.status(), resp.text().await?)),
+        }
+    }
+
+    /// Requests an application connection to the indexer.
+    pub(crate) async fn request_app_connection(
+        &self,
+        ephemeral_key: &PrivateKey,
+        opts: &AppMetadata,
+    ) -> Result<RegisterAppResponse, Error> {
+        self.post_json("auth/connect", ephemeral_key, Some(opts))
+            .await
+    }
+
+    /// Requests an application connection using a pre-authorized key, bypassing
+    /// the interactive approval flow.
+    pub(crate) async fn request_app_connection_pre_authorized(
+        &self,
+        ephemeral_key: &PrivateKey,
+        opts: &AppMetadata,
+        pre_authorized_key: &PrivateKey,
+    ) -> Result<RegisterAppResponse, Error> {
+        let public_key = pre_authorized_key.public_key();
+        let sig_hash = pre_authorization_sig_hash(&ephemeral_key.public_key(), opts, &public_key);
+        let request = AppConnectRequest {
+            metadata: opts,
+            pre_authorized_key: public_key,
+            pre_authorization_signature: pre_authorized_key.sign(sig_hash.as_ref()),
+        };
+        self.post_json("auth/connect", ephemeral_key, Some(&request))
+            .await
+    }
+
+    /// Checks if an auth request has been approved. Returns None if the
+    /// request is still pending.
+    pub(crate) async fn check_request_status(
+        &self,
+        ephemeral_key: &PrivateKey,
+        status_url: Url,
+    ) -> Result<Option<AuthApproval>, Error> {
+        let query_params = sign(
+            ephemeral_key,
+            &status_url,
+            Method::GET,
+            None,
+            Utc::now() + Duration::from_secs(60),
+        );
+
+        let resp = self
+            .client
+            .get(status_url)
+            .timeout(DEFAULT_API_TIMEOUT)
+            .query(&query_params)
+            .send()
+            .await?;
+        let http_status = resp.status();
+        match http_status {
+            StatusCode::OK => {
+                let status = Self::handle_response::<AuthConnectStatusResponse>(resp).await?;
+                if !status.approved {
+                    return Ok(None);
+                }
+                Ok(status.user_secret.map(|user_secret| AuthApproval {
+                    user_secret,
+                    reconnecting: status.reconnecting,
+                }))
+            }
+            StatusCode::NOT_FOUND => Err(Error::UserRejected),
+            _ => Err(Error::Api(http_status, resp.text().await?)),
+        }
+    }
+
+    /// Registers the application key with the indexer.
+    pub(crate) async fn register_app(
+        &self,
+        signing_key: &PrivateKey,
+        app_key: &PrivateKey,
+        register_url: Url,
+    ) -> Result<(), Error> {
+        let segments = register_url
+            .path_segments()
+            .ok_or(Error::Format("invalid register url format".into()))?;
+        // ../auth/connect/:request_id/register
+        let request_id = segments
+            .rev()
+            .nth(1)
+            .ok_or(Error::Format("invalid register url format".into()))?;
+
+        let sig_hash = register_app_sig_hash(request_id, &signing_key.public_key());
+        let body = RegisterAppRequest {
+            app_key: app_key.public_key(),
+            signature: app_key.sign(sig_hash.as_ref()),
+        };
+        post_json::<_, EmptyResponse>(&self.client, register_url, signing_key, Some(&body))
+            .await
+            .map(|_| ())
+    }
+
+    /// Returns all usable hosts.
+    ///
+    /// # Arguments
+    /// * `query` - Parameters to control the hosts listing.
+    pub(crate) async fn hosts(
+        &self,
+        app_key: &PrivateKey,
+        query: HostQuery,
+    ) -> Result<Vec<Host>, Error> {
+        self.get_list("hosts", app_key, Some(&query)).await
+    }
+
+    /// Retrieves an object from the indexer by its key.
+    pub(crate) async fn object(
+        &self,
+        app_key: &PrivateKey,
+        key: &Hash256,
+    ) -> Result<SealedObject, Error> {
+        self.get_json::<_, ()>(&format!("objects/{key}"), app_key, None)
+            .await
+    }
+
+    /// Fetches a list of objects from the indexer. Can be paginated using the
+    /// cursor and limit arguments.
+    pub(crate) async fn objects(
+        &self,
+        app_key: &PrivateKey,
+        cursor: Option<ObjectsCursor>,
+        limit: Option<usize>,
+    ) -> Result<Vec<SealedObjectEvent>, Error> {
+        let mut query_params = Vec::new();
+        if let Some(limit) = limit {
+            query_params.push(("limit", limit.to_string()));
+        }
+        if let Some(ObjectsCursor { after, id }) = cursor {
+            query_params.push(("after", after.to_rfc3339())); // indexd expects RFC3339
+            query_params.push(("key", id.to_string()));
+        }
+        self.get_list("objects", app_key, Some(&query_params)).await
+    }
+
+    /// PATCH U1 (sia-s3 harness; needs the U1 indexd endpoint): lists the account's current objects in ID order
+    /// after `after`, read from the indexer's object table rather than its event feed, so an acknowledged pin is
+    /// listed at once.
+    ///
+    /// PATCH U1-B (blocked listing): always asks for `blocked=true`. indexd-fence leaves blocked objects out of this
+    /// listing by default, which would make an object its operator blocked look deleted or never written; with the
+    /// flag it is listed with `blocked` set and without its metadata.
+    pub(crate) async fn current_objects(
+        &self,
+        app_key: &PrivateKey,
+        after: Option<Hash256>,
+        limit: Option<usize>,
+    ) -> Result<Vec<SealedObjectEvent>, Error> {
+        let mut query_params = vec![("blocked", "true".to_string())];
+        if let Some(limit) = limit {
+            query_params.push(("limit", limit.to_string()));
+        }
+        if let Some(after) = after {
+            query_params.push(("after", after.to_string()));
+        }
+        self.get_list("current/objects", app_key, Some(&query_params)).await
+    }
+
+    /// Pins an object to the indexer. If an object with the same ID already
+    /// exists for the account, it is overwritten.
+    /// PATCH C2: with v4 fields, a v4 request conditional on the account's head; returns the head the indexer reports.
+    pub(crate) async fn pin_object(
+        &self,
+        app_key: &PrivateKey,
+        object: &SealedObject,
+        v4: Option<crate::fence::C2Op>,
+    ) -> Result<Option<crate::fence::C2Answer>, PinObjectError> {
+        let req = PinObjectRequest::from(object);
+        let body = to_vec(&req).map_err(|e| PinObjectError::Client(e.into()))?;
+        self.mutate_c2(Method::POST, self.url.join("objects").map_err(|e| PinObjectError::Client(e.into()))?, app_key, Some(body), v4)
+            .await
+            .map_err(|e| match &e {
+                Error::Api(_, message) if message.contains(ERROR_OBJECT_UNPINNED_SLAB) => {
+                    PinObjectError::UnpinnedSlab
+                }
+                _ => PinObjectError::Client(e),
+            })
+    }
+
+    /// Deletes an object from the indexer by its key. PATCH C2: a v4 request with v4 fields, as `pin_object`.
+    pub(crate) async fn delete_object(
+        &self,
+        app_key: &PrivateKey,
+        key: &Hash256,
+        v4: Option<crate::fence::C2Op>,
+    ) -> Result<Option<crate::fence::C2Answer>, Error> {
+        let url = self.url.join(&format!("objects/{key}"))?;
+        self.mutate_c2(Method::DELETE, url, app_key, None, v4).await
+    }
+
+    /// Pins slabs to the indexer.
+    pub(crate) async fn pin_slabs(
+        &self,
+        app_key: &PrivateKey,
+        slabs: &[SlabPinParams],
+    ) -> Result<Vec<Hash256>, Error> {
+        // indexd encodes an empty list as null
+        self.post_fenced(self.url.join("slabs")?, app_key, Some(&slabs))
+            .await
+            .map(Option::unwrap_or_default)
+    }
+
+    /// Unpins slabs not used by any object on the account.
+    ///
+    /// `before` prunes only slabs pinned before that time. Without it the
+    /// indexer applies its own cutoff.
+    pub(crate) async fn prune_slabs(
+        &self,
+        app_key: &PrivateKey,
+        before: Option<DateTime<Utc>>,
+    ) -> Result<(), Error> {
+        let mut url = self.url.join("slabs/prune")?;
+        if let Some(before) = before {
+            url.query_pairs_mut()
+                .append_pair("before", &before.to_rfc3339()); // indexd expects RFC3339
+        }
+        self.post_fenced::<(), EmptyResponse>(url, app_key, None)
+            .await
+            .map(|_| ())
+    }
