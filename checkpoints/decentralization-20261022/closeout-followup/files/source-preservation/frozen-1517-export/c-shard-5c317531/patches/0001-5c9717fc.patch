+    /// Matches a GET to `path` whose url signature was made by `by`.
+    fn signed_get(
+        path: impl Into<String>,
+        by: PublicKey,
+    ) -> impl Fn(&httptest::http::Request<httptest::bytes::Bytes>) -> bool {
+        let path = path.into();
+        move |req| {
+            req.method() == "GET"
+                && req.uri().path() == path
+                && validate_url_signature_request(req) == by
+        }
+    }
