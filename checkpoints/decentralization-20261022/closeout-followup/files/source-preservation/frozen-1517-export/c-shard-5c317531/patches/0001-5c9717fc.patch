+    kv("location", "s3://" + S.bucket + "/" + S.prefix);
+    const kinds = {}; for (const f of files) { const k = f.kind || "other"; kinds[k] = (kinds[k] || 0) + 1; }
+    const ks = Object.entries(kinds).sort((a, b) => b[1] - a[1]).map(([k, n]) => n + " " + k).join(", ");
+    if (ks) kv("types", ks);
+    const newest = files.reduce((a, f) => Math.max(a, f.mtime), 0); if (newest) kv("newest", fmtDate(newest));
+    pv.appendChild(dl);
+    pv.appendChild(el("div", "pvnote", "Select a file to preview it. Drag files in to upload; drag items onto a folder to move them (hold Ctrl to copy). Right-click for more."));
+  }
+}
+function actBtn(ic, label, fn, danger) { const b = el("button", "ib" + (danger ? " dangerous" : "")); b.append(icon(ic), el("span", "", label)); b.onclick = fn; return b; }
+// Fill `box` with a preview of one object: header, media, metadata, actions.
+async function fillPreview(box, b, it, signal, alive, big) {
+  const head = el("div", "pvh");
+  const ttl = el("div"); ttl.append(el("div", "t", it.name), el("div", "s", fmtBytes(it.size) + " · " + fmtDate(it.mtime)));
+  const ic = el("span"); ic.appendChild(iconFor(it));
+  head.append(ic, ttl);
+  if (!big) box.appendChild(head);
+  const media = el("div", "media"); box.appendChild(media);
+  const msg = (text, btn) => { media.textContent = ""; const m = el("div", "msg", text); if (btn) { m.appendChild(el("br")); m.appendChild(btn); } media.appendChild(m); };
+  const bigIcon = () => { media.textContent = ""; const d = el("div", "big"); d.appendChild(iconFor(it)); media.appendChild(d); };
+  bigIcon();
+  const dl = el("dl", "meta");
+  const kv = (k, v) => { dl.append(el("dt", "", k), el("dd", "", v)); };
+  kv("key", it.key); kv("size", fmtBytes(it.size) + " (" + it.size.toLocaleString() + " bytes)"); kv("modified", it.mtime ? new Date(it.mtime).toISOString().replace(".000Z", "Z") : "–");
+  kv("etag", it.etag || "–");
+  if (!big) {
+    box.appendChild(dl);
+    const a = el("div", "pvact");
+    a.append(actBtn("download", "Download", () => downloadMany([it])), actBtn("expand", "Open", () => openViewer(S.items.indexOf(it))),
+      actBtn("link", "S3 URI", () => copyText("s3://" + b + "/" + it.key, "S3 URI")), actBtn("rename", "Rename", () => doRename(it)), actBtn("trash", "Delete", () => doDelete([it]), true));
+    box.appendChild(a);
+  }
+  // what is it?
+  let kind = it.kind, mime = MIME[extOf(it.key)] || "";
+  try {
+    const h = await s3("HEAD", b, it.key, {}, { signal });
+    if (!alive()) return;
+    const ct = (h.headers.get("content-type") || "").split(";")[0].trim();
+    if (ct && ct !== "application/octet-stream") kv("type", ct);
+    if (!kind) { kind = kindOf("", ct); if (kind && !mime) mime = ct; }
+    if (!kind && it.size > 0) {
+      const r = await s3("GET", b, it.key, {}, { signal, headers: { range: "bytes=0-4095" } });
+      if (!alive()) return;
+      if (r.ok) {
+        const [k, m] = sniff(new Uint8Array(await r.arrayBuffer()));
+        if (!alive()) return;
+        kind = k; mime = m || mime;
+        kv("detected", k + (m ? " (" + m + ")" : ""));
+      }
+    }
+  } catch (e) { if (!alive()) return; }
+  if (!alive()) return;
+  if (kind && kind !== it.kind) { it.kind = kind; ic.textContent = ""; ic.appendChild(iconFor(it)); bigIcon(); }
+  if (it.size === 0) { msg("Empty file."); return; }
+  const load = async () => {
+    media.textContent = ""; bigIcon();
+    const prog = el("div", "prog"); prog.appendChild(el("i")); media.appendChild(prog);
+    try {
+      if (kind === "text") {
+        const r = await s3("GET", b, it.key, {}, { signal, headers: it.size > TEXT_MAX ? { range: "bytes=0-" + (TEXT_MAX - 1) } : null });
+        if (!r.ok) throw new Error(await s3err(r));
+        let t = new TextDecoder("utf-8").decode(await r.arrayBuffer());
+        if (!alive()) return;
+        if (it.size <= TEXT_MAX && /\.(json|jsonl?)$/i.test(it.key)) { try { t = JSON.stringify(JSON.parse(t), null, 2); } catch (e) {} }
+        media.textContent = "";
+        const pre = el("pre", "", t + (it.size > TEXT_MAX ? "\n\n… first " + fmtBytes(TEXT_MAX) + " of " + fmtBytes(it.size) : ""));
+        media.appendChild(pre);
+        return;
+      }
+      const url = await blobUrl(b, it, mime || (kind === "pdf" ? "application/pdf" : ""), signal, (f) => { prog.firstChild.style.width = Math.round(f * 100) + "%"; });
+      if (!alive()) return;
+      media.textContent = "";
+      if (kind === "image") { const im = el("img"); im.alt = it.name; im.src = url; im.onerror = () => msg("This image could not be decoded by the browser."); media.appendChild(im); }
+      else if (kind === "video") { const v = el("video"); v.controls = true; v.src = url; v.onerror = () => msg("This video format cannot play in the browser."); media.appendChild(v); }
+      else if (kind === "audio") { const a = el("audio"); a.controls = true; a.src = url; media.appendChild(a); }
+      else if (kind === "pdf") { const f = el("iframe"); f.title = it.name; f.src = url; media.appendChild(f); }
+    } catch (e) {
+      if (!alive() || signal.aborted) return;
+      msg("Preview failed: " + e.message);
+    }
+  };
+  const cap = CAP[kind];
+  if (kind === "text") return load();
+  if (!cap) { msg(kind === "archive" ? "Archive: download it to open." : kind === "binary" ? "Binary file: no preview." : "No preview for this type."); return; }
+  if (it.size > cap) {
+    const b2 = el("button", "ghost", "load anyway (" + fmtBytes(it.size) + ")"); b2.type = "button"; b2.onclick = load;
+    msg("Large file: previews download the whole object first.", b2); return;
+  }
+  return load();
+}
+
+// ---------------- full-screen viewer ----------------
+let viewer = null;
+function openViewer(i) {
+  if (i < 0 || !S.items[i] || S.items[i].dir) return;
+  closeViewer();
+  const it = S.items[i];
+  S.cursor = i; if (!S.sel.has(it.id) || S.sel.size !== 1) selectOnly(i); paintSel();
+  const v = el("div", "viewer"); v.setAttribute("role", "dialog"); v.setAttribute("aria-label", it.name);
+  const vh = el("div", "vh");
+  vh.appendChild(iconFor(it));
+  const t = el("div", "t", it.name); t.title = it.key;
+  const files = S.items.filter((x) => !x.dir), fi = files.indexOf(it);
+  vh.append(t, el("span", "s", fmtBytes(it.size) + " · " + (fi + 1) + " / " + files.length), el("span", "grow"));
+  const dl = el("button", "ib"); dl.append(icon("download"), el("span", "lb", "download")); dl.onclick = () => downloadMany([it]);
+  const x = el("button", "ib"); x.append(icon("x")); x.title = "Close (Esc)"; x.onclick = closeViewer;
+  vh.append(dl, x);
+  const vb = el("div", "vb");
+  const prev = el("button", "nav l"); prev.appendChild(icon("back")); prev.disabled = fi <= 0; prev.onclick = () => viewerStep(-1);
+  const next = el("button", "nav r"); next.appendChild(icon("fwd")); next.disabled = fi >= files.length - 1; next.onclick = () => viewerStep(1);
+  const holder = el("div"); holder.style.cssText = "width:100%;height:100%;display:flex;flex-direction:column;justify-content:center";
+  vb.append(holder, prev, next);
+  v.append(vh, vb);
+  v.addEventListener("click", (e) => { if (e.target === vb) closeViewer(); });
+  document.body.appendChild(v);
+  const ac = new AbortController();
+  viewer = { el: v, ac, files, fi };
+  fillPreview(holder, S.bucket, it, ac.signal, () => viewer && viewer.ac === ac, true);
+  x.focus();
+}
+function viewerStep(d) {
+  if (!viewer) return;
+  const nx = viewer.files[viewer.fi + d]; if (!nx) return;
+  openViewer(S.items.indexOf(nx));
+  const e = itemEl(S.cursor); if (e) e.scrollIntoView({ block: "nearest" });
+}
+function closeViewer() { if (!viewer) return; viewer.ac.abort(); viewer.el.remove(); viewer = null; }
+function viewerKey(e) {
+  if (e.key === "Escape" || e.key === " ") { e.preventDefault(); closeViewer(); $("files").focus(); }
+  else if (e.key === "ArrowLeft") { e.preventDefault(); viewerStep(-1); }
+  else if (e.key === "ArrowRight") { e.preventDefault(); viewerStep(1); }
+}
+
+// ---------------- grid thumbnails ----------------
+let thumbObs = null; const thumbQ = []; let thumbBusy = 0;
+function setupThumbs() {
+  const nodes = $("files").querySelectorAll("[data-thumb]");
+  if (!nodes.length) return;
+  thumbObs = new IntersectionObserver((ents) => {
+    for (const en of ents) if (en.isIntersecting) { thumbObs.unobserve(en.target); thumbQ.push(en.target); }
+    pumpThumbs();
+  }, { root: $("files"), rootMargin: "200px" });
+  nodes.forEach((n) => thumbObs.observe(n));
+}
+function pumpThumbs() {
+  while (thumbBusy < 3 && thumbQ.length) {
+    const n = thumbQ.shift(); const it = S.items[+n.dataset.thumb];
+    if (!it || !n.isConnected) continue;
+    thumbBusy++;
+    const b = S.bucket;
+    blobUrl(b, it, MIME[extOf(it.key)] || "image/png").then((url) => {
+      if (!n.isConnected) return;
+      const im = el("img"); im.alt = ""; im.src = url; im.onload = () => { n.textContent = ""; n.appendChild(im); };
+    }, () => {}).finally(() => { thumbBusy--; pumpThumbs(); });
+  }
+}
+
+// ---------------- open / lock ----------------
+const STORE_KEY = "sia-s3-keys";
+function loadKeys() { try { const v = sessionStorage.getItem(STORE_KEY); return v ? JSON.parse(v) : null; } catch (e) { return null; } }
+function saveKeys(c) { try { if (c) sessionStorage.setItem(STORE_KEY, JSON.stringify(c)); else sessionStorage.removeItem(STORE_KEY); } catch (e) {} }
+async function unlock(c, remember) {
+  creds = c; setErr("");
+  $("unlock").disabled = true;
+  try {
+    const r = await s3("GET", "", "", {});
+    if (!r.ok) throw new Error(await s3err(r));
+    S.buckets = Array.from(xmlDoc(await r.text()).getElementsByTagName("Bucket"), (b) => tagText(b, "Name"));
+    if (!S.buckets.length) throw new Error("this deployment has no buckets");
+    if (remember) saveKeys(c);
+    show($("locked"), false); show($("app"), true);
+    const h = parseHash();
+    const st = history.state;
+    navN = st && st.n != null ? st.n : 0; navMax = navN;
+    if (h && S.buckets.includes(h.b)) nav(h.b, h.p, true); else nav(S.buckets[0], "", true);
+    $("files").focus();
+  } catch (e) {
+    creds = null; saveKeys(null);
+    setErr("Could not open the bucket list: " + e.message);
+  } finally { $("unlock").disabled = false; }
+}
+$("unlock").onclick = () => {
+  const ak = $("ak").value.trim(), sk = $("sk").value.trim();
+  if (!ak || !sk) { setErr("Both keys are needed."); return; }
+  $("sk").value = "";
+  unlock({ ak, sk }, $("remember").checked);
+};
+$("sk").addEventListener("keydown", (e) => { if (e.key === "Enter") $("unlock").click(); });
+$("lock").onclick = () => {
+  if (jobs.some((j) => ["queued", "run", "wait"].includes(j.state)) && !confirmLeave()) return;
+  creds = null; saveKeys(null);
+  for (const v of blobs.values()) URL.revokeObjectURL(v.url);
+  blobs.clear(); blobBytes = 0; cache.clear(); S.clip = null; closeViewer();
+  $("files").textContent = ""; $("pv").textContent = ""; delete $("pv").dataset.k;
+  show($("app"), false); show($("locked"), true);
+};
+function confirmLeave() { toast("Transfers are still running: wait for them or cancel them first.", true); return false; }
+
+// toolbar wiring
+ibtn("side-btn", "menu"); ibtn("connect-btn", "plug", "connect"); ibtn("lock", "lock", "lock");
+ibtn("nb-back", "back"); ibtn("nb-fwd", "fwd"); ibtn("nb-up", "up"); ibtn("nb-refresh", "refresh");
+ibtn("ab-upload", "upload", "upload"); ibtn("ab-upfolder", "upload", "folder", true); ibtn("ab-newfolder", "newfolder", "new folder");
+ibtn("ab-download", "download", "download"); ibtn("ab-rename", "rename", "rename", true); ibtn("ab-move", "move", "move", true);
+ibtn("ab-copy", "copy", "copy", true); ibtn("ab-delete", "trash", "delete");
+ibtn("vb-list", "list"); ibtn("vb-grid", "grid"); ibtn("vb-pv", "panel"); ibtn("jobs-min", "chev");
+$("filter").parentNode.prepend(icon("search"));
+$("nb-back").onclick = () => { if (navN > 0) history.back(); };
+$("nb-fwd").onclick = () => { if (navN < navMax) history.forward(); };
+$("nb-up").onclick = () => { if (S.prefix) nav(S.bucket, parentOf(S.prefix)); };
+$("nb-refresh").onclick = () => refresh();
+$("ab-upload").onclick = () => $("upfile").click();
+$("ab-upfolder").onclick = () => $("updir").click();
+$("ab-newfolder").onclick = newFolder;
+$("ab-download").onclick = () => downloadMany(selItems().filter((x) => !x.dir));
+$("ab-rename").onclick = () => doRename(selItems()[0]);
+$("ab-move").onclick = () => doTransferDialog(selItems(), "move");
+$("ab-copy").onclick = () => doTransferDialog(selItems(), "copy");
+$("ab-delete").onclick = () => doDelete(selItems());
+$("vb-list").onclick = () => { S.view = "list"; lsSet("view", "list"); render(); };
+$("vb-grid").onclick = () => { S.view = "grid"; lsSet("view", "grid"); render(); };
+$("vb-pv").onclick = () => { S.pv = !S.pv; lsSet("pv", S.pv); delete $("pv").dataset.k; render(); };
+$("lhead").addEventListener("click", (e) => {
+  const b = e.target.closest("[data-sort]"); if (!b) return;
+  const by = b.dataset.sort;
+  S.sort = { by, dir: S.sort.by === by ? -S.sort.dir : by === "name" ? 1 : -1 }; lsSet("sort", S.sort);
+  applyView(); render();
+});
+$("sortsel").onchange = (e) => { const by = e.target.value; S.sort = { by, dir: by === "name" ? 1 : -1 }; lsSet("sort", S.sort); applyView(); render(); };
+let filterT = 0;
+$("filter").addEventListener("input", (e) => { clearTimeout(filterT); filterT = setTimeout(() => { S.filter = e.target.value; applyView(); render(); }, 80); });
+$("side-btn").onclick = () => $("side").classList.toggle("open");
+$("connect-btn").onclick = () => dialog({ title: "Connect an S3 client", node: $("connect-body"), wide: true, buttons: [{ label: "close", value: null, kind: "primary" }] });
+$("pill").onclick = () => { status(); dialog({ title: "Status", node: $("status-body"), wide: true, buttons: [{ label: "close", value: null, kind: "primary" }] }); };
+document.addEventListener("click", (e) => { const sd = $("side"); if (sd.classList.contains("open") && !sd.contains(e.target) && e.target !== $("side-btn") && !$("side-btn").contains(e.target)) sd.classList.remove("open"); });
+// the main pane is also a drop target for files (outside the list itself, e.g. the header)
+$("main").addEventListener("dragover", (e) => { if (isFiles(e)) { e.preventDefault(); dropOverlay(true, null); } });
+$("main").addEventListener("dragleave", (e) => { if (!$("main").contains(e.relatedTarget)) dropOverlay(false); });
+$("main").addEventListener("drop", (e) => {
+  if (!isFiles(e)) return;
+  e.preventDefault(); dropOverlay(false);
+  filesFromDrop(e.dataTransfer).then((l) => enqueueUploads(l, S.bucket, S.prefix));
+});
+// a stray drop outside any target must not navigate the tab away to the file
+window.addEventListener("dragover", (e) => { if (e.dataTransfer.types.includes("Files")) e.preventDefault(); });
+window.addEventListener("drop", (e) => { if (e.dataTransfer.types.includes("Files")) { e.preventDefault(); dropOverlay(false); } });
+window.addEventListener("resize", () => { delete $("pv").dataset.k; schedulePreview(); });
+
+status();
+setInterval(status, 15000);
+const kept = loadKeys();
+if (kept) status().then(() => unlock(kept, true));
+</script>
+</body>
+</html>
