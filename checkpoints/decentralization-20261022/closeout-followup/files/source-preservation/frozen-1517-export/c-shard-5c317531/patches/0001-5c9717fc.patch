+/// Integration tests requiring httptest, a TCP mock server. Native only.
+#[cfg(all(test, not(all(target_arch = "wasm32", target_os = "unknown"))))]
+mod native_tests {
+    use super::test::random_seed;
+    use super::*;
+    use crate::KeyStats;
