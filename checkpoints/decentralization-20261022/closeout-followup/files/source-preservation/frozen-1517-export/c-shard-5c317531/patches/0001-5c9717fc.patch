+    async fn c2_two_new_identical_writes_with_both_first_replies_lost_exactly_one_succeeds() {
+        // root's 14:38Z case: two copies with a copied RNG build the SAME sealed bytes for two NEW client requests, and
+        // the indexer handles both first sends but both answers are lost; then both settle. Each new operation takes its
+        // id from a nonce the indexer gave in a GET /fence it requested after the invocation began (G-C2 R2 N1), so the
+        // two are different operations at the same head: one is applied, the other is refused, and its settlement too
+        let nets = [Net::new(1)];
+        let c = c2_booted(&nets).await;
+        let s = c.store(0).unwrap();
+        let obj = s.upload(Rc::from(&b"identical"[..])).await.unwrap();
+        let sealed = obj.seal(&nets[0].key);
+        let p = copied_sdk(&nets, &s.sdk).await;
+        let q = copied_sdk(&nets, &s.sdk).await;
+        p.c2_test_copied_rng([5; 16]);
+        q.c2_test_copied_rng([5; 16]);
+        let h = p.c2_head().unwrap();
+        // both copies fetch their nonce and send before either send is applied; the indexer then handles both, in that
+        // order, and both answers are lost (the senders gave up)
+        nets[0].net.push_fault("pin_object", Fault::Defer);
+        nets[0].net.push_fault("pin_object", Fault::Defer);
+        let both = tokio::time::timeout(Duration::from_secs(1), async { tokio::join!(p.c2_test_pin_sealed(&sealed), q.c2_test_pin_sealed(&sealed)) }).await;
+        assert!(both.is_err(), "neither answered");
+        assert_eq!(nets[0].net.apply_deferred(), 2, "both first sends reach the indexer");
+        let (rp, rq) = (p.c2_check().await.unwrap(), q.c2_check().await.unwrap());
+        let ok = [&rp, &rq].iter().filter(|r| matches!(r, sia_storage::fence::C2Check::Confirmed(_))).count();
+        assert_eq!(ok, 1, "exactly one copy settles its write as applied: {rp:?} / {rq:?}");
+        assert!(matches!(rq, sia_storage::fence::C2Check::Forked(_)), "the second, a different operation at a stale head, is refused");
+        assert_eq!(nets[0].net.c2_head().0, h + 1, "applied once");
