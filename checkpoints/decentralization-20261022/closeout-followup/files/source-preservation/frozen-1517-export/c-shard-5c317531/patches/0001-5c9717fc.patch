+use std::mem;
+
+use bytes::Bytes;
+use sia_core::rhp4::{SECTOR_SIZE, SEGMENT_SIZE};
+use sia_reed_solomon::ReedSolomon;
+use thiserror::Error;
+use tokio::io::{self, AsyncRead, AsyncReadExt, AsyncWrite, AsyncWriteExt};
+
+use crate::EncryptionKey;
+use crate::encryption::Chacha20Cipher;
+use crate::object_encryption::hedged_key;
+
+#[derive(Debug, Error)]
+pub enum Error {
+    #[error("ReedSolomon error: {0}")]
+    ReedSolomon(#[from] sia_reed_solomon::Error),
+
+    #[error("IO error: {0}")]
+    Io(#[from] io::Error),
+}
+
+pub type Result<T> = std::result::Result<T, Error>;
+
+pub(crate) struct ErasureCoder {
+    encoder: ReedSolomon,
+}
+
+impl ErasureCoder {
+    pub fn new(data_shards: usize, parity_shards: usize) -> Result<Self> {
+        Ok(ErasureCoder {
+            encoder: ReedSolomon::new(data_shards, parity_shards)?,
+        })
+    }
+
+    pub fn data_shards(&self) -> usize {
+        self.encoder.data_shards()
+    }
+
+    /// encodes the shards using reed solomon erasure coding,
+    /// computing the parity shards and overwriting their values.
+    pub fn encode_shards(&self, shards: &mut [Vec<u8>]) -> Result<()> {
+        self.encoder.encode(shards)?;
+        Ok(())
+    }
+
+    /// reconstructs the missing datashards from the available ones.
+    pub fn reconstruct_data_shards(&self, shards: &mut [Option<Vec<u8>>]) -> Result<()> {
+        self.encoder.reconstruct_data(shards)?;
+        Ok(())
+    }
+
+    /// write_data_shards writes up to 'n' bytes from the given reconstructed shards
+    /// to the provided writer, skipping the first `skip` bytes.
+    pub async fn write_data_shards<W: AsyncWrite + Unpin>(
+        w: &mut W,
+        shards: &[Bytes],
+        mut skip: usize,
+        mut n: usize,
+    ) -> Result<()> {
+        let row_bytes = shards.len() * SEGMENT_SIZE;
+        let rows = skip / row_bytes;
+        let mut offset = rows * SEGMENT_SIZE;
+        skip %= row_bytes;
+        while n > 0 {
+            for shard in shards {
+                if n == 0 {
+                    return Ok(());
+                } else if skip > SEGMENT_SIZE {
+                    skip -= SEGMENT_SIZE;
+                    continue;
+                }
+
+                let start = offset + skip;
+                let length = n.min(SEGMENT_SIZE - skip);
+
+                w.write_all(&shard[start..start + length]).await?;
+                n -= length;
+                skip = 0;
+            }
+            offset += SEGMENT_SIZE;
+        }
+        Ok(())
+    }
+}
+
+/// A streaming reader that interleaves incoming bytes across a slab's data
+/// shards as they become available. Yields a [ReadSlab] whenever a full slab
+/// has been accumulated; call [SlabReader::finish] to recover any trailing
+/// partial slab.
+pub(crate) struct SlabReader {
+    data_shards: usize,
+    shards: Vec<Vec<u8>>,
+    /// PATCH (clone privacy): the current slab's plaintext ranges in slab
+    /// order, each with the data key of the object it belongs to. The slab key
+    /// is chosen, and these ranges encrypted, only once the slab is complete
+    /// (see [seal](Self::seal)).
+    segments: Vec<(usize, usize, EncryptionKey)>,
+    /// Contiguous landing area for incoming data, scattered from here into
+    /// the interleaved shard layout; when a slab is sealed, the same buffer
+    /// holds one chunk at a time while the object keystream is applied.
+    /// Allocated once and reused, so a slab costs no allocation here.
+    read_buffer: Vec<u8>,
+    length: usize,
+    total_length: u64,
+}
+
+/// How much data is buffered before a single `apply_keystream` call.
+const READ_BUFFER_SIZE: usize = 64 << 10;
+
+pub(crate) struct ReadSlab {
+    pub encryption_key: EncryptionKey,
+    pub length: usize,
+    pub shards: Vec<Vec<u8>>,
+}
+
+/// Reads as many bytes as possible from `r` into `buf`, stopping at end of
+/// input. Returns the number of bytes read.
+///
+/// This is distinct from `read_exact`, which reports an unexpected end of input
+/// when it cannot fill the buffer.
+async fn fill_buf<R: AsyncRead + Unpin>(r: &mut R, buf: &mut [u8]) -> io::Result<usize> {
+    let mut read_total = 0;
+    while read_total < buf.len() {
+        let n = r.read(&mut buf[read_total..]).await?;
+        if n == 0 {
+            break;
+        }
+        read_total += n;
+    }
+    Ok(read_total)
+}
+
+/// Visits the interleaved data-shard layout of slab bytes `start..start + len`
+/// in slab order: `f(shard, offset in shard, offset in the range, length)`.
+/// 64-byte segments are striped across the data shards.
+fn for_each_striped(
+    data_shards: usize,
+    start: usize,
+    len: usize,
+    mut f: impl FnMut(usize, usize, usize, usize),
+) {
+    let stripe_size = SEGMENT_SIZE * data_shards;
+    let mut off = 0;
+    while off < len {
+        let logical = start + off;
+        let shard_index = (logical % stripe_size) / SEGMENT_SIZE;
+        let byte_in_seg = logical % SEGMENT_SIZE;
+        let dst = (logical / stripe_size) * SEGMENT_SIZE + byte_in_seg;
+        let take = (SEGMENT_SIZE - byte_in_seg).min(len - off);
+        f(shard_index, dst, off, take);
+        off += take;
+    }
+}
+
+/// PATCH (clone privacy): the domain of the hedged slab key derivation.
+const SLAB_KEY_DOMAIN: &[u8] = b"sia_storage/slab-key/v1";
+
+/// PATCH (clone privacy): the key of a complete slab, derived from fresh
+/// randomness AND everything that determines the slab's ciphertext: the
+/// layout, the length, each plaintext range with its data key, and the data
+/// shards' plaintext (zero padding included). See
+/// [hedged_key](crate::object_encryption::hedged_key). Every field before the
+/// shards has a fixed width, so the encoding is unambiguous.
+fn hedged_slab_key(
+    total_shards: usize,
+    length: usize,
+    segments: &[(usize, usize, EncryptionKey)],
+    data: &[Vec<u8>],
+) -> EncryptionKey {
+    let mut header = zeroize::Zeroizing::new(Vec::with_capacity(32 + segments.len() * 48));
+    for v in [data.len(), total_shards, length, segments.len()] {
+        header.extend((v as u64).to_le_bytes());
+    }
+    for (start, end, data_key) in segments {
+        header.extend((*start as u64).to_le_bytes());
+        header.extend((*end as u64).to_le_bytes());
+        header.extend(data_key.as_ref());
+    }
+    let mut parts: Vec<&[u8]> = vec![header.as_slice()];
+    parts.extend(data.iter().map(|d| d.as_slice()));
+    hedged_key(SLAB_KEY_DOMAIN, &parts)
+}
+
+impl SlabReader {
+    pub(crate) fn new(data_shards: usize, parity_shards: usize) -> Self {
+        let total_shards = data_shards + parity_shards;
+        Self {
+            data_shards,
+            shards: vec![vec![0u8; SECTOR_SIZE]; total_shards],
+            segments: Vec::new(),
+            read_buffer: vec![0u8; READ_BUFFER_SIZE],
+            length: 0,
+            total_length: 0,
+        }
+    }
+
+    pub fn length(&self) -> usize {
+        self.length
+    }
+
+    /// Cumulative bytes that have landed in the pipeline across all
+    /// `read_slab` calls, including bytes from reads that errored part-way.
+    /// Unlike [length](Self::length), this never resets when a slab is
+    /// finalized.
+    pub fn total_length(&self) -> u64 {
+        self.total_length
+    }
+
+    /// The optimal slab size for streaming reads
+    pub fn optimal_data_size(&self) -> usize {
+        self.data_shards * SECTOR_SIZE
+    }
+
+    /// Finalizes the slab reader, returning any remaining data as a slab.
+    pub fn finish(mut self) -> Option<ReadSlab> {
+        if self.length == 0 {
+            return None;
+        }
+        let length = self.length;
+        let shards = mem::take(&mut self.shards);
+        Some(self.seal(shards, length))
+    }
+
+    /// PATCH (clone privacy): completes a slab. Its key is chosen only now,
+    /// from fresh randomness and the slab's whole content (`hedged_slab_key`),
+    /// and only then is each range encrypted with its object's keystream, as
+    /// [read_slab](Self::read_slab) used to do while reading.
+    ///
+    /// Why: a key chosen before the input is complete is shared by every copy
+    /// of a running process (the copies' RNGs are copies too), so copies given
+    /// different input would encrypt it under the same keystreams in both
+    /// layers. With a hedged key they get independent keystreams unless the
+    /// slab is identical, in which case the ciphertext is identical too:
+    /// equality is all copies can reveal. With fresh randomness the key is as
+    /// random as before. The stored format is unchanged.
+    fn seal(&mut self, mut shards: Vec<Vec<u8>>, length: usize) -> ReadSlab {
+        let segments = mem::take(&mut self.segments);
+        let total_shards = shards.len();
+        let encryption_key = hedged_slab_key(
+            total_shards,
+            length,
+            &segments,
+            &shards[..self.data_shards],
+        );
+        let data_shards = self.data_shards;
+        for (start, end, data_key) in segments {
+            let mut cipher = Chacha20Cipher::new_v1(data_key, start as u64, &encryption_key);
+            let mut p = start;
+            while p < end {
+                let n = (end - p).min(self.read_buffer.len());
+                let buf = &mut self.read_buffer[..n];
+                for_each_striped(data_shards, p, n, |s, dst, off, take| {
+                    buf[off..off + take].copy_from_slice(&shards[s][dst..dst + take]);
+                });
+                cipher.apply_keystream(buf);
+                for_each_striped(data_shards, p, n, |s, dst, off, take| {
+                    shards[s][dst..dst + take].copy_from_slice(&buf[off..off + take]);
+                });
+                p += n;
+            }
+        }
+        self.read_buffer.fill(0); // it held plaintext
+        ReadSlab {
+            encryption_key,
+            length,
+            shards,
+        }
+    }
+
+    /// Reads data from the reader until reaching the optimal slab size or EOF,
+    /// whichever comes first. This should be called in a loop until EOF is
+    /// reached.
+    ///
+    /// If the optimal slab size is reached, the completed slab is returned.
+    /// Any remaining data should be retrieved using [finish](Self::finish).
+    pub async fn read_slab<R: AsyncRead + Unpin>(
+        &mut self,
+        data_key: EncryptionKey,
+        r: &mut R,
+    ) -> io::Result<(usize, Option<ReadSlab>)> {
+        if self.length == self.optimal_data_size() {
+            return Ok((0, None));
+        }
+        let mut total_read = 0;
+
+        while self.length < self.optimal_data_size() {
+            // Fill the buffer, then stripe it into the shards. `want` never
+            // exceeds what is left of the slab, so the reader is never taken
+            // past the boundary.
+            let remaining = self.optimal_data_size() - self.length;
+            let want = remaining.min(self.read_buffer.len());
+            let filled = fill_buf(r, &mut self.read_buffer[..want]).await?;
+            if filled == 0 {
+                break;
+            }
+
+            // PATCH (clone privacy): stored as plaintext and recorded with its
+            // data key; `seal` encrypts it once the slab is complete. Recorded
+            // as soon as it lands, so bytes from a read that errors later are
+            // encrypted (with the failed object's key) like any others.
+            let start_len = self.length;
+            let (shards, buf) = (&mut self.shards, &self.read_buffer);
+            for_each_striped(self.data_shards, start_len, filled, |s, dst, off, take| {
+                shards[s][dst..dst + take].copy_from_slice(&buf[off..off + take]);
+            });
+            match self.segments.last_mut() {
+                Some((_, end, key)) if *end == start_len && *key == data_key => *end += filled,
+                _ => self.segments.push((start_len, start_len + filled, data_key.clone())),
+            }
+
+            self.length += filled;
+            self.total_length += filled as u64;
+            total_read += filled;
+
+            // A short fill means the reader is done.
+            if filled < want {
+                break;
+            }
+        }
+        let slab = if self.length == self.optimal_data_size() {
+            let length = mem::take(&mut self.length);
+            let total_shards = self.shards.len();
+            let shards = mem::replace(&mut self.shards, vec![vec![0u8; SECTOR_SIZE]; total_shards]);
+            Some(self.seal(shards, length))
+        } else {
+            None
+        };
+        Ok((total_read, slab))
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use std::io::Cursor;
+
+    use super::*;
+
+    fn init_shard(i: u8) -> Vec<u8> {
+        vec![i; SECTOR_SIZE]
+    }
+
+    /// Reverses the per-segment encryption `read_slab` applies, restoring the
+    /// data shards to plaintext so the striping assertions can compare against
+    /// the original input. Mirrors `read_slab`'s logical-order walk.
+    fn decrypt_data_shards(
+        shards: &mut [Vec<u8>],
+        data_shards: usize,
+        data_key: &EncryptionKey,
+        slab_key: &EncryptionKey,
+        length: usize,
+    ) {
+        let mut cipher = Chacha20Cipher::new_v1(data_key.clone(), 0, slab_key);
+        let stripe = SEGMENT_SIZE * data_shards;
+        let mut p = 0;
+        while p < length {
+            let shard = (p % stripe) / SEGMENT_SIZE;
+            let seg_start = (p / stripe) * SEGMENT_SIZE;
+            let n = SEGMENT_SIZE.min(length - p);
+            cipher.apply_keystream(&mut shards[shard][seg_start..seg_start + n]);
+            p += n;
+        }
+    }
+
+    #[sia_core_derive::cross_target_test]
+    fn test_encode_shards() {
+        let data_shards = 2;
+        let parity_shards = 3;
+        let coder = ErasureCoder::new(data_shards, parity_shards).unwrap();
+
+        let mut shards: Vec<Vec<u8>> = [
+            init_shard(1),
+            init_shard(2),
+            init_shard(0),
+            init_shard(0),
+            init_shard(0),
+        ]
+        .into();
+
+        coder.encode_shards(&mut shards).unwrap();
+
+        let expected_shards: Vec<Vec<u8>> = vec![
+            init_shard(1),
+            init_shard(2),
+            init_shard(7),  // parity shard 1
+            init_shard(4),  // parity shard 2
+            init_shard(13), // parity shard 3
+        ];
+        assert_eq!(shards, expected_shards);
+
+        // reconstruct data shards
+        for i in 0..data_shards {
+            let mut shards: Vec<Option<Vec<u8>>> = shards.iter().cloned().map(Some).collect();
+            shards[i] = None;
+            coder.reconstruct_data_shards(&mut shards).unwrap();
+            let shards: Vec<Vec<u8>> = shards.into_iter().map(|s| s.unwrap()).collect();
+            assert_eq!(shards, expected_shards);
+        }
+    }
