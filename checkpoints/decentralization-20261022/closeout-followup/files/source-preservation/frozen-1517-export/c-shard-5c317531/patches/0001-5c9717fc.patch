+    // ---- C2 (module docs, "C2"; work/storage-c2-implementation-interface.txt) ----
+
+    /// A memory copy of `p` taken now (a host snapshots a RUNNING instance after its raise and resumes the copy): the same
+    /// instance id, ballot, receipts, clock and reserved range, SDKs presenting the same credential AND the same C2
+    /// heads, and indexes listed from the same state.
+    async fn clone_of(p: &Cluster, nets: &[Net]) -> Cluster {
+        let mut sdks = Vec::new();
+        for (i, n) in nets.iter().enumerate() {
+            sdks.push((i, n.net.sdk(n.key.clone()).await.unwrap()));
+        }
+        p.test_memory_copy(sdks).await
+    }
+
+    async fn c2_booted(nets: &[Net]) -> Cluster {
+        let (p, r) = fenced(nets, &all(nets.len()), nets.len() / 2 + 1, lease_policy(5), None).await;
+        r.unwrap();
+        settle(&p).await;
+        maintain(&p).await;
+        p.put("b", "seed", b"s".to_vec(), None, &Cond::None).await.unwrap(); // a version range is reserved
+        p
+    }
+
+    /// Tentative content still on each indexer, from a fresh listing.
+    async fn tentative_left(nets: &[Net]) -> Vec<usize> {
+        let mut out = Vec::new();
+        for n in nets {
+            let sdk = n.net.sdk(n.key.clone()).await.unwrap();
+            let mut s = Store::load_listing(sdk, 8 << 20, opts()).await.unwrap();
+            out.push(s.idx.get_mut().tentative.len());
+        }
+        out
+    }
