+    async fn blocked_listing_pages_past_blocked_and_short_pages_and_fails_closed_until_unblocked() {
+        let nets = [Net::new(1)];
+        let c = cluster(&nets, 1).await;
+        maintain(&c).await;
+        for k in ["k0", "k1", "k2", "k3", "k4"] {
+            c.put("b", k, k.as_bytes().to_vec(), None, &Cond::None).await.unwrap();
+        }
+        let (h1, h3) = (host_of(&c, 0, "k1").await, host_of(&c, 0, "k3").await);
+        let total = c.store(0).unwrap().idx.lock().await.objs.len();
+        drop(c);
+        nets[0].net.block_object(h1, true);
+        nets[0].net.block_object(h3, true);
+        // pages of one entry (a server capping below the 500 asked), some made of a blocked entry only, then pages of
+        // two (mixed): each listing goes on to the empty page and misses nothing that is not blocked
+        for cap in [1, 2] {
+            nets[0].net.set_listing_page_limit(Some(cap));
+            let mut s = Store::load_listing(sdk_of(&nets[0]).await, 8 << 20, opts()).await.unwrap();
+            let idx = s.idx.get_mut();
+            assert_eq!(idx.blocked.len(), 2, "cap {cap}");
+            assert_eq!(idx.objs.len(), total - 2, "cap {cap}: every unblocked object, past short and blocked pages");
+            for k in ["k0", "k2", "k4"] {
+                assert!(idx.keys.contains_key(&("b".to_string(), k.to_string())), "cap {cap}: {k}");
+            }
+            assert!(idx.orphans.is_empty() && !idx.complete(), "nothing is swept from a listing with blocked objects");
+            let e = Store::load_with(sdk_of(&nets[0]).await, 8 << 20, opts()).await.err().unwrap();
+            assert!(e.starts_with("AdminBlocked"), "{e}");
+        }
+        nets[0].net.set_listing_page_limit(None);
+        // a restart: the only replica is left out, so nothing is served (503), never an empty or older listing
+        let c = cluster(&nets, 1).await;
+        assert!(!c.ready() && c.store(0).is_none() && c.lookup("b", "k0").is_none());
+        assert_eq!(c.blocked_objects(0), Some(2));
+        // maintenance lists it again; once the operator lifts the blocks it rejoins and serves everything
+        maintain(&c).await;
+        assert!(!c.ready());
+        nets[0].net.block_object(h1, false);
+        nets[0].net.block_object(h3, false);
+        maintain(&c).await;
+        assert!(c.ready() && c.blocked_objects(0).is_none(), "{:?}", c.ms_reason());
+        for k in ["k0", "k1", "k2", "k3", "k4"] {
+            assert_eq!(get(&c, k).await.unwrap(), k.as_bytes());
