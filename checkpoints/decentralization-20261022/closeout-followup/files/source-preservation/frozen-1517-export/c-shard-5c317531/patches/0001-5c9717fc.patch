+
+    use crate::fencing::{Authority, FenceMode, FencePolicy, Isolation};
+
+    fn lease(generation: u64) -> Authority {
+        Authority::Lease17 { chain_id: 8453, ledger: format!("0x{}", "1".repeat(40)), deployment: format!("0x{}", "2".repeat(64)), generation }
+    }
+
+    /// A lease instance on SNP, production-shaped: NO acceptUnevidencedIsolation (C2 does not assume no-clone; its
+    /// preconditions are verified at boot).
+    fn lease_policy(generation: u64) -> FencePolicy {
+        FencePolicy { mode: FenceMode::Required, authority: Some(lease(generation)), isolation: Some(Isolation::Snp), accept_unevidenced_isolation: false }
+    }
+
+    fn owner_policy() -> FencePolicy {
+        FencePolicy { mode: FenceMode::Required, authority: Some(Authority::OwnerCold), isolation: Some(Isolation::OwnerProcess), accept_unevidenced_isolation: false }
+    }
