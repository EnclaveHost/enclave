+        assert!(c.lookup("b", "k").is_none(), "r0's tombstone still hides r2's v1");
+        assert!(c.withheld("b", "d", &d_ver), "d's version was served when r1 was found blocked and r1 no longer vouches for it");
+        let de = c.lookup("b", "d").unwrap();
