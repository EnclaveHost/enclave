+        // reservation (W = 1 under the old set: r0 alone acknowledges it)
+        nets[1].offline(true);
+        nets[2].offline(true);
+        let p1 = members_with(&nets, &[(0, true), (1, false), (2, false)], 2).await;
+        assert_eq!(phase(&p1), (Phase::Migrating, true, 1));
