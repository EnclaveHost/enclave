+        assert_eq!(nets[0].net.c2_head().0, h0 + 1, "applied once");
+        // the next check replays exactly that operation: answered as applied, NOT applied again
+        c.fresh().await.unwrap();
+        assert_eq!(nets[0].net.c2_head().0, h0 + 1, "the replay was not applied a second time");
