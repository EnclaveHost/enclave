+        maintain(&a).await;
+        a.put("b", "k", b"v1".to_vec(), None, &Cond::None).await.unwrap();
+        for n in &nets {
+            n.net.push_fault("pin_object", Fault::Defer);
+        }
+        let _ = tokio::time::timeout(Duration::from_secs(20), a.put("b", "k2", b"stale".to_vec(), None, &Cond::None)).await;
+        let b = cluster(&nets, 2).await;
+        maintain(&b).await;
+        assert!(b.lookup("b", "k2").is_none(), "B booted without A's unacknowledged k2");
+        let applied = nets.iter().map(|n| n.net.apply_deferred()).sum::<usize>();
+        assert!(applied >= 2);
+        // the old writer, still running, answers reads from its own view and believes it is current: nothing stops it
+        assert!(a.ready() && a.superseded().is_none(), "unfenced: no fence tells A it is stale");
+        assert!(a.fresh().await.is_ok(), "unfenced: no confirmation either");
+        let b2 = cluster(&nets, 2).await;
