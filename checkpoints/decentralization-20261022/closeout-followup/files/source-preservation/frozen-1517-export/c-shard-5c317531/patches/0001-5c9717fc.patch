+        drop(one);
+        // the same lease, restarted with {r1, r2} and r0 retiring: the fence covers current and target replicas
+        let (m, r) = fenced(&nets, &[(0, true), (1, false), (2, false)], 2, lease_policy(5), None).await;
+        r.unwrap();
+        assert_eq!(phase(&m).0, Phase::Migrating);
+        backfill(&m).await;
+        maintain(&m).await;
+        assert_eq!(phase(&m), (Phase::Stable, true, 3), "{:?}", m.ms_reason());
+        for n in &nets {
+            assert_eq!(n.net.installed_fence(), m.ballot());
+        }
+        m.put("b", "k2", b"w".to_vec(), None, &Cond::None).await.unwrap();
+        // a later lease boots on the new set alone (r0 gone): every acknowledged write is there; m is stopped
+        nets[0].offline(true);
+        let (b, r) = fenced(&nets, &[(1, false), (2, false)], 2, lease_policy(6), None).await;
+        r.unwrap();
+        maintain(&b).await;
+        assert_eq!(phase(&b).0, Phase::Stable);
+        assert_eq!(get(&b, "k").await.unwrap(), b"v");
+        assert_eq!(get(&b, "k2").await.unwrap(), b"w");
+        assert!(m.fresh().await.is_err());
+        // m's further maintenance writes nothing (it is superseded)
+        let rep = m.repair(1 << 30).await;
+        assert_eq!(rep, RepairReport::default());
+        nets[0].offline(false);
+    }
