+        assert_eq!(nets[1].load().await.unwrap().idx.lock().await.ceiling, ceiling, "r1 now holds it too");
+
+        // a reservation whose pin is answered nowhere in time fails (no versions are stamped in it) ...
+        let solo = Net::on_disk(85);
