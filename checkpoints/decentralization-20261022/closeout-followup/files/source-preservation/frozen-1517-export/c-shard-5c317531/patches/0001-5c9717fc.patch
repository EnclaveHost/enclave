+        eprintln!("starter results: {b1:?} / {b2:?}; reballots {reballots}");
+        for c in [&c1, &c2] {
+            if c.superseded().is_none() && c.ballot().is_some() {
+                settle(c).await;
+                maintain(c).await;
+            }
+        }
+        // whatever the interleaving: at most one of them can confirm, and at most one put-if-absent succeeds
+        let f1 = c1.fresh().await.is_ok();
+        let f2 = c2.fresh().await.is_ok();
