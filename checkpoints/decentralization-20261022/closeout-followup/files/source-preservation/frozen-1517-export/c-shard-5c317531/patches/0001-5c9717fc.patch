+    async fn c2_negative_control_without_the_nonce_both_identical_writes_settle_as_applied() {
+        // what G-C2 R2 fixes, reproduced: operation ids from the copied RNG alone (no nonce). Both first answers lost,
+        // both copies settle by replaying byte-identical operations, and BOTH are answered "replayed": two client
+        // requests would both get 200. The first-send rule cannot see this (both settlements are replays).
+        let nets = [Net::new(1)];
+        let c = c2_booted(&nets).await;
+        let s = c.store(0).unwrap();
+        let obj = s.upload(Rc::from(&b"identical"[..])).await.unwrap();
+        let sealed = obj.seal(&nets[0].key);
+        let p = copied_sdk(&nets, &s.sdk).await;
+        let q = copied_sdk(&nets, &s.sdk).await;
+        p.c2_test_force_next_op([5; 16]);
+        q.c2_test_force_next_op([5; 16]);
+        nets[0].net.push_fault("pin_object", Fault::Defer);
+        nets[0].net.push_fault("pin_object", Fault::Defer);
+        let both = tokio::time::timeout(Duration::from_secs(1), async { tokio::join!(p.c2_test_pin_sealed(&sealed), q.c2_test_pin_sealed(&sealed)) }).await;
+        assert!(both.is_err());
+        assert_eq!(nets[0].net.apply_deferred(), 2);
+        assert!(matches!(p.c2_check().await.unwrap(), sia_storage::fence::C2Check::Confirmed(_)));
+        assert!(matches!(q.c2_check().await.unwrap(), sia_storage::fence::C2Check::Confirmed(_)), "the hole the nonce closes");
+    }
+
+    #[tokio::test]
+    async fn c2_one_invocation_copied_after_its_nonce_is_one_operation() {
+        // the boundary: a copy taken AFTER an invocation fetched its nonce (the operation is in flight) continues that
+        // SAME invocation; both copies settle it as applied, and it is applied once
+        let nets = [Net::new(1)];
+        let c = c2_booted(&nets).await;
+        let s = c.store(0).unwrap();
+        let h = s.sdk.c2_head().unwrap();
+        let obj = s.upload(Rc::from(&b"in flight"[..])).await.unwrap();
+        nets[0].net.push_fault("pin_object", Fault::ApplyThenLose);
+        assert!(s.sdk.c2_test_pin_sealed(&obj.seal(&nets[0].key)).await.is_err(), "sent with its nonce-derived id; answer lost");
+        let snap = copied_sdk(&nets, &s.sdk).await; // the copy holds the same unknown outcome (same id, same bytes)
+        assert!(matches!(s.sdk.c2_check().await.unwrap(), sia_storage::fence::C2Check::Confirmed(_)));
+        assert!(matches!(snap.c2_check().await.unwrap(), sia_storage::fence::C2Check::Confirmed(_)));
+        assert_eq!(nets[0].net.c2_head().0, h + 1, "applied once");
+        // and an exact retry by ONE invocation alone is answered once too (legitimate lost-reply recovery is kept)
+        nets[0].net.push_fault("pin_object", Fault::ApplyThenLose);
+        let obj2 = s.upload(Rc::from(&b"retry"[..])).await.unwrap();
+        assert!(s.sdk.c2_test_pin_sealed(&obj2.seal(&nets[0].key)).await.is_err());
+        assert!(matches!(s.sdk.c2_check().await.unwrap(), sia_storage::fence::C2Check::Confirmed(_)));
+        assert_eq!(nets[0].net.c2_head().0, h + 2);
+    }
+}
+
diff --git a/sia-s3/src/s3.rs b/sia-s3/src/s3.rs
new file mode 100644
index 0000000000000000000000000000000000000000..a74466aa860038252cc3271c320fa19569450f7c
--- /dev/null
+++ b/sia-s3/src/s3.rs
@@ -0,0 +1,683 @@
+//! S3 request handling (path-style): the subset object stores are used for —
+//! buckets are fixed by config; objects, ranges, copy, multipart, ListObjectsV2.
+
+use std::rc::Rc;
+
+use tokio::io::AsyncWriteExt;
+use tokio::net::TcpStream;
+
+use crate::http::{Request, write_head};
+use crate::replica::Cluster;
+use crate::sigv4::{self, Verdict, percent_decode};
+use crate::store::Cond;
+
+pub struct App {
+    /// the indexers this app's data is replicated across (one for a 0.1.x config)
+    pub cluster: Rc<Cluster>,
+    pub buckets: Vec<String>,
+    pub credentials: Vec<(String, String)>,
+    pub region: String,
+    pub boot_error: std::cell::RefCell<Option<String>>,
+}
+
+struct Resp {
+    status: u16,
+    headers: Vec<(String, String)>,
+    body: Vec<u8>,
+}
+
+fn xml_escape(s: &str) -> String {
+    s.replace('&', "&amp;").replace('<', "&lt;").replace('>', "&gt;").replace('"', "&quot;").replace('\'', "&apos;")
+}
+
+fn xml(status: u16, body: String) -> Resp {
+    Resp {
+        status,
+        headers: vec![("Content-Type".into(), "application/xml".into())],
+        body: format!("<?xml version=\"1.0\" encoding=\"UTF-8\"?>\n{body}").into_bytes(),
+    }
+}
+
+fn err(status: u16, code: &str, msg: &str, resource: &str) -> Resp {
+    xml(
+        status,
+        format!(
+            "<Error><Code>{code}</Code><Message>{}</Message><Resource>{}</Resource></Error>",
+            xml_escape(msg),
+            xml_escape(resource)
+        ),
+    )
+}
+
+fn empty(status: u16) -> Resp {
+    Resp { status, headers: vec![], body: vec![] }
+}
+
+fn http_date(unix: i64) -> String {
+    chrono::DateTime::from_timestamp(unix, 0).unwrap_or_default().format("%a, %d %b %Y %H:%M:%S GMT").to_string()
+}
+
+fn iso_date(unix: i64) -> String {
+    chrono::DateTime::from_timestamp(unix, 0).unwrap_or_default().format("%Y-%m-%dT%H:%M:%S.000Z").to_string()
+}
+
+/// Map store errors onto S3 codes.
+fn store_err(e: String, resource: &str) -> Resp {
+    let code = e.split(':').next().unwrap_or("");
+    match code {
+        "NoSuchKey" => err(404, "NoSuchKey", "The specified key does not exist.", resource),
+        "NoSuchUpload" => err(404, "NoSuchUpload", "The specified upload does not exist.", resource),
+        "PreconditionFailed" => err(412, "PreconditionFailed", "At least one of the pre-conditions you specified did not hold", resource),
+        "InvalidPart" | "InvalidPartOrder" | "EntityTooLarge" => err(400, code, &e, resource),
+        // PATCH U1-B: a version an indexer's operator may have blocked (replica.rs, "Blocked objects", B3)
+        "UnavailableForLegalReasons" => err(451, "UnavailableForLegalReasons", &e, resource),
+        // a write quorum of indexers did not take the request (replica.rs)
+        "ServiceUnavailable" => {
+            eprintln!("[sia-s3] {resource}: {e}");
+            err(503, "ServiceUnavailable", &e, resource)
+        }
+        _ => {
+            eprintln!("[sia-s3] {resource}: {e}");
+            err(500, "InternalError", &e, resource)
+        }
+    }
+}
+
+/// Parse a single `bytes=` range against `size`: Ok(None) = whole object.
+fn parse_range(h: Option<&str>, size: u64) -> Result<Option<(u64, u64)>, ()> {
+    let Some(h) = h else { return Ok(None) };
+    let Some(spec) = h.trim().strip_prefix("bytes=") else { return Ok(None) };
+    if spec.contains(',') {
+        return Ok(None); // multi-range: serve the whole object, as S3 does
+    }
+    let (a, b) = spec.split_once('-').ok_or(())?;
+    let (start, end) = if a.is_empty() {
+        let n: u64 = b.parse().map_err(|_| ())?;
+        if n == 0 {
+            return Err(());
+        }
+        (size.saturating_sub(n), size.saturating_sub(1))
+    } else {
+        let s: u64 = a.parse().map_err(|_| ())?;
+        let e: u64 = if b.is_empty() { size.saturating_sub(1) } else { b.parse::<u64>().map_err(|_| ())?.min(size.saturating_sub(1)) };
+        (s, e)
+    };
+    if size == 0 || start >= size || end < start {
+        return Err(());
+    }
+    Ok(Some((start, end)))
+}
+
+fn tag_values(xml: &str, tag: &str) -> Vec<String> {
+    let (open, close) = (format!("<{tag}>"), format!("</{tag}>"));
+    let mut out = Vec::new();
+    let mut rest = xml;
+    while let Some(i) = rest.find(&open) {
+        let after = &rest[i + open.len()..];
+        let Some(j) = after.find(&close) else { break };
+        out.push(after[..j].trim().to_string());
+        rest = &after[j + close.len()..];
+    }
+    out
+}
+
+fn unescape(s: &str) -> String {
+    s.replace("&quot;", "\"").replace("&apos;", "'").replace("&lt;", "<").replace("&gt;", ">").replace("&amp;", "&")
+}
+
+/// Handle one request, writing the full response to `w`.
+pub async fn handle(app: &App, req: &Request, w: &mut TcpStream) -> std::io::Result<()> {
+    let ka = req.keep_alive;
+    if req.path == "/healthz" && req.method == "GET" {
+        let body = health(app).await;
+        let r = Resp { status: 200, headers: vec![("Content-Type".into(), "application/json".into())], body: body.into_bytes() };
+        return send(w, r, ka).await;
+    }
+    // A browser opening the endpoint gets the app's page instead of an S3 AccessDenied. Only UNSIGNED GETs of these
+    // three paths: anything signed (or any other path) is S3 as before, so no client ever sees HTML for an S3 call.
+    let signed = req.header("authorization").is_some() || req.query.contains("X-Amz-Signature");
+    if !signed && req.method == "GET" {
+        if let Some(r) = page(app, &req.path).await {
+            return send(w, r, ka).await;
+        }
+    }
+    let resource = req.path.clone();
+    match sigv4::verify(req, &app.credentials) {
+        Verdict::Ok => {}
+        Verdict::Denied(code, msg) => return send(w, err(403, code, &msg, &resource), ka).await,
+    }
+    let store = app.cluster.clone();
+    if !store.ready() {
+        let msg = store
+            .superseded()
+            .map(|w| format!("writer fencing stopped this instance: {w}"))
+            .or_else(|| app.boot_error.borrow().clone())
+            .unwrap_or_else(|| "index is loading".into());
+        return send(w, err(503, "SlowDown", &msg, &resource), ka).await;
+    }
+    // writer fencing: whatever this request is answered with (data, a listing, a 412, a 404, a DELETE of an absent key)
+    // must reflect every write acknowledged before it arrived, by any writer. A confirmation round started after
+    // this point must find our exact fence on W voters (Cluster::fresh); otherwise 503. No-op when unfenced.
+    if let Err(e) = store.fresh().await {
+        return send(w, err(503, "SlowDown", &e, &resource), ka).await;
+    }
+
+    let q = sigv4::parse_query(&req.query);
+    let qv = |k: &str| q.iter().find(|(a, _)| a == k).map(|(_, v)| v.as_str());
+    let has = |k: &str| q.iter().any(|(a, _)| a == k);
+
+    // signed diagnostics: can this deployment reach the Sia hosts it would upload to?
+    if req.path == "/" && has("sia-diag") && req.method == "GET" {
+        let limit = qv("limit").and_then(|v| v.parse().ok()).unwrap_or(60);
+        let secs = qv("timeout").and_then(|v| v.parse().ok()).unwrap_or(30);
+        // ?replica=<name> picks the indexer whose hosts are probed (default: the first loaded one)
+        let loaded = store.loaded();
+        let pick = loaded.iter().find(|(i, _)| qv("replica").is_none_or(|n| store.replicas[*i].name == n));
+        let body = match pick {
+            Some((_, s)) => crate::diag::run(s, limit, secs).await,
+            None => serde_json::json!({ "error": "no such loaded replica" }).to_string(),
+        };
+        let r = Resp { status: 200, headers: vec![("Content-Type".into(), "application/json".into())], body: body.into_bytes() };
+        return send(w, r, ka).await;
+    }
+
+    let path = req.path.trim_start_matches('/');
+    let (bucket_raw, key_raw) = path.split_once('/').unwrap_or((path, ""));
+    let bucket = percent_decode(bucket_raw);
+    let key = percent_decode(key_raw);
+
+    if bucket.is_empty() {
+        if req.method != "GET" {
+            return send(w, err(405, "MethodNotAllowed", "", &resource), ka).await;
+        }
+        let bs: String = app
+            .buckets
+            .iter()
+            .map(|b| format!("<Bucket><Name>{}</Name><CreationDate>2026-10-14T00:00:00.000Z</CreationDate></Bucket>", xml_escape(b)))
+            .collect();
+        return send(w, xml(200, format!("<ListAllMyBucketsResult><Owner><ID>sia-s3</ID></Owner><Buckets>{bs}</Buckets></ListAllMyBucketsResult>")), ka).await;
+    }
+    if !app.buckets.contains(&bucket) {
+        return send(w, err(404, "NoSuchBucket", "The specified bucket does not exist.", &resource), ka).await;
+    }
+
+    if key.is_empty() {
+        let r = match req.method.as_str() {
+            "HEAD" => empty(200),
+            "PUT" => empty(200), // buckets come from config; creating one that exists is a no-op
+            "GET" if has("location") => xml(200, format!("<LocationConstraint>{}</LocationConstraint>", xml_escape(&app.region))),
+            "GET" if has("versioning") => xml(200, "<VersioningConfiguration/>".into()),
+            "GET" if has("uploads") => list_uploads(&store, &bucket).await,
+            "GET" => list(&store, &bucket, &q).await,
+            "POST" if has("delete") => delete_many(&store, &bucket, &req.body).await,
+            _ => err(501, "NotImplemented", "bucket operation not supported", &resource),
+        };
+        return send(w, r, ka).await;
+    }
+
+    match req.method.as_str() {
+        "GET" | "HEAD" if !has("uploadId") => get(&store, req, &bucket, &key, w).await,
+        "PUT" if req.header("x-amz-copy-source").is_some() => {
+            let src = percent_decode(req.header("x-amz-copy-source").unwrap().trim_start_matches('/'));
+            let src = src.split('?').next().unwrap_or("").to_string();
+            let (sb, sk) = src.split_once('/').unwrap_or((&src, ""));
+            if !app.buckets.iter().any(|b| b == sb) || sk.is_empty() {
+                return send(w, err(400, "InvalidArgument", "bad x-amz-copy-source", &resource), ka).await;
+            }
+            let r = match store.copy((sb, sk), (&bucket, &key)).await {
+                Ok((etag, m)) => xml(200, format!("<CopyObjectResult><LastModified>{}</LastModified><ETag>\"{etag}\"</ETag></CopyObjectResult>", iso_date(m))),
+                Err(e) => store_err(e, &resource),
+            };
+            send(w, r, ka).await
+        }
+        "PUT" if has("uploadId") => {
+            let (Some(uid), Some(n)) = (qv("uploadId"), qv("partNumber").and_then(|n| n.parse::<u32>().ok())) else {
+                return send(w, err(400, "InvalidArgument", "uploadId and partNumber are required", &resource), ka).await;
+            };
+            if !(1..=10000).contains(&n) {
+                return send(w, err(400, "InvalidArgument", "partNumber must be 1-10000", &resource), ka).await;
+            }
+            let r = match store.upload_part(uid, n, req.body.clone()).await {
+                Ok(etag) => Resp { status: 200, headers: vec![("ETag".into(), format!("\"{etag}\""))], body: vec![] },
+                Err(e) => store_err(e, &resource),
+            };
+            send(w, r, ka).await
+        }
+        "PUT" => {
+            let ct = req.header("content-type").map(String::from);
+            // conditional writes (jot's and depot's compare-and-swap): If-None-Match: * creates only, If-Match an ETag
+            let cond = match (req.header("if-none-match"), req.header("if-match")) {
+                (Some(v), _) if v.trim() == "*" => Cond::IfNoneMatch,
+                (Some(_), _) => return send(w, err(501, "NotImplemented", "If-None-Match on PUT supports only *", &resource), ka).await,
+                (None, Some(t)) => Cond::IfMatch(t.trim().trim_start_matches("W/").trim_matches('"').to_string()),
+                (None, None) => Cond::None,
+            };
+            if let Some(rest) = req.stream {
+                let r = put_streamed(&store, req, &bucket, &key, ct, &cond, rest, w).await;
+                return send(w, r, false).await;
+            }
+            let r = match store.put(&bucket, &key, req.body.clone(), ct, &cond).await {
+                Ok(etag) => Resp { status: 200, headers: vec![("ETag".into(), format!("\"{etag}\""))], body: vec![] },
+                Err(e) => store_err(e, &resource),
+            };
+            send(w, r, ka).await
+        }
+        "POST" if has("uploads") => {
+            let r = match store.create_upload(&bucket, &key).await {
+                Ok(uid) => xml(200, format!(
+                    "<InitiateMultipartUploadResult><Bucket>{}</Bucket><Key>{}</Key><UploadId>{uid}</UploadId></InitiateMultipartUploadResult>",
+                    xml_escape(&bucket), xml_escape(&key)
+                )),
+                Err(e) => store_err(e, &resource),
+            };
+            send(w, r, ka).await
+        }
+        "POST" if has("uploadId") => {
+            let uid = qv("uploadId").unwrap_or("");
+            let body = String::from_utf8_lossy(&req.body).to_string();
+            let mut parts = Vec::new();
+            for p in tag_values(&body, "Part") {
+                let n = tag_values(&p, "PartNumber").first().and_then(|n| n.parse::<u32>().ok());
+                let t = tag_values(&p, "ETag").first().map(|t| unescape(t).trim_matches('"').to_string());
+                match (n, t) {
+                    (Some(n), Some(t)) => parts.push((n, t)),
+                    _ => return send(w, err(400, "MalformedXML", "bad CompleteMultipartUpload body", &resource), ka).await,
+                }
+            }
+            let r = match store.complete_upload(uid, &parts).await {
+                Ok((b, k, etag)) => xml(200, format!(
+                    "<CompleteMultipartUploadResult><Location>/{b}/{k}</Location><Bucket>{}</Bucket><Key>{}</Key><ETag>\"{etag}\"</ETag></CompleteMultipartUploadResult>",
+                    xml_escape(&b), xml_escape(&k)
+                )),
+                Err(e) => store_err(e, &resource),
+            };
+            send(w, r, ka).await
+        }
+        "DELETE" if has("uploadId") => {
+            let r = match store.abort_upload(qv("uploadId").unwrap_or("")).await {
+                Ok(()) => empty(204),
+                Err(e) => store_err(e, &resource),
+            };
+            send(w, r, ka).await
+        }
+        "DELETE" => {
+            let r = match store.delete(&bucket, &key).await {
+                Ok(()) => empty(204),
+                Err(e) => store_err(e, &resource),
+            };
+            send(w, r, ka).await
+        }
+        _ => send(w, err(501, "NotImplemented", "operation not supported", &resource), ka).await,
+    }
+}
+
+/// A single PUT too large to buffer: the body goes from the socket through a pipe into the Sia upload as it arrives,
+/// hashed on the way (MD5 = the ETag, SHA-256 = the signed payload hash, checked before anything is committed).
+#[allow(clippy::too_many_arguments)]
+async fn put_streamed(store: &Cluster, req: &Request, b: &str, k: &str, ct: Option<String>, cond: &Cond, rest: u64, w: &mut TcpStream) -> Resp {
+    use md5::{Digest as _, Md5};
+    use sha2::Sha256;
+    use tokio::io::{AsyncReadExt, AsyncWriteExt};
+    let resource = req.path.clone();
+    if let Err(e) = store.check(b, k, cond) {
+        return store_err(e, &resource);
+    }
+    let size = req.body.len() as u64 + rest;
+    let want_sha = req.header("x-amz-content-sha256").filter(|p| p.len() == 64).map(|p| p.to_ascii_lowercase());
+    let (mut tx, rx) = tokio::io::duplex(4 << 20);
+    let pump = async {
+        let (mut md5, mut sha) = (Md5::new(), Sha256::new());
+        md5.update(&req.body);
+        sha2::Digest::update(&mut sha, &req.body);
+        tx.write_all(&req.body).await?;
+        let mut n = req.body.len() as u64;
+        let mut buf = vec![0u8; 256 << 10];
+        while n < size {
+            let want = (size - n).min(buf.len() as u64) as usize;
+            let m = w.read(&mut buf[..want]).await?;
+            if m == 0 {
+                return Err(std::io::Error::new(std::io::ErrorKind::UnexpectedEof, format!("the body ended after {n} of {size} bytes")));
+            }
+            md5.update(&buf[..m]);
+            sha2::Digest::update(&mut sha, &buf[..m]);
+            tx.write_all(&buf[..m]).await?;
+            n += m as u64;
+        }
+        tx.shutdown().await?;
+        Ok::<_, std::io::Error>((hex::encode(md5.finalize()), hex::encode(sha2::Digest::finalize(sha))))
+    };
+    let (hashes, staged) = tokio::join!(pump, store.upload_reader(rx));
+    let staged = match staged {
+        Ok(o) => o,
+        Err(e) => return store_err(e, &resource),
+    };
+    let (etag, sha) = match hashes {
+        Ok(h) => h,
+        Err(e) => {
+            store.discard(staged).await;
+            return err(400, "IncompleteBody", &e.to_string(), &resource);
+        }
+    };
+    if want_sha.is_some_and(|w| w != sha) {
+        store.discard(staged).await;
+        return err(400, "XAmzContentSHA256Mismatch", "body does not match x-amz-content-sha256", &resource);
+    }
+    match store.commit(b, k, staged, etag.clone(), size, ct, cond).await {
+        Ok(()) => Resp { status: 200, headers: vec![("ETag".into(), format!("\"{etag}\""))], body: vec![] },
+        Err(e) => store_err(e, &resource),
+    }
+}
+
+async fn send(w: &mut TcpStream, r: Resp, ka: bool) -> std::io::Result<()> {
+    write_head(w, r.status, &r.headers, r.body.len() as u64, ka).await?;
+    if !r.body.is_empty() {
+        w.write_all(&r.body).await?;
+    }
+    w.flush().await
+}
+
+async fn get(store: &Cluster, req: &Request, bucket: &str, key: &str, w: &mut TcpStream) -> std::io::Result<()> {
+    let ka = req.keep_alive;
+    let resource = req.path.clone();
+    let Some(entry) = store.lookup(bucket, key) else {
+        let r = if req.method == "HEAD" { empty(404) } else { err(404, "NoSuchKey", "The specified key does not exist.", &resource) };
+        return send(w, r, ka).await;
+    };
+    // PATCH U1-B: a withheld version is neither read nor described (GET and HEAD alike), whatever replica holds it
+    if store.withheld(bucket, key, &entry.ver()) {
+        let r = if req.method == "HEAD" { empty(451) } else { store_err(crate::replica::WITHHELD.to_string(), &resource) };
+        return send(w, r, ka).await;
+    }
+    let size = entry.s;
+    // conditional reads: a resumed range must not stitch two versions together
+    let tag_matches = |h: &str| h.split(',').map(|t| t.trim().trim_start_matches("W/").trim_matches('"')).any(|t| t == "*" || t == entry.t);
+    if req.header("if-match").is_some_and(|h| !tag_matches(h)) {
+        return send(w, err(412, "PreconditionFailed", "At least one of the pre-conditions you specified did not hold", &resource), ka).await;
+    }
+    if req.header("if-none-match").is_some_and(tag_matches) {
+        let r = Resp { status: 304, headers: vec![("ETag".into(), format!("\"{}\"", entry.t))], body: vec![] };
+        return send(w, r, ka).await;
+    }
+    let range = match parse_range(req.header("range"), size) {
+        Ok(r) => r,
+        Err(()) => {
+            let mut r = err(416, "InvalidRange", "The requested range is not satisfiable", &resource);
+            r.headers.push(("Content-Range".into(), format!("bytes */{size}")));
+            return send(w, r, ka).await;
+        }
+    };
+    let (start, len) = match range {
+        Some((a, b)) => (a, b - a + 1),
+        None => (0, size),
+    };
+    if req.method != "HEAD" {
+        if let Err(e) = store.servable(&entry, start, len).await {
+            return send(w, store_err(e, &resource), ka).await;
+        }
+    }
+    let mut headers = vec![
+        ("ETag".to_string(), format!("\"{}\"", entry.t)),
+        ("Last-Modified".to_string(), http_date(entry.m)),
+        ("Accept-Ranges".to_string(), "bytes".to_string()),
+        ("Content-Type".to_string(), entry.c.clone().unwrap_or_else(|| "application/octet-stream".into())),
+    ];
+    let status = match range {
+        Some((a, b)) => {
+            headers.push(("Content-Range".into(), format!("bytes {a}-{b}/{}", entry.s)));
+            206
+        }
+        None => 200,
+    };
+    write_head(w, status, &headers, len, ka).await?;
+    if req.method == "HEAD" {
+        return w.flush().await;
+    }
+    // every replica holding this exact version is tried in turn, resuming where the last one stopped
+    match store.read(&entry, start, len, w).await {
+        Ok(_) => w.flush().await,
+        Err(e) => {
+            // the head is already out: the only honest signal left is a short body
+            eprintln!("[sia-s3] GET {resource}: download failed: {e}");
+            Err(std::io::Error::other(e))
+        }
+    }
+}
+
+async fn list(store: &Cluster, bucket: &str, q: &[(String, String)]) -> Resp {
+    let qv = |k: &str| q.iter().find(|(a, _)| a == k).map(|(_, v)| v.clone());
+    let v2 = qv("list-type").as_deref() == Some("2");
+    let prefix = qv("prefix").unwrap_or_default();
+    let delimiter = qv("delimiter").filter(|d| !d.is_empty());
+    let max = qv("max-keys").and_then(|m| m.parse::<usize>().ok()).unwrap_or(1000).min(1000);
+    let after = if v2 {
+        qv("continuation-token").map(|t| String::from_utf8(hex::decode(t).unwrap_or_default()).unwrap_or_default()).or(qv("start-after"))
+    } else {
+        qv("marker")
+    }
+    .unwrap_or_default();
+
+    let view = store.view.borrow();
+    let lo = (bucket.to_string(), if after > prefix { after.clone() } else { prefix.clone() });
+    let mut contents = String::new();
+    let mut prefixes: Vec<String> = Vec::new();
+    let mut count = 0;
+    let mut last = String::new();
+    let mut truncated = false;
+    for ((b, k), entry) in view.keys.range(lo..) {
+        if b != bucket || !k.starts_with(&prefix) {
+            break;
+        }
+        if k == &after {
+            continue;
+        }
+        if count == max {
+            truncated = true;
+            break;
+        }
+        if let Some(d) = &delimiter {
+            if let Some(i) = k[prefix.len()..].find(d.as_str()) {
+                let cp = k[..prefix.len() + i + d.len()].to_string();
+                if prefixes.last() != Some(&cp) {
+                    prefixes.push(cp);
+                    count += 1;
+                }
+                last = k.clone();
+                continue;
+            }
+        }
+        contents.push_str(&format!(
+            "<Contents><Key>{}</Key><LastModified>{}</LastModified><ETag>&quot;{}&quot;</ETag><Size>{}</Size><StorageClass>STANDARD</StorageClass></Contents>",
+            xml_escape(k),
+            iso_date(entry.m),
+            entry.t,
+            entry.s
+        ));
+        count += 1;
+        last = k.clone();
+    }
+    let cps: String = prefixes.iter().map(|p| format!("<CommonPrefixes><Prefix>{}</Prefix></CommonPrefixes>", xml_escape(p))).collect();
+    let mut body = format!(
+        "<ListBucketResult xmlns=\"http://s3.amazonaws.com/doc/2006-03-01/\"><Name>{}</Name><Prefix>{}</Prefix><MaxKeys>{max}</MaxKeys><IsTruncated>{truncated}</IsTruncated>",
+        xml_escape(bucket),
+        xml_escape(&prefix)
+    );
+    if let Some(d) = &delimiter {
+        body.push_str(&format!("<Delimiter>{}</Delimiter>", xml_escape(d)));
+    }
+    if v2 {
+        body.push_str(&format!("<KeyCount>{count}</KeyCount>"));
+        if let Some(t) = qv("continuation-token") {
+            body.push_str(&format!("<ContinuationToken>{}</ContinuationToken>", xml_escape(&t)));
+        }
+        if truncated {
+            body.push_str(&format!("<NextContinuationToken>{}</NextContinuationToken>", hex::encode(&last)));
+        }
+    } else if truncated {
+        body.push_str(&format!("<NextMarker>{}</NextMarker>", xml_escape(&last)));
+    }
+    body.push_str(&contents);
+    body.push_str(&cps);
+    body.push_str("</ListBucketResult>");
+    xml(200, body)
+}
+
+async fn list_uploads(store: &Cluster, bucket: &str) -> Resp {
+    let ups: String = store
+        .uploads()
+        .await
+        .into_iter()
+        .filter(|(_, b, _, _)| b == bucket)
+        .map(|(id, _, k, started)| format!("<Upload><Key>{}</Key><UploadId>{id}</UploadId><Initiated>{}</Initiated></Upload>", xml_escape(&k), iso_date(started)))
+        .collect();
+    xml(200, format!("<ListMultipartUploadsResult><Bucket>{}</Bucket><IsTruncated>false</IsTruncated>{ups}</ListMultipartUploadsResult>", xml_escape(bucket)))
+}
+
+async fn delete_many(store: &Cluster, bucket: &str, body: &[u8]) -> Resp {
+    let body = String::from_utf8_lossy(body).to_string();
+    let quiet = tag_values(&body, "Quiet").first().is_some_and(|q| q == "true");
+    let mut out = String::new();
+    for o in tag_values(&body, "Object") {
+        let Some(k) = tag_values(&o, "Key").first().map(|k| unescape(k)) else { continue };
+        match store.delete(bucket, &k).await {
+            Ok(()) if !quiet => out.push_str(&format!("<Deleted><Key>{}</Key></Deleted>", xml_escape(&k))),
+            Ok(()) => {}
+            Err(e) => {
+                let code = if e.starts_with("ServiceUnavailable") { "ServiceUnavailable" } else { "InternalError" };
+                out.push_str(&format!("<Error><Key>{}</Key><Code>{code}</Code><Message>{}</Message></Error>", xml_escape(&k), xml_escape(&e)))
+            }
+        }
+    }
+    xml(200, format!("<DeleteResult>{out}</DeleteResult>"))
+}
+
+const UI: &str = include_str!("ui.html");
+const LOGO: &str = include_str!("../assets/logo.svg");
+
+/// The public page and what it reads. The status is the in-memory index only (no Sia or indexer traffic, so loading
+/// the page costs nothing and cannot starve the egress front); it never includes keys, object names or credentials.
+async fn page(app: &App, path: &str) -> Option<Resp> {
+    let typed = |ct: &str, body: Vec<u8>, extra: &[(&str, &str)]| {
+        let mut headers: Vec<(String, String)> = vec![("Content-Type".into(), ct.into()), ("Cache-Control".into(), "no-store".into())];
+        headers.extend(extra.iter().map(|(k, v)| (k.to_string(), v.to_string())));
+        Resp { status: 200, headers, body }
+    };
+    match path {
+        "/" => Some(typed(
+            "text/html; charset=utf-8",
+            UI.as_bytes().to_vec(),
+            &[
+                (
+                    "Content-Security-Policy",
+                    "default-src 'none'; script-src 'unsafe-inline'; style-src 'unsafe-inline'; img-src 'self' blob: data:; \
+                     media-src blob:; frame-src blob:; connect-src 'self'; frame-ancestors 'none'; base-uri 'none'; form-action 'none'",
+                ),
+                ("Referrer-Policy", "no-referrer"),
+                ("X-Content-Type-Options", "nosniff"),
+            ],
+        )),
+        "/logo.svg" | "/favicon.ico" => Some(typed("image/svg+xml", LOGO.as_bytes().to_vec(), &[])),
+        "/api/status" => {
+            let c = app.cluster.clone();
+            let ready = c.ready();
+            let mut v = serde_json::json!({
+                "app": "sia-s3",
+                "version": env!("CARGO_PKG_VERSION"),
+                "indexer": c.replicas.iter().map(|r| r.indexer.as_str()).collect::<Vec<_>>().join(", "),
+                "region": app.region,
+                "ready": ready,
+                "bootError": *app.boot_error.borrow(),
+                "writeQuorum": c.write_quorum,
+                "readQuorum": c.read_quorum(),
+                "writerFence": c.fence_status(),
+                "withheldVersions": c.withheld_count(),
+                "replicas": c.replica_status().await,
+            });
+            if ready {
+                let buckets: Vec<_> = {
+                    let view = c.view.borrow();
+                    app.buckets
+                        .iter()
+                        .map(|b| {
+                            let (n, bytes) = view
+                                .keys
+                                .range((b.clone(), String::new())..)
+                                .take_while(|((kb, _), _)| kb == b)
+                                .fold((0u64, 0u64), |(n, t), (_, e)| (n + 1, t + e.s));
+                            serde_json::json!({ "name": b, "keys": n, "bytes": bytes })
+                        })
+                        .collect()
+                };
+                v["buckets"] = serde_json::json!(buckets);
+                let mut objects = 0;
+                for (_, s) in c.loaded() {
+                    objects += s.idx.lock().await.objs.len();
+                }
+                v["objects"] = serde_json::json!(objects);
+                v["openUploads"] = serde_json::json!(c.uploads().await.len());
+                v["replication"] = serde_json::json!(*c.stats.borrow());
+            } else {
+                v["buckets"] = serde_json::json!(app.buckets.iter().map(|b| serde_json::json!({ "name": b })).collect::<Vec<_>>());
+            }
+            Some(typed("application/json", v.to_string().into_bytes(), &[]))
+        }
+        _ => None,
+    }
+}
+
+async fn health(app: &App) -> String {
+    let c = app.cluster.clone();
+    if !c.ready() {
+        return serde_json::json!({
+            "app": concat!("sia-s3/", env!("CARGO_PKG_VERSION")),
+            "ready": false,
+            "error": *app.boot_error.borrow(),
+            "writerFence": c.fence_status(),
+            "withheldVersions": c.withheld_count(),
+            "replicas": c.replica_status().await,
+        })
+        .to_string();
+    }
+    let (mut objects, mut unpacked) = (0, 0);
+    for (_, s) in c.loaded() {
+        let idx = s.idx.lock().await;
+        objects += idx.objs.len();
+        unpacked += idx.objs.values().filter(|(o, m)| !m.p && o.size() <= s.compact_max_object).count();
+    }
+    let (keys, bytes) = {
+        let view = c.view.borrow();
+        (view.keys.len(), view.keys.values().map(|e| e.s).sum::<u64>())
+    };
+    let compactor = c.loaded().first().map(|(_, s)| serde_json::json!(*s.stats.borrow()));
+    serde_json::json!({
+        "writerFence": c.fence_status(),
+        "withheldVersions": c.withheld_count(),
+        "app": concat!("sia-s3/", env!("CARGO_PKG_VERSION")),
+        "ready": true,
+        "keys": keys,
+        "objects": objects,
+        "openUploads": c.uploads().await.len(),
+        "smallUnpacked": unpacked,
+        "bytes": bytes,
+        "compactor": compactor,
+        "writeQuorum": c.write_quorum,
+        "readQuorum": c.read_quorum(),
+        "replication": *c.stats.borrow(),
+        "replicas": c.replica_status().await,
+    })
+    .to_string()
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn ranges() {
+        assert_eq!(parse_range(Some("bytes=0-99"), 1000), Ok(Some((0, 99))));
+        assert_eq!(parse_range(Some("bytes=900-"), 1000), Ok(Some((900, 999))));
+        assert_eq!(parse_range(Some("bytes=-100"), 1000), Ok(Some((900, 999))));
+        assert_eq!(parse_range(Some("bytes=990-2000"), 1000), Ok(Some((990, 999))));
+        assert!(parse_range(Some("bytes=1000-"), 1000).is_err());
+        assert_eq!(parse_range(None, 10), Ok(None));
+    }
+}
diff --git a/sia-s3/src/sigv4.rs b/sia-s3/src/sigv4.rs
new file mode 100644
index 0000000000000000000000000000000000000000..cfbf96360e1376065ffb13a2cb458549c3f213ee
--- /dev/null
+++ b/sia-s3/src/sigv4.rs
@@ -0,0 +1,182 @@
+//! AWS Signature V4 verification (header form) for incoming S3 requests.
+//!
+//! The canonical request is rebuilt from the bytes the client sent: the path
+//! verbatim (S3 does not double-encode), the query re-normalised, the signed
+//! headers, and the client's `x-amz-content-sha256`. When that header is a hex
+//! digest the body must hash to it; `UNSIGNED-PAYLOAD` is accepted (the request
+//! line and headers stay signed). Streaming (aws-chunked) payloads are refused.
+
+use hmac::{Hmac, Mac};
+use sha2::{Digest, Sha256};
+
+use crate::http::Request;
+
+type HmacSha256 = Hmac<Sha256>;
+
+const MAX_SKEW_SECS: i64 = 15 * 60;
+
+fn hmac(key: &[u8], data: &[u8]) -> Vec<u8> {
+    let mut m = HmacSha256::new_from_slice(key).expect("hmac takes any key length");
+    m.update(data);
+    m.finalize().into_bytes().to_vec()
+}
+
+/// AWS URI encoding: unreserved characters stay, everything else is %XX.
+pub fn aws_encode(s: &str) -> String {
+    let mut out = String::with_capacity(s.len());
+    for b in s.bytes() {
+        if b.is_ascii_alphanumeric() || matches!(b, b'-' | b'_' | b'.' | b'~') {
+            out.push(b as char);
+        } else {
+            out.push_str(&format!("%{b:02X}"));
+        }
+    }
+    out
+}
+
+pub fn percent_decode(s: &str) -> String {
+    let b = s.as_bytes();
+    let mut out = Vec::with_capacity(b.len());
+    let mut i = 0;
+    while i < b.len() {
+        if b[i] == b'%' && i + 2 < b.len() {
+            if let Some(v) = std::str::from_utf8(&b[i + 1..i + 3]).ok().and_then(|h| u8::from_str_radix(h, 16).ok()) {
+                out.push(v);
+                i += 3;
+                continue;
+            }
+        }
+        // '+' stays literal: S3 clients encode spaces as %20
+        out.push(b[i]);
+        i += 1;
+    }
+    String::from_utf8_lossy(&out).into_owned()
+}
+
+/// Query pairs, decoded.
+pub fn parse_query(raw: &str) -> Vec<(String, String)> {
+    raw.split('&')
+        .filter(|p| !p.is_empty())
+        .map(|p| match p.split_once('=') {
+            Some((k, v)) => (percent_decode(k), percent_decode(v)),
+            None => (percent_decode(p), String::new()),
+        })
+        .collect()
+}
+
+fn canonical_query(raw: &str) -> String {
+    let mut pairs: Vec<(String, String)> = parse_query(raw)
+        .into_iter()
+        .map(|(k, v)| (aws_encode(&k), aws_encode(&v)))
+        .collect();
+    pairs.sort();
+    pairs.iter().map(|(k, v)| format!("{k}={v}")).collect::<Vec<_>>().join("&")
+}
+
+pub enum Verdict {
+    Ok,
+    Denied(&'static str, String),
+}
+
+/// Parse `AWS4-HMAC-SHA256 Credential=AK/DATE/REGION/s3/aws4_request, SignedHeaders=a;b, Signature=hex`.
+fn parse_auth(v: &str) -> Option<(String, String, String, String, Vec<String>, String)> {
+    let rest = v.strip_prefix("AWS4-HMAC-SHA256")?.trim();
+    let (mut cred, mut signed, mut sig) = (None, None, None);
+    for part in rest.split(',') {
+        let part = part.trim();
+        if let Some(c) = part.strip_prefix("Credential=") {
+            cred = Some(c.to_string());
+        } else if let Some(s) = part.strip_prefix("SignedHeaders=") {
+            signed = Some(s.split(';').map(|h| h.to_ascii_lowercase()).collect::<Vec<_>>());
+        } else if let Some(s) = part.strip_prefix("Signature=") {
+            sig = Some(s.to_ascii_lowercase());
+        }
+    }
+    let cred = cred?;
+    let mut it = cred.split('/');
+    let (ak, date, region, service, term) = (it.next()?, it.next()?, it.next()?, it.next()?, it.next()?);
+    if service != "s3" || term != "aws4_request" {
+        return None;
+    }
+    Some((ak.to_string(), date.to_string(), region.to_string(), service.to_string(), signed?, sig?))
+}
+
+pub fn verify(req: &Request, credentials: &[(String, String)]) -> Verdict {
+    let Some(auth) = req.header("authorization") else {
+        return Verdict::Denied("AccessDenied", "requests must be signed (SigV4)".into());
+    };
+    let Some((ak, date, region, _svc, signed, sig)) = parse_auth(auth) else {
+        return Verdict::Denied("AuthorizationHeaderMalformed", "unsupported Authorization header".into());
+    };
+    let Some(secret) = credentials.iter().find(|(id, _)| *id == ak).map(|(_, s)| s) else {
+        return Verdict::Denied("InvalidAccessKeyId", "unknown access key".into());
+    };
+    let Some(amz_date) = req.header("x-amz-date") else {
+        return Verdict::Denied("AccessDenied", "missing x-amz-date".into());
+    };
+    let Ok(when) = chrono::NaiveDateTime::parse_from_str(amz_date, "%Y%m%dT%H%M%SZ") else {
+        return Verdict::Denied("AccessDenied", "bad x-amz-date".into());
+    };
+    if (chrono::Utc::now().naive_utc() - when).num_seconds().abs() > MAX_SKEW_SECS {
+        return Verdict::Denied("RequestTimeTooSkewed", "x-amz-date is more than 15 minutes off".into());
+    }
+    if !amz_date.starts_with(&date) {
+        return Verdict::Denied("AccessDenied", "credential date does not match x-amz-date".into());
+    }
+    let payload = req.header("x-amz-content-sha256").unwrap_or("");
+    match payload {
+        "UNSIGNED-PAYLOAD" => {}
+        // a streamed body is hashed as it arrives and compared at its end (s3.rs), before anything is committed
+        p if p.len() == 64 && p.bytes().all(|c| c.is_ascii_hexdigit()) => {
+            if req.stream.is_none() && hex::encode(Sha256::digest(&req.body)) != p.to_ascii_lowercase() {
+                return Verdict::Denied("XAmzContentSHA256Mismatch", "body does not match x-amz-content-sha256".into());
+            }
+        }
+        _ => return Verdict::Denied("NotImplemented", "x-amz-content-sha256 must be a hex digest or UNSIGNED-PAYLOAD (no aws-chunked)".into()),
+    }
+    if !signed.iter().any(|h| h == "host") {
+        return Verdict::Denied("AccessDenied", "host must be signed".into());
+    }
+
+    let mut canon_headers = String::new();
+    for h in &signed {
+        let v = req.header(h).unwrap_or("");
+        let v = v.split_whitespace().collect::<Vec<_>>().join(" ");
+        canon_headers.push_str(&format!("{h}:{v}\n"));
+    }
+    let canonical = format!(
+        "{}\n{}\n{}\n{}\n{}\n{}",
+        req.method,
+        req.path,
+        canonical_query(&req.query),
+        canon_headers,
+        signed.join(";"),
+        payload
+    );
+    let scope = format!("{date}/{region}/s3/aws4_request");
+    let to_sign = format!("AWS4-HMAC-SHA256\n{amz_date}\n{scope}\n{}", hex::encode(Sha256::digest(canonical.as_bytes())));
+    let k = hmac(format!("AWS4{secret}").as_bytes(), date.as_bytes());
+    let k = hmac(&k, region.as_bytes());
+    let k = hmac(&k, b"s3");
+    let k = hmac(&k, b"aws4_request");
+    let expect = hex::encode(hmac(&k, to_sign.as_bytes()));
+    // constant-time compare
+    let ok = expect.len() == sig.len() && expect.bytes().zip(sig.bytes()).fold(0u8, |a, (x, y)| a | (x ^ y)) == 0;
+    if ok {
+        Verdict::Ok
+    } else {
+        Verdict::Denied("SignatureDoesNotMatch", "signature does not match".into())
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn encodes_like_aws() {
+        assert_eq!(aws_encode("a b/c~d"), "a%20b%2Fc~d");
+        assert_eq!(canonical_query("uploads"), "uploads=");
+        assert_eq!(canonical_query("prefix=pins%2F&list-type=2"), "list-type=2&prefix=pins%2F");
+    }
+}
