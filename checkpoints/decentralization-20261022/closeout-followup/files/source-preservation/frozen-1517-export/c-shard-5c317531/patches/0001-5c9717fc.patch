+        nets[2].net.push_fault("fence_raise", Fault::ApplyThenFail);
+        let (c, r) = fenced(&nets, &all(3), 2, lease_policy(5), None).await;
+        r.unwrap();
+        maintain(&c).await;
+        assert!(c.ready() && c.store(2).is_none(), "installed but without a receipt: not used");
+        let sdk = nets[2].net.sdk(nets[2].key.clone()).await.unwrap();
+        let e = c.fence_join(2, sdk, 8 << 20, opts()).await.unwrap_err();
+        assert!(e.contains("refused"), "{e}");
+        assert!(c.superseded().is_none(), "our own unknown raise is not another writer");
+        c.put("b", "k", b"v".to_vec(), None, &Cond::None).await.unwrap();
+        c.fresh().await.unwrap();
+    }
