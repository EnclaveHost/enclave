+        assert!(!(p1 && p2), "both creates succeeded");
+        assert!(p1 || p2, "one of them is the writer");
+        let winner = if p1 { &c1 } else { &c2 };
+        assert!(winner.fresh().await.is_ok());
+        for n in &nets {
+            assert_eq!(n.net.installed_fence(), winner.ballot());
+        }
+    }
