+    #[sia_core_derive::cross_target_test]
+    fn test_slab_pin_params_digest() {
+        for version in [SlabVersion::V0, SlabVersion::V1] {
+            let slab = Slab {
+                version,
+                encryption_key: [1u8; 32].into(),
+                min_shards: 1,
+                sectors: vec![Sector {
+                    root: Hash256::new([2u8; 32]),
+                    host_key: PublicKey::new([3u8; 32]),
+                }],
+                offset: 123,
+                length: 456,
