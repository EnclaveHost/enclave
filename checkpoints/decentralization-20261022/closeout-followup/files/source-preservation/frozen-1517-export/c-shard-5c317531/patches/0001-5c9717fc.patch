+        assert!(c.forked_out(0).is_none(), "our own delayed request is not a fork");
+        // r0 holds only the tentative phase 1: maintenance re-reads it, removes the leftover and copies the commit
+        maintain(&c).await;
+        assert_eq!(tentative_left(&nets).await, vec![0, 0, 0]);
