+    async fn c2_a_reused_operation_id_with_another_mutation_is_never_acknowledged() {
+        let nets = [Net::new(1)];
+        let c = c2_booted(&nets).await;
+        let s = c.store(0).unwrap();
+        let a = s.upload(Rc::from(&b"object A"[..])).await.unwrap();
+        let b = s.upload(Rc::from(&b"object B"[..])).await.unwrap();
+        let h = s.sdk.c2_head().unwrap();
+        // the writer sends "pin A" with operation id X at head h; copies of its memory are taken while the answer is
+        // outstanding (same credential, same head h, same pending operation)
+        let x: [u8; 16] = [7; 16];
+        s.sdk.c2_test_pending_pin(&a, x);
+        let copy = || async {
+            let c = nets[0].net.sdk(nets[0].key.clone()).await.unwrap();
+            c.set_fence_credential(s.sdk.fence_credential());
+            c.c2_copy_state_from(&s.sdk);
+            c
+        };
+        let identical = copy().await;
+        let other_body = copy().await;
+        other_body.c2_test_pending_pin(&b, x); // X reused (a copied RNG) for ANOTHER body
+        let other_method = copy().await;
+        other_method.c2_test_pending_delete(a.id(), x); // X reused for a DELETE
+        // the original settles: "pin A" is applied at h
+        assert!(matches!(s.sdk.c2_check().await.unwrap(), sia_storage::fence::C2Check::Confirmed(_)));
+        assert_eq!(nets[0].net.c2_head().0, h + 1);
+        let st = s.sdk.fence_state().await.unwrap();
+        assert_eq!((st.last_op, st.seq), (Some(x), Some(h + 1)));
+        // reusing X with another body or method is refused (412 op), latched as a fork, and nothing is applied
+        for (what, sdk) in [("another body", &other_body), ("another method", &other_method)] {
+            let r = sdk.c2_check().await.unwrap();
+            assert!(matches!(r, sia_storage::fence::C2Check::Forked(_)), "{what}: {r:?}");
+            assert!(sdk.c2_forked().is_some());
+            assert_eq!(nets[0].net.c2_head().0, h + 1, "{what}: nothing applied");
+        }
+        // negative control: the IDENTICAL operation replayed is answered as applied, once
+        assert!(matches!(identical.c2_check().await.unwrap(), sia_storage::fence::C2Check::Confirmed(_)));
+        assert_eq!(identical.c2_head(), Some(h + 1));
+        assert_eq!(nets[0].net.c2_head().0, h + 1);
+    }
