+#[derive(Debug, Error)]
+pub enum ProofValidationError {
+    #[error("Invalid proof length")]
+    InvalidProofLength,
+
+    #[error("Invalid proof root")]
+    InvalidProofRoot,
+
+    #[error("IO error: {0}")]
+    Io(#[from] io::Error),
+
+    #[error("The proof data is not segment aligned")]
+    NotSegmentAligned,
+}
+
+impl Clone for ProofValidationError {
+    fn clone(&self) -> Self {
+        match self {
+            Self::InvalidProofLength => Self::InvalidProofLength,
+            Self::InvalidProofRoot => Self::InvalidProofRoot,
+            Self::Io(e) => Self::Io(io::Error::new(e.kind(), e.to_string())),
+            Self::NotSegmentAligned => Self::NotSegmentAligned,
+        }
+    }
+}
