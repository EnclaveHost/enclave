diff --git a/fixture/shardloss.sh b/fixture/shardloss.sh
new file mode 100755
index 0000000000000000000000000000000000000000..f9480069db67807d15fd87e33cd29ea384e23ea3
--- /dev/null
+++ b/fixture/shardloss.sh
@@ -0,0 +1,17 @@
+#!/bin/bash
+# shardloss.sh <run-id>: assemble shardloss.py (storage-write-release's interop16 helpers _base.py, read-only and pinned,
+# + main_shardloss.py) and run it in PRIVATE network + PID namespaces as uid 1000. ONE claude-test-queue allocation (1536).
+set -euo pipefail
+here=$(cd "$(dirname "$0")" && pwd)
+id=${1:?run-id}
+[[ "$id" =~ ^[a-z0-9]{1,12}$ ]] || { echo "run-id: [a-z0-9]{1,12}"; exit 2; }
+base="$here/../../storage-write-release/rehearsal/_base.py"
+[ "$(sha256sum "$base" | cut -c1-64)" = bd92f094f88ee7bf0e005171ac5d26d6fdd3879ef3bf9c707271cd15fa361b6b ] || { echo "_base.py pin mismatch"; exit 2; }
+{ printf '#!/usr/bin/env python3\n"""shardloss.py: GENERATED by shardloss.sh from storage-write-release/rehearsal/_base.py + main_shardloss.py."""\n'
+  cat "$base" "$here/main_shardloss.py"; } > "$here/shardloss.py"
+mkdir -p "$here/runs"
+export SHARDLOSS_FIXED="$here/../artifacts/candidate-55888a41.wasm"
+export SHARDLOSS_FIXED_SHA256=55888a41033c5c913f64adc7dc601d314cbe387b377445a23e5475643bea7918
+sha256sum "$base" "$here/main_shardloss.py" "$here/shardloss.py" "$SHARDLOSS_FIXED"
+exec unshare -rn --pid --fork --kill-child --mount-proc sh -c \
+  'ip link set lo up && exec unshare -U --map-user=1000 --map-group=1000 python3 -u -B "$0" "$1"' "$here/shardloss.py" "$id"
diff --git a/run-suite.sh b/run-suite.sh
new file mode 100755
index 0000000000000000000000000000000000000000..3a89fbee22c5dedc62484d336622679017a63347
--- /dev/null
+++ b/run-suite.sh
@@ -0,0 +1,20 @@
+#!/bin/bash
+# run-suite.sh <label>: (copy of storage-clone-privacy-review/candidate/run-suite.sh) the whole sia-s3 test suite (ignored tests stay ignored; the fork cases are in run-cases.sh),
+# ONE test per fresh process, sequentially, so peak memory is one test's. Each test's start is logged before it runs.
+cd "$(dirname "$0")" || exit 2
+label=$1
+./cargo-step.sh test --no-run || exit 3
+bin=$(grep -o "Executable unittests src/main.rs ([^)]*)" logs/cargo-last.out | tail -1 | sed 's/.*(\(.*\))/\1/')
+sha256sum "$bin"
+mkdir -p "logs/$label"
+pass=0; fail=0; ign=0
+for t in $("$bin" --list 2>/dev/null | grep ": test$" | sed 's/: test$//' | grep -v "^clone_privacy::\|clone_privacy_a_refused"); do
+  echo "start $t" >> "logs/$label/progress.txt"
+  timeout -k 5 900 "$bin" --exact "$t" --test-threads=1 > "logs/$label/$t.out" 2>&1
+  rc=$?
+  if grep -q "1 ignored" "logs/$label/$t.out"; then ign=$((ign+1)); r=ignored
+  elif [ $rc -eq 0 ]; then pass=$((pass+1)); r=ok; else fail=$((fail+1)); r="FAILED rc=$rc"; fi
+  echo "$t $r" | tee -a "logs/$label/progress.txt"
+done
+echo "suite: passed=$pass failed=$fail ignored=$ign"
+[ $fail -eq 0 ]
