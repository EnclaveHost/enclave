index 5a15a48b36abb7ea6cf9b396a5c320198dd48a6e..bfc77a18380b557ff3b6f213656db904e2185880 100644
--- a/network/public-rpc-config.mjs
+++ b/network/public-rpc-config.mjs
@@ -7,18 +7,20 @@
 // the browser note's methods (NOTE-BROWSER-RPC-ENDPOINT-REQUIREMENTS.md) plus the explicit raw submission; the server's
 // parameter checks must cover exactly these (network/public-rpc.mjs asserts it at load)
 export const SERVED_METHODS = Object.freeze(['eth_chainId', 'eth_blockNumber', 'eth_getBlockByNumber', 'eth_call', 'eth_estimateGas', 'eth_getCode', 'eth_getBalance',
-  'eth_getTransactionCount', 'eth_getStorageAt', 'eth_getLogs', 'eth_getTransactionReceipt', 'eth_getTransactionByHash', 'eth_sendRawTransaction']);
+  'eth_getTransactionCount', 'eth_getStorageAt', 'eth_getLogs', 'eth_getTransactionReceipt', 'eth_getTransactionByHash', 'eth_sendRawTransaction',
+  // consumer interface (root interface reviews): a witness gateway's proof/header source, a wallet broadcast's tip quote
+  'eth_getProof', 'eth_getBlockByHash', 'eth_maxPriorityFeePerGas']);
 const HASH = /^0x[0-9a-fA-F]{64}$/;
 // what the local verifier can answer from proofs at a pinned block (network/verified-chain.mjs pinnedClient)
 export const VERIFIABLE_METHODS = Object.freeze(['eth_chainId', 'eth_blockNumber', 'eth_getBlockByNumber', 'eth_call', 'eth_getCode', 'eth_getStorageAt', 'eth_getBalance']);
 // refused by NAME (never forwarded): node administration, debugging, wallets, signing, mempool and server-side filters
-export const FORBIDDEN = /^(admin|debug|personal|miner|txpool|clique|engine|parity|trace|ots|anvil|hardhat|evm|wallet|rpc)_|^eth_(sign|signTransaction|signTypedData.*|sendTransaction|accounts|coinbase|mining|hashrate|submitWork|submitHashrate|getWork|newFilter|newBlockFilter|newPendingTransactionFilter|getFilterChanges|getFilterLogs|uninstallFilter|subscribe|unsubscribe|getProof|createAccessList|simulateV1|callMany)$/;
+export const FORBIDDEN = /^(admin|debug|personal|miner|txpool|clique|engine|parity|trace|ots|anvil|hardhat|evm|wallet|rpc)_|^eth_(sign|signTransaction|signTypedData.*|sendTransaction|accounts|coinbase|mining|hashrate|submitWork|submitHashrate|getWork|newFilter|newBlockFilter|newPendingTransactionFilter|getFilterChanges|getFilterLogs|uninstallFilter|subscribe|unsubscribe|createAccessList|simulateV1|callMany)$/;
 const plain = (o) => !!o && typeof o === 'object' && !Array.isArray(o);
 const fail = (m) => { throw new Error(`public-rpc: ${m}`); };
 const SECRETISH = /(secret|token|password|passwd|private|mnemonic|seed|apikey|api_key|auth|hmac|credential|key$|keyfile)/i;
 const FIELDS = ['port', 'bind', 'hostId', 'chainId', 'node', 'chainVerifier', 'verifiedMethods', 'allowedOrigins', 'maxHeadAgeSec', 'rawTransactions', 'limits'];
 const LIMITS = Object.freeze({ maxBodyBytes: [1024, 1 << 20, 128 << 10], maxResponseBytes: [64 << 10, 16 << 20, 4 << 20], backendTimeoutMs: [500, 30000, 6000],
-  maxInFlight: [1, 256, 16], perSecond: [1, 10000, 50], burst: [1, 20000, 100], maxLogRange: [1, 10000, 2000] });
+  maxInFlight: [1, 256, 16], perSecond: [1, 10000, 50], burst: [1, 20000, 100], maxLogRange: [1, 10000, 2000], maxProofKeys: [1, 1024, 128] });
 
 function loopbackUrl(v, what) {
   let e; try { e = rpcEndpoint(v); } catch (x) { fail(`${what}: ${x.message}`); }
diff --git a/network/public-rpc.mjs b/network/public-rpc.mjs
index 998c9a4312248d3ec21d1fac8e5eab915dd9b5ff..1e51f4d8133fd9e9498a435b995dfd4f0d74e6f4 100644
--- a/network/public-rpc.mjs
+++ b/network/public-rpc.mjs
@@ -16,7 +16,13 @@
 //   - bounds: request body, response size, one backend deadline, in-flight requests and an aggregate token bucket (the
 //     ingress hands every connection over loopback, so per-client limits are the exits' and the ingress's);
 //   - CORS: only the configured dashboard origins (or "*" written explicitly), POST with content-type only, never
-//     credentials; no redirect is followed or sent.
+//     credentials; no redirect is followed or sent;
+//   - consumer interface (root interface reviews): eth_getProof (bounded storage keys) and eth_getBlockByHash (headers
+//     only) as PROOF MATERIAL for a consumer that verifies it against its own authenticated root (B's witness gateway:
+//     roots from a signed head, never from this endpoint); eth_getTransactionCount at "pending" only (the node's mempool
+//     view, for a wallet's next nonce) and eth_maxPriorityFeePerGas (the node's tip quote). Every answer names its kind in
+//     X-Enclave-Rpc-Class: chain-state | proof-material-unverified | mempool-unverified | fee-quote-unverified | submission.
+//     Nothing here is labelled verified because of its method name.
 // The role holds no key, no secret and no wallet. It is not indexed: no EnclaveServiceIndex kind names an RPC endpoint, so
 // browsers reach it only through a profile that lists its URL.
 //   node network/public-rpc.mjs <config.json>     prints {"type":"ready","port":N}
@@ -34,7 +40,8 @@
 class ParamError extends Error {}
 const bad = (m) => { throw new ParamError(m); };
 const block = (v, { tagsOnly = false } = {}) => {
-  if (typeof v === 'string') { if (TAGS.has(v) || QTY.test(v)) return; bad('block must be a hex number, latest, earliest, safe or finalized (pending is not served)'); }
+  // a bare 32-byte hash is a block HASH (alloy's BlockId serialization without requireCanonical); a number is at most 16 digits
+  if (typeof v === 'string') { if (TAGS.has(v) || QTY.test(v) || (!tagsOnly && HASH.test(v))) return; bad('block must be a hex number, a block hash, latest, earliest, safe or finalized (pending is not served)'); }
   if (!tagsOnly && plain(v)) {                                   // EIP-1898
     const keys = Object.keys(v);
     if (keys.includes('blockHash')) { if (!HASH.test(String(v.blockHash)) || keys.some((k) => !['blockHash', 'requireCanonical'].includes(k)) || (v.requireCanonical !== undefined && typeof v.requireCanonical !== 'boolean')) bad('{blockHash, requireCanonical?}'); return; }
@@ -53,6 +60,16 @@
     if (t === 'qty' ? !(typeof x === 'string' && QTY.test(x)) : t === 'hex' ? !(typeof x === 'string' && HEX.test(x)) : (t(x, k), false)) bad(`invalid ${k}`);
   }
 }
+// eth_getProof storage keys: 1-64 hex digits each, distinct, at most limits.maxProofKeys
+function storageKeys(k, limits) {
+  if (!Array.isArray(k) || k.length > limits.maxProofKeys) bad(`storage keys: a list of at most ${limits.maxProofKeys}`);
+  const seen = new Set();
+  for (const x of k) {
+    if (typeof x !== 'string' || !/^0x[0-9a-fA-F]{1,64}$/.test(x)) bad('each storage key must be a hex word');
+    const n = BigInt(x).toString(16);
+    if (seen.has(n)) bad('storage keys repeat'); seen.add(n);
+  }
+}
 const arity = (p, lo, hi) => { if (!Array.isArray(p) || p.length < lo || p.length > hi) bad(`expects ${lo === hi ? lo : `${lo} to ${hi}`} parameters`); };
 function logFilter(f, limits, head) {
   if (!plain(f)) bad('the filter must be an object');
@@ -78,13 +95,29 @@
   eth_estimateGas: (p) => { arity(p, 1, 2); tx(p[0]); if (p.length === 2) block(p[1]); },
   eth_getCode: (p) => { arity(p, 2, 2); addr(p[0]); block(p[1]); },
   eth_getBalance: (p) => { arity(p, 2, 2); addr(p[0]); block(p[1]); },
-  eth_getTransactionCount: (p) => { arity(p, 2, 2); addr(p[0]); block(p[1]); },
+  // 'pending' only here: the operator's node's own mempool view (a wallet's next nonce), labelled mempool-unverified
+  eth_getTransactionCount: (p) => { arity(p, 2, 2); addr(p[0]); if (p[1] !== 'pending') block(p[1]); },
   eth_getStorageAt: (p) => { arity(p, 3, 3); addr(p[0]); if (typeof p[1] !== 'string' || !/^0x[0-9a-fA-F]{1,64}$/.test(p[1])) bad('slot must be a hex word'); block(p[2]); },
   eth_getLogs: (p, ctx) => { arity(p, 1, 1); logFilter(p[0], ctx.limits, ctx.head); },
   eth_getTransactionReceipt: (p) => { arity(p, 1, 1); hash(p[0]); },
   eth_getTransactionByHash: (p) => { arity(p, 1, 1); hash(p[0]); },
   eth_sendRawTransaction: (p) => { arity(p, 1, 1); if (typeof p[0] !== 'string' || !HEX.test(p[0]) || p[0].length < 4) bad('a signed raw transaction (hex)'); },
+  // proof material for a consumer that verifies it against ITS OWN authenticated root (a witness gateway, a light client):
+  // the node's answer, unchecked here, labelled proof-material-unverified
+  eth_getProof: (p, ctx) => { arity(p, 3, 3); addr(p[0]); storageKeys(p[1], ctx.limits); block(p[2]); },
+  // a header by hash (ancestry); full transaction objects are not served
+  eth_getBlockByHash: (p) => { arity(p, 2, 2); hash(p[0]); if (p[1] !== false) bad('full transaction objects are not served (pass false)'); },
+  // the node's own tip suggestion (a fee quote, not a chain fact)
+  eth_maxPriorityFeePerGas: (p) => arity(p, 0, 0),
 };
+/** What kind of answer this is, said in X-Enclave-Rpc-Class: never "verified" (a consumer verifies proof material itself). */
+export function answerClass(method, params) {
+  if (method === 'eth_getProof' || method === 'eth_getBlockByHash') return 'proof-material-unverified';
+  if (method === 'eth_getTransactionCount' && Array.isArray(params) && params[1] === 'pending') return 'mempool-unverified';
+  if (method === 'eth_maxPriorityFeePerGas') return 'fee-quote-unverified';
+  if (method === 'eth_sendRawTransaction') return 'submission';
+  return 'chain-state';
+}
 if (Object.keys(METHODS).join() !== SERVED_METHODS.join()) throw new Error('public-rpc: the parameter checks and SERVED_METHODS differ');
 
 /**
@@ -132,7 +165,7 @@
   const send = (res, status, body, { origin = null, source = null, extra = {} } = {}) => {
     const h = { 'content-type': 'application/json', 'cache-control': 'no-store', 'x-content-type-options': 'nosniff', 'x-enclave-rpc-host': cfg.hostId, ...extra };
     if (source) h['x-enclave-rpc-source'] = source;
-    if (origin) Object.assign(h, { 'access-control-allow-origin': origin, vary: 'Origin', 'access-control-expose-headers': 'x-enclave-rpc-source, x-enclave-rpc-host' });
+    if (origin) Object.assign(h, { 'access-control-allow-origin': origin, vary: 'Origin', 'access-control-expose-headers': 'x-enclave-rpc-source, x-enclave-rpc-host, x-enclave-rpc-class' });
     res.writeHead(status, h); res.end(typeof body === 'string' ? body : JSON.stringify(body));
   };
   const rpcError = (reqId, code, message, data) => ({ jsonrpc: '2.0', id: reqId ?? null, error: { code, message, ...(data !== undefined ? { data } : {}) } });
@@ -199,7 +232,7 @@
         return send(res, e.tooLarge ? 502 : e.name === 'TimeoutError' ? 504 : 503, rpcError(reqId, -32002, `${what} ${e.tooLarge ? 'answered more than this endpoint returns' : e.name === 'TimeoutError' ? `did not answer within ${L.backendTimeoutMs} ms` : 'is unavailable'}; nothing was answered${viaVerifier ? ' (verified methods never fall back to the node)' : ''}`),
           { origin: allowed, source: viaVerifier ? 'verifier' : 'node' });
       }
-      const extra = method === 'eth_sendRawTransaction' ? { 'x-enclave-rpc-propagation': 'operator-stated' } : {};
+      const extra = { 'x-enclave-rpc-class': answerClass(method, params), ...(method === 'eth_sendRawTransaction' ? { 'x-enclave-rpc-propagation': 'operator-stated' } : {}) };
       return send(res, 200, out.error ? { jsonrpc: '2.0', id: reqId ?? null, error: out.error } : { jsonrpc: '2.0', id: reqId ?? null, result: out.result },
         { origin: allowed, source: viaVerifier ? 'verifier' : 'node', extra });
     } finally { inFlight--; }
