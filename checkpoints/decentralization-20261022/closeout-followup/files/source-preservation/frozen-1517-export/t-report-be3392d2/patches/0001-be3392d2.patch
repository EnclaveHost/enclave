index 0000000000000000000000000000000000000000..c12ce4f048663c7e05c40f25e2478d85a9c5ff0f
--- /dev/null
+++ b/itest/consumer.py
@@ -0,0 +1,72 @@
+#!/usr/bin/env python3
+"""STAND-IN for a node process (NOT reth, Lighthouse or Base). It runs under the GENERATED node unit (drop-in replaces only
+ExecStart), as that unit's User=, with its sandbox, Type=notify and dependencies.
+
+Behaviour on I/O errors: it logs them and KEEPS RUNNING. It deliberately does not exit, so the test shows whether the
+SUPERVISION (the bound watch unit) stops it. No claim is made here about how the real clients react to EIO.
+
+  consumer.py <tag> <datadir>
+    writes <datadir>/standin/<seq>.bin (512 KiB, content derived from seq), fsyncs it and the directory, then records seq
+    in LAST (fsynced). After 30 files it keeps rewriting `tick` (4 KiB + fsync) every 0.5 s, so I/O is in flight when the
+    export is lost.
+"""
+import hashlib
+import os
+import socket
+import sys
+import time
+
+tag, datadir = sys.argv[1], sys.argv[2]
+d = os.path.join(datadir, "standin")
+
+
+def say(m):
+    print(f"standin[{tag}] {m}", flush=True)
+
+
+def notify(msg):
+    a = os.environ.get("NOTIFY_SOCKET")
+    if a:
+        a = "\0" + a[1:] if a.startswith("@") else a
+        with socket.socket(socket.AF_UNIX, socket.SOCK_DGRAM) as s:
+            s.connect(a); s.sendall(msg.encode())
+
+
+def content(n):
+    return hashlib.sha256(f"{tag}:{n}".encode()).digest() * (512 * 1024 // 32)
+
+
+def fsync_dir(p):
+    fd = os.open(p, os.O_RDONLY)
+    try:
+        os.fsync(fd)
+    finally:
+        os.close(fd)
+
+
+os.makedirs(d, exist_ok=True)
+try:
+    last = int(open(os.path.join(d, "LAST")).read())
+except (OSError, ValueError):
+    last = 0
+say(f"start uid={os.getuid()} datadir={datadir} last={last}")
+notify("READY=1")
+n = last
+while True:
+    try:
+        if n < last + 30 and n < 200:
+            n += 1
+            with open(os.path.join(d, f"{n:06d}.bin"), "wb") as f:
+                f.write(content(n)); f.flush(); os.fsync(f.fileno())
+            fsync_dir(d)
+            with open(os.path.join(d, "LAST.tmp"), "w") as f:
+                f.write(str(n)); f.flush(); os.fsync(f.fileno())
+            os.replace(os.path.join(d, "LAST.tmp"), os.path.join(d, "LAST"))
+            fsync_dir(d)
+            say(f"synced {n}")
+        else:
+            with open(os.path.join(d, "tick"), "wb") as f:
+                f.write(os.urandom(4096)); f.flush(); os.fsync(f.fileno())
+    except OSError as e:
+        say(f"IOERROR at seq {n}: {type(e).__name__} errno={e.errno} {e.strerror}; continuing (stand-in does not exit on EIO)")
+    time.sleep(0.5)
diff --git a/itest/guest/build-initramfs.sh b/itest/guest/build-initramfs.sh
new file mode 100755
index 0000000000000000000000000000000000000000..1068d18c56ea58062ec9d35b563b055b1bf5ecef
--- /dev/null
+++ b/itest/guest/build-initramfs.sh
@@ -0,0 +1,19 @@
+#!/bin/bash
+# Guest initramfs: bash, insmod, mount and friends with their libraries, plus the GUEST kernel package's 9p and virtio-net
+# modules (decompressed). Adapted from the transport repo's test/guest/build-initramfs.sh (a9f0155c). Output: $1.
+set -euo pipefail
+OUT=$1; KV=$2; HERE=$(cd "$(dirname "$0")" && pwd)
+W=$(mktemp -d); trap 'rm -rf "$W"' EXIT INT TERM HUP
+mkdir -p $W/{bin,usr/bin,lib64,usr/lib,mod,proc,sys,dev,newroot}
+for b in bash insmod mount umount mkdir ln chroot sed tee sync sleep echo printf chmod cp; do
+  p=$(command -v $b) || continue; [ "$p" = "$b" ] && continue
+  cp -L "$p" $W/usr/bin/; for l in $(ldd "$p" | grep -oE '/[^ ]+\.so[^ ]*'); do cp -Ln "$l" $W/usr/lib/ 2>/dev/null || true; done
+done
+ln -s ../usr/bin/bash $W/bin/sh; ln -s ../usr/bin/bash $W/bin/bash
+cp -L /lib64/ld-linux-x86-64.so.2 $W/lib64/
+for m in netfs 9pnet 9pnet_virtio 9p failover net_failover virtio_net; do
+  f=$(find /usr/lib/modules/$KV -name "$m.ko.zst" | head -1); [ -n "$f" ] || { echo "module $m missing" >&2; exit 3; }
+  zstd -q -d -c "$f" > $W/mod/$m.ko
+done
+cp "$HERE/init" $W/init; chmod 755 $W/init
+(cd $W && find . -print0 | cpio --null -o -H newc --quiet) | gzip -1 > "$OUT"
