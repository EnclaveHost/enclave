+NETWORK_LAYOUT = 'network-hdd-nbd'
+TRANSPORT_FORMAT = 'enclave-rpc-hdd-nbd/v1'
+PLACEMENT_KEYS = ('caCertSha256', 'exportName', 'fstype', 'imageBytes', 'imagePath', 'mountTarget', 'requireRotational',
+                  'serverCertSha256')
+
+
+def canonical_json(o):
+    return json.dumps(o, sort_keys=True, separators=(',', ':')).encode()
+
+
+def validate_network_origin(o, role=None):
+    """The origin is NOT a local file: it is the enclave-rpc-hdd transport's authenticated NBD export of a NEW image file
+    on the desktop HDD, attached RAW (hddattach.py attach) and verified at every assemble (hddattach.py verify-attached).
+    `placement` is the attach config's placement block, copied from the export host's placement.json and REVIEWED: it is
+    the export host's own statement from its mount table and sysfs (not cryptographic proof of physical media), pinned
+    here by digest. A statement without requireRotational: true is refused; there is no "any network disk" mode."""
+    only('storage.origin', o, ['transport', 'role', 'attachConfig', 'device', 'placement', 'bytes', 'filesystemUuid'],
+         ['transport', 'role', 'attachConfig', 'device', 'placement', 'bytes'])
+    if o['transport'] != TRANSPORT_FORMAT:
+        fail(f'storage.origin.transport must be {TRANSPORT_FORMAT}')
+    if o['role'] not in ('base', 'l1') or (role and o['role'] != role):
+        fail(f"storage.origin.role must be {role or 'base or l1'} (the L1 and Base exports are never shared)")
+    r = o['role']
+    if not re.fullmatch(r'/dev/nbd[0-9]{1,2}', str(o['device'])):
+        fail('storage.origin.device must be /dev/nbdN (the attach config\'s device)')
+    nbytes = integer('storage.origin.bytes', o['bytes'], 1_500_000_000_000, 30_000_000_000_000)
+    pl = o['placement']
+    only('storage.origin.placement', pl, PLACEMENT_KEYS, PLACEMENT_KEYS)
+    if pl['exportName'] != f'enclave-rpc-{r}' or pl['imageBytes'] != nbytes:
+        fail(f'storage.origin.placement must be the enclave-rpc-{r} export of exactly storage.origin.bytes')
+    if pl['requireRotational'] is not True:
+        fail('storage.origin.placement.requireRotational must be true: the export host must have found its backing disk '
+             'rotational; a fixture or SSD/NVMe-backed export is refused')
+    if pl['fstype'] not in ('ntfs3', 'ext4', 'xfs'):
+        fail('storage.origin.placement.fstype must be the HDD filesystem the export host checked (ntfs3, ext4 or xfs)')
+    mt = abspath('storage.origin.placement.mountTarget', pl['mountTarget'])
+    ip = abspath('storage.origin.placement.imagePath', pl['imagePath'])
+    if mt == '/' or not ip.startswith(mt.rstrip('/') + '/') or os.path.basename(ip) != f'{r}-origin.img':
+        fail(f'storage.origin.placement.imagePath must be {r}-origin.img under the HDD mount target')
+    for k in ('serverCertSha256', 'caCertSha256'):
+        if not re.fullmatch(r'[0-9a-f]{64}', str(pl[k])):
+            fail(f'storage.origin.placement.{k} must be the 64-hex fingerprint from the export host')
+    u = o.get('filesystemUuid')
+    if u is not None and not re.fullmatch(r'[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}', str(u)):
+        fail('storage.origin.filesystemUuid must be null (before the one first format) or the filesystem UUID')
+    return {'transport': TRANSPORT_FORMAT, 'role': r, 'attachConfig': abspath('storage.origin.attachConfig', o['attachConfig']),
+            'device': o['device'], 'placement': dict(pl), 'placementSha256': hashlib.sha256(canonical_json(pl)).hexdigest(),
+            'bytes': nbytes, 'filesystemUuid': u}
+
+
