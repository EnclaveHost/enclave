+def network_placement(c, leaves, watch_cfg):
+    """Network-HDD placement. Inside the VM the nbd device's queue/rotational says nothing about the desktop's media
+    (measured: 0), and it is never overridden. Instead, ALL of these must hold:
+      - the datadir resolves to exactly the configured origin nbd device (plus, when cached, only non-rotational cache
+        leaves);
+      - the attach config's placement statement is the pinned, reviewed one;
+      - the supervisor's full check passes (owned attach, mapping, mount, ext4 errors, a direct origin read).
+    This is an authenticated, operator-configured statement by the export host, NOT cryptographic proof of physical
+    media. It needs root (the attach state is root-only)."""
+    import subprocess
+    o = c['storage']['origin']
+    nbd = os.path.basename(o['device'])
+    names = [l['device'] for l in leaves]
+    if c['storage']['cache']['mechanism'] == 'none':
+        if names != [nbd]:
+            fail(f'datadir must resolve to exactly the network origin {nbd}; backing: {leaves}')
+    elif nbd not in names or any(l['rotational'] for l in leaves if l['device'] != nbd):
+        fail(f'a cached network datadir must resolve to the origin {nbd} plus non-rotational cache leaves only; backing: {leaves}')
+    try:
+        pl = json.loads(Path(o['attachConfig']).read_text())['placement']
+    except (OSError, ValueError, KeyError) as e:
+        fail(f'cannot read the attach config placement: {e}')
+    if hashlib.sha256(canonical_json(pl)).hexdigest() != o['placementSha256']:
+        fail('the attach config placement statement is not the pinned, reviewed one')
+    r = subprocess.run(['/usr/bin/python3', '-I', HDD_TOOLS + '/hddwatch.py', 'check', watch_cfg], capture_output=True, text=True, timeout=180)
+    if r.returncode != 0:
+        fail(f'network-HDD supervision check failed: {r.stdout.strip()[-300:]}')
+    return (f"network placement: {o['placement']['exportName']} ({o['placementSha256'][:16]}), leaves {names}; "
+            'export-host statement, not cryptographic proof of media')
+
+
