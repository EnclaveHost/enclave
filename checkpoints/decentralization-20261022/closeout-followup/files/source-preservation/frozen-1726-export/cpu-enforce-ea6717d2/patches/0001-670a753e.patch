+/** What a compliant host reads back after the processor-allocation script (CMD.processor) it was given. */
+export function processorAnswer(script, over = {}) {
+  const cw = script.match(/\$cpuWant = @\{q=(\d+); l=(\d+); r=(\d+)\}/) || [null, "0", "0", "0"];
+  const [q, l, r] = cw.slice(1).map(Number);
