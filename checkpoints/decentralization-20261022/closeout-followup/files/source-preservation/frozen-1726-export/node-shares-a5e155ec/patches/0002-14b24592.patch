+  const h = box({ isolationManager: `http://127.0.0.1:${m.port}` }, logs);
+  h.records.set(DEP, { id: DEP, status: "running", isolation: { instance: r0.instance.id } });
+  noSecrets(h);
+  await h.refreshManagerView();
