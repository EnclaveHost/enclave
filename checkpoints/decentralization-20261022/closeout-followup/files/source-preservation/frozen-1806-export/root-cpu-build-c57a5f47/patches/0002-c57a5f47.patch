+assert ids(before)==ids(after)
+out={'at':datetime.datetime.now(datetime.timezone.utc).isoformat(),'status':'Native Windows launcher build passed; staged only, not activated','sourceCommit':build['commit'],'sourceFiles':18,'sourceZipSha256':json.loads((p/'native-loader-source.json').read_text())['zipSha256'],'binarySha256':build['sha256'],'binaryBytes':build['bytes'],'nativeBuild':{'mode':'offline, locked, release, one job; existing nightly MSVC and SDK','exit':0,'verifiedAt':r['at'],'coldBuildSeconds':49.09,'coldPeakTreeBytes':309899264,'coldMinimumFreeBytes':26454904832,'incrementalConfirmSeconds':0.27,'incrementalSampling':'Finished before 2-second sample; raw peak0/min1e12 are sentinel values, not observations'},'attempts':['Detached guard ended with SSH session before build entered; no compiler ran.','First synchronous Cargo build finished but guard misread null PowerShell Process.ExitCode.','Corrected command exit receipt confirms exit0; multiline result needed independent compact readback.'],'production':{'checkedAt':after['at'],'runningApps':sum(d['status']=='running' for d in after['deployments']),'sameManagerVMIdsAndStates':True,'availability':after['availability'],'installedLauncherChanged':False,'guestImageChanged':False,'managerChanged':False},'remaining':['Guest image build and provenance/compatibility review','Combined native app canary: actual CPU allowance, TLS, secret handling and restart','Reviewed manager/image/launcher rollout and app recovery'],'custody':'Preparatory source/record audit only; no new production custody test or activation yet.'}
+(p/'NATIVE-LOADER-RESULT.json').write_text(json.dumps(out,indent=2)+'\n')
