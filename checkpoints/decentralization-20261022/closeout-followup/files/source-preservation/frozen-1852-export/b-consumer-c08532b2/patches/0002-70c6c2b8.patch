+  assert.throws(() => loadLeaseGasConfig({ env: { ...env, ENCLAVE_CHAIN_VERIFIER: 'https://mainnet.base.org/' }, chain: base, ledger: fixture.ledger, registry: fixture.registry, readFile }),
