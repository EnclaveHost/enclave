 network/chain-authority.mjs                | 29 +++++++++++++++++++-
 supervisor.js                              |  2 +-
 test/chain-authority.test.mjs              | 32 ++++++++++++++++++++++
 4 files changed, 63 insertions(+), 3 deletions(-)

