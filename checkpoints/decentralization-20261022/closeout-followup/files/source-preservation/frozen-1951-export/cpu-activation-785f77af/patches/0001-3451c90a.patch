+      $masterSha = (ShaOf $master);
+      ${guestStateMasterSha256 ? `$pin = ${q(guestStateMasterSha256)}; if ($masterSha -ne $pin) { throw ('the guest-state master hashes ' + $masterSha + ', not the pinned ' + $pin) };` : ""}
