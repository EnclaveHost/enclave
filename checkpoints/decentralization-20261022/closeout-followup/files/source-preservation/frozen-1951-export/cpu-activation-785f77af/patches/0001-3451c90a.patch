+        grants=@($grants)} | ConvertTo-Json -Compress -Depth 4
+    } catch {
+      $err = $_;
+      $victims = @();
+      if ($vm) { $victims = @($vm) } else { $victims = @(Get-VM -Name $name -EA SilentlyContinue | Where-Object { [string]::IsNullOrWhiteSpace([string]$_.Notes) -or ${OWNED("$_")} }) };
