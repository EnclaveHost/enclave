+r=h.ps(r'''$p='C:\ProgramData\Enclave\hotfix\cpu-quota-20261023';$m=Get-Content ($p+'\manifest.json') -Raw|ConvertFrom-Json;$old=[IO.File]::ReadAllText($m.config.path);$new=[IO.File]::ReadAllText($p+'\prepared\shield-config.cmd');$keys=@('ENCLAVE_GUEST_IGVM','ENCLAVE_GUEST_IGVM_SHA256','ENCLAVE_WMISERVE_EXE','ENCLAVE_WMISERVE_EXE_SHA256','ENCLAVE_GUEST_CPU_ALLOWANCE');$values=@{};foreach($k in $keys){$pat='(?m)^set '+[regex]::Escape($k)+'=([^\r\n]*)\r?\n?';$match=[regex]::Matches($new,$pat);if($match.Count -ne 1){throw ('Expected one '+$k)};$values[$k]=$match[0].Groups[1].Value;$old=[regex]::Replace($old,$pat,'');$new=[regex]::Replace($new,$pat,'')};if($old -cne $new){throw 'Unrelated configuration changed'};if($values.ENCLAVE_GUEST_IGVM -ne $m.image.live -or $values.ENCLAVE_GUEST_IGVM_SHA256 -ne $m.image.sha256 -or $values.ENCLAVE_WMISERVE_EXE -ne $m.loader.live -or $values.ENCLAVE_WMISERVE_EXE_SHA256 -ne $m.loader.sha256 -or $values.ENCLAVE_GUEST_CPU_ALLOWANCE -ne '1'){throw 'New configuration values mismatch'};$a=Get-Content $m.policy.path -Raw|ConvertFrom-Json;$b=Get-Content ($p+'\prepared\admitted-shield-policy.json') -Raw|ConvertFrom-Json;$entry=@($b.images|Where-Object {$_.measurement -eq $m.policy.newMeasurement});if($entry.Count -ne 1){throw 'New policy entry count'};$entry[0].measurement=$m.policy.oldMeasurement;$want=@($a.images|Where-Object {$_.measurement -eq $m.policy.oldMeasurement})[0];if(($entry[0]|ConvertTo-Json -Depth 20 -Compress) -cne ($want|ConvertTo-Json -Depth 20 -Compress)){throw 'Policy flags changed'};$b.images=@($b.images|Select-Object -SkipLast 1);if(($a|ConvertTo-Json -Depth 20 -Compress) -cne ($b|ConvertTo-Json -Depth 20 -Compress)){throw 'Unrelated policy changed'};@{ok=$true;unrelatedConfigUnchanged=$true;originalPolicyUnchanged=$true;newValues=$values}|ConvertTo-Json -Depth 4 -Compress''',30)
