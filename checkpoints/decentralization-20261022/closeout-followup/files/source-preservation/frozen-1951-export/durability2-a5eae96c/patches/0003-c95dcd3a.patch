+    if (com.machines.length !== 1 || lc(D.machineHash(com.machines[0])) !== lc(D.machineHash(me))) return "the committee was created for another machine";
+    if (lc(hex0x(com.commitments)) !== lc(gi.args[2])) return "the committee's key differs from this machine's genesis key";
