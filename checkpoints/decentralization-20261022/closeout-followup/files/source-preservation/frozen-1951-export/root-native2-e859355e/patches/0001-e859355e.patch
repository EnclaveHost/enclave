+      if ([int64]$vssd.GuestFeatureSet -ne ${GUEST_FEATURE_SET}) { throw ('GuestFeatureSet reads back as 0x' + ('{0:x}' -f [int64]$vssd.GuestFeatureSet) + ', not 0x201') };
