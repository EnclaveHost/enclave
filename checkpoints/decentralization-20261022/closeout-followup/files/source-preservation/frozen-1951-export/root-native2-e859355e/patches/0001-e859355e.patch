+      $mod = ${q(hypervModule)}; $pin = ${q(hypervModuleSha256)};
+      $modSha = (ShaOf $mod);
+      if ($modSha -ne $pin) { throw ('the module that DEFINES the VM hashes ' + $modSha + ', not the pinned ' + $pin) };
