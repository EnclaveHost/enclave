+    ${ENUMERABLE}
+    $ErrorActionPreference = 'Stop'; ${SHA_OF}
+    $name = ${q(name)}; $gsf = ${q(guestStateRun)}; $fw = ${q(firmware)}; $pipe = ${q(pipe)};
