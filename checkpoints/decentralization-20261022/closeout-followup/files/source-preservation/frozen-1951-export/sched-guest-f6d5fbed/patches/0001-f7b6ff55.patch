+	endedCleanly(t, m, d)
+	// nothing was written to cgroup.kill, because the domain was known to be gone
+	if _, err := os.Stat(filepath.Join(d.cgroup, "cgroup.kill")); err == nil {
+		t.Fatal("a reaped domain must not be killed again")
+	}
+}
