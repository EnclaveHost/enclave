+chmod 700 "$L"
+say() { printf '%s %s\n' "$(date -u +%H:%M:%SZ)" "$*" | tee -a "$L/run.txt"; }
+PIDS=()
+LINKED_NM=""
+LABPINS="$ISO/m2/release/labpins"
+MODCOPY="$REPO/relay/.lab-secrets-release.mjs"
