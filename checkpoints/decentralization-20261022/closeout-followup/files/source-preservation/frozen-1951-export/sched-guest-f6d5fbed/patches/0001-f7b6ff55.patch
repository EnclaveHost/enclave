+probe initrd      6dd5deeb993d19d7bd916359b7e17817275142054f6674322f0677551cac9f0a  (production 0d14db23 + /probe.ko = memmarker.ko; NOT a production medium)
+probe UKI (box)   265de2cccef20022fec592e50b003293ed3512d7d00ff0d82d7087031cc45bfa  (WSL kernel 7fe3edb5; NOT a production medium)
