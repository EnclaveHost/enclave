+    else echo "FAIL the $role, from inside: $( [ -s "$d/root/probe-out/$role.frontuid" ] && grep -E '^BAD|^done|^uid' "$d/root/probe-out/$role.frontuid" | tr '\n' ' ' || echo "no report; console: $(tr '\n' ' ' < "$d/console.txt" | cut -c1-200)")"; rc=1; fi
