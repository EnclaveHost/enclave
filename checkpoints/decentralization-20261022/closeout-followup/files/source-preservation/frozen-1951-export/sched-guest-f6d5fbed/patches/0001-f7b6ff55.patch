+
+const haveCPUID = true
diff --git a/isolation/m3/monitor/cpuid_amd64.s b/isolation/m3/monitor/cpuid_amd64.s
new file mode 100644
index 0000000000000000000000000000000000000000..3c59020d6b723a1e364459c0584658aa599a9e3b
--- /dev/null
+++ b/isolation/m3/monitor/cpuid_amd64.s
@@ -0,0 +1,12 @@
+#include "textflag.h"
+
+// func cpuid(leaf, sub uint32) (eax, ebx, ecx, edx uint32)
+TEXT ·cpuid(SB), NOSPLIT, $0-24
+	MOVL leaf+0(FP), AX
+	MOVL sub+4(FP), CX
+	CPUID
+	MOVL AX, eax+8(FP)
+	MOVL BX, ebx+12(FP)
+	MOVL CX, ecx+16(FP)
+	MOVL DX, edx+20(FP)
+	RET
