+#!/usr/bin/env bash
+# The attested release, END TO END, on real SEV-SNP with SYNTHETIC config and secrets (a lab, not production).
+#
+#   a REAL per-app SNP guest (this tree's front, lab pins) --vsock 9444--> a LAB guestd's ticket service
