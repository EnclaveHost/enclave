+if [ -r "$MUSL/lib/musl-gcc.specs" ]; then
+  run_all "$here/dominit.c" "$here/app-seccomp.h" /usr/bin/gcc -specs "$MUSL/lib/musl-gcc.specs" -static; m=$?
