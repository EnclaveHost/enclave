 // certNameOK: <8 lowercase hex>.<zone>, the app-zone name shape (isolation/m2/front certs.go nameFromHostData), at
 // most 253 bytes, zone labels of lowercase letters, digits and hyphens.
+// cpuVMBoundMarker, in the measured platform directory, states that this image runs ONE app per partition whose CPU is
+// capped by its hypervisor (the per-app Hyper-V partition's exact processor Limit/Reservation): a domain loaded without
+// an explicit allocation then gets every online processor, so the partition's cap - not the catalog cpuPercent - is
+// what binds. An image without it keeps the catalog share exactly as before.
+const cpuVMBoundMarker = "cpu-vm-bound.enabled"
+
+// allocatedPolicy is a domain's share: the catalog's (EffectivePolicy: the hashed bundle wins), RAISED where the launcher
+// allocates more. Physical RAM and CPU are availability allocations, separate from the immutable catalog minimum in the
+// hashed bundle: the AppID and every report still name the bundle's own policy. An allocation may never go below that
+// minimum, and CPU (percent of one processor, cgroup cpu.max) never past the processors this guest has online, so one
+// the guest cannot honour is refused rather than ignored. With no CPU allocation on a VM-bound image (cpuVMBoundMarker)
+// the domain gets every online processor. The load answer states what was applied (cpuPercent, memMiB).
+func allocatedPolicy(manifest *contract.Manifest, req request, onlineCPUs int, vmBound bool) (contract.Policy, error) {
+	pol := contract.EffectivePolicy(manifest, contract.Request{CPU: req.CPU, MemMiB: req.MemMiB})
+	if manifest == nil {
+		return pol, nil
+	}
+	if req.MemMiB != 0 {
+		if req.MemMiB < pol.MemMiB || req.MemMiB > 1048576 {
+			return pol, fmt.Errorf("memory allocation is below the catalog minimum or outside host bounds")
+		}
+		pol.MemMiB = req.MemMiB
+	}
+	if req.CPU != 0 {
+		if req.CPU < pol.CPUPercent || req.CPU > onlineCPUs*100 {
+			return pol, fmt.Errorf("cpu allocation %d%% is below the catalog cpuPercent %d or above this guest's %d online processors",
+				req.CPU, pol.CPUPercent, onlineCPUs)
+		}
+		pol.CPUPercent = req.CPU
+	} else if vmBound && onlineCPUs*100 > pol.CPUPercent {
+		pol.CPUPercent = onlineCPUs * 100
+	}
+	return pol, nil
+}
+
 func certNameOK(n string) bool {
 	if len(n) > 253 || len(n) < 10 || n[8] != '.' {
 		return false
