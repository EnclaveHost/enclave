@@ -9,9 +9,10 @@
 	"enclave.host/isolation/contract"
 )
 
-// The launcher's CPU allocation RAISES a bundle domain's cgroup quota above the catalog cpuPercent, as its RAM allocation
-// raises memory.max; it never lowers the catalog minimum, never exceeds the processors online, and is never ignored.
-func TestCPUAllowanceRaisesCatalogShare(t *testing.T) {
+// The launcher's CPU allocation is the purchased share of the host, applied exactly: above the catalog cpuPercent (a
+// share of several processors) and BELOW it (a share smaller than one processor: 1% of 16 logical processors is 16% of
+// one), never past the processors online, never ignored. RAM keeps its catalog minimum.
+func TestCPUAllowanceIsThePurchasedShare(t *testing.T) {
 	man := &contract.Manifest{Policy: contract.Policy{CPUPercent: 100, MemMiB: 512, Vcpus: 1}}
 	ok := []struct {
 		req      request
@@ -19,16 +20,24 @@
 		cpu, mem int
 	}{
 		{request{}, 4, 100, 512},                          // nothing asked: the catalog's share, exactly as before
+		{request{CPU: 16, MemMiB: 983}, 1, 16, 983},       // 1% of 16 LPs: 16% of one processor, NOT the catalog's 100
+		{request{CPU: 32}, 1, 32, 512},                    // 2%
+		{request{CPU: 64}, 1, 64, 512},                    // 4%
+		{request{CPU: 1}, 1, 1, 512},                      // the cgroup's smallest quota (1 ms per 100 ms period)
 		{request{CPU: 336, MemMiB: 20643}, 4, 336, 20643}, // a 21% share of 16 VPs: 4 VPs at 84%
-		{request{CPU: 400}, 4, 400, 512},                  // every online processor
-		{request{CPU: 100}, 1, 100, 512},                  // the catalog share itself is always allowed
-		{request{CPU: 208}, 3, 208, 512},                  // 13%: 3 VPs at 69.333%, quota rounded UP so the VM cap binds
+		{request{CPU: 400}, 4, 400, 512},                  // 25%: every online processor
+		{request{CPU: 100}, 1, 100, 512},                  // 6.25%: one whole processor
+		{request{CPU: 208}, 3, 208, 512},                  // 13%: 2.08 processors
 	}
 	for _, c := range ok {
 		pol, err := allocatedPolicy(man, c.req, c.cpus, false)
 		if err != nil || pol.CPUPercent != c.cpu || pol.MemMiB != c.mem || pol.Vcpus != 1 {
 			t.Fatalf("%+v on %d CPUs: %+v %v", c.req, c.cpus, pol, err)
 		}
+		// an explicit allocation wins on a VM-bound image too
+		if pol, err := allocatedPolicy(man, c.req, c.cpus, true); c.req.CPU != 0 && (err != nil || pol.CPUPercent != c.cpu) {
+			t.Fatalf("VM-bound %+v on %d CPUs: %+v %v", c.req, c.cpus, pol, err)
+		}
 	}
 	if man.Policy.CPUPercent != 100 {
 		t.Fatalf("the hashed manifest's policy was changed: %+v", man.Policy)
@@ -36,7 +45,8 @@
 	for _, c := range []struct {
 		req  request
 		cpus int
-	}{{request{CPU: 16}, 16}, {request{CPU: -5}, 4}, {request{CPU: 401}, 4}, {request{CPU: 200}, 1}, {request{MemMiB: 256}, 4}} {
+	}{{request{CPU: -5}, 4}, {request{CPU: 401}, 4}, {request{CPU: 200}, 1}, {request{CPU: 101}, 1}, {request{CPU: 1601}, 16},
+		{request{MemMiB: 256}, 4}, {request{CPU: 16, MemMiB: 256}, 1}} {
 		if pol, err := allocatedPolicy(man, c.req, c.cpus, false); err == nil {
 			t.Fatalf("%+v on %d CPUs was accepted: %+v", c.req, c.cpus, pol)
 		}
diff --git a/isolation/m3/monitor/cpu_load_test.go b/isolation/m3/monitor/cpu_load_test.go
index 7631565dd8c133f81ba5e592b822aaa792ba4331..35794e2658e0fcad4ddba940cf426853824b6d62 100644
--- a/isolation/m3/monitor/cpu_load_test.go
+++ b/isolation/m3/monitor/cpu_load_test.go
@@ -76,9 +76,26 @@
 	}
 }
 
-func TestLoadRefusesAnAllocationBelowTheCatalogShare(t *testing.T) {
-	if d, cpuMax, err := loadWithCPU(t, 16); err == nil {
-		t.Fatalf("16%% under a catalog 100%% was loaded (cpuPercent %d, cpu.max %q) instead of refused", d.CPU, cpuMax)
+// A purchased share smaller than one processor reaches the domain's cgroup exactly: 1%, 2% and 4% of 16 logical
+// processors are 16%, 32% and 64% of one, under a catalog cpuPercent of 100. The pre-fix monitor refused them, so the
+// launcher could only leave such a domain at the catalog's whole processor (6.25% of the host for a 1% purchase).
+func TestLoadAppliesAPurchasedShareBelowOneProcessor(t *testing.T) {
+	for _, cpu := range []int{16, 32, 64} {
+		d, cpuMax, err := loadWithCPU(t, cpu)
+		if err != nil {
+			t.Fatalf("%d%% under a catalog 100%% was refused: %v", cpu, err)
+		}
+		ans, _ := json.Marshal(d)
+		want := strconv.Itoa(cpu*1000) + " 100000"
+		if d.CPU != cpu || cpuMax != want || !bytes.Contains(ans, []byte(`"cpuPercent":`+strconv.Itoa(cpu)+`,`)) {
+			t.Fatalf("asked %d: domain cpuPercent %d, cgroup cpu.max %q (want %q), answer %s", cpu, d.CPU, cpuMax, want, ans)
+		}
+	}
+}
+
+func TestLoadRefusesAnAllocationPastTheOnlineProcessors(t *testing.T) {
+	if d, cpuMax, err := loadWithCPU(t, runtime.NumCPU()*100+1); err == nil {
+		t.Fatalf("more than every online processor was loaded (cpuPercent %d, cpu.max %q) instead of refused", d.CPU, cpuMax)
 	}
 }
 
