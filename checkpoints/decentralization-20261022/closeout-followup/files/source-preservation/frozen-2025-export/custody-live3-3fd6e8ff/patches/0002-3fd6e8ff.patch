+import fs from 'node:fs';import {parseAbi,stringToHex} from 'viem';import {pinBlock,readMany} from '../lib/live.mjs';
+const ids=JSON.parse(fs.readFileSync(new URL('../../../outputs/decentralization-audit/nucbox-coupled-shares-production-20261023.json',import.meta.url))).shares.map(v=>v.deployment);
+ids.push('0x4e62e60da567ca6c0b35f818192813e082149e738ad27204b5f074ed8adc6c1e');
+const vaults=['0x0807c71768b458ca6de85f78ed71c17cfe8eb3ee','0xe48699b8401564aace7a814ae4569b67a3f7eef5'];
+const old=JSON.parse(fs.readFileSync(new URL('../evidence/relay-public-config.json',import.meta.url)));vaults[0]=old.publicEnvironment.CUSTODY_VAULT;
+const abi=parseAbi(['function beneficialOwnerOf(bytes32) view returns(address)','function policyOf(bytes32) view returns(address owner,uint64 policyRev,uint64 secretRev,bytes32 committeeId,bool paused,bytes rules)']);
+const block=await pinBlock(),rows=[];for(const vault of vaults){const r=await readMany(block,ids.flatMap(id=>[{address:vault,abi,functionName:'beneficialOwnerOf',args:[id]},{address:vault,abi,functionName:'policyOf',args:[id]}]));for(let i=0;i<ids.length;i++){const [owner,policyRev,secretRev,committeeId,paused]=r[2*i+1].value;rows.push({vault,id:ids[i],beneficialOwner:r[2*i].value,policyOwner:owner,policyRev,secretRev,committeeId,paused});}}
+const out={at:new Date().toISOString(),readOnly:true,block,scope:'Nine recovered NucBox apps plus known original v2 canary, in configured v1 and v2 vaults',rows,limits:['Known-ID reads only, not exhaustive policy event discovery. No secret rules or bundle bytes emitted. No policy or address-book change.']};const text=JSON.stringify(out,(_,v)=>typeof v==='bigint'?v.toString():v,2)+'\n';fs.writeFileSync(new URL('../evidence/factory-consumer-state.json',import.meta.url),text);console.log(JSON.stringify({at:out.at,checked:rows.length,nonzeroPolicies:rows.filter(r=>r.policyRev>0).map(({vault,id,policyOwner,policyRev})=>({vault,id,policyOwner,policyRev:String(policyRev)}))}));
diff --git a/probes/factory-policy-discovery.mjs b/probes/factory-policy-discovery.mjs
new file mode 100644
index 0000000000000000000000000000000000000000..b5192c33a8fd33f537fbef1a8302863235667ae7
--- /dev/null
+++ b/probes/factory-policy-discovery.mjs
@@ -0,0 +1,22 @@
+// Read-only discovery from both original vault deployment blocks; emits policy metadata, never bundle bodies.
+import fs from 'node:fs';import {decodeEventLog,parseAbi} from 'viem';import {pinBlock,rpc,LIVE,readMany} from '../lib/live.mjs';
+const root=new URL('../../custody-v2-durability-20261023/repo/contracts/deployments/',import.meta.url);
+const files=['secret-vault-base.json','secret-vault-v2-base.json'];
+const contracts=files.map(f=>JSON.parse(fs.readFileSync(new URL(f,root))));
+const eventsAbi=parseAbi(['event PolicyUpdated(bytes32 indexed id,address indexed owner,uint64 policyRev,bytes32 committeeId,bool paused)','event PolicyClaimed(bytes32 indexed id,address indexed previousOwner,address indexed newOwner,uint64 policyRev)']);
+const abi=parseAbi(['function policyOf(bytes32) view returns(address owner,uint64 policyRev,uint64 secretRev,bytes32 committeeId,bool paused,bytes rules)','function beneficialOwnerOf(bytes32) view returns(address)']);
+const block=await pinBlock(),results=[];const deadline=Date.now()+360000;
+for(const c of contracts){
+ const byProvider=[];
+ for(const url of LIVE.state){const seen=[];let complete=true,error=null;try{for(let from=BigInt(c.block);from<=block.number;from+=5000n){if(Date.now()>deadline)throw Error('bounded discovery deadline reached');let to=from+4999n;if(to>block.number)to=block.number;
+  const raw=await rpc(url,'eth_getLogs',[{address:c.address,fromBlock:'0x'+from.toString(16),toBlock:'0x'+to.toString(16)}],{tries:1});
+  for(const l of raw){try{const e=decodeEventLog({abi:eventsAbi,topics:l.topics,data:l.data});seen.push({id:e.args.id,block:l.blockNumber,tx:l.transactionHash,index:l.logIndex,event:e.eventName});}catch{}}
+ }}catch(e){complete=false;error=e.message.slice(0,250);}byProvider.push({provider:new URL(url).host,complete,error,events:seen});}
+ const ids=[...new Set(byProvider.flatMap(p=>p.events.map(e=>e.id)))];const rows=[];
+ for(const id of ids){const r=await readMany(block,[{address:c.address,abi,functionName:'policyOf',args:[id]},{address:c.address,abi,functionName:'beneficialOwnerOf',args:[id]}]);const [owner,policyRev,secretRev,committeeId,paused]=r[0].value;rows.push({id,owner,policyRev,secretRev,committeeId,paused,beneficialOwner:r[1].value});}
+ const agreed=byProvider.every(p=>p.complete)&&JSON.stringify(byProvider[0].events)===JSON.stringify(byProvider[1].events);
+ results.push({vault:c.address,fromBlock:c.block,toBlock:block.number,byProvider,discoveryAgreed:agreed,policies:rows});console.log(JSON.stringify({vault:c.address,complete:byProvider.map(p=>p.complete),agreed,policies:rows.length}));
+}
+const out={at:new Date().toISOString(),readOnly:true,block,results,limits:['Log completeness remains dependent on RPC providers even when two agree. Current policy state is independently quorum-read. No bundle/rule values emitted or chain state changed.']};
+fs.writeFileSync(new URL('../evidence/factory-policy-discovery.json',import.meta.url),JSON.stringify(out,(_,v)=>typeof v==='bigint'?v.toString():v,2)+'\n');
+if(results.some(r=>!r.discoveryAgreed))process.exitCode=2;
diff --git a/probes/local-network-inventory.py b/probes/local-network-inventory.py
new file mode 100644
index 0000000000000000000000000000000000000000..974c3330add2a683c1e50c5720bae852d51604c1
--- /dev/null
+++ b/probes/local-network-inventory.py
@@ -0,0 +1,23 @@
+"""Read only service names, selected public paths/addresses and listeners; no full argv or environments."""
+import subprocess, pathlib, json, datetime
+units=subprocess.run(['systemctl','--user','list-units','--all','--no-legend','--plain'],capture_output=True,text=True,timeout=10,check=True).stdout.splitlines()
+selected=[]
+for line in units:
+ cols=line.split()
+ if cols and any(x in cols[0].lower() for x in ['enclave','caddy','custody']):selected.append({'unit':cols[0],'load':cols[1],'active':cols[2],'sub':cols[3]})
+listeners=subprocess.run(['ss','-ltnH'],capture_output=True,text=True,timeout=10,check=True).stdout.splitlines()
+ports=[]
+for line in listeners:
+ cols=line.split()
+ if len(cols)>3:ports.append(cols[3])
+commands=[]
+for unit in selected:
+ if unit['active']!='active' or not unit['unit'].endswith('.service'):continue
+ p=subprocess.run(['systemctl','--user','show',unit['unit'],'-p','MainPID','--value'],capture_output=True,text=True,timeout=10,check=True).stdout.strip()
+ if not p.isdigit() or int(p)<2:continue
+ try:
+  args=pathlib.Path(f'/proc/{p}/cmdline').read_bytes().decode().split('\0')
+  commands.append({'unit':unit['unit'],'pid':int(p),'program':pathlib.Path(args[0]).name,'paths':[v for v in args[1:] if v.startswith('/') and v.endswith(('.mjs','.js','.json','.sh'))],'cwd':str(pathlib.Path(f'/proc/{p}/cwd').resolve())})
+ except OSError:pass
+out={'at':datetime.datetime.now(datetime.timezone.utc).isoformat(),'readOnly':True,'units':selected,'listenerAddresses':ports,'selectedProcessPaths':commands,'limits':['Metadata only, no secret/config/environment values or full argv. No service changed.']}
+pathlib.Path('work/custody-v2-live-20261023/evidence/local-network-inventory.json').write_text(json.dumps(out,indent=2)+'\n');print(json.dumps(out))
