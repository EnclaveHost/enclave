+const prior=JSON.parse(fs.readFileSync(new URL('../../existing-custody-audit/evidence/session-factory-identity.json',import.meta.url)));
+const book='0xab214342d5a490150a4a977063a2f88e21f80907',factory='0x1f5c887c0cdf491b16ab6c449abafdf9b2ec9c9c',admin='0x0b2d009c0c9af05b12100d77f3c815fea822ee61',sv='0xb794c4dd0e1c5e6b72281799f282bfde7654345d',vault='0xe48699b8401564aace7a814ae4569b67a3f7eef5',zero='0x'+'00'.repeat(20),id='0xa69dcbbae66ac6ca71784d56209b1039142480ec97e0c8a3fd9cc658d969ed77';
+const abi=parseAbi(['function owner() view returns(address)','function addr(bytes32) view returns(address)','function set(bytes32,address)','function implementation() view returns(address)','function book() view returns(address)','function isVault(address) view returns(bool)','function beneficialOwnerOf(bytes32) view returns(address)']);
+const block=await pinBlock(),tag='0x'+block.number.toString(16),key=stringToHex('sessionVaultFactory',{size:32});
+const r=await readMany(block,[{address:book,abi,functionName:'owner'},{address:book,abi,functionName:'addr',args:[key]},{address:factory,abi,functionName:'implementation'},{address:factory,abi,functionName:'isVault',args:[sv]},{address:sv,abi,functionName:'owner'},{address:vault,abi,functionName:'beneficialOwnerOf',args:[id]}]);
+assert.equal(r[0].value.toLowerCase(),admin);assert.equal(r[1].value.toLowerCase(),zero);assert.equal(r[2].value.toLowerCase(),prior.factories[factory].implementation);assert.equal(r[3].value,true);assert.equal(r[4].value.toLowerCase(),admin);assert.ok([sv,admin].includes(r[5].value.toLowerCase()),'Unexpected sample owner');
+const impl=r[2].value;const [bc]=await readMany(block,[{address:impl,abi,functionName:'book'}]);assert.equal(bc.value.toLowerCase(),book);
+const hashes={factory:keccak256(await codeAt(block,factory)),implementation:keccak256(await codeAt(block,impl))};assert.equal(hashes.factory,prior.factories[factory].codeHash);assert.equal(hashes.implementation,prior.factories[factory].implementationCodeHash);
+const transaction={chainId:'0x2105',from:admin,to:book,value:'0x0',data:encodeFunctionData({abi,functionName:'set',args:[key,factory]})};assert.equal(await agree('eth_call',[transaction,tag]),'0x');
+const rejected=await Promise.all(LIVE.state.map(async url=>{try{await rpc(url,'eth_call',[{...transaction,from:'0x'+'19'.repeat(20)},tag]);return false}catch(e){return /revert/i.test(e.message)}}));assert.ok(rejected.every(Boolean));
+const out={at:new Date().toISOString(),status:'UNSIGNED; consumer impact review required before requesting activation',readOnly:true,block,book,factory,implementation:impl,codeHashes:hashes,sample:{deployment:id,sessionVault:sv,vaultOwner:r[4].value,recognizedByFactory:r[3].value,currentCustodyBeneficialOwner:r[5].value,sampleIsSessionVaultOwned:r[5].value.toLowerCase()===sv},expectedBefore:{sessionVaultFactory:zero,bookOwner:admin},transaction,simulation:{adminSucceeded:true,unauthorizedRejected:rejected},effect:'Enable the original custody vault to unwrap recognized SessionVault deployments to their wallet owner. Needed before creating policies intended to be owned by that wallet. Existing EOA-owned policies are unaffected.',risk:'A policy previously pinned to a SessionVault address could require claimPolicy after this change, which destroys its encrypted bundle. Review all v1/v2 consumers of this shared book key before activation. Do not blindly toggle back after creating wallet-owned policies.',notSent:true};
+const txt=JSON.stringify(out,(_,v)=>typeof v==='bigint'?v.toString():v,2)+'\n';fs.writeFileSync(new URL('../evidence/factory-activation-unsigned-20261023.json',import.meta.url),txt);console.log(txt);
