+/**
+ * What a committee is, exactly: never a badge. Seats are counted as the vault and custody/v2/protocol.mjs seatLayout count
+ * them: every Enclave-flagged machine is ONE Enclave seat (its replicas hold the same shares), each other machine its own
+ * seat. n = 1 is a SINGLE-SEAT bootstrap. More seats are stated as such and never called decentralized or independent:
+ * distinct registry hosts or operator addresses do not prove distinct operators or failure domains.
+ */
 export function describeCommittee(committee){
   if (!committee) return null;
-  const seats = committee.machines.length, enclave = committee.machines.filter((m) => m.enclave).length;
-  const hosts = new Set(committee.machines.map((m) => m.registryId)).size;
-  const kind = seats === 1 ? "single-seat-bootstrap" : enclave === seats ? "enclave-operated" : "mixed";
-  const label = kind === "single-seat-bootstrap"
-    ? "SINGLE-SEAT BOOTSTRAP: one custodian machine (" + (enclave ? "Enclave-operated" : "not Enclave-operated") + "), " + committee.t + " of " + committee.W
-      + " shares - protection rests on that one TEE and its software, not on distribution"
-    : kind === "enclave-operated"
-      ? "ENCLAVE-OPERATED BOOTSTRAP: all " + seats + " seats run by Enclave, " + committee.t + " of " + committee.W + " shares - not decentralized custody"
