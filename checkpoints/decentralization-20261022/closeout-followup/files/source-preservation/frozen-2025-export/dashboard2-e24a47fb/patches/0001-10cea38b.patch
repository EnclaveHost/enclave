           + " · owner " + pol.owner + (pol.ownerMoved ? " (the ledger now names " + s2.beneficialOwner + ": use the CLI's claimPolicy)" : ""));
-        if (c) c2paint(c.kind === "mixed" ? "info" : "warn", "// committee " + c.committeeId.slice(0, 10) + "… epoch " + c.epoch + ": " + c.label);
+        if (c) c2paint(c.kind === "multi-seat" ? "info" : "warn", "// committee " + c.committeeId.slice(0, 10) + "… epoch " + c.epoch + ": " + c.label);
         if (pol.rulesError) c2paint("warn", "[x] its rules do not parse here: " + pol.rulesError);
