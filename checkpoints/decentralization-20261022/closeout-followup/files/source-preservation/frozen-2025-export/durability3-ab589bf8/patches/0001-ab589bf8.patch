From ab589bf80b669c9671b53573d489b6c6c45779ea Mon Sep 17 00:00:00 2001
From: SteveDeFacto <5148995+SteveDeFacto@users.noreply.github.com>
Date: Fri, 23 Oct 2026 12:59:20 -0700
Subject: [PATCH] test: the real custodian daemon startup and direct-ingress
 path spellings

custody-v2-daemon-startup runs the REAL custody/v2/daemon.mjs main, bundled
the way the image bundles it with the original vault's production measured
config. Only the chip is stubbed (snpkey derive returns a test key) and every
fetch other than the host's is refused. Against a host /state server:
- 503, 500, 403, 401, a disconnect, a redirect, an empty or truncated 200, a
  blob sealed by another key, a tampered blob, an oversize body and a stall:
  the daemon does not start and writes nothing; the stored state is untouched.
- The stored state opens, and opens again after those failures.
- An explicit 404 whose first write fails starts nothing.
- An explicit 404 seals a fresh identity with the chip key before anything else.
At c95dcd3a, and with a mutant of a5eae96c's wiring that maps read errors to
"missing", a 503 writes a new identity over the stored state; both fail this
test.

custody-direct-ingress-paths puts the REAL Caddy (CADDY_BIN) and the generated
ingress in front of the REAL custodian router. 25 spellings of the
host-binding route (case, slashes, dot segments plain and %-encoded,
backslashes, encoded separators, double encoding, ;params, query, absolute
form) and the host's private routes never reach setHostSig or the guest port.
A mutant ingress forwarding /v2/custody/* lets 11 spellings through and fails.
---
 test/custody-direct-ingress-paths.test.mjs |  85 +++++++++++++
 test/custody-v2-daemon-startup.test.mjs    | 138 +++++++++++++++++++++
 2 files changed, 223 insertions(+)
 create mode 100644 test/custody-direct-ingress-paths.test.mjs
 create mode 100644 test/custody-v2-daemon-startup.test.mjs

diff --git a/test/custody-direct-ingress-paths.test.mjs b/test/custody-direct-ingress-paths.test.mjs
new file mode 100644
index 0000000000000000000000000000000000000000..e718886066e9145c7d670a636bbffee0683785e0
--- /dev/null
+++ b/test/custody-direct-ingress-paths.test.mjs
@@ -0,0 +1,85 @@
+// The direct custodian ingress (custody/v2/ingress.mjs, served by the REAL Caddy over TLS) in front of the REAL custodian
+// router (custody/v2/http.mjs). Caddy matches a cleaned, percent-decoded path; the guest resolves the forwarded URL with
+// WHATWG rules (dot segments, %2e, backslashes). No request through the ingress, however its path is spelled, may reach
+// the guest's host-binding route; and the host's private /state, /submit and /receipts never reach the guest port.
+//   run: CADDY_BIN=/path/to/caddy node --test test/custody-direct-ingress-paths.test.mjs
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import fs from 'node:fs';
+import path from 'node:path';
+import http from 'node:http';
+import https from 'node:https';
+import net from 'node:net';
+import {execFileSync,spawn} from 'node:child_process';
+import {once} from 'node:events';
+import {mintLocalCa} from './helpers/local-tls.mjs';
+import {directCustodyIngress} from '../custody/v2/ingress.mjs';
+import {createCustodyRouter} from '../custody/v2/http.mjs';
+const caddy=process.env.CADDY_BIN;
+const HB='host-binding';
+// spellings of the host-binding route: case, slashes, dot segments (plain, %-encoded, mixed), backslashes, encoded
+// separators, parameters, query and fragment confusion, and an absolute-form target
+const VARIANTS=[`/v2/custody/${HB}`,`/V2/CUSTODY/HOST-BINDING`,`/v2/custody/${HB}/`,`//v2/custody/${HB}`,`/v2//custody/${HB}`,`/v2/custody/./${HB}`,
+  `/v2/custody/release/../${HB}`,`/v2/custody/release/%2e%2e/${HB}`,`/v2/custody/release/%2E%2E/${HB}`,`/v2/custody/release/.%2e/${HB}`,
+  `/v2/custody/release/%2e./${HB}`,`/v2/custody/release\\..\\${HB}`,`/v2/custody/release/..\\${HB}`,`/v2/custody/release/..%5c${HB}`,
+  `/v2/custody/release%2f..%2f${HB}`,`/v2/custody/release/%252e%252e/${HB}`,`/v2/custody/${HB}?/v2/custody/release`,`/v2/custody/${HB};/v2/custody/release`,
+  `/v2/custody/release/..;/${HB}`,`/v2/custody/host%2Dbinding`,`/v2/custody/%68ost-binding`,`/v2/custody/release/%2e%2e%2f${HB}`,
+  `/v2/custody/x/../release/../${HB}`,`/v2/custody/release/../../custody/${HB}`,`http://localhost/v2/custody/${HB}`];
+const PRIVATE=[['/state','GET'],['/state','PUT'],['/submit','POST'],['/receipts','GET'],['/v2/custody/release/../../../state','GET'],
+  ['/v2/custody/release/%2e%2e/%2e%2e/%2e%2e/submit','POST']];
+
+test('no spelling of the host-binding route passes the direct ingress to the real custodian router',
+  {skip:!caddy?'set CADDY_BIN to run the real Caddy/TLS integration':false,timeout:30000},async()=>{
+  const ca=mintLocalCa(),seen=[];let bound=0,child,backend,diagnostics='';
+  const request=(port,route,method,body='{}')=>new Promise((resolve,reject)=>{
+    const req=https.request({hostname:'127.0.0.1',servername:'localhost',port,path:route,method,ca:ca.caPem,
+      headers:{host:'localhost','content-type':'application/json','content-length':Buffer.byteLength(body)},timeout:3000},res=>{
+      const chunks=[];res.on('data',c=>chunks.push(c));res.on('end',()=>resolve({status:res.statusCode,body:Buffer.concat(chunks).toString()}));
+    });req.on('error',reject);req.on('timeout',()=>req.destroy(Error('timeout')));req.end(body);
+  });
+  // the real router; the member's host-binding entry point only counts (the private surface under test)
+  const member={info:()=>({v:2}),setHostSig:async()=>{bound++;return {ok:true};},evidence:async()=>({ok:true}),join:async()=>({ok:true}),approve:async()=>({ok:true}),
+    approveCode:async()=>({ok:true})};
+  const custodian={encKeyHex:'00',challenge:()=>({ok:true}),release:async()=>({ok:true})};
+  const route=createCustodyRouter({custodian,member,runIndependent:async()=>({ok:true}),servedCommittee:()=>null,chainId:8453,vault:'0x'+'00'.repeat(20),rate:()=>true});
+  try{
+    backend=http.createServer((req,res)=>{seen.push({path:req.url,method:req.method,resolved:new URL(req.url,'http://x').pathname});return route(req,res);});
+    backend.listen(0,'127.0.0.1');await once(backend,'listening');
+    const reservation=net.createServer();reservation.listen(0,'127.0.0.1');await once(reservation,'listening');
+    const port=reservation.address().port;await new Promise(r=>reservation.close(r));
+    const site=directCustodyIngress({endpoint:'https://localhost',mgmtPort:backend.address().port});
+    const config='{\n admin off\n auto_https off\n}\n'+site.replace('https://localhost {',`https://localhost:${port} {\n bind 127.0.0.1\n tls ${ca.dir}/leaf.pem ${ca.dir}/leaf.key`);
+    const configPath=path.join(ca.dir,'Caddyfile');fs.writeFileSync(configPath,config,{mode:0o600});
+    execFileSync(caddy,['adapt','--config',configPath,'--adapter','caddyfile'],{stdio:'pipe'});
+    child=spawn(caddy,['run','--config',configPath,'--adapter','caddyfile'],{env:{...process.env,XDG_CONFIG_HOME:ca.dir,XDG_DATA_HOME:ca.dir},stdio:['ignore','ignore','pipe']});
+    child.stderr.on('data',c=>{diagnostics=(diagnostics+c.toString()).slice(-3000);});
+    let ready=false;
+    for(let i=0;i<100&&!ready;i++){
+      if(child.exitCode!==null)throw Error('Caddy exited: '+diagnostics);
+      try{ready=(await request(port,'/v2/custody/info','GET','')).status===200;}catch{}
+      if(!ready)await new Promise(r=>setTimeout(r,50));
+    }
+    assert.ok(ready,'the ingress becomes ready');
+    // positive control: an allowlisted POST reaches the guest router
+    seen.length=0;
+    assert.equal((await request(port,'/v2/custody/challenge','POST')).status,200);
+    assert.equal(seen.length,1,'an allowlisted route is forwarded');
+    seen.length=0;
+    const outcomes=[];
+    for(const v of VARIANTS){
+      let status;try{status=(await request(port,v,'POST')).status;}catch(e){status='client:'+e.code;}
+      outcomes.push([v,status]);
+    }
+    for(const [r,m] of PRIVATE){let status;try{status=(await request(port,r,m)).status;}catch(e){status='client:'+e.code;}outcomes.push([`${m} ${r}`,status]);}
+    assert.equal(bound,0,`a host-binding spelling reached the guest's setHostSig: ${JSON.stringify(outcomes)} forwarded ${JSON.stringify(seen)}`);
+    for(const s of seen){
+      assert.notEqual(s.resolved.toLowerCase().replace(/\/+$/,''),'/v2/custody/host-binding',`forwarded and resolved to host-binding: ${s.path}`);
+      assert.ok(!['/state','/submit','/receipts'].includes(s.resolved),`a private host route reached the guest port: ${s.path}`);
+    }
+    for(const [v,status] of outcomes)assert.ok(status===404||status===400||String(status).startsWith('client:'),`${v}: ${status} (forwarded: ${JSON.stringify(seen)})`);
+  }finally{
+    if(child&&child.exitCode===null){const done=once(child,'exit');child.kill('SIGTERM');await done;}
+    if(backend){backend.closeAllConnections();await new Promise(r=>backend.close(r));}
+    ca.cleanup();
+  }
+});
diff --git a/test/custody-v2-daemon-startup.test.mjs b/test/custody-v2-daemon-startup.test.mjs
new file mode 100644
index 0000000000000000000000000000000000000000..55ef464bca31ceb1e6943610873fd3523a42b780
--- /dev/null
+++ b/test/custody-v2-daemon-startup.test.mjs
@@ -0,0 +1,138 @@
+// The REAL custodian daemon's startup (custody/v2/daemon.mjs main, bundled as the image bundles it, with the production
+// measured config of the original vault) against a host /state server this test controls. Only the chip is stubbed: the
+// /opt/custodian/snpkey call returns a test-only key, and every fetch other than the host's is refused (no network).
+// Each case is a fresh daemon process. A host answer other than an explicit 404 must never create a new identity or
+// write over the stored state; a 404 creates one and seals it with the chip key before anything else.
+//   run: node --test test/custody-v2-daemon-startup.test.mjs
+import test from "node:test";
+import assert from "node:assert/strict";
+import fs from "node:fs";
+import os from "node:os";
+import path from "node:path";
+import http from "node:http";
+import { spawn } from "node:child_process";
+import { createCipheriv, createDecipheriv, randomBytes } from "node:crypto";
+import { fileURLToPath } from "node:url";
+import { build, stop as stopEsbuild } from "esbuild";
+import { custodianMeasured, measuredModule, bundleOptions } from "../custody/v2/build-config.mjs";
+
+const ROOT = path.resolve(path.dirname(fileURLToPath(import.meta.url)), "..");
+const KEY = randomBytes(32);                                  // test-only stand-in for the chip-derived sealing key
+const AAD = Buffer.from("enclave-custody-v2 state");          // daemon.mjs seal/unseal
+const seal = (obj, key = KEY) => { const iv = randomBytes(12), c = createCipheriv("aes-256-gcm", key, iv); c.setAAD(AAD);
+  const ct = Buffer.concat([c.update(Buffer.from(JSON.stringify(obj))), c.final()]); return Buffer.concat([iv, c.getAuthTag(), ct]); };
+const unseal = (blob) => { const d = createDecipheriv("aes-256-gcm", KEY, blob.subarray(0, 12)); d.setAAD(AAD); d.setAuthTag(blob.subarray(12, 28));
+  return JSON.parse(Buffer.concat([d.update(blob.subarray(28)), d.final()]).toString("utf8")); };
+
+async function bundleDaemon(dir) {
+  const hp = JSON.parse(fs.readFileSync(path.join(ROOT, "release/host-policy-production.json"), "utf8"));
+  const { measured } = custodianMeasured({ vault: "0xe48699b8401564aace7a814ae4569b67a3f7eef5", hostOwnership: "0xbbd885d3e9bc33609387bb9710e91c1905fe6ee7",
+    transport: "direct", book: "0xab214342d5a490150a4a977063a2f88e21f80907", hostPolicy: hp });
+  const options = bundleOptions(measuredModule(measured), { root: ROOT });
+  const stub = path.join(dir, "child-process-stub.mjs");
+  fs.writeFileSync(stub, `import { createRequire } from "node:module";
+const real = createRequire(import.meta.url)("child_process");
+export const { spawn, spawnSync, exec, execFile, execSync, fork } = real;
+export function execFileSync(cmd, args, o) {
+  if (cmd === "/opt/custodian/snpkey" && args && args[0] === "derive") return process.env.TEST_SNPKEY_HEX + "\\n";
+  throw new Error("test: unexpected execFileSync " + cmd);
+}
+export default { ...real, execFileSync };
+`);
+  const out = await build({ ...options, entryPoints: [path.join(ROOT, "custody/v2/daemon.mjs")],
+    plugins: [...options.plugins, { name: "chip-stub", setup(b) { b.onResolve({ filter: /^(node:)?child_process$/ }, (a) => (a.importer === stub ? undefined : { path: stub })); } }] });
+  stopEsbuild();                                              // as the image builder does: no resident esbuild service
+  const file = path.join(dir, "custodian.mjs");
+  fs.writeFileSync(file, out.outputFiles[0].contents);
+  return file;
+}
+
+// one daemon process against the host; resolves when it exits (startup always ends: after the state step the next
+// step reads the SNP report, which this host has no configfs for, or the chain, which the fetch guard refuses)
+function runDaemon(daemon, dir, hostUrl) {
+  const cfg = path.join(dir, `host-config-${randomBytes(4).toString("hex")}.json`);
+  fs.writeFileSync(cfg, JSON.stringify({ endpoint: "https://custody.test.example", registryId: "0x" + "ab".repeat(32), hostUrl, genesis: false }));
+  const guard = path.join(dir, "fetch-guard.mjs");
+  fs.writeFileSync(guard, `const real = globalThis.fetch, allow = process.env.TEST_HOST_URL;
+globalThis.fetch = (u, o) => { const s = String(u && u.url ? u.url : u); return s.startsWith(allow + "/") ? real(u, o) : Promise.reject(new Error("test: network refused " + s)); };
+`);
+  return new Promise((resolve) => {
+    const p = spawn(process.execPath, ["--import", guard, daemon], { env: { PATH: process.env.PATH, CUSTODY_HOST_CONFIG: cfg, TEST_HOST_URL: hostUrl, TEST_SNPKEY_HEX: KEY.toString("hex") },
+      stdio: ["ignore", "pipe", "pipe"] });
+    let out = ""; p.stdout.on("data", (d) => (out += d)); p.stderr.on("data", (d) => (out += d));
+    const kill = setTimeout(() => p.kill("SIGKILL"), 60_000);
+    p.on("exit", (code) => { clearTimeout(kill); resolve({ code, out }); });
+  });
+}
+
+test("the real daemon startup: only an explicit 404 creates an identity; any other host answer leaves the stored state untouched", { timeout: 300_000 }, async (t) => {
+  const dir = fs.mkdtempSync(path.join(os.tmpdir(), "custody-daemon-startup-"));
+  t.after(() => fs.rmSync(dir, { recursive: true, force: true }));
+  const daemon = await bundleDaemon(dir);
+  const stored = { identityKey: "0x" + "11".repeat(32), encPrivate: "22".repeat(32), member: { epochs: { [`0x${"cd".repeat(32)}:1`]: [{ k: 1, x: "33".repeat(32) }] }, pending: {}, hostSig: null, candidates: {} } };
+  let disk = seal(stored), mode = "stored", puts = 0, gets = 0, putFails = false;
+  const srv = http.createServer((req, res) => {
+    if (req.url === "/state" && req.method === "PUT") {
+      const chunks = []; req.on("data", (c) => chunks.push(c)); req.on("end", () => {
+        puts++;
+        if (putFails) { res.writeHead(500); return res.end(); }
+        disk = Buffer.concat(chunks); res.writeHead(200, { "content-type": "application/json" }); res.end('{"ok":true}');
+      }); return;
+    }
+    if (req.url !== "/state" || req.method !== "GET") { res.writeHead(404); return res.end(); }
+    gets++;
+    if (mode === "disconnect") return req.socket.destroy();
+    if (mode === "stall") return;                                         // never answers: the daemon's read deadline
+    if (mode === "redirect") { res.writeHead(302, { location: "/elsewhere" }); return res.end(); }
+    if (mode === "missing") { res.writeHead(404, { "content-type": "application/json" }); return res.end('{"error":"none"}'); }
+    if (/^\d{3}$/.test(mode)) { res.writeHead(Number(mode)); return res.end(); }
+    if (mode === "empty") { res.writeHead(200); return res.end(); }
+    if (mode === "truncated") { res.writeHead(200); return res.end(disk.subarray(0, 27)); }
+    if (mode === "foreign") { res.writeHead(200); return res.end(seal(stored, randomBytes(32))); }   // another chip's/build's blob
+    if (mode === "tampered") { const b = Buffer.from(disk); b[b.length - 1] ^= 1; res.writeHead(200); return res.end(b); }
+    if (mode === "oversize") { res.writeHead(200); return res.end(Buffer.alloc((4 << 20) + 1, 7)); }
+    res.writeHead(200, { "content-type": "application/octet-stream" }); res.end(disk);
+  });
+  await new Promise((r) => srv.listen(0, "127.0.0.1", r));
+  t.after(() => { srv.closeAllConnections(); return new Promise((r) => srv.close(r)); });
+  const hostUrl = `http://127.0.0.1:${srv.address().port}`;
+  const original = Buffer.from(disk);
+
+  // the stored state opens; nothing is written
+  let r = await runDaemon(daemon, dir, hostUrl);
+  assert.match(r.out, /sealed state opened/, r.out);
+  assert.doesNotMatch(r.out, /new custodian identity/);
+  assert.equal(puts, 0);
+
+  for (mode of ["503", "500", "403", "401", "disconnect", "redirect", "empty", "truncated", "foreign", "tampered", "oversize", "stall"]) {
+    const g = gets;
+    r = await runDaemon(daemon, dir, hostUrl);
+    assert.ok(gets > g, `${mode}: the daemon asked the host for its state`);
+    assert.notEqual(r.code, 0, `${mode}: the daemon must not start`);
+    assert.match(r.out, /FATAL/, `${mode}: ${r.out}`);
+    assert.doesNotMatch(r.out, /new custodian identity|sealed state opened/, `${mode}: ${r.out}`);
+    assert.equal(puts, 0, `${mode}: no identity was written over the stored state`);
+    assert.deepEqual(disk, original, `${mode}: the stored state is untouched`);
+  }
+
+  // recovery: the same stored state opens again
+  mode = "stored";
+  r = await runDaemon(daemon, dir, hostUrl);
+  assert.match(r.out, /sealed state opened/); assert.equal(puts, 0);
+
+  // an explicit 404 whose first write fails: nothing is used, nothing logged as sealed
+  mode = "missing"; putFails = true;
+  r = await runDaemon(daemon, dir, hostUrl);
+  assert.equal(puts, 1); assert.notEqual(r.code, 0);
+  assert.doesNotMatch(r.out, /new custodian identity sealed/);
+  assert.deepEqual(disk, original);
+
+  // an explicit 404: a fresh identity, sealed with the chip key, written before anything else
+  putFails = false;
+  r = await runDaemon(daemon, dir, hostUrl);
+  assert.equal(puts, 2);
+  assert.match(r.out, /new custodian identity sealed/, r.out);
+  const fresh = unseal(disk);
+  assert.match(fresh.identityKey, /^0x[0-9a-f]{64}$/); assert.match(fresh.encPrivate, /^[0-9a-f]{64}$/); assert.equal(fresh.member, null);
+  assert.notEqual(fresh.identityKey, stored.identityKey);
+});
