diff --git a/probes/canary-caddy-validate.py b/probes/canary-caddy-validate.py
new file mode 100644
index 0000000000000000000000000000000000000000..f5cbb3f6d9a3c772db1567b47a9b9c9d8272cd49
--- /dev/null
+++ b/probes/canary-caddy-validate.py
@@ -0,0 +1,11 @@
+"""Validate a standalone canary snippet with the control VM's installed Caddy; no serving/reload/config edit."""
+import pathlib,subprocess,json,datetime,hashlib
+p=pathlib.Path('work/custody-v2-ingress-forwarder-20261023/examples/Caddyfile.canary-snippet')
+snippet=p.read_text().replace('<R>','18902')
+config='http://127.0.0.1:18903 {\n'+snippet+'\nhandle {\n respond "Not found" 404\n}\n}\n'
+cmd=['ssh','-p32423','-o','BatchMode=yes','-o','ConnectTimeout=10','-o','UserKnownHostsFile=/home/steven/Documents/Codex/2026-10-18/wo/work/control-vm/known_hosts','-i','/home/steven/.ssh/minipc','controladmin@127.0.0.1','caddy adapt --config /dev/stdin --adapter caddyfile --validate']
+r=subprocess.run(cmd,input=config,text=True,capture_output=True,timeout=35)
+result={'at':datetime.datetime.now(datetime.timezone.utc).isoformat(),'scope':'standalone syntax/provisioning validation only; no listener, live config write or reload','snippetSha256':hashlib.sha256(p.read_bytes()).hexdigest(),'inputSha256':hashlib.sha256(config.encode()).hexdigest(),'exit':r.returncode,'diagnostics':r.stderr[-2000:]}
+if r.returncode==0:
+ d=json.loads(r.stdout);result['adaptedSha256']=hashlib.sha256(r.stdout.encode()).hexdigest();result['servers']=list(d.get('apps',{}).get('http',{}).get('servers',{}))
+pathlib.Path('work/custody-v2-live-20261023/evidence/canary-caddy-validate.json').write_text(json.dumps(result,indent=2)+'\n');print(json.dumps(result));raise SystemExit(r.returncode)
diff --git a/probes/recipient-runtime-inventory.py b/probes/recipient-runtime-inventory.py
new file mode 100644
index 0000000000000000000000000000000000000000..53490c84c2cecd08d058f331e95df47b9cf0d54c
--- /dev/null
+++ b/probes/recipient-runtime-inventory.py
@@ -0,0 +1,30 @@
+"""Read selected public metal runner configuration and HTTP capabilities; no credentials or state mutation."""
+import json,pathlib,hashlib,urllib.request,datetime,subprocess
+p=pathlib.Path('/home/steven/Projects/enclave/metal/config.json');d=json.loads(p.read_text())
+public={k:d.get(k) for k in ['dist','mode','name','cpus','memMiB','publicUrl','wasmtimeBin']}
+iso=d.get('isolation'); public['isolation']={k:(iso[k] if isinstance(iso[k],(str,int,bool)) else {'configured':True,'type':type(iso[k]).__name__}) for k in ['mode','guestd','root','enabled'] if k in iso} if isinstance(iso,dict) else (iso if isinstance(iso,(str,int,bool)) else None)
+# Emit only types/names for paths that may carry a config object.
+for k,v in list(public.items()):
+ if isinstance(v,(dict,list)) and k!='isolation':public[k]={'configured':True,'type':type(v).__name__}
+dist=pathlib.Path(public['dist']);mp=dist/'manifest.json';manifest=None
+if mp.is_file():
+ data=json.loads(mp.read_text());manifest={'path':str(mp),'sha256':hashlib.sha256(mp.read_bytes()).hexdigest(),'fields':sorted(data)}
+ for k in ['commit','measurement','runtimeId','mode','transport','isolation']:
+  if isinstance(data.get(k),(str,int,bool)):manifest[k]=data[k]
+responses=[]
+for suffix in ['/v1/health','/availability']:
+ url='https://api.enclave.host/t/metal0'+suffix
+ row={'url':url}
+ try:
+  with urllib.request.urlopen(url,timeout=10) as r:
+   body=r.read(131073);row.update(httpStatus=r.status,bytes=len(body),sha256=hashlib.sha256(body).hexdigest())
+   if len(body)>131072:raise ValueError('oversize public response')
+   obj=json.loads(body);row['fields']=sorted(obj) if isinstance(obj,dict) else []
+   if isinstance(obj,dict):
+    for k in ['mode','isolation','capabilities','custody','custodyV2','version','status','runtimeId','measurement','fullService','claimEnabled','memMb','cpuAvailable','cpuTotal','ramGbFree','nodeRamGb','nodeVcpus','cpuShareFree','maxShare','secrets','teeCpu']:
+     v=obj.get(k)
+     if isinstance(v,(str,int,bool,list,dict)):row[k]=v
+ except Exception as e:row['error']=str(e)[:180]
+ responses.append(row)
+out={'at':datetime.datetime.now(datetime.timezone.utc).isoformat(),'readOnly':True,'publicConfiguration':public,'manifest':manifest,'http':responses,'limits':['Public configuration/HTTP metadata only; no secret keys, raw environment, sealed state or secret records read or emitted. No service or configuration changed.']}
+pathlib.Path('work/custody-v2-live-20261023/evidence/recipient-runtime-capabilities.json').write_text(json.dumps(out,indent=2)+'\n');print(json.dumps(out))
diff --git a/probes/relay-session-authority.py b/probes/relay-session-authority.py
new file mode 100644
index 0000000000000000000000000000000000000000..2b21aa7da2d16a70f01ab7550fb52b1fe9b97f60
--- /dev/null
+++ b/probes/relay-session-authority.py
@@ -0,0 +1,21 @@
+"""Read only the relay's public factory/book settings and source hashes, never secret values."""
+import subprocess,json,pathlib,datetime
+ssh=['ssh','-p32423','-o','BatchMode=yes','-o','ConnectTimeout=10','-o','UserKnownHostsFile=/home/steven/Documents/Codex/2026-10-18/wo/work/control-vm/known_hosts','-i','/home/steven/.ssh/minipc','controladmin@127.0.0.1','sudo python3 -']
+remote=r'''
+import subprocess,pathlib,json,hashlib,re,datetime
+pid=int(subprocess.check_output(['systemctl','show','enclave-api-relay','-p','MainPID','--value'],text=True).strip());assert pid>1
+allowed={'SESSIONS_FACTORY','ADDRESS_BOOK_ADDRESS','CUSTODY_VAULT','CUSTODY_VAULT_V2'}
+public={k:None for k in allowed}
+for entry in pathlib.Path(f'/proc/{pid}/environ').read_bytes().split(b'\0'):
+ key,sep,val=entry.partition(b'=')
+ if sep and key.decode() in allowed:
+  value=val.decode();public[key.decode()]=value if re.fullmatch(r'0x[0-9a-fA-F]{40}',value) else {'present':True,'validAddress':False}
+root=pathlib.Path('/opt/nan-relay');hashes=[]
+for name in ['api-relay.js','sessions.js','network-api.js','relay/sessions.mjs','network/owner-signature.mjs']:
+ p=root/name
+ hashes.append({'path':name,'exists':p.is_file(),'sha256':hashlib.file_digest(open(p,'rb'),'sha256').hexdigest() if p.is_file() else None})
+print(json.dumps({'at':datetime.datetime.now(datetime.timezone.utc).isoformat(),'readOnly':True,'pid':pid,'publicEnvironment':public,'sourceHashes':hashes,'limits':['Only public address settings emitted; no secret values, raw environment or private configuration printed. No restart or configuration change.']}))
+'''
+r=subprocess.run(ssh,input=remote,text=True,capture_output=True,timeout=40)
+if r.returncode:raise SystemExit('Read-only relay probe failed: '+r.stderr[-250:])
+out=json.loads(r.stdout);pathlib.Path('work/custody-v2-live-20261023/evidence/relay-session-authority.json').write_text(json.dumps(out,indent=2)+'\n');print(json.dumps(out))
