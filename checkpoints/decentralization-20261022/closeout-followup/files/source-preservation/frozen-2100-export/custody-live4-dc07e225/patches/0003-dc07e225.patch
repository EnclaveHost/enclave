diff --git a/probes/book-abi-readcheck.mjs b/probes/book-abi-readcheck.mjs
new file mode 100644
index 0000000000000000000000000000000000000000..6d0e09826a7d26be1390805aec652466af70a502
--- /dev/null
+++ b/probes/book-abi-readcheck.mjs
@@ -0,0 +1,5 @@
+// Read-only diagnosis of the exact pinned original book ABI; no journal/signing/submission.
+import fs from 'node:fs';import{parseAbi,encodeFunctionData,keccak256}from'viem';import{pinBlock,rpc,LIVE}from'../lib/live.mjs';
+const book='0xab214342d5a490150a4a977063a2f88e21f80907';const abi=parseAbi(['function owner() view returns(address)','function pendingOwner() view returns(address)']);const block=await pinBlock();const rows=[];
+for(const url of LIVE.state){const code=await rpc(url,'eth_getCode',[book,'0x'+block.number.toString(16)]);const row={provider:new URL(url).host,codeHash:keccak256(code),calls:[]};for(const fn of ['owner','pendingOwner']){const data=encodeFunctionData({abi,functionName:fn});try{row.calls.push({function:fn,selector:data,selectorPresentInCode:code.includes(data.slice(2)),result:await rpc(url,'eth_call',[{to:book,data},'0x'+block.number.toString(16)],{tries:1})});}catch(e){row.calls.push({function:fn,selector:data,selectorPresentInCode:code.includes(data.slice(2)),error:e.message.slice(0,180)});}}rows.push(row);}
+const out={at:new Date().toISOString(),readOnly:true,book,block,rows};fs.writeFileSync(new URL('../evidence/book-abi-readcheck.json',import.meta.url),JSON.stringify(out,(_,v)=>typeof v==='bigint'?v.toString():v,2)+'\n');console.log(JSON.stringify(rows));
