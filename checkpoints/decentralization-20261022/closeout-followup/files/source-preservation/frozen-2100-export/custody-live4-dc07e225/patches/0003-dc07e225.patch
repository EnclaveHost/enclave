+"""Read selected metadata and redacted publisher startup errors on NucBox. No state/config change."""
+import importlib.util,pathlib,json
+s=importlib.util.spec_from_file_location('h','work/nucbox-tls-20261021/root-activate-reviewed.py');h=importlib.util.module_from_spec(s);s.loader.exec_module(h)
+p=r'''$id='0xd9798e4ccd0c8402d0042000513fc6bc14616043d96dff3368080a21a1abbb9a';$v=@((Invoke-RestMethod -TimeoutSec 8 http://127.0.0.1:8091/vms).vms|Where-Object {$_.name -eq $id});if($v.Count -ne 1){throw 'Expected one publisher VM'};$v=$v[0];$o=[ordered]@{at=(Get-Date).ToUniversalTime().ToString('o');readOnly=$true;vm=($v|Select-Object id,name,status,instanceId,cpu,memory);fields=@($v.PSObject.Properties.Name)};$logs=@(Get-ChildItem 'C:\ProgramData\Enclave\logs\partitions' -File|Where-Object {$_.Name -like ('*'+$v.instanceId+'*')}|Sort-Object LastWriteTime -Descending|Select-Object -First 2);$o.logs=@($logs|ForEach-Object {$f=$_;$lines=@(Get-Content $f.FullName -Tail 1000|Where-Object {$_ -match '\[ipns-publisher\]' -and $_ -match 'GET failed|GET answered|publish aborted|knows sequence|signed sequence|state file|failed|error'}|Select-Object -Last 25|ForEach-Object {$l=[string]$_;$l=$l -replace '(?i)(token|password|signature|authorization|secret|seed|api.key)([=: ]+)[^ ,;]+','$1=[redacted]';$l=$l -replace '[A-Za-z0-9+/_=-]{43,}','[long-value-redacted]';$l.Substring(0,[Math]::Min(700,$l.Length))});@{path=$f.FullName;modified=$f.LastWriteTimeUtc.ToString('o');bytes=$f.Length;messages=$lines}});$o|ConvertTo-Json -Depth 7 -Compress'''
+r=h.ps(p,40);pathlib.Path('work/custody-v2-live-20261023/evidence/publisher-runtime-metadata.json').write_text(json.dumps(r,indent=2)+'\n');print(json.dumps(r))
diff --git a/probes/recipient-live-confirm.py b/probes/recipient-live-confirm.py
new file mode 100644
index 0000000000000000000000000000000000000000..31b5bb5bbc88988f34816716e2bce078cb6fc114
--- /dev/null
+++ b/probes/recipient-live-confirm.py
@@ -0,0 +1,21 @@
+"""Bounded read-only recipient admission/capability observations. No raw attestation or pairing material emitted."""
+import urllib.request,json,secrets,hashlib,pathlib,datetime
+rows=[]
+nonce=secrets.token_hex(32)
+for name,url in [('relayAttestation','https://api.enclave.host/v1/enclaves/metal0/attestation?nonce='+nonce),('guestd','http://127.0.0.1:8095/health')]:
+ row={'name':name,'url':url}
+ try:
+  with urllib.request.urlopen(url,timeout=20) as r:
+   b=r.read(1048577);row['status']=r.status
+   if len(b)>1048576:raise ValueError('response too large')
+   d=json.loads(b);row['sha256']=hashlib.sha256(b).hexdigest();row['fields']=sorted(d)
+   if name=='relayAttestation':
+    a=d.get('operatorAllowlist',{});row['admittedAtAttach']=a.get('admittedAtAttach');row['allowedMeasurementCount']=len(a.get('measurements',[]))
+    row['measurementFields']={k:v for k,v in d.items() if k in ['measurement','format','verified','attested'] and isinstance(v,(str,bool))}
+    row['nonceRequested']=nonce
+   else:
+    row['supports']=d.get('supports');c=d.get('catalog',{});row['catalog']={k:c[k] for k in ['runtimeId','runtime','release'] if k in c};row['version']=d.get('version')
+ except Exception as e:row['error']=str(e)[:180]
+ rows.append(row)
+out={'at':datetime.datetime.now(datetime.timezone.utc).isoformat(),'readOnly':True,'observations':rows,'limits':['Relay-admitted measurement and public guestd capability observations only; not an independent fresh SNP quote verification or a custody release test. No raw quotes, chip IDs, keys or service changes.']}
+p=pathlib.Path('work/custody-v2-live-20261023/evidence/recipient-live-confirm.json');p.write_text(json.dumps(out,indent=2)+'\n');print(json.dumps(out))
