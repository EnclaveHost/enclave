new file mode 100755
index 0000000000000000000000000000000000000000..53a67835dc16c9f560ba376552bcbc66436618ae
--- /dev/null
+++ b/run-tests.sh
@@ -0,0 +1,4 @@
+#!/bin/bash
+cd "$(dirname "$0")" && mkdir -p logs
+node --test --test-concurrency=1 --test-reporter=tap test/review.test.mjs > "logs/$1.tap" 2>&1; rc=$?
+grep -E "^(not )?ok |^# (tests|pass|fail)" "logs/$1.tap"; echo "node exit=$rc"; exit $rc
diff --git a/test/review.test.mjs b/test/review.test.mjs
