+  await page.click("#check");
+  await until(async () => /^Confirmed:/.test(await p.status()), "confirmed", 25000);
+  assert.equal(p.sent.length, 0, "the page never re-sent anything");
+  assert.deepEqual(problems(p.logs), []);
+});
