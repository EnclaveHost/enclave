+    } };
+    window.addEventListener("eip6963:requestProvider", () => window.dispatchEvent(new CustomEvent("eip6963:announceProvider",
+      { detail: Object.freeze({ info: { uuid: "test", name: "MetaMask", icon: "data:,", rdns: "io.metamask" }, provider }) })));
