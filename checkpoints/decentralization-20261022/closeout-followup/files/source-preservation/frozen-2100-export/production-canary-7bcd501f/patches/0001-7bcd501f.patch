+
+const tag = (t, n) => createHash(n === 48 ? "sha384" : "sha256").update(`enclave-custody-canary-decoy-${t}-v1`).digest("hex");
+export const DECOY = Object.freeze({ measurement: tag("measurement", 48), runtimeId: tag("runtime", 32), appId: tag("app", 32) });
+export const DECOY_SENDER = "0x000000000000000000000000000000000000dead"; // eth_call only; nobody can sign for it
+
+// The pinned client code, loaded from the pinned repo path (hash-checked by the caller first).
+export async function loadClient(repo) {
+  const imp = (rel) => import(pathToFileURL(path.join(repo, rel)).href);
+  const viemEsm = path.join(repo, "node_modules/viem/_esm/index.js");
+  if (!fs.existsSync(viemEsm)) throw new Error(`${viemEsm}: the pinned repo's viem is missing`);
+  const [owner, rules, protocol, viem] = await Promise.all([imp("custody/v2/owner.mjs"), imp("custody/rules.mjs"), imp("custody/protocol.mjs"), import(pathToFileURL(viemEsm).href)]);
+  return { owner, rules, protocol, viem };
+}
+
+export function rulesFor(image, variant) {
+  const im = { platform: "sev-snp", measurement: image.measurement, runtimeId: image.runtimeId };
+  const r = { v: 1, appId: image.appId, images: [im], minTcb: image.minTcb, vmpl: 0 };
+  switch (variant) {
+    case "image": return r;
+    case "decoy-measurement": return { ...r, images: [{ ...im, measurement: DECOY.measurement }] };
+    case "decoy-runtime": return { ...r, images: [{ ...im, runtimeId: DECOY.runtimeId }] };
+    case "decoy-app": return { ...r, appId: DECOY.appId };
+    default: throw new Error(`unknown rules variant ${variant}`);
+  }
+}
+
+// chain: { block:{number,hash}, policy:{owner, policyRev, secretRev, committeeId, paused}, committee:{Y, epoch, t, W},
+//          configText, ownerNonce } — read through the agreed reader by the caller.
+// env: the marker values (in memory) when the step writes a bundle; never returned.
+export function prepareMutation({ client, pins, step, chain, env = null }) {
+  const m = step.mutation;
+  if (!m || step.status !== "ready") throw new Error(`${step.id}: not a ready mutation step`);
+  const id = m.ids[0];
+  if (id === PROTECTED_POLICY_4E62) throw new Error("refusing the protected policy 0x4e62");
+  if (BigInt(chain.policy.policyRev) !== BigInt(m.expectPolicyRev))
+    throw new Error(`${step.id}: chain policyRev ${chain.policy.policyRev} is not the planned ${m.expectPolicyRev}; the plan is out of step, nothing prepared`);
+  if (BigInt(chain.policy.policyRev) > 0n && String(chain.policy.owner).toLowerCase() !== m.from)
+    throw new Error(`${step.id}: the policy owner is not the canary owner`);
+  const committeeId = COMMITTEE_4774;
+  const rules = client.rules.validateRules(rulesFor(pins.image, m.policy.rules));
+  let bundle = null, secretRev = BigInt(chain.policy.secretRev);
+  if (m.bundle) {
+    if (!env || !Object.keys(env).length) throw new Error(`${step.id}: a bundle step needs its marker values`);
+    if (!(chain.committee?.Y instanceof Uint8Array) || chain.committee.Y.length !== 33) throw new Error(`${step.id}: the committee key Y (33 bytes, as the reader returns it) was not read`);
+    if (typeof chain.configText !== "string") throw new Error(`${step.id}: configText (from the lease envelope, \"\" for none) is required`);
+    secretRev += 1n;
+    bundle = client.owner.buildBundleV2({ chainId: 8453, vault: ORIGINAL_VAULT_V2, id, secretRev, committeeId, Y: chain.committee.Y, env, configText: chain.configText });
+  }
+  const update = client.owner.makeUpdateV2({ expectPolicyRev: BigInt(m.expectPolicyRev), policy: { committeeId, paused: m.policy.paused, rules }, bundle });
+  const data = client.viem.encodeFunctionData({ abi: client.owner.UPDATE_V2_ABI, functionName: "update", args: [id, update] });
+  const selector = client.viem.toFunctionSelector(client.owner.UPDATE_V2_ABI.find((f) => f.name === "update"));
+  const calldataSha256 = sha256hex(Buffer.from(data.slice(2), "hex"));
+  const summary = { id, expectPolicyRev: String(update.expectPolicyRev), setPolicy: update.setPolicy, committeeId: update.committeeId, paused: update.paused,
+    rulesKeccak: client.viem.keccak256(update.rules), rulesVariant: m.policy.rules, setBundle: update.setBundle,
+    bundleKeccak: update.setBundle ? client.viem.keccak256(update.bundle) : null, bundleBytes: bundle ? bundle.length : 0, nextSecretRev: String(secretRev),
+    configSha256: bundle ? client.protocol.configSha256(chain.configText) : null, clear: update.clear };
+  const prepared = { stepId: step.id, stepHash: step.stepHash, block: chain.block, expectNonce: chain.ownerNonce, calldataSha256, selector, summary };
+  prepared.preparedHash = hashOf("custody-canary-prepared-v1", prepared);
+  return { prepared, tx: { chainId: 8453, from: m.from, to: m.target, data, value: 0n } };
+}
+
+// eth_call inputs for the chain-side refusal checks (never sent).
+export function prepareSimulation({ client, pins, step, chain }) {
+  const s = step.simulate;
+  const rules = client.rules.validateRules(rulesFor(pins.image, "image"));
+  const cur = BigInt(chain.policy.policyRev);
+  if (cur < 1n) throw new Error(`${step.id}: needs an existing canary policy`);
+  const expectPolicyRev = s.expectPolicyRev === "current-1" ? cur - 1n : cur;
+  const update = client.owner.makeUpdateV2({ expectPolicyRev, policy: { committeeId: COMMITTEE_4774, paused: false, rules } });
+  const data = client.viem.encodeFunctionData({ abi: client.owner.UPDATE_V2_ABI, functionName: "update", args: [s.id, update] });
+  return { from: s.from === "decoy" ? DECOY_SENDER : String(pins.owner.address).toLowerCase(), to: ORIGINAL_VAULT_V2, data, expectRevert: s.expectRevert };
+}
+
+export function writePrivate(dir, name, value) {
+  const file = path.join(dir, name);
+  const fd = fs.openSync(file, fs.constants.O_WRONLY | fs.constants.O_CREAT | fs.constants.O_EXCL, 0o600);
+  try { fs.writeSync(fd, JSON.stringify(value, (k, v) => typeof v === "bigint" ? `n:${v}` : v, 1)); fs.fsyncSync(fd); } finally { fs.closeSync(fd); }
+  return file;
+}
diff --git a/driver/probe.mjs b/driver/probe.mjs
new file mode 100644
index 0000000000000000000000000000000000000000..5e640dd4f8b46772b4576e31d9c50963ddaa4d55
--- /dev/null
+++ b/driver/probe.mjs
@@ -0,0 +1,66 @@
+// Pre-attestation refusal probes against the REAL custodian (public endpoint). No attestation is sent or claimed:
+// the evidence field is a deliberately non-evidence object, so every request is refused before any partial could be
+// made. These show nonce single use/expiry and the chain-revision gates on the live custodian; they are NOT
+// attestation evidence and NOT state anti-replay.
+import { randomBytes } from "node:crypto";
+
+const NOT_EVIDENCE = Object.freeze({ format: "enclave-canary-not-evidence/1" });
+const PARTIAL_KEYS = /partial|share|sealed|plaintext|env/i;
+
+async function post(fetchImpl, base, path, body, timeoutMs = 20_000) {
+  const r = await fetchImpl(`${base}${path}`, { method: "POST", headers: { "content-type": "application/json" }, body: JSON.stringify(body ?? {}),
+    redirect: "error", signal: AbortSignal.timeout(timeoutMs) });
+  let j = null; try { j = await r.json(); } catch {}
+  return { status: r.status, code: j?.error ?? null, keys: j && typeof j === "object" ? Object.keys(j) : [] };
+}
+
+export function releaseBody({ id, endpoint, committeeId, epoch, policyRev, secretRev, challenge, rng = randomBytes, nowSec }) {
+  return { v: 2, id, endpoint, committeeId, epoch, policyRev: String(policyRev), secretRev: String(secretRev),
+    recipientKey: "0x" + rng(32).toString("hex"), challenges: [{ encKey: challenge.encKey, nonce: challenge.nonce }],
+    operator: { sig: "0x" + "00".repeat(65), expiry: nowSec + 300 }, evidence: NOT_EVIDENCE };
+}
+
+async function challenge(fetchImpl, base) {
+  const r = await fetchImpl(`${base}/v2/custody/challenge`, { method: "POST", headers: { "content-type": "application/json" }, body: "{}",
+    redirect: "error", signal: AbortSignal.timeout(20_000) });
+  const j = await r.json().catch(() => null);
+  if (r.status !== 200 || !/^0x[0-9a-f]{64}$/.test(String(j?.encKey)) || typeof j?.nonce !== "string") throw new Error(`challenge: HTTP ${r.status}`);
+  return { encKey: j.encKey, nonce: j.nonce };
+}
+
+// cur: { id, endpoint (the lease runner), committeeId, epoch, policyRev, secretRev } as read at an agreed block.
+export async function probeNonce({ base, cur, fetchImpl = fetch, sleep = (ms) => new Promise((r) => setTimeout(r, ms)), nowSec = () => Math.floor(Date.now() / 1000), expiryWaitMs = 125_000 }) {
+  const body = releaseBody({ ...cur, challenge: await challenge(fetchImpl, base), nowSec: nowSec() });
+  const first = await post(fetchImpl, base, "/v2/custody/release", body);
+  const replay = await post(fetchImpl, base, "/v2/custody/release", body);
+  const late = await challenge(fetchImpl, base);
+  await sleep(expiryWaitMs);
+  const expired = await post(fetchImpl, base, "/v2/custody/release", releaseBody({ ...cur, challenge: late, nowSec: nowSec() }));
+  return evalNonce({ first, replay, expired });
+}
+
+export function evalNonce({ first, replay, expired }) {
+  const noPartial = [first, replay, expired].every((r) => !r.keys.some((k) => PARTIAL_KEYS.test(k)));
+  const ok = first.status >= 400 && replay.status === 403 && replay.code === "bad_challenge" && expired.status === 403 && expired.code === "bad_challenge" && noPartial;
+  return { outcome: ok ? "pass" : "fail", evidence: { first: { status: first.status, code: first.code }, replay: { status: replay.status, code: replay.code },
+    expired: { status: expired.status, code: expired.code }, noPartial, scope: "pre-attestation refusal on the live custodian; not attestation evidence" } };
+}
+
+export async function probeStale({ base, cur, fetchImpl = fetch, nowSec = () => Math.floor(Date.now() / 1000) }) {
+  const fresh = () => challenge(fetchImpl, base);
+  const variants = {
+    staleRevision: { ...cur, policyRev: BigInt(cur.policyRev) - 1n, secretRev: BigInt(cur.secretRev) - 1n },
+    wrongCommittee: { ...cur, committeeId: "0x" + "ab".repeat(32) },
+    staleEpoch: { ...cur, epoch: cur.epoch + 1 },
+  };
+  const out = {};
+  for (const [k, v] of Object.entries(variants)) out[k] = await post(fetchImpl, base, "/v2/custody/release", releaseBody({ ...v, challenge: await fresh(), nowSec: nowSec() }));
+  return evalStale(out);
+}
+
+export function evalStale(r) {
+  const want = { staleRevision: [409, "stale_revision"], wrongCommittee: [409, "wrong_committee"], staleEpoch: [409, "stale_epoch"] };
+  const results = Object.fromEntries(Object.entries(want).map(([k, [s, c]]) => [k, { status: r[k]?.status, code: r[k]?.code, ok: r[k]?.status === s && r[k]?.code === c && !r[k].keys.some((x) => PARTIAL_KEYS.test(x)) }]));
+  return { outcome: Object.values(results).every((x) => x.ok) ? "pass" : "fail",
+    evidence: { ...results, scope: "chain-revision freshness on the live custodian; NOT sealed-state anti-replay" } };
+}
diff --git a/driver/relay.mjs b/driver/relay.mjs
new file mode 100644
index 0000000000000000000000000000000000000000..1a7360b99d2f150dbea26e49deb062f519d40c67
--- /dev/null
+++ b/driver/relay.mjs
@@ -0,0 +1,76 @@
+// Owner-signed relay calls for the canary ids, with the relay's own message formats (relay/secrets.js putMessage /
+// getMessage; cli/enclave.mjs secretsCall: expiry = now + 300). Reads return METADATA ONLY: names, rev, and whether
+// each value equals the local marker (by commitment). Values never leave this module. fetch and the signer are
+// injected, so tests touch no network and no key.
+import { createHash } from "node:crypto";
+import { commitmentOf } from "./markers.mjs";
+
+export const putMessage = (id, expiry, payload) => `enclave-secrets:put:${id}:${expiry}:${createHash("sha256").update(payload, "utf8").digest("hex")}`;
+export const getMessage = (id, expiry) => `enclave-secrets:get:${id}:${expiry}`;
+const H32 = /^0x[0-9a-f]{64}$/;
+
+async function post(fetchImpl, api, path, body, timeoutMs = 20_000) {
+  const r = await fetchImpl(`${api}${path}`, { method: "POST", headers: { "content-type": "application/json" }, body: JSON.stringify(body),
+    redirect: "error", signal: AbortSignal.timeout(timeoutMs) });
+  let j = null; try { j = await r.json(); } catch {}
+  return { status: r.status, body: j };
+}
+
+export function createRelay({ api, fetchImpl = fetch, now = () => Date.now() }) {
+  if (!/^https:\/\/[a-z0-9.-]+$/.test(api)) throw new Error("relay api must be an https origin");
+  const expiry = () => Math.floor(now() / 1000) + 300;
+  return {
+    async exists(id) {
+      if (!H32.test(id)) throw new Error("id");
+      const r = await post(fetchImpl, api, "/v1/secrets/exists", { id });
+      return { status: r.status, exists: r.body?.exists === true, custody: r.body?.custody === true };
+    },
+    // marker: { run, set, values } (in memory) — compared by commitment, never returned
+    async getMeta(id, signer, marker = null) {
+      const e = expiry();
+      const signature = await signer.signMessage({ message: getMessage(id, e) });
+      const r = await post(fetchImpl, api, `/v1/secrets/${id}/get`, { expiry: e, signature });
+      const env = r.body && typeof r.body.env === "object" && r.body.env ? r.body.env : {};
+      const names = Object.keys(env).sort();
+      const out = { status: r.status, error: r.body?.error ?? null, rev: r.body?.rev ?? null, names };
+      if (marker) out.valuesEqualMarkers = names.length === Object.keys(marker.values).length
+        && names.every((n) => n in marker.values && commitmentOf({ run: marker.run, set: marker.set, name: n, value: env[n] }) === commitmentOf({ run: marker.run, set: marker.set, name: n, value: marker.values[n] }));
+      return out;
+    },
+    // the plaintext env for ONE migration step, handed straight to buildBundleV2 and never logged
+    async getValuesForMigration(id, signer) {
+      const e = expiry();
+      const signature = await signer.signMessage({ message: getMessage(id, e) });
+      const r = await post(fetchImpl, api, `/v1/secrets/${id}/get`, { expiry: e, signature });
+      if (r.status !== 200 || !r.body?.env || !Object.keys(r.body.env).length) throw new Error(`relay holds no values for ${id} (HTTP ${r.status})`);
+      return { rev: r.body.rev, env: r.body.env };
+    },
+    async put(id, signer, payloadObj) {
+      const payload = JSON.stringify(payloadObj);
+      const e = expiry();
+      const signature = await signer.signMessage({ message: putMessage(id, e, payload) });
+      const r = await post(fetchImpl, api, `/v1/secrets/${id}`, { payload, expiry: e, signature });
+      return { status: r.status, error: r.body?.error ?? null };
+    },
+  };
+}
+
+// --- evaluations (pure) ---
+export function evalLegacyCheck({ meta, exists, markerNames }) {
+  const ok = meta.status === 200 && meta.valuesEqualMarkers === true && JSON.stringify(meta.names) === JSON.stringify([...markerNames].sort())
+    && exists.exists === true && exists.custody === false;
+  return { outcome: ok ? "pass" : "fail", evidence: { getStatus: meta.status, names: meta.names, valuesEqualMarkers: meta.valuesEqualMarkers, exists: exists.exists, custody: exists.custody } };
+}
+export function evalRelayRefusals({ heldSet, strangerGet, exists }) {
+  const ok = heldSet.status === 409 && heldSet.error === "custody_held" && [401, 403].includes(strangerGet.status) && strangerGet.names.length === 0 && exists.custody === true;
+  return { outcome: ok ? "pass" : "fail", evidence: { heldSet, strangerGet: { status: strangerGet.status, error: strangerGet.error, names: strangerGet.names.length }, exists } };
+}
+export function evalClearProof({ ownerGet, hasIdOnRelayHost, markerSearch, retentionListed }) {
+  const reasons = [];
+  if (ownerGet.status !== 200 || ownerGet.names.length !== 0) reasons.push("owner /get still names values");
+  if (hasIdOnRelayHost !== false) reasons.push("secrets.json still has the id (root R5 read)");
+  if (markerSearch?.outcome !== "pass") reasons.push("marker search did not pass");
+  if (!Array.isArray(retentionListed)) reasons.push("R6 retention inventory (backups/snapshots) not recorded");
+  return { outcome: reasons.length ? "fail" : "pass", evidence: { ownerGetNames: ownerGet.names.length, ownerGetRev: ownerGet.rev, hasIdOnRelayHost, retentionListed,
+    limitation: "clears the live relay store only; backups, snapshots, journals of earlier hosts and process memory are listed, not cleared" }, reasons };
+}
diff --git a/driver/tx.mjs b/driver/tx.mjs
new file mode 100644
index 0000000000000000000000000000000000000000..c1ee1ef3fb77d6740bbc38c5c694d73c56ea3053
--- /dev/null
+++ b/driver/tx.mjs
@@ -0,0 +1,80 @@
+// ONE bounded owner transaction per execute call. Everything is pinned by the plan step and the prepared record and is
+// re-checked here: target contract, function selector, the deployment id inside the calldata, the exact calldata hash,
+// chain id, zero value, sender = the pinned canary owner, gas cap, fee ceiling and total-cost cap, the owner's
+// balance, and the operator's typed confirmation of the PREPARED hash.
+// It simulates first (eth_call from the owner), refuses when the estimate exceeds the cap, sends with gas = cap, and
+// waits a bounded time for the receipt. It never retries a send: a missing receipt is recorded as UNKNOWN and the
+// step is closed; the next read decides what happened.
+import { createHash } from "node:crypto";
+
+export const BASE_CHAIN_ID = 8453;
+export const GLOBAL_GAS_CAP = 3_000_000n;
+export const GLOBAL_FEE_CAP = 100_000_000n;              // 0.1 gwei per gas
+export const GLOBAL_COST_CAP_WEI = 300_000_000_000_000n; // 0.0003 ETH per transaction, whatever the step says
+
+const sha = (hex) => createHash("sha256").update(Buffer.from(hex.replace(/^0x/, ""), "hex")).digest("hex");
+const lc = (a) => String(a).toLowerCase();
+
+// prepared: { stepId, stepHash, calldataSha256, preparedHash, ... } from prepare.mjs; selector: the pinned ABI's
+// selector of step.mutation.fn.
+export function checkTxAgainstStep(tx, step, prepared, selector) {
+  const m = step.mutation;
+  if (!m) throw new Error(`${step.id}: not a mutation step`);
+  if (!prepared || prepared.stepId !== step.id || prepared.stepHash !== step.stepHash) throw new Error("tx: the prepared record is not for this step of this plan");
+  if (tx.chainId !== BASE_CHAIN_ID || m.chainId !== BASE_CHAIN_ID) throw new Error("tx: Base mainnet (8453) only");
+  if (lc(tx.to) !== lc(m.target)) throw new Error(`tx: target ${tx.to} is not the pinned ${m.target}`);
+  if (lc(tx.from) !== lc(m.from)) throw new Error("tx: sender is not the pinned canary owner");
+  if (BigInt(tx.value || 0) !== 0n) throw new Error("tx: value must be zero");
+  const data = lc(tx.data);
+  if (!/^0x[0-9a-f]{8}([0-9a-f]{64})+$/.test(data)) throw new Error("tx: calldata is not a selector plus ABI words");
+  if (data.slice(0, 10) !== lc(selector)) throw new Error(`tx: selector ${data.slice(0, 10)} is not ${m.fn}`);
+  const id = "0x" + data.slice(10, 74);
+  if (!m.ids.map(lc).includes(id)) throw new Error(`tx: calldata names deployment ${id}, not this step's canary`);
+  if (sha(data) !== prepared.calldataSha256) throw new Error("tx: calldata differs from the prepared calldata");
+  const gasCap = BigInt(m.gasCap), fee = BigInt(m.maxFeePerGasWei), costCap = BigInt(m.maxCostWei);
+  if (gasCap <= 0n || gasCap > GLOBAL_GAS_CAP) throw new Error("tx: gas cap out of bounds");
+  if (fee <= 0n || fee > GLOBAL_FEE_CAP) throw new Error("tx: fee ceiling out of bounds");
+  if (costCap !== gasCap * fee || costCap > GLOBAL_COST_CAP_WEI) throw new Error("tx: cost cap must be gasCap x fee ceiling and within the global cap");
+  return { gasCap, fee, costCap };
+}
+
+// client: { getBalance, call, estimateGas, getGasPrice, getTransactionCount, sendTransaction, waitForReceipt } — a thin
+// adapter over viem (cli.mjs), injected so tests never touch a chain.
+export async function executeTx({ step, prepared, selector, tx, confirm, client, timeoutMs = 120_000 }) {
+  if (confirm !== prepared?.preparedHash) throw new Error(`${step.id}: --confirm must equal the prepared hash`);
+  const { gasCap, fee, costCap } = checkTxAgainstStep(tx, step, prepared, selector);
+  const ev = { simulated: false, estimate: null, gasCap: String(gasCap), maxFeePerGas: String(fee), nonce: null };
+  const balance = await client.getBalance({ address: tx.from });
+  if (balance < costCap) return { outcome: "fail", evidence: { ...ev, refusedBy: "balance below this step's cost cap", balance: String(balance) } };
+  try { await client.call({ from: tx.from, to: tx.to, data: tx.data }); }
+  catch (e) { return { outcome: "fail", evidence: { ...ev, refusedBy: "simulation", reason: String(e.shortMessage || e.message).slice(0, 200) } }; }
+  ev.simulated = true;
+  const estimate = await client.estimateGas({ from: tx.from, to: tx.to, data: tx.data });
+  ev.estimate = String(estimate);
+  if (estimate > gasCap) return { outcome: "fail", evidence: { ...ev, refusedBy: "gas cap" } };
+  const price = await client.getGasPrice();
+  ev.gasPrice = String(price);
+  if (price * 2n > fee) return { outcome: "fail", evidence: { ...ev, refusedBy: "fee ceiling (gas price above half the pinned ceiling)" } };
+  const nonce = await client.getTransactionCount({ address: tx.from, blockTag: "pending" });
+  if (prepared.expectNonce !== undefined && nonce !== prepared.expectNonce) return { outcome: "fail", evidence: { ...ev, refusedBy: "nonce moved since prepare", nonce } };
+  ev.nonce = nonce;
+  const hash = await client.sendTransaction({ from: tx.from, to: tx.to, data: tx.data, value: 0n, gas: gasCap,
+    maxFeePerGas: fee, maxPriorityFeePerGas: price < fee ? price : fee, nonce, chainId: tx.chainId });
+  ev.txHash = hash;
+  let receipt;
+  try { receipt = await client.waitForReceipt(hash, timeoutMs); }
+  catch { return { outcome: "aborted", evidence: { ...ev, receipt: "UNKNOWN: not seen within the bound; read the chain before any next step" } }; }
+  Object.assign(ev, { blockNumber: String(receipt.blockNumber), gasUsed: String(receipt.gasUsed), status: receipt.status,
+    effectiveGasPrice: String(receipt.effectiveGasPrice ?? "") });
+  return { outcome: receipt.status === "success" ? "pass" : "fail", evidence: ev };
+}
+
+// A chain-side refusal check: eth_call ONLY. Passes when the call reverts with the expected custom error name.
+export async function simulateRefusal({ client, from, to, data, expectRevert }) {
+  try { await client.call({ from, to, data }); }
+  catch (e) {
+    const name = e.errorName || e.cause?.data?.errorName || (/reverted[^:]*: (\w+)/.exec(String(e.shortMessage || e.message)) || [])[1] || null;
+    return { outcome: name === expectRevert ? "pass" : "fail", evidence: { reverted: true, errorName: name, expected: expectRevert } };
+  }
+  return { outcome: "fail", evidence: { reverted: false, expected: expectRevert, note: "the call SUCCEEDED; nothing was sent" } };
+}
diff --git a/pins.example.json b/pins.example.json
new file mode 100644
index 0000000000000000000000000000000000000000..c30ddeeb001e27540b11719fba0c1921125e3f1f
--- /dev/null
+++ b/pins.example.json
@@ -0,0 +1,81 @@
+{
+  "v": 1,
+  "runLabel": "20261023T000000Z",
+  "chainId": 8453,
+  "vaultV2": "0xe48699b8401564aace7a814ae4569b67a3f7eef5",
+  "vaultCodeHash": "0x4b949b378382d7fa862e7bc1552b58547ce811527c9746f4d9a0d39a8b4f716b",
+  "committee": {
