+  assert.equal(r.outcome, "pass");
+  const sent = c.calls.find((x) => x[0] === "send")[1];
+  assert.equal(sent.gas, 400000n); assert.equal(sent.maxFeePerGas, 20_000_000n); assert.equal(sent.value, 0n); assert.equal(sent.nonce, 7);
