+print('literal files', bad); sys.exit(1 if bad else 0)
+PY
+echo "[scan] gitleaks=$g scan-crypto-keys=$k literal=$l"; [ $g -eq 0 ] && [ $k -eq 0 ] && [ $l -eq 0 ]
