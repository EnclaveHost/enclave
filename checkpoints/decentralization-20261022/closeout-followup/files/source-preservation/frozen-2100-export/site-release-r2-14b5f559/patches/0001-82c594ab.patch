+    add("empty-data diamond, depth 26 (2^27 walks, no output)", n.cid, F.car(n.cid, F.blocksOf(n)), null); }
+  { const d = cfg(14, 10); let n = F.leaf("raw", d); for (let i = 0; i < 1100; i++) n = F.node([n]);
