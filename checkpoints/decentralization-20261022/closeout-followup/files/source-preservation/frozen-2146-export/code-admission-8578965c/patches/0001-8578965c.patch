+package custody
+
+// Custody v2 (docs/security/secret-custody-v2.md): ONE committee key Y = x·G held by host custodians in their TEEs; a
+// bundle is threshold ElGamal (R = r·G, S = r·Y) with a label proof; each custodian answers a release with partial
+// decryptions D_k = x_k·R and a DLEQ proof per share index it holds; the guest verifies every proof against Y_k from the
+// on-chain commitments, combines exactly t of them in the exponent, and opens the bundle under HKDF(S, label).
+//
+// custody/v2/protocol.mjs is the reference for every byte; testdata/v2-vectors.json (scripts/custody-v2-vectors.mjs) pins
+// this file to it. Point arithmetic is github.com/decred/dcrd/dcrec/secp256k1/v4 (its variable-time operations: every
+// input here is public or, for D_k and S, already sealed to this guest; the guest holds no long-term secret scalar).
+//
+// WHAT THIS IS: textbook constructions (threshold ElGamal with a TDH2-style label proof, Chaum-Pedersen DLEQ, Shamir in the
+// exponent). It has NOT had an external review.
+
+import (
+	"crypto/aes"
+	"crypto/cipher"
+	"crypto/ecdh"
+	"crypto/hkdf"
+	"crypto/sha256"
+	"crypto/sha512"
+	"encoding/binary"
+	"encoding/hex"
+	"encoding/json"
+	"errors"
+	"fmt"
+	"math/big"
+	"sort"
+
+	"github.com/decred/dcrd/dcrec/secp256k1/v4"
+
+	"enclave.host/isolation/m2/custody/seats"
+)
+
+const (
+	domainV2Label      = "enclave-custody-v2 label\n"
+	domainV2POK        = "enclave-custody-v2 pok\n"
+	domainV2DLEQ       = "enclave-custody-v2 dleq\n"
+	domainV2Partial    = "enclave-custody-v2 partial\n"
+	domainV2Challenges = "enclave-custody-v2 challenges\n"
+	domainV2Release    = "enclave-custody-release-v2\n"
+	infoV2KDF          = "enclave-custody-v2 key"
+	infoV2Partial      = "enclave-custody-v2 partial-release"
+
+	// PartialRecordBytes is one partial: u32 k ‖ D_k (33) ‖ c (32) ‖ z (32).
+	PartialRecordBytes = 101
+	// MaxBundleBytes is the vault's bound on a v2 bundle (EnclaveSecretVaultV2, 24 KiB).
+	MaxBundleBytes = 24 * 1024
+	// MaxMachinesV2 and MaxSeatsV2 bound a v2 committee (custody/v2/protocol.mjs).
+	MaxMachinesV2 = seats.MaxMachines
+	MaxSeatsV2    = seats.MaxSeats
+	// minBundleBytes: R (33) ‖ c (32) ‖ z (32) ‖ nonce (12) ‖ GCM tag (16).
+	minBundleBytes = 33 + 64 + 12 + 16
+)
+
+// ---- scalars and points ----
+
+// HashToScalar is int(SHA-512(parts...)) mod q.
+func HashToScalar(parts ...[]byte) *secp256k1.ModNScalar {
+	h := sha512.Sum512(cat(parts...))
+	n := new(big.Int).Mod(new(big.Int).SetBytes(h[:]), order)
+	return modN(n)
+}
+
+func modN(n *big.Int) *secp256k1.ModNScalar {
+	var b [32]byte
+	new(big.Int).Mod(n, order).FillBytes(b[:])
+	var s secp256k1.ModNScalar
+	s.SetBytes(&b)
+	return &s
+}
+
+// scalarV2 is a 32-byte big-endian scalar in [1, q): a value >= q is refused, never reduced, and so is zero (the
+// reference's base multiplication refuses 0, and no honest proof carries it).
+func scalarV2(b []byte, what string) (*secp256k1.ModNScalar, error) {
+	if len(b) != 32 {
+		return nil, fmt.Errorf("%s: 32 bytes", what)
+	}
+	var a [32]byte
+	copy(a[:], b)
+	var s secp256k1.ModNScalar
+	if s.SetBytes(&a) != 0 {
+		return nil, fmt.Errorf("%s: out of range", what)
+	}
+	if s.IsZero() {
+		return nil, fmt.Errorf("%s: zero", what)
+	}
+	return &s, nil
+}
+
+// Point is a secp256k1 point (Jacobian). PointOf never returns the identity.
+type Point = secp256k1.JacobianPoint
+
+type point = Point
+
+func isIdentity(p *point) bool {
+	x, y, z := p.X, p.Y, p.Z
+	x.Normalize()
+	y.Normalize()
+	z.Normalize()
+	return (x.IsZero() && y.IsZero()) || z.IsZero()
+}
+
+// PointOf parses a 33-byte compressed point (0x02/0x03 prefix, on the curve). The identity has no such encoding.
+func PointOf(b []byte, what string) (*point, error) {
+	if len(b) != PointBytes || (b[0] != 0x02 && b[0] != 0x03) {
+		return nil, fmt.Errorf("%s: not a 33-byte compressed point", what)
+	}
+	pk, err := secp256k1.ParsePubKey(b)
+	if err != nil {
+		return nil, fmt.Errorf("%s: not a curve point", what)
+	}
+	var p point
+	pk.AsJacobian(&p)
+	return &p, nil
+}
+
+// PointBytesOf is the 33-byte compressed encoding; the identity has none and is refused.
+func PointBytesOf(p *point) ([]byte, error) {
+	if isIdentity(p) {
+		return nil, errors.New("the identity point")
+	}
+	a := *p
+	a.ToAffine()
+	return secp256k1.NewPublicKey(&a.X, &a.Y).SerializeCompressed(), nil
+}
+
+func mulG(s *secp256k1.ModNScalar) *point {
+	var r point
+	secp256k1.ScalarBaseMultNonConst(s, &r)
+	return &r
+}
+
+func mul(p *point, s *secp256k1.ModNScalar) *point {
+	var r point
+	secp256k1.ScalarMultNonConst(s, p, &r)
+	return &r
+}
+
+func add(a, b *point) *point {
+	var r point
+	secp256k1.AddNonConst(a, b, &r)
+	return &r
+}
+
+// sub is a - s·b
+func subMul(a, b *point, s *secp256k1.ModNScalar) *point {
+	var neg secp256k1.ModNScalar
+	neg.NegateVal(s)
+	return add(a, mul(b, &neg))
+}
+
+func pointsEqual(a, b *point) bool {
+	ab, err1 := PointBytesOf(a)
+	bb, err2 := PointBytesOf(b)
+	return err1 == nil && err2 == nil && string(ab) == string(bb)
+}
+
+// PublicShare is Y_k = Σ_j C_j·k^j from the commitments alone; an identity result is refused.
+func PublicShare(k uint32, commitments [][]byte) (*point, error) {
+	if k < 1 || k > 2*MaxSeatsV2 {
+		return nil, errors.New("bad share index")
+	}
+	if len(commitments) == 0 {
+		return nil, errors.New("no commitments")
+	}
+	var acc point // the identity
+	var kp secp256k1.ModNScalar
+	kp.SetInt(1)
+	var ks secp256k1.ModNScalar
+	ks.SetInt(k)
+	for j, c := range commitments {
+		C, err := PointOf(c, fmt.Sprintf("commitment %d", j))
+		if err != nil {
+			return nil, err
+		}
+		acc = *add(&acc, mul(C, &kp))
+		kp.Mul(&ks)
+	}
+	if isIdentity(&acc) {
+		return nil, fmt.Errorf("public share %d is the identity", k)
+	}
+	return &acc, nil
+}
+
+// lagrangeAt0 is λ_k(T) at 0 over the index set T.
+func lagrangeAt0(k uint32, set []uint32) (*secp256k1.ModNScalar, error) {
+	num, den := big.NewInt(1), big.NewInt(1)
+	for _, m := range set {
+		if m == k {
+			continue
+		}
+		num.Mod(num.Mul(num, big.NewInt(int64(m))), order)
+		den.Mod(den.Mul(den, big.NewInt(int64(m)-int64(k))), order)
+	}
+	inv := new(big.Int).ModInverse(den, order)
+	if inv == nil {
+		return nil, errors.New("no inverse")
+	}
+	return modN(num.Mul(num, inv)), nil
+}
+
+// ---- seats ----
+
+// SeatLayout is custody/v2/protocol.mjs seatLayout over the machines' Enclave flags, in machine order.
+func SeatLayout(enclave []bool) (*seats.Layout, error) { return seats.Of(enclave) }
+
+// ---- label, challenges, binding ----
+
+// LabelInput names one bundle.
+type LabelInput struct {
+	Ctx         Context
+	ID          [32]byte
+	SecretRev   uint64
+	CommitteeID [32]byte
+}
+
+// LabelOf is SHA-256(LABEL ‖ u64 chainId ‖ vault ‖ id ‖ u64 secretRev ‖ committeeId).
+func LabelOf(in LabelInput) [32]byte {
+	return sum([]byte(domainV2Label), in.Ctx.bytes(), in.ID[:], u64(in.SecretRev), in.CommitteeID[:])
+}
+
+// ChallengeRootV2 commits to every challenge a v2 release carries, sorted by custodian key; duplicates are refused.
+func ChallengeRootV2(ch []Challenge) ([32]byte, error) {
+	if len(ch) == 0 || len(ch) > MaxMachinesV2 {
+		return [32]byte{}, fmt.Errorf("challenges: 1..%d entries", MaxMachinesV2)
+	}
+	rows := append([]Challenge(nil), ch...)
+	sort.Slice(rows, func(i, j int) bool { return string(rows[i].EncKey[:]) < string(rows[j].EncKey[:]) })
+	parts := [][]byte{[]byte(domainV2Challenges), u32(uint32(len(rows)))}
+	for i, r := range rows {
+		if i > 0 && r.EncKey == rows[i-1].EncKey {
+			return [32]byte{}, errors.New("challenges: duplicate custodian")
+		}
+		parts = append(parts, r.EncKey[:], r.Nonce[:])
+	}
+	return sum(parts...), nil
+}
+
+// BindingInputV2 is everything report_data[0:32] commits to for one v2 release.
+type BindingInputV2 struct {
+	Ctx           Context
+	ID            [32]byte
+	PolicyRev     uint64
+	SecretRev     uint64
+	CommitteeID   [32]byte
+	Epoch         uint32
+	Challenges    []Challenge
+	RuntimeID     [32]byte
+	TransportSPKI []byte
+	RecipientKey  [32]byte
+}
+
+// BindingV2 is report_data[0:32] of a v2 custody release report.
+func BindingV2(in BindingInputV2) ([32]byte, error) {
+	if len(in.TransportSPKI) < 32 {
+		return [32]byte{}, errors.New("the transport key must be a DER SPKI")
+	}
+	root, err := ChallengeRootV2(in.Challenges)
+	if err != nil {
+		return [32]byte{}, err
+	}
+	spki := sha256.Sum256(in.TransportSPKI)
+	return sum([]byte(domainV2Release), in.Ctx.bytes(), in.ID[:], u64(in.PolicyRev), u64(in.SecretRev), in.CommitteeID[:],
+		u32(in.Epoch), root[:], in.RuntimeID[:], spki[:], in.RecipientKey[:]), nil
+}
+
+// OperatorMessageV2 is what the lease holder's operator signs (personal_sign) for one v2 release (the supervisor signs it;
+// the guest never does). Kept here so the two halves can be tested against one definition.
+func OperatorMessageV2(c Context, id [32]byte, endpoint string, binding [32]byte, expiry int64) string {
+	return fmt.Sprintf("enclave-custody-release-v2:%d:0x%s:0x%s:%s:%s:%d", c.ChainID, hex.EncodeToString(c.Vault[:]), hex.EncodeToString(id[:]),
+		endpoint, hex.EncodeToString(binding[:]), expiry)
+}
+
+// ---- the bundle ----
+
+// BundleV2 is a parsed v2 bundle: R ‖ proof (c ‖ z) ‖ nonce ‖ ciphertext. Shape only.
+type BundleV2 struct {
+	R      *point
+	c, z   *secp256k1.ModNScalar
+	Sealed []byte // nonce (12) ‖ AES-256-GCM ciphertext
+}
+
+// ParseBundleV2 parses a bundle's shape: R a curve point, c and z in range.
+func ParseBundleV2(b []byte) (*BundleV2, error) {
+	if len(b) < minBundleBytes {
+		return nil, errors.New("bundle too short")
+	}
+	if len(b) > MaxBundleBytes {
+		return nil, errors.New("bundle too long")
+	}
+	R, err := PointOf(b[:33], "bundle R")
+	if err != nil {
+		return nil, err
+	}
+	c, err := scalarV2(b[33:65], "proof c")
+	if err != nil {
+		return nil, err
+	}
+	z, err := scalarV2(b[65:97], "proof z")
+	if err != nil {
+		return nil, err
+	}
+	return &BundleV2{R: R, c: c, z: z, Sealed: b[97:]}, nil
+}
+
+// VerifyLabelProof checks the bundle's Schnorr proof of knowledge of r against label: the custodians answer only a bundle
+// whose proof names this deployment, and the guest checks the same before it asks.
+func VerifyLabelProof(bundle []byte, label [32]byte) bool {
+	p, err := ParseBundleV2(bundle)
+	if err != nil {
+		return false
+	}
+	A := subMul(mulG(p.z), p.R, p.c)
+	ab, err := PointBytesOf(A)
+	if err != nil {
+		return false
+	}
+	rb, _ := PointBytesOf(p.R)
+	return HashToScalar([]byte(domainV2POK), label[:], rb, ab).Equals(p.c)
+}
+
+// DecryptBundleV2 derives K = HKDF-SHA256(ikm = S (33), salt = label, info "enclave-custody-v2 key") and opens the
+// AES-256-GCM ciphertext under aad = label; the plaintext is {"v":2,"env":{...},"configSha256":"<hex>"}.
+func DecryptBundleV2(S *point, label [32]byte, bundle []byte) (*Bundle, error) {
+	p, err := ParseBundleV2(bundle)
+	if err != nil {
+		return nil, err
+	}
+	sb, err := PointBytesOf(S)
+	if err != nil {
+		return nil, err
+	}
+	k, err := hkdf.Key(sha256.New, sb, label[:], infoV2KDF, 32)
+	if err != nil {
+		return nil, err
+	}
+	defer clear(k)
+	blk, err := aes.NewCipher(k)
+	if err != nil {
+		return nil, err
+	}
+	g, err := cipher.NewGCM(blk)
+	if err != nil {
+		return nil, err
+	}
+	pt, err := g.Open(nil, p.Sealed[:12], p.Sealed[12:], label[:])
+	if err != nil {
+		return nil, errors.New("the bundle does not open under the combined key")
+	}
+	defer clear(pt)
+	var o struct {
+		V            *int              `json:"v"`
+		Env          map[string]string `json:"env"`
+		ConfigSha256 string            `json:"configSha256"`
+	}
+	if err := json.Unmarshal(pt, &o); err != nil {
+		return nil, fmt.Errorf("bundle plaintext: %w", err)
+	}
+	if o.V == nil || *o.V != 2 {
+		return nil, errors.New("unknown bundle version")
+	}
+	if !hex64.MatchString(o.ConfigSha256) {
+		return nil, errors.New("the bundle commits no config")
+	}
+	if o.Env == nil {
+		return nil, errors.New("env must be an object of NAME: value")
+	}
+	if err := CheckEnv(o.Env); err != nil {
+		return nil, err
+	}
+	return &Bundle{Env: o.Env, ConfigSha256: o.ConfigSha256}, nil
+}
+
+// ---- partials ----
+
+// Partial is one verified partial decryption D_k = x_k·R.
+type Partial struct {
+	K uint32
+	D *point
+}
+
+// VerifyPartial checks one 101-byte record's DLEQ proof (log_G Y_k = log_R D_k) against Y_k from the commitments, under
+// this release's binding. Identity points and out-of-range scalars are refused.
+func VerifyPartial(record []byte, R *point, binding [32]byte, commitments [][]byte) (Partial, error) {
+	if len(record) != PartialRecordBytes {
+		return Partial{}, errors.New("partial: 101 bytes")
+	}
+	k := binary.BigEndian.Uint32(record[:4])
+	D, err := PointOf(record[4:37], "partial D")
+	if err != nil {
+		return Partial{}, err
+	}
+	c, err := scalarV2(record[37:69], "partial c")
+	if err != nil {
+		return Partial{}, err
+	}
+	z, err := scalarV2(record[69:101], "partial z")
+	if err != nil {
+		return Partial{}, err
+	}
+	Yk, err := PublicShare(k, commitments)
+	if err != nil {
+		return Partial{}, err
+	}
+	A1 := subMul(mulG(z), Yk, c)
+	A2 := subMul(mul(R, z), D, c)
+	var enc [5][]byte
+	for i, p := range []*point{Yk, R, D, A1, A2} {
+		if enc[i], err = PointBytesOf(p); err != nil {
+			return Partial{}, fmt.Errorf("partial for index %d: the proof does not verify", k)
+		}
+	}
+	c2 := HashToScalar([]byte(domainV2DLEQ), binding[:], u32(k), enc[0], enc[1], enc[2], enc[3], enc[4])
+	if !c2.Equals(c) {
+		return Partial{}, fmt.Errorf("partial for index %d: the proof does not verify", k)
+	}
+	return Partial{K: k, D: D}, nil
+}
+
+// PartialAAD is SHA-256(PARTIAL ‖ binding ‖ memberEncKey ‖ u32 count).
+func PartialAAD(binding, encKey [32]byte, count int) []byte {
+	a := sum([]byte(domainV2Partial), binding[:], encKey[:], u32(uint32(count)))
+	return a[:]
+}
+
+// OpenPartials opens one member's answer (HPKE to the recipient key under PARTIAL_INFO) into exactly count records.
+func OpenPartials(sk *ecdh.PrivateKey, binding, encKey [32]byte, count int, sealed []byte) ([][]byte, error) {
+	if count < 1 || count > 2*MaxSeatsV2 {
+		return nil, errors.New("partials: bad count")
+	}
+	pt, err := Open(sk, []byte(infoV2Partial), PartialAAD(binding, encKey, count), sealed)
+	if err != nil {
+		return nil, err
+	}
+	if len(pt) != count*PartialRecordBytes {
+		return nil, errors.New("partials: wrong length")
+	}
+	out := make([][]byte, count)
+	for i := range out {
+		out[i] = pt[i*PartialRecordBytes : (i+1)*PartialRecordBytes]
+	}
+	return out, nil
+}
+
+// Combine is S = Σ λ_k(T)·D_k over EXACTLY t verified partials with distinct indices.
+func Combine(ps []Partial, t int) (*point, error) {
+	if t < 1 || len(ps) != t {
+		return nil, fmt.Errorf("combine: exactly %d distinct share indices", t)
+	}
+	ks := make([]uint32, len(ps))
+	seen := map[uint32]bool{}
+	for i, p := range ps {
+		if seen[p.K] || p.D == nil {
+			return nil, fmt.Errorf("combine: exactly %d distinct share indices", t)
+		}
+		seen[p.K] = true
+		ks[i] = p.K
+	}
+	var S point
+	for _, p := range ps {
+		l, err := lagrangeAt0(p.K, ks)
+		if err != nil {
+			return nil, err
+		}
+		S = *add(&S, mul(p.D, l))
+	}
+	if isIdentity(&S) {
+		return nil, errors.New("combine: identity")
+	}
+	return &S, nil
+}
+
+// SplitCommitmentsV2 splits a v2 pointer's commitments (t x 33 bytes), each checked to be a curve point.
+func SplitCommitmentsV2(b []byte, t int) ([][]byte, error) {
+	if t < 1 || len(b) != t*PointBytes {
+		return nil, fmt.Errorf("commitments: %d x 33 bytes", t)
+	}
+	out := make([][]byte, t)
+	for j := range out {
+		out[j] = b[j*PointBytes : (j+1)*PointBytes]
+		if _, err := PointOf(out[j], fmt.Sprintf("commitment %d", j)); err != nil {
+			return nil, err
+		}
+	}
+	return out, nil
+}
diff --git a/orig-9d43/isolation/m2/custody/v2client.go b/orig-9d43/isolation/m2/custody/v2client.go
new file mode 100644
index 0000000000000000000000000000000000000000..be9bb21923e4706efb3e9a4631f5c7395fff1878
--- /dev/null
+++ b/orig-9d43/isolation/m2/custody/v2client.go
@@ -0,0 +1,340 @@
+package custody
+
+// The v2 release, as the measured front runs it (docs/security/secret-custody-v2-spec.md §4):
+//
+//  1. ask EVERY machine of the committee's epoch for a challenge; E = the Enclave machines that answered;
+//  2. a fresh recipient key, the v2 binding over the challenges that answered, hardware evidence over it (report_data =
+//     binding ‖ AppID, the front's half) and the lease holder's operator authorization (custody-auth-v2);
+//  3. the release to every machine that issued a challenge; each answer opens only under the recipient key and this
+//     binding, and EVERY partial record in it must verify (DLEQ against Y_k from the commitments) and be for exactly the
+//     indices that machine holds: a machine with one bad record is dropped whole;
+//  4. THE ENCLAVE RULE (§6.2 rule 3): if E is non-empty, the combination uses exactly ONE Enclave machine's partials (all
+//     of the Enclave seat's indices, from that single machine) and the rest from other seats; if no Enclave machine in E
+//     released valid partials, the release is REFUSED. If E is empty, t indices from the other seats;
+//  5. combine exactly t partials, open the bundle under its label. Fewer than t: refuse; the app does not start.
+//
+// Because every partial is verified before it is used, a lying custodian is identified and dropped; it cannot make the
+// guest combine a wrong key, so no subset search is needed (v1's MaxSubsets does not apply).
+
+import (
+	"context"
+	"crypto/ecdh"
+	"encoding/base64"
+	"encoding/hex"
+	"encoding/json"
+	"errors"
+	"fmt"
+	"sort"
+	"strconv"
+	"sync"
+
+	"enclave.host/isolation/m2/custody/seats"
+)
+
+// MachineV2 is one custodian machine of the committee's epoch, in machine order.
+type MachineV2 struct {
+	EncKey   [32]byte
+	Endpoint string // https base URL (may carry a path prefix); the API paths are appended
+	Enclave  bool
+	Indices  []uint32
+}
+
+// StateV2 is what a v2 release needs to know about the deployment's custody (the relay-signed v2 pointer).
+type StateV2 struct {
+	Ctx         Context
+	ID          [32]byte
+	CommitteeID [32]byte
+	PolicyRev   uint64
+	SecretRev   uint64
+	Epoch       uint32
+	Threshold   int
+	Commitments [][]byte // t x 33
+	Bundle      []byte   // R ‖ proof ‖ nonce ‖ ct
+	Machines    []MachineV2
+}
+
+// check checks the state's shape against the seat layout, and the bundle's label proof against this deployment.
+func (s *StateV2) check() (label [32]byte, l *seats.Layout, err error) {
+	if s.PolicyRev == 0 || s.SecretRev == 0 || s.Epoch == 0 || s.Ctx.ChainID == 0 {
+		return label, nil, errors.New("the custody state is incomplete")
+	}
+	flags := make([]bool, len(s.Machines))
+	keys := map[[32]byte]bool{}
+	for i, m := range s.Machines {
+		flags[i] = m.Enclave
+		if keys[m.EncKey] {
+			return label, nil, fmt.Errorf("machine %d repeats another machine's key", i)
+		}
+		keys[m.EncKey] = true
+	}
+	if l, err = SeatLayout(flags); err != nil {
+		return label, nil, err
+	}
+	if l.T != s.Threshold {
+		return label, nil, fmt.Errorf("the pointer's threshold %d is not its seat layout's %d", s.Threshold, l.T)
+	}
+	for i, m := range s.Machines {
+		if !equalIndices(m.Indices, l.Indices[i]) {
+			return label, nil, fmt.Errorf("machine %d's share indices are not its seat's", i)
+		}
+	}
+	if len(s.Commitments) != s.Threshold {
+		return label, nil, fmt.Errorf("%d commitments for threshold %d", len(s.Commitments), s.Threshold)
+	}
+	for j, c := range s.Commitments {
+		if _, err := PointOf(c, fmt.Sprintf("commitment %d", j)); err != nil {
+			return label, nil, err
+		}
+	}
+	label = LabelOf(LabelInput{Ctx: s.Ctx, ID: s.ID, SecretRev: s.SecretRev, CommitteeID: s.CommitteeID})
+	if !VerifyLabelProof(s.Bundle, label) {
+		return label, nil, errors.New("the bundle's label proof does not name this deployment")
+	}
+	return label, l, nil
+}
+
+func equalIndices(a, b []uint32) bool {
+	if len(a) != len(b) {
+		return false
+	}
+	for i := range a {
+		if a[i] != b[i] {
+			return false
+		}
+	}
+	return true
+}
+
+type wireChallengeV2 struct {
+	EncKey    string `json:"encKey"`
+	Nonce     string `json:"nonce"`
+	ExpiresAt int64  `json:"expiresAt,omitempty"`
+}
+
+type wireReleaseV2 struct {
+	V            int             `json:"v"`
+	ID           string          `json:"id"`
+	Endpoint     string          `json:"endpoint"`
+	CommitteeID  string          `json:"committeeId"`
+	Epoch        uint32          `json:"epoch"`
+	PolicyRev    string          `json:"policyRev"`
+	SecretRev    string          `json:"secretRev"`
+	RecipientKey string          `json:"recipientKey"`
+	Challenges   []wireChallenge `json:"challenges"`
+	Operator     wireOperator    `json:"operator"`
+	Evidence     json.RawMessage `json:"evidence"`
+}
+
+type wirePartialsV2 struct {
+	V      int    `json:"v"`
+	EncKey string `json:"encKey"`
+	Count  int    `json:"count"`
+	Sealed string `json:"sealed"`
+}
+
+// ObtainV2 returns the deployment's opened v2 bundle, or an error naming why not. The recipient key lives only in this
+// call. The CALLER must refuse to substitute the values into any config whose sha256 is not Bundle.ConfigSha256.
+func (c *Client) ObtainV2(ctx context.Context, st StateV2) (*Bundle, error) {
+	if c.AuthorizeV2 == nil {
+		return nil, errors.New("no custody-auth-v2 channel")
+	}
+	label, lay, err := st.check()
+	if err != nil {
+		return nil, err
+	}
+	R, err := PointOf(st.Bundle[:33], "bundle R")
+	if err != nil {
+		return nil, err
+	}
+
+	// 1. challenges from every machine
+	type got struct {
+		i  int
+		ch Challenge
+	}
+	var mu sync.Mutex
+	var chs []got
+	var wg sync.WaitGroup
+	for i, m := range st.Machines {
+		wg.Add(1)
+		go func(i int, m MachineV2) {
+			defer wg.Done()
+			var r wireChallengeV2
+			if err := c.Post(ctx, m.Endpoint+"/v2/custody/challenge", struct{}{}, &r); err != nil {
+				c.logf("DOM custody: machine %d gave no challenge: %v", i, err)
+				return
+			}
+			if r.EncKey != hex.EncodeToString(m.EncKey[:]) {
+				c.logf("DOM custody: machine %d answered under another key", i)
+				return
+			}
+			n, err := hex.DecodeString(r.Nonce)
+			if err != nil || len(n) != 32 {
+				c.logf("DOM custody: machine %d's challenge has no 32-byte nonce", i)
+				return
+			}
+			g := got{i: i, ch: Challenge{EncKey: m.EncKey}}
+			copy(g.ch.Nonce[:], n)
+			mu.Lock()
+			chs = append(chs, g)
+			mu.Unlock()
+		}(i, m)
+	}
+	wg.Wait()
+	sort.Slice(chs, func(a, b int) bool { return chs[a].i < chs[b].i })
+	enclaveOnline, others := false, 0
+	for _, g := range chs {
+		if st.Machines[g.i].Enclave {
+			enclaveOnline = true
+		} else {
+			others++
+		}
+	}
+	reach := others
+	if enclaveOnline {
+		reach += lay.EnclaveWeight
+	}
+	if reach < st.Threshold {
+		return nil, fmt.Errorf("%w: the %d of %d machines that issued a challenge hold %d share indices (need %d)", ErrQuorum, len(chs), len(st.Machines), reach, st.Threshold)
+	}
+	challenges := make([]Challenge, len(chs))
+	for i, g := range chs {
+		challenges[i] = g.ch
+	}
+
+	// 2. recipient key, binding, evidence, the operator's authorization
+	sk, err := NewRecipientKey()
+	if err != nil {
+		return nil, err
+	}
+	var rk [32]byte
+	copy(rk[:], sk.PublicKey().Bytes())
+	binding, err := BindingV2(BindingInputV2{Ctx: st.Ctx, ID: st.ID, PolicyRev: st.PolicyRev, SecretRev: st.SecretRev, CommitteeID: st.CommitteeID,
+		Epoch: st.Epoch, Challenges: challenges, RuntimeID: c.RuntimeID, TransportSPKI: c.TransportSPKI, RecipientKey: rk})
+	if err != nil {
+		return nil, err
+	}
+	ev, err := c.Evidence(binding)
+	if err != nil {
+		return nil, fmt.Errorf("the custody report: %w", err)
+	}
+	endpoint, sig, expiry, err := c.AuthorizeV2(ctx, st.Ctx.Vault, st.ID, binding)
+	if err != nil {
+		return nil, fmt.Errorf("the operator's authorization: %w", err)
+	}
+	req := wireReleaseV2{V: 2, ID: "0x" + hex.EncodeToString(st.ID[:]), Endpoint: endpoint, CommitteeID: "0x" + hex.EncodeToString(st.CommitteeID[:]),
+		Epoch: st.Epoch, PolicyRev: strconv.FormatUint(st.PolicyRev, 10), SecretRev: strconv.FormatUint(st.SecretRev, 10),
+		RecipientKey: hex.EncodeToString(rk[:]), Operator: wireOperator{Sig: sig, Expiry: expiry}, Evidence: ev}
+	for _, ch := range challenges {
+		req.Challenges = append(req.Challenges, wireChallenge{EncKey: hex.EncodeToString(ch.EncKey[:]), Nonce: hex.EncodeToString(ch.Nonce[:])})
+	}
+
+	// 3. partials from every machine that issued a challenge; a machine with any bad record is dropped whole
+	valid := map[int][]Partial{}
+	for _, g := range chs {
+		wg.Add(1)
+		go func(g got) {
+			defer wg.Done()
+			m := st.Machines[g.i]
+			var r wirePartialsV2
+			if err := c.Post(ctx, m.Endpoint+"/v2/custody/release", req, &r); err != nil {
+				c.logf("DOM custody: machine %d released nothing: %v", g.i, err)
+				return
+			}
+			ps, err := c.machinePartials(sk, binding, R, st.Commitments, m, r)
+			if err != nil {
+				c.logf("DOM custody: machine %d dropped: %v", g.i, err)
+				return
+			}
+			mu.Lock()
+			valid[g.i] = ps
+			mu.Unlock()
+		}(g)
+	}
+	wg.Wait()
+
+	// 4. choose exactly t indices under the Enclave rule
+	var use []Partial
+	var used []int // machine positions combined
+	if enclaveOnline {
+		chosen := -1
+		for _, g := range chs {
+			if st.Machines[g.i].Enclave && valid[g.i] != nil {
+				chosen = g.i
+				break
+			}
+		}
+		if chosen < 0 {
+			return nil, errors.New("an Enclave custodian answered the challenge round but none released valid partials: refused (one Enclave partial is required while Enclave is online)")
+		}
+		use = append(use, valid[chosen]...)
+		used = append(used, chosen)
+	}
+	for _, g := range chs {
+		if len(use) >= st.Threshold {
+			break
+		}
+		if !st.Machines[g.i].Enclave && valid[g.i] != nil {
+			use = append(use, valid[g.i]...)
+			used = append(used, g.i)
+		}
+	}
+	if len(use) < st.Threshold {
+		return nil, fmt.Errorf("%w: %d valid share indices released (need %d)", ErrQuorum, len(use), st.Threshold)
+	}
+	if len(use) > st.Threshold { // only possible if a seat's weight exceeded what remained; never with this layout
+		return nil, errors.New("the released indices do not make up exactly the threshold")
+	}
+
+	// 5. combine and open
+	ks := make([]uint32, len(use))
+	for i, p := range use {
+		ks[i] = p.K
+	}
+	c.logf("DOM custody: %d of %d machines released valid partials; combining indices %v from machines %v", len(valid), len(chs), ks, used)
+	S, err := Combine(use, st.Threshold)
+	if err != nil {
+		return nil, err
+	}
+	b, err := DecryptBundleV2(S, label, st.Bundle)
+	if err != nil {
+		return nil, fmt.Errorf("the combined key: %w", err)
+	}
+	return b, nil
+}
+
+// machinePartials opens one machine's answer and verifies that it holds exactly one valid partial for each of that
+// machine's share indices, and nothing else.
+func (c *Client) machinePartials(sk *ecdh.PrivateKey, binding [32]byte, R *Point, commitments [][]byte, m MachineV2, r wirePartialsV2) ([]Partial, error) {
+	if r.V != 2 || r.EncKey != hex.EncodeToString(m.EncKey[:]) {
+		return nil, errors.New("it answered for another version or key")
+	}
+	if r.Count != len(m.Indices) {
+		return nil, fmt.Errorf("it answered %d partials for %d share indices", r.Count, len(m.Indices))
+	}
+	blob, err := base64.StdEncoding.DecodeString(r.Sealed)
+	if err != nil {
+		return nil, errors.New("its answer is not base64")
+	}
+	recs, err := OpenPartials(sk, binding, m.EncKey, r.Count, blob)
+	if err != nil {
+		return nil, errors.New("its answer does not open under this release")
+	}
+	want := map[uint32]bool{}
+	for _, k := range m.Indices {
+		want[k] = true
+	}
+	out := make([]Partial, 0, len(recs))
+	for _, rec := range recs {
+		p, err := VerifyPartial(rec, R, binding, commitments)
+		if err != nil {
+			return nil, err
+		}
+		if !want[p.K] {
+			return nil, fmt.Errorf("a partial for index %d, which it does not hold (or repeats)", p.K)
+		}
+		delete(want, p.K)
+		out = append(out, p)
+	}
+	return out, nil
+}
diff --git a/orig-9d43/isolation/m2/custody/v2member/member.go b/orig-9d43/isolation/m2/custody/v2member/member.go
new file mode 100644
index 0000000000000000000000000000000000000000..abef6785a5ed09b6c24adfb2c6c01c91e92eb0d6
--- /dev/null
+++ b/orig-9d43/isolation/m2/custody/v2member/member.go
@@ -0,0 +1,179 @@
+// Package v2member is the OWNER and CUSTODIAN half of custody v2's math (custody/v2/protocol.mjs encryptBundle, partial,
+// sealPartials), in Go, for tests only: it lets the guest's tests run a fake committee. The guest never links it (only
+// _test files import it), and production custodians run the JS reference.
+package v2member
+
+import (
+	"crypto/aes"
+	"crypto/cipher"
+	"crypto/ecdh"
+	"crypto/hkdf"
+	"crypto/rand"
+	"crypto/sha256"
+	"encoding/binary"
+	"encoding/json"
+	"errors"
+
+	"github.com/decred/dcrd/dcrec/secp256k1/v4"
+
+	"enclave.host/isolation/m2/custody"
+)
+
+// Scalar is a big-endian value reduced mod q (the JS vectors' sc()).
+func Scalar(b []byte) *secp256k1.ModNScalar {
+	var s secp256k1.ModNScalar
+	s.SetByteSlice(b)
+	return &s
+}
+
+// Random draws a scalar in [1, q).
+func Random() *secp256k1.ModNScalar {
+	for {
+		var b [32]byte
+		rand.Read(b[:])
+		var s secp256k1.ModNScalar
+		if s.SetBytes(&b) == 0 && !s.IsZero() {
+			return &s
+		}
+	}
+}
+
+func bytesOf(p *secp256k1.JacobianPoint) []byte {
+	b, err := custody.PointBytesOf(p)
+	if err != nil {
+		panic(err)
+	}
+	return b
+}
+
+func mulG(s *secp256k1.ModNScalar) *secp256k1.JacobianPoint {
+	var r secp256k1.JacobianPoint
+	secp256k1.ScalarBaseMultNonConst(s, &r)
+	return &r
+}
+
+func mul(p *secp256k1.JacobianPoint, s *secp256k1.ModNScalar) *secp256k1.JacobianPoint {
+	var r secp256k1.JacobianPoint
+	secp256k1.ScalarMultNonConst(s, p, &r)
+	return &r
+}
+
+// Committee is a dealt polynomial: x = Coeffs[0], share x_k = Σ Coeffs[j]·k^j, commitments C_j = Coeffs[j]·G.
+type Committee struct {
+	Coeffs      []*secp256k1.ModNScalar
+	Commitments [][]byte
+}
+
+// NewCommittee deals a degree t-1 polynomial (coeffs given, or random).
+func NewCommittee(t int, coeffs ...*secp256k1.ModNScalar) *Committee {
+	c := &Committee{}
+	for j := 0; j < t; j++ {
+		s := Random()
+		if j < len(coeffs) {
+			s = coeffs[j]
+		}
+		c.Coeffs = append(c.Coeffs, s)
+		c.Commitments = append(c.Commitments, bytesOf(mulG(s)))
+	}
+	return c
+}
+
+// Y is the committee key.
+func (c *Committee) Y() []byte { return c.Commitments[0] }
+
+// CommitmentBytes is the pointer's commitments field (t x 33).
+func (c *Committee) CommitmentBytes() []byte {
+	var out []byte
+	for _, b := range c.Commitments {
+		out = append(out, b...)
+	}
+	return out
+}
+
+// Share is x_k.
+func (c *Committee) Share(k uint32) *secp256k1.ModNScalar {
+	var acc, kk, kp secp256k1.ModNScalar
+	kk.SetInt(k)
+	kp.SetInt(1)
+	for _, a := range c.Coeffs {
+		var term secp256k1.ModNScalar
+		term.Mul2(a, &kp)
+		acc.Add(&term)
+		kp.Mul(&kk)
+	}
+	return &acc
+}
+
+// EncryptBundle is protocol.mjs encryptBundle; r, k and nonce are drawn when nil.
+func EncryptBundle(Y []byte, label [32]byte, env map[string]string, configSha256 string, r, k *secp256k1.ModNScalar, nonce []byte) ([]byte, error) {
+	if r == nil {
+		r = Random()
+	}
+	if k == nil {
+		k = Random()
+	}
+	if nonce == nil {
+		nonce = make([]byte, 12)
+		rand.Read(nonce)
+	}
+	Yp, err := custody.PointOf(Y, "committee key")
+	if err != nil {
+		return nil, err
+	}
+	R, A := bytesOf(mulG(r)), bytesOf(mulG(k))
+	c := custody.HashToScalar([]byte("enclave-custody-v2 pok\n"), label[:], R, A)
+	var z secp256k1.ModNScalar
+	z.Mul2(c, r).Add(k)
+	key, err := hkdf.Key(sha256.New, bytesOf(mul(Yp, r)), label[:], "enclave-custody-v2 key", 32)
+	if err != nil {
+		return nil, err
+	}
+	pt, err := json.Marshal(struct {
+		V            int               `json:"v"`
+		Env          map[string]string `json:"env"`
+		ConfigSha256 string            `json:"configSha256"`
+	}{2, env, configSha256})
+	if err != nil {
+		return nil, err
+	}
+	blk, _ := aes.NewCipher(key)
+	g, _ := cipher.NewGCM(blk)
+	cb, zb := c.Bytes(), z.Bytes()
+	out := append(append(append(append([]byte{}, R...), cb[:]...), zb[:]...), nonce...)
+	return g.Seal(out, nonce, pt, label[:]), nil
+}
+
+// Partial is protocol.mjs partial: D = x·R with a DLEQ proof under binding; u is drawn when nil.
+func Partial(k uint32, x *secp256k1.ModNScalar, R []byte, binding [32]byte, commitments [][]byte, u *secp256k1.ModNScalar) ([]byte, error) {
+	Rp, err := custody.PointOf(R, "bundle R")
+	if err != nil {
+		return nil, err
+	}
+	Yk, err := custody.PublicShare(k, commitments)
+	if err != nil {
+		return nil, err
+	}
+	if u == nil {
+		u = Random()
+	}
+	D := bytesOf(mul(Rp, x))
+	var kb [4]byte
+	binary.BigEndian.PutUint32(kb[:], k)
+	c := custody.HashToScalar([]byte("enclave-custody-v2 dleq\n"), binding[:], kb[:], bytesOf(Yk), R, D, bytesOf(mulG(u)), bytesOf(mul(Rp, u)))
+	var z secp256k1.ModNScalar
+	z.Mul2(c, x).Add(u)
+	cb, zb := c.Bytes(), z.Bytes()
+	return append(append(append(kb[:], D...), cb[:]...), zb[:]...), nil
+}
+
+// Seal is protocol.mjs sealPartials (ikmE nil = fresh).
+func Seal(recipient *ecdh.PublicKey, binding, encKey [32]byte, records [][]byte, ikmE []byte) ([]byte, error) {
+	if len(records) == 0 {
+		return nil, errors.New("no records")
+	}
+	var pt []byte
+	for _, r := range records {
+		pt = append(pt, r...)
+	}
+	return custody.Seal(recipient, []byte("enclave-custody-v2 partial-release"), custody.PartialAAD(binding, encKey, len(records)), pt, ikmE)
+}
diff --git a/orig-9d43/scripts/build-custodian-v2.mjs b/orig-9d43/scripts/build-custodian-v2.mjs
new file mode 100644
index 0000000000000000000000000000000000000000..6942f439a86003b2ad7b823cc8800a2f0294f93f
--- /dev/null
+++ b/orig-9d43/scripts/build-custodian-v2.mjs
@@ -0,0 +1,101 @@
+#!/usr/bin/env node
+// The custody v2 CUSTODIAN image (docs/security/secret-custody-v2.md §8.1): a measured SEV-SNP guest made from a
+// digest-checked metal control image (its kernel, PID 1, Node, guest modules and the fleet-tunnel agent), with:
+//   - /opt/metal/gsup.mjs replaced by custody/v2/cvm-gsup.mjs (runs the custodian + the tunnel agent, nothing else);
+//   - /opt/custodian/custodian.mjs: custody/v2/daemon.mjs bundled, with the MEASURED chain config (vault, RPCs) baked in;
+//   - /opt/custodian/snpkey: the derived-key helper (isolation/m2/cmd/snpkey), static.
+// Every other cpio entry is copied byte for byte. The launch measurement is printed (sev-snp-measure, 2 vCPUs).
+//
+//   node scripts/build-custodian-v2.mjs --base <metal dist dir> --out <new dir> --vault 0x… [--vcpus 2]
+import fs from "node:fs";
+import path from "node:path";
+import url from "node:url";
+import zlib from "node:zlib";
+import { createHash } from "node:crypto";
+import { execFileSync } from "node:child_process";
+import { build } from "esbuild";
+
+const ROOT = path.resolve(path.dirname(url.fileURLToPath(import.meta.url)), "..");
+const arg = (n, d) => { const i = process.argv.indexOf("--" + n); return i > 0 ? process.argv[i + 1] : d; };
+const BASE = path.resolve(arg("base", "")), OUT = path.resolve(arg("out", "")), VAULT = String(arg("vault", "")).toLowerCase();
+const VCPUS = String(arg("vcpus", "2"));
+const sha = (b) => createHash("sha256").update(b).digest("hex");
+if (!fs.existsSync(path.join(BASE, "manifest.json"))) throw new Error("--base must be a metal dist dir");
+if (fs.existsSync(OUT)) throw new Error(`${OUT} exists: an image is built once`);
+if (!/^0x[0-9a-f]{40}$/.test(VAULT) || /^0x0{40}$/.test(VAULT)) throw new Error("--vault must be the deployed EnclaveSecretVaultV2");
+const commit = execFileSync("git", ["rev-parse", "HEAD"], { cwd: ROOT, encoding: "utf8" }).trim();
+const dirty = execFileSync("git", ["status", "--porcelain", "--", "custody", "isolation/m2/cmd/snpkey", "relay/snp-verify.mjs", "verifier", "scripts/build-custodian-v2.mjs"], { cwd: ROOT, encoding: "utf8" }).trim();
+if (dirty && !process.argv.includes("--allow-dirty")) throw new Error(`uncommitted changes in the image's sources:\n${dirty}`);
+
+// 1. base, checked against its manifest
+const m = JSON.parse(fs.readFileSync(path.join(BASE, "manifest.json"), "utf8"));
+const gz = fs.readFileSync(path.join(BASE, "initramfs.cpio.gz"));
+if (m.initramfs && sha(gz) !== m.initramfs.sha256) throw new Error("base initramfs hash mismatch");
+if (sha(fs.readFileSync(path.join(BASE, "vmlinuz"))) !== m.kernel.sha256) throw new Error("base kernel hash mismatch");
+
+// 2. the custodian bundle with the measured config
+const measured = `export const MEASURED = Object.freeze(${JSON.stringify({
+  chainId: 8453, vault: VAULT,
+  rpcs: ["https://mainnet.base.org", "https://base-rpc.publicnode.com", "https://base.drpc.org", "https://1rpc.io/base"],
+  minAgree: 2, maxAgeSec: 120, enclaveOwner: "0x0b2d009c0c9af05b12100d77f3c815fea822ee61" })});\n`;
+const bundled = await build({ entryPoints: [path.join(ROOT, "custody/v2/daemon.mjs")], bundle: true, platform: "node", format: "esm", target: "node22",
+  write: false, legalComments: "none", banner: { js: 'import { createRequire as __cr } from "node:module"; const require = __cr(import.meta.url);' },
+  plugins: [{ name: "measured", setup(b) { b.onLoad({ filter: /custody[\\/]v2[\\/]measured\.mjs$/ }, () => ({ contents: measured, loader: "js" })); } }] });
+const custodianJs = Buffer.from(bundled.outputFiles[0].contents);
+const tmpKey = path.join(OUT + ".snpkey");
+execFileSync("go", ["build", "-trimpath", "-buildvcs=false", "-ldflags=-s -w -buildid=", "-o", tmpKey, "./cmd/snpkey"],
+  { cwd: path.join(ROOT, "isolation/m2"), env: { ...process.env, GOFLAGS: "", CGO_ENABLED: "0", GOEXPERIMENT: "nodwarf5", GOTOOLCHAIN: "go1.27.0" }, stdio: "inherit" });
+const snpkey = fs.readFileSync(tmpKey); fs.unlinkSync(tmpKey);
+const gsup = fs.readFileSync(path.join(ROOT, "custody/v2/cvm-gsup.mjs"));
+
+// 3. rewrite the newc cpio: replace gsup, append the custodian dir + files before the trailer
+const raw = zlib.gunzipSync(gz);
+const parts = []; let off = 0, maxino = 0, prefix = null, replaced = false;
+const entry = (fields, name, data) => {
+  const nm = Buffer.from(name + "\0");
+  const h = Buffer.from("070701" + fields.map((n) => n.toString(16).padStart(8, "0")).join(""));
+  const head = Buffer.concat([h, nm]); const pad1 = Buffer.alloc((4 - (head.length % 4)) % 4);
+  return Buffer.concat([head, pad1, data, Buffer.alloc((4 - (data.length % 4)) % 4)]);
+};
+while (off < raw.length) {
+  const start = off, h = raw.subarray(off, off + 110); off += 110;
+  if (h.subarray(0, 6).toString() !== "070701") throw new Error("only newc cpio is supported");
+  const f = Array.from({ length: 13 }, (_, i) => parseInt(h.subarray(6 + i * 8, 14 + i * 8).toString(), 16));
+  const size = f[6], ns = f[11];
+  const name = raw.subarray(off, off + ns - 1).toString(); off = (off + ns + 3) & ~3;
+  const data = raw.subarray(off, off + size); off = (off + size + 3) & ~3;
+  const key = name.replace(/^\.\//, "");
+  maxino = Math.max(maxino, f[0]);
+  if (key === "opt/metal/gsup.mjs") prefix = name.slice(0, name.length - key.length);
+  if (name === "TRAILER!!!") {
+    const add = (mode, k, d) => { maxino++; parts.push(entry([maxino, mode, 0, 0, mode >> 12 === 4 ? 2 : 1, 0, d.length, 0, 0, 0, 0, (prefix + k).length + 1, 0], prefix + k, d)); };
+    add(0o040755, "opt/custodian", Buffer.alloc(0));
+    add(0o100644, "opt/custodian/custodian.mjs", custodianJs);
+    add(0o100755, "opt/custodian/snpkey", snpkey);
+    parts.push(raw.subarray(start, off));
+    break;
+  }
+  if (key === "opt/metal/gsup.mjs") {
+    if (f[4] !== 1) throw new Error("gsup.mjs is hardlinked");
+    f[6] = gsup.length; parts.push(entry(f, name, gsup)); replaced = true;
+  } else parts.push(raw.subarray(start, off));
+}
+if (!replaced || prefix === null) throw new Error("the base image has no /opt/metal/gsup.mjs");
+fs.mkdirSync(OUT);
+const out = zlib.gzipSync(Buffer.concat(parts), { level: 9 });
+fs.writeFileSync(path.join(OUT, "initramfs.cpio.gz"), out);
+fs.copyFileSync(path.join(BASE, "vmlinuz"), path.join(OUT, "vmlinuz"));
+const cmdline = fs.readFileSync(path.join(BASE, "cmdline"), "utf8").trim().replace("${MODE}", "snp");
+fs.writeFileSync(path.join(OUT, "cmdline"), cmdline + "\n");
+const manifest = { role: "enclave-custodian-v2", commit, vault: VAULT, base: { dir: path.basename(BASE), initramfsSha256: sha(gz), kernelSha256: m.kernel.sha256 },
+  files: { "/opt/metal/gsup.mjs": sha(gsup), "/opt/custodian/custodian.mjs": sha(custodianJs), "/opt/custodian/snpkey": sha(snpkey) },
+  kernel: { sha256: m.kernel.sha256 }, initramfs: { sha256: sha(out), bytes: out.length }, cmdline, vcpus: Number(VCPUS) };
+// 4. the launch measurement this image produces on this host's firmware (the verifying OVMF), Turin
+const OVMF = process.env.OVMF || path.join(process.env.HOME, ".cache/enclave-isolation/fwbuild/OVMF.amdsev.fd");
+try {
+  const meas = execFileSync(process.env.SEV_SNP_MEASURE || "sev-snp-measure", ["--mode", "snp", "--vcpus", VCPUS, "--vcpu-family", "26", "--vcpu-model", "2", "--vcpu-stepping", "1",
+    "--ovmf", OVMF, "--kernel", path.join(OUT, "vmlinuz"), "--initrd", path.join(OUT, "initramfs.cpio.gz"), "--append", cmdline], { encoding: "utf8" }).trim().split("\n").pop();
+  manifest.measurement = meas; manifest.measurementSha256 = "0x" + sha(Buffer.from(meas, "hex")); manifest.ovmfSha256 = sha(fs.readFileSync(OVMF));
+} catch (e) { manifest.measurementError = e.message; }
+fs.writeFileSync(path.join(OUT, "manifest.json"), JSON.stringify(manifest, null, 2) + "\n");
+console.log(JSON.stringify({ out: OUT, initramfs: manifest.initramfs, measurement: manifest.measurement, measurementSha256: manifest.measurementSha256 }, null, 1));
diff --git a/orig-9d43/test/custody-v2-deploy.test.mjs b/orig-9d43/test/custody-v2-deploy.test.mjs
new file mode 100644
index 0000000000000000000000000000000000000000..e18d887b0077d8faf3c53286a0b9609f1bed4004
--- /dev/null
+++ b/orig-9d43/test/custody-v2-deploy.test.mjs
@@ -0,0 +1,55 @@
+// scripts/deploy-secret-vault-v2.mjs: the vault compiles under EIP-170, and against a real chain (anvil) the script deploys it
+// over a given address book and Enclave wallet, verifies both, and only PRINTS the governance transaction (never sends it).
+//   run: node --test test/custody-v2-deploy.test.mjs
+import test from "node:test";
+import assert from "node:assert/strict";
+import { createWalletClient, http, decodeFunctionData, hexToString, encodeAbiParameters, keccak256, toHex } from "viem";
+import { privateKeyToAccount, generatePrivateKey } from "viem/accounts";
+import { anvilAvailable, startAnvil, compileContracts } from "./helpers/custody-rig.mjs";
+import { deploySecretVaultV2, compileSecretVaultV2, EIP170, NETWORKS } from "../scripts/deploy-secret-vault-v2.mjs";
+
+test("the v2 vault fits EIP-170", () => {
+  const { size } = compileSecretVaultV2();
+  assert.ok(size > 0 && size <= EIP170, `runtime ${size} bytes`);
+});
+
+test("Base: the book and the Enclave wallet are the spec's", () => {
+  assert.equal(NETWORKS.base.book, "0xab214342d5A490150A4A977063A2f88E21F80907");
+  assert.equal(NETWORKS.base.enclaveOwner, "0x0b2d009c0c9Af05b12100D77F3c815fea822eE61");
+});
+
+test("a dry run sends nothing", async () => {
+  const logs = [];
+  const r = await deploySecretVaultV2({ book: NETWORKS.base.book, enclaveOwner: NETWORKS.base.enclaveOwner, dryRun: true, log: (m) => logs.push(m) });
+  assert.equal(r, null);
+  assert.match(logs.join("\n"), /dry run: nothing sent/);
+  await assert.rejects(deploySecretVaultV2({ book: NETWORKS.base.book, enclaveOwner: "", dryRun: true, log: () => {} }), /ENCLAVE_OWNER/);
+});
+
+test("deploy on anvil: reads back book and enclaveOwner, prints the book step, and machineHash matches the spec's encoding",
+     { skip: anvilAvailable() ? false : "anvil not installed" }, async () => {
+  const a = await startAnvil();
+  try {
+    const key = generatePrivateKey(), acct = privateKeyToAccount(key);
+    await a.client.request({ method: "anvil_setBalance", params: [acct.address, "0x56bc75e2d63100000"] });
+    const C = compileContracts();
+    const w = createWalletClient({ account: acct, chain: a.chain, transport: http(a.url) });
+    const book = (await a.client.waitForTransactionReceipt({ hash: await w.deployContract({ abi: C.book.abi, bytecode: C.book.bytecode }) })).contractAddress;
+    const enclaveOwner = "0x0b2d009c0c9Af05b12100D77F3c815fea822eE61";
+    const logs = [];
+    const r = await deploySecretVaultV2({ rpc: a.url, chain: a.chain, privateKey: key, book, enclaveOwner, log: (m) => logs.push(m) });
+    assert.match(logs.join("\n"), /GOVERNANCE STEP \(not sent\)/);
+    const { args } = decodeFunctionData({ abi: [{ type: "function", name: "set", inputs: [{ type: "bytes32" }, { type: "address" }], outputs: [] }], data: r.setData });
+    assert.equal(hexToString(args[0], { size: 32 }), "secretVaultV2");
+    assert.equal(args[1], r.vault);
+    assert.equal(await a.client.readContract({ address: book, abi: C.book.abi, functionName: "addr", args: [args[0]] }), "0x0000000000000000000000000000000000000000");
+
+    // machineHash (spec §1.1) from viem's ABI encoder equals the contract's
+    const { abi } = compileSecretVaultV2();
+    const m = { identity: acct.address, encKey: keccak256(toHex("enc")), endpoint: "https://custodian.example", chipId: keccak256(toHex("chip")),
+                registryId: keccak256(toHex("https://host.example")), measurement: keccak256(toHex("m")) };
+    const want = keccak256(encodeAbiParameters([{ type: "address" }, { type: "bytes32" }, { type: "bytes32" }, { type: "bytes32" }, { type: "bytes32" }, { type: "bytes32" }],
+      [m.identity, m.encKey, keccak256(toHex(m.endpoint)), m.chipId, m.registryId, m.measurement]));
+    assert.equal(await a.client.readContract({ address: r.vault, abi, functionName: "machineHash", args: [m] }), want);
+  } finally { a.stop(); }
+});
diff --git a/orig-9d43/test/custody-v2-e2e.test.mjs b/orig-9d43/test/custody-v2-e2e.test.mjs
new file mode 100644
index 0000000000000000000000000000000000000000..b2216ef023b16d10845074bd401743b622e4abad
--- /dev/null
+++ b/orig-9d43/test/custody-v2-e2e.test.mjs
@@ -0,0 +1,241 @@
+// Custody v2 end to end on a REAL chain (anvil) with the REAL EnclaveSecretVaultV2: the Enclave seat creates the committee
+// (genesis), an owner encrypts to the committee key, an attested guest unlocks at t = 1, candidates join (a second
+// Enclave machine, two capacity-proven hosts), a handover runs through the contract (proposal, deals, acks, activation),
+// and the guest unlocks at t = 2 with EXACTLY ONE Enclave machine's partial; the two Enclave machines alone cannot.
+// Every custodian signature (genesis, approvals, deals, acks) is checked by the contract, so this also pins
+// custody/v2/digests.mjs to the Solidity. Attestation of app guests is SIMULATED (synthetic AMD chain, real verifier);
+// custodian self-evidence is stubbed (the hardware path is exercised on warden-host).
+//   run: node --test test/custody-v2-e2e.test.mjs
+import test from "node:test";
+import assert from "node:assert/strict";
+import fs from "node:fs";
+import path from "node:path";
+import { createRequire } from "node:module";
+import { createHash, randomBytes } from "node:crypto";
+import { createWalletClient, http, keccak256, toBytes, parseEther, stringToHex } from "viem";
+import { privateKeyToAccount, generatePrivateKey } from "viem/accounts";
+import { anvilAvailable, startAnvil, snpAttester, RUNTIME, MEASUREMENT, FLOOR } from "./helpers/custody-rig.mjs";
+import { synthChain } from "./helpers/snp-synth.mjs";
+import { memoryCollateral } from "../verifier/index.mjs";
