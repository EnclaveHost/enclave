index 0000000000000000000000000000000000000000..ccf8a3d0181dfc970bec1d358491468627aa2411
--- /dev/null
+++ b/orig-9d43/custody/v2/cvm-gsup.mjs
@@ -0,0 +1,32 @@
+// PID 1's hand-off in the CUSTODIAN image (replaces the metal image's /opt/metal/gsup.mjs; scripts/build-custodian-v2.mjs).
+// Runs two processes and keeps them alive:
+//   - the custodian (/opt/custodian/custodian.mjs, custody/v2/daemon.mjs) on :8787;
+//   - the fleet-tunnel agent (/opt/metal/agent.mjs, unchanged from the metal image), which attaches to the relay by this
+//     guest's SEV-SNP quote and forwards https://api.enclave.host/t/<name>/... to the custodian.
+// Its inputs are fw_cfg's opt/org.enclave.custody JSON (unmeasured: name, public URL, VCEK), never the custodian's keys.
+import fs from "node:fs";
+import { spawn } from "node:child_process";
+
+const FW = "/sys/firmware/qemu_fw_cfg/by_name/opt/org.enclave.custody/raw";
+const log = (m) => { try { fs.writeFileSync("/dev/console", `[custodian-gsup] ${m}\n`); } catch { console.log(m); } };
+let cfg = {};
+try { cfg = JSON.parse(fs.readFileSync(FW, "utf8")); } catch (e) { log(`no host config (${e.message}); the custodian will refuse to start`); }
+const NAME = /^[a-z0-9][a-z0-9-]{0,40}$/.test(String(cfg.tunnelName || "")) ? cfg.tunnelName : "custody-unnamed";
+const PATH = "/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin";
+
+function keep(name, args, env) {
+  let restarts = 0;
+  const run = () => {
+    const c = spawn("/usr/local/bin/node", args, { env: { PATH, NODE_EXTRA_CA_CERTS: "/etc/ssl/certs/ca-certificates.crt", ...env }, stdio: ["ignore", "inherit", "inherit"] });
+    c.on("exit", (code, sig) => { restarts++; const d = Math.min(2000 * restarts, 30000); log(`${name} exited code=${code} sig=${sig}; restart in ${d} ms`); setTimeout(run, d); });
+  };
+  run();
+}
+keep("custodian", ["/opt/custodian/custodian.mjs"], {});
+keep("agent", ["/opt/metal/agent.mjs"], {
+  METAL_MODE: "snp", METAL_NAME: NAME, METAL_SUP_URL: "http://127.0.0.1:8787",
+  METAL_RELAY_URL: String(cfg.relayUrl || "wss://api.enclave.host/v1/fleet-tunnel"),
+  METAL_PUBLIC_URL: String(cfg.endpoint || ""), METAL_VCEK_B64: typeof cfg.vcek === "string" ? cfg.vcek : "",
+  METAL_RAD_PORT: "8443", METAL_TUNNEL_TOKEN: "",
+});
+log(`custodian + tunnel agent "${NAME}" started`);
diff --git a/orig-9d43/custody/v2/daemon.mjs b/orig-9d43/custody/v2/daemon.mjs
new file mode 100644
index 0000000000000000000000000000000000000000..e6e45132496d54cd7c8a5e4e4926d7aadeff1dbb
--- /dev/null
+++ b/orig-9d43/custody/v2/daemon.mjs
@@ -0,0 +1,177 @@
+// The custody v2 custodian, as it runs INSIDE its SEV-SNP guest (docs/security/secret-custody-v2.md §8). Bundled by
+// scripts/build-custodian-v2.mjs into /opt/custodian/custodian.mjs of the custodian image.
+//
+// MEASURED (this bundle's constants, MEASURED below): the chain, the vault, the RPCs and how many must agree, the Enclave
+// owner. A host must not choose the chain a custodian believes: RPCs it controls could invent a policy.
+// UNMEASURED (fw_cfg opt/org.enclave.custody, written by the host launcher): the public endpoint, the host's registry id,
+// the committee to serve, whether to run genesis, and where the host keeps the sealed state and submits transactions. A
+// lying host can at most make this custodian useless (wrong endpoint, dropped state, unsent transactions); it cannot make
+// it release anything: every release is checked against the agreed chain, and the state opens only inside this guest.
+//
+// State: sealed with an SNP DERIVED key (snpkey: VCEK root, mixing the launch measurement and the guest policy), so only
+// this exact code on this exact chip opens it. The host stores the ciphertext (GET/PUT <host>/state).
+import fs from "node:fs";
+import http from "node:http";
+import { execFileSync } from "node:child_process";
+import { createCipheriv, createDecipheriv, randomBytes, createHash } from "node:crypto";
+import { privateKeyToAccount, generatePrivateKey } from "viem/accounts";
+import { bytesToHex } from "viem";
+import * as hpke from "../hpke.mjs";
+import { createChainReaderV2 } from "./chain.mjs";
+import { createCustodianV2, Refusal } from "./custodian.mjs";
+import { createMember } from "./member.mjs";
+import { rateLimiter } from "../custodian.mjs";
+import { productionVerifiers } from "../verifiers.mjs";
+import { cachedCollateral, httpCollateral } from "../../verifier/consumer.mjs";
+import { verifyQuote, parseSnpReport } from "../../relay/snp-verify.mjs";
+import { MEASURED } from "./measured.mjs";
+
+const log = (...a) => console.log(new Date().toISOString(), ...a);
+const FW = "/sys/firmware/qemu_fw_cfg/by_name/opt/org.enclave.custody/raw";
+const TSM = "/sys/kernel/config/tsm/report";
+
+function readHostConfig() {
+  const c = JSON.parse(fs.readFileSync(process.env.CUSTODY_HOST_CONFIG || FW, "utf8"));
+  const out = {
+    endpoint: String(c.endpoint || ""), registryId: String(c.registryId || "").toLowerCase(), hostUrl: String(c.hostUrl || "http://10.0.2.2:8796"),
+    committeeId: c.committeeId ? String(c.committeeId).toLowerCase() : null, genesis: c.genesis === true, port: Number(c.port || 8787),
+    vcek: c.vcek ? Buffer.from(String(c.vcek), "base64") : null,
+  };
+  if (!/^https:\/\/[a-z0-9.-]{1,253}(\/[A-Za-z0-9._~-]+){0,4}$/.test(out.endpoint)) throw new Error("host config: endpoint must be an https URL (an optional plain path prefix)");
+  if (!/^0x[0-9a-f]{64}$/.test(out.registryId)) throw new Error("host config: registryId must be bytes32");
+  if (out.committeeId && !/^0x[0-9a-f]{64}$/.test(out.committeeId)) throw new Error("host config: committeeId must be bytes32");
+  return out;
+}
+
+// ---- the chip: derived sealing key and reports ----
+const derivedKey = () => Buffer.from(execFileSync("/opt/custodian/snpkey", ["derive"], { encoding: "utf8" }).trim(), "hex");
+function vcekTable(der) {
+  const hdr = Buffer.alloc(48);
+  Buffer.from("63da758de6644564adc5f4b93be8accd", "hex").copy(hdr, 0);
+  hdr.writeUInt32LE(48, 16); hdr.writeUInt32LE(der.length, 20);
+  return Buffer.concat([hdr, der]);
+}
+function tsmReport(first32, vcek) {
+  const dir = `${TSM}/custody-${process.pid}-${randomBytes(4).toString("hex")}`;
+  fs.mkdirSync(dir);
+  try {
+    const rd = Buffer.alloc(64); Buffer.from(first32).copy(rd, 0);
+    fs.writeFileSync(`${dir}/inblob`, rd);
+    const report = fs.readFileSync(`${dir}/outblob`);
+    let auxblob = null; try { auxblob = fs.readFileSync(`${dir}/auxblob`); } catch {}
+    if ((!auxblob || !auxblob.length) && vcek) auxblob = vcekTable(vcek);
+    return { report, auxblob };
+  } finally { try { fs.rmdirSync(dir); } catch {} }
+}
+
+// ---- sealed state ----
+const AAD = Buffer.from("enclave-custody-v2 state");
+function seal(key, obj) {
+  const iv = randomBytes(12), c = createCipheriv("aes-256-gcm", key, iv); c.setAAD(AAD);
+  const ct = Buffer.concat([c.update(Buffer.from(JSON.stringify(obj))), c.final()]);
+  return Buffer.concat([iv, c.getAuthTag(), ct]);
+}
+function unseal(key, blob) {
+  const d = createDecipheriv("aes-256-gcm", key, blob.subarray(0, 12)); d.setAAD(AAD); d.setAuthTag(blob.subarray(12, 28));
+  return JSON.parse(Buffer.concat([d.update(blob.subarray(28)), d.final()]).toString("utf8"));
+}
+async function hostGet(hostUrl, p) { const r = await fetch(hostUrl + p); if (r.status === 404) return null; if (!r.ok) throw new Error(`host ${p}: ${r.status}`); return Buffer.from(await r.arrayBuffer()); }
+async function hostPut(hostUrl, p, body) { const r = await fetch(hostUrl + p, { method: "PUT", body }); if (!r.ok) throw new Error(`host ${p}: ${r.status}`); }
+
+async function main() {
+  const hc = readHostConfig();
+  const key = derivedKey();
+  // 1. the sealed state (keys + shares), or a fresh identity
+  let state = null;
+  const blob = await hostGet(hc.hostUrl, "/state").catch((e) => { log(`state fetch failed: ${e.message}`); return null; });
+  if (blob) { try { state = unseal(key, blob); log("sealed state opened"); } catch { throw new Error("the host's sealed state does not open in this guest (another chip or another custodian build): refusing to start rather than overwrite it"); } }
+  if (!state) {
+    const kp = hpke.generateKeyPair();
+    state = { identityKey: generatePrivateKey(), encPrivate: Buffer.from(kp.privateKey).toString("hex"), member: null };
+    await hostPut(hc.hostUrl, "/state", seal(key, state));
+    log("new custodian identity sealed");
+  }
+  const identity = privateKeyToAccount(state.identityKey);
+  const encPrivateKey = new Uint8Array(Buffer.from(state.encPrivate, "hex"));
+  const encKey = "0x" + Buffer.from(hpke.publicKeyOf(encPrivateKey)).toString("hex");
+  // 2. this machine's record: measurement and chip id from its OWN report
+  const probe = parseSnpReport(tsmReport(Buffer.alloc(32), hc.vcek).report);
+  const sha = (b) => "0x" + createHash("sha256").update(b).digest("hex");
+  const machine = { identity: identity.address.toLowerCase(), encKey, endpoint: hc.endpoint, chipId: sha(probe.chipId), registryId: hc.registryId, measurement: sha(probe.measurement) };
+  log(`machine ${machine.identity} measurement ${probe.measurement.toString("hex").slice(0, 16)}... chip ${machine.chipId.slice(0, 12)}...`);
+
+  const chain = createChainReaderV2({ rpcs: MEASURED.rpcs, vault: MEASURED.vault, minAgree: MEASURED.minAgree, maxAgeSec: MEASURED.maxAgeSec });
+  const store = { load: () => state.member, save: (m) => { state.member = m; hostPut(hc.hostUrl, "/state", seal(key, state)).catch((e) => log(`STATE SAVE FAILED: ${e.message}`)); } };
+  const saveNow = async () => hostPut(hc.hostUrl, "/state", seal(key, state));
+  const submit = async (fn, args) => {
+    const r = await fetch(hc.hostUrl + "/submit", { method: "POST", headers: { "content-type": "application/json" },
+      body: JSON.stringify({ fn, args }, (k, v) => (typeof v === "bigint" ? v.toString() : v)) });
+    const j = await r.json().catch(() => ({}));
+    if (!r.ok) throw new Error(`submit ${fn}: ${j.error || r.status}`);
+    return j.tx;
+  };
+  const fetchJson = async (url, body) => {
+    const r = await fetch(url, body === undefined ? {} : { method: "POST", headers: { "content-type": "application/json" }, body: JSON.stringify(body) });
+    const j = await r.json(); if (!r.ok) throw new Error(j.message || j.error || String(r.status)); return j;
+  };
+  const verifyPeerQuote = async (report, { binding, auxblob, minTcb }) => {
+    let p; try { p = parseSnpReport(report); } catch (e) { return { ok: false, reason: e.message }; }
+    const v = await verifyQuote(report, { challenge: Buffer.alloc(32, 1), transportKeySpki: Buffer.alloc(32, 1), expectedBinding: Buffer.from(binding),
+                                          allowedMeasurements: [p.measurement.toString("hex")], auxblob, requireVcek: true, minTcb, expectedVmpl: 0 });
+    if (!v.ok) return { ok: false, reason: v.reasons.slice(-1)[0] };
+    return { ok: true, measurement: p.measurement.toString("hex"), chipId: p.chipId.toString("hex") };
+  };
+  const member = createMember({ chainId: MEASURED.chainId, vault: MEASURED.vault, identity, encPrivateKey, machine, chain, store, submit, fetchJson,
+                                attestSelf: async (b) => tsmReport(b, hc.vcek), verifyPeerQuote, enclaveOwner: MEASURED.enclaveOwner, log });
+  const custodian = createCustodianV2({ chainId: MEASURED.chainId, vault: MEASURED.vault, encPrivateKey, shares: member.shares, chain,
+                                        verifiers: productionVerifiers({ collateral: cachedCollateral({ dir: "/tmp/amd-collateral", upstream: httpCollateral({ timeoutMs: 8000 }) }) }), log });
+
+  // 3. HTTP (the tunnel agent forwards the relay's /t/<name>/... here)
+  const rate = rateLimiter();
+  const json = (res, code, body) => { res.writeHead(code, { "content-type": "application/json", "cache-control": "no-store" }); res.end(JSON.stringify(body)); };
+  const srv = http.createServer(async (req, res) => {
+    const u = new URL(req.url, "http://x");
+    const client = String(req.headers["x-forwarded-for"] || req.socket.remoteAddress || "-").split(",")[0].trim().slice(0, 64);
+    try {
+      if (req.method === "GET" && (u.pathname === "/health" || u.pathname === "/")) return json(res, 200, { ok: true, role: "custodian-v2" });
+      if (req.method === "GET" && u.pathname === "/v2/custody/info") return json(res, 200, { ...member.info(hc.committeeId), chainId: MEASURED.chainId, vault: MEASURED.vault });
+      if (req.method !== "POST") return json(res, 405, { error: "method_not_allowed", message: "POST only." });
+      if (!rate(client)) return json(res, 429, { error: "rate_limited", message: "Too many requests; retry shortly." });
+      const chunks = []; let n = 0;
+      for await (const ch of req) { n += ch.length; if (n > 262144) return json(res, 413, { error: "too_large", message: "Body too large." }); chunks.push(ch); }
+      let body; try { body = JSON.parse(Buffer.concat(chunks).toString("utf8") || "{}"); } catch { return json(res, 400, { error: "bad_json", message: "Body must be JSON." }); }
+      switch (u.pathname) {
+        case "/v2/custody/challenge": return json(res, 200, custodian.challenge({ client }));
+        case "/v2/custody/release": return json(res, 200, await custodian.release(body));
+        case "/v2/custody/evidence": return json(res, 200, await member.evidence(String(body.nonce || "")));
+        case "/v2/custody/join": return json(res, 200, await member.join(body, hc.committeeId));
+        case "/v2/custody/approve": return json(res, 200, await member.approve({ ...body, next: body.next || [] }));
+        case "/v2/custody/host-binding": return json(res, 200, await member.setHostSig(String(body.sig || "")));
+        default: return json(res, 404, { error: "not_found", message: "Unknown custody route." });
+      }
+    } catch (e) {
+      if (e instanceof Refusal) return json(res, e.status, { error: e.code, message: e.message });
+      return json(res, 422, { error: "refused", message: String(e.message).slice(0, 300) });
+    }
+  });
+  srv.listen(hc.port, "0.0.0.0", () => log(`custodian-v2 on :${hc.port} for ${hc.endpoint}`));
+
+  // 4. genesis, if the host asked for it and there is no committee yet; then the engine
+  if (hc.genesis && !hc.committeeId && !(state.member && Object.keys(state.member.epochs || {}).length)) {
+    for (;;) {
+      if (state.member && state.member.hostSig) break;
+      if (member._state().hostSig) break;
+      log("genesis waits for the host binding (POST /v2/custody/host-binding)"); await new Promise((r) => setTimeout(r, 15000));
+    }
+    const g = await member.genesis({ salt: "0x" + randomBytes(32).toString("hex"), codeSet: [machine.measurement] });
+    await saveNow();
+    log(`GENESIS ${g.committeeId}: set committeeId in the host config`);
+  }
+  const loop = async () => {
+    const cid = hc.committeeId || Object.keys(member._state().epochs || {}).map((k) => k.split(":")[0])[0];
+    if (cid) { try { const r = await member.tick(cid); if (r.state !== "steady" && r.state !== "idle") log(`[engine] ${JSON.stringify(r)}`); } catch (e) { log(`[engine] ${e.message}`); } }
+    setTimeout(loop, 60_000);
+  };
+  setTimeout(loop, 5_000);
+}
+main().catch((e) => { log(`FATAL ${e.stack || e.message}`); process.exit(1); });
diff --git a/orig-9d43/custody/v2/digests.mjs b/orig-9d43/custody/v2/digests.mjs
new file mode 100644
index 0000000000000000000000000000000000000000..61bbe3d660b3cc650015eac2cce76ccc3ac13721
--- /dev/null
+++ b/orig-9d43/custody/v2/digests.mjs
@@ -0,0 +1,34 @@
+// The digests EnclaveSecretVaultV2 checks signatures over (docs/security/secret-custody-v2-spec.md §1.2). Every signature
+// is EIP-191 personal_sign over the 32-byte digest. test/custody-v2-contract.test.mjs pins these to the contract's own.
+import { keccak256, encodeAbiParameters, toBytes, bytesToHex, recoverMessageAddress } from "viem";
+
+const T = (type) => ({ type });
+export function machineHash(m) {
+  return keccak256(encodeAbiParameters([T("address"), T("bytes32"), T("bytes32"), T("bytes32"), T("bytes32"), T("bytes32")],
+    [m.identity, m.encKey, keccak256(toBytes(m.endpoint)), m.chipId, m.registryId, m.measurement]));
+}
+const hx = (b) => (typeof b === "string" ? b : bytesToHex(b));
+export const hostDigest = ({ chainId, vault, machine }) =>
+  keccak256(encodeAbiParameters([T("string"), T("uint256"), T("address"), T("bytes32")], ["enclave-custody-v2 host", BigInt(chainId), vault, machineHash(machine)]));
+export const genesisDigest = ({ chainId, vault, committeeId, Y, machine, codeSet }) =>
+  keccak256(encodeAbiParameters([T("string"), T("uint256"), T("address"), T("bytes32"), T("bytes32"), T("bytes32"), T("bytes32")],
+    ["enclave-custody-v2 genesis", BigInt(chainId), vault, committeeId, keccak256(hx(Y)), machineHash(machine), keccak256(encodeAbiParameters([T("bytes32[]")], [codeSet]))]));
+export const handoverDigest = ({ chainId, vault, committeeId, fromEpoch, next, dealerIndices }) =>
+  keccak256(encodeAbiParameters([T("string"), T("uint256"), T("address"), T("bytes32"), T("uint32"), T("bytes32"), T("bytes32")],
+    ["enclave-custody-v2 handover", BigInt(chainId), vault, committeeId, fromEpoch,
+     keccak256(encodeAbiParameters([T("bytes32[]")], [next.map(machineHash)])), keccak256(encodeAbiParameters([T("uint32[]")], [dealerIndices]))]));
+export const dealDigest = ({ chainId, vault, committeeId, toEpoch, dealerIndex, dealCommitments, sealed }) =>
+  keccak256(encodeAbiParameters([T("string"), T("uint256"), T("address"), T("bytes32"), T("uint32"), T("uint32"), T("bytes32"), T("bytes32")],
+    ["enclave-custody-v2 deal", BigInt(chainId), vault, committeeId, toEpoch, dealerIndex, keccak256(hx(dealCommitments)), keccak256(encodeAbiParameters([T("bytes[]")], [sealed.map(hx)]))]));
+export const ackDigest = ({ chainId, vault, committeeId, toEpoch, newCommitments }) =>
+  keccak256(encodeAbiParameters([T("string"), T("uint256"), T("address"), T("bytes32"), T("uint32"), T("bytes32")],
+    ["enclave-custody-v2 ack", BigInt(chainId), vault, committeeId, toEpoch, keccak256(hx(newCommitments))]));
+export const codeDigest = ({ chainId, vault, committeeId, epoch, measurement, add }) =>
+  keccak256(encodeAbiParameters([T("string"), T("uint256"), T("address"), T("bytes32"), T("uint32"), T("bytes32"), T("bool")],
+    ["enclave-custody-v2 code", BigInt(chainId), vault, committeeId, epoch, measurement, !!add]));
+export const committeeIdOf = ({ chainId, vault, salt, Y }) =>
+  keccak256(encodeAbiParameters([T("uint256"), T("address"), T("bytes32"), T("bytes32")], [BigInt(chainId), vault, salt, keccak256(hx(Y))]));
+
+// account: a viem local account; -> 65-byte hex signature (viem's are low-s)
+export const signDigest = (account, digest) => account.signMessage({ message: { raw: digest } });
+export const recoverDigest = (digest, signature) => recoverMessageAddress({ message: { raw: digest }, signature }).then((a) => a.toLowerCase()).catch(() => null);
diff --git a/orig-9d43/custody/v2/host.mjs b/orig-9d43/custody/v2/host.mjs
new file mode 100644
index 0000000000000000000000000000000000000000..05d364aecae08c3430510c061e8eca61f3c186e1
--- /dev/null
+++ b/orig-9d43/custody/v2/host.mjs
@@ -0,0 +1,111 @@
+#!/usr/bin/env node
+// The HOST side of a custody v2 custodian (docs/security/secret-custody-v2.md §8): OUTSIDE the TEE, untrusted for
+// secrecy. It
+//   - launches the custodian image as an SEV-SNP guest (kernel-hashes=on: kernel + initramfs + cmdline measured);
+//   - keeps the guest's SEALED state (ciphertext only; it opens solely inside that guest on this chip): GET/PUT /state;
+//   - submits the transactions the guest SIGNS (POST /submit), paying the gas; it can drop them, never forge them;
+//   - binds the guest to this host's registry entry: signs hostDigest(machine) with the host's registry operator key.
+//
+//   node custody/v2/host.mjs <config.json>
+// config: { dist, ovmf, sevDevice, qemu?, cpus, memMiB, tunnelName, endpoint, registryEndpoint, hostPort, mgmtPort, stateDir,
+//           committeeId?, genesis?, vcekFile?, relayUrl?, vault, rpc, registryKeyFile (JSON with registryKey), submitterKeyEnv }
+import fs from "node:fs";
+import path from "node:path";
+import http from "node:http";
+import { spawn } from "node:child_process";
+import { createPublicClient, createWalletClient, http as viemHttp, keccak256, toBytes, stringToHex } from "viem";
+import { privateKeyToAccount } from "viem/accounts";
+import { base } from "viem/chains";
+import { VAULT_V2_ABI, REGISTRY_V4_ABI } from "./chain.mjs";
+import * as D from "./digests.mjs";
+
+const cfg = JSON.parse(fs.readFileSync(process.argv[2], "utf8"));
+const log = (...a) => console.log(new Date().toISOString(), "[custodian-host]", ...a);
+const STATE = path.join(cfg.stateDir, "state.bin");
+fs.mkdirSync(cfg.stateDir, { recursive: true, mode: 0o700 });
+const registryId = keccak256(toBytes(cfg.registryEndpoint));
+const pub = createPublicClient({ chain: base, transport: viemHttp(cfg.rpc || "https://mainnet.base.org") });
+const submitter = process.env[cfg.submitterKeyEnv || "CUSTODY_SUBMITTER_KEY"] ? privateKeyToAccount(process.env[cfg.submitterKeyEnv || "CUSTODY_SUBMITTER_KEY"]) : null;
+const wallet = submitter ? createWalletClient({ chain: base, account: submitter, transport: viemHttp(cfg.rpc || "https://mainnet.base.org") }) : null;
+const ALLOWED = new Set(["createCommittee", "proposeHandover", "postDeal", "ackHandover", "proposeCode", "removeCode"]);
+
+// ---- fw_cfg for the guest (unmeasured) ----
+const fwPath = path.join(cfg.stateDir, "fwcfg.json");
+fs.writeFileSync(fwPath, JSON.stringify({
+  endpoint: cfg.endpoint, tunnelName: cfg.tunnelName, registryId, hostUrl: `http://10.0.2.2:${cfg.hostPort}`, port: 8787,
+  committeeId: cfg.committeeId || null, genesis: cfg.genesis === true, relayUrl: cfg.relayUrl || "wss://api.enclave.host/v1/fleet-tunnel",
+  vcek: cfg.vcekFile ? fs.readFileSync(cfg.vcekFile).toString("base64") : null }), { mode: 0o600 });
+
+// ---- state store + submitter (loopback; the guest reaches it as 10.0.2.2) ----
+const srv = http.createServer(async (req, res) => {
+  const send = (code, body, type = "application/json") => { res.writeHead(code, { "content-type": type }); res.end(typeof body === "string" || Buffer.isBuffer(body) ? body : JSON.stringify(body)); };
+  try {
+    if (req.url === "/state" && req.method === "GET") return fs.existsSync(STATE) ? send(200, fs.readFileSync(STATE), "application/octet-stream") : send(404, { error: "none" });
+    const chunks = []; for await (const c of req) chunks.push(c);
+    const body = Buffer.concat(chunks);
+    if (req.url === "/state" && req.method === "PUT") {
+      if (body.length < 28 || body.length > 4 << 20) return send(400, { error: "bad state" });
+      if (fs.existsSync(STATE)) fs.copyFileSync(STATE, `${STATE}.${Date.now()}`);   // keep history; prune below
+      const tmp = `${STATE}.tmp`; fs.writeFileSync(tmp, body, { mode: 0o600 }); fs.renameSync(tmp, STATE);
+      const old = fs.readdirSync(cfg.stateDir).filter((f) => /^state\.bin\.\d+$/.test(f)).sort();
+      for (const f of old.slice(0, Math.max(0, old.length - 20))) fs.unlinkSync(path.join(cfg.stateDir, f));
+      return send(200, { ok: true });
+    }
+    if (req.url === "/submit" && req.method === "POST") {
+      const { fn, args } = JSON.parse(body.toString("utf8"));
+      if (!ALLOWED.has(fn)) return send(400, { error: `not a custodian transaction: ${fn}` });
+      if (!wallet) return send(503, { error: "no submitter key configured" });
+      const hash = await wallet.writeContract({ address: cfg.vault, abi: VAULT_V2_ABI, functionName: fn, args });
+      const r = await pub.waitForTransactionReceipt({ hash, timeout: 120_000 });
+      log(`submitted ${fn}: ${hash} ${r.status}`);
+      if (r.status !== "success") return send(500, { error: `reverted: ${hash}` });
+      return send(200, { tx: hash });
+    }
+    send(404, { error: "not found" });
+  } catch (e) { log(`host api: ${e.shortMessage || e.message}`); send(500, { error: String(e.shortMessage || e.message).slice(0, 300) }); }
+});
+srv.listen(cfg.hostPort, "127.0.0.1", () => log(`state/submit on 127.0.0.1:${cfg.hostPort}`));
+
+// ---- the host binding: this host's registry operator signs the guest's machine record ----
+async function bindLoop() {
+  const reg = JSON.parse(fs.readFileSync(cfg.registryKeyFile, "utf8"));
+  const op = privateKeyToAccount(reg.registryKey.startsWith("0x") ? reg.registryKey : "0x" + reg.registryKey);
+  const book = await pub.readContract({ address: cfg.vault, abi: VAULT_V2_ABI, functionName: "book" });
+  const regAddr = await pub.readContract({ address: book, abi: [{ type: "function", name: "addr", stateMutability: "view", inputs: [{ type: "bytes32" }], outputs: [{ type: "address" }] }], functionName: "addr", args: [stringToHex("registry", { size: 32 })] });
+  const e = await pub.readContract({ address: regAddr, abi: REGISTRY_V4_ABI, functionName: "get", args: [registryId] });
+  if (!e.active || e.operator.toLowerCase() !== op.address.toLowerCase()) { log(`REFUSING to bind: ${cfg.registryEndpoint}'s registry operator is ${e.operator}, not this key`); return; }
+  for (;;) {
+    try {
+      const i = await (await fetch(`http://127.0.0.1:${cfg.mgmtPort}/v2/custody/info`)).json();
+      if (i.hostSig) { log(`guest ${i.identity} bound (${i.epochs?.length || 0} epoch(s) held)`); return; }
+      const sig = await D.signDigest(op, D.hostDigest({ chainId: 8453, vault: cfg.vault.toLowerCase(), machine: i.machine }));
+      const r = await fetch(`http://127.0.0.1:${cfg.mgmtPort}/v2/custody/host-binding`, { method: "POST", headers: { "content-type": "application/json" }, body: JSON.stringify({ sig }) });
+      log(`host binding for ${i.identity}: ${r.status} ${await r.text()}`);
+      if (r.ok) return;
+    } catch (err) { log(`waiting for the guest: ${err.message}`); }
+    await new Promise((r) => setTimeout(r, 10_000));
+  }
+}
+
+// ---- the SEV-SNP guest ----
+const dist = cfg.dist;
+const cmdline = fs.readFileSync(path.join(dist, "cmdline"), "utf8").trim();
+const args = [
+  "-machine", "q35,accel=kvm,confidential-guest-support=cx0,memory-backend=ram0", "-cpu", "host", "-smp", String(cfg.cpus || 2), "-m", String(cfg.memMiB || 3072),
+  "-nographic", "-no-reboot", "-kernel", path.join(dist, "vmlinuz"), "-initrd", path.join(dist, "initramfs.cpio.gz"), "-append", cmdline,
+  "-fw_cfg", `name=opt/org.enclave.custody,file=${fwPath}`,
+  "-netdev", `user,id=net0,hostfwd=tcp:127.0.0.1:${cfg.mgmtPort}-:8787`,
+  "-device", "virtio-net-pci,netdev=net0,csum=off,gso=off,guest_csum=off,host_tso4=off,host_tso6=off,guest_tso4=off,guest_tso6=off,guest_ecn=off,host_ufo=off,guest_ufo=off",
+  "-serial", "mon:stdio",
+  "-object", `memory-backend-memfd,id=ram0,size=${cfg.memMiB || 3072}M,share=true,prealloc=false`, "-bios", cfg.ovmf,
+  "-object", `sev-snp-guest,id=cx0,cbitpos=51,reduced-phys-bits=1,kernel-hashes=on,sev-device=${cfg.sevDevice || "/dev/sev"}`,
+];
+let child = null, stopping = false, restarts = 0;
+function launch() {
+  log(`launching ${cfg.tunnelName} from ${dist}`);
+  child = spawn(cfg.qemu || "qemu-system-x86_64", args, { stdio: ["ignore", "inherit", "inherit"] });
+  child.on("exit", (code, sig) => { if (stopping) return; restarts++; const d = Math.min(5000 * restarts, 60000); log(`guest exited ${code}/${sig}; relaunch in ${d} ms`); setTimeout(launch, d); });
+  setTimeout(() => bindLoop().catch((e) => log(`bind: ${e.message}`)), 20_000);
+}
+for (const s of ["SIGTERM", "SIGINT"]) process.on(s, () => { stopping = true; if (child) child.kill("SIGTERM"); setTimeout(() => process.exit(0), 3000); });
+launch();
