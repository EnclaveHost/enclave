+        bad[3] = new uint32[](3); bad[3][0] = 1; bad[3][1] = 2; bad[3][2] = 5;     // above W
+        bad[4] = new uint32[](3); bad[4][0] = 2; bad[4][1] = 3; bad[4][2] = 2;     // duplicate
