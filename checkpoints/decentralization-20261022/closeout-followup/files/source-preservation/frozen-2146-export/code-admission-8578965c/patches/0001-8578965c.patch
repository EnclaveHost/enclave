+    function test_dealerIndicesAreValidated() public {
+        (bytes32 cid, EnclaveSecretVaultV2.Machine[] memory l) = _fiveSeatCommittee();   // t 3, W 4
+        bytes[] memory hs = _hostSigs(l);
