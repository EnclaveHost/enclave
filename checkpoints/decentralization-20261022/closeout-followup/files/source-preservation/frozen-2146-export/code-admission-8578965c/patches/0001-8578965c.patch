+        // 3 non-Enclave seats and no Enclave seat at all: allowed at n >= 3
+        l = new EnclaveSecretVaultV2.Machine[](3); l[0] = a; l[1] = b; l[2] = c;
+        vm.warp(block.timestamp + 1 days);
+        _propose(cid, l);
+        (t, W) = _pendingTW(cid); assertEq(t, 2); assertEq(W, 3);
