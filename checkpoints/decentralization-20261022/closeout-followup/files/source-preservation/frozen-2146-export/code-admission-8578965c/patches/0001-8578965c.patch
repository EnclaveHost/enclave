+        vm.expectRevert(EnclaveSecretVaultV2.BadDealers.selector);
+        vault.postDeal(cid, to, 1, com, st, a.identity, sig);
+        _deal(cid, to, 1, e.identity);
+        _deal(cid, to, 2, e.identity);
+        _ackAll(cid, to);
+        (, uint32 e2,,,) = vault.committeeOf(cid);
+        assertEq(e2, epoch + 1);
+    }
