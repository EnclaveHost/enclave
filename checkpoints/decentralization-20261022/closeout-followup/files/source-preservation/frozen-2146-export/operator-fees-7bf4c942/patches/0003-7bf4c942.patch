+// Base GasPriceOracle predeploy, assumptions explicit:
+//   getL1FeeUpperBound(_unsignedTxSize) (Fjord+): treats its argument as an UNSIGNED size, adds ORACLE_SIGNATURE_ALLOWANCE
+//     (68) bytes for the signature and applies the worst-case fastlz bound -> the L1 data fee upper bound.
+//   isIsthmus() / getOperatorFee(_gasUsed) (Isthmus+): the predeploy computes the OP-stack operator fee the protocol
+//     charges for a given gas used, from the operator-fee parameters in force at the read block. The fee is non-decreasing
+//     in gas used, so getOperatorFee(gas limit) bounds this transaction's operator fee at those parameters. A chain whose
+//     oracle cannot answer (function absent / reverts / not Isthmus) leaves the operator fee UNDETERMINED: the plan refuses
+//     rather than claim a bound.
+// All three are bounds at the agreed block's oracle parameters (L1 fee inputs and operator-fee parameters can change
+// before inclusion); --send re-reads them fresh.
+const ORACLE_ABI = [
+  { type: "function", name: "getL1FeeUpperBound", stateMutability: "view", inputs: [{ type: "uint256" }], outputs: [{ type: "uint256" }] },
+  { type: "function", name: "isIsthmus", stateMutability: "view", inputs: [], outputs: [{ type: "bool" }] },
+  { type: "function", name: "getOperatorFee", stateMutability: "view", inputs: [{ type: "uint256" }], outputs: [{ type: "uint256" }] },
+];
+export const ORACLE_SIGNATURE_ALLOWANCE = 68;
+/**
+ * Encoded sizes of the EXACT transaction (its real nonce, gas and fee fields): unsigned, and the MAXIMUM signed size
+ * (yParity 1, r = s = 2^256-1; type 2 without an access list, as signed here). `argument` is the size passed to
+ * getL1FeeUpperBound: the smallest value whose oracle-side size (argument + 68) still covers the maximum signed size.
+ */
+export function txSizes(tx) {
+  const unsigned = (serializeTransaction(tx).length - 2) / 2;
+  const signedMax = (serializeTransaction(tx, { r: "0x" + "ff".repeat(32), s: "0x" + "ff".repeat(32), yParity: 1 }).length - 2) / 2;
+  return { unsigned, signedMax, argument: Math.max(unsigned, signedMax - ORACLE_SIGNATURE_ALLOWANCE) };
+}
+/** Refuses a size argument whose oracle-side size would undercount the signed transaction. */
+export function assertCoversSigned({ argument, signedMax }) {
+  if (!(Number.isSafeInteger(argument) && argument + ORACLE_SIGNATURE_ALLOWANCE >= signedMax))
+    refuse("l1_size", `the L1 fee size ${argument} (+${ORACLE_SIGNATURE_ALLOWANCE} signature bytes) undercounts the signed transaction (${signedMax} bytes)`);
+}
 const ZERO = "0x0000000000000000000000000000000000000000";
 
 export class Refusal extends Error { constructor(code, message) { super(message); this.code = code; } }
