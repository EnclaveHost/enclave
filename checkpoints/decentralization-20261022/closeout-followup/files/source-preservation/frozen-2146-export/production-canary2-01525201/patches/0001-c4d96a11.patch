+      observed: { block: o.blk.number.toString(), blockHash: o.blk.hash, rpcs: rpcs.map((u) => new URL(u).host), balanceWei: o.balance.toString(), baseFeePerGas: o.blk.baseFee.toString(),
+        estimates: pr.estimates, unsignedSize: pr.unsignedSize, l1FeeUpperBoundWei: pr.l1FeeUpperBound.toString(), isthmus: pr.isthmus, operatorFeeBoundWei: pr.operatorFeeBound.toString(),
