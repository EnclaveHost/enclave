+    try {
+      l1 = viem.decodeFunctionResult({ abi: ORACLE_ABI, functionName: "getL1FeeUpperBound",
+        data: await o.call(ORACLE, viem.encodeFunctionData({ abi: ORACLE_ABI, functionName: "getL1FeeUpperBound", args: [BigInt(size)] })) });
+      isthmus = viem.decodeFunctionResult({ abi: ORACLE_ABI, functionName: "isIsthmus", data: await o.call(ORACLE, viem.encodeFunctionData({ abi: ORACLE_ABI, functionName: "isIsthmus" })) });
+      opFee = isthmus ? viem.decodeFunctionResult({ abi: ORACLE_ABI, functionName: "getOperatorFee",
+        data: await o.call(ORACLE, viem.encodeFunctionData({ abi: ORACLE_ABI, functionName: "getOperatorFee", args: [gas] })) }) : 0n;
+    } catch (e) { if (e instanceof Refusal) throw e; refuse("fee_unbounded", `the L1/operator fee bound could not be read (${String(e.message).slice(0, 120)}): no unaccounted cost is allowed`); }
