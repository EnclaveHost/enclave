+#!/bin/bash
+# Control: the NEW test file run against the UNMODIFIED deabf8f90 tree must FAIL on the vault assertions (exit != 0 expected).
+set -u
+cd "$(dirname "$0")"
+rm -rf control-wt; git -C repo worktree add -q --detach ../control-wt deabf8f90f64902d20d48620fd911d34c445859d
+for d in . relay network; do ln -s "$(cd repo/$d && readlink -f node_modules)" control-wt/$d/node_modules; done
+mkdir -p control-wt/test/helpers; cp repo/test/helpers/gsup-env-harness.mjs control-wt/test/helpers/; cp repo/test/metal-gsup-custody-env.test.mjs control-wt/test/
+(cd control-wt && node --test --test-concurrency=1 test/metal-gsup-custody-env.test.mjs); rc=$?
+git -C repo worktree remove --force ../control-wt
+echo "control exit $rc (expected non-zero)"; [ $rc -ne 0 ]
diff --git a/entries.py b/entries.py
new file mode 100644
index 0000000000000000000000000000000000000000..7714ea474ed9d62d3cc40f742c3a9d9e9a6821e9
--- /dev/null
+++ b/entries.py
@@ -0,0 +1,27 @@
+"""entries.py A.cpio.gz B.cpio.gz : stream BOTH newc archives (64 KiB chunks) and print every entry that differs
+(name, mode, size, sha256) as JSON lines, then a summary. Read-only."""
+import gzip, hashlib, json, sys
+def entries(path):
+    out = {}
+    with gzip.open(path, 'rb') as f:
+        buf = bytearray()
+        def read(n):
+            while len(buf) < n:
+                c = f.read(65536)
+                if not c: raise EOFError(path)
+                buf.extend(c)
+            d = bytes(buf[:n]); del buf[:n]; return d
+        while True:
+            h = read(110); fld = [int(h[6+8*i:14+8*i], 16) for i in range(13)]
+            mode, size, ns = fld[1], fld[6], fld[11]
+            name = read(ns)[:-1].decode('utf-8', 'surrogateescape'); read((-(110+ns)) % 4)
+            if name == 'TRAILER!!!': break
+            hs = hashlib.sha256(); left = size
+            while left: k = min(65536, left); hs.update(read(k)); left -= k
+            read((-size) % 4)
+            out[name] = (oct(mode), size, hs.hexdigest())
+    return out
+a, b = entries(sys.argv[1]), entries(sys.argv[2])
+diff = sorted(k for k in set(a) | set(b) if a.get(k) != b.get(k))
+for k in diff: print(json.dumps({'entry': k, 'a': a.get(k), 'b': b.get(k)}))
+print(json.dumps({'entriesA': len(a), 'entriesB': len(b), 'differing': diff}))
