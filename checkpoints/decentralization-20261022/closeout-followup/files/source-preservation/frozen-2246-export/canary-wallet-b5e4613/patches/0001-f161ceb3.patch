+    const blocks = await both("eth_getBlockByNumber", [hexN(n), false]);
+    if (!blocks[0] || !blocks[1] || lc(blocks[0].hash) !== lc(blocks[1].hash)) refuse("rpc_disagree", `the RPCs disagree on block ${n}`);
