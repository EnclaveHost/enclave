+      catch (e) {
+        // an unknown upload that is not servable was not stored: a new authorization (same bytes, same CID) is allowed
+        if (state.status === "upload-unknown") set({ status: "ready", lastError: String(e.message).slice(0, 300), note: "the earlier upload is not servable; authorize again" });
