+# PHASE 1 (ROOT EXECUTES, read-only, after stage.py): python3 work/custody-boot-price-activation-20261023/prepare-admission.py
+# Reads (a) the PUBLIC attestation allowlist, (b) over root's SSH, READ-ONLY, the relay's installed measurement env file
+# (its sha256 and body - a public measurement list, no secret) and its drop-in sha256 and the API service state.
+# Asserts: the installed file is the second attempt's admission (dd62be7c...: the 36 + 08d1f838, 22:10Z) holding exactly the 37
+# public measurements, the running ed918e4b, ee5df6b8 and 08d1f838 among them, the approved candidate not yet; the drop-in is the
+# installed one. Writes admission.json + measurement.env (ADDITIVE: all 37 in their installed order, then the candidate = 38;
+# nothing removed). The remote backup name is unique to the candidate commit (.before-<short>): the earlier .before-a6b1378cd and
+# .before-9f6d37bd8 stay untouched (admit.py's CAS refuses an existing backup).
+# Changes nothing anywhere.
+import json, sys
+from common import *
+NEW = load_new()
