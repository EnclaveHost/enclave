+        worst = gas * mf + int(sp['l1FeeUpperBoundWei']) + int(sp.get('operatorFeeWei') or 0)
+        if int(sp['worstCaseWei']) != worst: out.append('worst case does not add up')
+        bal = int(o['balanceWei'])
