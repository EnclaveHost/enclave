+const chain=await import('../windows/node/chain.mjs');
+chain.addresses.deployments=DEPLOYMENTS;chain.addresses.appCatalog=CATALOG;chain.loadOperator();
+const {Host}=await import('../windows/node/host.mjs');
+const dirs=[];after(()=>{rpc.close();for(const dir of dirs)fs.rmSync(dir,{recursive:true,force:true});});
+const id='0x'+'ab'.repeat(32), id2='0x'+'ac'.repeat(32),ref='catalog://0x'+'cd'.repeat(32)+'/1',endpoint='https://api.enclave.host/t/lease-readiness-test';
+const version={cid:'bafy',version:'1',vramMb:0,gpuGflops:0,memMb:512,cpuGflops:0,createdAt:1n,verified:true,yanked:false,ports:'',approval:1,config:'{}'};
+const row=(h,key=id,seconds=3600)=>({id:key,owner:chain.operatorAddress(),appRef:ref,ports:'',configCid:'',gpuMilli:0,cpuMilli:100,appPort:8000,isPublic:true,
+ active:true,createdAt:1n,rate:1n,balance6:1000000n,spent6:0n,runner:h.enclaveId,runnerOperator:chain.operatorAddress(),leaseUntil:BigInt(Math.floor(Date.now()/1000)+seconds)});
+async function box(answer=async()=>null){
+ rpc.row.current=null;rpc.rows.current=null;rpc.rows.failGet=null;rpc.chainTx.mine=false;rpc.catalog.current=version;
+ const dir=fs.mkdtempSync(path.join(os.tmpdir(),'lease-readiness-'));dirs.push(dir);
+ const cfg={dir,endpoint,name:'test',appsEnabled:true,vcpus:8,ramGb:16,cpuPricePerSec6:0,hostAdmission:{hostId:chain.enclaveIdOf(endpoint),refusal:answer}};
+ const h=new Host(cfg);h.chainReady=true;h.registered={cpuPricePerSec6:'0'};await h.refreshOwners();
+ for(const name of ['followBook','enforceOff','ensureRegistered','ensurePriced','scanLedger','retireForeignRecovered'])h[name]=async()=>{};
+ h.ensureApp=async key=>{const r={...h.records.get(key),status:'running'};h.records.set(key,r);return r;};
+ return {h,cfg};
+}
+function serving(h,key=id){h.tracked.add(key);h.records.set(key,{id:key,status:'running',appRef:ref,isolationRequired:false});h.apps.set(key,{state:'running',stop:async()=>{},alive:async()=>true});}
+const health=(h,key=id)=>h.leaseReadiness().deployments.find(r=>r.id===key);
+
+test('cold process cannot advertise a completed pass, even with a persisted tracked deployment',async()=>{
+ const {h,cfg}=await box();fs.writeFileSync(path.join(cfg.dir,'host-state.json'),JSON.stringify({tracked:[id],leaseReadiness:{sequence:100,completedAt:Date.now()}}));
+ const restarted=new Host(cfg);assert.ok(restarted.tracked.has(id));assert.deepEqual(restarted.leaseReadiness(),{sequence:0,startedAt:0,completedAt:0,inFlight:false,deployments:[]});
+});
+
+test('completed pass reports actual lease/runner and running adoption without sending needless renewal',async()=>{
+ const {h}=await box();serving(h);rpc.row.current=row(h);const before=rpc.chainTx.sent.length;const t=Date.now();await h.tick();
+ const r=h.leaseReadiness();assert.equal(r.sequence,1);assert.equal(r.inFlight,false);assert.ok(r.completedAt>=r.startedAt&&r.startedAt>=t);
+ assert.equal(health(h).status,'ready');assert.equal(health(h).runner,h.enclaveId.toLowerCase());assert.equal(health(h).leaseUntil,Number(rpc.row.current.leaseUntil));assert.ok(health(h).observedAt>=t);assert.equal(rpc.chainTx.sent.length,before);
+ r.deployments[0].status='forged';assert.equal(health(h).status,'ready','returned rows cannot alter private readiness');
+});
+
+test('slow policy remains pending; overlapping tick joins the same pass',async()=>{
+ let release,entered;const seen=new Promise(r=>entered=r),gate=new Promise(r=>release=r);
+ const {h}=await box(async()=>{entered();await gate;return null;});serving(h);rpc.row.current=row(h);
+ const a=h.tick();await seen;const b=h.tick();assert.equal(a,b);assert.equal(h.leaseReadiness().completedAt,0);assert.equal(h.leaseReadiness().inFlight,true);assert.equal(health(h).status,'pending');
+ release();await a;assert.equal(health(h).status,'ready');assert.equal(h.leaseReadiness().sequence,1);
+});
+
+test('a failed subsequent pass clears old completion and ready rows',async()=>{
+ const {h}=await box();serving(h);rpc.row.current=row(h);await h.tick();assert.equal(health(h).status,'ready');
+ h.followBook=async()=>{throw Error('book unavailable');};await assert.rejects(h.tick(),/book unavailable/);
+ assert.equal(h.leaseReadiness().sequence,2);assert.equal(h.leaseReadiness().completedAt,0);assert.equal(h.leaseReadiness().inFlight,false);assert.equal(health(h).status,'pending');
+});
+
+test('unknown wallet policy cannot reuse earlier ready evidence',async()=>{
+ let unknown=false;const {h}=await box(async()=>{if(unknown)throw Error('policy unavailable');return null;});serving(h);rpc.row.current=row(h);await h.tick();assert.equal(health(h).status,'ready');
+ unknown=true;await h.tick();assert.equal(health(h).status,'pending');assert.notEqual(h.records.get(id).status,'running');
+});
+
+test('one unreadable lease never hides behind another running deployment',async()=>{
+ const {h}=await box();serving(h);serving(h,id2);rpc.rows.current=[row(h),row(h,id2)];rpc.rows.failGet=key=>key===id2;
+ await h.tick();assert.equal(health(h).status,'ready');assert.equal(health(h,id2).status,'pending');assert.ok(h.leaseReadiness().completedAt>0);
+});
+
+test('renewal failure is not ready even though the existing app remains running',async()=>{
+ const {h}=await box();serving(h);rpc.row.current=row(h,id,60);await h.tick();
+ assert.equal(h.records.get(id).status,'running');assert.match(h.records.get(id).reason,/renew failed|will not renew/);assert.equal(health(h).status,'not-ready');
+});
+
+test('unsuccessful adoption never reports readiness',async()=>{
+ const {h}=await box();serving(h);h.apps.delete(id);rpc.row.current=row(h);h.ensureApp=async()=>{h.records.set(id,{...h.records.get(id),status:'held'});};
+ await h.tick();assert.equal(health(h).status,'not-ready');
+});
+
+test('actual Host readiness serializes into the exact cutover gate; a cold successor is refused',async()=>{
+ const {spawnSync}=await import('node:child_process');const {fileURLToPath}=await import('node:url');
+ assert.ok(process.env.PWSH,'PWSH is required for the integration check');
+ const here=path.dirname(fileURLToPath(import.meta.url));const tools=path.resolve(here,'../../cutover/tools');
+ const script=path.resolve(tools,'../helper/node-hold-cutover.ps1');const sinceMs=Date.now()-1;
+ const {h,cfg}=await box();serving(h);rpc.row.current=row(h);await h.tick();
+ const file=path.join(cfg.dir,'readiness-fixture.json');
+ function gate(host){
+  fs.writeFileSync(file,JSON.stringify({sinceMs,params:{runner:h.enclaveId,expectedIds:[id],lease:{marginSec:180}},state:{deployments:host.deployments(),leaseReadiness:host.leaseReadiness()}}));
+  const r=spawnSync(process.env.PWSH,['-NoProfile','-NonInteractive','-File',path.join(tools,'gate-from-report.ps1'),'-Script',script,'-Fixture',file],{encoding:'utf8',timeout:10000});
+  assert.equal(r.status,0,r.stderr);return JSON.parse(r.stdout).ready;
+ }
+ assert.equal(gate(h),true);assert.equal(gate(new Host(cfg)),false);
+});
diff --git a/test/windows-node-wallet-enroll.test.mjs b/test/windows-node-wallet-enroll.test.mjs
new file mode 100644
index 000000000..372a66b9d
--- /dev/null
+++ b/test/windows-node-wallet-enroll.test.mjs
@@ -0,0 +1,46 @@
+// network-enroll.mjs carries the node's wallet hold channel into the privacy agent's config (enclaveNetwork.walletAdmission)
+// only while the node runs one, and drops it - restarting the agent once each way - when it stops; the agent then reads it.
+import { test } from "node:test";
+import assert from "node:assert/strict";
+import fs from "node:fs";
+import os from "node:os";
+import path from "node:path";
+import { createNetworkEnroll } from "../windows/node/network-enroll.mjs";
+import { rawDigest } from "../network/shield-expectation.mjs";
+
+const RID = "ab".repeat(32), APP = "0x" + "5a".repeat(32), RUNNER = "0x" + "22".repeat(32), D = "0x" + "11".repeat(32);
+const CID = "bafkreibjbefi32gvjrd54lhdizq6zlywym6urcuztzvi455xfv23tyjnza";
+
+function world(walletAdmission) {
+  const dir = fs.mkdtempSync(path.join(os.tmpdir(), "wallet-enroll-")), agentDir = path.join(dir, "agent"), policyFile = path.join(dir, "policy.json");
+  fs.mkdirSync(agentDir); fs.writeFileSync(policyFile, JSON.stringify({ cpu: { runtimeId: RID }, gpu: {} }));
+  const rows = [{ id: D, appRef: `catalog://${APP}/4`, configCid: "{}", runner: RUNNER, active: true, isPublic: true, leaseUntil: 9999999999n }];
+  const vm = { name: D, status: "running", appReady: true, catalog: { app: APP, version: 4 }, cid: CID, appId: "ef".repeat(32), runtimeId: RID,
+               componentSha256: rawDigest(CID), derivation: "enclave-catalog-bundle/1", gpuMilli: 0, startedAt: 1 };
+  let restarts = 0;
+  const make = (wa) => createNetworkEnroll({ agentDir, binDir: path.join(dir, "bin"), runner: RUNNER, relayBase: "https://api.enclave.host",
+    fetch: async () => ({ ok: true, json: async () => ({ domains: {} }) }), log: () => {}, restartAgent: async () => { restarts++; },
+    config: { agentDir, binDir: path.join(dir, "bin"), nodeBinary: "node.exe", operatorKeyFile: "op.key", runner: RUNNER, endpoint: "https://api.enclave.host/t/box",
+      relayBase: "https://api.enclave.host", policyFile, tpmBinary: "tpmattest.exe", tpmSha256: "aa".repeat(32), addressBook: "0x" + "44".repeat(20), chainRpc: ["https://rpc"],
+      enclaveNetwork: { checkers: ["0x" + "57".repeat(20)] }, walletAdmission: wa },
+    rows: async () => rows, version: async () => ({ cid: CID }), vms: async () => [vm] });
+  const read = () => JSON.parse(fs.readFileSync(path.join(agentDir, "privacy-config.json"), "utf8"));
+  return { dir, agentDir, make, read, restarts: () => restarts };
+}
+
+test("the channel is enrolled only while the node runs one: added and dropped with one agent restart each, steady otherwise", async () => {
+  const w = world(null);
+  await w.make(null).pass();
+  assert.equal(w.read().enclaveNetwork.walletAdmission, undefined, "no channel: the agent admits on lease and proof as before");
+  const file = path.join(w.agentDir, "wallet-admission.json");
+  const on = w.make({ file });
+  await on.pass();
+  assert.deepEqual(w.read().enclaveNetwork.walletAdmission, { file }); assert.equal(w.restarts(), 1, "the agent restarts once to enforce it");
+  assert.equal((await on.pass()).changed, false); assert.equal(w.restarts(), 1, "steady: no further restart");
+  await w.make(null).pass();
+  assert.equal(w.read().enclaveNetwork.walletAdmission, undefined, "a node without a channel (rolled back, or OFF) drops it");
+  assert.equal(w.restarts(), 2);
+  await w.make({ file: "relative.json" }).pass();
+  assert.equal(w.read().enclaveNetwork.walletAdmission, undefined, "a relative path is never enrolled");
+  fs.rmSync(w.dir, { recursive: true, force: true });
+});
diff --git a/test/windows-node-wallet-network-hold.test.mjs b/test/windows-node-wallet-network-hold.test.mjs
new file mode 100644
index 000000000..b7b6ca510
--- /dev/null
+++ b/test/windows-node-wallet-network-hold.test.mjs
@@ -0,0 +1,250 @@
+// The non-destructive wallet hold, end to end on one box: the REAL Host (windows/node/host.mjs) with chain.mjs on a fake
+// Base RPC and the real IsolationManagerClient against a loopback manager that counts removals, writing its wallet channel
+// (network/wallet-admission.mjs) that the REAL PrivacyAgent / EnclaveNetworkManager / EgressMap read, whose status.json
+// the Host then reads back as the hold's acknowledgement. An UNKNOWN host-wallet answer keeps a running domain only with
+// that acknowledgement; everything else is retired as before.
+import {test,after} from 'node:test';
+import assert from 'node:assert/strict';
+import fs from 'node:fs';
+import os from 'node:os';
+import path from 'node:path';
+import http from 'node:http';
+import net from 'node:net';
+import {once} from 'node:events';
+import {fakeBaseRpc,DEPLOYMENTS,CATALOG} from './helpers/fake-base-rpc.mjs';
+process.env.NODE_OPERATOR_KEY='0x'+'7f'.repeat(32);
+delete process.env.ENCLAVE_NETWORK_WALLET_HOLD;
+const rpc=await fakeBaseRpc();
+const chain=await import('../windows/node/chain.mjs');
+chain.addresses.deployments=DEPLOYMENTS;chain.addresses.appCatalog=CATALOG;chain.loadOperator();
+const {Host}=await import('../windows/node/host.mjs');
+const {PrivacyAgent}=await import('../network/privacy-agent.mjs');
+const {WalletAllowFile}=await import('../network/wallet-admission.mjs');
+const {defaultNetworkPolicy}=await import('../network/network-policy-core.mjs');
+const {HostEgress}=await import('../network/host-egress.mjs');
+const dirs=[];
+const id='0x'+'ab'.repeat(32),ref='catalog://0x'+'cd'.repeat(32)+'/1',endpoint='https://api.enclave.host/t/wallet-hold-test';
+const runner=chain.enclaveIdOf(endpoint).toLowerCase(),INSTANCE='hv'+'1'.repeat(32);
+const version={cid:'bafy',version:'1',vramMb:0,gpuGflops:0,memMb:512,cpuGflops:0,createdAt:1n,verified:true,yanked:false,ports:'',approval:1,config:'{}'};
+const expected={appRef:ref,configCid:'',appSha256:'4'.repeat(64),runtimeId:'runtime'};
+
+const mgr={vms:[],removed:[]};
+const srv=http.createServer((q,s)=>{const send=(c,b)=>{s.writeHead(c,{'content-type':'application/json'});s.end(JSON.stringify(b));};
+ const m=q.url.match(/^\/vms(?:\/([^/?]+))?$/);if(!m)return send(404,{error:'no'});
+ const vid=m[1]&&decodeURIComponent(m[1]);
+ if(q.method==='GET'&&!vid)return send(200,{vms:mgr.vms});
+ if(q.method==='GET'){const v=mgr.vms.find(x=>x.id===vid);return v?send(200,v):send(404,{error:'gone'});}
+ if(q.method==='DELETE'){const i=mgr.vms.findIndex(x=>x.id===vid);if(i<0)return send(404,{error:'gone'});mgr.removed.push(vid);mgr.vms.splice(i,1);return send(200,{removed:vid});}
+ send(405,{});});
+await new Promise(r=>srv.listen(0,'127.0.0.1',r));
+const MANAGER=`http://127.0.0.1:${srv.address().port}`;
+const realNow=Date.now;let skew=0;Date.now=()=>realNow()+skew;
+const loops=new Set();
+after(()=>{for(const l of loops)clearInterval(l);Date.now=realNow;rpc.close();srv.close();for(const dir of dirs)fs.rmSync(dir,{recursive:true,force:true});});
+
+const row=()=>({id,owner:chain.operatorAddress(),appRef:ref,ports:'',configCid:'',gpuMilli:0,cpuMilli:100,appPort:8000,isPublic:true,
+ active:true,createdAt:1n,rate:1n,balance6:1000000n,spent6:0n,runner,runnerOperator:chain.operatorAddress(),
+ leaseUntil:BigInt(Math.floor(Date.now()/1000)+600)});
+const quiet=h=>{for(const name of ['followBook','enforceOff','ensureRegistered','ensurePriced','scanLedger','retireForeignRecovered'])h[name]=async()=>{};};
+const UNKNOWN=()=>{throw Error('chain quorum unavailable');};
+const ALLOW=(ms=80_000)=>({refusal:null,validUntil:Date.now()+ms});
+
+// the network agent of this box: the real PrivacyAgent on the host's channel file, its own lease and guest proof kept fresh
+// (what its chain round and proof renewal do), its admission + snapshot timer at 100 ms (1 s in production)
+function network(agentDir,{walletRunner=runner,wallet=true,run=true}={}){
+ const reader=wallet?new WalletAllowFile({file:path.join(agentDir,'wallet-admission.json'),runner:walletRunner}):null;
+ const agent=new PrivacyAgent({apps:[{deploymentId:id,expected}],runner,wallet:reader,directory:path.join(agentDir,'state'),dns:['1.1.1.1'],
+  leaseReader:{get:()=>null},network:{localRoutes:false,runtime:{},providers:async()=>[]}});
+ const prove=()=>{agent.admission.observeLease({id,runner,owner:'0x'+'5'.repeat(40),appRef:ref,configCid:'',active:true,isPublic:true,validUntil:Date.now()+90_000,leaseUntil:Date.now()+90_000});
+  agent.admission.proofs.set(id,{deploymentId:id,appSha256:expected.appSha256,runtimeId:expected.runtimeId,spkiSha256:'5'.repeat(64),validUntil:Date.now()+60_000});};
+ const tick=async()=>{prove();await agent.snapshot();};
+ let loop=null;const start=()=>{loop=setInterval(()=>void tick().catch(()=>{}),100);loops.add(loop);},stop=()=>{clearInterval(loop);loops.delete(loop);};
+ const n={agent,reader,tick,start,stop,
+  admitted:()=>agent.manager.authorizationUntil(id)>Date.now(),
+  egress:()=>JSON.parse(fs.readFileSync(path.join(agentDir,'state','egress-routes.json'),'utf8')).apps,
+  configure:()=>agent.manager.configure([{deploymentId:id,names:[id.slice(2,10)+'.app.enclave.host'],policy:defaultNetworkPolicy(id)}])};
+ return n;
+}
+// a FRESH node process with the channel on, a running domain on the manager, and its box's network agent
+async function box(answer,{hostAdmission,agentDir,networkOpts={},startNetwork=true,cfg={}}={}){
+ skew=0;mgr.removed=[];mgr.vms=[{id:INSTANCE,name:id,status:'running',appId:'a'.repeat(64)}];
+ const dir=fs.mkdtempSync(path.join(os.tmpdir(),'host-wallet-hold-'));dirs.push(dir);
+ agentDir||=path.join(dir,'agent');fs.mkdirSync(path.join(agentDir,'state'),{recursive:true});
+ const walletAdmission={file:path.join(agentDir,'wallet-admission.json'),statusFile:path.join(agentDir,'state','status.json')};
+ const h=new Host({dir,endpoint,name:'test',appsEnabled:true,vcpus:8,ramGb:16,cpuPricePerSec6:0,isolationManager:MANAGER,walletAdmission,...cfg,
+   hostAdmission:hostAdmission||{hostId:chain.enclaveIdOf(endpoint),refusal:async q=>(await answer(q)).refusal,decision:async q=>answer(q)}});
+ h.chainReady=true;h.registered={cpuPricePerSec6:'0'};await h.refreshOwners();quiet(h);
+ await h.walletChannelStart();
+ rpc.row.current=row();rpc.catalog.current=version;rpc.chainTx.mine=true;
+ h.tracked.add(id);h.records.set(id,{id});
+ let launched=0;h.ensureApp=async()=>{launched++;h.records.set(id,{...h.records.get(id),status:'running',isolation:{instance:INSTANCE,appId:'a'.repeat(64)}});return h.records.get(id);};
+ const withdrawn=[];h.servingWithdrawn=i=>withdrawn.push(i);
+ const n=network(agentDir,networkOpts);await n.configure();if(startNetwork){await n.tick();n.start();}
+ return {h,n,dir,agentDir,launched:()=>launched,withdrawn,tx:()=>rpc.chainTx.sent.length};
+}
