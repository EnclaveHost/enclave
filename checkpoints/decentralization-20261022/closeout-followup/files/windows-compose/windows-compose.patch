+test("an expired lease: the keeper never renews or claims it; the pass retires it; quorum failures retry boundedly, never the operator's ETH", { timeout: 30_000 }, async () => {
+  const b = await box({ left: 400 });
+  await b.pass();
+  S.down = true;                                        // the lease-gas quorum never answers again in this window
+  for (let t = 30; t <= 480; t += 30) await keep(b);
+  const tries = renews().length;
+  assert.ok(tries >= 3 && tries <= 6, `bounded retries inside a 285-s window (${tries})`);
+  assert.ok(renews().every((c) => c.start < S.until[A.toLowerCase()] * 1000), "no attempt after the lease expired");
+  S.down = false;                                       // the RPCs answer again, after the lease expired
+  for (let i = 0; i < 3; i++) await keep(b);
+  assert.equal(renews().length, tries, "nothing for an expired lease");
+  await b.pass();
+  assert.equal(b.h.records.get(A).status, "stopped");
+  assert.match(b.h.records.get(A).reason, /the lease expired; a new claim must pass the current funding and hosting policy/);
+  assert.equal(S.calls.filter((c) => c.fn !== "renew").length, 0, "no claim and no release");
+  assert.equal(operatorTx(), 0, "never this host's ETH");
+  assert.ok(b.logs.filter((l) => /renew failed/.test(l)).every((l) => l.includes(QUORUM)), b.logs.join("\n"));
+});
+
+test("the window's lead is read once per lease per 5 minutes, not on every pass", { timeout: 30_000 }, async () => {
+  const b = await box({ left: 840 });
+  for (let t = 0; t <= 540; t += 30) { await b.pass(); skew += 30_000; }   // a fast pass, every 30 s, from 14 min left
+  assert.ok(S.leadCalls <= 2, `${S.leadCalls} verified-authority lead reads (the installed host: one per pass)`);
+  assert.equal(renews().length, 0, "not yet due");
+});
+
+test("a new process renews nothing before its own pass has served the row", { timeout: 30_000 }, async () => {
+  const b = await box({ left: 250 });
+  for (let i = 0; i < 3; i++) await keep(b, 10);
+  assert.equal(renews().length, 0);
+  await b.pass();                                       // its own pass renews (due)
+  assert.equal(renews().length, 1); assert.equal(b.ready(), "ready");
+});
+
+// SERVING FIRST (windows-serving-first): the pass reconciles what this box already serves BEFORE its queued-claim sweep
+// (scanLedger: a claim's gate, send and launch), so a slow sweep cannot delay an existing app's authorization, readiness or
+// keeper eligibility. The sweep is replaced by a gated one; everything else is the real pass.
+const until = async (what, cond, ms = 5000) => { const end = realNow() + ms; while (!cond()) { if (realNow() > end) throw new Error(`timed out: ${what}`); await sleep(5); } };
+const slowSweep = (b, also = async () => {}) => {
+  const g = gate(), st = { started: false, done: false };
+  b.h.scanLedger = async () => { st.started = true; await g.p; await also(); st.done = true; };
+  return Object.assign(st, { open: g.open });
+};
+
+test("SERVING FIRST: a slow queued-claim sweep cannot delay an existing served app's readiness or its keeper renewal", { timeout: 30_000 }, async () => {
+  const b = await box({ left: 400 });
+  const sw = slowSweep(b);
+  const pass = b.pass();
+  await until("the sweep started", () => sw.started);
+  assert.equal(b.h.leaseReadiness().inFlight, true, "the pass is still running (blocked in the sweep)");
+  assert.equal(b.ready(), "ready", "the existing app reads ready while the claim sweep is still blocked");
+  const r = await keep(b, 150);                        // inside the 285-s window now, the sweep still blocked
+  assert.deepEqual(r.renewed, [A], `keeper renewed during the blocked sweep: ${JSON.stringify(r)}`);
+  assert.equal(renews().length, 1); assert.equal(operatorTx(), 0, "never this host's ETH");
+  sw.open(); await pass;
+  assert.ok(sw.done); assert.equal(b.ready(), "ready");
+});
+
+test("SERVING FIRST: what the sweep resumes is reconciled in the same pass; a tracked re-claim waits until after the sweep", { timeout: 30_000 }, async () => {
+  const C = "0x" + "c3".repeat(32);
+  const b = await box({ ids: [A, B, C], left: 400 });
+  setRow(B, { runner: "0x" + "00".repeat(32) });      // B: tracked, but this box no longer holds it (unclaimed): a re-claim
+  b.h.tracked.delete(C);                               // C: a live lease of this box it no longer tracks; the sweep resumes it
+  const order = [];
+  b.h.consider = async (id) => { order.push({ id, afterSweep: sw.done }); return { accepted: false }; };
+  const sw = slowSweep(b, async () => { b.h.tracked.add(C); });
+  const pass = b.pass();
+  await until("the sweep started", () => sw.started);
+  assert.equal(b.ready(A), "ready", "A ready before the sweep finished");
+  assert.deepEqual(order, [], "no re-claim before the sweep (it would delay the apps after it)");
+  sw.open(); await pass;
+  assert.deepEqual(order, [{ id: B, afterSweep: true }], "the deferred re-claim ran once, after the sweep, on a fresh row");
+  assert.equal(b.ready(C), "ready", "the lease the sweep resumed was reconciled in the same pass");
+  assert.notEqual(b.ready(B), "ready");
+});
+
+test("SERVING FIRST: a wallet refusal or unknown, a transfer and a suspension still block while the sweep is slow", { timeout: 60_000 }, async () => {
+  const variants = {
+    "wallet ban": (b) => { b.answer = REFUSE; },
+    "wallet unknown": (b) => { b.answer = UNKNOWN; },
+    "transfer to an owner this box does not serve": () => setRow(A, { owner: "0x" + "99".repeat(20) }),
+    suspended: () => { S.suspended = "suspended by the platform administrator"; },
+  };
+  for (const [name, apply] of Object.entries(variants)) {
+    const b = await box({ left: 400 });
+    apply(b);
+    const sw = slowSweep(b);
+    const pass = b.pass();
+    await until(`${name}: the sweep started`, () => sw.started);
+    assert.notEqual(b.ready(), "ready", `${name}: ready while refused`);
+    await keep(b, 150);
+    assert.equal(renews().length, 0, `${name}: renewed while refused: ${JSON.stringify(renews())}`);
+    sw.open(); await pass;
+    assert.notEqual(b.ready(), "ready", name);
+    for (let i = 0; i < 3; i++) await keep(b);
+    assert.equal(renews().length, 0, name); assert.equal(operatorTx(), 0, name);
+  }
+});
+
+// SERVING-FIRST FIXES (serving-first-fixes): F1 - phase 2 takes what (re)entered tracking after phase 1 by MEMBERSHIP EPOCH,
+// so a lease phase 1 retired and the sweep re-claimed in the SAME pass is reconciled in that pass; F3 - one tracked
+// deployment's throw fails only that deployment (not ready, not keeper-eligible), never the others or the claim sweep.
+test("F1: an own lease retired in phase 1 and re-claimed by the sweep in the same pass is reconciled in phase 2 (ready, keeper-eligible)", { timeout: 30_000 }, async () => {
+  const b = await box({ left: -30 });                   // A's own lease ended 30 s ago: phase 1 retires it (untracked)
+  let untrackedAtSweep = null;
+  const VM2 = "hv" + "9".repeat(32);
+  b.h.scanLedger = async () => {                        // the sweep re-claims it, leaving what a landed consider() leaves
+    untrackedAtSweep = !b.h.tracked.has(A);
+    const until = Math.floor(Date.now() / 1000) + 1800;
+    S.until[A.toLowerCase()] = until; setRow(A, { leaseUntil: BigInt(until) });
+    mgr.vms.push({ id: VM2, name: A, status: "running", appId: "a".repeat(64) });
+    b.h.records.set(A, { id: A, status: "running", appRef: ref, envelope: "", claimedAt: Date.now(), isolation: { instance: VM2, appId: "a".repeat(64) } });
+    b.h.tracked.add(A);
+  };
+  await b.pass();
+  assert.equal(untrackedAtSweep, true, "phase 1 retired the expired lease before the sweep");
+  assert.equal(b.ready(), "ready", "the same-pass re-claim was reconciled in phase 2 (its readiness row published)");
+  const r = await keep(b, 1800 - 250);                  // 250 s left of the new lease: inside its window
+  assert.deepEqual(r.renewed, [A], `keeper-eligible after phase 2: ${JSON.stringify(r)}`);
+  assert.equal(renews().length, 1); assert.equal(operatorTx(), 0);
+});
+
+test("F3: ensureApp throwing for one app fails only that app's pass: the other reads ready, the sweep runs, it is neither ready nor renewed", { timeout: 30_000 }, async () => {
+  const b = await box({ ids: [A, B], left: 400 });
+  let swept = false; b.h.scanLedger = async () => { swept = true; };
+  const ensure = b.h.ensureApp;
+  b.h.ensureApp = async (id, d) => { if (id === A) throw new Error("manager unreachable (test)"); return ensure(id, d); };
+  await b.pass();                                       // must not reject: the throw is contained to A
+  assert.equal(swept, true, "the claim sweep ran after A's failed reconcile");
+  assert.equal(b.ready(B), "ready", "B was reconciled after A's failure");
+  const rowA = b.h.leaseReadiness().deployments.find((x) => x.id === A);
+  assert.equal(rowA.status, "not-ready"); assert.match(rowA.error, /manager unreachable/);
+  assert.ok(b.logs.some((l) => /reconcile failed \(manager unreachable/.test(l)), b.logs.join("\n"));
+  for (let i = 0; i < 6; i++) await keep(b);            // to 220 s left: inside both windows
+  assert.equal(renews(A).length, 0, "the keeper renewed an app whose reconcile failed");
+  assert.equal(renews(B).length, 1, "B renewed by the keeper as usual");
+  assert.equal(operatorTx(), 0);
+});
diff --git a/test/windows-node-wallet-channel-bundle.test.mjs b/test/windows-node-wallet-channel-bundle.test.mjs
new file mode 100644
index 000000000..ade659f41
--- /dev/null
+++ b/test/windows-node-wallet-channel-bundle.test.mjs
@@ -0,0 +1,100 @@
+// The wallet hold channel on the SHIPPED admission bundle: the real Host (windows/node/host.mjs) with the real
+// windows/node/host-admission.bundle.mjs (createHostAdmission on a scripted agreeing reader, as test/host-admission-runtime
+// does) and the real channel writer. The other wallet-hold suites hand the Host a mock admission, so none of them notices a
+// bundle that predates decision(): the channel then stays OFF and an UNKNOWN policy retires the domain as before.
+import {test,after} from 'node:test';
+import assert from 'node:assert/strict';
+import fs from 'node:fs';
+import os from 'node:os';
+import path from 'node:path';
+import http from 'node:http';
+import {fakeBaseRpc,DEPLOYMENTS,CATALOG} from './helpers/fake-base-rpc.mjs';
+process.env.NODE_OPERATOR_KEY='0x'+'7f'.repeat(32);
+delete process.env.ENCLAVE_NETWORK_WALLET_HOLD;
+const rpc=await fakeBaseRpc();
+const chain=await import('../windows/node/chain.mjs');
+chain.addresses.deployments=DEPLOYMENTS;chain.addresses.appCatalog=CATALOG;chain.loadOperator();
+const {Host}=await import('../windows/node/host.mjs');
+const {createHostAdmission}=await import('../windows/node/host-admission.bundle.mjs');
+const {hostAdmissionPolicyHash}=await import('../network/host-admission-policy.mjs');
+const dirs=[];
+const endpoint='https://api.enclave.host/t/wallet-channel-bundle',hostId=chain.enclaveIdOf(endpoint),runner=hostId.toLowerCase();
+const app='0x'+'cd'.repeat(32),id='0x'+'ab'.repeat(32),ref=`catalog://${app}/1`,INSTANCE='hv'+'2'.repeat(32);
+const ownership='0x'+'11'.repeat(20),registry='0x'+'22'.repeat(20),catalog='0x'+'33'.repeat(20),owner='0x'+'44'.repeat(20);
+const version={cid:'bafy',version:'1',vramMb:0,gpuGflops:0,memMb:512,cpuGflops:0,createdAt:1n,verified:true,yanked:false,ports:'',approval:1,config:'{}'};
+
+const mgr={vms:[],removed:[]};
+const srv=http.createServer((q,s)=>{const send=(c,b)=>{s.writeHead(c,{'content-type':'application/json'});s.end(JSON.stringify(b));};
+ const m=q.url.match(/^\/vms(?:\/([^/?]+))?$/);if(!m)return send(404,{error:'no'});
+ const vid=m[1]&&decodeURIComponent(m[1]);
+ if(q.method==='GET'&&!vid)return send(200,{vms:mgr.vms});
+ if(q.method==='GET'){const v=mgr.vms.find(x=>x.id===vid);return v?send(200,v):send(404,{error:'gone'});}
+ if(q.method==='DELETE'){const i=mgr.vms.findIndex(x=>x.id===vid);if(i<0)return send(404,{error:'gone'});mgr.removed.push(vid);mgr.vms.splice(i,1);return send(200,{removed:vid});}
+ send(405,{});});
+await new Promise(r=>srv.listen(0,'127.0.0.1',r));
+const MANAGER=`http://127.0.0.1:${srv.address().port}`;
+after(()=>{rpc.close();srv.close();for(const dir of dirs)fs.rmSync(dir,{recursive:true,force:true});});
+
+// the shipped bundle's admission: this host's wallet policy (no extra restriction) and the platform catalog, both read
+// through a scripted agreeing reader whose snapshots carry block timestamps (authority 40 s old, catalog fresh)
+function admission(){
+ const doc={version:1,chainId:8453,ownershipContract:ownership,hostId,requireCatalogApproval:false,denyDeployments:[],denyAppRefs:[]};
+ const state={catalog:{active:true,approval:1,yanked:false},authorityAge:40_000,authorityAt:[]};
+ const client={readContract:async q=>{
+  if(q.functionName==='registry')return registry;
+  if(q.functionName==='authority')return [owner,owner,1n,hostAdmissionPolicyHash(doc)];
+  if(q.functionName==='getApp')return {appId:app,versionCount:2,...state.catalog};
+  if(q.functionName==='getVersion')return state.catalog;
+  throw Error('unexpected read '+q.functionName);
+ }};
+ const reader={agreed:async fn=>{const value=await fn(client,100n);const timestamp=Date.now()-(value.owner?state.authorityAge:0);
+  if(value.owner)state.authorityAt.push(timestamp);return {timestamp,...value};}};
+ return {state,admission:createHostAdmission({hostId,ownershipContract:ownership,registry,catalog,reader,loadPolicy:async()=>doc,now:()=>Date.now()})};
+}
+const row=()=>({id,owner:chain.operatorAddress(),appRef:ref,ports:'',configCid:'',gpuMilli:0,cpuMilli:100,appPort:8000,isPublic:true,
+ active:true,createdAt:1n,rate:1n,balance6:1000000n,spent6:0n,runner,runnerOperator:chain.operatorAddress(),
+ leaseUntil:BigInt(Math.floor(Date.now()/1000)+3600)});
+async function box(){
+ mgr.removed=[];mgr.vms=[{id:INSTANCE,name:id,status:'running',appId:'b'.repeat(64)}];
+ const dir=fs.mkdtempSync(path.join(os.tmpdir(),'wallet-channel-bundle-'));dirs.push(dir);
+ const agentDir=path.join(dir,'agent');fs.mkdirSync(path.join(agentDir,'state'),{recursive:true});
+ const walletAdmission={file:path.join(agentDir,'wallet-admission.json'),statusFile:path.join(agentDir,'state','status.json')};
+ const a=admission();
+ const h=new Host({dir,endpoint,name:'test',appsEnabled:true,vcpus:8,ramGb:16,cpuPricePerSec6:0,isolationManager:MANAGER,walletAdmission,hostAdmission:a.admission});
+ h.chainReady=true;h.registered={cpuPricePerSec6:'0'};await h.refreshOwners();
+ for(const name of ['followBook','enforceOff','ensureRegistered','ensurePriced','scanLedger','retireForeignRecovered'])h[name]=async()=>{};
+ rpc.row.current=row();rpc.catalog.current=version;rpc.chainTx.mine=true;
+ h.ensureApp=async()=>{h.records.set(id,{...h.records.get(id),status:'running',isolation:{instance:INSTANCE,appId:'b'.repeat(64)}});return h.records.get(id);};
+ const channel=()=>JSON.parse(fs.readFileSync(walletAdmission.file,'utf8'));
+ return {h,a,channel,walletAdmission};
+}
+
+test('the shipped admission bundle has decision(): the channel starts EMPTY and a definite allow carries the original chain deadline',{timeout:30_000},async()=>{
+ const {h,a,channel}=await box();
+ assert.equal(typeof a.admission.decision,'function','the shipped bundle predates decision(): the hold channel would stay OFF');
+ assert.ok(await h.walletChannelStart(),`channel OFF: ${h.walletChannelOff}`);assert.equal(h.walletChannelOff,null);
+ const first=channel();
+ assert.equal(first.runner,runner);assert.deepEqual(first.allows,{},'a fresh generation admits nothing before a fresh allow');
+ h.tracked.add(id);h.records.set(id,{id});
+ await h.tick();
+ const allow=channel().allows[id];
+ assert.ok(allow,'the definite allow is published to the network agent');
+ assert.equal(allow.appRef,ref);
+ // decision(): min(authority snapshot + 90 s, catalog snapshot + 90 s, now + 90 s); the authority snapshot is 40 s old
+ assert.equal(allow.validUntil,a.state.authorityAt[0]+90_000,'the allow lives to the chain snapshot\'s own deadline, not a fresh lifetime');
+ assert.ok(allow.validUntil>Date.now()&&allow.validUntil<=Date.now()+50_000);
+ assert.equal(h.records.get(id).status,'running');
+ assert.equal(await a.admission.refusal({deploymentId:id,appRef:ref}),(await a.admission.decision({deploymentId:id,appRef:ref})).refusal,'refusal() is decision().refusal');
+});
+
+test('platform moderation through the same bundle: an administrator yank refuses the deployment and withdraws its published allow',{timeout:30_000},async()=>{
+ const {h,a,channel}=await box();
+ assert.ok(await h.walletChannelStart());
+ h.tracked.add(id);h.records.set(id,{id});
+ await h.tick();assert.ok(channel().allows[id]);
+ a.state.catalog={...a.state.catalog,yanked:true};
+ assert.ok((await a.admission.decision({deploymentId:id,appRef:ref})).refusal,'the yank is a refusal, not an unknown');
+ await h.tick();
+ assert.equal(channel().allows[id],undefined,'the allow is withdrawn from the network channel');
+ assert.notEqual(h.records.get(id)?.status,'running','not served after the administrator refused it');
+});
diff --git a/test/windows-node-wallet-enroll.test.mjs b/test/windows-node-wallet-enroll.test.mjs
new file mode 100644
index 000000000..372a66b9d
--- /dev/null
+++ b/test/windows-node-wallet-enroll.test.mjs
@@ -0,0 +1,46 @@
+// network-enroll.mjs carries the node's wallet hold channel into the privacy agent's config (enclaveNetwork.walletAdmission)
+// only while the node runs one, and drops it - restarting the agent once each way - when it stops; the agent then reads it.
+import { test } from "node:test";
+import assert from "node:assert/strict";
+import fs from "node:fs";
+import os from "node:os";
+import path from "node:path";
+import { createNetworkEnroll } from "../windows/node/network-enroll.mjs";
+import { rawDigest } from "../network/shield-expectation.mjs";
+
+const RID = "ab".repeat(32), APP = "0x" + "5a".repeat(32), RUNNER = "0x" + "22".repeat(32), D = "0x" + "11".repeat(32);
+const CID = "bafkreibjbefi32gvjrd54lhdizq6zlywym6urcuztzvi455xfv23tyjnza";
+
+function world(walletAdmission) {
+  const dir = fs.mkdtempSync(path.join(os.tmpdir(), "wallet-enroll-")), agentDir = path.join(dir, "agent"), policyFile = path.join(dir, "policy.json");
+  fs.mkdirSync(agentDir); fs.writeFileSync(policyFile, JSON.stringify({ cpu: { runtimeId: RID }, gpu: {} }));
+  const rows = [{ id: D, appRef: `catalog://${APP}/4`, configCid: "{}", runner: RUNNER, active: true, isPublic: true, leaseUntil: 9999999999n }];
+  const vm = { name: D, status: "running", appReady: true, catalog: { app: APP, version: 4 }, cid: CID, appId: "ef".repeat(32), runtimeId: RID,
+               componentSha256: rawDigest(CID), derivation: "enclave-catalog-bundle/1", gpuMilli: 0, startedAt: 1 };
+  let restarts = 0;
+  const make = (wa) => createNetworkEnroll({ agentDir, binDir: path.join(dir, "bin"), runner: RUNNER, relayBase: "https://api.enclave.host",
+    fetch: async () => ({ ok: true, json: async () => ({ domains: {} }) }), log: () => {}, restartAgent: async () => { restarts++; },
+    config: { agentDir, binDir: path.join(dir, "bin"), nodeBinary: "node.exe", operatorKeyFile: "op.key", runner: RUNNER, endpoint: "https://api.enclave.host/t/box",
+      relayBase: "https://api.enclave.host", policyFile, tpmBinary: "tpmattest.exe", tpmSha256: "aa".repeat(32), addressBook: "0x" + "44".repeat(20), chainRpc: ["https://rpc"],
+      enclaveNetwork: { checkers: ["0x" + "57".repeat(20)] }, walletAdmission: wa },
+    rows: async () => rows, version: async () => ({ cid: CID }), vms: async () => [vm] });
+  const read = () => JSON.parse(fs.readFileSync(path.join(agentDir, "privacy-config.json"), "utf8"));
+  return { dir, agentDir, make, read, restarts: () => restarts };
+}
+
+test("the channel is enrolled only while the node runs one: added and dropped with one agent restart each, steady otherwise", async () => {
+  const w = world(null);
+  await w.make(null).pass();
+  assert.equal(w.read().enclaveNetwork.walletAdmission, undefined, "no channel: the agent admits on lease and proof as before");
+  const file = path.join(w.agentDir, "wallet-admission.json");
+  const on = w.make({ file });
+  await on.pass();
+  assert.deepEqual(w.read().enclaveNetwork.walletAdmission, { file }); assert.equal(w.restarts(), 1, "the agent restarts once to enforce it");
+  assert.equal((await on.pass()).changed, false); assert.equal(w.restarts(), 1, "steady: no further restart");
+  await w.make(null).pass();
+  assert.equal(w.read().enclaveNetwork.walletAdmission, undefined, "a node without a channel (rolled back, or OFF) drops it");
+  assert.equal(w.restarts(), 2);
+  await w.make({ file: "relative.json" }).pass();
+  assert.equal(w.read().enclaveNetwork.walletAdmission, undefined, "a relative path is never enrolled");
+  fs.rmSync(w.dir, { recursive: true, force: true });
+});
diff --git a/test/windows-node-wallet-grant-refresh.test.mjs b/test/windows-node-wallet-grant-refresh.test.mjs
new file mode 100644
index 000000000..4d80e7487
--- /dev/null
+++ b/test/windows-node-wallet-grant-refresh.test.mjs
@@ -0,0 +1,295 @@
+// Wallet GRANT REFRESH between slow passes (windows/node/host.mjs walletRefresh), end to end on one box, on the same harness as
+// test/windows-node-wallet-network-hold.test.mjs: the REAL Host with chain.mjs on a fake Base RPC, writing its wallet channel
+// that the REAL PrivacyAgent reads. The host admission answer is a stand-in decision() whose deadline is now + 80 s (the
+// production runtime caps it at the chain snapshot + 90 s). Time moves with `skew`; the 10-s heartbeat and refresh timers are
+// driven explicitly. 2026-10-22 minipc outage: a pass took ~7 min, so the adapter was admitted ~73 s of every 7 minutes.
+import {test,after} from 'node:test';
+import assert from 'node:assert/strict';
+import fs from 'node:fs';
+import os from 'node:os';
+import path from 'node:path';
+import http from 'node:http';
+import net from 'node:net';
+import {once} from 'node:events';
+import {fakeBaseRpc,DEPLOYMENTS,CATALOG} from './helpers/fake-base-rpc.mjs';
+process.env.NODE_OPERATOR_KEY='0x'+'7f'.repeat(32);
+delete process.env.ENCLAVE_NETWORK_WALLET_HOLD;
+const rpc=await fakeBaseRpc();
+const chain=await import('../windows/node/chain.mjs');
+chain.addresses.deployments=DEPLOYMENTS;chain.addresses.appCatalog=CATALOG;chain.loadOperator();
+const {Host}=await import('../windows/node/host.mjs');
+const {PrivacyAgent}=await import('../network/privacy-agent.mjs');
+const {WalletAllowFile}=await import('../network/wallet-admission.mjs');
+const {defaultNetworkPolicy}=await import('../network/network-policy-core.mjs');
+const {HostEgress}=await import('../network/host-egress.mjs');
+const dirs=[];
+const id='0x'+'ab'.repeat(32),ref='catalog://0x'+'cd'.repeat(32)+'/1',endpoint='https://api.enclave.host/t/wallet-hold-test';
+const runner=chain.enclaveIdOf(endpoint).toLowerCase(),INSTANCE='hv'+'1'.repeat(32);
