+ // injected at the atomic replace itself (fs.renameSync of the channel file), not above the writer: the writer's
+ // COMMIT_RETRY is the only retry layer (7d D1 v2), so the host path pays at most its budget, never a multiple of it
+ const realRename=fs.renameSync;
+ const refuse=(file,n)=>{let left=n;fs.renameSync=(a,b)=>{if(b===file&&left-->0)throw Object.assign(Error('EPERM: operation not permitted, rename'),{code:'EPERM'});return realRename(a,b);};};
