+ *  blocks are then kept as they are. */
+export async function readHostServicesFile(file) {
+  if (!file) return { error: null };
+  if (!path.isAbsolute(file)) return { error: `ENCLAVE_HOST_SERVICES_FILE must be an absolute path (${file})` };
