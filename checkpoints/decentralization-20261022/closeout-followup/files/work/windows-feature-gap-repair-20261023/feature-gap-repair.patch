--- a/test/registry-reconcile.test.mjs
+++ b/test/registry-reconcile.test.mjs
@@ -44,10 +44,71 @@ test("both platforms load the same rule; the supervisor image and the Windows de
   const sup = fs.readFileSync(path.join(REPO, "supervisor.js"), "utf8"), win = fs.readFileSync(path.join(REPO, "windows/node/host.mjs"), "utf8");
