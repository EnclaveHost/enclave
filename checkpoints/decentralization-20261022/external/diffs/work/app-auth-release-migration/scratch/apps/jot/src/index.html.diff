+    ssoStart(false);
+    return;
+  }
+  const signer = pickSigner(how);
+  if (!signer) { $("#ssoerr").textContent = "No browser wallet was found on this page: link another signer instead."; return; }
+  try {
+    const address = await signer.address();
+    if (!/^0x[0-9a-fA-F]{40}$/.test(String(address || ""))) throw new Error("the wallet returned no account");
+    const nonce = Array.from(crypto.getRandomValues(new Uint8Array(16)), (x) => x.toString(16).padStart(2, "0")).join("");
+    const d = await api("POST", "/api/link/challenge", given ? { address, nonce, account: given } : { address, nonce });
+    const acct = given ? d.account : c.sub;
+    const lines = d.message.split("\n");
+    if (lines[0] !== location.host + " wants you to sign in with your Ethereum account:" ||
+        lines[1].toLowerCase() !== String(address).toLowerCase() || !d.message.includes("\nNonce: " + nonce) ||
+        !d.message.includes("\n- urn:enclave:link:account:" + acct + "\n") ||
+        !lines[3].startsWith("Link the Enclave account " + acct + " to this wallet"))
+      throw new Error("the link message does not name this site, your address and this account");
+    const bytes = new TextEncoder().encode(d.message);
+    const sig = await signer.sign(bytes, address, d.message);
+    if (typeof sig !== "string" || !SIG_RE.test(sig)) throw new Error("the wallet returned no signature");
+    const b64u = (b) => btoa(String.fromCharCode(...b)).replace(/\+/g, "-").replace(/\//g, "_").replace(/=+$/, "");
+    const wtok = "EWS1." + b64u(bytes) + "." + b64u(Uint8Array.from(sig.slice(2).match(/../g), (x) => parseInt(x, 16)));
