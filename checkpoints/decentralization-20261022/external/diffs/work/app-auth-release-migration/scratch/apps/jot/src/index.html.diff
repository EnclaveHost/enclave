+// The hand-signed path's two steps, in the #handsign panel of the sign-in card. A Cancel rejects like a wallet's refusal.
+let hsWait = null;
+function hsAsk(step) {
+  return new Promise((resolve, reject) => {
+    hsWait = { resolve, reject };
+    $("#handsign").hidden = false;
+    $("#hs-addr-step").hidden = step !== "addr";
+    $("#hs-sig-step").hidden = step !== "sig";
+    $(step === "addr" ? "#hs-addr" : "#hs-sig").focus();
+  });
+}
+function hsSettle(value, err) {
+  const w = hsWait; hsWait = null;
+  if (err || value === undefined) $("#handsign").hidden = true;
+  if (w) err ? w.reject(err) : w.resolve(value);
+}
+function handSigner() {
+  return {
+    address: async () => { $("#hs-addr").value = ""; return hsAsk("addr"); },
+    sign: async (_bytes, _address, text) => {
+      $("#hs-msg").value = text; $("#hs-sig").value = "";
+      try { return await hsAsk("sig"); } finally { $("#handsign").hidden = true; }
+    },
+  };
+}
