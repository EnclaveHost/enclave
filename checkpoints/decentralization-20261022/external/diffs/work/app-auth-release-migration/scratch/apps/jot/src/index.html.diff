+  const signer = pickSigner(how);
+  if (!signer) { $("#ssoerr").textContent = "No browser wallet was found on this page: use Another signer instead."; return; }
+  try {
+    const address = await signer.address();
+    if (!/^0x[0-9a-fA-F]{40}$/.test(String(address || ""))) throw new Error("the wallet returned no account");
+    const nonce = Array.from(crypto.getRandomValues(new Uint8Array(16)), (x) => x.toString(16).padStart(2, "0")).join("");
+    const d = await api("GET", "/api/auth/wallet/challenge?address=" + address + "&nonce=" + nonce);
+    const lines = d.message.split("\n");
+    if (lines[0] !== location.host + " wants you to sign in with your Ethereum account:" ||
+        lines[1].toLowerCase() !== address.toLowerCase() || !d.message.includes("\nNonce: " + nonce) ||
+        !d.message.endsWith("\n- urn:enclave:deployment:" + status.wallet.aud.toLowerCase()))
+      throw new Error("the sign-in message does not name this site, your address and this notebook");
+    const bytes = new TextEncoder().encode(d.message);
+    const sig = await signer.sign(bytes, address, d.message);
+    if (typeof sig !== "string" || !SIG_RE.test(sig)) throw new Error("the wallet returned no signature");
+    const b64u = (b) => btoa(String.fromCharCode(...b)).replace(/\+/g, "-").replace(/\//g, "_").replace(/=+$/, "");
+    ssoToken = "EWS1." + b64u(bytes) + "." + b64u(Uint8Array.from(sig.slice(2).match(/../g), (x) => parseInt(x, 16)));
+    try { sessionStorage.setItem(SSO_KEY, ssoToken); localStorage.setItem(SSO_KEY, ssoToken); } catch (e) {}
+    await loadStatus(); await refresh(); fresh();
+  } catch (e) { $("#ssoerr").textContent = e && e.code === 4001 ? "Sign-in cancelled in the wallet." : "Wallet sign-in failed: " + ((e && e.message) || e); }
+}
+
+// Linking (link.rs on the server): while signed in with Enclave, make a
+// wallet you hold the way into THIS account's notebook, once and for good.
+// The server wants a sign-in from the last ten minutes and a wallet signature
+// naming this account, that sign-in and this notebook; it refuses a wallet
+// already linked or one with notes of its own, and never relinks.
+// given: an EAB1 migration file (the account proof), instead of a fresh Enclave sign-in
+async function linkStart(how, given) {
