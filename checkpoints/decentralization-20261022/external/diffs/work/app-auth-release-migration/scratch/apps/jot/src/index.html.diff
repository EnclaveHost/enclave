+// Direct wallet sign-in, when the config has a `wallet` block: the visitor's
+// own wallet signs the EIP-4361 message this notebook composed for this host
+// and deployment (GET /api/auth/wallet/challenge), checked inside the enclave
+// (wallet.rs). It rides X-Sso-Token like an Enclave token and opens the
+// notebook of `wallet_0x…` - never the notebook of an Enclave account.
+// Who signs: the page's own browser wallet (EIP-1193), or - how === "hand" - the person, by hand (handSigner below):
+// the page shows the exact message and takes back the signature. Nothing pasted is trusted beyond its shape; the
+// enclave verifies it like any signature (an EOA offline, a contract account through the owner's pinned readers).
+// 65 bytes from an ordinary wallet, up to the server's 6144 from a contract account (an EIP-6492 wrapper included).
+const SIG_RE = /^0x(?:[0-9a-fA-F]{2}){65,6144}$/;
+function pickSigner(how) {
+  if (how === "hand") return handSigner();
+  const eth = window.ethereum;
+  if (!eth || typeof eth.request !== "function") return null;
+  return {
+    address: async () => { const a = await eth.request({ method: "eth_requestAccounts" }); return String((a && a[0]) || ""); },
+    sign: async (bytes, address) => eth.request({ method: "personal_sign", params: ["0x" + Array.from(bytes, (x) => x.toString(16).padStart(2, "0")).join(""), address] }),
+  };
+}
+async function walletStart(how) {
