+/// One JSON-RPC POST to a chain reader the owner pinned in
+/// `wallet.contract_wallets` (EIP-1271 contract wallets, wallet.rs): bounded,
+/// no redirect followed, only the public signature data in the body.
+fn rpc_post(url: &str, body: &[u8], timeout_s: u64, max_bytes: usize) -> Result<Vec<u8>, String> {
+    let (https, rest) = match (url.strip_prefix("https://"), url.strip_prefix("http://")) {
+        (Some(r), _) => (true, r),
+        (None, Some(r)) => (false, r),
+        _ => return Err("reader URL is not http(s)".into()),
+    };
+    let (authority, path) = match rest.find('/') {
+        Some(i) => (&rest[..i], &rest[i..]),
+        None => (rest, "/"),
+    };
+    let headers = vec![("content-type".to_string(), "application/json".to_string())];
+    let r = http::request(&http::HttpReq {
+        method: bindings::wasi::http::types::Method::Post,
+        https,
+        authority,
+        path_with_query: path,
+        headers: &headers,
+        body,
+        timeout_s,
+        max_bytes,
+    })?;
+    if r.status != 200 {
+        return Err(format!("reader answered HTTP {}", r.status));
+    }
+    Ok(r.body)
+}
+
+/// wallet.rs's check for one act; the chain readers are attached only when
+/// the owner pinned them, so an EOA never touches the network.
+fn wallet_verify(w: &wallet::WalletConfig, tok: &str, now: u64, act: wallet::Act) -> Result<wallet::Claims, String> {
+    if w.contract.is_some() {
+        let mut readers = wallet::HttpReaders(rpc_post);
+        wallet::verify_act(w, tok, now, act, Some(&mut readers))
+    } else {
+        wallet::verify_act(w, tok, now, act, None)
+    }
+}
+
+/// How recent the Enclave sign-in proving an ACCOUNT for a link must be.
+const LINK_FRESH_SECS: u64 = 600;
+
+/// The ACCOUNT side of a link: a Sign in with Enclave token minted for THIS
+/// notebook's own deployment (not one it merely accepts) in the last ten
+/// minutes, naming an account. Returns (account, the token as presented).
+fn account_proof(cfg: &Config, req: &IncomingRequest, now: u64) -> Result<(String, String), (u16, String)> {
+    account_proof_of(cfg, header(req, "x-sso-token").map(|t| t.trim().to_string()), now)
+}
+
+fn account_proof_of(cfg: &Config, tok: Option<String>, now: u64) -> Result<(String, String), (u16, String)> {
+    let (Some(s), Some(w)) = (&cfg.sso, &cfg.wallet) else {
+        return Err((404, "this notebook does not offer account links: it needs both an sso and a wallet block".into()));
+    };
+    let tok = tok.filter(|t| t.starts_with("EST1."))
+        .ok_or((401, "[sso_required] sign in with Enclave (X-Sso-Token) to prove the account you are linking".to_string()))?;
+    let c = sso::verify(s, &tok, now).map_err(|e| (401, format!("[sso_required] {e}")))?;
+    if !c.aud.eq_ignore_ascii_case(&s.audience) || !c.aud.eq_ignore_ascii_case(&w.audience) {
+        return Err((401, "that Enclave sign-in was made for another deployment; sign in to this notebook itself".into()));
+    }
+    if c.iat.saturating_add(LINK_FRESH_SECS) < now {
+        return Err((401, "linking needs a fresh Enclave sign-in (the last 10 minutes): sign in again, then link".into()));
+    }
+    if !wallet::is_account_sub(&c.sub) {
+        return Err((401, "that sign-in names no Enclave account".into()));
+    }
+    Ok((c.sub, tok))
+}
+
+/// The ACCOUNT side of a link, from the request: an EAB1 migration file in the body's `account` (eab1.rs), checked
+/// against the snapshot this notebook's owner pinned - no issuer - and, with `wallet`, that this wallet is one the
+/// account committed at cutover; otherwise a fresh Enclave sign-in in X-Sso-Token. Returns (account, the proof as
+/// presented), the proof the wallet's link signature must name.
+fn link_account(cfg: &Config, req: &IncomingRequest, b: &serde_json::Value, now: u64, wallet: Option<&str>) -> Result<(String, String), (u16, String)> {
+    let cred = b.get("account").and_then(|v| v.as_str()).unwrap_or("").trim().to_string();
+    if !cred.starts_with(eab1::PREFIX) {
+        return account_proof(cfg, req, now);
+    }
+    let (Some(pin), Some(_)) = (&cfg.migration, &cfg.wallet) else {
+        return Err((404, "this notebook honours no account migration snapshot (its config pins no `migration`)".into()));
+    };
+    let account = match wallet {
+        Some(w) => eab1::account_for(pin, &cred, w),
+        None => eab1::open(pin, &cred).map(|x| x.account),
+    }
+    .map_err(|e| (401, e))?;
+    Ok((account, cred))
+}
