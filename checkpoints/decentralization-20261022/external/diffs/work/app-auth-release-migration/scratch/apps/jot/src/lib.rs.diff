+/// The bucket, as link.rs needs it.
+struct BucketLinks<'a> {
+    ep: s3::Endpoint,
+    cfg: &'a Config,
+}
+
+impl<'a> BucketLinks<'a> {
+    fn open(cfg: &'a Config) -> Result<BucketLinks<'a>, (u16, String)> {
+        if !cfg.missing.is_empty() || cfg.error.is_some() {
+            return Err((503, "this notebook is not configured".into()));
+        }
+        Ok(BucketLinks { ep: s3::Endpoint::parse(&cfg.endpoint, &cfg.region).map_err(|e| (503, e))?, cfg })
+    }
+    fn client(&self) -> s3::Client<'_> {
+        s3::Client { ep: &self.ep, bucket: &self.cfg.bucket, creds: self.cfg.creds.as_ref() }
+    }
+}
+
+impl link::LinkStore for BucketLinks<'_> {
+    fn get(&self, key: &str) -> Result<Option<(Vec<u8>, String)>, String> {
+        Ok(self.client().get(key).map_err(|e| e.message())?.map(|f| (f.body, f.etag)))
+    }
+    fn create(&self, key: &str, body: &[u8]) -> Result<Option<String>, String> {
+        self.client().create(key, body, "application/json").map_err(|e| e.message())
+    }
+    fn replace_if(&self, key: &str, body: &[u8], etag: &str) -> Result<bool, String> {
+        match self.client().put(key, body, "application/json", Some(etag)) {
+            Ok(_) => Ok(true),
+            Err(s3::S3Error::Http(412, _)) => Ok(false),
+            Err(e) => Err(e.message()),
+        }
+    }
+    fn any_under(&self, prefix: &str) -> Result<bool, String> {
+        Ok(!self.client().list(prefix, 1).map_err(|e| e.message())?.0.is_empty())
+    }
+}
