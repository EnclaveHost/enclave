+  fs.mkdirSync(path.join(DIST, "profiles"), { recursive: true });
+  fs.writeFileSync(path.join(DIST, "profiles", D.profileDigest.slice(7) + ".json"), D.profileText);
+  fs.writeFileSync(path.join(DIST, "profiles", D.authorityDigest.slice(7) + ".json"), D.authorityText);
