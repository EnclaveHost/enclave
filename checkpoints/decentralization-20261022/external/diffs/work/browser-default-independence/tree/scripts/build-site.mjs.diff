+const gitOut = (args) => execFileSync("git", args, { cwd: ROOT, stdio: ["ignore", "pipe", "ignore"] }).toString().trim();
+// a source tree without git (an isolated candidate, an unpacked release) stamps "nogit" instead of failing the build
+const gitOr = (args, fallback) => { try { return gitOut(args); } catch { return fallback; } };
+const BUILD_STAMP = gitOr(["rev-parse", "--short=8", "HEAD"], "nogit")   // fixed width: bare --short wobbles 7/8 as the repo grows
+  + (gitOr(["status", "--porcelain"], "") ? "*" : "")
   + " · " + new Date().toISOString().slice(0, 10);
 
+/* --default-profile <module>: ship the reviewed independent default (js/gen/default-profile.js is null in source, so a
+   build without it keeps the hosted default byte for byte). The module comes from scripts/network/default-profile.mjs
+   module; a non-provisional one must carry a publishable gate report, and every digest in it is re-checked here exactly
+   as the page checks it at load. --provisional-ok is required to bake a provisional (loopback-only test) profile. */
+const argv = process.argv.slice(2);
+const argOf = (k) => { const i = argv.indexOf(k); return i >= 0 ? argv[i + 1] : null; };
+const DEFAULT_PROFILE_MODULE = argOf("--default-profile");
+let defaultProfileSource = null;
+if (DEFAULT_PROFILE_MODULE){
+  defaultProfileSource = fs.readFileSync(path.resolve(DEFAULT_PROFILE_MODULE), "utf8");
+  const { DEFAULT_PROFILE } = await import("data:text/javascript;base64," + Buffer.from(defaultProfileSource).toString("base64"));
+  const { checkPackagedDefault } = await import(new URL("../site/js/core/independent.js", import.meta.url));
+  const checked = checkPackagedDefault(DEFAULT_PROFILE, { loopback: true });
+  if (checked.provisional && !argv.includes("--provisional-ok")) throw new Error("the default profile module is PROVISIONAL (a loopback-only test profile): pass --provisional-ok to build it, never for a release");
+  if (!checked.provisional && !DEFAULT_PROFILE.gateDigest) throw new Error("a non-provisional default profile module must carry its gate report digest");
+  console.log("[build] default profile " + checked.profileDigest + " (authority " + checked.authorityDigest + (checked.provisional ? ", PROVISIONAL" : "") + ")");
+}
+const defaultProfilePlugin = {
+  name: "default-profile",
+  setup(b) {
+    if (!defaultProfileSource) return;
+    b.onLoad({ filter: /[\\/]js[\\/]gen[\\/]default-profile\.js$/ }, () => ({ contents: defaultProfileSource, loader: "js" }));
+  },
+};
+
