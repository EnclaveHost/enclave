+        /// <summary>One command line that CommandLineToArgvW / the CRT split back into exactly these arguments (a path with
+        /// spaces or quotes stays one argument across the relaunch).</summary>
+        internal static string QuoteArgs(string[] args)
+        {
+            var b = new StringBuilder();
+            foreach (var a in args)
+            {
+                if (b.Length > 0) b.Append(' ');
+                if (a.Length > 0 && a.IndexOfAny(new[] { ' ', '\t', '"' }) < 0) { b.Append(a); continue; }
+                b.Append('"');
+                for (int i = 0; i < a.Length; i++)
+                {
+                    int n = 0; while (i < a.Length && a[i] == '\\') { n++; i++; }
+                    if (i == a.Length) { b.Append('\\', n * 2); break; }
+                    if (a[i] == '"') b.Append('\\', n * 2 + 1).Append('"'); else b.Append('\\', n).Append(a[i]);
+                }
+                b.Append('"');
+            }
+            return b.ToString();
+        }
