+            assert_eq!(up.asked.get(), 1);
+            assert!(r.refreshing.borrow().is_empty());
+            // and with every waiter gone, the refresh still fills the cache
+            seed(&r, &name, OLD, Sec::Insecure, 30, 31_000);
+            advance(FWD_MEMO_MS + 100);
+            let _ = net::select2(ask(&r, &name), net::sleep(Duration::from_millis(100))).await;
+            settle(&r).await;
+            let (a, _) = ask(&r, &name).await;
+            assert_eq!((a.source, ips(&a)), ("cache", vec![IpAddr::from(NEW)]));
+            assert_eq!(up.asked.get(), 2);
+            up.stop.set(true);
+        });
+    }
+}
