+/// One background re-resolution of (name, type), shared by every query
+/// waiting on it. Dropping a waiter (a timeout, a closed connection) never
+/// stops it: it runs to its own deadline and refreshes the cache.
+#[derive(Default)]
+struct Refresh {
+    done: RefCell<Option<Answer>>,
+    wakers: RefCell<Vec<Waker>>,
+}
+
+struct RefreshDone(Rc<Refresh>);
+
+impl Future for RefreshDone {
+    type Output = Answer;
+    fn poll(self: Pin<&mut Self>, cx: &mut Context<'_>) -> Poll<Answer> {
+        if let Some(a) = self.0.done.borrow().as_ref() {
+            return Poll::Ready(a.clone());
+        }
+        let mut w = self.0.wakers.borrow_mut();
+        if !w.iter().any(|x| x.will_wake(cx.waker())) {
+            w.push(cx.waker().clone());
+        }
+        Poll::Pending
+    }
+}
