+    // ---- ?format=car of a CID outside the index (EnclaveDNS upload 502, 2026-10-21) ----------------------------
+
+    /// One request through the real engine and router, as main() serves it (poll -> route -> pump/flush), on a
+    /// loopback port of its own; `connection: close`, so the answer ends at EOF. -> (status, lowercased headers, body)
+    fn http_once(app: &mut App, method: &str, target: &str, accept: Option<&str>) -> (u16, Vec<(String, String)>, Vec<u8>) {
+        use std::io::{ErrorKind, Read, Write};
+        let port = std::net::TcpListener::bind("127.0.0.1:0").unwrap().local_addr().unwrap().port();
+        let mut srv = Server::bind("car404-test", port);
+        let mut c = std::net::TcpStream::connect(("127.0.0.1", port)).unwrap();
+        let accept = accept.map(|a| format!("accept: {a}\r\n")).unwrap_or_default();
+        c.write_all(format!("{method} {target} HTTP/1.1\r\nhost: t\r\n{accept}connection: close\r\n\r\n").as_bytes()).unwrap();
+        c.set_nonblocking(true).unwrap();
+        let (mut got, mut buf, deadline) = (Vec::new(), [0u8; 65536], Instant::now() + Duration::from_secs(30));
+        // the client drains everything the socket holds on each pass
+        'serve: loop {
+            for (key, req) in srv.poll(MAX_BODY, &[], &[]) {
+                route(app, &mut srv, key, &req);
+            }
+            srv.pump();
+            srv.flush();
+            loop {
+                match c.read(&mut buf) {
+                    Ok(0) => break 'serve,
+                    Ok(n) => got.extend_from_slice(&buf[..n]),
+                    Err(e) if e.kind() == ErrorKind::WouldBlock => break,
+                    Err(e) => panic!("{method} {target}: {e}"),
+                }
+            }
+            assert!(Instant::now() < deadline, "{method} {target}: no complete answer ({} bytes)", got.len());
+            std::thread::sleep(Duration::from_millis(1));
+        }
+        let end = got.windows(4).position(|w| w == b"\r\n\r\n").unwrap_or_else(|| panic!("{method} {target}: no header block in {} bytes", got.len()));
+        let head = String::from_utf8_lossy(&got[..end]).to_string();
+        let mut lines = head.split("\r\n");
+        let status: u16 = lines.next().unwrap().split(' ').nth(1).unwrap().parse().unwrap();
+        let headers: Vec<(String, String)> = lines
+            .filter_map(|l| l.split_once(':').map(|(k, v)| (k.trim().to_ascii_lowercase(), v.trim().to_string())))
+            .collect();
+        let mut body = got[end + 4..].to_vec();
+        // a HEAD answer has no body, whatever its transfer-encoding says
+        if method != "HEAD" && headers.iter().any(|(k, v)| k == "transfer-encoding" && v == "chunked") {
+            let (mut out, mut i) = (Vec::new(), 0);
+            loop {
+                let nl = i + body[i..].windows(2).position(|w| w == b"\r\n")
+                    .unwrap_or_else(|| panic!("{method} {target}: chunked body cut at byte {i} of {}", body.len()));
+                let n = usize::from_str_radix(std::str::from_utf8(&body[i..nl]).unwrap().trim(), 16).unwrap();
+                if n == 0 {
+                    break;
+                }
+                out.extend_from_slice(&body[nl + 2..nl + 2 + n]);
+                i = nl + 2 + n + 2;
+            }
+            body = out;
+        }
+        (status, headers, body)
+    }
+
+    fn header<'a>(h: &'a [(String, String)], name: &str) -> Option<&'a str> {
+        h.iter().find(|(k, _)| k == name).map(|(_, v)| v.as_str())
+    }
+
+    #[test]
+    fn a_car_of_a_cid_outside_the_index_is_the_raw_404_for_head_and_get() {
+        let (_bucket, ep) = sample_bucket();
+        let mut app = boot(&ep);
+        run_until_ready(&mut app);
+        let absent = [
+            Cid { codec: CODEC_DAG_PB, digest: [0x5a; 32] },
+            Cid::raw([0x5b; 32]),
+            Cid::parse("bafybeic3peeqxip4w2sxz66krxbhkjygfnkqyigdgvoajw6moykvtkfeau").unwrap(), // the 2026-10-21 one
+        ];
+        for cid in absent {
+            assert!(!car_root_indexed(&app.snap, &cid), "{cid}");
+            let (raw_status, _, raw_body) = http_once(&mut app, "GET", &format!("/ipfs/{cid}?format=raw"), None);
+            assert_eq!(raw_status, 404, "{cid}: the raw answer this must match");
+            for (target, accept) in [(format!("/ipfs/{cid}?format=car"), None), (format!("/ipfs/{cid}"), Some("application/vnd.ipld.car"))] {
+                for method in ["HEAD", "GET"] {
+                    let (status, h, body) = http_once(&mut app, method, &target, accept);
+                    assert_eq!(status, 404, "{method} {target} {accept:?}: a CID outside the index is not a 200 CAR");
+                    assert_eq!(header(&h, "content-type"), Some("application/json"), "{method} {target}");
+                    assert!(header(&h, "content-disposition").is_none(), "{method} {target}: no CAR attachment");
+                    if method == "GET" {
+                        assert_eq!(body, raw_body, "{target}: the same not_indexed answer ?format=raw gives");
+                    }
+                }
+            }
+        }
+    }
+
+    #[test]
+    fn a_car_of_an_indexed_cid_is_unchanged() {
+        let (_bucket, ep) = sample_bucket();
+        let mut app = boot(&ep);
+        run_until_ready(&mut app);
+        let file = |k: &str| app.snap.files.iter().find(|f| f.key == k).unwrap().root;
+        let big = file("pins/bafkbig");        // a multi-chunk file: a dag-pb root
+        let small = file("pins/bafksmall");    // one chunk: a raw root
+        let leaf = Cid::raw(*app.snap.leaf_of.keys().next().unwrap());
+        let dir = app.snap.root.expect("the bucket's root directory");
+        assert_eq!((big.codec, small.codec, dir.codec), (CODEC_DAG_PB, CODEC_RAW, CODEC_DAG_PB));
+        for cid in [big, small, leaf, dir] {
+            assert!(car_root_indexed(&app.snap, &cid), "{cid}");
+            // what the route streamed before this change: CarBody's own bytes
+            let mut want = Vec::new();
+            let mut src = CarBody::new(app.snap.clone(), app.s3.clone().unwrap(), cid);
+            while let Some(part) = src.pull().unwrap() {
+                want.extend(part);
+            }
+            assert!(want.starts_with(&ipfs::car_header(&cid)));
+            let (status, h, body) = http_once(&mut app, "GET", &format!("/ipfs/{cid}?format=car"), None);
+            assert_eq!(status, 200, "{cid}");
+            assert_eq!(header(&h, "content-type"), Some("application/vnd.ipld.car; version=1"));
+            assert_eq!(header(&h, "content-disposition"), Some(format!("attachment; filename=\"{cid}.car\"").as_str()));
+            assert_eq!(body, want, "{cid}: the CAR bytes are unchanged");
+            let (status, h, body) = http_once(&mut app, "HEAD", &format!("/ipfs/{cid}"), Some("application/vnd.ipld.car"));
+            assert_eq!((status, header(&h, "content-type")), (200, Some("application/vnd.ipld.car; version=1")), "{cid}");
+            assert!(body.is_empty(), "{cid}: HEAD has no body");
+        }
+    }
