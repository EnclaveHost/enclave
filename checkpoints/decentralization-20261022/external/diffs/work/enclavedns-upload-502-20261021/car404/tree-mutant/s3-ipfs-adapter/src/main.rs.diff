+/// Whether a CAR can start at `cid`: the lookup CarBody's first pull makes (a dag-pb node in `nodes`, anything else a
+/// leaf in `leaf_of`), which is also the one serve_raw answers its 404 from.
+fn car_root_indexed(snap: &Snapshot, cid: &Cid) -> bool {
+    if cid.codec == CODEC_DAG_PB {
+        snap.nodes.contains_key(&cid.digest)
+    } else {
+        snap.leaf_of.contains_key(&cid.digest)
+    }
+}
