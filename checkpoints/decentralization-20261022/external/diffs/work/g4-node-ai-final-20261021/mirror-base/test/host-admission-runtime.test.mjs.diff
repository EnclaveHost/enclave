+test('decision lifetime is bounded by BOTH original agreeing snapshots; cached authority is never renewed locally',async()=>{
+ const {state,admission}=setup();state.authorityAge=40000;
+ const first=await admission.decision(request);assert.equal(first.refusal,null);assert.equal(first.validUntil,1050000);
+ state.now+=10000;state.authorityAge=0;
+ assert.equal((await admission.decision(request)).validUntil,first.validUntil,'cache reuse cannot extend authority');
+ state.now+=10000;state.catalogAge=80000;
+ const next=await admission.decision(request);assert.equal(next.validUntil,state.now+10000,'catalog deadline is also binding');
+ state.catalog.yanked=true;assert.ok((await admission.decision(request)).refusal,'administrator yank remains effective');
+});
+test('decision refuses stale or future catalog data and never adds a fresh grace period',async()=>{
+ for(const age of [90000,100000,-5001]){
+  const {state,admission}=setup();state.catalogAge=age;
+  await assert.rejects(admission.decision(request),/catalog snapshot expired/);
+ }
+ const {state,admission}=setup();state.authorityAge=89999;
+ assert.equal((await admission.decision(request)).validUntil,state.now+1);
+});
