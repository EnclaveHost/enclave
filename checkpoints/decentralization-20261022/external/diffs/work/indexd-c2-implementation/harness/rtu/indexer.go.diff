+// StoreSpec names a persistent database on a PostgreSQL server (HARNESS ADDITION).
+type StoreSpec struct {
+	CI       postgres.ConnectionInfo
+	Database string
+}
+
+// WithStore makes the indexer use (and keep) the named database (HARNESS ADDITION).
+func WithStore(spec StoreSpec) IndexerOpt {
+	return func(cfg *indexerCfg) { cfg.store = &spec }
+}
+
+// WithWalletKey fixes the indexer's wallet key (HARNESS ADDITION).
+func WithWalletKey(k types.PrivateKey) IndexerOpt {
+	return func(cfg *indexerCfg) { cfg.walletKey = &k }
+}
+
+// WithListen fixes the application and admin API listen addresses (HARNESS ADDITION; loopback).
+func WithListen(appAddr, adminAddr string) IndexerOpt {
+	return func(cfg *indexerCfg) { cfg.appListen, cfg.adminListen = appAddr, adminAddr }
+}
+
+// WithGeoIPDir sets the directory holding indexd's geoip database (HARNESS ADDITION).
+func WithGeoIPDir(dir string) IndexerOpt {
+	return func(cfg *indexerCfg) { cfg.geoipDir = dir }
+}
