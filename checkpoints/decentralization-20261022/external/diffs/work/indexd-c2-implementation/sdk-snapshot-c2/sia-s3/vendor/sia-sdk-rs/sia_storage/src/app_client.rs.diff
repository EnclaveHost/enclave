+        // next mutation or check replays it
+        self.c2_set(crate::fence::C2State::Pending { head, op: op.clone() });
+        let r = self.c2_send(app_key, &op, head).await;
+        let outcome = match &r {
+            Ok(seq) => C2Outcome::Applied(*seq),
+            Err(e) => c2_classify(e),
+        };
