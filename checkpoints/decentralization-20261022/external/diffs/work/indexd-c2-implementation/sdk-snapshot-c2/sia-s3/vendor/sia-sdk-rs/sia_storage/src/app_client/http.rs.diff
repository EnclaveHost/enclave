+    /// PATCH (writer fencing): a 409 whose JSON body names a fence is a fenced refusal: recorded (the first one) and
+    /// returned as `Error::Fenced`.
+    fn note_refusal(&self, e: Error) -> Error {
+        if let Error::Api(status, body) = &e {
+            // PATCH C2 (G-C2 v4.0 section 4): C2 refusals are 412 {"conflict": "seq"|"op"|"mode"}; 409 stays the fence
+            if *status == StatusCode::PRECONDITION_FAILED {
+                return match parse_conflict(body) {
+                    Some((kind, seq)) if kind == "seq" => Error::SeqConflict(seq),
+                    Some((kind, seq)) if kind == "op" => Error::OpConflict(seq),
+                    Some((kind, _)) if kind == "mode" => Error::ModeConflict,
+                    _ => e,
+                };
+            }
+            if *status == StatusCode::CONFLICT {
+                if let Some(current) = parse_refusal(body) {
+                    let mut st = self.fence.lock().unwrap();
+                    if st.conflict.is_none() {
+                        st.conflict = Some(current);
+                    }
+                    return Error::Fenced(current);
+                }
+            }
+        }
+        e
+    }
