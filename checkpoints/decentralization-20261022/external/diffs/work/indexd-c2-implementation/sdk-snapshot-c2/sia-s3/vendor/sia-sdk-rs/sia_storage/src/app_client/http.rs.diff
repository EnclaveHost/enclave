+    /// PATCH (writer fencing): a signed POST of a fenced mutation (carries `sf` when this client holds a credential).
+    async fn post_fenced<S: Serialize, D: DeserializeOwned>(&self, url: Url, signing_key: &PrivateKey, body: Option<&S>) -> Result<D, Error> {
+        let (cred, v4) = self.cred_v4();
+        let body = body.and_then(|body| to_vec(body).ok());
+        let params = sign_c2(signing_key, &url, Method::POST, body.as_deref(), Utc::now() + Duration::from_secs(60), cred.as_ref(), v4);
+        let mut builder = self.client.post(url).timeout(DEFAULT_API_TIMEOUT).query(&params);
+        if let Some(body) = body {
+            builder = builder.body(body);
+        }
+        Client::handle_response(builder.send().await?).await.map_err(|e| self.note_refusal(e))
+    }
+
+    /// PATCH (writer fencing): a signed DELETE of a fenced mutation.
+    async fn delete_fenced(&self, path: &str, app_key: &PrivateKey) -> Result<(), Error> {
+        let url = self.url.join(path)?;
+        let (cred, v4) = self.cred_v4();
+        let params = sign_c2(app_key, &url, Method::DELETE, None, Utc::now() + Duration::from_secs(60), cred.as_ref(), v4);
+        Client::handle_response::<EmptyResponse>(self.client.delete(url).timeout(DEFAULT_API_TIMEOUT).query(&params).send().await?)
