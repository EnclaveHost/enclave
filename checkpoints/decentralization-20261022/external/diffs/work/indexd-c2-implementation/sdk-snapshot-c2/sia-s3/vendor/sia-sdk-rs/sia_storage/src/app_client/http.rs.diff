+/// PATCH C2: the answer of an object mutation: empty or null (no head reported), or {"seq": n}.
+fn parse_seq_answer(raw: &[u8]) -> Result<Option<u64>, Error> {
+    let t = std::str::from_utf8(raw).map_err(|e| Error::Format(e.to_string()))?.trim();
+    if t.is_empty() || t == "null" {
+        return Ok(None);
+    }
+    #[derive(serde::Deserialize)]
+    struct Seq {
+        seq: u64,
+    }
+    Ok(Some(serde_json::from_str::<Seq>(t)?.seq))
+}
