+    /// PATCH C2: a signed head-advancing object mutation (POST /objects with a body, or DELETE /objects/:key) carrying
+    /// `sf` and, when given, the v4 fields. Returns the head the indexer reports ({"seq": n, "replayed": b}; None for
+    /// an empty or null answer).
+    async fn mutate_c2(&self, method: Method, url: Url, signing_key: &PrivateKey, body: Option<Vec<u8>>, v4: Option<crate::fence::C2Op>) -> Result<Option<u64>, Error> {
+        let cred: Option<FenceCredential> = self.fence.lock().unwrap().cred;
+        let params = sign_c2(signing_key, &url, method.clone(), body.as_deref(), Utc::now() + Duration::from_secs(60), cred.as_ref(), v4);
+        let mut builder = self.client.request(method, url).timeout(DEFAULT_API_TIMEOUT).query(&params);
+        if let Some(body) = body {
+            builder = builder.body(body);
+        }
+        let resp = builder.send().await?;
+        if !resp.status().is_success() {
+            let e = Error::Api(resp.status(), resp.text().await?);
+            return Err(self.note_refusal(e));
+        }
+        let raw = resp.bytes().await?;
+        Ok(parse_seq_answer(&raw)?)
+    }
