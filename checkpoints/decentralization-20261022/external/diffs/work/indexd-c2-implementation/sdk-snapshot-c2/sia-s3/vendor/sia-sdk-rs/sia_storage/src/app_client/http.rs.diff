+    /// PATCH C2: the credential, and v4 fields for a NON-advancing fenced route: an enrolled client must send every
+    /// fenced mutation as v4 (G-C2 v4.0 section 1), here with a fresh op and no head precondition.
+    fn cred_v4(&self) -> (Option<FenceCredential>, Option<crate::fence::C2Op>) {
+        let st = self.fence.lock().unwrap();
+        let v4 = match st.c2 {
+            crate::fence::C2State::Off => None,
+            _ => Some(crate::fence::C2Op { op: rand::random(), sq: None }),
+        };
+        (st.cred, v4)
+    }
