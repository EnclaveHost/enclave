+    /// PATCH (writer fencing): `POST /fence {"fence": hex64}` -> 200 {"fence","receipt"} | 409 {"fence"}.
+    /// PATCH C2: with `cas`, the body adds "mode": "cas" (sticky enrolment) and the answer's "seq" is returned; a 412
+    /// {"conflict": "mode"} (a raise without "mode": "cas" on an enrolled account) is `Error::ModeConflict`.
+    pub(crate) async fn fence_raise(&self, app_key: &PrivateKey, token: FenceToken, cas: bool) -> Result<(FenceRaise, Option<u64>), Error> {
+        #[derive(serde::Deserialize)]
+        struct Installed {
+            fence: String,
+            receipt: String,
+            #[serde(default)]
+            seq: Option<u64>,
+        }
+        let url = self.url.join("fence")?;
+        let body = if cas {
+            serde_json::json!({ "fence": token.to_hex(), "mode": "cas" })
+        } else {
+            serde_json::json!({ "fence": token.to_hex() })
+        };
+        match post_json::<_, Installed>(&self.client, url, app_key, Some(&body)).await {
+            Ok(w) => {
+                let installed = FenceToken::parse_hex(&w.fence).map_err(Error::Format)?;
+                if installed != token {
+                    return Err(Error::Format("the indexer installed a different fence than requested".into()));
+                }
+                let receipt = FenceReceipt(strict_hex::<16>(&w.receipt).map_err(Error::Format)?);
+                Ok((FenceRaise::Installed(FenceCredential { token, receipt }), w.seq))
+            }
+            Err(Error::Api(status, body)) if status == StatusCode::PRECONDITION_FAILED => match parse_conflict(&body) {
+                Some((kind, _)) if kind == "mode" => Err(Error::ModeConflict),
+                _ => Err(Error::Api(status, body)),
+            },
+            Err(Error::Api(status, body)) if status == StatusCode::CONFLICT => match parse_refusal(&body) {
+                Some(current) => Ok((FenceRaise::Refused(current), None)),
+                None => Err(Error::Api(status, body)),
+            },
+            Err(e) => Err(e),
+        }
+    }
