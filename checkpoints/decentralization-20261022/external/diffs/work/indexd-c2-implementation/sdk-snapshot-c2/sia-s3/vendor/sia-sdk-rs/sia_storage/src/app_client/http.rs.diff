+    /// PATCH (writer fencing): `GET /fence` -> {"fence": hex64|null, "receiptSha256": hex64|null}, and (PATCH C2, G-C2
+    /// v4.0 section 5) "seq", "lastOp" (hex32|null), "lastOpDigest" (hex64|null), "mode" ("cas"|null) and
+    /// "capabilities" (absent from older indexers).
+    pub(crate) async fn fence_get(&self, app_key: &PrivateKey) -> Result<FenceState, Error> {
+        #[derive(serde::Deserialize)]
+        struct Wire {
+            fence: Option<String>,
+            #[serde(rename = "receiptSha256")]
+            receipt_sha256: Option<String>,
+            #[serde(default)]
+            seq: Option<u64>,
+            #[serde(rename = "lastOp", default)]
+            last_op: Option<String>,
+            #[serde(rename = "lastOpDigest", default)]
+            last_op_digest: Option<String>,
+            #[serde(default)]
+            mode: Option<String>,
+            #[serde(default)]
+            capabilities: Option<Vec<String>>,
+        }
+        let w: Wire = self.get_json::<_, ()>("fence", app_key, None).await?;
+        let fence = w.fence.map(|f| FenceToken::parse_hex(&f)).transpose().map_err(Error::Format)?;
+        let receipt_sha256 = w.receipt_sha256.map(|h| strict_hex::<32>(&h)).transpose().map_err(Error::Format)?;
+        let last_op = w.last_op.map(|h| strict_hex::<16>(&h)).transpose().map_err(Error::Format)?;
+        let last_op_digest = w.last_op_digest.map(|h| strict_hex::<32>(&h)).transpose().map_err(Error::Format)?;
+        Ok(FenceState {
+            fence,
+            receipt_sha256,
+            seq: w.seq,
+            last_op,
+            last_op_digest,
+            cas_mode: w.mode.as_deref() == Some("cas"),
+            capabilities: w.capabilities.unwrap_or_default(),
+        })
+    }
