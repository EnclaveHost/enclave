+
+// FenceResponse is the body of GET /fence (FENCING PATCH).
+type FenceResponse = accounts.FenceState
+
+// RaiseFenceResponse is the body of a successful POST /fence: the installed fence, the receipt to present with it
+// (sf = fence || receipt), and the event sequence head (FENCING PATCH).
+type RaiseFenceResponse struct {
+	Fence   accounts.Fence   `json:"fence"`
+	Receipt accounts.Receipt `json:"receipt"`
+	Seq     uint64           `json:"seq"`
+}
+
+// Credential returns the credential the raise issued.
+func (r RaiseFenceResponse) Credential() accounts.Credential {
+	return accounts.Credential{Fence: r.Fence, Receipt: r.Receipt}
+}
+
+// RaiseFenceRequest is the body of POST /fence (FENCING PATCH).
+type RaiseFenceRequest struct {
+	Fence accounts.Fence `json:"fence"`
+}
+
+// FencedResponse is the body of a 409 fence refusal (FENCING PATCH).
+type FencedResponse struct {
+	Fence *accounts.Fence `json:"fence"`
+}
+
+// Fence returns the account's installed writer fence and its event sequence head (FENCING PATCH).
+func (c *Client) Fence(ctx context.Context, appKey types.PrivateKey) (resp FenceResponse, err error) {
+	err = c.signedRequest(ctx, appKey, http.MethodGet, "/fence", nil, &resp)
+	return
+}
+
+// RaiseFence installs the writer fence f (FENCING PATCH).
+func (c *Client) RaiseFence(ctx context.Context, appKey types.PrivateKey, f accounts.Fence) (resp RaiseFenceResponse, err error) {
+	err = c.signedRequest(ctx, appKey, http.MethodPost, "/fence", RaiseFenceRequest{Fence: f}, &resp)
+	return
+}
+
+// ListObjectsSeq returns one page of the account's commit-ordered object sequence (FENCING PATCH).
+func (c *Client) ListObjectsSeq(ctx context.Context, appKey types.PrivateKey, after uint64, limit int) (resp slabs.SeqListing, err error) {
+	err = c.signedRequest(ctx, appKey, http.MethodGet, fmt.Sprintf("/seq/objects?after=%d&limit=%d", after, limit), nil, &resp)
+	return
+}
