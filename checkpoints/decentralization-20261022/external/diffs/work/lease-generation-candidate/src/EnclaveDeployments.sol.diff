+/// The rev-17 lease surface as one ABI, for clients: the ledger answers it through fallback() -> EnclaveLeaseGeneration.
+interface IEnclaveDeploymentsLeases {
+    function release(bytes32 id) external;
+    function releaseLease(bytes32 id, bytes32 runner, uint64 generation) external;
+    function leaseOf(bytes32 id) external view returns (bytes32 runner, address runnerOperator, uint64 leaseUntil, uint64 generation);
+    function guardedReleaseOnly(address operator) external view returns (bool);
+    function setGuardedReleaseOnly(bool on) external;
+    event Released(bytes32 indexed id, bytes32 indexed enclaveId, uint256 refunded6);
+    event GuardedReleaseOnlySet(address indexed operator, bool on);
+}
+
+/// Rev 17: the lease-naming surface of EnclaveDeployments, moved out of the ledger for EIP-170. Linked like
+/// EnclaveLedgerBandwidth and reached ONLY through the ledger's fallback (DELEGATECALL): it runs on the ledger's storage
+/// with the caller's msg.sender. Stateless, no admin, no target. Its non-view entry points refuse a direct CALL (the
+/// viaIR library guard), so calling the library itself changes nothing anywhere.
+///
+/// EXPLICIT STORAGE LAYOUT: the ledger slots below are fixed by the ledger's declaration order (rev 16d's, with the two
+/// rev-17 mappings appended). scripts/build.mjs refuses a build whose compiler layout differs from any of them.
+library EnclaveLeaseGeneration {
+    uint256 internal constant DEPLOYMENTS_SLOT = 12;   // mapping(bytes32 => Deployment) _deployments
+    uint256 internal constant EXISTS_SLOT = 13;        // mapping(bytes32 => bool) _exists
+    uint256 internal constant EARN_SLOT = 15;          // mapping(bytes32 => Earn) _earn
+    uint256 internal constant EARNED_SLOT = 17;        // mapping(address => uint256) earned6
+    uint256 internal constant PROVEN_SLOT = 19;        // mapping(bytes32 => uint64) provenUntil
+    uint256 internal constant GENERATION_SLOT = 26;    // mapping(bytes32 => uint64) _leaseGen
+    uint256 internal constant GUARDED_SLOT = 27;       // mapping(address => bool) _guardedReleaseOnly
+
+    event Released(bytes32 indexed id, bytes32 indexed enclaveId, uint256 refunded6);
+    event GuardedReleaseOnlySet(address indexed operator, bool on);
+
+    function _deployments() private pure returns (mapping(bytes32 => EnclaveDeployments.Deployment) storage m) { assembly ("memory-safe") { m.slot := DEPLOYMENTS_SLOT } }
+    function _exists() private pure returns (mapping(bytes32 => bool) storage m) { assembly ("memory-safe") { m.slot := EXISTS_SLOT } }
+    function _earn() private pure returns (mapping(bytes32 => EnclaveDeployments.Earn) storage m) { assembly ("memory-safe") { m.slot := EARN_SLOT } }
+    function _earned() private pure returns (mapping(address => uint256) storage m) { assembly ("memory-safe") { m.slot := EARNED_SLOT } }
+    function _proven() private pure returns (mapping(bytes32 => uint64) storage m) { assembly ("memory-safe") { m.slot := PROVEN_SLOT } }
+    function _generation() private pure returns (mapping(bytes32 => uint64) storage m) { assembly ("memory-safe") { m.slot := GENERATION_SLOT } }
+    function _guarded() private pure returns (mapping(address => bool) storage m) { assembly ("memory-safe") { m.slot := GUARDED_SLOT } }
+
+    /// @notice Graceful hand-back of whatever lease the caller holds on `id` - rev 16d's release, unchanged - unless
+    ///         the caller opted into guardedReleaseOnly ("guarded release only"). See the ledger's comment above
+    ///         _burnLease for the checkpoint-then-release ordering.
+    function release(bytes32 id) external { _release(id, false, bytes32(0), 0); }
+
+    /// @notice Release exactly the lease (runner, generation): a stale, replayed or second-host release meant for an
+    ///         earlier lease of this operator reverts "not this lease" instead of ending a later one - including a
+    ///         re-claim in the same block at the same leaseUntil. Same body as release(id).
+    function releaseLease(bytes32 id, bytes32 runner, uint64 generation) external { _release(id, true, runner, generation); }
+
+    /// @notice The lease a host decides on, in one call at one block. generation 0 = never claimed on this ledger.
+    function leaseOf(bytes32 id) external view returns (bytes32 runner, address runnerOperator, uint64 leaseUntil, uint64 generation) {
+        EnclaveDeployments.Deployment storage d = _deployments()[id];
+        return (d.runner, d.runnerOperator, d.leaseUntil, _generation()[id]);
+    }
+
+    function guardedReleaseOnly(address operator) external view returns (bool) { return _guarded()[operator]; }
+
+    /// @notice Refuse (or allow again) the unnamed release(id) for the caller's own key. Set it once every host
+    ///         holding this key sends releaseLease; an older binary's blind release then ends nothing.
+    function setGuardedReleaseOnly(bool on) external {
+        _guarded()[msg.sender] = on;
+        emit GuardedReleaseOnlySet(msg.sender, on);
+    }
+
+    function _release(bytes32 id, bool named, bytes32 runner, uint64 gen) private {
+        EnclaveDeployments.Deployment storage d = _deployments()[id];
+        require(_exists()[id], "unknown");
+        require(d.runnerOperator == msg.sender, "not runner");
+        if (named) require(d.runner == runner && _generation()[id] == gen, "not this lease");
+        else require(!_guarded()[msg.sender], "guarded release only");
+        EnclaveDeployments.Earn storage e = _earn()[id];
+        // pay for time HELD; the refunded tail earns nothing (proofRequired: the ledger's own view, read in place)
+        EnclaveLedgerBandwidth.credit(d, e, _earned(), EnclaveDeployments(address(this)).proofRequired(), _proven()[id]);
+        uint256 tail = 0;                        // not `refund` - that names the owner-facing rev-10 call
+        if (d.leaseUntil > block.timestamp) {
+            tail = (d.leaseUntil - block.timestamp) * d.rate;
+            d.balance6 += tail;
+            d.spent6 -= tail;
+        }
+        bytes32 enclaveId = d.runner;
+        d.runner = bytes32(0);
+        d.runnerOperator = address(0);
+        d.leaseUntil = 0;
+        e.creditedUntil = 0;                     // meter idles until the next claim restarts it
+        _proven()[id] = 0;                       // and the proof watermark resets with it
+        emit Released(id, enclaveId, tail);
+    }
+}
