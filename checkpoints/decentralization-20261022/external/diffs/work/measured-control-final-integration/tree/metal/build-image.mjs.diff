+/** Every repository file a module statically or dynamically imports by relative path, transitively (itself included). */
+export function importClosure(src, entry) {
+  const seen = new Set(), queue = [entry];
+  while (queue.length) {
+    const f = path.normalize(queue.pop());
+    if (seen.has(f)) continue;
+    seen.add(f);
+    const code = fs.readFileSync(path.join(src, f), 'utf8');
+    for (const m of code.matchAll(/(?:from\s*|import\s*\()\s*(['"])(\.\.?\/[^'"]+)\1/g)) queue.push(path.join(path.dirname(f), m[2]));
+  }
+  return [...seen];
+}
 
