+# Guest modules a committed gsup.mjs may import: installed exactly when that commit's gsup imports them (its closure),
+# so an overlay of an older commit is unchanged and a newer one never ships a gsup without its helper.
+OPTIONAL_GUEST_FILES = ['measured-control.mjs']
+def guest_files(commit, repo):
+    gsup = subprocess.check_output(['git', 'show', commit+':metal/guest/gsup.mjs'], cwd=repo).decode()
+    return GUEST_FILES + [f for f in OPTIONAL_GUEST_FILES if ("'./"+f+"'") in gsup or ('"./'+f+'"') in gsup]
+# The supervisor's independent direct-mode chain reader and its import closure, installed exactly when that commit's
+# supervisor.js imports it (an overlay of an older commit is unchanged; a newer one never ships the import without it).
+DIRECT_CHAIN_ENTRY = 'network/direct-chain.mjs'
+IMPORT_RE = re.compile(r'''(?:from\s*|import\s*\()\s*(['"])(\.\.?/[^'"]+)\1''')
+def app_files(commit, repo):
+    show = lambda f: subprocess.check_output(['git', 'show', commit+':'+f], cwd=repo).decode()
+    if '"./'+DIRECT_CHAIN_ENTRY+'"' not in show('supervisor.js'):
+        return list(APP_FILES)
+    seen, queue = [], [DIRECT_CHAIN_ENTRY]
+    while queue:
+        f = posixpath.normpath(queue.pop())
+        if f in seen:
+            continue
+        seen.append(f)
+        for m in IMPORT_RE.finditer(show(f)):
+            queue.append(posixpath.join(posixpath.dirname(f), m.group(2)))
+    return list(APP_FILES) + [f for f in seen if f not in APP_FILES]
