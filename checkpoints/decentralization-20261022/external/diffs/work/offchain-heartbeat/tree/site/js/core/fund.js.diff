+  let pricing = null;
+  try { pricing = await (await fetch(Enclave.base + "/pricing", { signal: AbortSignal.timeout(8000) })).json(); } catch(e){}
+  return { usdc: (pricing && pricing.usdc) || "0x833589fCD6eDb6E08f4c7C32D4f71b54bdA02913",
+           usdcDomain: pricing && pricing.usdcDomain, ethUsd: pricing && pricing.ethUsd };
+}
