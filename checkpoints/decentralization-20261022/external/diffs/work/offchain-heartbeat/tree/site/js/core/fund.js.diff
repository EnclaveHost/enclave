+export async function fundingTerms(){
+  if (INDEPENDENT_MODE){
+    const { tokenDomain, ethFundingQuote } = await import("./independent-chain.js");
+    // the ETH price fundEth will credit at: the ledger's own feed, read at a block the profile's RPCs agree on
+    let ethUsd = null, ethUsdError = null, ethQuote = null;
