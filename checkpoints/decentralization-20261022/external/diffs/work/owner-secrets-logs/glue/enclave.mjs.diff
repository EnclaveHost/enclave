+    if (!(await verifyTypedData({ address: owner, ...td, signature: sig })))
+      throw new Error(`the signature is not ${owner}'s over this exact SessionGrant (vault ${vault}, chain ${DEFAULTS.chainId}); nothing was sent`);
+    return sig;
