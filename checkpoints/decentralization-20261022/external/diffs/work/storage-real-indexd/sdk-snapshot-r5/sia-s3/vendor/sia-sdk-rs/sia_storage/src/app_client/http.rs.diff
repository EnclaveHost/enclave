+    /// PATCH (writer fencing): a 409 whose JSON body names a fence is a fenced refusal: recorded (the first one) and
+    /// returned as `Error::Fenced`.
+    fn note_refusal(&self, e: Error) -> Error {
+        if let Error::Api(status, body) = &e {
+            if *status == StatusCode::CONFLICT {
+                if let Some(current) = parse_refusal(body) {
+                    let mut st = self.fence.lock().unwrap();
+                    if st.conflict.is_none() {
+                        st.conflict = Some(current);
+                    }
+                    return Error::Fenced(current);
+                }
+            }
+        }
+        e
+    }
+
+    /// PATCH (writer fencing): a signed POST of a fenced mutation (carries `sf` when this client holds a credential).
+    async fn post_fenced<S: Serialize, D: DeserializeOwned>(&self, url: Url, signing_key: &PrivateKey, body: Option<&S>) -> Result<D, Error> {
+        let cred: Option<FenceCredential> = self.fence.lock().unwrap().cred;
+        let body = body.and_then(|body| to_vec(body).ok());
+        let params = sign_fenced(signing_key, &url, Method::POST, body.as_deref(), Utc::now() + Duration::from_secs(60), cred.as_ref());
+        let mut builder = self.client.post(url).timeout(DEFAULT_API_TIMEOUT).query(&params);
+        if let Some(body) = body {
+            builder = builder.body(body);
+        }
+        Client::handle_response(builder.send().await?).await.map_err(|e| self.note_refusal(e))
+    }
+
+    /// PATCH (writer fencing): a signed DELETE of a fenced mutation.
+    async fn delete_fenced(&self, path: &str, app_key: &PrivateKey) -> Result<(), Error> {
+        let url = self.url.join(path)?;
+        let cred: Option<FenceCredential> = self.fence.lock().unwrap().cred;
+        let params = sign_fenced(app_key, &url, Method::DELETE, None, Utc::now() + Duration::from_secs(60), cred.as_ref());
+        Client::handle_response::<EmptyResponse>(self.client.delete(url).timeout(DEFAULT_API_TIMEOUT).query(&params).send().await?)
+            .await
+            .map(|_| ())
+            .map_err(|e| self.note_refusal(e))
+    }
+
+    /// PATCH (writer fencing): `GET /fence` -> {"fence": hex64|null, "receiptSha256": hex64|null}.
+    pub(crate) async fn fence_get(&self, app_key: &PrivateKey) -> Result<FenceState, Error> {
+        #[derive(serde::Deserialize)]
+        struct Wire {
+            fence: Option<String>,
+            #[serde(rename = "receiptSha256")]
+            receipt_sha256: Option<String>,
+        }
+        let w: Wire = self.get_json::<_, ()>("fence", app_key, None).await?;
+        let fence = w.fence.map(|f| FenceToken::parse_hex(&f)).transpose().map_err(Error::Format)?;
+        let receipt_sha256 = w.receipt_sha256.map(|h| strict_hex::<32>(&h)).transpose().map_err(Error::Format)?;
+        Ok(FenceState { fence, receipt_sha256 })
+    }
+
+    /// PATCH (writer fencing): `POST /fence {"fence": hex64}` -> 200 {"fence","receipt"} | 409 {"fence"}.
+    pub(crate) async fn fence_raise(&self, app_key: &PrivateKey, token: FenceToken) -> Result<FenceRaise, Error> {
+        #[derive(serde::Deserialize)]
+        struct Installed {
+            fence: String,
+            receipt: String,
+        }
+        let url = self.url.join("fence")?;
+        let body = serde_json::json!({ "fence": token.to_hex() });
+        match post_json::<_, Installed>(&self.client, url, app_key, Some(&body)).await {
+            Ok(w) => {
+                let installed = FenceToken::parse_hex(&w.fence).map_err(Error::Format)?;
+                if installed != token {
+                    return Err(Error::Format("the indexer installed a different fence than requested".into()));
+                }
+                let receipt = FenceReceipt(strict_hex::<16>(&w.receipt).map_err(Error::Format)?);
+                Ok(FenceRaise::Installed(FenceCredential { token, receipt }))
+            }
+            Err(Error::Api(status, body)) if status == StatusCode::CONFLICT => match parse_refusal(&body) {
+                Some(current) => Ok(FenceRaise::Refused(current)),
+                None => Err(Error::Api(status, body)),
+            },
+            Err(e) => Err(e),
+        }
+    }
