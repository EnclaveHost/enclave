+    /// PATCH U1 (needs the U1 indexd endpoint): the account's current objects in ID order after `after`, read
+    /// from the indexer's object table: unlike [Sdk::object_events], an acknowledged pin is listed at once.
+    /// Consecutive pages (each `after` = the last ID of the page before) return every object committed before
+    /// the first page that is not deleted meanwhile, exactly once.
+    pub async fn current_objects(&self, after: Option<Hash256>, limit: Option<usize>) -> Result<Vec<ObjectEvent>, Error> {
+        let events = self.api_client.current_objects(&self.app_key.0, after, limit).await.map_err(|e| Error::App(format!("{e:?}")))?;
+        events
+            .into_iter()
+            .map(|event| {
+                let object = match event.object {
+                    Some(sealed) => Some(sealed.open(self.app_key.as_ref())?),
+                    None => None,
+                };
+                Ok(ObjectEvent { id: event.id, deleted: event.deleted, updated_at: event.updated_at, object })
+            })
+            .collect()
+    }
+
