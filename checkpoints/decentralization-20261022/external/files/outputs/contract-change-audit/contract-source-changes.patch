+        "admin": "0x10d6a54a4754c8869d6886b5f5d7fbfa5b4522237ea5c60d11bc4e7a1ff9390b"
+      },
+      "profileName": "usdc",
+      "basis": "External Circle upgradeable proxy (CBOR solc 0.6.12). Only the proxy runtime hash is pinned and its source is not verified here. Implementation and admin live in the ZeppelinOS slots named below; they are observed on every run but deliberately not pinned, because the admin can replace the implementation without changing the proxy hash. Verifying this proxy says nothing about future USDC behavior."
+    }
+  }
+}
