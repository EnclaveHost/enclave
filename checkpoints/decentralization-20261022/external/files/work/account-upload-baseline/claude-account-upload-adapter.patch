+    let cors = cfg.map(|c| gateway_cors(req, c)).unwrap_or_default();
+    if !cors.is_empty() {
+        resp.headers.extend(cors);
+        resp = resp.with("access-control-allow-methods", "GET, HEAD, OPTIONS").with("access-control-allow-headers", "range, cache-control");
+    }
+    resp
