+    fn upload_origins_are_exact_and_explicit() {
+        let j = |v: serde_json::Value| allow_origins(Some(&v));
+        // the historical default is kept for configs that never said
+        assert_eq!(allow_origins(None), vec!["https://enclave.host"]);
