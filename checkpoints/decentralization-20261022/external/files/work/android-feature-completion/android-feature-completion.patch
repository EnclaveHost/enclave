+}
+const body = (req) => new Promise((res, rej) => { const c = []; req.on("data", (b) => c.push(b)); req.on("end", () => { try { res(JSON.parse(Buffer.concat(c).toString() || "{}")); } catch (e) { rej(e); } }); });
