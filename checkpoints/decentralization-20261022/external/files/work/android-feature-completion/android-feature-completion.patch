+  assert.equal(c.subarray(0, 32).toString("hex"), sha(Buffer.concat([Buffer.from("enclave-custody-avf-v1\n"), binding, instanceId])).toString("hex"));
+  assert.equal(c.toString("hex"), vec.challenge);
+});
