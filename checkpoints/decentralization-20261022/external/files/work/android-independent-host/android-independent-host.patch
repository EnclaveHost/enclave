+  const verifierPolicy = createHostPolicyRuntime(resolveHostPolicyConfig({ env: { ENCLAVE_PLATFORM_HOST_POLICY: JSON.stringify({ book: BOOK, hostOwnership: OWNERSHIP, mirrors: [pw.mirrorOrigin], rpcs: policyRpcs }) } }),
