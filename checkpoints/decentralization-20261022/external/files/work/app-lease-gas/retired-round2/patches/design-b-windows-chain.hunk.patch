+// ---- app-funded lease gas, design B (work/app-lease-gas; PROTOTYPE, off unless configured) ----
+// The user's direction: lease claims and renewals (and the release that ends one) are paid by the APP, not this box's
+// wallet. With ENCLAVE_LEASE_GAS_RESERVE set, claim / renew / release are signed LOCALLY by the operator key (EIP-7702
+// delegated to EnclaveLeaseExecutor; the authorization rides in a relay's transaction), sent by any of
+// ENCLAVE_LEASE_GAS_RELAYS, and paid from the app's ETH reserve. A refusal (no reserve, empty, outside the renew
+// window, ...) throws in the reserve's own words with .code; this box never falls back to spending its own ETH.
+// The same module as the Linux supervisor (network/lease-executor-client.mjs). Unset: exactly the sends above.
+const LEASE_GAS_RESERVE = (process.env.ENCLAVE_LEASE_GAS_RESERVE || "").trim();
+const LEASE_GAS_RELAYS = (process.env.ENCLAVE_LEASE_GAS_RELAYS || "").split(",").map((s) => s.trim()).filter(Boolean);
+let leaseGas = null;
+async function leaseSender() {
+  if (!LEASE_GAS_RESERVE) return null;
+  if (!LEASE_GAS_RELAYS.length) throw new Error("ENCLAVE_LEASE_GAS_RESERVE needs ENCLAVE_LEASE_GAS_RELAYS");
+  if (!acct) throw new Error("no operator key on this box");
+  if (!leaseGas) {
+    const L = await import("../../network/lease-executor-client.mjs");
+    leaseGas = L.createLeaseSender({ client: publicClient(), account: acct, reserve: getAddress(LEASE_GAS_RESERVE), relays: LEASE_GAS_RELAYS });
+  }
+  return leaseGas;
+}
+/** claim / renew / release: app-funded when configured, serialized with this key's other sends (its one-time 7702
+ *  authorization consumes an account nonce); otherwise the operator's own transaction. */
+async function leaseSend(fn, args) {
+  const s = await leaseSender();
+  if (!s) return send(addresses.deployments, DEP_ABI, fn, args);
+  const job = async () => {
+    const r = await s[fn](...args);
+    if (r.receipt.status !== "success") throw new Error(`${fn} reverted (${r.hash})`);
+    return r.hash;
+  };
+  return (chainTx = chainTx.then(job, job));
+}
+export const leaseGasActive = () => !!LEASE_GAS_RESERVE;
