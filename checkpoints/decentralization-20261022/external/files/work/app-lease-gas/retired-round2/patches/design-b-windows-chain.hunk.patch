+  outputs: [{ type: "tuple", components: [{ name: "balanceWei", type: "uint128" }, { name: "maxPerOpWei", type: "uint64" },
+    { name: "epochCapWei", type: "uint64" }, { name: "enabled", type: "bool" }, { name: "claimPolicy", type: "uint8" }, { name: "sponsorRelease", type: "bool" },
+    { name: "renewWindow", type: "uint32" }, { name: "minExtension", type: "uint32" }, { name: "claimCooldown", type: "uint32" },
+    { name: "epochSec", type: "uint32" }, { name: "maxGasPrice", type: "uint64" }, { name: "maxClaimsPerEpoch", type: "uint8" },
+    { name: "epochIndex", type: "uint32" }, { name: "epochSpentWei", type: "uint96" }, { name: "epochClaims", type: "uint8" },
+    { name: "lastClaimAt", type: "uint64" }, { name: "lastClaimOperator", type: "address" }] }] }];
+/** How long before leaseUntil this box should renew: `fallbackMs` normally; when app-funded, inside the app's renew
+ *  window (the reserve refuses earlier), minus 15 s for inclusion. */
+export async function renewLeadMs(id, fallbackMs) {
+  if (!LEASE_GAS_RESERVE) return fallbackMs;
+  try {
+    const d = await readDeployment(id);
+    const r = await publicClient().readContract({ address: getAddress(LEASE_GAS_RESERVE), abi: RESERVE_WINDOW_ABI, functionName: "reserveOf", args: [id, d.owner] });
+    if (!r.enabled) return fallbackMs;
+    return Math.min(fallbackMs, Math.max(5, Number(r.renewWindow) - 15) * 1000);
+  } catch { return fallbackMs; }
+}
