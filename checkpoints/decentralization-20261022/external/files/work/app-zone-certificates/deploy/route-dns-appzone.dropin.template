# /etc/systemd/system/enclave-route-dns.service.d/zz-app-zone-challenge.conf  (TEMPLATE - root fills <...>; not applied)
# Adds the route replica's own app-zone DNS-01 authority (relay/dns-relay.js APP_CHALLENGE_AUTH=attested-lease) to the
# existing read-only replica. Everything else (DNS_READ_ONLY, ROUTE_MAP_URL=http://127.0.0.1:8188/v1/network/routes,
# zones, NS set, rate limits, DNS_API_BIND=127.0.0.1 DNS_API_PORT=8154) stays as deployed. Rollback: remove this file,
# restore the previous ExecStart drop-in, daemon-reload, restart (no state: challenge values are disposable).
[Service]
ExecStart=
# the release directory holds dns.mjs AND network-runtime.bundle.mjs (deploy/dist, hashes in dns.mjs.manifest.json)
ExecStart=/usr/local/bin/node /opt/enclave-route-dns/appzone-<dns.mjs sha256[0:12]>/dns.mjs
Environment=APP_CHALLENGE_AUTH=attested-lease
# the measured direct-front release(s) the platform admits (96-hex SNP launch digests; from the release records)
Environment=APP_CHALLENGE_MEASUREMENTS=<96hex>[,<96hex>...]
# the same agreeing public RPC set the local directory uses (two or more distinct hosts)
Environment=APP_CHALLENGE_RPCS=https://mainnet.base.org,https://base-rpc.publicnode.com,https://base.drpc.org
# production pins (contracts/deployments/contract-pins-production-base.json; the book is the existing admin-owned book)
Environment=APP_CHALLENGE_PINS={"addressBook":"0xab214342d5A490150A4A977063A2f88E21F80907","deployments":"0xb1783b61e1fdee6a6163dc3cdac27bf32e7d117b","registry":"0x868eb7fc5b5a84b2ff082eafc9bf40b7aac5ccac","catalog":"0x18419ca2b502d423a8de6269aeee171a378626e3"}
# transition: merge the current control challenge store so relay-issued certificates keep validating
Environment=APP_CHALLENGE_UPSTREAM=127.0.0.1:31053
# the other replicas' HTTPS push endpoints (literal-IP sites + deploy/caddy-appzone.py route), excluding this host
Environment=APP_CHALLENGE_PEERS=https://<peer ip 1>,https://<peer ip 2>,https://<peer ip 3>
