+const plain = (v) => !!v && typeof v === "object" && Object.getPrototypeOf(v) === Object.prototype;
+const address = /^0x[0-9a-f]{40}$/, hash32 = /^0x[0-9a-f]{64}$/, zero = "0x" + "0".repeat(40);
