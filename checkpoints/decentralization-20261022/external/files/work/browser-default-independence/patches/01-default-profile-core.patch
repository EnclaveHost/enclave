+      if (JSON.stringify(got.reviewedState[getter]) !== JSON.stringify(want.reviewedState[getter])) problems.push(`${name}.${getter}: reviewed mutable state changed (${JSON.stringify(got.reviewedState[getter])})`);
+  }
