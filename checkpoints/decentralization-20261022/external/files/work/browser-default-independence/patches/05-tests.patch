+#!/usr/bin/env node
+// Builds the site exactly as a release would, but with a PROVISIONAL (loopback-only) default profile for the browser
+// tests (test/site-default-independence.test.mjs). The profile is generated by scripts/network/default-profile.mjs from:
+//   - the REAL reviewed authority profile (contracts/deployments/network-profile-base.json, digest checked) and the real
+//     host contract pins: the tests run on an anvil fork of Base, which holds exactly those contracts;
+//   - the REAL service index pin (contracts/deployments/service-index-pin-base.json);
+//   - three loopback RPC proxies on FIXED ports (the profile is baked into the bundle);
+//   - a fixture storage plan and host-policy mirror at public-looking names the test routes to local handlers.
+// Then scripts/build-site.mjs --default-profile <module> --provisional-ok writes site/dist. Prints a JSON summary.
+//   node test/helpers/default-site-fixture.mjs [--out-dir DIR]
+import fs from "node:fs";
+import os from "node:os";
+import path from "node:path";
+import { execFileSync } from "node:child_process";
+import { createHash } from "node:crypto";
+import { fileURLToPath } from "node:url";
+
+const ROOT = path.resolve(path.dirname(fileURLToPath(import.meta.url)), "../..");
+export const PROXY_PORTS = [39651, 39652, 39653];
+export const FIXTURE_STORAGE = { version: 1, minimumCopies: 2, replicas: [
+  { upload: "https://s1.storage-a.net/add-json", audience: "0x" + "a1".repeat(32), gateway: "https://s1.storage-a.net/ipfs" },
+  { upload: "https://s2.storage-b.net/add-json", audience: "0x" + "b2".repeat(32), gateway: "https://s2.storage-b.net/ipfs" }] };
+export const POLICY_MIRROR = "https://policies.operator-c.net";
+export const AUTHORITY = path.join(ROOT, "contracts/deployments/network-profile-base.json");
+export const AUTHORITY_DIGEST = "sha256:" + createHash("sha256").update(fs.readFileSync(AUTHORITY)).digest("hex");
+
+export function buildFixtureSite({ outDir = fs.mkdtempSync(path.join(os.tmpdir(), "default-site-")) } = {}){
+  const storage = path.join(outDir, "storage-plan.json");
+  fs.writeFileSync(storage, JSON.stringify(FIXTURE_STORAGE));
+  const prof = path.join(outDir, "profile");
+  const run = (args) => execFileSync("node", args, { cwd: ROOT, stdio: ["ignore", "pipe", "inherit"] }).toString().trim().split("\n").pop();
+  const gen = JSON.parse(run([path.join(ROOT, "scripts/network/default-profile.mjs"), "generate", "--provisional", "--authority", AUTHORITY,
