+    let clean = true;
+    try { git("diff", "--quiet", "HEAD", "--", p); } catch { clean = false; }
+    if (!git("ls-files", "--", p)) clean = false;
+    return { commit, committedClean: clean };
+  } catch { return { commit: null, committedClean: null }; }
+}
+
+if (import.meta.url === `file://${process.argv[1]}`) {
