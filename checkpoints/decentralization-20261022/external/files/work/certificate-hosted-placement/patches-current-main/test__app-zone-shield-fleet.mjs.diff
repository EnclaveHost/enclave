+      else if (b.op === 'delist') state.apps['0x' + '66'.repeat(32)].active = false;
+      else if (b.op === 'relist') state.apps['0x' + '66'.repeat(32)].active = true;
+      else if (b.op === 'release') { d.runner = '0x' + '0'.repeat(64); d.runnerOperator = '0x' + '0'.repeat(40); }
