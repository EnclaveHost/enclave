+def resume_unchanged(node, before, version):
+    """after a failed pre-switch verification: restart the UNCHANGED source release if that is safe -> report (never
+    raises an ordinary exception)"""
+    try:
+        cur = Path(node["release_dir"]) / "current"
+        now = os.readlink(cur) if cur.is_symlink() else None
+        if before is None or now != before:
+            return {"resumed": False, "reason": f"current release {now} is not the pre-upgrade release {before}: not restarted"}
+        try:
+            v = node.db_version(timeout=QUERY_CAP)
+        except Exception as e:
+            return {"resumed": False, "reason": f"db_version unreadable ({str(e)[-160:]}): not restarted"}
+        if v != version:
+            return {"resumed": False, "reason": f"db_version {v} != {version}: not restarted"}
+        node.start()
+        node.wait_ready(version)
+    except Exception as e:
+        return {"resumed": False, "resumeFailed": f"{type(e).__name__}: {str(e)[-300:]}", "release": before}
+    return {"resumed": True, "release": before, "dbVersion": version}
+
+
+def verify_before_switch(node, b, before, version):
+    """the upgrade's VERIFY step, BEFORE anything is switched. On a failed verification, an uncertain cleanup or ANY
+    ordinary exception: no switch, the unchanged source release is resumed if safe, evidence stays in the backup
+    directory, and the command exits 1. KeyboardInterrupt/SystemExit propagate (never a success)."""
+    try:
+        v = verify_backup(node, b)
+    except Exception as e:                       # safety net: verify_backup already reports its own exceptions
+        v = {"ok": False, "cleanupOk": False, "problems": [f"verification raised {type(e).__name__}: {str(e)[-240:]}"]}
+    if v.get("ok") and v.get("cleanupOk"):
+        return v
+    res = resume_unchanged(node, before, version)
+    print(json.dumps({"ok": False, "error": "backup verification failed before the switch: nothing switched",
+                      "verify": v, "resume": res, "backup": str(b), "previousRelease": before}))
+    sys.exit(1)
 
 
