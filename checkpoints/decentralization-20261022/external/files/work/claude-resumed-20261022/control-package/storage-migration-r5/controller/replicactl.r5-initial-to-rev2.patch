+class QueryBudget:
+    """ONE time budget for every verification query except the restore itself (profile key verify_query_seconds).
+    Each query or sleep gets min(its own cap, what is left); when nothing is left, TimeoutError (an ordinary
+    exception: the scratch database is then preserved and reported, never dropped)."""
+
+    def __init__(self, seconds):
+        self.left_at = time.monotonic() + seconds
+        self.seconds = seconds
+
+    def cap(self, c):
+        left = self.left_at - time.monotonic()
+        if left <= 0:
+            raise TimeoutError(f"verification query budget of {self.seconds} s exhausted")
+        return min(c, left)
+
+
+class VerifyRecord:
+    """<backup>/verify-<scratch>.json, the recovery record of ONE verification.
+    - Created EXCLUSIVELY (O_EXCL | O_NOFOLLOW, 0600): an existing record of that name is refused, never overwritten.
+    - Each update is written to a fresh temp of a random name, itself created exclusively.
+    - The temp replaces the record only while the record is still the file this verification last wrote (same device and
+      inode); otherwise the update is refused.
+    - Only this verification's own temp is ever removed (after a failed update), and only if it is still the inode it
+      created."""
+
+    def __init__(self, backup, scratch):
+        self.p = Path(backup) / f"verify-{scratch}.json"
+        fd = os.open(self.p, os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_NOFOLLOW, 0o600)   # FileExistsError: refused
+        st = os.fstat(fd)
+        os.close(fd)
+        self.ident = (st.st_dev, st.st_ino)
+
+    def write(self, rep):
+        st = os.lstat(self.p)
+        if (st.st_dev, st.st_ino) != self.ident:
+            raise RuntimeError(f"{self.p.name} is no longer the record this verification wrote: not overwritten")
+        tmp = self.p.parent / f".{self.p.name}.{secrets.token_hex(8)}.tmp"
+        fd = os.open(tmp, os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_NOFOLLOW, 0o600)   # FileExistsError: never reused
+        tst = os.fstat(fd)
+        try:
+            with os.fdopen(fd, "w") as f:
+                f.write(json.dumps(rep, indent=1) + "\n")
+                f.flush()
+                os.fsync(f.fileno())
+            os.replace(tmp, self.p)
+        except BaseException:
+            try:
+                cur = os.lstat(tmp)
+                if (cur.st_dev, cur.st_ino) == (tst.st_dev, tst.st_ino):
+                    os.unlink(tmp)                         # ours: the inode this update created
+            except FileNotFoundError:
+                pass
+            raise
+        self.ident = (tst.st_dev, tst.st_ino)
 
 
