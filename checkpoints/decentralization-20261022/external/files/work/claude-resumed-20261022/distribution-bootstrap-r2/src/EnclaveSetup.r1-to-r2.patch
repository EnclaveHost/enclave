+        /// <summary>At most max bytes from s, or a throw: reads up to max + 1 bytes, so a stream longer than max (however its
+        /// Length reports, e.g. a file still growing) is refused instead of truncated or accepted.</summary>
+        internal static byte[] ReadBounded(Stream s, int max)
+        {
+            var buf = new byte[max + 1]; int n = 0, r;
+            while (n <= max && (r = s.Read(buf, n, max + 1 - n)) > 0) n += r;
+            if (n > max) throw new Exception("more than " + max + " bytes");
+            var b = new byte[n]; Array.Copy(buf, b, n); return b;
+        }
