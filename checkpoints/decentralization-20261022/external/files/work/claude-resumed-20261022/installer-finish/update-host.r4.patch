+# What lives beside the release in Program Files\Enclave and \Enclave\ (install-host.ps1's own lists); empty on a plain host.
+function RolesBeside {
+  $owned = @("runtime", "control", "network", "bin", "guest", "tray", "tuna", "manifest.json", "uninstall-host.ps1", "update-host.ps1", "EnclaveSetup.exe")
+  $beside = @(Get-ChildItem -LiteralPath $PF -Force | Where-Object { $owned -notcontains $_.Name } | ForEach-Object { "$PF\$($_.Name)" })
+  $roles = @(Get-ScheduledTask -TaskPath "\Enclave\" -ErrorAction SilentlyContinue | Where-Object { @("Shield", "Card", "Node", "Network", "Tuna", "Update") -notcontains $_.TaskName } | ForEach-Object { "\Enclave\$($_.TaskName)" })
+  return @($beside + $roles)
+}
+function Preserving($dir) {
+  $i = Join-Path $dir "install-host.ps1"
+  return (Test-Path -LiteralPath $i) -and (Select-String -LiteralPath $i -SimpleMatch "ENCLAVE-ROLE-PRESERVATION-V1" -Quiet)
+}
