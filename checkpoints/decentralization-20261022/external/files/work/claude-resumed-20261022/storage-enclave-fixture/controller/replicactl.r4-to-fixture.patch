+BOOT_ID_FILE = "/proc/sys/kernel/random/boot_id"
+
+
+def boot_id():
+    return Path(BOOT_ID_FILE).read_text().strip()
+
+
+def proc_start(pid):
+    """starttime (field 22 of /proc/<pid>/stat) of a live, non-zombie pid; None if no such process or a zombie.
+    Any other read failure raises (unknown state)."""
+    try:
+        raw = Path(f"/proc/{pid}/stat").read_bytes()
+    except (FileNotFoundError, ProcessLookupError):
+        return None
+    rest = raw[raw.rindex(b")") + 2:].split()   # fields 3.. (comm may contain spaces and parentheses)
+    if rest[0] in (b"Z", b"X"):
+        return None
+    return rest[19].decode()
+
+
+def proc_cgroup(pid):
+    """cgroup v2 path of pid ("self" allowed); None if no such process. Any other read failure raises (unknown)."""
+    try:
+        line = Path(f"/proc/{pid}/cgroup").read_text().strip()
+    except (FileNotFoundError, ProcessLookupError):
+        return None
+    return line.split("::", 1)[1] if "::" in line else None
+
+
+def ancestor_pids():
+    """this controller and all its ancestors: never a signal target"""
+    out, pid = set(), os.getpid()
+    while pid and pid > 1:
+        try:
+            st = Path(f"/proc/{pid}/stat").read_bytes()
+        except (FileNotFoundError, ProcessLookupError):
+            break
+        out.add(pid)
+        pid = int(st[st.rindex(b")") + 2:].split()[1])
+    return out
+
+
+def pidfd_wait(fd, seconds):
+    """True once the process behind the pidfd has exited (the pidfd becomes readable)."""
+    po = select.poll()
+    po.register(fd, select.POLLIN)
+    return bool(po.poll(int(seconds * 1000)))
+
