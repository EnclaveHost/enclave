+    # ---------- root-run1 regression: the PostgreSQL socket path must fit AF_UNIX ----------
+    def test_root_run1_socket_path_is_reproduced_and_now_refused_before_any_action(self):
+        base_src = F.BASE.read_text()
+        j = [json.loads(l) for l in (PKG / "runs" / "aaee0cac7170551d.journal.jsonl").read_text().splitlines()]
+        stage = next(e["name"] for e in j if e.get("event") == "created" and e.get("resource") == "stage")
+        self.assertEqual(len(stage + F.SOCK_SUFFIX), 138, "root-run1's actual host-side socket path")
+        self.assertIn("138 bytes", F.socket_path_problem(PKG / "runs", base_src), "the r1 layout is refused")
+        self.assertIsNone(F.socket_path_problem(F.RUNS, base_src))
+        self.assertLessEqual(len(str(F.RUNS)) + 1 + 16 + len(F.SOCK_SUFFIX), F.SUN_PATH_MAX)
+        self.assertIn("re-derive", F.socket_path_problem(F.RUNS, base_src.replace("  host: {SOCK}\n", "  host: {W}\n")))
+
+    def test_the_af_unix_limit_is_real_at_both_lengths(self):
+        # same lengths as r1 (138) and the r2 worst case: a server bound at the r2 length accepts a client; at 138 the
+        # name is refused before any connect (the kernel sun_path is 108 bytes; Go returns EINVAL for the same names)
+        r2 = len(str(F.RUNS)) + 1 + 16 + len(F.SOCK_SUFFIX)
+        with tempfile.TemporaryDirectory(prefix="afu-") as d:
+            def path(n):
+                q = Path(d) / ("p" * (n - len(d) - 1)); self.assertEqual(len(str(q)), n); return str(q)
+            ok = path(r2); srv = socket.socket(socket.AF_UNIX); srv.bind(ok); srv.listen(1)
+            cli = socket.socket(socket.AF_UNIX); cli.connect(ok); cli.close(); srv.close()
+            with socket.socket(socket.AF_UNIX) as s138, self.assertRaises(OSError) as e:
+                s138.connect(path(138))
+            self.assertIn("too long", str(e.exception))
+
