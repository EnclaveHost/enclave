+    if (!fs.statSync(p).isFile() || /\.key$|\.pkcs8$/.test(p)) continue;
+    const t = fs.readFileSync(p, "utf8");
+    for (const k of Object.values(KEYS)) assert.ok(!t.includes(k.slice(2)), `${p} holds a wallet key`);
+  }
