+  const home = fs.mkdtempSync(path.join(tmp, "home-"));
+  return new Promise((resolve) => {
+    const p = spawn(process.execPath, [CLI, "--independent", "--contract-pins", W.pins, "--usdc-token", "0x" + "c3".repeat(20), "--rpc", (rpcs || W.rpcs).join(","),
