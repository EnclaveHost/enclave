+      return new Promise(() => {});
+    }
+    case "gas": {
+      const id = lc(o._[1]); if (!/^0x[0-9a-f]{64}$/.test(id)) throw new Error("gas <deploymentId>");
+      const reader = readerFor(o, pins), snap = await reader.snapshot();
+      const ledger = o.ledger ? lc(o.ledger) : null;
