+  sha256(concatBytes(d(DOMAIN.DEAL), context({ chainId, vault }), fixed(committeeId, 32, "committeeId"), u32(fromEpoch), u32(toEpoch), u32(dealerIndex),
+                     fixed(encKey, 32, "encKey"), commitmentsHash(dealCommitments)));
