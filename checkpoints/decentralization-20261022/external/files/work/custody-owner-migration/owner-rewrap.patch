+    if (!m || !/^0x[0-9a-f]{40}$/.test(lc(m.identity))) throw new Error("join: a machine record is required");
+    const r = await verifyCandidate(body, committeeId);
+    if (!r.ok) throw new Error(`join refused: ${r.reason}`);
