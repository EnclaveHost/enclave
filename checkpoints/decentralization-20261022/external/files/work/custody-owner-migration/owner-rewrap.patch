+//     ],
+//     "minTcb": { "Genoa": { "bootloader": 10, "tee": 0, "snp": 23, "microcode": 84 } },   REQUIRED: no default floor
+//     "vmpl": 0                             the VMPL the release report must come from
+//   }
+//
