+             bundle: { committeeId: lc(bundle[0]), secretRev: bundle[1].toString(), data: lc(bundle[2]) },
+             beneficialOwner: beneficialOwner ? lc(beneficialOwner) : null, source, dest, destCodeActiveAt: Number(destCodeActiveAt),
