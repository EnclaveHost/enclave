+    await Promise.all(com.machines.filter((m) => m.identity !== me.identity).map(async (m) => {
+      try { const i = await fetchJson(`${m.endpoint}/v2/custody/info`); if (i && lc(i.identity) === m.identity) lastSeen.set(m.identity, now()); } catch {}
