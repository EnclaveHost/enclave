+export function sealDeal({ encKey, aadFields, entries }) {
+  return hpke.seal(fixed(encKey, 32, "encKey"), DEAL_INFO, dealAad({ ...aadFields, encKey }), concatBytes(...entries.map(([kk, y]) => concatBytes(u32(kk), scalarToBytes(y)))));
