+/// A binary CID (v0 or v1) -> (codec, multihash). CIDv0 is sha2-256 dag-pb.
+fn cid_parts(b: &[u8]) -> Option<(u64, Vec<u8>)> {
+    if b.len() == 34 && b[0] == 0x12 && b[1] == 0x20 {
+        return Some((CODEC_DAG_PB, b.to_vec()));
+    }
+    let (version, n) = varint_read(b)?;
+    let (codec, m) = varint_read(b.get(n..)?)?;
+    let (mh, len) = cid_multihash(b)?;
+    (version == 1 && len == b.len() && n + m <= b.len()).then_some((codec, mh))
+}
+
+/// The child CIDs (binary) of a dag-pb block: PBNode field 2 (Links), each PBLink field 1 (Hash).
+fn dag_pb_links(block: &[u8]) -> Result<Vec<Vec<u8>>, String> {
+    fn fields(b: &[u8]) -> Result<Vec<(u64, &[u8])>, String> {
+        let mut out = Vec::new();
+        let mut p = 0;
+        while p < b.len() {
+            let (key, n) = varint_read(&b[p..]).ok_or("dag-pb: bad key")?;
+            p += n;
+            match key & 7 {
+                0 => p += varint_read(&b[p..]).ok_or("dag-pb: bad varint")?.1,
+                2 => {
+                    let (len, n) = varint_read(&b[p..]).ok_or("dag-pb: bad length")?;
+                    let end = (p + n).checked_add(len as usize).filter(|e| *e <= b.len()).ok_or("dag-pb: truncated")?;
+                    out.push((key >> 3, &b[p + n..end]));
+                    p = end;
+                }
+                t => return Err(format!("dag-pb: wire type {t}")),
+            }
+        }
+        Ok(out)
+    }
+    let mut links = Vec::new();
+    for (f, link) in fields(block)? {
+        if f == 2 {
+            let hash = fields(link)?.into_iter().find(|(f, _)| *f == 1).ok_or("dag-pb: link without Hash")?.1;
+            links.push(hash.to_vec());
+        }
+    }
+    Ok(links)
+}
+
+/// Whether `block` is the content `mh` names (sha2-256 only, which is all a site DAG uses).
+fn block_matches(mh: &[u8], block: &[u8]) -> bool {
+    mh.len() == 34 && mh[0] == 0x12 && mh[1] == 0x20 && Sha256::digest(block).as_slice() == &mh[2..]
+}
+
+/// An in-progress DAG enumeration: dag-pb nodes still to fetch, multihashes found (DAG order, deduplicated).
+struct Walk {
+    root: Vec<u8>,
+    pending: VecDeque<Vec<u8>>,
+    seen: HashSet<Vec<u8>>,
+    mhs: Vec<Vec<u8>>,
+    fetched: usize,
+}
+
+impl Walk {
+    fn new(root: Vec<u8>) -> Result<Walk, String> {
+        let mut w = Walk { root: root.clone(), pending: VecDeque::new(), seen: HashSet::new(), mhs: Vec::new(), fetched: 0 };
+        w.add(&root)?;
+        Ok(w)
+    }
+    /// Record a CID's multihash; queue it for fetching when it is a dag-pb node.
+    fn add(&mut self, cid: &[u8]) -> Result<(), String> {
+        let (codec, mh) = cid_parts(cid).ok_or("bad CID in DAG")?;
+        if varint_read(&mh).map(|(code, _)| code == 0).unwrap_or(false) || !self.seen.insert(mh.clone()) {
+            return Ok(()); // identity (inline, never fetched) or already counted
+        }
+        if codec != CODEC_DAG_PB && codec != ipni::CODEC_RAW {
+            return Err(format!("unsupported codec 0x{codec:x} in DAG"));
+        }
+        if self.mhs.len() >= MAX_ENTRIES {
+            return Err(format!("more than {MAX_ENTRIES} blocks"));
+        }
+        self.mhs.push(mh.clone());
+        if codec == CODEC_DAG_PB {
+            self.pending.push_back([&[0x01u8, 0x70][..], &mh].concat());
+        }
+        Ok(())
+    }
+    /// Take one fetched dag-pb node (already hash-checked) and queue its links.
+    fn visit(&mut self, block: &[u8]) -> Result<(), String> {
+        self.fetched += 1;
+        for link in dag_pb_links(block)? {
+            self.add(&link)?;
+        }
+        Ok(())
+    }
+}
