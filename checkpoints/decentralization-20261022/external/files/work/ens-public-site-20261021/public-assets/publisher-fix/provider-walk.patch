+    fn walk_offline(root: &[u8], blocks: &HashMap<Vec<u8>, Vec<u8>>) -> Result<Walk, String> {
+        let mut w = Walk::new(root.to_vec())?;
+        while let Some(cid) = w.pending.pop_front() {
+            let b = blocks.get(&cid).ok_or("missing block")?;
+            assert!(block_matches(&mh_of(&cid), b));
+            w.visit(b)?;
+        }
+        Ok(w)
+    }
