+                }
+                let line = String::from_utf8_lossy(&req).lines().next().unwrap_or("").to_string();
+                log2.lock().unwrap().push(line.clone());
+                let path = line.split(' ').nth(1).unwrap_or("");
+                let cid = path.strip_prefix("/ipfs/b").and_then(|r| r.strip_suffix("?format=raw")).and_then(crate::multiformats::base32_decode);
+                let body = match cid.as_ref().and_then(|c| blocks.get(c)) {
+                    Some(b) if cid == lie => [b.as_slice(), b"!"].concat(),
+                    Some(b) => b.clone(),
+                    None => { let _ = s.write_all(b"HTTP/1.1 404 Not Found\r\ncontent-length: 0\r\nconnection: close\r\n\r\n"); continue; }
+                };
+                let _ = s.write_all(format!("HTTP/1.1 200 OK\r\ncontent-type: application/vnd.ipld.raw\r\ncontent-length: {}\r\nconnection: close\r\n\r\n", body.len()).as_bytes());
+                let _ = s.write_all(&body);
+            }
+        });
+        (url, log)
+    }
+    fn provider(gateway: &str, all: bool) -> Provider {
+        Provider::new(SigningKey::from_bytes(&[7u8; 32]), gateway.into(), "https://d9798e4c.app.enclave.host", vec![], all).unwrap()
+    }
+    fn run(p: &mut Provider) { for _ in 0..1000 { if !p.drive() { return; } } panic!("provider never went idle"); }
+    fn entries(p: &Provider) -> Vec<u8> { p.blocks.get(&ad_entries_link(&p.blocks[p.head.as_ref().unwrap()]).unwrap()).unwrap().clone() }
+
+    #[test]
+    fn provider_advertises_every_block_walked_over_the_gateway() {
+        let (root, blocks, all) = tiny_site();
+        let (url, log) = serve(blocks, None);
+        let mut p = provider(&url, true);
+        p.announce_root(root.clone());
+        run(&mut p);
+        assert_eq!((p.block_count, p.advertised_all, p.last_error.clone()), (all.len(), true, None));
+        assert_eq!(entries(&p), ipni::entry_chunk(&all), "breadth-first DAG order");
+        let log = log.lock().unwrap();
+        assert_eq!(log.len(), 4, "one GET per dag-pb node: {log:?}");
+        assert!(log.iter().all(|l| l.starts_with("GET /ipfs/bafybei") && l.contains("?format=raw")), "{log:?}");
+        // the same root again: nothing to do
+        p.announce_root(root);
+        assert!(!p.drive());
+    }
+
+    #[test]
+    fn a_lying_gateway_fails_the_walk_and_a_new_root_is_still_advertised_alone() {
+        let (root, blocks, _) = tiny_site();
+        let (cssd, _) = blocks.iter().find(|(c, b)| c[1] == 0x70 && dag_pb_links(b).map(|l| l.len()) == Ok(1)).unwrap();
+        let (url, _) = serve(blocks.clone(), Some(cssd.clone()));
+        let mut p = provider(&url, true);
+        p.announce_root(root.clone());
+        run(&mut p);
+        assert!(p.last_error.as_deref().unwrap().contains("not b"), "{:?}", p.last_error);
+        assert_eq!((p.block_count, p.advertised_all, p.current_root.clone()), (1, false, Some(root.clone())));
+        assert_eq!(entries(&p), ipni::entry_chunk(&[mh_of(&root)]));
+        // a retry that fails again keeps the existing ad (no chain growth)
+        let head = p.head.clone();
+        p.announce_root(root);
+        run(&mut p);
+        assert_eq!(p.head, head);
+    }
+
+    #[test]
+    fn turning_announce_all_blocks_on_re_advertises_a_root_announced_alone() {
+        let (root, blocks, all) = tiny_site();
+        let (url, _) = serve(blocks, None);
+        let mut p = provider(&url, false);
+        p.announce_root(root.clone());
+        run(&mut p);
+        assert_eq!((p.block_count, p.advertised_all), (1, false));
+        let first = p.head.clone().unwrap();
+        // the redeployed publisher: same state (root + head), announceAllBlocks now true
+        p.announce_all_blocks = true;
+        p.announce_root(root.clone());
+        run(&mut p);
+        assert_eq!((p.block_count, p.advertised_all), (all.len(), true));
+        assert_ne!(p.head.as_ref(), Some(&first));
+        assert_eq!(p.chain.len(), 2, "chained to the root-only ad");
+        // and a publisher that keeps announceAllBlocks false does not churn
+        let mut q = provider(&url, false);
+        q.announce_root(root.clone());
+        run(&mut q);
+        let h = q.head.clone();
+        q.announce_root(root);
+        run(&mut q);
+        assert_eq!(q.head, h);
+    }
 }
