+    // ---- the DAG walk (announceAllBlocks) ----------------------------------
+
+    fn pb_link(cid: &[u8], name: &str) -> Vec<u8> {
+        let mut l = Vec::new();
+        for (tag, v) in [(0x0a, cid), (0x12, name.as_bytes())] {
+            l.push(tag);
+            crate::multiformats::varint(&mut l, v.len() as u64);
+            l.extend_from_slice(v);
+        }
+        l.extend_from_slice(&[0x18, 0x07]); // Tsize (ignored)
+        l
+    }
+    /// A dag-pb node: Links (field 2) then Data (field 1, a UnixFS stub), canonical order.
+    fn pb_node(links: &[(&[u8], &str)]) -> Vec<u8> {
+        let mut b = Vec::new();
+        for (cid, name) in links {
+            let l = pb_link(cid, name);
+            b.push(0x12);
+            crate::multiformats::varint(&mut b, l.len() as u64);
+            b.extend_from_slice(&l);
+        }
+        b.extend_from_slice(&[0x0a, 0x02, 0x08, 0x01]);
+        b
+    }
+    fn mh_of(cid: &[u8]) -> Vec<u8> { cid_parts(cid).unwrap().1 }
+
+    /// root/{index.html, css/site.css, js/{boot.js, big (2 raw chunks)}}: 4 dag-pb nodes, 5 raw leaves, one leaf shared.
+    fn tiny_site() -> (Vec<u8>, HashMap<Vec<u8>, Vec<u8>>, Vec<Vec<u8>>) {
+        let mut blocks = HashMap::new();
+        let mut put = |codec: u64, b: Vec<u8>| { let c = cid_v1(codec, &b); blocks.insert(c.clone(), b); c };
+        let html = put(CODEC_RAW, b"<link rel=stylesheet href=css/site.css>".to_vec());
+        let css = put(CODEC_RAW, b"body{}".to_vec());
+        let boot = put(CODEC_RAW, b"import'./big'".to_vec());
+        let c1 = put(CODEC_RAW, vec![1u8; 300]);
+        let big = put(CODEC_DAG_PB, pb_node(&[(&c1, ""), (&c1, ""), (&css, "")]));
+        let cssd = put(CODEC_DAG_PB, pb_node(&[(&css, "site.css")]));
+        let jsd = put(CODEC_DAG_PB, pb_node(&[(&boot, "boot.js"), (&big, "big")]));
+        let root = put(CODEC_DAG_PB, pb_node(&[(&cssd, "css"), (&html, "index.html"), (&jsd, "js")]));
+        let all = [&root, &cssd, &html, &jsd, &css, &boot, &big, &c1].iter().map(|c| mh_of(c)).collect();
+        (root, blocks, all)
+    }
