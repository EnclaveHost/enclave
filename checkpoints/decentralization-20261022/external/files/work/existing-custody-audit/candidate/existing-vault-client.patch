+    const [e, a] = await Promise.all([call(registry, REG_ABI, "get", [id]), call(hostOwnership, OWN_ABI, "authority", [id])]);
+    hosts[lc(id)] = { registryId: lc(id), operator: lc(e.operator), active: !!e.active, endpoint: e.endpoint, owner: lc(a[0]) };
