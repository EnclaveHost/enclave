+}
+
+// ---------------------------------------------------------------- decisions
+export function policyStatus(policy, nowSec) {
+  if (!policy) return "none";
+  if (policy.expiresAt === 0) return "current";            // anchored non-expiring: the caller has checked the anchor
+  if (nowSec <= policy.expiresAt) return "current";
