+// One constructor for non-custody runtimes (relay, supervisor / measured guest, CLI, Windows host): a platform host
+// policy gate over the shared majority-agreement reader (custody/v2/quorum.mjs) and the HTTPS mirrors.
+//   config: { book, hostOwnership, mirrors: [https...] }  (ENCLAVE_PLATFORM_HOST_POLICY as JSON, or a measured section)
+// Returns { gate, admissions, measured(hostId) } - see network/host-policy-adapters.mjs. Absent config: null (enforcement
+// off, today's behavior). A present but malformed config throws: it never silently disables enforcement.
+import { createPublicClient, http, encodeFunctionData, decodeFunctionResult } from "viem";
+import { createQuorumReader, checkRpcUrls } from "../custody/v2/quorum.mjs";
+import { createPlatformHostGate } from "./platform-host-policy.mjs";
+import { httpPolicyMirrors, validateMirrors } from "./host-policy-mirrors.mjs";
+import { hostAdmissions, measuredHostGate } from "./host-policy-adapters.mjs";
+
+const ADDR = /^0x[0-9a-f]{40}$/;
+export function parseHostPolicyConfig(raw) {
+  if (raw === undefined || raw === null || raw === "") return null;
+  const c = typeof raw === "string" ? JSON.parse(raw) : raw;
+  if (!c || typeof c !== "object" || Object.keys(c).some((k) => !["book", "hostOwnership", "mirrors"].includes(k))) throw Error("platform host policy config: { book, hostOwnership, mirrors }");
+  const book = String(c.book || "").toLowerCase(), hostOwnership = String(c.hostOwnership || "").toLowerCase();
+  if (!ADDR.test(book) || /^0x0{40}$/.test(book) || !ADDR.test(hostOwnership) || /^0x0{40}$/.test(hostOwnership)) throw Error("platform host policy config: book and hostOwnership addresses");
+  return Object.freeze({ book, hostOwnership, mirrors: validateMirrors(c.mirrors) });
+}
+export function createHostPolicyRuntime(config, { rpcs, minAgree, clients = null, store = null, fetch = globalThis.fetch, log = () => {}, ttlMs = 30_000 }) {
+  const cfg = parseHostPolicyConfig(config);
+  if (!cfg) return null;
+  if (!clients) checkRpcUrls(rpcs);
+  const cs = clients || rpcs.map((u) => createPublicClient({ transport: http(u, { timeout: 10_000, retryCount: 0 }) }));
+  const agreed = createQuorumReader({ clients: cs, minAgree: minAgree ?? Math.floor(cs.length / 2) + 1, maxAgeSec: 120 });
+  const snapshot = (fn) => agreed((c, b) => fn({ block: b.blockNumber,
+    call: async (address, abi, functionName, args = []) => decodeFunctionResult({ abi, functionName,
+      data: await c.request({ method: "eth_call", params: [{ to: address, data: encodeFunctionData({ abi, functionName, args }) }, { blockHash: b.blockHash, requireCanonical: true }] }) }),
+    code: (a) => c.request({ method: "eth_getCode", params: [a, { blockHash: b.blockHash, requireCanonical: true }] }) }));
+  const gate = createPlatformHostGate({ book: cfg.book, hostOwnership: cfg.hostOwnership, snapshot, mirrors: httpPolicyMirrors(cfg.mirrors, { fetch }), store, log });
