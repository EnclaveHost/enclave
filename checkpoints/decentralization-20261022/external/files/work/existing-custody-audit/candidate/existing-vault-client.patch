+    const ids = [...new Set(registryIds.map(lc))], out = {}, ask = [];
+    for (const id of ids) { const d = c.get(id); if (d) out[id] = d; else ask.push(id); }
+    if (ask.length) {
+      const r = await decided(gate, () => gate.decide({ registryIds: ask }));
