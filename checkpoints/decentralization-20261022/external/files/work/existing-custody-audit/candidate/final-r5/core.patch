+  const every = Number(intervalMs ?? env.ENCLAVE_PLATFORM_HOST_POLICY_INTERVAL_SEC * 1000) || 60_000;
+  const grace = Number(graceMs ?? env.ENCLAVE_PLATFORM_HOST_POLICY_GRACE_SEC * 1000) || 15 * 60_000;
