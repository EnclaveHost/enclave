+    nsName: 'ns-a.enclave.host', nsNames: ['ns-a.enclave.host'], routeMapUrl: 'http://127.0.0.1:18188/v1/network/routes'};
+  const sources = ['127.0.0.1:18353', '127.0.0.1:31053'];
+  const launched = rd.launch(rd.validate({...base, challengeTxtUpstreams: sources})).env;
+  assert.deepEqual(JSON.parse(launched.CHALLENGE_TXT_UPSTREAMS), sources);
+  assert.ok(!('CHALLENGE_TXT_UPSTREAM' in launched));
+  for (const invalid of [null, [], '127.0.0.1:53', ['host.test:53'], ['127.0.0.1:0'], ['127.0.0.1:99999'],
+    ['127.0.0.1:53', '127.0.0.1:053'], ['[::1]:53', '[0:0:0:0:0:0:0:1]:53'], ['127.0.0.1:18153'],
+    Array.from({length: 5}, (_, i) => `127.0.0.1:${10000+i}`)]) {
+    assert.throws(() => rd.validate({...base, challengeTxtUpstreams: invalid}), /challengeTxtUpstream/);
+  }
+  assert.throws(() => rd.validate({...base, challengeTxtUpstream: sources[0], challengeTxtUpstreams: sources}), /not both/);
+});
+
+test('runtime refuses invalid plural sources and simultaneous singular/plural settings before serving', async () => {
+  for (const extra of [
+    {CHALLENGE_TXT_UPSTREAMS: 'not JSON'},
+    {CHALLENGE_TXT_UPSTREAMS: 'null'},
+    {CHALLENGE_TXT_UPSTREAMS: '[]'},
+    {CHALLENGE_TXT_UPSTREAMS: JSON.stringify(['host.test:53'])},
+    {CHALLENGE_TXT_UPSTREAMS: JSON.stringify(['[::1]:53', '[0:0:0:0:0:0:0:1]:53'])},
+    {CHALLENGE_TXT_UPSTREAMS: JSON.stringify(Array.from({length: 5}, (_, i) => `127.0.0.1:${10000+i}`))},
+    {CHALLENGE_TXT_UPSTREAM: '127.0.0.1:53', CHALLENGE_TXT_UPSTREAMS: '["127.0.0.1:54"]'},
+  ]) {
+    const r = await replica(extra);
+    if (r.child.exitCode === null) await Promise.race([once(r.child, 'exit'), delay(2000)]);
+    assert.equal(r.child.exitCode, 1, r.log());
+    assert.equal(r.health, null, 'invalid configuration never served health');
+    assert.match(r.log(), /fatal:/);
+  }
+});
