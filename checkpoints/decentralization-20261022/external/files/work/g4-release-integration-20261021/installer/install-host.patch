+# What a release OWNS in Program Files\Enclave: its six directories, the pre-.35 tuna\ and the bundle's top-level files. A full
+# install removes exactly these (never the whole folder), so content a release does not own - the host-services runner's
+# installed roles (host-services\hs2) or a persistent role release dir at the top level - survives. Anything INSIDE the six
+# directories is release content and is replaced, so a role's files must not live there (or must be in the manifest).
+function Clear-ReleaseContent($root) {
+  if (-not (Test-Path -LiteralPath $root)) { return }
+  foreach ($d in "runtime", "control", "network", "bin", "guest", "tray", "tuna") { $p = Join-Path $root $d; if (Test-Path -LiteralPath $p) { Remove-Item -LiteralPath $p -Recurse -Force } }
+  foreach ($f in "manifest.json", "uninstall-host.ps1", "update-host.ps1", "EnclaveSetup.exe") { $p = Join-Path $root $f; if (Test-Path -LiteralPath $p) { Remove-Item -LiteralPath $p -Force } }
+}
