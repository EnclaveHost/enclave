+# PRIOR STATE of every \Enclave\ task, recorded before it is stopped: at the end a task is started again only if it was enabled
+# (and, for a task this script does not own, running), and a task the operator disabled stays disabled (Restore-EnclaveTasks)
+function Save-EnclaveTaskState {
+  $prior = @{}
+  foreach ($t in Get-ScheduledTask -TaskPath "\Enclave\" -ErrorAction SilentlyContinue | Where-Object { $_.TaskName -ne "Update" }) {
+    $prior[$t.TaskName] = [ordered]@{ enabled = [bool]$t.Settings.Enabled; running = ([string]$t.State -eq "Running") }
+    Stop-ScheduledTask -TaskPath "\Enclave\" -TaskName $t.TaskName -ErrorAction SilentlyContinue
+  }
+  return $prior
+}
