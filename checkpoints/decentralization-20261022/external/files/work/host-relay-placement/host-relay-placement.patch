+  if (cfg.platformHostPolicy !== "off" && !/^https:\/\/[^\s/?#@]+$/.test(String(cfg.host.endpoint || "").replace(/\/+$/, ""))) fail("host.endpoint: this host's registry endpoint (its PUBLIC_URL) is required to enforce the platform host policy");
