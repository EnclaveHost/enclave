+}
+const ROOT = await makeCa('root');
+await makeCa('int', { issuer: 'root' });
+await makeCa('int-noca', { issuer: 'root', ca: false });
+await makeCa('int-expired', { issuer: 'root', notBefore: Date.now() - 400 * 86400e3, notAfter: Date.now() - 30 * 86400e3 });
