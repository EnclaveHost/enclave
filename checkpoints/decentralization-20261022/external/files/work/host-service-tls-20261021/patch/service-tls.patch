+}
+const stamp = (ms) => new Date(ms).toISOString().replace(/[-:T]/g, '').replace(/\.\d+Z$/, 'Z');
+let serial = 1;
+const DIR = path.join(TMP, 'ca'); fs.mkdirSync(DIR);
