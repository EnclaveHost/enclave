+      console.log(JSON.stringify({ ok: true, platformHostPolicy: c.platformHostPolicy, policyCarriers: usesCarriers(c) ? { ...(c.platformHostPolicyCarriers || {}), ownPolicyMirror: c.services.some((s) => s.role === 'policy-mirror') } : null,
