+  const pin = si.validateIndexPin(cfg.serviceIndex);
+  if (!/^0x[0-9a-fA-F]{40}$/.test(String(operator)) || !Number.isInteger(slot) || !/^[1-9][0-9]*$/.test(String(sequence))) fail('advertise needs --operator 0x…, --slot N and --sequence N (> 0)');
