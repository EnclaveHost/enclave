+func TestCPURate(t *testing.T) {
+	for _, c := range []struct {
+		pct, cpus int
+		want      uint32
+	}{{150, 8, 1875}, {150, 1, 10000}, {150, 64, 234}, {10, 6400, 1}, {100, 0, 10000}} {
+		if got := CPURate(c.pct, c.cpus); got != c.want {
+			t.Errorf("CPURate(%d,%d)=%d want %d", c.pct, c.cpus, got, c.want)
+		}
+	}
+}
