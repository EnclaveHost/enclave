+
+export function base32(bytes) {
+  let out = '', bits = 0, value = 0;
+  for (const b of bytes) { value = (value << 8) | b; bits += 8; while (bits >= 5) { out += ALPHABET[(value >>> (bits - 5)) & 31]; bits -= 5; } value &= 0xff; }
+  if (bits > 0) out += ALPHABET[(value << (5 - bits)) & 31];
