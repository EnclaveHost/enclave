+	// G-C2: the last applied head-advancing v4 operation of the CURRENT generation (cleared by every raise), the
+	// enrolment mode ("cas" or null) and the server's capabilities, so a writer can resolve an unknown outcome and
+	// fail closed on an indexd without cas-v4.
+	LastOp       *OpID     `json:"lastOp"`
+	LastOpDigest *OpDigest `json:"lastOpDigest"`
+	Mode         *string   `json:"mode"`
+	Capabilities []string  `json:"capabilities"`
+	// G-C2 R2: 16 fresh random bytes from the indexer, new in EVERY GET /fence answer and never stored. A writer takes
+	// the op id of a NEW mutation from it (fetched after the invocation starts), so two post-raise copies with copied
+	// RNG state and clocks still send different operations for two different invocations; a retry of ONE invocation
+	// keeps its op. Not part of any hash.
+	OpNonce *OpID `json:"opNonce"`
 }
+
+// Capabilities is what GET /fence advertises ("op-nonce": the answer carries opNonce, G-C2 R2).
+var Capabilities = []string{"fence-v3", "cas-v4", "op-nonce"}
