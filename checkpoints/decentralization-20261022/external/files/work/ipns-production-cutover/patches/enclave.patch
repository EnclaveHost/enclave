ype\":\"address\",\"name\":\"owner_\",\"type\":\"address\"},{\"internalType\":\"address\",\"name\":\"delegate_\",\"type\":\"address\"},{\"internalType\":\"uint64\",\"name\":\"delegateUntil_\",\"type\":\"uint64\"},{\"internalType\":\"bool\",\"name\":\"retired_\",\"type\":\"bool\"},{\"internalType\":\"address\",\"name\":\"successor_\",\"type\":\"address\"}],\"stateMutability\":\"view\",\"type\":\"function\"},{\"inputs\":[],\"name\":\"successor\",\"outputs\":[{\"internalType\":\"address\",\"name\":\"\",\"type\":\"address\"}],\"stateMutability\":\"view\",\"type\":\"function\"},{\"inputs\":[{\"internalType\":\"address\",\"name\":\"to\",\"type\":\"address\"}],\"name\":\"transferOwnership\",\"outputs\":[],\"stateMutability\":\"nonpayable\",\"type\":\"function\"}],\"devdoc\":{\"details\":\"Immutable by construction: no proxy, no delegatecall, no selfdestruct. `nameHash` is an immutable, so it      is part of the runtime code and the publisher's pinned codehash covers it.\",\"kind\":\"dev\",\"methods\":{},\"title\":\"ReleaseAnchor \\u2014 the on-chain authority for one IPNS name's site release.\",\"version\":1},\"userdoc\":{\"kind\":\"user\",\"methods\":{\"acceptOwnership()\":{\"notice\":\"The new owner starts with no delegate: an appointment never outlives the owner who made it.\"},\"nameHash()\":{\"notice\":\"keccak256 of the IPNS name's peer multihash bytes (identity multihash of the ed25519 public key protobuf).\"},\"pin(string)\":{\"notice\":\"Owner override: a new release AND no delegate, in one transaction. No CAS, so a racing delegate cannot block it.\"},\"publish(string,uint64)\":{\"notice\":\"The delegate's (and the owner's) release call. The compare-and-swap makes a stale or replayed transaction fail.\"},\"retire(address)\":{\"notice\":\"Freeze forever. `successor` is a pointer for humans; publishers never follow it without a new owner config.\"},\"setDelegate(address,uint64)\":{\"notice\":\"Appoint (bounded in time) or revoke (d = 0, until = 0) the delegate.\"},\"state()\":{\"notice\":\"Everything the publisher needs, read atomically at one block.\"},\"transferOwnership(address)\":{\"notice\":\"Two-step transfer; `to = 0` cancels a pending one.\"}},\"notice\":\"The ipns-publisher reads `state()` through a quorum of RPC endpoints at one agreed block and publishes         /ipfs/<cid> at IPNS sequence `sequenceOffset + seq`. The owner appoints a delegate whose only power is         publish(cid, expectedSeq): it cannot touch the publisher's config, secrets or key, the owner, or itself.         The owner's pin() always wins and revokes the delegate in the same transaction.\",\"version\":1}},\"settings\":{\"compilationTarget\":{\"src/ReleaseAnchor.sol\":\"ReleaseAnchor\"},\"evmVersion\":\"osaka\",\"libraries\":{},\"metadata\":{\"appendCBOR\":false,\"bytecodeHash\":\"none\"},\"optimizer\":{\"enabled\":true,\"runs\":200},\"remappings\":[]},\"sources\":{\"src/ReleaseAnchor.sol\":{\"keccak256\":\"0xfd351737a0bb30175f51189c26756bbd4c0e6d0ea9ae9c3cb67aeaa480711f87\",\"license\":\"MIT\",\"urls\":[\"bzz-raw://14bada5a667cc71278bf19358c1d97e8b2f5f2a7faa7add98d0c2fae24ae9a72\",\"dweb:/ipfs/QmXp79isn4EqYBSNG7ayCpHR4peSbbYyKcieTjBo3WMhGn\"]}},\"version\":1}","metadata":{"compiler":{"version":"0.8.35+commit.47b9dedd"},"language":"Solidity","output":{"abi":[{"inputs":[{"internalType":"address","name":"owner_","type":"address"},{"internalType":"bytes32","name":"nameHash_","type":"bytes32"},{"internalType":"string","name":"cid_","type":"string"}],"stateMutability":"nonpayable","type":"constructor"},{"inputs":[],"type":"error","name":"BadCid"},{"inputs":[],"type":"error","name":"BadDelegation"},{"inputs":[],"type":"error","name":"BadName"},{"inputs":[],"type":"error","name":"IsRetired"},{"inputs":[],"type":"error","name":"NotAuthorized"},{"inputs":[],"type":"error","name":"NotOwner"},{"inputs":[],"type":"error","name":"NotPendingOwner"},{"inputs":[{"internalType":"uint64","name":"expected","type":"uint64"},{"internalType":"uint64","name":"current