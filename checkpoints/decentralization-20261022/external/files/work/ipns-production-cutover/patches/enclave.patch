diff --git a/tools/ipns-cutover/lib/anchor-build.mjs b/tools/ipns-cutover/lib/anchor-build.mjs
new file mode 100644
index 0000000..8ede63c
--- /dev/null
+++ b/tools/ipns-cutover/lib/anchor-build.mjs
@@ -0,0 +1,77 @@
+// The reviewed ReleaseAnchor build (frozen: work/ipns-release-anchor/out) as a deterministic CREATE2 deployment, and
+// the IPNS name -> nameHash derivation from the PUBLIC name (no key needed).
+import { createHash } from "node:crypto";
+import { readFileSync } from "node:fs";
+import { join } from "node:path";
+import { viem } from "./chain.mjs";
+import { ANCHOR } from "./paths.mjs";
+
+export const ANCHOR_DIR = ANCHOR;
+const ARTIFACT = join(ANCHOR_DIR, "out/ReleaseAnchor.sol/ReleaseAnchor.json");
+const SOURCE = join(ANCHOR_DIR, "src/ReleaseAnchor.sol");
+// the hashes the frozen candidate was tested and reported at (work/claude-ipns-anchor-result.md)
+export const REVIEWED = {
+  sourceSha256: "50f9710f8166e89f762d03eb869a06c303e5af8c270e2b975fafffc11776012c",
+  artifactSha256: "f592eb23ad60d6b21b7a449b350f4d987f828237ba2cf5d941631b307a56d3b2",
+};
+const sha256 = (b) => createHash("sha256").update(b).digest("hex");
+
+const B36 = "0123456789abcdefghijklmnopqrstuvwxyz";
+function varint(buf, i) {
+  let v = 0, s = 0;
+  for (;;) { const b = buf[i++]; if (b === undefined) throw new Error("truncated varint"); v += (b & 0x7f) * 2 ** s; s += 7; if (!(b & 0x80)) return [v, i]; }
+}
+/** k51… (CIDv1, libp2p-key, base36) -> the identity multihash bytes of the public key (the "peer multihash"). */
+export function peerMultihash(name) {
+  if (!/^k[0-9a-z]+$/.test(name)) throw new Error("expected a base36 (k…) IPNS name");
+  let n = 0n;
+  for (const c of name.slice(1)) n = n * 36n + BigInt(B36.indexOf(c));
+  let hex = n.toString(16);
+  if (hex.length % 2) hex = "0" + hex;
+  const bytes = Buffer.from(hex, "hex");
+  let [version, i] = varint(bytes, 0);
+  let codec;
+  [codec, i] = varint(bytes, i);
+  if (version !== 1 || codec !== 0x72) throw new Error("not a CIDv1 libp2p-key");
+  const mh = bytes.subarray(i);
+  const [code, j] = varint(mh, 0);
+  const [len, k] = varint(mh, j);
+  if (code !== 0x00 || len !== mh.length - k) throw new Error("not an identity multihash");
+  return mh;
+}
+export const nameHash = (name) => viem.keccak256(peerMultihash(name));
+
+/** The frozen artifact, refused unless it is byte-identical to the reviewed one. */
+export function artifact() {
+  const raw = readFileSync(ARTIFACT);
+  const src = readFileSync(SOURCE);
+  if (sha256(raw) !== REVIEWED.artifactSha256 || sha256(src) !== REVIEWED.sourceSha256)
+    throw new Error("work/ipns-release-anchor out/ or src/ differs from the reviewed build");
+  return JSON.parse(raw);
+}
+
+const CTOR = [{ type: "address" }, { type: "bytes32" }, { type: "string" }];
+export const ANCHOR_ABI = viem.parseAbi([
+  "function state() view returns (bytes32 schema, bytes32 nameHash, uint64 seq, string cid, address owner, address delegate, uint64 delegateUntil, bool retired, address successor)",
+  "function publish(string cid, uint64 expectedSeq)",
+  "function pin(string cid)",
+  "function setDelegate(address d, uint64 until)",
+  "function retire(address successor)",
+]);
+
+/** Everything about one anchor deployment, computed offline. */
+export function anchorDeployment({ deployer, salt, owner, nameHash: nh, cid }) {
+  const art = artifact();
+  const initcode = viem.concat([art.bytecode.object, viem.encodeAbiParameters(CTOR, [owner, nh, cid])]);
+  const address = viem.getContractAddress({ opcode: "CREATE2", from: deployer, salt, bytecode: initcode });
+  const runtime = Buffer.from(art.deployedBytecode.object.slice(2), "hex");
+  const refs = Object.values(art.deployedBytecode.immutableReferences);
+  if (refs.length !== 1) throw new Error("expected exactly one immutable");
+  for (const { start } of refs[0]) Buffer.from(nh.slice(2), "hex").copy(runtime, start);
+  return {
+    address, salt, initcode, initcodeHash: viem.keccak256(initcode),
+    deployCalldata: viem.concat([salt, initcode]),
+    runtimeHex: "0x" + runtime.toString("hex"), codeHash: viem.keccak256(runtime), runtimeBytes: runtime.length,
+    build: { ...REVIEWED, compiler: art.metadata?.compiler?.version ?? null },
+  };
+}
diff --git a/tools/ipns-cutover/probe/rpc-probe.mjs b/tools/ipns-cutover/probe/rpc-probe.mjs
new file mode 100644
index 0000000..d5acfde
--- /dev/null
+++ b/tools/ipns-cutover/probe/rpc-probe.mjs
@@ -0,0 +1,110 @@
+#!/usr/bin/env node
+// Read-only compatibility probe of the owner-chosen public Base RPCs, with plain Node HTTPS (not the wasm path):
+// chain identity, heads, agreement on one block, EIP-1898 reads ({blockHash, requireCanonical}) of a pinned contract's
+// code and state, and the refusal of an unknown blockHash (a provider that answered it from "latest" would break
+// hash-bound authority). No keys, no transactions.
+//
+//   node probe/rpc-probe.mjs [--profile FILE] [--out FILE] [--confirmations N]
+import { readFileSync, writeFileSync } from "node:fs";
+import { createRequire } from "node:module";
+import { dirname, join } from "node:path";
+import { fileURLToPath } from "node:url";
+
+import { REPO, WORKSPACE_PROFILE } from "../lib/paths.mjs";
+const WS = join(dirname(fileURLToPath(import.meta.url)), "../../..");
+const require = createRequire(join(REPO, "package.json"));
+const { keccak256 } = require("viem");
+
+const argv = process.argv.slice(2);
+const arg = (k, d) => (argv.includes(k) ? argv[argv.indexOf(k) + 1] : d);
+const profilePath = arg("--profile", WORKSPACE_PROFILE);
+const profile = JSON.parse(readFileSync(profilePath, "utf8"));
+const CONF = Number(arg("--confirmations", "6"));
+const ledger = profile.contracts.deployments;
+const SCHEMA_SEL = keccak256(new TextEncoder().encode("deploymentsSchema()")).slice(0, 10);
+
+let id = 1;
+async function call(url, method, params) {
+  const t0 = Date.now();
+  try {
+    const r = await fetch(url, {
+      method: "POST",
+      headers: { "content-type": "application/json", accept: "application/json" },
+      body: JSON.stringify({ jsonrpc: "2.0", id: id++, method, params }),
+      signal: AbortSignal.timeout(15_000),
+    });
+    const text = await r.text();
+    let j;
+    try { j = JSON.parse(text); } catch { return { ok: false, ms: Date.now() - t0, http: r.status, error: `non-JSON (${text.slice(0, 80)})` }; }
+    if (j.error) return { ok: false, ms: Date.now() - t0, http: r.status, error: `${j.error.code}: ${String(j.error.message).slice(0, 160)}` };
+    return { ok: true, ms: Date.now() - t0, http: r.status, result: j.result };
+  } catch (e) {
+    return { ok: false, ms: Date.now() - t0, error: String(e?.cause?.code ?? e?.message ?? e).slice(0, 160) };
+  }
+}
+
+const hosts = profile.review.rpcHosts;
+const out = { kind: "rpc-probe", path: "native-node-https (fetch/undici, OS resolver, direct TCP; NOT wasm, NOT fleet SOCKS)",
+  profile: { file: profilePath.replace(WS + "/", ""), chainId: profile.chainId, rpcHosts: hosts },
+  pinned: { contract: "deployments", address: ledger.address, codeHash: ledger.codeHash, expectSchema: ledger.immutable.deploymentsSchema },
+  confirmations: CONF, startedAt: new Date().toISOString(), providers: {} };
+
+// A. identity and heads
+for (const h of hosts) {
+  const url = `https://${h}`;
+  const p = (out.providers[h] = { url });
+  p.chainId = await call(url, "eth_chainId", []);
+  p.head = await call(url, "eth_blockNumber", []);
+  p.clientVersion = await call(url, "web3_clientVersion", []);
+}
+const heads = hosts.map((h) => out.providers[h].head).filter((x) => x.ok).map((x) => Number(BigInt(x.result))).sort((a, b) => b - a);
+out.heads = heads;
+const k = 2;
+const target = heads.length >= k ? heads[k - 1] - CONF : null;
+out.target = target;
+
+// B. agreement on the target block; C. EIP-1898 reads by its hash
+const blocks = {};
+for (const h of hosts) {
+  const p = out.providers[h];
+  if (target == null) break;
+  const b = await call(p.url, "eth_getBlockByNumber", ["0x" + target.toString(16), false]);
+  p.block = b.ok && b.result ? { ok: true, ms: b.ms, number: Number(BigInt(b.result.number)), hash: b.result.hash, timestamp: Number(BigInt(b.result.timestamp)) } : b;
+  if (p.block.ok) blocks[p.block.hash] = (blocks[p.block.hash] ?? 0) + 1;
+}
+out.blockAgreement = blocks;
+const agreed = Object.entries(blocks).find(([, n]) => n >= k)?.[0] ?? null;
+out.agreedHash = agreed;
+for (const h of hosts) {
+  const p = out.providers[h];
+  if (!agreed) break;
+  const at = { blockHash: agreed, requireCanonical: true };
+  const code = await call(p.url, "eth_getCode", [ledger.address, at]);
+  p.codeByHash = code.ok ? { ok: true, ms: code.ms, bytes: (code.result.length - 2) / 2, codeHash: keccak256(code.result), matchesPin: keccak256(code.result) === ledger.codeHash } : code;
+  const st = await call(p.url, "eth_call", [{ to: ledger.address, data: SCHEMA_SEL }, at]);
+  p.callByHash = st.ok ? { ok: true, ms: st.ms, deploymentsSchema: Number(BigInt(st.result)) } : st;
+  // the same call without requireCanonical (plain EIP-1898 hash form)
+  const st2 = await call(p.url, "eth_call", [{ to: ledger.address, data: SCHEMA_SEL }, { blockHash: agreed }]);
+  p.callByHashNoCanonicalFlag = st2.ok ? { ok: true, deploymentsSchema: Number(BigInt(st2.result)) } : st2;
+  // an unknown block hash MUST be refused, not answered from latest
+  const bogus = "0x" + "ab".repeat(32);
+  const neg = await call(p.url, "eth_call", [{ to: ledger.address, data: SCHEMA_SEL }, { blockHash: bogus, requireCanonical: true }]);
+  // only a "no such block" answer counts as the refusal; a rate limit or transport error proves nothing
+  const notFound = (e) => /block not found|unknown block|header not found|not found/i.test(e ?? "");
+  p.unknownHashRefused = neg.ok ? { refused: false, answered: neg.result } : { refused: notFound(neg.error), error: neg.error };
+  const negCode = await call(p.url, "eth_getCode", [ledger.address, { blockHash: bogus, requireCanonical: true }]);
+  p.unknownHashCodeRefused = negCode.ok ? { refused: false, answeredBytes: (negCode.result.length - 2) / 2 } : { refused: notFound(negCode.error), error: negCode.error };
+}
+out.finishedAt = new Date().toISOString();
+const ends = Math.floor(Date.now() / 1000);
+const ts = Object.values(out.providers).find((p) => p.block?.ok && p.block.hash === agreed)?.block.timestamp;
+out.agreedBlockAgeAtEndSecs = ts ? ends - ts : null;
+out.verdict = Object.fromEntries(hosts.map((h) => {
+  const p = out.providers[h];
+  const ok = p.chainId.ok && Number(BigInt(p.chainId.result)) === profile.chainId && p.block?.ok && p.block.hash === agreed &&
+    p.codeByHash?.matchesPin && p.callByHash?.deploymentsSchema === Number(ledger.immutable.deploymentsSchema) && p.unknownHashRefused?.refused && p.unknownHashCodeRefused?.refused;
+  return [h, ok ? "compatible" : "NOT compatible"];
+}));
+const file = arg("--out", null);
+if (file) writeFileSync(file, JSON.stringify(out, null, 2) + "\n");
+console.log(JSON.stringify(out, null, 2));
diff --git a/tools/ipns-cutover/probe/wasm-probe.mjs b/tools/ipns-cutover/probe/wasm-probe.mjs
new file mode 100644
index 0000000..d3eddcc
--- /dev/null
+++ b/tools/ipns-cutover/probe/wasm-probe.mjs
@@ -0,0 +1,134 @@
+#!/usr/bin/env node
+// The actual ipns-publisher wasm component's anchor reader (src/anchor.rs over src/webreq.rs + rustls) against the
+// owner-chosen PUBLIC Base RPCs, read-only. No ReleaseAnchor exists on Base yet, so the probe points `releaseAnchor` at
+// a pinned, existing contract (the deployments ledger, codeHash from the owner profile): a round then exercises chain
+// identity, heads, quorum agreement on one block and eth_getCode BY THAT BLOCK HASH (keccak checked in wasm against
+// the pin), and stops at eth_call(state()) by the same hash, which the ledger reverts (it has no state()). With a
+// wrong codeHash pin the round must refuse every endpoint on the code hash instead.
+//
+// Three runs: (1) wasmtime with host sockets (-Sinherit-network; the local path, not the fleet), (2) the same with a
+// wrong pin, (3) through a LOOPBACK SOCKS5 front speaking the fleet egress protocol (user/pass, ATYP DOMAIN), which
+// exercises src/egress.rs socks_connect: the code path a fleet deployment uses, not the fleet's own front.
+// The probe key is random, there are no delegates and no DHT: nothing can be published anywhere.
+import { spawn, execFileSync } from "node:child_process";
+import { randomBytes } from "node:crypto";
+import { readFileSync, writeFileSync, mkdtempSync, rmSync } from "node:fs";
+import net from "node:net";
+import { tmpdir } from "node:os";
+import { dirname, join } from "node:path";
+import { fileURLToPath } from "node:url";
+
+import { PUBLISHER_WASM, WORKSPACE_PROFILE } from "../lib/paths.mjs";
+const WS = join(dirname(fileURLToPath(import.meta.url)), "../../..");
+const WASM = PUBLISHER_WASM;
+const profile = JSON.parse(readFileSync(process.env.AUTHORITY_PROFILE ?? WORKSPACE_PROFILE, "utf8"));
+const ledger = profile.contracts.deployments;
+const TMP = mkdtempSync(join(tmpdir(), "wasm-probe-"));
+const CWASM = join(TMP, "p.cwasm");
+const sleep = (ms) => new Promise((r) => setTimeout(r, ms));
+
+function freePort() {
+  return new Promise((res) => { const s = net.createServer().listen(0, "127.0.0.1", () => { const p = s.address().port; s.close(() => res(p)); }); });
+}
+
+/** A minimal SOCKS5 front: user/pass auth (RFC 1929) then CONNECT, logging each target; pipes to the real host. */
+function socksFront(log) {
+  return new Promise((resolve) => {
+    const srv = net.createServer((c) => {
+      let buf = Buffer.alloc(0), stage = 0;
+      const onData = (d) => {
+        buf = Buffer.concat([buf, d]);
+        if (stage === 0 && buf.length >= 3) { // greeting
+          const n = buf[1];
+          if (buf.length < 2 + n) return;
+          const methods = [...buf.subarray(2, 2 + n)];
+          buf = buf.subarray(2 + n);
+          if (!methods.includes(2)) { c.end(Buffer.from([5, 0xff])); return; }
+          c.write(Buffer.from([5, 2])); stage = 1;
+        }
+        if (stage === 1 && buf.length >= 2) { // user/pass
+          const ul = buf[1]; if (buf.length < 3 + ul) return;
+          const pl = buf[2 + ul]; if (buf.length < 3 + ul + pl) return;
+          const user = buf.subarray(2, 2 + ul).toString();
+          buf = buf.subarray(3 + ul + pl);
+          c.write(Buffer.from([1, user === "probe" ? 0 : 1])); stage = 2;
+        }
+        if (stage === 2 && buf.length >= 5) { // CONNECT
+          const atyp = buf[3];
+          let host, off;
+          if (atyp === 3) { const l = buf[4]; if (buf.length < 5 + l + 2) return; host = buf.subarray(5, 5 + l).toString(); off = 5 + l; }
+          else if (atyp === 1) { if (buf.length < 10) return; host = [...buf.subarray(4, 8)].join("."); off = 8; }
+          else { c.destroy(); return; }
+          const port = buf.readUInt16BE(off);
+          const rest = buf.subarray(off + 2);
+          log.push({ atyp: atyp === 3 ? "DOMAIN" : "IPv4", host, port });
+          stage = 3;
+          c.removeListener("data", onData);
+          const up = net.connect(port, host, () => {
+            c.write(Buffer.from([5, 0, 0, 1, 0, 0, 0, 0, 0, 0]));
+            if (rest.length) up.write(rest);
+            c.pipe(up); up.pipe(c);
+          });
+          up.on("error", () => { c.end(Buffer.from([5, 4, 0, 1, 0, 0, 0, 0, 0, 0])); });
+          c.on("error", () => up.destroy());
+        }
+      };
+      c.on("data", onData);
+      c.on("error", () => {});
+    }).listen(0, "127.0.0.1", () => resolve(srv));
+  });
+}
+
+async function run(label, { codeHash, egress }) {
+  const port = await freePort();
+  const cfg = {
+    ipnsKey: randomBytes(32).toString("hex"), delegates: [], dht: false, lifetimeSecs: 172800,
+    releaseAnchor: {
+      chainId: profile.chainId, contract: ledger.address, codeHash,
+      rpcs: profile.review.rpcHosts.map((h) => `https://${h}`), quorum: 2, confirmations: 6,
+      maxBlockAgeSecs: 120, authorityTtlSecs: 43200, pollSecs: 120, sequenceOffset: 0, rpcTimeoutSecs: 10,
+    },
+  };
+  const args = ["run", "-Scli", "-Stcp", "-Sinherit-network", "-Sallow-ip-name-lookup",
+    "--env", `ENCLAVE_PORTS=http:8000=${port}`, "--env", `IPNSPUB_CONFIG=${JSON.stringify(cfg)}`];
+  if (egress) args.push("--env", `ENCLAVE_EGRESS=${egress}`);
+  args.push("--allow-precompiled", CWASM);
+  const logFile = join(TMP, `${label}.log`);
+  const chunks = [];
+  const p = spawn("wasmtime", args, { stdio: ["ignore", "pipe", "pipe"] });
+  p.stdout.on("data", (d) => chunks.push(d)); p.stderr.on("data", (d) => chunks.push(d));
+  const t0 = Date.now();
+  let s = null;
+  try {
+    for (let i = 0; i < 240; i++) {
+      await sleep(250);
+      try {
+        s = await (await fetch(`http://127.0.0.1:${port}/api/status`)).json();
+        if (s.anchor.roundsOk + s.anchor.roundsFailed >= 1) break;
+      } catch {}
+    }
+  } finally { p.kill("SIGKILL"); }
+  const log = Buffer.concat(chunks).toString();
+  writeFileSync(logFile, log);
+  return {
+    label, roundSecs: (Date.now() - t0) / 1000, egress: egress ? "loopback SOCKS5 front (fleet egress protocol)" : "host sockets (wasmtime -Sinherit-network)",
+    authorityMode: s?.authorityMode, roundsOk: s?.anchor.roundsOk, roundsFailed: s?.anchor.roundsFailed, lastError: s?.anchor.lastError,
+    endpoints: s?.anchor.endpoints, publishedAt: s?.publishedAt, logTail: log.trim().split("\n").filter((l) => /anchor/.test(l)).slice(-3),
+  };
+}
+
+const out = { kind: "wasm-probe", wasm: WASM.replace(WS + "/", ""), wasmSha256: execFileSync("sha256sum", [WASM], { encoding: "utf8" }).split(" ")[0],
+  wasmtime: execFileSync("wasmtime", ["--version"], { encoding: "utf8" }).trim(), contract: ledger.address, codeHash: ledger.codeHash,
+  rpcs: profile.review.rpcHosts, startedAt: new Date().toISOString(), runs: [] };
+execFileSync("wasmtime", ["compile", WASM, "-o", CWASM]);
+out.runs.push(await run("native-sockets", { codeHash: ledger.codeHash }));
+out.runs.push(await run("wrong-pin", { codeHash: "0x" + "00".repeat(31) + "01" }));
+const connects = [];
+const front = await socksFront(connects);
+out.runs.push({ ...(await run("socks-front", { codeHash: ledger.codeHash, egress: `socks5://probe:token@127.0.0.1:${front.address().port}` })), socksConnects: connects });
+front.close();
+out.finishedAt = new Date().toISOString();
+rmSync(TMP, { recursive: true, force: true });
+const file = process.argv[2];
+if (file) writeFileSync(file, JSON.stringify(out, null, 2) + "\n");
+console.log(JSON.stringify(out, null, 2));
diff --git a/tools/ipns-cutover/probe/production-read.mjs b/tools/ipns-cutover/probe/production-read.mjs
new file mode 100644
index 0000000..dea503a
--- /dev/null
+++ b/tools/ipns-cutover/probe/production-read.mjs
@@ -0,0 +1,157 @@
+#!/usr/bin/env node
+// Public, read-only state of the production ipns-publisher: the deployment record, its catalog version and config
+// commitment through agreed reads (lib/chain.mjs Quorum, one blockHash), the publisher's own status, and every
+// reachable copy of the IPNS record, each verified against the name by kubo (`ipfs name inspect --verify`, offline).
+// Secrets: the envelope may carry config values; it is hashed (the commitment) and only a redacted form is stored.
+// The highest sequence SEEN here is a floor for what exists, never a proof that nothing higher was ever signed.
+//
+//   node probe/production-read.mjs [--out FILE] [--dht]
+import { execFileSync, spawn } from "node:child_process";
+import { createHash } from "node:crypto";
+import { mkdtempSync, readFileSync, rmSync, writeFileSync } from "node:fs";
+import { tmpdir } from "node:os";
+import { dirname, join } from "node:path";
+import { fileURLToPath } from "node:url";
+import { Quorum, redactConfig, viem } from "../lib/chain.mjs";
+import { ABI, PRODUCTION } from "../lib/production.mjs";
+
+import { ANCHOR, WORKSPACE_PROFILE } from "../lib/paths.mjs";
+const WS = join(dirname(fileURLToPath(import.meta.url)), "../../..");
+const argv = process.argv.slice(2);
+const outFile = argv.includes("--out") ? argv[argv.indexOf("--out") + 1] : null;
+const profile = JSON.parse(readFileSync(argv.includes("--profile") ? argv[argv.indexOf("--profile") + 1] : WORKSPACE_PROFILE, "utf8"));
+const sha256 = (b) => createHash("sha256").update(b).digest("hex");
+
+const out = { kind: "production-read", capturedAt: new Date().toISOString(), production: PRODUCTION };
+
+// ---- chain: one agreed block for every read --------------------------------------------------------------------
+const q = new Quorum({ rpcs: profile.review.rpcHosts.map((h) => `https://${h}`), chainId: profile.chainId, quorum: 2, confirmations: 6, maxBlockAgeSecs: 120 });
+await q.block();
+const ledger = profile.contracts.deployments.address;
+const catalog = profile.contracts.appCatalog.address;
+const ledgerCode = await q.code(ledger);
+const catalogCode = await q.code(catalog);
+const schema = Number(await q.read(ledger, ABI.ledger, "deploymentsSchema"));
+const d = await q.read(ledger, ABI.ledger, "get", [PRODUCTION.deployment]);
+const catSchema = Number(await q.read(catalog, ABI.catalog, "catalogSchema"));
+const m = /^catalog:\/\/(0x[0-9a-fA-F]{64})\/(\d{1,9})$/.exec(d.appRef);
+let version = null, app = null, versionConfigCid = null;
+if (m) {
+  const [v] = await q.read(catalog, catSchema >= 4 ? ABI.catalogV3 : ABI.catalog, "getVersionsPage", [m[1], BigInt(m[2]), 1n]);
+  version = v;
+  if (catSchema >= 7) versionConfigCid = await q.read(catalog, ABI.catalog, "versionConfigCid", [m[1], BigInt(m[2])]);
+  app = { appId: m[1], index: Number(m[2]), numVersions: Number(await q.read(catalog, ABI.catalog, "numVersions", [m[1]])) };
+}
+const ownerCode = await q.code(d.owner);
+const ownerNonce = await q.nonce(d.owner);
+const ownerBalance = await q.balance(d.owner);
+const createCode = await q.code(PRODUCTION.create2Deployer);
+out.chain = q.close();
+out.chain.codeHashes = {
+  deployments: { observed: viem.keccak256(ledgerCode), pinned: profile.contracts.deployments.codeHash },
+  appCatalog: { observed: viem.keccak256(catalogCode), pinned: profile.contracts.appCatalog.codeHash },
+  create2Deployer: { address: PRODUCTION.create2Deployer, observed: createCode === "0x" ? null : viem.keccak256(createCode), expected: PRODUCTION.create2DeployerCodeHash },
+};
+out.chain.deploymentsSchema = schema;
+out.chain.catalogSchema = catSchema;
+
+let envelope = String(d.configCid ?? "");
+let parsed = null;
+try { parsed = envelope.trim().startsWith("{") ? JSON.parse(envelope) : null; } catch {}
+out.deployment = {
+  id: PRODUCTION.deployment, owner: d.owner, ownerIsContract: ownerCode !== "0x", ownerNonce, ownerBalanceWei: String(ownerBalance),
+  appRef: d.appRef, active: d.active, isPublic: d.isPublic, appPort: Number(d.appPort), cpuMilli: Number(d.cpuMilli), gpuMilli: Number(d.gpuMilli),
+  createdAt: Number(d.createdAt), leaseUntil: Number(d.leaseUntil), runner: d.runner, runnerOperator: d.runnerOperator,
+  balance6: String(d.balance6), rate: String(d.rate),
+  envelope: {
+    commitmentSha256: sha256(Buffer.from(envelope, "utf8")), bytes: Buffer.byteLength(envelope),
+    namespaces: parsed ? Object.keys(parsed) : null,
+    configCid: parsed?.configCid ?? null,
+    guestBootstrapSha256: parsed?.guestBootstrap?.sha256 ?? null,
+    configRedacted: parsed?.config ? redactConfig(parsed.config) : null,
+    waf: parsed?.waf ?? null,
+  },
+};
+envelope = null; // never stored raw
+out.version = version && {
+  ...app, cid: version.cid, version: version.version, approval: Number(version.approval), yanked: version.yanked, verified: version.verified,
+  memMb: Number(version.memMb), ports: version.ports, createdAt: Number(version.createdAt),
+  configSha256: version.config ? sha256(Buffer.from(version.config, "utf8")) : null,
+  configRedacted: (() => { try { return version.config ? redactConfig(JSON.parse(version.config)) : null; } catch { return "unparseable"; } })(),
+  versionConfigCid,
+};
+
+// ---- the publisher's own report (self-reported, not authority) --------------------------------------------------
+try {
+  const r = await fetch(`${PRODUCTION.publisherUrl}/api/status`, { signal: AbortSignal.timeout(20_000) });
+  const s = await r.json();
+  out.publisherStatus = { http: r.status, ...s };
+} catch (e) { out.publisherStatus = { error: String(e.message ?? e) }; }
+
+// ---- every reachable IPNS record, verified against the name ---------------------------------------------------
+const repo = mkdtempSync(join(tmpdir(), "prodread-kubo-"));
+const env = { ...process.env, IPFS_PATH: join(repo, "kubo") };
+execFileSync("ipfs", ["init", "--profile=test"], { env, stdio: "ignore" });
+function inspect(bytes) {
+  const j = JSON.parse(execFileSync("ipfs", ["name", "inspect", "--enc=json", "--dump=false", "--verify", PRODUCTION.name], { env, input: bytes }).toString());
+  return { valid: j.Validation?.Valid === true, sequence: j.Entry?.Sequence, value: j.Entry?.Value, validity: j.Entry?.Validity, ttlSecs: Number(j.Entry?.TTL) / 1e9, signatureType: j.SignatureType, bytes: bytes.length, sha256: sha256(bytes) };
+}
+const sources = {
+  publisher: `${PRODUCTION.publisherUrl}/routing/v1/ipns/${PRODUCTION.name}`,
+  "delegated-ipfs.dev": `https://delegated-ipfs.dev/routing/v1/ipns/${PRODUCTION.name}`,
+  "ipfs.io": `https://ipfs.io/ipns/${PRODUCTION.name}?format=ipns-record`,
+  "dweb.link": `https://dweb.link/ipns/${PRODUCTION.name}?format=ipns-record`,
+  "trustless-gateway.link": `https://trustless-gateway.link/ipns/${PRODUCTION.name}?format=ipns-record`,
+  "w3s.link": `https://w3s.link/ipns/${PRODUCTION.name}?format=ipns-record`,
+  "4everland.io": `https://4everland.io/ipns/${PRODUCTION.name}?format=ipns-record`,
+  "ipfs.enclave.host (Enclave origin)": `https://ipfs.enclave.host/ipns/${PRODUCTION.name}?format=ipns-record`,
+};
+out.records = {};
+for (const [k, url] of Object.entries(sources)) {
+  try {
+    const r = await fetch(url, { headers: { accept: "application/vnd.ipfs.ipns-record" }, signal: AbortSignal.timeout(30_000) });
+    const b = Buffer.from(await r.arrayBuffer());
+    out.records[k] = r.status === 200 ? { http: 200, ...inspect(b) } : { http: r.status, body: b.toString().slice(0, 120) };
+  } catch (e) { out.records[k] = { error: String(e.message ?? e).slice(0, 160) }; }
+}
+if (argv.includes("--dht")) {
+  // a fresh, empty DHT client: one more independent vantage point (read-only GET_VALUE walk)
+  execFileSync("ipfs", ["config", "Routing.Type", "dhtclient"], { env });
+  execFileSync("ipfs", ["config", "--json", "Addresses.API", '"/ip4/127.0.0.1/tcp/0"'], { env });
+  execFileSync("ipfs", ["config", "--json", "Addresses.Gateway", "[]"], { env });
+  execFileSync("ipfs", ["config", "--json", "Swarm.ConnMgr", '{"LowWater":20,"HighWater":60}'], { env });
+  execFileSync("ipfs", ["config", "--json", "Bootstrap", JSON.stringify(["/dnsaddr/bootstrap.libp2p.io/p2p/QmNnooDu7bfjPFoTZYxMNLWUQJyrVwtbZg5gBMjTezGAJN",
+    "/dnsaddr/bootstrap.libp2p.io/p2p/QmQCU2EcMqAqQPR2i9bChDtGNJchTbq5TbXJJ16u19uLTa", "/dnsaddr/bootstrap.libp2p.io/p2p/QmbLHAnMoJPWSCR5Zhtx6BHJX9KiKNN6tpvbUcqanj75Nb",
+    "/dnsaddr/bootstrap.libp2p.io/p2p/QmcZf59bWwK5XFi76CZX8cbJ4BhTzzA3gU1ZjYZcYW3dwt", "/ip4/104.131.131.82/tcp/4001/p2p/QmaCpDMGvV2BGHeYERUEnRQAwe3N8SzbUtfsmvsqQLuvuJ"])], { env });
+  const daemon = spawn("ipfs", ["daemon"], { env, stdio: ["ignore", "pipe", "pipe"] });
+  try {
+    await new Promise((res) => { daemon.stdout.on("data", (x) => { if (/Daemon is ready/.test(String(x))) res(); }); setTimeout(res, 30_000); });
+    await new Promise((r) => setTimeout(r, 15_000)); // let the routing table fill
+    const peers = execFileSync("ipfs", ["swarm", "peers"], { env }).toString().trim().split("\n").filter(Boolean).length;
+    const b = execFileSync("ipfs", ["routing", "get", `/ipns/${PRODUCTION.name}`], { env, timeout: 120_000 });
+    out.records["public-dht (fresh client)"] = { peers, ...inspect(b) };
+  } catch (e) { out.records["public-dht (fresh client)"] = { error: String(e.message ?? e).slice(0, 200) }; }
+  finally { daemon.kill("SIGINT"); await new Promise((r) => setTimeout(r, 2000)); daemon.kill("SIGKILL"); }
+}
+rmSync(repo, { recursive: true, force: true });
+
+// ---- content availability: the COMPLETE DAG (verified CAR), for the current value and any --also CID -----------
+const seen = Object.values(out.records).filter((r) => r.valid);
+const maxSeq = seen.reduce((a, r) => Math.max(a, Number(r.sequence)), -1);
+const current = seen.find((r) => Number(r.sequence) === maxSeq)?.value ?? null;
+out.summary = {
+  maxObservedSequence: maxSeq, valueAtMax: current,
+  distinct: [...new Set(seen.map((r) => `${r.sequence} ${r.value}`))],
+  note: "a floor: records signed by any key holder and not reachable from these vantage points are not seen",
+};
+const cids = [current?.replace(/^\/ipfs\//, "").split("/")[0], ...(argv.includes("--also") ? [argv[argv.indexOf("--also") + 1]] : [])].filter(Boolean);
+out.availability = { check: "complete DAG: ?format=car verified by scripts/site-release/car.mjs readCar (tools/ipns-release-anchor completeAt)" };
+const { completeAt } = await import(join(ANCHOR, "scripts/anchor-release.mjs"));
+for (const cid of cids) {
+  out.availability[cid] = {};
+  for (const gw of ["https://ipfs.io", "https://dweb.link", "https://trustless-gateway.link", "https://w3s.link", "https://4everland.io", "https://ipfs.enclave.host"]) {
+    out.availability[cid][new URL(gw).host] = await completeAt(gw, cid, { maxBytes: 512 * 1024 * 1024, timeoutMs: 120_000 });
+  }
+}
+if (outFile) writeFileSync(outFile, JSON.stringify(out, null, 2) + "\n");
+console.log(JSON.stringify(out, null, 2));
