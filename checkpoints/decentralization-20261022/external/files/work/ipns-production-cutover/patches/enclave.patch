diff --git a/tools/ipns-release-anchor/foundry.toml b/tools/ipns-release-anchor/foundry.toml
new file mode 100644
index 0000000..11ee743
--- /dev/null
+++ b/tools/ipns-release-anchor/foundry.toml
@@ -0,0 +1,19 @@
+# Isolated forge project for the IPNS release-anchor candidate. solc 0.8.35 (the repo's pinned compiler, from the
+# local svm cache), offline. No CBOR metadata, so the runtime codehash depends only on the source and these settings;
+# scripts/expected-codehash.mjs derives the pinned codehash from out/ without reading any chain.
+[profile.default]
+src = "src"
+test = "test"
+out = "out"
+cache_path = "cache"
+libs = []
+solc = "0.8.35"
+optimizer = true
+optimizer_runs = 200
+via_ir = false
+bytecode_hash = "none"
+cbor_metadata = false
+offline = true
+
+[fuzz]
+runs = 256
diff --git a/tools/ipns-release-anchor/src/ReleaseAnchor.sol b/tools/ipns-release-anchor/src/ReleaseAnchor.sol
new file mode 100644
index 0000000..4fd6fe0
--- /dev/null
+++ b/tools/ipns-release-anchor/src/ReleaseAnchor.sol
@@ -0,0 +1,163 @@
+// SPDX-License-Identifier: MIT
+pragma solidity 0.8.35;
+
+/// @title ReleaseAnchor — the on-chain authority for one IPNS name's site release.
+/// @notice The ipns-publisher reads `state()` through a quorum of RPC endpoints at one agreed block and publishes
+///         /ipfs/<cid> at IPNS sequence `sequenceOffset + seq`. The owner appoints a delegate whose only power is
+///         publish(cid, expectedSeq): it cannot touch the publisher's config, secrets or key, the owner, or itself.
+///         The owner's pin() always wins and revokes the delegate in the same transaction.
+/// @dev Immutable by construction: no proxy, no delegatecall, no selfdestruct. `nameHash` is an immutable, so it
+///      is part of the runtime code and the publisher's pinned codehash covers it.
+contract ReleaseAnchor {
+    bytes32 public constant SCHEMA = keccak256("enclave.ipns-release-anchor.v1");
+    uint64 public constant MAX_DELEGATION_SECS = 180 days;
+
+    /// keccak256 of the IPNS name's peer multihash bytes (identity multihash of the ed25519 public key protobuf).
+    bytes32 public immutable nameHash;
+
+    address public owner;
+    address public pendingOwner;
+    address public delegate;
+    uint64 public delegateUntil;
+    uint64 public seq;
+    bool public retired;
+    address public successor;
+    string private _cid;
+
+    event Published(uint64 indexed seq, string cid, address indexed by);
+    event DelegateSet(address delegate, uint64 until);
+    event OwnershipTransferStarted(address indexed owner, address indexed pendingOwner);
+    event OwnershipTransferred(address indexed previousOwner, address indexed newOwner);
+    event Retired(address successor, uint64 seq);
+
+    error NotOwner();
+    error NotAuthorized();
+    error NotPendingOwner();
+    error IsRetired();
+    error ZeroAddress();
+    error BadCid();
+    error BadName();
+    error StaleSeq(uint64 expected, uint64 current);
+    error BadDelegation();
+
+    modifier onlyOwner() {
+        if (msg.sender != owner) revert NotOwner();
+        _;
+    }
+
+    modifier live() {
+        if (retired) revert IsRetired();
+        _;
+    }
+
+    constructor(address owner_, bytes32 nameHash_, string memory cid_) {
+        if (owner_ == address(0)) revert ZeroAddress();
+        if (nameHash_ == bytes32(0)) revert BadName();
+        _checkCid(bytes(cid_));
+        owner = owner_;
+        nameHash = nameHash_;
+        seq = 1;
+        _cid = cid_;
+        emit OwnershipTransferred(address(0), owner_);
+        emit Published(1, cid_, msg.sender);
+    }
+
+    /// The delegate's (and the owner's) release call. The compare-and-swap makes a stale or replayed transaction fail.
+    function publish(string calldata cid_, uint64 expectedSeq) external live {
+        if (msg.sender != owner && !(msg.sender == delegate && block.timestamp <= delegateUntil)) {
+            revert NotAuthorized();
+        }
+        if (expectedSeq != seq) revert StaleSeq(expectedSeq, seq);
+        _set(cid_);
+    }
+
+    /// Owner override: a new release AND no delegate, in one transaction. No CAS, so a racing delegate cannot block it.
+    function pin(string calldata cid_) external onlyOwner live {
+        _setDelegate(address(0), 0);
+        _set(cid_);
+    }
+
+    /// Appoint (bounded in time) or revoke (d = 0, until = 0) the delegate.
+    function setDelegate(address d, uint64 until) external onlyOwner live {
+        if (d == address(0)) {
+            if (until != 0) revert BadDelegation();
+        } else if (until <= block.timestamp || until > block.timestamp + MAX_DELEGATION_SECS) {
+            revert BadDelegation();
+        }
+        _setDelegate(d, until);
+    }
+
+    /// Two-step transfer; `to = 0` cancels a pending one.
+    function transferOwnership(address to) external onlyOwner live {
+        pendingOwner = to;
+        emit OwnershipTransferStarted(owner, to);
+    }
+
+    /// The new owner starts with no delegate: an appointment never outlives the owner who made it.
+    function acceptOwnership() external live {
+        if (msg.sender != pendingOwner) revert NotPendingOwner();
+        address previous = owner;
+        owner = msg.sender;
+        pendingOwner = address(0);
+        _setDelegate(address(0), 0);
+        emit OwnershipTransferred(previous, msg.sender);
+    }
+
+    /// Freeze forever. `successor` is a pointer for humans; publishers never follow it without a new owner config.
+    function retire(address successor_) external onlyOwner live {
+        _setDelegate(address(0), 0);
+        pendingOwner = address(0);
+        retired = true;
+        successor = successor_;
+        emit Retired(successor_, seq);
+    }
+
+    function cid() external view returns (string memory) {
+        return _cid;
+    }
+
+    /// Everything the publisher needs, read atomically at one block.
+    function state()
+        external
+        view
+        returns (
+            bytes32 schema,
+            bytes32 nameHash_,
+            uint64 seq_,
+            string memory cid_,
+            address owner_,
+            address delegate_,
+            uint64 delegateUntil_,
+            bool retired_,
+            address successor_
+        )
+    {
+        return (SCHEMA, nameHash, seq, _cid, owner, delegate, delegateUntil, retired, successor);
+    }
+
+    function _set(string calldata cid_) private {
+        _checkCid(bytes(cid_));
+        uint64 next = seq + 1; // checked: reverts at type(uint64).max
+        seq = next;
+        _cid = cid_;
+        emit Published(next, cid_, msg.sender);
+    }
+
+    function _setDelegate(address d, uint64 until) private {
+        if (delegate == d && delegateUntil == until) return;
+        delegate = d;
+        delegateUntil = until;
+        emit DelegateSet(d, until);
+    }
+
+    /// A multibase base32-lower string: 'b' then [a-z2-7], 8..128 bytes. The publisher additionally decodes it as a
+    /// CIDv1; this check keeps paths, whitespace and other encodings out of the record value.
+    function _checkCid(bytes memory c) private pure {
+        uint256 n = c.length;
+        if (n < 8 || n > 128 || c[0] != "b") revert BadCid();
+        for (uint256 i = 1; i < n; ++i) {
+            bytes1 ch = c[i];
+            if (!((ch >= "a" && ch <= "z") || (ch >= "2" && ch <= "7"))) revert BadCid();
+        }
+    }
+}
diff --git a/tools/ipns-release-anchor/test/ReleaseAnchor.t.sol b/tools/ipns-release-anchor/test/ReleaseAnchor.t.sol
new file mode 100644
index 0000000..1daa8ae
--- /dev/null
+++ b/tools/ipns-release-anchor/test/ReleaseAnchor.t.sol
@@ -0,0 +1,327 @@
+// SPDX-License-Identifier: MIT
+pragma solidity 0.8.35;
+
+import {MiniTest} from "./MiniTest.sol";
+import {ReleaseAnchor} from "../src/ReleaseAnchor.sol";
+
+contract ReleaseAnchorTest is MiniTest {
+    ReleaseAnchor a;
+    address owner = makeAddr("owner");
+    address del = makeAddr("delegate");
+    address other = makeAddr("other");
+    bytes32 constant NAME = keccak256("peer-multihash");
+    string constant CID0 = "bafybeigdyrzt5sfp7udm7hu76uh7y26nf3efuylqabf3oclgtqy55fbzdi";
+    string constant CID1 = "bafkreihdwdcefgh4dqkjv67uzcmw7ojee6xedzdetojuzjevtenxquvyku";
+    string constant CID2 = "bafybeibml5uieyxa5tufngvg7fgwbkwvlsuntwbxgtskoqynbt7wlchmfm";
+
+    event Published(uint64 indexed seq, string cid, address indexed by);
+    event DelegateSet(address delegate, uint64 until);
+    event OwnershipTransferred(address indexed previousOwner, address indexed newOwner);
+    event Retired(address successor, uint64 seq);
+
+    function setUp() public {
+        vm.warp(1_800_000_000);
+        a = new ReleaseAnchor(owner, NAME, CID0);
+    }
+
+    function _state()
+        internal
+        view
+        returns (bytes32 schema, bytes32 nh, uint64 seq, string memory cid, address o, address d, uint64 until, bool retired, address succ)
+    {
+        return a.state();
+    }
+
+    function _appoint() internal {
+        vm.prank(owner);
+        a.setDelegate(del, uint64(block.timestamp + 30 days));
+    }
+
+    // ---- construction --------------------------------------------------------------------------------------------
+
+    function test_constructorState() public view {
+        (bytes32 schema, bytes32 nh, uint64 seq, string memory cid, address o, address d, uint64 until, bool r, address s) = _state();
+        assertEq(schema, keccak256("enclave.ipns-release-anchor.v1"));
+        assertEq(schema, a.SCHEMA());
+        assertEq(nh, NAME);
+        assertEq(seq, 1);
+        assertEq(cid, CID0);
+        assertEq(o, owner);
+        assertEq(d, address(0));
+        assertEq(until, 0);
+        assertFalse(r);
+        assertEq(s, address(0));
+        assertEq(a.MAX_DELEGATION_SECS(), 180 days);
+    }
+
+    function test_constructorRejects() public {
+        vm.expectRevert(ReleaseAnchor.ZeroAddress.selector);
+        new ReleaseAnchor(address(0), NAME, CID0);
+        vm.expectRevert(ReleaseAnchor.BadName.selector);
+        new ReleaseAnchor(owner, bytes32(0), CID0);
+        vm.expectRevert(ReleaseAnchor.BadCid.selector);
+        new ReleaseAnchor(owner, NAME, "/ipfs/bafy");
+    }
+
+    // ---- publish: CAS, authorization, expiry ---------------------------------------------------------------------
+
+    function test_ownerPublishCas() public {
+        vm.expectEmit(true, true, false, true, address(a));
+        emit Published(2, CID1, owner);
+        vm.prank(owner);
+        a.publish(CID1, 1);
+        assertEq(a.seq(), 2);
+        assertEq(a.cid(), CID1);
+        // the same transaction replayed (same expectedSeq) fails: no off-chain replay can move the anchor
+        vm.prank(owner);
+        vm.expectRevert(abi.encodeWithSelector(ReleaseAnchor.StaleSeq.selector, uint64(1), uint64(2)));
+        a.publish(CID0, 1);
+        assertEq(a.cid(), CID1);
+    }
+
+    function test_delegatePublishWithinWindow() public {
+        _appoint();
+        vm.prank(del);
+        a.publish(CID1, 1);
+        assertEq(a.seq(), 2);
+        // exactly at the bound is still allowed; one second after is not
+        vm.warp(block.timestamp + 30 days);
+        vm.prank(del);
+        a.publish(CID2, 2);
+        vm.warp(block.timestamp + 1);
+        vm.prank(del);
+        vm.expectRevert(ReleaseAnchor.NotAuthorized.selector);
+        a.publish(CID1, 3);
+        assertEq(a.seq(), 3);
+    }
+
+    function test_strangerCannotPublish() public {
+        _appoint();
+        vm.prank(other);
+        vm.expectRevert(ReleaseAnchor.NotAuthorized.selector);
+        a.publish(CID1, 1);
+    }
+
+    function test_delegateHasNoOtherPower() public {
+        _appoint();
+        vm.startPrank(del);
+        vm.expectRevert(ReleaseAnchor.NotOwner.selector);
+        a.pin(CID1);
+        vm.expectRevert(ReleaseAnchor.NotOwner.selector);
+        a.setDelegate(del, uint64(block.timestamp + 180 days));
+        vm.expectRevert(ReleaseAnchor.NotOwner.selector);
+        a.setDelegate(other, uint64(block.timestamp + 1 days));
+        vm.expectRevert(ReleaseAnchor.NotOwner.selector);
+        a.transferOwnership(del);
+        vm.expectRevert(ReleaseAnchor.NotPendingOwner.selector);
+        a.acceptOwnership();
+        vm.expectRevert(ReleaseAnchor.NotOwner.selector);
+        a.retire(del);
+        vm.stopPrank();
+        assertEq(a.owner(), owner);
+        assertEq(a.delegateUntil(), uint64(block.timestamp + 30 days));
+    }
+
+    // ---- delegation bounds and revocation ------------------------------------------------------------------------
+
+    function test_delegationBounds() public {
+        vm.startPrank(owner);
+        vm.expectRevert(ReleaseAnchor.BadDelegation.selector);
+        a.setDelegate(del, uint64(block.timestamp));
+        vm.expectRevert(ReleaseAnchor.BadDelegation.selector);
+        a.setDelegate(del, uint64(block.timestamp + 180 days + 1));
+        vm.expectRevert(ReleaseAnchor.BadDelegation.selector);
+        a.setDelegate(address(0), 5);
+        a.setDelegate(del, uint64(block.timestamp + 180 days));
+        assertEq(a.delegate(), del);
+        vm.expectEmit(false, false, false, true, address(a));
+        emit DelegateSet(address(0), 0);
+        a.setDelegate(address(0), 0);
+        vm.stopPrank();
+        assertEq(a.delegate(), address(0));
+        vm.prank(del);
+        vm.expectRevert(ReleaseAnchor.NotAuthorized.selector);
+        a.publish(CID1, 1);
+    }
+
+    function test_pinOverridesAndRevokes() public {
+        _appoint();
+        vm.prank(del);
+        a.publish(CID1, 1); // the delegate's (say, compromised) release
+        vm.expectEmit(false, false, false, true, address(a));
+        emit DelegateSet(address(0), 0);
+        vm.expectEmit(true, true, false, true, address(a));
+        emit Published(3, CID2, owner);
+        vm.prank(owner);
+        a.pin(CID2); // no expectedSeq: a racing delegate publish cannot make the override fail
+        assertEq(a.seq(), 3);
+        assertEq(a.cid(), CID2);
+        assertEq(a.delegate(), address(0));
+        vm.prank(del);
+        vm.expectRevert(ReleaseAnchor.NotAuthorized.selector);
+        a.publish(CID1, 3);
+    }
+
+    // ---- ownership -----------------------------------------------------------------------------------------------
+
+    function test_twoStepOwnershipClearsDelegate() public {
+        _appoint();
+        vm.prank(owner);
+        a.transferOwnership(other);
+        assertEq(a.owner(), owner); // nothing moves until accepted
+        vm.prank(other);
+        vm.expectRevert(ReleaseAnchor.NotOwner.selector);
+        a.pin(CID1);
+        vm.expectEmit(true, true, false, false, address(a));
+        emit OwnershipTransferred(owner, other);
+        vm.prank(other);
+        a.acceptOwnership();
+        assertEq(a.owner(), other);
+        assertEq(a.pendingOwner(), address(0));
+        assertEq(a.delegate(), address(0)); // the old owner's appointment does not survive
+        vm.prank(del);
+        vm.expectRevert(ReleaseAnchor.NotAuthorized.selector);
+        a.publish(CID1, 1);
+        vm.prank(owner);
+        vm.expectRevert(ReleaseAnchor.NotOwner.selector);
+        a.pin(CID1);
+        vm.prank(other);
+        a.pin(CID1);
+        assertEq(a.seq(), 2);
+    }
+
+    function test_transferCancel() public {
+        vm.startPrank(owner);
+        a.transferOwnership(other);
+        a.transferOwnership(address(0));
+        vm.stopPrank();
+        vm.prank(other);
+        vm.expectRevert(ReleaseAnchor.NotPendingOwner.selector);
+        a.acceptOwnership();
+    }
+
+    // ---- retirement ----------------------------------------------------------------------------------------------
+
+    function test_retireFreezes() public {
+        _appoint();
+        vm.prank(owner);
+        a.transferOwnership(other);
+        vm.expectEmit(false, false, false, true, address(a));
+        emit Retired(other, 1);
+        vm.prank(owner);
+        a.retire(other);
+        (,, uint64 seq, string memory cid,, address d, uint64 until, bool r, address s) = _state();
+        assertEq(seq, 1);
+        assertEq(cid, CID0);
+        assertEq(d, address(0));
+        assertEq(until, 0);
+        assertTrue(r);
+        assertEq(s, other);
+        assertEq(a.pendingOwner(), address(0));
+        vm.startPrank(owner);
+        vm.expectRevert(ReleaseAnchor.IsRetired.selector);
+        a.publish(CID1, 1);
+        vm.expectRevert(ReleaseAnchor.IsRetired.selector);
+        a.pin(CID1);
+        vm.expectRevert(ReleaseAnchor.IsRetired.selector);
+        a.setDelegate(del, uint64(block.timestamp + 1 days));
+        vm.expectRevert(ReleaseAnchor.IsRetired.selector);
+        a.transferOwnership(other);
+        vm.expectRevert(ReleaseAnchor.IsRetired.selector);
+        a.retire(address(0));
+        vm.stopPrank();
+        vm.prank(other);
+        vm.expectRevert(ReleaseAnchor.IsRetired.selector);
+        a.acceptOwnership();
+    }
+
+    // ---- the CID rule --------------------------------------------------------------------------------------------
+
+    function test_cidRule() public {
+        vm.startPrank(owner);
+        string[9] memory bad = [
+            string("bafybei"),                    // 7 bytes
+            "Bafybeigdyrzt5sfp7udm7hu76uh7y26",   // multibase 'B' (upper)
+            "bafybeigDyrzt5sfp7udm7hu76uh7y26",   // upper case inside
+            "bafybeig1yrzt5sfp7udm7hu76uh7y26",   // '1' is not base32
+            "bafybeig8yrzt5sfp7udm7hu76uh7y26",   // '8'
+            "bafybeig yrzt5sfp7udm7hu76uh7y26",   // space
+            "bafybeig/yrzt5sfp7udm7hu76uh7y26",   // a path
+            "QmYwAPJzv5CZsnA625s3Xf2nemtYgPpHdWEz", // base58 CIDv0
+            ""
+        ];
+        for (uint256 i = 0; i < bad.length; ++i) {
+            vm.expectRevert(ReleaseAnchor.BadCid.selector);
+            a.publish(bad[i], 1);
+        }
+        bytes memory long = new bytes(129);
+        long[0] = "b";
+        for (uint256 i = 1; i < 129; ++i) long[i] = "a";
+        vm.expectRevert(ReleaseAnchor.BadCid.selector);
+        a.publish(string(long), 1);
+        bytes memory max = new bytes(128);
+        max[0] = "b";
+        for (uint256 i = 1; i < 128; ++i) max[i] = "7";
+        a.publish(string(max), 1);
+        a.publish("baaaaaaa", 2); // 8 bytes, the minimum
+        vm.stopPrank();
+        assertEq(a.seq(), 3);
+    }
+
+    function testFuzz_cidCharset(bytes1 ch) public {
+        bytes memory c = bytes("bafybeigdyrzt5sfp7udm7hu76uh7y26");
+        c[10] = ch;
+        bool ok = (ch >= "a" && ch <= "z") || (ch >= "2" && ch <= "7");
+        vm.prank(owner);
+        if (!ok) vm.expectRevert(ReleaseAnchor.BadCid.selector);
+        a.publish(string(c), 1);
+        assertEq(a.seq(), ok ? 2 : 1);
+    }
+
+    // ---- sequence overflow ---------------------------------------------------------------------------------------
+
+    function test_seqOverflowReverts() public {
+        // slot 3 packs seq (uint64, low bytes), retired (bool) and successor; set seq = max, the rest zero
+        assertEq(uint256(vm.load(address(a), bytes32(uint256(3)))), 1);
+        vm.store(address(a), bytes32(uint256(3)), bytes32(uint256(type(uint64).max)));
+        assertEq(a.seq(), type(uint64).max);
+        vm.prank(owner);
+        vm.expectRevert(ARITHMETIC_PANIC);
+        a.publish(CID1, type(uint64).max);
+        vm.prank(owner);
+        vm.expectRevert(ARITHMETIC_PANIC);
+        a.pin(CID1);
+    }
+
+    // ---- what the publisher reads and pins -----------------------------------------------------------------------
+
+    function test_stateAbiLayout() public {
+        vm.prank(owner);
+        a.publish(CID1, 1);
+        (bool ok, bytes memory raw) = address(a).staticcall(abi.encodeWithSignature("state()"));
+        assertTrue(ok);
+        assertEq(bytes4(keccak256("state()")), ReleaseAnchor.state.selector);
+        // the head is 9 words; the string lives at offset 9*32; this is the exact layout the Rust decoder accepts
+        assertEq(raw.length, 9 * 32 + 32 + ((bytes(CID1).length + 31) / 32) * 32);
+        bytes memory expected = abi.encode(
+            a.SCHEMA(), NAME, uint64(2), CID1, owner, address(0), uint64(0), false, address(0)
+        );
+        assertEq(raw, expected);
+        uint256 off;
+        assembly {
+            off := mload(add(raw, add(32, 96)))
+        }
+        assertEq(off, 9 * 32);
+    }
+
+    function test_codehashPinsNameAndIsStateIndependent() public {
+        ReleaseAnchor same = new ReleaseAnchor(other, NAME, CID2);
+        ReleaseAnchor diff = new ReleaseAnchor(owner, keccak256("another name"), CID0);
+        // storage (owner, cid, seq) is not code: one codehash per (build, nameHash)
+        assertEq(address(same).codehash, address(a).codehash);
+        assertTrue(address(diff).codehash != address(a).codehash);
+        vm.prank(owner);
+        a.publish(CID1, 1);
+        assertEq(address(same).codehash, address(a).codehash);
+    }
+}
diff --git a/tools/ipns-release-anchor/test/MiniTest.sol b/tools/ipns-release-anchor/test/MiniTest.sol
new file mode 100644
index 0000000..cd7d8e9
--- /dev/null
+++ b/tools/ipns-release-anchor/test/MiniTest.sol
@@ -0,0 +1,54 @@
+// SPDX-License-Identifier: MIT
+pragma solidity 0.8.35;
+
+/// The few forge cheatcodes these tests use, and plain assertions. forge-std's Test.sol pulls ~20 files whose
+/// compilation alone exceeds this project's 512 MiB test allocation; this keeps the suite inside it.
+interface Vm {
+    function warp(uint256) external;
+    function prank(address) external;
+    function startPrank(address) external;
+    function stopPrank() external;
+    function expectRevert(bytes4) external;
+    function expectRevert(bytes calldata) external;
+    function expectEmit(bool, bool, bool, bool, address) external;
+    function store(address, bytes32, bytes32) external;
+    function load(address, bytes32) external view returns (bytes32);
+    function addr(uint256) external pure returns (address);
+}
+
+abstract contract MiniTest {
+    Vm internal constant vm = Vm(address(uint160(uint256(keccak256("hevm cheat code")))));
+    bytes internal constant ARITHMETIC_PANIC = abi.encodeWithSignature("Panic(uint256)", 0x11);
+
+    function makeAddr(string memory label) internal pure returns (address) {
+        return vm.addr(uint256(keccak256(bytes(label))));
+    }
+
+    function assertTrue(bool c) internal pure {
+        require(c, "assertTrue");
+    }
+
+    function assertFalse(bool c) internal pure {
+        require(!c, "assertFalse");
+    }
+
+    function assertEq(uint256 x, uint256 y) internal pure {
+        require(x == y, "assertEq(uint)");
+    }
+
+    function assertEq(address x, address y) internal pure {
+        require(x == y, "assertEq(address)");
+    }
+
+    function assertEq(bytes32 x, bytes32 y) internal pure {
+        require(x == y, "assertEq(bytes32)");
+    }
+
+    function assertEq(string memory x, string memory y) internal pure {
+        require(keccak256(bytes(x)) == keccak256(bytes(y)), "assertEq(string)");
+    }
+
+    function assertEq(bytes memory x, bytes memory y) internal pure {
+        require(keccak256(x) == keccak256(y), "assertEq(bytes)");
+    }
+}
diff --git a/tools/ipns-release-anchor/test/anchor-e2e.test.mjs b/tools/ipns-release-anchor/test/anchor-e2e.test.mjs
