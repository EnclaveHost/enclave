+    ctx.plan.release.cid, [t.vramMb, t.gpuGflops, t.memMb, t.cpuGflops], t.ports, t.config, 0n] });
+  const pr = await sendAsOwner({ from: OWNER, to: cat, data, value: "0x0", gas: "0x200000" });
