+test("partition: cached authority signs only until block time + authorityTtlSecs, then signing stops", async () => {
+  ctx.proxies.forEach((p) => (p.mode = "down"));
+  let s = await ctx.main.status();
+  const until = s.anchor.authority.until;
+  assert.equal(until, s.anchor.authority.blockTimestamp + 40);
+  const rec = await kuboRecord();
+  assert.ok(rec.validity <= until, `record EOL ${rec.validity} <= authority bound ${until}`);
+  assert.ok(rec.ttlNs <= 40e9);
+  // keep asking; every round fails; once the bound is near, the due re-sign is refused
+  await waitFor("signing stops", async () => {
+    await ctx.main.publish();
+    return /authority expired/.test((await ctx.main.status()).lastError ?? "");
+  }, 70_000, 2000);
+  s = await ctx.main.status();
+  assert.ok(Date.now() / 1000 + 10 >= until, "refused only at the bound");
+  assert.ok(s.validUntil <= until, "no record outlives the authority");
+  assert.ok(s.anchor.roundsFailed >= 2);
+  assert.equal((await kuboRecord()).seq, 14);
+  // heal: a fresh quorum read re-signs the same release at the same sequence with a new bound
+  ctx.proxies.forEach((p) => (p.mode = "ok"));
+  assert.equal(await ctx.main.publish(), 202);
+  await waitFor("re-signed after healing", async () => {
+    const t = await ctx.main.status();
+    return t.lastError === null && t.validUntil > until && t.sequence === 14;
+  }, 30_000);
+  await ctx.main.stop();
+});
+
+test("cold restart without /data: no quorum, replayed old responses or withheld blocks sign nothing", async () => {
+  // all three providers down: nothing to sign from
+  ctx.proxies.forEach((p) => (p.mode = "down"));
+  const cold = await startPublisher({ anchor: true });
+  let s = await rounds(cold, 0);
+  assert.equal(s.durableState, false);
+  assert.match(s.anchor.lastError, /only 0 of the required 2 endpoints/);
+  // p1 and p2 replay, verbatim, the complete once-valid answers captured at anchor seq 2 (release B)
+  ctx.proxies[0].mode = ctx.proxies[1].mode = "replay";
+  ctx.proxies[0].replay = ctx.proxies[1].replay = ctx.captured;
+  await cold.publish();
+  s = await rounds(cold, decided(s));
+  assert.match(s.anchor.lastError, /^stale: block \d+ is \d+s old at the end of the round/);
+  // p1 and p2 withhold every block after that old head but answer everything else honestly
+  ctx.proxies[0].mode = ctx.proxies[1].mode = "stale-head";
+  ctx.proxies[0].frozenHead = ctx.proxies[1].frozenHead = ctx.capturedHead;
+  await cold.publish();
+  s = await rounds(cold, decided(s));
+  assert.match(s.anchor.lastError, /^stale: block \d+ is \d+s old at the end of the round/);
+  assert.equal(s.anchor.roundsOk, 0);
+  assert.equal(s.anchor.authority, null);
+  assert.equal(s.publishedAt, 0);
+  assert.equal((await cold.record()).status, 503, "nothing signed");
+  assert.equal((await kuboRecord()).seq, 14, "the network still has the pin");
+  // with the quorum back, the cold publisher learns everything from the chain
+  ctx.proxies.forEach((p) => (p.mode = "ok"));
+  assert.equal(await cold.publish(), 202);
+  await waitFor("cold publisher signs seq 14", async () => {
+    const t = await cold.status();
+    return t.publishedAt > 0 && t.sequence === 14 ? t : null;
+  }, 30_000);
+  assert.equal(await site("release A"), "release A");
+  await cold.stop();
+});
+
+test("a chain rollback below the high-water is refused, and the refusal survives a restart", async () => {
+  const snap = await rpc(ctx.anvil, "evm_snapshot");
+  let p = await startPublisher({ anchor: true, dataDir: ctx.data });
+  const r = delegatePublish(ctx.cid.D);
+  assert.equal(r.code, 0, r.err);
+  assert.equal(r.out.seq, 5);
+  await waitFor("seq 15", async () => (await kuboRecord())?.seq === 15, 40_000, 500);
+  const hw = (await p.status()).anchor.highWater;
+  assert.equal(hw.seq, 5);
+  // the chain (as every endpoint now sees it) loses the last blocks: anchor seq back to 4, head below the mark
+  assert.equal(await rpc(ctx.anvil, "evm_revert", [snap]), true);
+  let from = decided(await p.status());
+  await p.publish();
+  let s = await rounds(p, from);
+  assert.match(s.anchor.lastError, /regression: the quorum's confirmed block \d+ is below the accepted high-water/);
+  // anvil's revert also rewinds its clock, so the reverted chain is stale too (refused for that alone); give it
+  // current timestamps, as a real reorg would have, so that the next check is the high-water itself
+  await rpc(ctx.anvil, "evm_setNextBlockTimestamp", [Math.floor(Date.now() / 1000)]);
+  // once the head passes the mark, the lower seq itself is refused
+  await waitFor("head past the high-water", async () => Number(BigInt(await rpc(ctx.anvil, "eth_blockNumber"))) - 2 > hw.block, 60_000, 500);
+  from = decided(await p.status());
+  await p.publish();
+  s = await rounds(p, from);
+  assert.match(s.anchor.lastError, /regression: anchor seq 4 is below the accepted high-water 5/);
+  assert.equal((await kuboRecord()).seq, 15);
+  await p.stop();
+  // a restart with the same /data keeps the high-water
+  p = await startPublisher({ anchor: true, dataDir: ctx.data });
+  s = await rounds(p, 0);
+  assert.match(s.anchor.lastError, /seq 4 is below the accepted high-water 5/);
+  await p.stop();
+  // a cold restart has no high-water, but the network's record (seq 15) is above the anchor's mapped 14
+  p = await startPublisher({ anchor: true });
+  s = await rounds(p, 0);
+  assert.equal(s.anchor.authority.seq, 4);
+  await waitFor("refused below the recovered sequence", async () => /exists above the anchor's 14/.test((await p.status()).lastError ?? ""), 20_000);
+  assert.equal((await p.status()).publishedAt, 0);
+  assert.equal((await kuboRecord()).seq, 15);
+  assert.equal(await site("release D"), "release D");
+  await p.stop();
+});
diff --git a/tools/ipns-release-anchor/scripts/guard.sh b/tools/ipns-release-anchor/scripts/guard.sh
new file mode 100755
index 0000000..fb2fe9c
--- /dev/null
+++ b/tools/ipns-release-anchor/scripts/guard.sh
@@ -0,0 +1,23 @@
+#!/bin/bash
+# usage: guard.sh CAP_MIB LOG cmd...
+# Runs cmd in its own process group; kills the group if its RSS exceeds CAP_MIB, MemAvailable drops below 16 GiB,
+# or 900 s pass. Appends one summary line (reason, exit, min MemAvailable, peak group RSS) to LOG.
+CAP=$1; LOG=$2; shift 2
+setsid "$@" > "$LOG" 2>&1 &
+PID=$!
+START=$(date +%s); MINAVAIL=999999; MAXRSS=0; REASON=finished; declare -A PEAK
+while kill -0 $PID 2>/dev/null; do
+  AV=$(awk '/MemAvailable/{print int($2/1024)}' /proc/meminfo)
+  RSS=$(ps -o rss= -g $PID 2>/dev/null | awk '{s+=$1}END{print int(s/1024)}')
+  [ "$AV" -lt $MINAVAIL ] && MINAVAIL=$AV; [ "${RSS:-0}" -gt $MAXRSS ] && MAXRSS=$RSS
+  # per-command peaks (largest single process of each command name)
+  while read -r R C; do [ -n "$C" ] && [ "$R" -gt "${PEAK[$C]:-0}" ] && PEAK[$C]=$R; done < <(ps -o rss=,comm= -g $PID 2>/dev/null)
+  if [ "${RSS:-0}" -gt "$CAP" ]; then REASON="killed: own RSS ${RSS} MiB > ${CAP}"; kill -KILL -$PID; break; fi
+  if [ "$AV" -lt 16384 ]; then REASON="killed: MemAvailable ${AV} MiB < 16384 (own RSS ${RSS} MiB)"; kill -KILL -$PID; break; fi
+  if [ $(( $(date +%s) - START )) -gt 900 ]; then REASON="killed: 900 s deadline"; kill -KILL -$PID; break; fi
+  sleep 0.5
+done
+wait $PID 2>/dev/null; CODE=$?
+for C in "${!PEAK[@]}"; do echo "guard: peak ${C} $(( ${PEAK[$C]} / 1024 ))MiB"; done | sort >> "$LOG"
+echo "guard: $REASON exit=$CODE cap=${CAP}MiB minMemAvailable=${MINAVAIL}MiB maxOwnRSS=${MAXRSS}MiB elapsed=$(( $(date +%s) - START ))s" | tee -a "$LOG"
+exit $CODE
diff --git a/tools/ipns-release-anchor/scripts/expected-codehash.mjs b/tools/ipns-release-anchor/scripts/expected-codehash.mjs
new file mode 100644
index 0000000..6a7ed14
--- /dev/null
+++ b/tools/ipns-release-anchor/scripts/expected-codehash.mjs
@@ -0,0 +1,68 @@
+#!/usr/bin/env node
+// The ReleaseAnchor runtime codehash to pin in the publisher's `releaseAnchor.codeHash`, derived from the reviewed
+// build (out/), never from a chain: the deployed runtime is the compiled runtime with the one immutable (nameHash)
+// filled in. Also scans the runtime for opcodes the contract must not contain (calls, creates, selfdestruct).
+//
+//   node scripts/expected-codehash.mjs 0x<nameHash>        (nameHash: `ipns-publisher id <key>` prints it)
+//   node scripts/expected-codehash.mjs 0x<nameHash> --code 0x<runtime from eth_getCode>   (also compare)
+//
+// keccak256 comes from foundry's `cast keccak` (the same toolchain that built out/).
+import { readFileSync } from "node:fs";
+import { createHash } from "node:crypto";
+import { execFileSync } from "node:child_process";
+import { dirname, join } from "node:path";
+import { fileURLToPath } from "node:url";
+
+const root = join(dirname(fileURLToPath(import.meta.url)), "..");
+const FORBIDDEN = { 0xf0: "CREATE", 0xf1: "CALL", 0xf2: "CALLCODE", 0xf4: "DELEGATECALL", 0xf5: "CREATE2", 0xfa: "STATICCALL", 0xff: "SELFDESTRUCT" };
+
+export function expectedRuntime(nameHash) {
+  if (!/^0x[0-9a-fA-F]{64}$/.test(nameHash) || /^0x0{64}$/.test(nameHash)) throw new Error("nameHash must be a nonzero 32-byte 0x hex");
+  const artifactPath = join(root, "out/ReleaseAnchor.sol/ReleaseAnchor.json");
+  const artifactRaw = readFileSync(artifactPath);
+  const art = JSON.parse(artifactRaw);
+  const code = Buffer.from(art.deployedBytecode.object.replace(/^0x/, ""), "hex");
+  const refs = Object.values(art.deployedBytecode.immutableReferences ?? {});
+  if (refs.length !== 1) throw new Error(`expected exactly one immutable (nameHash), found ${refs.length}`);
+  const value = Buffer.from(nameHash.slice(2), "hex");
+  for (const { start, length } of refs[0]) {
+    if (length !== 32) throw new Error("immutable reference is not 32 bytes");
+    value.copy(code, start);
+  }
+  return {
+    runtime: code,
+    artifactSha256: createHash("sha256").update(artifactRaw).digest("hex"),
+    sourceSha256: createHash("sha256").update(readFileSync(join(root, "src/ReleaseAnchor.sol"))).digest("hex"),
+    compiler: art.metadata?.compiler?.version ?? null,
+  };
+}
+
+export function forbiddenOpcodes(code) {
+  const found = [];
+  for (let i = 0; i < code.length; i++) {
+    const op = code[i];
+    if (op >= 0x60 && op <= 0x7f) { i += op - 0x5f; continue; } // PUSH1..PUSH32 data
+    if (FORBIDDEN[op]) found.push(`${FORBIDDEN[op]}@${i}`);
+  }
+  return found;
+}
+
+export function keccakHex(buf) {
+  return execFileSync("cast", ["keccak", "0x" + Buffer.from(buf).toString("hex")], { encoding: "utf8" }).trim();
+}
+
+if (import.meta.url === `file://${process.argv[1]}`) {
+  const [nameHash, flag, onchain] = process.argv.slice(2);
+  const r = expectedRuntime(nameHash);
+  const out = {
+    codeHash: keccakHex(r.runtime),
+    runtimeBytes: r.runtime.length,
+    forbiddenOpcodes: forbiddenOpcodes(r.runtime),
+    artifactSha256: r.artifactSha256,
+    sourceSha256: r.sourceSha256,
+    compiler: r.compiler,
+  };
+  if (flag === "--code") out.matchesOnchain = onchain.toLowerCase() === "0x" + r.runtime.toString("hex");
+  console.log(JSON.stringify(out, null, 2));
+  if (out.forbiddenOpcodes.length || out.matchesOnchain === false) process.exit(1);
+}
diff --git a/tools/ipns-release-anchor/scripts/anchor-release.mjs b/tools/ipns-release-anchor/scripts/anchor-release.mjs
new file mode 100644
index 0000000..ff04cc7
--- /dev/null
+++ b/tools/ipns-release-anchor/scripts/anchor-release.mjs
@@ -0,0 +1,138 @@
+#!/usr/bin/env node
+// The CID-only delegate's release step (unattended: CI runs it after mirroring a release). It can do one thing:
+// ReleaseAnchor.publish(cid, expectedSeq). It has no access to the publisher's config, secrets or key.
+//
+//   node scripts/anchor-release.mjs state   --rpc URL --contract 0x…
+//   node scripts/anchor-release.mjs publish --rpc URL --contract 0x… --cid bafy… \
+//        --keystore PATH --password-file PATH [--gateway URL]... [--min-gateways N] [--max-car-bytes N]
+//
+// Before publishing, the COMPLETE content of the CID must be retrievable from at least --min-gateways of the
+// --gateway URLs (default: all of them): each gateway's `?format=car` export is read with site-release's verifier
+// (scripts/site-release/car.mjs readCar: every block hashes to its CID, every block is reachable from the root, every
+// file of the UnixFS tree reassembles from blocks present in the CAR), bounded by --max-car-bytes. A gateway that
+// serves the root but misses any child counts as unavailable. This is an availability check on replicated storage,
+// not an authority.
+// The one --rpc here is not trusted either: the contract's compare-and-swap makes a stale view fail, never move
+// the anchor backwards. The key never appears on a command line (cast reads the keystore and password file).
+import { execFileSync } from "node:child_process";
+import { existsSync } from "node:fs";
+import { dirname, join } from "node:path";
+import { fileURLToPath, pathToFileURL } from "node:url";
+
+// site-release's CAR verifier: <repo>/scripts/site-release (repository layout: tools/ipns-release-anchor/scripts),
+// or the workspace's sibling checkout (work/ipns-release-anchor/scripts -> work/enclave)
+const HERE = dirname(fileURLToPath(import.meta.url));
+const CAR_MODULE = [join(HERE, "../../../scripts/site-release/car.mjs"), join(HERE, "../../enclave/scripts/site-release/car.mjs")].find((f) => existsSync(f));
+const DEFAULT_MAX_CAR_BYTES = 512 * 1024 * 1024;
+
+const STATE_SIG = "state()(bytes32,bytes32,uint64,string,address,address,uint64,bool,address)";
+
+function args(argv) {
+  const out = { gateway: [] };
+  for (let i = 0; i < argv.length; i++) {
+    const k = argv[i];
+    if (!k.startsWith("--")) { (out._ ??= []).push(k); continue; }
+    const name = k.slice(2);
+    const v = argv[++i];
+    if (v === undefined) throw new Error(`${k} needs a value`);
+    if (name === "gateway") out.gateway.push(v); else out[name] = v;
+  }
+  return out;
+}
+
+function base32decode(s) {
+  const alphabet = "abcdefghijklmnopqrstuvwxyz234567";
+  let bits = 0, acc = 0;
+  const out = [];
+  for (const c of s) {
+    const v = alphabet.indexOf(c);
+    if (v < 0) throw new Error("cid: not base32-lower");
+    acc = (acc << 5) | v; bits += 5;
+    if (bits >= 8) { bits -= 8; out.push((acc >> bits) & 0xff); }
+  }
+  return Buffer.from(out);
+}
+
+function varint(buf, i) {
+  let v = 0, shift = 0;
+  for (;;) {
+    const b = buf[i++];
+    if (b === undefined) throw new Error("cid: truncated varint");
+    v += (b & 0x7f) * 2 ** shift; shift += 7;
+    if (!(b & 0x80)) return [v, i];
+  }
+}
+
+/** The CIDv1's sha2-256 digest (the only hash the site release produces). */
+export function cidDigest(cid) {
+  if (!/^b[a-z2-7]{7,127}$/.test(cid)) throw new Error("cid must be a base32 CIDv1 (b…)");
+  const bytes = base32decode(cid.slice(1));
+  let [version, i] = varint(bytes, 0);
+  if (version !== 1) throw new Error("cid: not CIDv1");
+  [, i] = varint(bytes, i); // codec
+  let code, len;
+  [code, i] = varint(bytes, i);
+  [len, i] = varint(bytes, i);
+  if (code !== 0x12 || len !== 32 || bytes.length !== i + 32) throw new Error("cid: not a sha2-256 multihash");
+  return bytes.subarray(i);
+}
+
+/** "ok" only when the gateway's CAR export holds the whole DAG under `cid`, verified; else the reason. */
+export async function completeAt(gateway, cid, { maxBytes = DEFAULT_MAX_CAR_BYTES, timeoutMs = 300_000 } = {}) {
+  if (!CAR_MODULE) return "site-release's CAR verifier (scripts/site-release/car.mjs) is not available";
+  const { readCar } = await import(pathToFileURL(CAR_MODULE).href);
+  try {
+    const r = await fetch(`${gateway.replace(/\/$/, "")}/ipfs/${cid}?format=car`, {
+      headers: { accept: "application/vnd.ipld.car" }, redirect: "error", signal: AbortSignal.timeout(timeoutMs),
+    });
+    if (r.status !== 200) return `HTTP ${r.status}`;
+    const chunks = [];
+    let n = 0;
+    for await (const c of r.body) { n += c.length; if (n > maxBytes) return `CAR over ${maxBytes} bytes`; chunks.push(c); }
+    const car = readCar(Buffer.concat(chunks), { expectRoot: cid });
+    return car.files.length ? "ok" : "the DAG holds no files";
+  } catch (e) {
+    return String(e?.message ?? e).slice(0, 120);
+  }
+}
+
+export function readState(rpc, contract) {
+  const out = execFileSync("cast", ["call", "--rpc-url", rpc, contract, STATE_SIG], { encoding: "utf8" }).trim().split("\n");
+  const [schema, nameHash, seq, cid, owner, delegate, delegateUntil, retired, successor] = out.map((l) => l.trim());
+  return {
+    schema, nameHash, seq: Number(seq.split(" ")[0]), cid: JSON.parse(cid), owner, delegate,
+    delegateUntil: Number(delegateUntil.split(" ")[0]), retired: retired === "true", successor,
+  };
+}
+
+async function main() {
+  const [cmd, ...rest] = process.argv.slice(2);
+  const a = args(rest);
+  if (!a.rpc || !a.contract) throw new Error("--rpc and --contract are required");
+  const before = readState(a.rpc, a.contract);
+  if (cmd === "state") return console.log(JSON.stringify(before, null, 2));
+  if (cmd !== "publish") throw new Error("usage: state | publish");
+  if (!a.cid || !a.keystore || !a["password-file"]) throw new Error("publish needs --cid, --keystore and --password-file");
+  cidDigest(a.cid); // shape check: a base32 CIDv1 with a sha2-256 multihash
+  const need = Number(a["min-gateways"] ?? a.gateway.length);
+  if (!(need >= 1)) throw new Error("--min-gateways must be at least 1");
+  const maxBytes = Number(a["max-car-bytes"] ?? DEFAULT_MAX_CAR_BYTES);
+  const checks = await Promise.all(a.gateway.map(async (g) => [new URL(g).host, await completeAt(g, a.cid, { maxBytes })]));
+  const ok = checks.filter(([, r]) => r === "ok").length;
+  if (ok < need) {
+    console.log(JSON.stringify({ published: false, reason: `available at ${ok} of the required ${need} gateways`, checks }));
+    process.exit(3);
+  }
+  if (before.retired) throw new Error("the anchor is retired");
+  if (before.cid === a.cid) return console.log(JSON.stringify({ published: false, reason: "already current", seq: before.seq, checks }));
+  const receipt = JSON.parse(execFileSync("cast", [
+    "send", "--json", "--rpc-url", a.rpc, "--keystore", a.keystore, "--password-file", a["password-file"],
+    a.contract, "publish(string,uint64)", a.cid, String(before.seq),
+  ], { encoding: "utf8" }));
+  if (receipt.status !== "0x1") throw new Error(`publish reverted (tx ${receipt.transactionHash})`);
+  console.log(JSON.stringify({ published: true, seq: before.seq + 1, cid: a.cid, tx: receipt.transactionHash, block: Number(receipt.blockNumber), checks }));
+}
+
+if (import.meta.url === `file://${process.argv[1]}`) {
+  main().catch((e) => { console.error(`anchor-release: ${e.message}`); process.exit(1); });
+}
diff --git a/tools/ipns-release-anchor/docs/ipns-release-anchor.md b/tools/ipns-release-anchor/docs/ipns-release-anchor.md
new file mode 100644
index 0000000..41e58bb
--- /dev/null
+++ b/tools/ipns-release-anchor/docs/ipns-release-anchor.md
@@ -0,0 +1,170 @@
+# IPNS release anchor: reviewed design (supersedes docs/ipns-release-pointer-proposal.md)
+
+**Status: an OPTIONAL, proposed additive contract.** Implemented and tested locally, never deployed. Every existing
+contract stays as it is: nothing here modifies, migrates or replaces a deployed contract, and no step is irreversible.
+- the contract: `src/ReleaseAnchor.sol`;
+- the publisher's reader: [`ipns-publisher/src/anchor.rs`](https://github.com/EnclaveHost/enclave-apps/blob/main/ipns-publisher/src/anchor.rs)
+  and `src/main.rs` in the enclave-apps repository (configuration: its README, "Release anchor");
+- the tests: `test/` here (forge, and the anvil + kubo + publisher end-to-end), and `../ipns-cutover/test/` (a Base fork
+  with the production 1.0.5 component);
+- the production cutover: [`../ipns-cutover/README.md`](../ipns-cutover/README.md).
+
+**What it gives:**
+- unattended site releases with **no owner signature per release** and **no Enclave server in the authority path**;
+- the IPNS key, the name, the delegates, the DHT and the record format are unchanged;
+- the legacy fixed-`value` configuration is unchanged.
+
+## 0. Is a new contract needed? (existing contracts first)
+
+The requirement is that the site release moves the IPNS name **without a mutable Enclave server** in the authority
+path. Today that server is `https://ipfs.enclave.host/site-root`, the deployed publisher's `value`. Three ways meet
+it. The first two need no contract change at all.
+
+| | A. The existing ledger (`setConfig`) | B. The existing EnclaveAddressBook (`setMany`) | C. ReleaseAnchor (optional, additive) |
+| --- | --- | --- | --- |
+| Contracts | the deployed deployments ledger | the deployed book `0xab21…0907` | one new contract; nothing existing changes |
+| Publisher code | the deployed 1.0.5 as is: `value: /ipfs/<CID>` in the owner's config | a new book-read mode (not implemented) | the reviewed `releaseAnchor` mode |
+| Per release | one owner signature (`enclave config set`), which restarts the app | one owner signature: the platform governance EOA writes 3 keys atomically | **none**: a CI delegate calls `publish(cid, expectedSeq)` |
+| Who can move the name | the deployment owner (or an owner-approved session on a vault-held record) | only the book owner, the same key that repoints registry, ledger and catalog | the delegate (CID only, ≤ 180 days), or the owner at any time |
+| Ordering | ledger order; the old code's max+1 rule | none on chain: the owner writes the sequence, the publisher's high-water refuses regressions | compare-and-swap on chain |
+
+**A is available today, with no new code and no new contract.** It removes the `site-root` server dependency as
+soon as the owner sets `value` to a fixed `/ipfs/<CID>` and changes it per release (site-release's `publish-plan`
+prepares exactly that transaction). An owner-approved session can do it unattended only for a record that the
+owner's vault holds; the CLI refuses a session that changes a wallet-held production deployment's config. The session
+can rewrite the **whole** config, not only the CID.
+
+**B is measured, not assumed** (`probe/book-evaluation.mjs`, read-only). The deployed book holds only addresses, 20
+bytes per key. A CIDv1/sha2-256 plus a sequence round-trips through three keys written by one `setMany`, so readers at
+one block hash see all three together. The owner's simulated `setMany` succeeds; an outsider's reverts. But its only
+writer is the platform governance owner. There is no per-key writer, no expiry and no compare-and-swap, so CI could
+write a release only by holding the governance key itself. B therefore suits owner-signed releases only, and it also
+needs a publisher book-read mode that A does not.
+
+**C is justified only for unattended CI releases.** It is the one option that delegates *only* "choose this CID"
+to an expiring, revocable key without handing CI the governance key or the whole deployment config. It is a new,
+independent contract: it reads and changes nothing in the ledger, book or catalog, and the owner can stop using it at
+any time with a config change. If unattended CI release is not wanted, use A and do not deploy C. `retire` exists
+in its bytecode but is irreversible and is never used by any step here.
+
+## 1. Review of the proposal, and what changed
+
+| # | The proposal | The problem | Now |
+| --- | --- | --- | --- |
+| 1 | On an RPC outage, republish the value verified "during this process's lifetime", extending the record's lifetime. | This is unbounded. A partitioned publisher would re-sign a revoked delegate's CID forever, so "the owner can revoke within a bounded time" was false. | The authority from a round is valid until `block.timestamp + authorityTtlSecs`. Every record's EOL is capped there, and so is its TTL. Past the bound, signing **stops**. |
+| 2 | Freshness: the block is "no older than `maxBlockAgeSecs`". | It did not say which clock or when. A slow round could pass a check made at its start. A fresh timestamp was read as "the latest state". | Checked with the clock read **after the last response**. The claim is stated as "the state at one recent canonical block", never "the head". Withholding blocks is possible up to the window. |
+| 3 | Agreement "on `(seq, cid)`" at "one block". | It did not specify how the block is chosen, how the read is bound to it, or what code is read. Liars could inflate the head, or answer from a fork. | Target = the quorum-th highest head minus `confirmations`. Quorum agreement on (number, hash, timestamp). `eth_getCode` and `eth_call` **by that blockHash** (EIP-1898, `requireCanonical`). The runtime codehash is pinned to the reviewed build. Every endpoint is asked; nothing is first-success. |
+| 4 | Not covered. | A confirmed state could later be "un-confirmed", by a deep reorg or by lying endpoints after a restart. | The block and seq high-water, keyed by (chainId, contract), is persisted in `/data`. Any regression is refused. Without `/data`, the recovered IPNS sequence is the floor. |
+| 5 | `sequenceOffset` "above the last sequence". | It said nothing about overflow, about being equal with another value, or about migration. | The add is checked. A recovered sequence that is higher, or equal with another value, is refused. The migration and identity rules are in §4. |
+| 6 | `setSigner(address)`, unbounded in time. A `pin` with CAS was implied. | The delegation was unbounded. An owner override could lose a race to the delegate. The owner was "fixed at deployment" (no reviewable transfer). | `setDelegate(d, until)` is bounded to ≤ 180 days. `pin` has no CAS and revokes in the same transaction. Ownership is a two-step transfer that clears the delegate. `retire` exists in the reviewed bytecode but is irreversible, so no plan or step uses it. |
+
+**Kept from the proposal:**
+- one immutable contract per name;
+- the compare-and-swap `publish`;
+- no off-chain signed pointer at all, so there is nothing whose "newest seq" is remembered only locally;
+- the honest statement that liveness is lost when the host withholds the network.
+
+## 2. Threat model and claims
+
+**The adversary may:**
+- control up to quorum − 1 of the configured RPC endpoints, which may lie, lag, fork, replay or hang;
+- control every delegate, gateway and DHT peer;
+- crash the publisher, wipe `/data`, and partition it;
+- skew the host clock;
+- compromise the delegate's key.
+
+**It may not:**
+- forge the owner's signature;
+- control `quorum` endpoints at once;
+- rewrite Base history deeper than `confirmations`;
+- skew the clocks of resolvers.
+
+**Safety, under those assumptions:**
+1. Every record carries a state the anchor held at a quorum-agreed canonical block.
+2. A publisher never signs a lower IPNS sequence than one it has accepted or recovered, nor the same sequence with
+   another value.
+3. A state superseded at block time P (by a pin, a revocation or a publish) appears only in records whose EOL is at most
+   P + `authorityTtlSecs`. The EOL bound is derived from the attested block timestamp, so a host that partitions the
+   publisher, or moves its clock, cannot extend it.
+4. The delegate can choose a CID, and nothing else.
+
+**Liveness, not claimed under attack:**
+- Without a quorum, a working delegate (or the DHT), and storage that holds the CID, nothing new is published.
+- After `authorityTtlSecs` without a successful round, signing stops; the last record lapses at its EOL. This is the
+  price of claim 3.
+- In normal operation, a change is observed within `pollSecs`, plus the confirmations, plus one round.
+
+**Clock:** a slow host clock makes old blocks look fresh to the freshness check. Claim 3 still holds, because the EOL
+comes from the block. The publisher refuses blocks more than 120 s ahead of its clock.
+
+## 3. Dependencies, not authorities
+
+| Dependency | Role | If it fails or lies |
+| --- | --- | --- |
+| RPC providers (`releaseAnchor.rpcs`) | the chain view, quorum-checked | fewer than quorum faulty: no effect. Otherwise: refused rounds (liveness only), unless `quorum` collude (the assumption) |
+| Delegated routing (`delegates`), DHT, IPNI | distribution of the signed record; sequence recovery | slower or no propagation. A higher recovered sequence makes the publisher refuse (safe) |
+| Replicated storage of the site CAR | resolvability of the content | the name resolves to a CID that cannot be fetched. The delegate tool refuses to publish a CID unless at least `--min-gateways` gateways serve its complete DAG (a verified CAR: every block and file) |
+| Enclave origins (the fleet RPC, the app's own HTTP surface, the site hosts) | conveniences | none is in the authority path. The tests run with an Enclave RPC that hangs and an Enclave delegate whose port is closed |
+
+None of these has a default that chooses the value: `rpcs` has no default, and `delegates` and `bootstrap` defaults
+only distribute.
+
+## 4. Sequence offset, migration, identity
+
+- **Cutover from `value`:** pick `sequenceOffset` > (the highest sequence ever published) − 1. The publisher refuses
+  a lower mapping that it can see; it cannot see records it cannot reach.
+- **A new anchor contract:**
+  1. deploy it;
+  2. `setConfig` with the new contract and codeHash, and an offset above the old mapped sequence;
+  3. then `setDelegate(0, 0)` on the old anchor. That is reversible, and the owner keeps the old anchor and its
+     ownership. **Do not call `retire`:** it freezes the contract forever, and no migration needs it. The owner
+     migrates by changing the publisher's config, which stays under the owner's control (and the platform
+     administrator's, where the deployment is governed that way).
+
+  The high-water is per (chainId, contract), so the old one does not block the new one. `successor` is never
+  followed automatically.
+- **A new IPNS key** is a new name, so it needs a new anchor: `nameHash` is immutable and part of the codehash.
+- **Two publishers with the same key and anchor** produce the same (sequence, value). With different offsets, the higher
+  one wins, so stop or reconfigure the other one.
+- **Ownership:** `transferOwnership` → `acceptOwnership`. Both are public events, and the delegate is cleared.
+
+## 5. Integration (shared files are not edited here)
+
+**Unattended release in CI, after the existing `deliver` step reports `active`** (no `--publish`):
+
+```yaml
+- name: anchor release
+  env:   # secrets reach the shell as environment, never interpolated into the script
+    ANCHOR_RPC: ${{ vars.ANCHOR_RPC }}
+    ANCHOR_CONTRACT: ${{ vars.ANCHOR_CONTRACT }}
+    KS: ${{ secrets.ANCHOR_DELEGATE_KEYSTORE }}
+    PW: ${{ secrets.ANCHOR_DELEGATE_PASSWORD }}
+  run: |
+    umask 077
+    printf '%s' "$KS" > "$RUNNER_TEMP/ks.json"
+    printf '%s' "$PW" > "$RUNNER_TEMP/pw"
+    node tools/ipns-release-anchor/scripts/anchor-release.mjs publish --rpc "$ANCHOR_RPC" --contract "$ANCHOR_CONTRACT" \
+      --cid "$CID" --keystore "$RUNNER_TEMP/ks.json" --password-file "$RUNNER_TEMP/pw" \
+      --gateway https://gw1.example --gateway https://gw2.example --min-gateways 2
+```
+
+The repository's actual step is in `.github/workflows/deploy.yml` ("Publish through the release anchor"). The release
+tool admits a CID only when `--min-gateways` gateways each serve its **complete** DAG: their `?format=car` export must
+verify with site-release's `scripts/site-release/car.mjs` (every block hashes to its CID and is reachable from the
+root, and every file reassembles), bounded by `--max-car-bytes`. A root block alone proves nothing about the
+children.
+
+## 6. Owner steps (each one is an owner signature; none was done here)
+
+1. Deploy `ReleaseAnchor(owner, nameHash, initialCid)` on Base:
+   - `nameHash` is the `anchor-name-hash` printed by `ipns-publisher id <key>`;
+   - `initialCid` is the release currently published.
+2. Verify the deployment: `node scripts/expected-codehash.mjs <nameHash> --code $(cast code <addr>)` prints
+   `matchesOnchain: true` and the `codeHash`.
+3. Appoint the delegate: `setDelegate(<delegate>, <now + ≤ 180 days>)`. Then fund the delegate with Base ETH; a publish
+   costs at most about 132k gas (the forge gas report, for a 128-byte CID).
+4. Configure the publisher: `enclave config set <deployment>` with `releaseAnchor` added and `value` removed. This
+   needs:
+   - three or more independent https RPC providers, with `quorum` ≥ 2;
+   - `sequenceOffset` above the highest published sequence.
+5. Every ≤ 180 days: renew with `setDelegate`. To revoke at any time: `setDelegate(0, 0)`, or `pin(cid)`.
