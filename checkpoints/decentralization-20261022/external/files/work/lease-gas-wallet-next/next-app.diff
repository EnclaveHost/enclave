< async function verify(){el('verify').disabled=true;try{const r=await api('/result',{hash});el('status').textContent='Confirmed on Base: '+r.transactionHash+'. The reserve is verified. Executor setup and app enrollment are still separate steps.';el('verify').hidden=true;}catch(e){el('status').textContent='Submitted '+hash+'. Verification pending: '+e.message;}finally{el('verify').disabled=false;}}
