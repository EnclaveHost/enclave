index 0000000000000000000000000000000000000000..44bb38651aa0a65f9604881766972ff32b3deaf5
--- /dev/null
+++ b/network/lease-relay-check.mjs
@@ -0,0 +1,89 @@
+// lease-relay-check.mjs - the lease relay release's configuration check (docs/network/lease-relay-release.md). The
+// systemd unit runs it before every start (ExecStartPre); an operator can run it by hand. It has NO imports beyond
+// node: builtins, so it runs from the release directory without node_modules.
+//
+// Every setting is explicit; nothing has a default (in particular no float, no quorum, no port):
+//   LEASE_RELAY_RECORD, LEASE_RELAY_DIGEST    the reviewed deployment record file and its sha256 ("sha256:<hex>")
+//   LEASE_RELAY_RPCS, LEASE_RELAY_QUORUM      2..16 distinct https RPCs and a strict majority of at least 2
+//   LEASE_RELAY_MAX_FLOAT_ETH, _MIN_FLOAT_ETH the hot key's cap and refill threshold (min < max, both > 0)
+//   LEASE_RELAY_LISTEN                        a loopback host:port; TLS is terminated in front of it
+//   LEASE_RELAY_KEY_FILE                      owner-only (0600/0400) regular file; its CONTENT is never read here
+//   LEASE_RELAY_ARTIFACT_SHA256               the reviewed lease-relay.mjs this directory must hold
+// Exit 0 with a one-line summary, or 1 listing every problem. No RPC is contacted, no key is read, nothing is written.
+import fs from "node:fs";
+import path from "node:path";
+import { createHash } from "node:crypto";
+import { fileURLToPath } from "node:url";
+
+const DECIMAL = /^(0|[1-9][0-9]{0,6})(\.[0-9]{1,18})?$/;
+const wei = (s) => { const [i, f = ""] = s.split("."); return BigInt(i) * 10n ** 18n + BigInt((f + "0".repeat(18)).slice(0, 18)); };
+
+/** -> { ok, problems[], summary } for an environment object and the release directory holding lease-relay.mjs */
+export function checkRelayConfig(env, { releaseDir, nodeVersion = process.versions.node } = {}) {
+  const problems = [], need = (k) => { const v = String(env[k] ?? "").trim(); if (!v) problems.push(`${k} is not set (there is no default)`); return v; };
+  if (Number(String(nodeVersion).split(".")[0]) < 20) problems.push(`node ${nodeVersion}: the release needs node 20 or later`);
+  const recordFile = need("LEASE_RELAY_RECORD"), digest = need("LEASE_RELAY_DIGEST");
+  if (digest && !/^sha256:[0-9a-f]{64}$/.test(digest)) problems.push("LEASE_RELAY_DIGEST must be sha256:<64 lowercase hex>");
+  if (recordFile) {
+    try {
+      const st = fs.lstatSync(recordFile);
+      if (!st.isFile() || st.size > 64 * 1024) problems.push(`${recordFile} must be a regular file of at most 64 KiB`);
+      else {
+        const bytes = fs.readFileSync(recordFile), got = "sha256:" + createHash("sha256").update(bytes).digest("hex");
+        if (digest && got !== digest) problems.push(`${recordFile} is ${got}, not the reviewed ${digest}`);
+        let j = null; try { j = JSON.parse(bytes); } catch { problems.push(`${recordFile} is not JSON`); }
+        if (j && (j.format !== "enclave-lease-gas-deployment/v1" || !Number.isSafeInteger(j.chainId))) problems.push(`${recordFile} is not an enclave-lease-gas-deployment/v1 record`);
+      }
+    } catch (e) { problems.push(`${recordFile}: ${e.code || e.message}`); }
+  }
+  const rpcs = need("LEASE_RELAY_RPCS").split(",").map((s) => s.trim()).filter(Boolean), quorumRaw = need("LEASE_RELAY_QUORUM");
+  if (rpcs.length && (rpcs.length < 2 || rpcs.length > 16)) problems.push(`LEASE_RELAY_RPCS lists ${rpcs.length} RPC(s): 2..16 independent providers are required`);
+  const hosts = new Set();
+  for (const u of rpcs) {
+    let url = null; try { url = new URL(u); } catch { problems.push(`LEASE_RELAY_RPCS: ${u.slice(0, 80)} is not a URL`); continue; }
+    if (url.protocol !== "https:" || url.username || url.password || url.hash) problems.push(`LEASE_RELAY_RPCS: ${url.origin} must be https, without credentials or fragment`);
+    const id = url.host.toLowerCase().replace(/\.$/, "");
+    if (hosts.has(id)) problems.push(`LEASE_RELAY_RPCS: ${id} appears twice (one provider is one vote)`);
+    hosts.add(id);
+  }
+  if (quorumRaw) {
+    const q = Number(quorumRaw);
+    if (!/^[0-9]+$/.test(quorumRaw) || q < 2 || q > rpcs.length || q <= rpcs.length / 2) problems.push(`LEASE_RELAY_QUORUM=${quorumRaw} must be a strict majority (and at least 2) of the ${rpcs.length} RPCs`);
+  }
+  const maxF = need("LEASE_RELAY_MAX_FLOAT_ETH"), minF = need("LEASE_RELAY_MIN_FLOAT_ETH");
+  for (const [k, v] of [["LEASE_RELAY_MAX_FLOAT_ETH", maxF], ["LEASE_RELAY_MIN_FLOAT_ETH", minF]]) if (v && (!DECIMAL.test(v) || wei(v) === 0n)) problems.push(`${k}=${v} must be a positive decimal ETH amount`);
+  if (DECIMAL.test(maxF) && DECIMAL.test(minF) && wei(minF) >= wei(maxF)) problems.push(`LEASE_RELAY_MIN_FLOAT_ETH=${minF} must be below LEASE_RELAY_MAX_FLOAT_ETH=${maxF}`);
+  const listen = need("LEASE_RELAY_LISTEN");
+  if (listen) {
+    const m = /^(127\.0\.0\.1|\[::1\]):([0-9]{1,5})$/.exec(listen);
+    if (!m || Number(m[2]) < 1 || Number(m[2]) > 65535) problems.push(`LEASE_RELAY_LISTEN=${listen} must be 127.0.0.1:PORT or [::1]:PORT (an explicit port; TLS is terminated in front)`);
+  }
+  const keyFile = need("LEASE_RELAY_KEY_FILE");
+  if (keyFile) {
+    try {
+      const st = fs.statSync(keyFile);
+      if (!st.isFile()) problems.push(`${keyFile} is not a regular file`);
+      else if (process.platform !== "win32" && (st.mode & 0o077)) problems.push(`${keyFile} is mode ${(st.mode & 0o777).toString(8)}: it must be readable by its owner only`);
+      else if (st.size > 256) problems.push(`${keyFile} is ${st.size} bytes: one hex key is expected`);
+    } catch (e) { problems.push(`${keyFile}: ${e.code || e.message}`); }
+  }
+  const want = need("LEASE_RELAY_ARTIFACT_SHA256");
+  if (want && !/^[0-9a-f]{64}$/.test(want)) problems.push("LEASE_RELAY_ARTIFACT_SHA256 must be 64 lowercase hex");
+  else if (want && releaseDir) {
+    try {
+      const got = createHash("sha256").update(fs.readFileSync(path.join(releaseDir, "lease-relay.mjs"))).digest("hex");
+      if (got !== want) problems.push(`${path.join(releaseDir, "lease-relay.mjs")} is ${got}, not the reviewed ${want}`);
+    } catch (e) { problems.push(`lease-relay.mjs: ${e.code || e.message}`); }
+  }
+  const summary = problems.length ? null
+    : `lease relay configuration ok: record ${digest.slice(7, 19)}..., ${rpcs.length} RPCs (quorum ${quorumRaw}), float ${minF}..${maxF} ETH, listen ${listen}, artifact ${want.slice(0, 12)}...`;
+  return { ok: !problems.length, problems, summary };
+}
+
+// run directly (also through a symlinked release directory: both sides compared as real paths)
+const self = fileURLToPath(import.meta.url);
+if (process.argv[1] && fs.existsSync(process.argv[1]) && fs.realpathSync(process.argv[1]) === fs.realpathSync(self)) {
+  const r = checkRelayConfig(process.env, { releaseDir: path.dirname(fs.realpathSync(self)) });
+  if (r.ok) console.log(r.summary);
+  else { for (const p of r.problems) console.error(`[lease-relay-check] ${p}`); process.exitCode = 1; }
+}
diff --git a/relay/lease-relay.env.example b/relay/lease-relay.env.example
new file mode 100644
index 0000000000000000000000000000000000000000..bac9450fd4ae86c3f72bb7db054ef3eaa899d5f0
--- /dev/null
+++ b/relay/lease-relay.env.example
@@ -0,0 +1,16 @@
+# /etc/enclave-lease-relay/relay.env for relay/systemd/enclave-lease-relay.service. EVERY line is required and has no
+# default; lease-relay-check.mjs refuses to start the relay otherwise. Replace each <...>; never put the key here.
+# The reviewed deployment record (enclave-lease-gas-deployment/v1) and its sha256, from the owner/root review
+LEASE_RELAY_RECORD=/etc/enclave-lease-relay/deployment.json
+LEASE_RELAY_DIGEST=sha256:<64 hex of deployment.json>
+# 2..16 independent https Base RPC providers and a strict majority of them (at least 2)
+LEASE_RELAY_RPCS=<https://rpc-a>,<https://rpc-b>,<https://rpc-c>
+LEASE_RELAY_QUORUM=<2 of 3, 3 of 4, ...>
+# the hot key's float, in ETH: the relay refuses to start above MAX and warns below MIN. Choose both from measured
+# operation cost and expected concurrency (docs/network/lease-relay-release.md); a compromise of the box can lose MAX.
+LEASE_RELAY_MAX_FLOAT_ETH=<cap>
+LEASE_RELAY_MIN_FLOAT_ETH=<refill threshold, below cap>
+# loopback only, with a fixed port: the TLS front end (the box's existing reverse proxy) routes https to it
+LEASE_RELAY_LISTEN=127.0.0.1:<port>
+# the reviewed lease-relay.mjs (manifest.json artifact.sha256) that /opt/enclave-lease-relay/current must hold
+LEASE_RELAY_ARTIFACT_SHA256=<64 hex>
diff --git a/relay/systemd/enclave-lease-relay.service b/relay/systemd/enclave-lease-relay.service
new file mode 100644
index 0000000000000000000000000000000000000000..fcd4ad029dc54f5787098faa1d02facb129be84b
--- /dev/null
+++ b/relay/systemd/enclave-lease-relay.service
@@ -0,0 +1,47 @@
+# The permissionless app-funded lease relay (network/lease-relay-service.mjs), from a standalone release directory built
+# by scripts/build-lease-relay-release.mjs. Template: review every value; docs/network/lease-relay-release.md has the
+# staging, TLS route and rollback steps. Nothing in the repository installs or starts this unit.
+#   /opt/enclave-lease-relay/releases/<artifact sha256>/   lease-relay.mjs, lease-relay-check.mjs, manifest.json
+#   /opt/enclave-lease-relay/current -> releases/<sha256>   the release this unit runs (switch it to stage or roll back)
+#   /etc/enclave-lease-relay/relay.env                      every setting, explicit (relay.env.example)
+#   /etc/enclave-lease-relay/relay.key                      the hot key (0600 root): handed to the service as a credential
+[Unit]
+Description=Enclave app-funded lease relay
+After=network-online.target
+Wants=network-online.target
+StartLimitIntervalSec=600
+StartLimitBurst=5
+
+[Service]
+EnvironmentFile=/etc/enclave-lease-relay/relay.env
+# the key reaches the service only as a systemd credential (a private, read-only copy); the env names its path
+LoadCredential=relay-key:/etc/enclave-lease-relay/relay.key
+Environment=LEASE_RELAY_KEY_FILE=%d/relay-key
+WorkingDirectory=/opt/enclave-lease-relay/current
+# refuses to start unless every setting is explicit and valid and the directory holds the reviewed artifact
+ExecStartPre=/usr/bin/node /opt/enclave-lease-relay/current/lease-relay-check.mjs
+# --preserve-symlinks-main: the service starts only when its module URL equals the path it was run by; through the
+# `current` symlink Node would otherwise resolve the URL to releases/<sha256>/ and the relay would exit without serving
+ExecStart=/usr/bin/node --preserve-symlinks-main /opt/enclave-lease-relay/current/lease-relay.mjs
+Restart=on-failure
+RestartSec=10
+DynamicUser=yes
+NoNewPrivileges=yes
+ProtectSystem=strict
+ProtectHome=yes
+PrivateTmp=yes
+PrivateDevices=yes
+ProtectKernelTunables=yes
+ProtectKernelModules=yes
+ProtectControlGroups=yes
+RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
+RestrictNamespaces=yes
+LockPersonality=yes
+SystemCallArchitectures=native
+# measured (test/lease-relay-release.test.mjs, docs/network/lease-relay-release.md): set from the measured peak, with margin
+MemoryMax=192M
+TasksMax=64
+LimitNOFILE=4096
+
+[Install]
+WantedBy=multi-user.target
diff --git a/scripts/build-lease-relay-release.mjs b/scripts/build-lease-relay-release.mjs
new file mode 100644
index 0000000000000000000000000000000000000000..53d9eccdba76bd2937d8c2ccd80f5f73b2179f19
--- /dev/null
+++ b/scripts/build-lease-relay-release.mjs
@@ -0,0 +1,39 @@
+#!/usr/bin/env node
+// A standalone lease relay release (network/lease-relay-service.mjs; docs/network/lease-relay-release.md), built from
+// THIS repository: one esbuild bundle (no node_modules beside it), its input manifest, and the dependency-free
+// configuration check the service unit runs before every start.
+//   node scripts/build-lease-relay-release.mjs OUTDIR [--expect-sha256 HEX]
+// OUTDIR/lease-relay.mjs         the service (node >= 20); same options as the reviewed root build, so the same inputs
+//                                give the same bytes
+// OUTDIR/lease-relay-check.mjs   network/lease-relay-check.mjs, copied verbatim (no imports)
+// OUTDIR/manifest.json           sha256/bytes of both, and the sha256 of every bundled input
+// Nothing here reads a key, contacts an RPC or starts a service.
+import fs from "node:fs";
+import path from "node:path";
+import { createHash } from "node:crypto";
+import { fileURLToPath } from "node:url";
+import { build } from "esbuild";
+
+const ROOT = path.resolve(path.dirname(fileURLToPath(import.meta.url)), "..");
+const args = process.argv.slice(2), out = args[0] && !args[0].startsWith("--") ? path.resolve(args[0]) : null;
+const ex = args.indexOf("--expect-sha256"), expect = ex >= 0 ? String(args[ex + 1] || "") : null;
+if (!out || (expect !== null && !/^[0-9a-f]{64}$/.test(expect))) {
+  console.error("usage: node scripts/build-lease-relay-release.mjs OUTDIR [--expect-sha256 HEX]"); process.exit(2);
+}
+const sha = (b) => createHash("sha256").update(b).digest("hex");
+// preserveSymlinks: inputs keep their repository-relative paths even in a checkout built from links (in a plain checkout
+// it changes nothing; the bundle embeds no module paths either way)
+const r = await build({ absWorkingDir: ROOT, entryPoints: ["network/lease-relay-service.mjs"], platform: "node", format: "esm", target: "node20",
+  bundle: true, minify: true, write: false, metafile: true, preserveSymlinks: true });
+const bundle = Buffer.from(r.outputFiles[0].contents), check = fs.readFileSync(path.join(ROOT, "network/lease-relay-check.mjs"));
+const inputs = {};
+for (const rel of Object.keys(r.metafile.inputs).sort()) inputs[rel] = sha(fs.readFileSync(path.resolve(ROOT, rel)));
+const manifest = { format: "enclave-lease-relay-release/v1", nodeTarget: "node20", entry: "network/lease-relay-service.mjs",
+  artifact: { file: "lease-relay.mjs", sha256: sha(bundle), bytes: bundle.length },
+  check: { file: "lease-relay-check.mjs", sha256: sha(check), bytes: check.length }, inputs };
+if (expect && manifest.artifact.sha256 !== expect) { console.error(`lease-relay.mjs is ${manifest.artifact.sha256}, not the expected ${expect}: not written`); process.exit(1); }
+fs.mkdirSync(out, { recursive: true });
+fs.writeFileSync(path.join(out, "lease-relay.mjs"), bundle);
+fs.writeFileSync(path.join(out, "lease-relay-check.mjs"), check);
+fs.writeFileSync(path.join(out, "manifest.json"), JSON.stringify(manifest, null, 1) + "\n");
+console.log(JSON.stringify({ out, artifact: manifest.artifact, check: manifest.check, inputs: Object.keys(inputs).length }));
diff --git a/scripts/test-fixtures/snapshot-aa-code.mjs b/scripts/test-fixtures/snapshot-aa-code.mjs
