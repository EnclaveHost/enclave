+    console.log(`# lease relay memory: peak RSS ${(m.peakKiB / 1024).toFixed(1)} MiB, RSS after the run ${(m.rssKiB / 1024).toFixed(1)} MiB (claim + release + ${bad.length} refused requests)`);
