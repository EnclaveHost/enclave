+    return rec;
+  }
+
+  let running = null;
+  async function stepOnce() {
+    if (TERMINAL.has(rec.status) && !(rec.tx && rec.tx.state === "pending")) return rec;
+    const lp = localProblem();
+    if (lp) return set("refused", lp);
+    if (rec.tx && rec.tx.state === "pending") {
