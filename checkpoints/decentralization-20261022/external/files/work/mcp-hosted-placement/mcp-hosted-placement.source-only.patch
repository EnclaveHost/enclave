+// The hosted independent MCP adapter (mcp/server.mjs --remote, docs/network/hosted-mcp.md) as ONE file for the measured
+// control guest (/opt/metal/mcp-server.bundle.mjs, started by gsup.mjs for a bound config with an mcp member). The same
+// pattern as scripts/build-metal-lease-gas.mjs: exact inputs recorded in a manifest; --check refuses a stale one. Not
+// minified, so the bytes inside the measurement stay reviewable.
+import { build } from "esbuild";
+import fs from "node:fs/promises";
+import path from "node:path";
+import { fileURLToPath } from "node:url";
+import { createHash } from "node:crypto";
+const root = path.resolve(path.dirname(fileURLToPath(import.meta.url)), "..");
+const entry = "mcp/server.mjs", output = path.join(root, "metal/guest/mcp-server.bundle.mjs");
+const args = process.argv.slice(2);
+const outIdx = args.indexOf("--out");
+if (args.some((a, i) => !(a === "--check" || a === "--out" || (outIdx >= 0 && i === outIdx + 1)))) throw new Error("usage: build-mcp-guest-bundle.mjs [--check] [--out DIR]");
+const result = await build({
+  absWorkingDir: root, entryPoints: [entry], outfile: output,
+  platform: "node", format: "esm", target: "node20", bundle: true, minify: false, write: false, metafile: true, legalComments: "none", preserveSymlinks: true,
+  // esm output of cjs dependencies needs a require for node builtins
+  banner: { js: "// Generated by scripts/build-mcp-guest-bundle.mjs from mcp/server.mjs; do not edit.\nimport { createRequire as __mcpCreateRequire } from 'node:module'; const require = __mcpCreateRequire(import.meta.url);" },
+});
+const bytes = Buffer.from(result.outputFiles[0].contents);
+const sha = (b) => createHash("sha256").update(b).digest("hex");
+// preserveSymlinks keeps every input at its path in this tree (a symlinked node_modules included), so the manifest names
+// each nested dependency copy apart (node_modules/ox and relay/node_modules/ox differ)
+const inputs = {};
+for (const rel of Object.keys(result.metafile.inputs).sort()) {
+  if (rel.startsWith("..") || path.isAbsolute(rel)) throw new Error(`bundle input outside the tree: ${rel}`);
+  inputs[rel] = sha(await fs.readFile(path.resolve(root, rel)));
+}
+const manifest = JSON.stringify({ bundle: "metal/guest/mcp-server.bundle.mjs", entry, sha256: sha(bytes), bytes: bytes.length, inputs }, null, 2) + "\n";
+if (args.includes("--check")) {
+  if (!bytes.equals(await fs.readFile(output))) throw new Error("the hosted MCP guest bundle is stale; run node scripts/build-mcp-guest-bundle.mjs");
