+        for (uint256 i = 0; i < enc.length; i++) { if (enc[i]) hasE = true; else others++; }
+        uint256 n = others + (hasE ? 1 : 0);
+        uint256 wE = n >= 3 ? (hasE ? 1 : 0) : others + 1;
+        if (k <= wE) { for (uint256 i = 0; i < enc.length; i++) if (enc[i]) return ms[i].identity; }
+        uint256 next = wE + 1;
