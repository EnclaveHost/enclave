+        bytes[] memory hs = new bytes[](2);
+        hs[0] = _hostSig(e);
+        hs[1] = _psign(0x2000 + 30, _hostDigest(borrow));     // signed by the fake host's operator
+        uint32[] memory dl = _seq(1);
