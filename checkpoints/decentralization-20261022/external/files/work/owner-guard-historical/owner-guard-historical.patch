+test("a vault of the SUPERSEDED factory (2026-07-21) owning a record is recognized and refused the same way; its binding is reported unverified here", T, async () => {
+  const o = await W.owner(); const id = await W.create(o, { fund6: 0n });
+  const vault = privateKeyToAccount(generatePrivateKey()).address;
+  await W.rpc("anvil_setCode", [vault, clone1167(CREDIT_VAULT_HISTORICAL.implementation)]);   // exactly what that factory's CREATE2 deploys
+  await W.write(o.key, W.addr.ledger, W.A.ledger.abi, "transferDeployment", [id, vault]);
+  const s = (await cli(lg("status", id))).json.apps[0];
+  assert.equal(s.ownerKind.kind, "credit-vault");
+  assert.match(s.ownerKind.detail, /^UNSUPPORTED: EnclaveCreditVault \(factory 2026-07-21, superseded 2026-08-03\) 0x848[aA]8[aA]89.* \(binding not verified\)$/,
+    "no implementation code exists at that address on this local chain, so factory()/implementation() cannot be read: still refused, and said so");
