+      headers: { "content-type": "application/octet-stream", "content-length": blob.length } }, (res) => { res.resume(); res.on("end", () => (res.statusCode >= 200 && res.statusCode < 300 ? ok() : no(new Error(`HTTP ${res.statusCode}`)))); });
