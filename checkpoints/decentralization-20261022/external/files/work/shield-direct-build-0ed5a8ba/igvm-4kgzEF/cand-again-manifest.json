{
  "guest_arch": "x64",
  "guest_configs": [
    {
      "guest_svn": 13,
      "max_vtl": 2,
      "isolation_type": {
        "vbs": {
          "enable_debug": false
        }
      },
      "image": {
        "openhcl": {
          "command_line": "OPENHCL_FORCE_LOAD_VTL0_IMAGE=linux",
          "memory_page_count": 16384,
          "memory_page_base": 32768,
          "linux": {
            "use_initrd": true,
            "command_line": "console=ttyS0 rdinit=/init loglevel=3 report_host=9001"
          },
          "static_command_line": true
        }
      }
    }
  ]
}