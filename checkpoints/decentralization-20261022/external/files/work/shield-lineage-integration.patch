+			}
+			asked <- struct{}{}
+			c.Close()
+		}
+	}()
+	for _, ip := range []string{"127.0.0.1", "10.1.2.3", "169.254.169.254", "100.64.0.1", "::1", "fe80::1", "::ffff:192.168.1.1", "203.0.113.9"} {
