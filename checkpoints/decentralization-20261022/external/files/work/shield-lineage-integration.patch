@@ -0,0 +1,205 @@
+//go:build shielddirect && bootstrapdirect && !releaselab
+
+package main
+
+import (
+	"bytes"
+	"context"
+	"encoding/base64"
+	"encoding/binary"
+	"encoding/hex"
+	"encoding/json"
