+		{"nx.example", 1, 2, ""},            // the host could not resolve it
+		{"intranet", 1, 3, ""},              // not a public DNS name: NXDOMAIN without asking the host
+		{"1.2.3.4.in-addr.arpa", 12, 0, ""}, // PTR: NOERROR, no data
