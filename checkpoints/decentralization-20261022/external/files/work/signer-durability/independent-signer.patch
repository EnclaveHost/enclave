+/** Every fs call made while fn runs, with the path behind each descriptor. */
+function spyFs(fn) {
+  const names = ["openSync", "writeSync", "fsyncSync", "closeSync", "renameSync"], orig = Object.fromEntries(names.map((k) => [k, fs[k]]));
+  const fds = new Map(), ev = [];
