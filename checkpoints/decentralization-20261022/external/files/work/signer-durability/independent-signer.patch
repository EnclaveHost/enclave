+  assert.equal(w.count("eth_signTransaction"), 1, `eth_signTransaction requests: ${w.count("eth_signTransaction")}; intents: ${summary(dir)}`);
+  assert.equal(out.filter((o) => o.v?.status === "success").length, 1);
