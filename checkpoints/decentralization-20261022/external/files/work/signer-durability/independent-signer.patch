+/** Two child processes on one journal: started together, each held at its nonce read until both reached it or finished. */
+async function raceProcesses(cfg) {
+  const kids = [0, 1].map((i) => child({ tree: TREE, chainRpc, from: A0.address, to: SINK, data: `0x0${i + 1}`, gate: true, ...cfg }));
+  for (const k of kids) await k.wait("READY");
+  for (const k of kids) k.send("START");
+  await until(() => kids.every((k) => k.has("ARRIVED") || k.has("RESULT")), 20000, "both children to reach the nonce read or finish");
+  const arrivedBeforeGo = kids.filter((k) => k.has("ARRIVED")).length;
+  for (const k of kids) k.send("GO");
+  for (const k of kids) await k.wait("RESULT", 30000);
+  return { results: kids.map((k) => k.result()), arrivedBeforeGo };
+}
+
+test("separate processes, one journal (wallet-send): the wallet is asked to send once; the other process is refused before reading the nonce", T, async () => {
+  const w = await walletServer(async (m) => m.method === "eth_signTransaction" ? { error: { code: -32601, message: "Method not found" } } : forward(chainRpc)(m));
+  const dir = jdir(), before = await nonceOf();
+  const { results, arrivedBeforeGo } = await raceProcesses({ url: w.url, mode: "wallet-send", journalDir: dir });
+  assert.equal(w.count("eth_sendTransaction"), 1, `eth_sendTransaction requests: ${w.count("eth_sendTransaction")}; intents: ${summary(dir)}`);
+  assert.equal(arrivedBeforeGo, 1);
+  assert.equal(results.filter((r) => r.ok).length, 1, JSON.stringify(results));
+  assert.equal(results.find((r) => !r.ok).code, "busy");
+  assert.equal(await nonceOf(), before + 1);
+});
+
+test("separate processes, one journal (sign): one signature request and one broadcast", T, async () => {
+  const w = await walletServer(forward(walletRpc));
+  const dir = jdir(), before = await nonceOf();
+  const { results } = await raceProcesses({ url: w.url, mode: "sign", journalDir: dir });
+  assert.equal(w.count("eth_signTransaction"), 1, `eth_signTransaction requests: ${w.count("eth_signTransaction")}; intents: ${summary(dir)}`);
+  assert.equal(results.filter((r) => r.ok).length, 1, JSON.stringify(results));
+  assert.equal(await nonceOf(), before + 1);
+});
+
+test("separate processes, one journal (handoff): one handoff intent", T, async () => {
+  const dir = jdir();
+  const { results } = await raceProcesses({ mode: "handoff", journalDir: dir });
+  const handoffs = S.intentJournal(dir).list().filter((r) => r.state === "handoff");
+  assert.equal(handoffs.length, 1, `unresolved handoff intents for one account: ${summary(dir)}`);
+  assert.equal(results.filter((r) => r.ok).length, 1, JSON.stringify(results));
+});
diff -ruN a/test/cli-independent-signer-reservation-cli.test.mjs b/test/cli-independent-signer-reservation-cli.test.mjs
--- a/test/cli-independent-signer-reservation-cli.test.mjs	1969-12-31 17:00:00.000000000 -0700
+++ b/test/cli-independent-signer-reservation-cli.test.mjs	2026-10-19 23:42:59.229338402 -0700
@@ -0,0 +1,136 @@
+// The CLI (cli/enclave.mjs, or the built bundle via ENCLAVE_CLI_ENTRY) with an external signer: one send in flight per
+// account and journal across separate CLI processes, recovery from a CLI killed mid-send, and an unreadable journal
+// file. The chain is anvil (chain 8453) read through two RPC origins; the second origin is a forwarder that can HOLD
+// every pending-nonce read, so two CLI processes are forced into the interleaving that raced before (both past the busy
+// check, both about to read nonce N). Only anvil's published dev keys are used; nothing leaves 127.0.0.1.
+//   run: node --test --test-concurrency=1 test/cli-independent-signer-reservation-cli.test.mjs
+//   bundle: ENCLAVE_CLI_ENTRY=cli/dist/enclave.mjs node --test ...
+import test, { before, after } from "node:test";
+import assert from "node:assert/strict";
+import fs from "node:fs";
+import os from "node:os";
+import net from "node:net";
+import http from "node:http";
+import path from "node:path";
+import { spawn, execFileSync } from "node:child_process";
+import { fileURLToPath } from "node:url";
+import { createPublicClient, http as viemHttp, defineChain } from "viem";
+import { privateKeyToAccount } from "viem/accounts";
+
+const REPO = path.resolve(path.dirname(fileURLToPath(import.meta.url)), "..");
+const CLI = process.env.ENCLAVE_CLI_ENTRY ? path.resolve(process.env.ENCLAVE_CLI_ENTRY) : path.join(REPO, "cli", "enclave.mjs");
+const A0 = privateKeyToAccount("0xac0974bec39a17e36ba4a6b4d238ff944bacb478cbed5efcae784d7bf4f2ff80");
+const A1 = privateKeyToAccount("0x59c6995e998f97a5a0044966f0945389dc9e86dae88c7a8412f4603b6b78690d");
+const local = defineChain({ id: 8453, name: "local-base", nativeCurrency: { name: "Ether", symbol: "ETH", decimals: 18 }, rpcUrls: { default: { http: [] } } });
+const integrated = fs.readFileSync(CLI, "utf8").includes("signer attach");
+const tools = (() => { try { execFileSync("anvil", ["--version"], { stdio: "ignore" }); } catch { return "needs Foundry's anvil"; } return integrated ? null : "needs the external-signer CLI integration"; })();
+const T = tools ? { skip: tools } : { timeout: 120000 };
+
+const procs = [], servers = [], clis = new Set();
+let chainRpc, forwarderRpc, tmp, pins;
+const held = [];            // pending-nonce reads held at the forwarder: [release]
+let holding = false;
+const freePort = () => new Promise((ok) => { const s = net.createServer(); s.listen(0, "127.0.0.1", () => { const p = s.address().port; s.close(() => ok(p)); }); });
+const call = async (url, method, params = []) => {
+  const j = await (await fetch(url, { method: "POST", headers: { "content-type": "application/json" }, body: JSON.stringify({ jsonrpc: "2.0", id: 1, method, params }) })).json();
+  return "error" in j ? { error: j.error } : { result: j.result };
+};
+const until = async (pred, ms, what) => { const end = Date.now() + ms; while (!pred()) { if (Date.now() > end) throw new Error(`timed out: ${what}`); await new Promise((r) => setTimeout(r, 10)); } };
+const releaseAll = () => { holding = false; for (const go of held.splice(0)) go(); };
+
+before(async () => {
+  if (tools) return;
+  const port = await freePort();
+  procs.push(spawn("anvil", ["--port", String(port), "--chain-id", "8453", "--silent", "--base-fee", "5000000"], { stdio: "ignore" }));
+  chainRpc = `http://127.0.0.1:${port}`;
+  const pc = createPublicClient({ chain: local, transport: viemHttp(chainRpc) });
+  for (let i = 0; i < 100; i++) { try { await pc.getChainId(); break; } catch { await new Promise((r) => setTimeout(r, 100)); } }
+  const srv = http.createServer(async (req, res) => {
+    let b = ""; for await (const c of req) b += c;
+    const m = JSON.parse(b);
+    const one = async (x) => {
+      if (holding && x.method === "eth_getTransactionCount" && x.params?.[1] === "pending") await new Promise((go) => held.push(go));
+      return { jsonrpc: "2.0", id: x.id, ...(await call(chainRpc, x.method, x.params)) };
+    };
+    res.writeHead(200, { "content-type": "application/json" });
+    res.end(JSON.stringify(Array.isArray(m) ? await Promise.all(m.map(one)) : await one(m)));
+  });
+  await new Promise((r) => srv.listen(0, "127.0.0.1", r));
+  servers.push(srv);
+  forwarderRpc = `http://127.0.0.1:${srv.address().port}`;
+  tmp = fs.mkdtempSync(path.join(os.tmpdir(), "cli-signer-reservation-"));
+  pins = path.join(tmp, "pins.json");
+  const a = (n) => "0x" + n.toString(16).padStart(40, "0");
+  fs.writeFileSync(pins, JSON.stringify({ version: 1, chainId: 8453, contracts: { registry: a(1), deployments: a(2), appCatalog: a(3), proofOfTime: a(4),
+    enclavePay: a(0), verificationFees: a(0), sessionVaultFactory: a(0), secretVaultV2: a(0) } }));
+});
+after(() => { releaseAll(); for (const p of clis) p.kill("SIGKILL"); for (const s of servers) { s.closeAllConnections(); s.close(); } for (const p of procs) p.kill("SIGKILL"); if (tmp) fs.rmSync(tmp, { recursive: true, force: true }); });
+
+function cli(args, { home }) {
+  const p = spawn(process.execPath, [CLI, ...args], { env: { PATH: process.env.PATH, HOME: home, XDG_CONFIG_HOME: path.join(home, ".config"), ENCLAVE_ADDRESS_BOOK: "" }, stdio: ["ignore", "pipe", "pipe"] });
+  clis.add(p);
+  let out = "", err = "";
+  p.stdout.on("data", (d) => (out += d)); p.stderr.on("data", (d) => (err += d));
+  const done = new Promise((resolve) => p.on("close", (code, signal) => { clis.delete(p); resolve({ code, signal, out, err }); }));
+  return Object.assign(done, { p, exited: () => !clis.has(p) });
+}
+const IND = (home) => ["--independent", "--contract-pins", pins, "--rpc", `${chainRpc},${forwarderRpc}`, "--confirmations", "0", "--state-dir", path.join(home, "state")];
+const handoff = (home) => [...IND(home), "--json", "--signer-mode", "handoff", "--from", A0.address, "--yes", "host", "fund", "--address", A1.address, "--eth", "0.001"];
+const handoffOf = (r) => { const i = r.out.indexOf("{\n"); return i < 0 ? null : JSON.parse(r.out.slice(i)); };
+const list = async (home) => { const l = await cli([...IND(home), "--json", "signer", "list"], { home }); assert.equal(l.code, 0, l.err); return JSON.parse(l.out); };
+
+test("two CLI processes on one state dir, held at the pending-nonce read: one handoff; the other is refused before reading the nonce", T, async () => {
+  const home = path.join(tmp, "race");
+  holding = true;
+  const runs = [cli(handoff(home), { home }), cli(handoff(home), { home })];
+  await until(() => held.length + runs.filter((r) => r.exited()).length >= 2, 30000, "both CLIs at the nonce read or finished");
+  const heldBeforeGo = held.length;
+  releaseAll();
+  const [a, b] = await Promise.all(runs);
+  const handed = [a, b].map(handoffOf).filter(Boolean);
+  assert.equal(handed.length, 1, `handoffs printed: ${handed.length} (${handed.map((h) => `${h.handoff} nonce ${h.transaction.nonce}`).join("; ")})`);
+  assert.equal(heldBeforeGo, 1, "only one CLI reached the pending-nonce read");
+  const refused = [a, b].find((r) => !handoffOf(r));
+  assert.notEqual(refused.code, 0); assert.match(refused.err, /signing reservation|is unresolved/);
+  const l = await list(home);
+  assert.equal(l.intents.filter((r) => r.state === "handoff").length, 1);
+  assert.equal(l.reservations.length, 1); assert.equal(l.reservations[0].intent, handed[0].handoff);
+});
+
+test("a CLI killed after taking the reservation: the next CLI is refused and names it; signer release (explicit) lets sends go on", T, async () => {
+  const home = path.join(tmp, "killed");
+  holding = true;
+  const run = cli(handoff(home), { home });
+  await until(() => held.length === 1, 30000, "the CLI at the nonce read");
+  run.p.kill("SIGKILL");
+  assert.equal((await run).signal, "SIGKILL");
+  releaseAll();
+  const l = await list(home);
+  assert.deepEqual(l.intents, []); assert.equal(l.reservations.length, 1);
+  assert.equal(l.reservations[0].intent, null); assert.equal(l.reservations[0].pid, run.p.pid);
+  const key = l.reservations[0].key;
+  const busy = await cli(handoff(home), { home });
+  assert.notEqual(busy.code, 0); assert.match(busy.err, new RegExp(`signing reservation ${key.replace(/[/]/g, "\\/")}.*signer release ${key.replace(/[/]/g, "\\/")}`, "s"));
+  const text = await cli([...IND(home), "signer", "list"], { home });
+  assert.match(text.out, /held with no intent recorded .*signer release/);
+  const rel = await cli([...IND(home), "signer", "release", key], { home });
+  assert.equal(rel.code, 0, rel.err); assert.match(rel.out, /released/);
+  const ok = await cli(handoff(home), { home });
+  assert.equal(ok.code, 0, ok.err); assert.match(handoffOf(ok).handoff, /^tx-/);
+});
+
+test("an unreadable intent file stops every CLI send (its content never printed) until signer quarantine sets it aside", T, async () => {
+  const home = path.join(tmp, "unreadable");
+  const dir = path.join(home, "state", "signer");
+  fs.mkdirSync(dir, { recursive: true, mode: 0o700 });
+  fs.writeFileSync(path.join(dir, "tx-corrupt1-deadbeef.json"), `{"format":"enclave-signer-intent/v1","raw":"0x02f8${"cd".repeat(60)}","sta`, { mode: 0o600 });
+  const r = await cli(handoff(home), { home });
+  assert.notEqual(r.code, 0); assert.match(r.err, /cannot be read .*signer quarantine tx-corrupt1-deadbeef/);
+  const l = await cli([...IND(home), "signer", "list"], { home });
+  assert.match(l.out, /UNREADABLE tx-corrupt1-deadbeef\.json/);
+  for (const x of [r.err, r.out, l.out, l.err]) assert.ok(!x.includes("cdcdcdcd"), "the file's content is never printed");
+  const q = await cli([...IND(home), "signer", "quarantine", "tx-corrupt1-deadbeef"], { home });
+  assert.equal(q.code, 0, q.err); assert.match(q.out, /set aside/);
+  const ok = await cli(handoff(home), { home });
+  assert.equal(ok.code, 0, ok.err);
+});
diff -ruN a/test/helpers/signer-child.mjs b/test/helpers/signer-child.mjs
--- a/test/helpers/signer-child.mjs	1969-12-31 17:00:00.000000000 -0700
+++ b/test/helpers/signer-child.mjs	2026-10-19 23:42:59.229943370 -0700
@@ -0,0 +1,62 @@
+// One external-signer send in its OWN process, for the cross-process and crash tests of cli/independent-signer.mjs.
+//   node signer-child.mjs '<json>'   { tree, chainRpc, journalDir, mode, url, from, to, data, gate, publish, crashAt }
+// stdout, one line each and written synchronously (a line is out before any later kill):
+//   READY            set up; waits for START on stdin
+//   ARRIVED          (gate) paused just before its first pending-nonce read; waits for GO on stdin
+//   BROADCASTING     (publish) eth_sendRawTransaction is about to leave; PUBLISHED once one RPC accepted it
+//   RESULT <json>    the send's outcome
+// crashAt kills THIS process with SIGKILL at an exact filesystem step: "intent-rename" (an intent's tmp file is written
+// and flushed, not yet renamed into place), "after-intent" (that rename done, nothing after it) or "release-marker" (an
+// intent is decided on disk, its reservation not yet released). publish: "hang-before" | "hang-after" stops forever around the first broadcast, for the parent to kill.
+import fs from "node:fs";
+import path from "node:path";
+import readline from "node:readline";
+import { pathToFileURL } from "node:url";
+
+const cfg = JSON.parse(process.argv[2]);
+const say = (l) => fs.writeSync(1, l + "\n");
+const die = () => process.kill(process.pid, "SIGKILL");
+if (cfg.crashAt === "intent-rename") { const o = fs.renameSync; fs.renameSync = (a, b) => { if (/tx-[0-9a-z-]+\.json$/.test(String(b))) die(); return o(a, b); }; }
+if (cfg.crashAt === "after-intent") { const o = fs.renameSync; fs.renameSync = (a, b) => { const r = o(a, b); if (/tx-[0-9a-z-]+\.json$/.test(String(b))) die(); return r; }; }
+if (cfg.crashAt === "release-marker") { const o = fs.openSync; fs.openSync = (p, ...a) => { if (String(p).endsWith(".released")) die(); return o(p, ...a); }; }
+
+const lines = readline.createInterface({ input: process.stdin });
+const heard = new Set(), waiting = new Map();
+lines.on("line", (l) => { heard.add(l); waiting.get(l)?.(); });
+const hear = (l) => heard.has(l) ? Promise.resolve() : new Promise((r) => waiting.set(l, r));
+
+const { createPublicClient, http } = await import("viem");
+const { foundry } = await import("viem/chains");
+const { QuorumChain } = await import(pathToFileURL(path.join(cfg.tree, "cli/independent.mjs")).href);
+const S = await import(pathToFileURL(path.join(cfg.tree, "cli/independent-signer.mjs")).href);
+
+const client = () => {
+  const c = createPublicClient({ chain: foundry, transport: http(cfg.chainRpc) });
+  return new Proxy(c, { get: (t, k) => k !== "request" ? t[k] : async (a) => {
+    if (a.method !== "eth_sendRawTransaction" || !cfg.publish) return t.request(a);
+    say("BROADCASTING");
+    if (cfg.publish === "hang-before") return new Promise(() => {});
+    const r = await t.request(a);
+    say("PUBLISHED");
+    return cfg.publish === "hang-after" ? new Promise(() => {}) : r;
+  } });
+};
+const chain = new QuorumChain({ clients: [{ origin: cfg.chainRpc + "/a", client: client() }, { origin: cfg.chainRpc + "/b", client: client() }],
+  quorum: 2, confirmations: 0, maxBlockAgeMs: 600000, chainId: 31337 });
+let arrived = false;
+const each = chain.each.bind(chain);
+chain.each = async (fn, what) => {
+  if (cfg.gate && what === "pending nonce" && !arrived) { arrived = true; say("ARRIVED"); await hear("GO"); }
+  return each(fn, what);
+};
+const signer = S.createExternalSigner({ url: cfg.url, from: cfg.from, chainId: 31337, mode: cfg.mode, journalDir: cfg.journalDir,
+  approvalTimeoutMs: 20000, probeTimeoutMs: 5000, onHandoff: (rec) => ({ handoff: rec.id, nonce: rec.nonce }) });
+say("READY");
+await hear("START");
+let result;
+try {
+  const r = await signer.sendQuorumTx(chain, { to: cfg.to, data: cfg.data, timeoutMs: 15000, pollMs: 50 });
+  result = { ok: true, intent: r.intent ?? r.handoff, hash: r.transactionHash ?? null };
+} catch (e) { result = { ok: false, code: e.code ?? null, intent: e.intent ?? null, reservation: e.reservation ?? null, message: String(e.message) }; }
+say("RESULT " + JSON.stringify(result));
+process.exit(0);
diff -ruN a/test/helpers/signer-harness.mjs b/test/helpers/signer-harness.mjs
--- a/test/helpers/signer-harness.mjs	1969-12-31 17:00:00.000000000 -0700
+++ b/test/helpers/signer-harness.mjs	2026-10-19 23:42:59.229966110 -0700
@@ -0,0 +1,93 @@
+// Shared fixtures for the external-signer concurrency and durability tests: anvil chains, JSON-RPC wallet fixtures,
+// a pending-nonce gate, and child processes running signer-child.mjs. Only anvil's published development keys are used;
+// nothing talks to a network beyond 127.0.0.1.
+import fs from "node:fs";
+import os from "node:os";
+import net from "node:net";
+import http from "node:http";
+import path from "node:path";
+import readline from "node:readline";
+import { spawn, execFileSync } from "node:child_process";
+import { fileURLToPath } from "node:url";
+import { createPublicClient, http as viemHttp } from "viem";
+import { privateKeyToAccount } from "viem/accounts";
+import { foundry } from "viem/chains";
+
+export const KEY0 = "0xac0974bec39a17e36ba4a6b4d238ff944bacb478cbed5efcae784d7bf4f2ff80";   // anvil dev account 0 (published)
+export const A0 = privateKeyToAccount(KEY0);
+export const SINK = "0x000000000000000000000000000000000000c0de";                            // code 0x00: any call succeeds
+export const WAIT = { timeoutMs: 15000, pollMs: 50 };
+export const HANG = Symbol("hang");
+export const CHILD = path.join(path.dirname(fileURLToPath(import.meta.url)), "signer-child.mjs");
+export const tools = (() => { try { execFileSync("anvil", ["--version"], { stdio: "ignore" }); return null; } catch { return "needs Foundry's anvil"; } })();
+
+const procs = [], servers = [], kids = [];
+const freePort = () => new Promise((ok) => { const s = net.createServer(); s.listen(0, "127.0.0.1", () => { const p = s.address().port; s.close(() => ok(p)); }); });
+export async function anvil() {
+  const port = await freePort();
+  procs.push(spawn("anvil", ["--port", String(port), "--chain-id", "31337", "--silent", "--base-fee", "5000000"], { stdio: "ignore" }));
+  const url = `http://127.0.0.1:${port}`, c = createPublicClient({ chain: foundry, transport: viemHttp(url) });
+  for (let i = 0; i < 100; i++) { try { await c.getChainId(); break; } catch { await new Promise((r) => setTimeout(r, 100)); } }
+  return { url, c };
+}
+export const call = async (url, method, params = []) => {
+  const j = await (await fetch(url, { method: "POST", headers: { "content-type": "application/json" }, body: JSON.stringify({ jsonrpc: "2.0", id: 1, method, params }) })).json();
+  return "error" in j ? { error: j.error } : { result: j.result };
+};
+/** A JSON-RPC wallet fixture: handler(msg) -> {result} | {error} | HANG. Records every method asked. */
+export async function walletServer(handler) {
+  const calls = [];
+  const srv = http.createServer(async (req, res) => {
+    let b = ""; for await (const c of req) b += c;
+    const m = JSON.parse(b); calls.push(m);
+    const r = await handler(m);
+    if (r === HANG) return;
+    res.writeHead(200, { "content-type": "application/json" }); res.end(JSON.stringify({ jsonrpc: "2.0", id: m.id, ...r }));
+  });
+  await new Promise((r) => srv.listen(0, "127.0.0.1", r));
+  servers.push(srv);
+  return { url: `http://127.0.0.1:${srv.address().port}/rpc?token=SECRET-TOKEN`, calls, count: (method) => calls.filter((c) => c.method === method).length };
+}
+export const forward = (url) => (m) => call(url, m.method, m.params);
+/** A sign-only wallet answering from a dev key in this process (eth_signTransaction, as anvil answers it); no node of its own. */
+export const keyWallet = (account = A0) => async (m) => {
+  if (m.method === "eth_accounts" || m.method === "eth_requestAccounts") return { result: [account.address] };
+  if (m.method === "eth_chainId") return { result: "0x7a69" };
+  if (m.method !== "eth_signTransaction") return { error: { code: -32601, message: `the method ${m.method} does not exist/is not available` } };
+  const p = m.params[0];
+  return { result: await account.signTransaction({ type: "eip1559", chainId: Number(p.chainId), nonce: Number(p.nonce), to: p.to, value: BigInt(p.value),
+    data: p.data, gas: BigInt(p.gas), maxFeePerGas: BigInt(p.maxFeePerGas), maxPriorityFeePerGas: BigInt(p.maxPriorityFeePerGas), accessList: [] }) };
+};
+/** The same chain, with hook() awaited before every pending-nonce read (the first thing a send asks the chain). */
+export function gatedChain(chain, hook) {
+  const g = Object.create(chain);
+  g.each = async (fn, what) => { if (what === "pending nonce") await hook(); return chain.each(fn, what); };
+  return g;
+}
+export async function until(pred, ms = 15000, what = "condition") {
+  const end = Date.now() + ms;
+  while (!pred()) { if (Date.now() > end) throw new Error(`timed out waiting for ${what}`); await new Promise((r) => setTimeout(r, 5)); }
+}
+/** signer-child.mjs in its own process. */
+export function child(cfg) {
+  const p = spawn(process.execPath, [CHILD, JSON.stringify(cfg)], { stdio: ["pipe", "pipe", "pipe"] });
+  kids.push(p);
+  const lines = [];
+  let err = "";
+  readline.createInterface({ input: p.stdout }).on("line", (l) => lines.push(l));
+  p.stderr.on("data", (d) => (err += d));
+  const exited = new Promise((r) => p.on("exit", (code, signal) => r({ code, signal })));
+  const has = (prefix) => lines.some((l) => l === prefix || l.startsWith(prefix + " "));
+  return { p, lines, exited, has, stderr: () => err,
+    send: (l) => p.stdin.write(l + "\n"),
+    wait: (prefix, ms) => until(() => has(prefix), ms, `${prefix} from child ${p.pid} (lines ${JSON.stringify(lines)}; stderr ${err.slice(0, 400)})`),
+    result: () => { const l = lines.find((x) => x.startsWith("RESULT ")); return l ? JSON.parse(l.slice(7)) : null; },
+    kill: async () => { p.kill("SIGKILL"); return exited; } };
+}
+export function tmpRoot(prefix) { return fs.mkdtempSync(path.join(os.tmpdir(), prefix)); }
+export function cleanup(tmp) {
+  for (const k of kids) { try { k.kill("SIGKILL"); } catch {} }
+  for (const s of servers) { s.closeAllConnections(); s.close(); }
+  for (const p of procs) p.kill("SIGKILL");
+  if (tmp) fs.rmSync(tmp, { recursive: true, force: true });
+}
