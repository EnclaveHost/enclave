+/** Start `wasmtime serve` as the wasm manager does (-Scli -Shttp, max-memory-size, a read-only /config preopen). */
+async function serve({ env = {}, configFile = null } = {}) {
+  const cfgDir = fs.mkdtempSync(path.join(tmp, "cfg-"));
