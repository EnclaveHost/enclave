+
+let main;
+before(async () => { main = await serve({ env: { ENCLAVE_CONFIG: JSON.stringify({ release: CID, wasi: "0.2" }), ENCLAVE_CONFIG_FILE: "/config/config.json" } }); });
+after(() => {
