+    const t = setTimeout(() => fail(new Error("wasmtime serve did not start:\n" + log)), 60000);
+    const on = (d) => { log += d; const m = /Serving HTTP on http:\/\/127\.0\.0\.1:(\d+)/.exec(log); if (m) { clearTimeout(t); ok(Number(m[1])); } };
