+  try { const st = fs.readFileSync(`/proc/${servers[0].pid}/status`, "utf8"); console.log(`# wasmtime serve ${/VmHWM:\s*(\d+ kB)/.exec(st)[1]} peak RSS (VmHWM) for the main server`); } catch {}
