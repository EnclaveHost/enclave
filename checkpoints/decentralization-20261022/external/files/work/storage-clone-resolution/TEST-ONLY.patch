+    // ---- C2 ACCEPTANCE (work/storage-clone-resolution-interface.txt): what a fix must make true. These FAIL on the
+    // frozen SDK by design (it has no head CAS or commit phase); they are #[ignore] so the frozen suite is unchanged.
+
+    #[tokio::test]
+    #[ignore]
+    async fn c2_acceptance_a_post_raise_clone_can_neither_read_stale_nor_acknowledge_a_conflicting_create() {
+        let nets = [Net::new(1), Net::new(2), Net::new(3)];
+        let (p, r) = fenced(&nets, &all(3), 2, lease_policy(5), None).await;
+        r.unwrap();
+        settle(&p).await;
+        maintain(&p).await;
+        p.put("b", "seed", b"s".to_vec(), None, &Cond::None).await.unwrap();
+        let q = clone_of(&p, &nets).await;
+        p.put("b", "k", b"from-P".to_vec(), None, &Cond::IfNoneMatch).await.unwrap();
+        // required: Q's freshness round sees heads it did not produce on W voters -> fork -> stopped for good
+        assert!(q.fresh().await.is_err(), "C2: a clone must not confirm freshness after the other's acknowledged write");
+        assert!(q.put("b", "k", b"from-Q".to_vec(), None, &Cond::IfNoneMatch).await.is_err(), "C2: the conflicting create is not acknowledged");
+        assert!(q.superseded().is_some());
+        let (later, r) = fenced(&nets, &all(3), 2, lease_policy(6), None).await;
+        r.unwrap();
+        maintain(&later).await;
+        assert_eq!(get(&later, "k").await.unwrap(), b"from-P", "C2: the acknowledged create survives; the loser's never surfaces");
+    }
+
+    #[tokio::test]
+    #[ignore]
+    async fn c2_acceptance_a_clone_with_another_clock_cannot_acknowledge_a_write_after_the_other_wrote() {
+        let nets = [Net::new(1), Net::new(2), Net::new(3)];
+        let (p, r) = fenced(&nets, &all(3), 2, lease_policy(5), None).await;
+        r.unwrap();
+        settle(&p).await;
+        maintain(&p).await;
+        p.put("b", "seed", b"s".to_vec(), None, &Cond::None).await.unwrap();
+        let q = clone_of(&p, &nets).await;
+        p.clock.set(now_ms() + 3_600_000);
+        p.put("b", "u", b"v1-earlier".to_vec(), None, &Cond::None).await.unwrap();
+        assert!(q.put("b", "u", b"v2-later".to_vec(), None, &Cond::None).await.is_err(), "C2: only one branch can be acknowledged after a fork");
+        let (later, r) = fenced(&nets, &all(3), 2, lease_policy(6), None).await;
+        r.unwrap();
+        maintain(&later).await;
+        assert_eq!(get(&later, "u").await.unwrap(), b"v1-earlier");
+    }
