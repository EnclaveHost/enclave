+		Data: "0x" + strings.Repeat("0", 63) + "1" + strings.Repeat("0", 64), BlockNumber: "0x10", BlockHash: "0x" + strings.Repeat("44", 32), LogIndex: "0x0"}
+	slow := fakeSource("mainnet.base.org", nil, nil, 0, nil) // omits the claim, 400 ms later
