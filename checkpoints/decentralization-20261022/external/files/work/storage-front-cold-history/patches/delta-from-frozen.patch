+    Object.assign(rig.peers[MB].mode, { historyBelow: head - 300 });
+    Object.assign(rig.peers[MC].mode, { noLogs: true });
+    Object.assign(rig.peers[HA].mode, { rangeLimit: 50 });
+    Object.assign(rig.peers[HB].mode, { rangeLimit: 1000 });
+    return head;
+  });
