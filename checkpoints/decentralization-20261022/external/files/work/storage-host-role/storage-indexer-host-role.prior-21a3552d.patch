+  let busy = false;
+  const once = async () => { if (busy) return; busy = true; try { await tick(); } catch (e) { log(`[storage-indexer] tick: ${e.message}`); } finally { busy = false; } };
+  gate.start?.();
+  await once();
+  // NOT unref'd: while refused, PostgreSQL and indexd are stopped and this timer is what keeps the supervisor alive
+  const iv = setInterval(() => void once(), intervalMs);
