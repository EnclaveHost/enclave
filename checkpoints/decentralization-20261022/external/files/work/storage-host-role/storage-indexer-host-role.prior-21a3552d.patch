+    const sh = `set -o pipefail; openssl cms -decrypt -binary -inform DER -in "${inFile}" -inkey "${ownerKey}" -recip "${ownerCert}" | zstd -q -d | "${cfg.pgBin}/pg_restore" --exit-on-error --single-transaction -h "${sockDir(cfg)}" -d indexd`;
