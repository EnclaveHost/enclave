+        let other = def(2, 1, &[0, 1]);
+        let st = c.membership(&[(0, vec![rec("s", &other, Some(&one))]), (1, vec![]), (2, vec![])]);
+        assert_eq!((st.phase, st.ready), (Phase::Refused, false));
+    }
