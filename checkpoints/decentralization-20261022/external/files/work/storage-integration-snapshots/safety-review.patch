+    #[tokio::test]
+    async fn a_lagging_replica_gets_the_ceiling_and_a_late_reservation_only_raises_it() {
+        let nets = [Net::on_disk(83), Net::on_disk(84)];
+        let c = cluster(&nets, 1).await;
