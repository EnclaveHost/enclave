+package app_test
+
+// FENCING PATCH tests (work/indexd-fencing-implementation-interface.txt): the fence endpoints, the signed sf
+// credential and the sequence/current listings over real HTTP against a real store (PostgreSQL).
+
+import (
+	"bytes"
+	"crypto/sha256"
+	"encoding/base64"
+	"encoding/binary"
+	"encoding/hex"
+	"encoding/json"
+	"errors"
+	"fmt"
+	"io"
+	"net/http"
+	"net/url"
+	"strings"
