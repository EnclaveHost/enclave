+func assertFencedNoFatal(t *testing.T, err error, want *accounts.Fence) {
+	var fe *accounts.FencedError
+	if !errors.As(err, &fe) || fe.Current == nil || *fe.Current != *want {
+		t.Errorf("expected a FencedError naming %v, got %v", *want, err)
+	}
