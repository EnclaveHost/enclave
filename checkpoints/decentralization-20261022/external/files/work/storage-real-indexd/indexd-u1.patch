+// handleGETCurrentObjects lists the account's current objects in key order (PATCH U1): unlike the object feed,
+// an acknowledged pin is listed at once, before its event is published.
+func (a *app) handleGETCurrentObjects(jc jape.Context, pk types.PublicKey) {
+	_, limit, ok := api.ParseOffsetLimit(jc)
+	if !ok {
+		return
+	}
+	var after types.Hash256
+	if jc.DecodeForm("after", &after) != nil {
+		return
+	}
+	objs, err := a.slabs.ListCurrentObjects(jc.Request.Context(), proto.Account(pk), after, limit)
+	if err != nil {
+		jc.Error(err, http.StatusInternalServerError)
+		return
+	}
+	encodeResponse(jc, objs)
+}
