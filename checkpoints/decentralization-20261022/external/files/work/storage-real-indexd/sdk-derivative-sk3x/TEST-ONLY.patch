+
+// ---- TEST-ONLY DERIVATIVE (indexd worker 6b7af721, work/storage-real-indexd/sdk-derivative-sk3x) ----
+// Not part of the SDK worker's frozen tree (FINAL-tree.sha256 323d3038...): this ONE added test closes the
+// post-unblock assertion gap of real_fence_blocked_acknowledged_version_is_never_read_stale_or_repaired_back. No
+// production SDK code is changed; the frozen sk3 test above is kept verbatim.
+#[tokio::test]
+#[ignore]
+async fn real_fence_blocked_then_explicit_unblock_recovers_v2_converges_and_resurrects_nothing() {
+    // the frozen sk3 scenario (three indexers, W = 2, r1 blocks its own v2 object), plus a key d deleted while r2 is
+    // stopped (r2 keeps a stale live d), then an explicit REAL admin unblock and full post-unblock assertions
+    let u = urls();
+    let seed = key(&[0, 1, 2]);
+    let a = fenced(&u, seed, 2, lease(5)).await;
+    settle(&a).await;
+    a.put("b", "k", b"v1".to_vec(), None, &Cond::None).await.unwrap();
+    a.put("b", "d", b"doomed".to_vec(), None, &Cond::None).await.unwrap();
+    settle(&a).await;
+    let v1 = a.lookup("b", "k").unwrap().ver();
+    ctl("/stop?idx=2");
+    a.put("b", "k", b"v2".to_vec(), None, &Cond::None).await.unwrap();
+    a.delete("b", "d").await.unwrap();
+    let v2 = a.lookup("b", "k").unwrap().ver();
+    assert!(v2 > v1);
+    let obj = host_of(&a, 1, "k").await;
+    drop(a);
+    ctl("/start?idx=2");
+    let blk = ctl(&format!("/block-object?idx=1&key={obj}"));
+    ctl("/stop?idx=0");
+    let b = fenced_up(&u, seed, 2, lease(6)).await;
+    let early = (b.ready(), b.blocked_objects(1));
+    evidence("x-restart-without-r0", serde_json::json!({ "block": blk, "ready": early.0, "blockedObjects": early.1 }));
+    assert!(!early.0, "r2 alone (v1, stale live d) must not serve");
+    assert_eq!(early.1, Some(1));
+    ctl("/start?idx=0");
+    let joined = b.fence_join(0, sdk(&u[0], seed).await, 8 << 20, opts()).await;
+    settle(&b).await;
+    // blocked phase (as the frozen test): ready, k at v2 but withheld, d stays deleted, v2 not copied to r2
+    let mut body = Vec::new();
+    let e = b.lookup("b", "k");
+    let read = match &e {
+        Some(e) => b.read(e, 0, e.s, &mut body).await.err().unwrap_or_default(),
+        None => "absent".into(),
+    };
+    let blocked_phase = serde_json::json!({ "join": format!("{joined:?}"), "ready": b.ready(), "kIsV2": e.as_ref().map(|e| e.ver() == v2),
+        "read": read, "bodyLen": body.len(), "dListed": b.lookup("b", "d").is_some(), "withheld": b.withheld_count(), "blockedObjects": b.blocked_objects(1) });
+    evidence("x-blocked-phase", blocked_phase.clone());
+    assert!(b.ready());
+    assert_eq!(e.as_ref().map(|e| e.ver()), Some(v2.clone()));
+    assert!(read.starts_with("UnavailableForLegalReasons") && body.is_empty());
+    assert!(b.lookup("b", "d").is_none(), "the tombstone holds while r1 is blocked");
+
+    // the operator lifts the block through r1's REAL admin API; the next maintenance passes re-list r1
+    let ub = ctl(&format!("/unblock-object?idx=1&key={obj}"));
+    let mut passes = Vec::new();
+    for _ in 0..8 {
+        let r = b.repair(1 << 30).await;
+        let quiet = r.reconciled + r.purged + r.copies + r.deletes + r.floors + r.reclaimed + r.merged + r.parts + r.admitted + r.ceilings + r.pending == 0;
+        passes.push(format!("{r:?}"));
+        if quiet && b.blocked_objects(1).is_none() {
+            break;
+        }
+    }
+    // post-unblock: ready, nothing withheld or left out, the EXACT latest v2 is read, d stays deleted, fresh
+    let mut body = Vec::new();
+    let e = b.lookup("b", "k");
+    let read = match &e {
+        Some(e) => b.read(e, 0, e.s, &mut body).await.map(|_| "ok".to_string()).unwrap_or_else(|x| x),
+        None => "absent".into(),
+    };
+    let fresh = format!("{:?}", b.fresh().await);
+    // convergence: every replica, listed afresh from its own indexer, holds k at exactly v2 and no live d
+    let mut replicas = Vec::new();
+    for i in 0..3 {
+        let s = crate::store::Store::load_with(sdk(&u[i], seed).await, 8 << 20, opts()).await;
+        let (kv, d_live) = match &s {
+            Ok(s) => {
+                let idx = s.idx.lock().await;
+                (idx.keys.get(&("b".to_string(), "k".to_string())).map(|k| k.entry.ver()), idx.keys.contains_key(&("b".to_string(), "d".to_string())))
+            }
+            Err(_) => (None, true),
+        };
+        replicas.push(serde_json::json!({ "replica": i, "load": s.as_ref().err().cloned().unwrap_or_else(|| "ok".into()),
+            "kIsV2": kv.as_ref().map(|v| *v == v2), "kIsV1": kv.as_ref().map(|v| *v == v1), "dLive": d_live }));
+    }
+    let last = b.repair(1 << 30).await;
+    evidence("x-after-unblock", serde_json::json!({ "unblock": ub, "repairPasses": passes, "ready": b.ready(), "blockedObjects": b.blocked_objects(1),
+        "withheld": b.withheld_count(), "kIsV2": e.as_ref().map(|e| e.ver() == v2), "read": read, "body": String::from_utf8_lossy(&body),
+        "dListed": b.lookup("b", "d").is_some(), "fresh": fresh, "replicas": replicas, "finalRepair": format!("{last:?}"), "status": b.replica_status().await }));
+    assert!(b.ready(), "ready after the unblock");
+    assert_eq!(b.blocked_objects(1), None, "r1 is no longer left out");
+    assert_eq!(b.withheld_count(), 0, "nothing is withheld any more");
+    assert_eq!(e.as_ref().map(|e| e.ver()), Some(v2.clone()), "k is at exactly v2 (not v1)");
+    assert!(read == "ok" && body == b"v2", "the exact latest v2 is read");
+    assert!(b.lookup("b", "d").is_none(), "the deleted key d is not resurrected");
+    assert!(fresh.starts_with("Ok"), "the writer is fresh");
+    for r in &replicas {
+        assert_eq!(r["load"], "ok", "every replica lists cleanly: {r}");
+        assert_eq!(r["kIsV2"], true, "every replica converged to exactly v2: {r}");
+        assert_eq!(r["dLive"], false, "no replica holds a live d: {r}");
+    }
+    let quiet = last.reconciled + last.purged + last.copies + last.deletes + last.floors + last.reclaimed + last.merged + last.parts + last.admitted + last.ceilings + last.pending == 0;
+    assert!(quiet, "a final repair pass has nothing left to do: {last:?}");
+}
