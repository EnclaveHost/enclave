+def s_trace(seconds):
+    """race-free token evidence, its own session (the watcher is at the transport limit): the kernel's
+    Win32_ProcessStartTrace for powershell.exe started by the Schedule service's svchost ONLY: pid, ppid, session,
+    TIME_CREATED and Sid (no command line). Per-event errors are recorded. The temporary subscription is removed in
+    `finally`. The verdict counts the SID only with a VALID native trace validation in the plan (trace_validate.py)."""
+    return ("$G1='trace';$end=(Get-Date).AddSeconds(" + str(int(seconds)) + ");$o=[ordered]@{from=[DateTime]::UtcNow.ToString('o');sched=$null;on=$null;starts=@();errs=@();cleanup=$null};"
+            "try{$o.sched=[int](Get-CimInstance Win32_Service -Filter \"Name='Schedule'\" -OperationTimeoutSec 10).ProcessId;"
+            "Register-CimIndicationEvent -Query \"SELECT * FROM Win32_ProcessStartTrace WHERE ProcessName='powershell.exe'\" -SourceIdentifier G1T -OperationTimeoutSec 10;$o.on=$true;"
+            "while((Get-Date) -lt $end){foreach($e in @(Get-Event -SourceIdentifier G1T -ErrorAction SilentlyContinue)){$n=$e.SourceEventArgs.NewEvent;"
+            "Remove-Event -EventIdentifier $e.EventIdentifier;if([int]$n.ParentProcessID -ne $o.sched){continue};"
+            "try{$o.starts+=[ordered]@{pid=[int]$n.ProcessID;ppid=[int]$n.ParentProcessID;session=[int]$n.SessionID;"
+            "created=[DateTime]::FromFileTimeUtc([int64]$n.TIME_CREATED).ToString('o');sid=(New-Object Security.Principal.SecurityIdentifier([byte[]]$n.Sid,0)).Value}}"
+            "catch{$o.errs+='event:'+$_.FullyQualifiedErrorId}};Start-Sleep -Milliseconds 250}"
+            "}catch{$o.errs+='main:'+$_.FullyQualifiedErrorId}"
+            "finally{$cl=[ordered]@{};try{Unregister-Event -SourceIdentifier G1T -ErrorAction Stop;$cl.unregistered=$true}catch{$cl.unregistered=[string]$_.FullyQualifiedErrorId};"
+            "try{Get-Event -SourceIdentifier G1T -ErrorAction SilentlyContinue|Remove-Event}catch{};"
+            "$cl.subscribers=@(Get-EventSubscriber -SourceIdentifier G1T -ErrorAction SilentlyContinue).Count;$o.cleanup=$cl;$o.to=[DateTime]::UtcNow.ToString('o')}")
