[Unit]
Description=Encrypted challenge-DNS feed to minipc (127.0.0.1:31053 -> this VM 127.0.0.1:1053)
After=network-online.target enclave-dns.service
Wants=network-online.target
[Service]
User=enclave-control-tunnel
Group=enclave-control-tunnel
ExecStart=/usr/local/libexec/enclave-control-tunnel-minipc.sh
Restart=always
RestartSec=10
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
[Install]
WantedBy=multi-user.target
