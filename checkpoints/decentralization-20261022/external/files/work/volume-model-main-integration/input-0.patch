+	if v = gb.unlock(map[string]any{"name": "docs", "password": db["password"], "salt": db["salt"], "accessKeyId": credsB["accessKeyId"], "secretAccessKey": credsB["secretAccessKey"]}); v["status"] != "unlocked" {
