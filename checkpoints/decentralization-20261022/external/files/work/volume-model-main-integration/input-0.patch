@@ -0,0 +1,320 @@
+// Package spec is the encVolumes config: wasm/wasm_manager.py's _parse_enc_volumes rules (Parse), the per-app guest's
+// endpoint narrowing, and what a volume needs before any secret is known (ParseLayout, TmpfsMiB). Standard library
+// only: the Hyper-V partition's measured monitor stages volumes from it without linking the engine or its crypto.
+package spec
+
+import (
+	"encoding/json"
+	"errors"
+	"fmt"
+	"net"
+	"net/url"
+	"path/filepath"
+	"regexp"
+	"strconv"
+	"strings"
+)
+
+// The standard runtime's limits (WASM_ENC_DEF_MB, WASM_ENC_MAX_MB, WASM_ENC_MAX_VOLS); encvol.SyncTimeout is the fourth.
+const (
+	DefMB     = 1024
+	MaxMB     = 4096
+	MaxVols   = 8
+	GuestRoot = "/enc" // /enc/<name> inside the guest (WASM_ENC_GUEST)
+)
+
+var (
+	volNameRE = regexp.MustCompile(`^[a-z0-9][a-z0-9._-]{0,63}$`)        // _VOL_NAME_RE
+	bucketRE  = regexp.MustCompile(`^[A-Za-z0-9][A-Za-z0-9._-]{0,254}$`) // _ENC_BUCKET_RE
+	dnsHostRE = regexp.MustCompile(`^[a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?(\.[a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?)+$`)
+	fileEnc   = []string{"standard", "off", "obfuscate"} // _ENC_FILENAME_ENC
+)
+
+// TmpfsMiB is the size of a volume's own tmpfs in a guest: its cap plus a small headroom, so an overrun is still
+// measured (and the app ended, as on the standard tier) while a runaway write cannot take the guest's memory.
+// supervisor.js encTmpfsMiB is the same rule.
+func TmpfsMiB(maxMB int) int { return maxMB + 1 + maxMB/64 }
+
+// GuestReserveMiB is what a guest keeps for its runtime and app beside its volumes (supervisor.js ENC_GUEST_RESERVE_MIB).
+const GuestReserveMiB = 128
+
+// Spec is one validated encVolumes entry: where the ciphertext lives and how it was packed. Nothing in it is secret.
+type Spec struct {
+	Name                    string
+	Endpoint                string
+	Bucket                  string
+	Path                    string
+	Unlock                  string
+	KeyID                   string
+	Encrypted               bool
+	Provider                string
+	Region                  string
+	FilenameEncryption      string
+	DirectoryNameEncryption bool
+	MaxMB                   int
+	ReadOnly                bool
+}
+
+// ParseOptions: test hooks only. A guest never sets either (front/encvol.go passes the zero value).
+type ParseOptions struct {
+	AllowLocal       bool // "local:/abs/path" endpoints (WASM_ENC_LOCAL_SRC): rclone's local backend, no bucket
+	TestLoopbackHTTP bool // http://127.0.0.1:PORT endpoints, for an S3 fixture on the test host's loopback
+}
+
+// Parse validates the config's encVolumes exactly as _parse_enc_volumes does, plus the direct guest's endpoint rule.
+// No encVolumes (or an empty list) is nil, nil.
+func Parse(config string, o ParseOptions) ([]Spec, error) { return parse(config, o, false) }
+
+// ParseLayout is Parse for what a volume needs before any secret is known: every rule on the names, the count, the
+// caps, unlock and keyId, but NOT on endpoint, bucket and path, which a measured config may hold as "$SECRET"
+// references (the standard runtime parses the secret-substituted config). The Hyper-V partition's monitor stages
+// from it; the front then parses the resolved config with Parse and requires the same layout (SameLayout).
+func ParseLayout(config string) ([]Spec, error) { return parse(config, ParseOptions{}, true) }
+
+// SameLayout: the resolved config's volumes are exactly the staged ones (names, order, caps).
+func SameLayout(a, b []Spec) bool {
+	if len(a) != len(b) {
+		return false
+	}
+	for i := range a {
+		if a[i].Name != b[i].Name || a[i].MaxMB != b[i].MaxMB {
+			return false
+		}
+	}
+	return true
+}
+
+func parse(config string, o ParseOptions, layout bool) ([]Spec, error) {
+	if strings.TrimSpace(config) == "" {
+		return nil, nil
+	}
+	var doc map[string]json.RawMessage
+	if err := json.Unmarshal([]byte(config), &doc); err != nil {
+		return nil, nil // not an object: no encVolumes to read (the manager would not reach this either)
+	}
+	raw, ok := doc["encVolumes"]
+	if !ok {
+		return nil, nil
+	}
+	var any_ any
+	if err := json.Unmarshal(raw, &any_); err != nil || any_ == nil || isFalsy(any_) {
+		return nil, nil
+	}
+	entries, ok := any_.([]any)
+	if !ok || len(entries) > MaxVols {
+		return nil, fmt.Errorf("encVolumes must be a list of at most %d entries", MaxVols)
+	}
+	var specs []Spec
+	seen := map[string]bool{}
+	for _, e := range entries {
+		m, ok := e.(map[string]any)
+		if !ok {
+			return nil, errors.New("encVolumes entries must be objects")
+		}
+		name := strings.TrimSpace(strOr(m["name"], ""))
+		if !volNameRE.MatchString(name) {
+			return nil, fmt.Errorf("encVolumes: bad volume name '%s' (want %s)", name, volNameRE.String())
+		}
+		if seen[name] {
+			return nil, fmt.Errorf("encVolumes: duplicate volume '%s'", name)
+		}
+		seen[name] = true
+		endpoint := strings.TrimRight(strings.TrimSpace(strOr(m["endpoint"], "")), "/")
+		if err := checkEndpoint(name, endpoint, o); err != nil && !layout {
+			return nil, err
+		}
+		bucket := strings.Trim(strings.TrimSpace(strOr(m["bucket"], "")), "/")
+		if !bucketRE.MatchString(bucket) && !layout {
+			return nil, fmt.Errorf("encVolumes '%s': bad bucket name", name)
+		}
+		path := strings.Trim(strings.TrimSpace(strOr(m["path"], "")), "/")
+		if path != "" && !layout {
+			for _, seg := range strings.Split(path, "/") {
+				if seg == "" || seg == "." || seg == ".." {
+					return nil, fmt.Errorf("encVolumes '%s': bad path prefix", name)
+				}
+			}
+		}
+		encrypted := boolOr(m["encrypted"], true)
+		_, hasFenc := m["filenameEncryption"]
+		_, hasDenc := m["directoryNameEncryption"]
+		if !encrypted && (hasFenc || hasDenc) {
+			return nil, fmt.Errorf("encVolumes '%s': filenameEncryption/directoryNameEncryption apply to the "+
+				"crypt layer, which \"encrypted\": false turns off - drop them", name)
+		}
+		fenc := strings.TrimSpace(strOr(m["filenameEncryption"], "standard")) // str(x or "standard").strip()
+		if !contains(fileEnc, fenc) {
+			return nil, fmt.Errorf("encVolumes '%s': filenameEncryption must be one of ('standard', 'off', 'obfuscate')", name)
+		}
+		maxMB := DefMB
+		if v, present := m["maxMb"]; present && !isFalsy(v) {
+			n, ok := intOf(v)
+			if !ok {
+				return nil, fmt.Errorf("encVolumes '%s': maxMb must be an integer", name)
+			}
+			maxMB = n
+		}
+		if maxMB < 1 || maxMB > MaxMB {
+			return nil, fmt.Errorf("encVolumes '%s': maxMb must be 1..%d", name, MaxMB)
+		}
+		unlock := strings.TrimSpace(strOr(m["unlock"], "password"))
+		if unlock != "password" && unlock != "wallet" {
+			return nil, fmt.Errorf("encVolumes '%s': unlock must be 'password' or 'wallet'", name)
+		}
+		keyID := strings.TrimSpace(strOr(m["keyId"], name))
+		if !volNameRE.MatchString(keyID) {
+			return nil, fmt.Errorf("encVolumes '%s': bad keyId (want %s)", name, volNameRE.String())
+		}
+		provider := strings.TrimSpace(strOr(m["provider"], "Other")) // str(x or "Other").strip() or "Other"
+		if provider == "" {
+			provider = "Other"
+		}
+		specs = append(specs, Spec{Name: name, Endpoint: endpoint, Bucket: bucket, Path: path, Unlock: unlock, KeyID: keyID,
+			Encrypted: encrypted, Provider: provider, Region: strings.TrimSpace(strOr(m["region"], "")), FilenameEncryption: fenc,
+			DirectoryNameEncryption: boolOr(m["directoryNameEncryption"], true), MaxMB: maxMB, ReadOnly: boolOr(m["readOnly"], false)})
+	}
+	return specs, nil
+}
+
+// checkEndpoint: the manager's rule (http(s) S3 URL, local: only as a test hook) narrowed to what the guest's egress
+// carries: https, port 443, a plain DNS name - never an IP literal, userinfo, a path or a query.
+func checkEndpoint(name, endpoint string, o ParseOptions) error {
+	if strings.HasPrefix(endpoint, "local:") {
+		if !o.AllowLocal {
+			return fmt.Errorf("encVolumes '%s': local: endpoints are a test hook (WASM_ENC_LOCAL_SRC), not deployable", name)
+		}
+		if !filepath.IsAbs(strings.TrimPrefix(endpoint, "local:")) {
+			return fmt.Errorf("encVolumes '%s': local: endpoints need an absolute path", name)
+		}
+		return nil
+	}
+	if !strings.HasPrefix(endpoint, "https://") && !strings.HasPrefix(endpoint, "http://") {
+		return fmt.Errorf("encVolumes '%s': endpoint must be an http(s) S3 endpoint URL", name)
+	}
+	u, err := url.Parse(endpoint)
+	if err != nil || u.Host == "" {
+		return fmt.Errorf("encVolumes '%s': endpoint must be an http(s) S3 endpoint URL", name)
+	}
+	if o.TestLoopbackHTTP && u.Scheme == "http" && u.Hostname() == "127.0.0.1" && u.User == nil && (u.Path == "" || u.Path == "/") {
+		return nil
+	}
+	host := strings.ToLower(u.Hostname())
+	if host == "localhost" || strings.HasSuffix(host, ".localhost") || net.ParseIP(strings.Trim(host, "[]")) != nil {
+		return fmt.Errorf("encVolumes '%s': endpoint host '%s' is a private/loopback/link-local or literal address (SSRF-blocked); "+
+			"a per-app guest reaches S3 only by DNS name through its measured egress", name, host)
+	}
+	if u.Scheme != "https" || (u.Port() != "" && u.Port() != "443") || u.User != nil || (u.Path != "" && u.Path != "/") || u.RawQuery != "" || u.Fragment != "" {
+		return fmt.Errorf("encVolumes '%s': a per-app guest reaches S3 only over https:// on port 443 with no path "+
+			"(its measured egress carries nothing else); got %s", name, redact(endpoint))
+	}
+	if !dnsHostRE.MatchString(host) || strings.Contains(host, "%") {
+		return fmt.Errorf("encVolumes '%s': endpoint host '%s' is not a plain DNS name", name, host)
+	}
+	return nil
+}
+
+// Origin is the https origin a spec's endpoint needs in the guest's egress allowlist ("" for test hooks).
+func (s Spec) Origin() string {
+	u, err := url.Parse(s.Endpoint)
+	if err != nil || u.Scheme != "https" {
+		return ""
+	}
+	return "https://" + strings.ToLower(u.Hostname())
+}
+
+func redact(s string) string {
+	if u, err := url.Parse(s); err == nil && u.User != nil {
+		u.User = nil
+		return u.String()
+	}
+	return s
+}
+
+func str(v any) string {
+	switch x := v.(type) {
+	case nil:
+		return ""
+	case string:
+		return x
+	case float64:
+		if x == float64(int64(x)) {
+			return fmt.Sprintf("%d", int64(x))
+		}
+		return fmt.Sprintf("%v", x)
+	case bool:
+		if x {
+			return "True"
+		}
+		return "False"
+	default:
+		b, _ := json.Marshal(x)
+		return string(b)
+	}
+}
+
+// strOr is str(v or def): the default applies to a FALSY value, before any strip.
+func strOr(v any, def string) string {
+	if isFalsy(v) {
+		return def
+	}
+	return str(v)
+}
+
+// isFalsy mirrors Python truthiness for JSON values (the manager's `x or default`).
+func isFalsy(v any) bool {
+	switch x := v.(type) {
+	case nil:
+		return true
+	case bool:
+		return !x
+	case float64:
+		return x == 0
+	case string:
+		return x == ""
+	case []any:
+		return len(x) == 0
+	case map[string]any:
+		return len(x) == 0
+	}
+	return false
+}
+
+// boolOr is bool(e.get(k, def)): an absent key takes def; a present value is Python-truthy.
+func boolOr(v any, def bool) bool {
+	if v == nil {
+		return def
+	}
+	return !isFalsy(v)
+}
+
+// intOf is int(x) for what a JSON maxMb can be: an integral number, or a string of digits.
+func intOf(v any) (int, bool) {
+	switch x := v.(type) {
+	case float64:
+		if x != float64(int64(x)) {
+			return int(x), true // Python int() truncates a float
+		}
+		return int(x), true
+	case string:
+		n, err := strconv.Atoi(strings.TrimSpace(x)) // int("05"), int(" 7 "), int("+3") as Python parses them
+		if err != nil {
+			return 0, false
+		}
+		return n, true
+	case bool:
+		if x {
+			return 1, true
+		}
+		return 0, true
+	}
+	return 0, false
+}
+
+func contains(l []string, s string) bool {
+	for _, x := range l {
+		if x == s {
+			return true
+		}
+	}
+	return false
+}
diff --git a/isolation/m2/encvol/store.go b/isolation/m2/encvol/store.go
new file mode 100644
index 0000000..ca308c0
--- /dev/null
+++ b/isolation/m2/encvol/store.go
@@ -0,0 +1,470 @@
+package encvol
+
+// Where a volume's objects live: an S3 bucket (with the volume's key prefix), or - test hook only - a local directory
+// laid out as rclone's local backend would (local:<path>/<bucket>/<prefix>). The S3 side speaks the plain protocol
+// rclone's s3 backend uses for provider "Other": path-style URLs, SigV4 (region "us-east-1" when none is set), anonymous
+// requests for a public-read bucket, the session token header, and the modtime in X-Amz-Meta-Mtime in rclone's format.
+
+import (
+	"context"
+	"crypto/hmac"
+	"crypto/sha256"
+	"crypto/tls"
+	"crypto/x509"
+	_ "embed"
+	"encoding/hex"
+	"encoding/xml"
+	"errors"
+	"fmt"
+	"io"
+	"io/fs"
+	"net"
+	"net/http"
+	"net/url"
+	"os"
+	"path/filepath"
+	"sort"
+	"strconv"
+	"strings"
+	"time"
+)
+
+type object struct {
+	Key        string // relative to the volume's prefix, "/"-separated
+	Size       int64
+	ModTime    time.Time
+	HasModTime bool
+}
+
+type store interface {
+	List(ctx context.Context) ([]object, error)
+	Get(ctx context.Context, key string) (io.ReadCloser, time.Time, bool, error)
+	Head(ctx context.Context, key string) (time.Time, bool, error)
+	// Put sends `size` bytes; body is called once per attempt (and once more to hash, for S3).
+	Put(ctx context.Context, key string, body func() (io.Reader, error), size int64, mtime time.Time) error
+	Delete(ctx context.Context, key string) error
+}
+
+// ---- the modtime format rclone's s3 backend stores (ncw/swift v2.0.2 meta.go, MIT: nsToFloatString/floatStringToNs) ----
+
+func nsToFloatString(ns int64) string {
+	if ns < 0 {
+		return "-" + nsToFloatString(-ns)
+	}
+	result := fmt.Sprintf("%010d", ns)
+	split := len(result) - 9
+	result, decimals := result[:split], result[split:]
+	decimals = strings.TrimRight(decimals, "0")
+	if decimals != "" {
+		result += "."
+		result += decimals
+	}
+	return result
+}
+
+func floatStringToNs(s string) (int64, error) {
+	const zeros = "000000000"
+	if point := strings.IndexRune(s, '.'); point >= 0 {
+		tail := s[point+1:]
+		if fill := 9 - len(tail); fill < 0 {
+			tail = tail[:9]
+		} else {
+			tail += zeros[:fill]
+		}
+		s = s[:point] + tail
+	} else if len(s) > 0 {
+		s += zeros
+	}
+	return strconv.ParseInt(s, 10, 64)
+}
+
+// ---- local (test hook) -------------------------------------------------------------------------------------------------
+
+type localStore struct{ root string }
+
+func (l *localStore) List(ctx context.Context) ([]object, error) {
+	var out []object
+	err := filepath.WalkDir(l.root, func(p string, d fs.DirEntry, err error) error {
+		if err != nil {
+			if errors.Is(err, fs.ErrNotExist) && p == l.root {
+				return filepath.SkipAll
+			}
+			return err
+		}
+		if !d.Type().IsRegular() {
+			return nil
+		}
+		fi, err := d.Info()
+		if err != nil {
+			return err
+		}
+		rel, _ := filepath.Rel(l.root, p)
+		out = append(out, object{Key: filepath.ToSlash(rel), Size: fi.Size(), ModTime: fi.ModTime(), HasModTime: true})
+		return nil
+	})
+	return out, err
+}
+
+func (l *localStore) Get(ctx context.Context, key string) (io.ReadCloser, time.Time, bool, error) {
+	f, err := os.Open(filepath.Join(l.root, filepath.FromSlash(key)))
+	if err != nil {
+		return nil, time.Time{}, false, err
+	}
+	fi, _ := f.Stat()
+	return f, fi.ModTime(), true, nil
+}
+
+func (l *localStore) Head(ctx context.Context, key string) (time.Time, bool, error) {
+	fi, err := os.Stat(filepath.Join(l.root, filepath.FromSlash(key)))
+	if err != nil {
+		return time.Time{}, false, err
+	}
+	return fi.ModTime(), true, nil
+}
+
+func (l *localStore) Put(ctx context.Context, key string, body func() (io.Reader, error), size int64, mtime time.Time) error {
+	p := filepath.Join(l.root, filepath.FromSlash(key))
+	if err := os.MkdirAll(filepath.Dir(p), 0o755); err != nil {
+		return err
+	}
+	r, err := body()
+	if err != nil {
+		return err
+	}
+	tmp := p + ".encvol-partial"
+	f, err := os.OpenFile(tmp, os.O_CREATE|os.O_TRUNC|os.O_WRONLY, 0o644)
+	if err != nil {
+		return err
+	}
+	n, err := io.Copy(f, r)
+	if cerr := f.Close(); err == nil {
+		err = cerr
+	}
+	if err == nil && n != size {
+		err = fmt.Errorf("wrote %d bytes, expected %d", n, size)
+	}
+	if err != nil {
+		os.Remove(tmp)
+		return err
+	}
+	if err := os.Chtimes(tmp, mtime, mtime); err != nil {
+		return err
+	}
+	return os.Rename(tmp, p)
+}
+
+func (l *localStore) Delete(ctx context.Context, key string) error {
+	return os.Remove(filepath.Join(l.root, filepath.FromSlash(key)))
+}
+
+// ---- S3 ---------------------------------------------------------------------------------------------------------------
+
+//go:embed roots/cacert-2026-09-25.pem
+var publicRoots []byte
+
+// PublicRoots is the trust store for owner S3 endpoints: curl's dated Mozilla extract (cacert-2026-09-25.pem, sha256
+// a41b5d356aea97a529fe27e0f7316d2f9d946d75927476cf9cf1b90637d00505), compiled into the measured front.
+func PublicRoots() (*x509.CertPool, error) {
+	p := x509.NewCertPool()
+	if !p.AppendCertsFromPEM(publicRoots) {
+		return nil, errors.New("the embedded public roots do not parse")
+	}
+	return p, nil
+}
+
+type s3Store struct {
+	base    *url.URL // scheme://host[:port]
+	bucket  string
+	prefix  string // "" or "a/b/"
+	region  string
+	ak, sk  string
+	token   string
+	client  *http.Client
+	now     func() time.Time
+	retries int
+}
+
+func newS3Store(sp Spec, c creds, roots *x509.CertPool, plainHTTP bool, timeout time.Duration) (*s3Store, error) {
+	u, err := url.Parse(sp.Endpoint)
+	if err != nil {
+		return nil, err
+	}
+	tr := &http.Transport{Proxy: nil, DialContext: (&net.Dialer{Timeout: 15 * time.Second}).DialContext,
+		TLSHandshakeTimeout: 15 * time.Second, ResponseHeaderTimeout: 60 * time.Second, MaxIdleConnsPerHost: 4}
+	if !plainHTTP {
+		tr.TLSClientConfig = &tls.Config{RootCAs: roots, MinVersion: tls.VersionTLS12}
+	}
+	region := sp.Region
+	if region == "" {
+		region = "us-east-1"
+	}
+	pre := ""
+	if sp.Path != "" {
+		pre = sp.Path + "/"
+	}
+	return &s3Store{base: &url.URL{Scheme: u.Scheme, Host: u.Host}, bucket: sp.Bucket, prefix: pre, region: region,
+		ak: c.AccessKeyID, sk: c.SecretAccessKey, token: c.SessionToken,
+		client: &http.Client{Transport: tr, Timeout: timeout, CheckRedirect: func(*http.Request, []*http.Request) error { return http.ErrUseLastResponse }},
+		now:    time.Now, retries: 3}, nil
+}
+
+// uriEncode is SigV4's: unreserved characters stay, everything else %XX; "/" stays only in paths.
+func uriEncode(s string, path bool) string {
+	var b strings.Builder
+	for i := 0; i < len(s); i++ {
+		c := s[i]
+		if (c >= 'A' && c <= 'Z') || (c >= 'a' && c <= 'z') || (c >= '0' && c <= '9') || c == '-' || c == '_' || c == '.' || c == '~' || (path && c == '/') {
+			b.WriteByte(c)
+		} else {
+			fmt.Fprintf(&b, "%%%02X", c)
+		}
+	}
+	return b.String()
+}
+
+func hmacSHA256(key []byte, data string) []byte {
+	m := hmac.New(sha256.New, key)
+	m.Write([]byte(data))
+	return m.Sum(nil)
+}
+
+// do sends one signed request (anonymous without credentials); payloadHash is the hex sha256 of the body.
+func (s *s3Store) do(ctx context.Context, method, key string, query url.Values, body func() (io.Reader, error), size int64, payloadHash string, hdr map[string]string) (*http.Response, error) {
+	var last error
+	for attempt := 0; attempt < s.retries; attempt++ {
+		if attempt > 0 {
+			select {
+			case <-ctx.Done():
+				return nil, ctx.Err()
+			case <-time.After(time.Duration(attempt) * time.Second):
+			}
+		}
+		resp, err := s.once(ctx, method, key, query, body, size, payloadHash, hdr)
+		if err == nil && resp.StatusCode < 500 {
+			return resp, nil
+		}
+		if err == nil {
+			last = s3Error(resp)
+		} else {
+			last = err
+		}
+	}
+	return nil, last
+}
+
+func (s *s3Store) once(ctx context.Context, method, key string, query url.Values, body func() (io.Reader, error), size int64, payloadHash string, hdr map[string]string) (*http.Response, error) {
+	path := "/" + s.bucket
+	if key != "" {
+		path += "/" + s.prefix + key
+	} else if method == http.MethodGet && query == nil {
+		path += "/"
+	}
+	canonPath := uriEncode(path, true)
+	keys := make([]string, 0, len(query))
+	for k := range query {
+		keys = append(keys, k)
+	}
+	sort.Strings(keys)
+	var qs []string
+	for _, k := range keys {
+		qs = append(qs, uriEncode(k, false)+"="+uriEncode(query.Get(k), false))
+	}
+	canonQuery := strings.Join(qs, "&")
+	u := s.base.String() + canonPath
+	if canonQuery != "" {
+		u += "?" + canonQuery
+	}
+	var rd io.Reader = http.NoBody
+	if body != nil {
+		r, err := body()
+		if err != nil {
+			return nil, err
+		}
+		if size > 0 {
+			rd = r // a zero-length object goes as NoBody: Go would send an unknown length (chunked) otherwise
+		}
+	}
+	req, err := http.NewRequestWithContext(ctx, method, u, rd)
+	if err != nil {
+		return nil, err
+	}
+	if body != nil && size > 0 {
+		req.ContentLength = size
+	}
+	for k, v := range hdr {
+		req.Header.Set(k, v)
+	}
+	if s.ak == "" {
+		return s.client.Do(req) // anonymous: a public-read bucket
+	}
+	t := s.now().UTC()
+	amzDate := t.Format("20060102T150405Z")
+	day := t.Format("20060102")
+	req.Header.Set("x-amz-date", amzDate)
+	req.Header.Set("x-amz-content-sha256", payloadHash)
+	if s.token != "" {
+		req.Header.Set("x-amz-security-token", s.token)
+	}
+	signed := map[string]string{"host": req.URL.Host}
+	for k := range req.Header {
+		lk := strings.ToLower(k)
+		if lk == "content-type" || lk == "content-md5" || strings.HasPrefix(lk, "x-amz-") {
+			signed[lk] = strings.TrimSpace(req.Header.Get(k))
+		}
+	}
+	names := make([]string, 0, len(signed))
+	for k := range signed {
+		names = append(names, k)
+	}
+	sort.Strings(names)
+	var ch strings.Builder
+	for _, n := range names {
+		ch.WriteString(n + ":" + signed[n] + "\n")
+	}
+	signedHeaders := strings.Join(names, ";")
+	canon := strings.Join([]string{method, canonPath, canonQuery, ch.String(), signedHeaders, payloadHash}, "\n")
+	scope := day + "/" + s.region + "/s3/aws4_request"
+	sum := sha256.Sum256([]byte(canon))
+	toSign := "AWS4-HMAC-SHA256\n" + amzDate + "\n" + scope + "\n" + hex.EncodeToString(sum[:])
+	k := hmacSHA256([]byte("AWS4"+s.sk), day)
+	k = hmacSHA256(k, s.region)
+	k = hmacSHA256(k, "s3")
+	k = hmacSHA256(k, "aws4_request")
+	sig := hex.EncodeToString(hmacSHA256(k, toSign))
+	req.Header.Set("Authorization", "AWS4-HMAC-SHA256 Credential="+s.ak+"/"+scope+", SignedHeaders="+signedHeaders+", Signature="+sig)
+	return s.client.Do(req)
+}
+
+const emptySHA256 = "e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855"
+
+func s3Error(resp *http.Response) error {
+	defer resp.Body.Close()
+	b, _ := io.ReadAll(io.LimitReader(resp.Body, 64<<10))
+	var e struct {
+		Code    string `xml:"Code"`
+		Message string `xml:"Message"`
+	}
+	if xml.Unmarshal(b, &e) == nil && e.Code != "" {
+		return fmt.Errorf("S3 %s: %s (HTTP %d)", e.Code, e.Message, resp.StatusCode)
+	}
+	return fmt.Errorf("S3 answered HTTP %d", resp.StatusCode)
+}
+
+func (s *s3Store) List(ctx context.Context) ([]object, error) {
+	var out []object
+	token := ""
+	for page := 0; page < 100000; page++ {
+		q := url.Values{"list-type": {"2"}, "max-keys": {"1000"}}
+		if s.prefix != "" {
+			q.Set("prefix", s.prefix)
+		}
+		if token != "" {
+			q.Set("continuation-token", token)
+		}
+		resp, err := s.do(ctx, http.MethodGet, "", q, nil, 0, emptySHA256, nil)
+		if err != nil {
+			return nil, err
+		}
+		if resp.StatusCode != 200 {
+			return nil, s3Error(resp)
+		}
+		var r struct {
+			Contents []struct {
+				Key          string `xml:"Key"`
+				Size         int64  `xml:"Size"`
+				LastModified string `xml:"LastModified"`
+			} `xml:"Contents"`
+			IsTruncated           bool   `xml:"IsTruncated"`
+			NextContinuationToken string `xml:"NextContinuationToken"`
+		}
+		err = xml.NewDecoder(io.LimitReader(resp.Body, 64<<20)).Decode(&r)
+		resp.Body.Close()
+		if err != nil {
+			return nil, fmt.Errorf("S3 listing: %v", err)
+		}
+		for _, c := range r.Contents {
+			if !strings.HasPrefix(c.Key, s.prefix) || strings.HasSuffix(c.Key, "/") {
+				continue // outside the volume, or a directory marker
+			}
+			lm, _ := time.Parse(time.RFC3339, c.LastModified)
+			out = append(out, object{Key: strings.TrimPrefix(c.Key, s.prefix), Size: c.Size, ModTime: lm})
+		}
+		if !r.IsTruncated || r.NextContinuationToken == "" {
+			return out, nil
+		}
+		token = r.NextContinuationToken
+	}
+	return nil, errors.New("S3 listing did not end")
+}
+
+func metaMtime(h http.Header) (time.Time, bool) {
+	if v := h.Get("X-Amz-Meta-Mtime"); v != "" {
+		if ns, err := floatStringToNs(v); err == nil {
+			return time.Unix(0, ns), true
+		}
+	}
+	return time.Time{}, false
+}
+
+func (s *s3Store) Get(ctx context.Context, key string) (io.ReadCloser, time.Time, bool, error) {
+	resp, err := s.do(ctx, http.MethodGet, key, nil, nil, 0, emptySHA256, nil)
+	if err != nil {
+		return nil, time.Time{}, false, err
+	}
+	if resp.StatusCode != 200 {
+		return nil, time.Time{}, false, s3Error(resp)
+	}
+	t, ok := metaMtime(resp.Header)
+	return resp.Body, t, ok, nil
+}
+
+func (s *s3Store) Head(ctx context.Context, key string) (time.Time, bool, error) {
+	resp, err := s.do(ctx, http.MethodHead, key, nil, nil, 0, emptySHA256, nil)
+	if err != nil {
+		return time.Time{}, false, err
+	}
+	resp.Body.Close()
+	if resp.StatusCode != 200 {
+		return time.Time{}, false, fmt.Errorf("S3 HEAD answered HTTP %d", resp.StatusCode)
+	}
+	t, ok := metaMtime(resp.Header)
+	return t, ok, nil
+}
+
+func (s *s3Store) Put(ctx context.Context, key string, body func() (io.Reader, error), size int64, mtime time.Time) error {
+	h := sha256.New()
+	r, err := body()
+	if err != nil {
+		return err
+	}
+	n, err := io.Copy(h, r)
+	if err != nil {
+		return err
+	}
+	if n != size {
+		return fmt.Errorf("the local file changed while it was being sent (%d bytes, expected %d)", n, size)
+	}
+	hdr := map[string]string{"X-Amz-Meta-Mtime": nsToFloatString(mtime.UnixNano()), "Content-Type": "application/octet-stream"}
+	resp, err := s.do(ctx, http.MethodPut, key, nil, body, size, hex.EncodeToString(h.Sum(nil)), hdr)
+	if err != nil {
+		return err
+	}
+	if resp.StatusCode != 200 {
+		return s3Error(resp)
+	}
+	io.Copy(io.Discard, resp.Body)
+	resp.Body.Close()
+	return nil
+}
+
+func (s *s3Store) Delete(ctx context.Context, key string) error {
+	resp, err := s.do(ctx, http.MethodDelete, key, nil, nil, 0, emptySHA256, nil)
+	if err != nil {
+		return err
+	}
+	defer resp.Body.Close()
+	if resp.StatusCode != 204 && resp.StatusCode != 200 && resp.StatusCode != 404 {
+		return s3Error(resp)
+	}
+	return nil
+}
diff --git a/isolation/m2/encvol/sync.go b/isolation/m2/encvol/sync.go
new file mode 100644
index 0000000..622ec9d
--- /dev/null
+++ b/isolation/m2/encvol/sync.go
@@ -0,0 +1,373 @@
+package encvol
+
+// The sync the standard runtime gets from `rclone sync SRC DST --transfers 8 --checkers 8 --retries 2 --contimeout 15s
+// [--max-transfer NM]`, done natively over the vendored crypt cipher (rclonecrypt) and the store (store.go). It keeps
+// rclone's decisions where they change what lands on either side:
+//   - an object is transferred when the destination lacks it, its size differs, or its modtime differs (crypt has no
+//     hash in common with anything, so a modtime difference is always a transfer; for a plain volume rclone would
+//     first compare MD5 and only fix the modtime - here it transfers, which leaves the same bytes and modtime);
+//   - extraneous destination files are deleted after the transfers, and NOT when any transfer failed ("not deleting
+//     files as there were IO errors"); empty local directories not in the source go too;
+//   - under crypt, a name that does not decrypt is skipped and reported ("Skipping undecryptable file name"), which
+//     the runtime turns into its wrong-key message; a block that does not authenticate fails that file;
+//   - --max-transfer counts the bytes read for transfers and stops everything once they reach the cap
+//     (rclone's hard cutoff), and a failed sync is tried once more unless the failure was fatal.
+
+import (
+	"context"
+	"crypto/rand"
+	"encoding/hex"
+	"errors"
+	"fmt"
+	"io"
+	"path"
+	"sort"
+	"strings"
+	"sync"
+	"time"
+
+	"enclave.host/isolation/m2/encvol/rclonecrypt"
+)
+
+const (
+	transfers = 8
+	retries   = 2
+)
+
+var errMaxTransfer = errors.New("max transfer limit reached as set by --max-transfer")
+
+// remote is a volume's far side: the store and, unless the volume is plain, the cipher.
+type remote struct {
+	st     store
+	cipher *rclonecrypt.Cipher // nil = plain
+}
+
+type syncResult struct {
+	undecryptable int
+}
+
+// cappedReader is rclone's accounting check: before every read, the bytes already read must be under the cap.
+type cappedReader struct {
+	r    io.Reader
+	used *int64
+	mu   *sync.Mutex
+	max  int64
+}
+
+func (c *cappedReader) Read(p []byte) (int, error) {
+	c.mu.Lock()
+	if c.max > 0 && *c.used >= c.max {
+		c.mu.Unlock()
+		return 0, errMaxTransfer
+	}
+	c.mu.Unlock()
+	n, err := c.r.Read(p)
+	c.mu.Lock()
+	*c.used += int64(n)
+	c.mu.Unlock()
+	return n, err
+}
+
+type remoteEntry struct {
+	key  string // the store key (encrypted name under crypt)
+	obj  object
+	size int64 // plaintext size; -1 = unknown
+}
+
+// listRemote lists the far side under plaintext names; under crypt, undecryptable names are counted and skipped.
+func (rm *remote) listRemote(ctx context.Context) (map[string]remoteEntry, int, error) {
+	objs, err := rm.st.List(ctx)
+	if err != nil {
+		return nil, 0, err
+	}
+	out := map[string]remoteEntry{}
+	bad := 0
+	for _, o := range objs {
+		name, size := o.Key, o.Size
+		if rm.cipher != nil {
+			n, err := rm.cipher.DecryptFileName(o.Key)
+			if err != nil {
+				bad++
+				continue
+			}
+			name = n
+			if s, err := rm.cipher.DecryptedSize(o.Size); err == nil {
+				size = s
+			} else {
+				size = -1
+			}
+		}
+		out[name] = remoteEntry{key: o.Key, obj: o, size: size}
+	}
+	return out, bad, nil
+}
+
+// remoteModTime is the far side's modtime: X-Amz-Meta-Mtime when set (HEAD, as rclone's ModTime does), else the
+// listing's LastModified.
+func (rm *remote) remoteModTime(ctx context.Context, e remoteEntry) time.Time {
+	if e.obj.HasModTime {
+		return e.obj.ModTime
+	}
+	if t, ok, err := rm.st.Head(ctx, e.key); err == nil && ok {
+		return t
+	}
+	return e.obj.ModTime
+}
+
+func sameTime(a, b time.Time) bool { return a.Equal(b) } // both sides keep nanoseconds: rclone's window is 1ns
+
+func randTag() string {
+	b := make([]byte, 8)
+	rand.Read(b)
+	return hex.EncodeToString(b)
+}
+
+type firstErr struct {
+	mu    sync.Mutex
+	err   error
+	n     int
+	fatal bool
+}
+
+func (f *firstErr) add(rel string, err error) {
+	f.mu.Lock()
+	defer f.mu.Unlock()
+	f.n++
+	if errors.Is(err, errMaxTransfer) {
+		f.fatal = true
+	}
+	if f.err == nil {
+		f.err = fmt.Errorf("%s: %v", rel, err)
+	}
+}
+
+func (f *firstErr) result() error {
+	if f.err == nil {
+		return nil
+	}
+	if f.fatal {
+		return fmt.Errorf("Failed to sync: %v", errMaxTransfer)
+	}
+	if f.n > 1 {
+		return fmt.Errorf("Failed to sync: %v (and %d more errors)", f.err, f.n-1)
+	}
+	return fmt.Errorf("Failed to sync: %v", f.err)
+}
+
+// pull is `rclone sync REMOTE LOCAL [--max-transfer]`.
+func pull(ctx context.Context, rm *remote, t tree, maxBytes int64) (syncResult, error) {
+	var res syncResult
+	var err error
+	for attempt := 0; attempt < retries; attempt++ {
+		res, err = pullOnce(ctx, rm, t, maxBytes)
+		if err == nil || ctx.Err() != nil || errors.Is(err, errMaxTransfer) || strings.Contains(err.Error(), errMaxTransfer.Error()) || res.undecryptable > 0 {
+			break
+		}
+	}
+	return res, err
+}
+
+func pullOnce(ctx context.Context, rm *remote, t tree, maxBytes int64) (syncResult, error) {
+	src, bad, err := rm.listRemote(ctx)
+	if err != nil {
+		return syncResult{}, fmt.Errorf("Failed to sync: %v", err)
+	}
+	res := syncResult{undecryptable: bad}
+	files, dirs, err := t.walk()
+	if err != nil {
+		return res, fmt.Errorf("Failed to sync: %v", err)
+	}
+	have := map[string]localFile{}
+	for _, f := range files {
+		have[f.Rel] = f
+	}
+	names := make([]string, 0, len(src))
+	for n := range src {
+		names = append(names, n)
+	}
+	sort.Strings(names)
+	ctx, cancel := context.WithCancel(ctx)
+	defer cancel()
+	var used int64
+	var umu sync.Mutex
+	var errs firstErr
+	sem := make(chan struct{}, transfers)
+	var wg sync.WaitGroup
+	for _, n := range names {
+		e := src[n]
+		if l, ok := have[n]; ok && e.size >= 0 && l.Size == e.size && sameTime(l.ModTime, rm.remoteModTime(ctx, e)) {
+			continue
+		}
+		if ctx.Err() != nil {
+			break
+		}
+		sem <- struct{}{}
+		wg.Add(1)
+		go func(n string, e remoteEntry) {
+			defer func() { <-sem; wg.Done() }()
+			if err := pullFile(ctx, rm, t, n, e, &cappedReader{used: &used, mu: &umu, max: maxBytes}); err != nil {
+				errs.add(n, err)
+				if errors.Is(err, errMaxTransfer) {
+					cancel()
+				}
+			}
+		}(n, e)
+	}
+	wg.Wait()
+	if err := errs.result(); err != nil {
+		return res, err
+	}
+	// delete what the source does not have (after the transfers, only when they all succeeded)
+	keep := map[string]bool{}
+	for n := range src {
+		for d := path.Dir(n); d != "." && d != "/"; d = path.Dir(d) {
+			keep[d] = true
+		}
+	}
+	for _, f := range files {
+		if _, ok := src[f.Rel]; !ok {
+			if err := t.remove(f.Rel); err != nil {
+				errs.add(f.Rel, err)
+			}
+		}
+	}
+	var drop []string
+	for d := range dirs {
+		if !keep[d] {
+			drop = append(drop, d)
+		}
+	}
+	sort.Slice(drop, func(i, j int) bool { return len(drop[i]) > len(drop[j]) }) // deepest first
+	for _, d := range drop {
+		t.rmdirIfEmpty(d)
+	}
+	return res, errs.result()
+}
+
+func pullFile(ctx context.Context, rm *remote, t tree, rel string, e remoteEntry, cr *cappedReader) error {
+	body, mt, ok, err := rm.st.Get(ctx, e.key)
+	if err != nil {
+		return err
+	}
+	defer body.Close()
+	if !ok {
+		mt = e.obj.ModTime
+	}
+	var r io.ReadCloser = body
+	if rm.cipher != nil {
+		dr, err := rm.cipher.DecryptData(body)
+		if err != nil {
+			return err
+		}
+		defer dr.Close()
+		r = dr
+	}
+	cr.r = r
+	n, err := t.writeFile(rel, cr, mt, randTag())
+	if err != nil {
+		return err
+	}
+	if e.size >= 0 && n != e.size {
+		t.remove(rel)
+		return fmt.Errorf("corrupted on transfer: sizes differ %d vs %d", e.size, n)
+	}
+	return nil
+}
+
+// push is `rclone sync LOCAL REMOTE` (no cap: the volume's own cap bounds what there is).
+func push(ctx context.Context, rm *remote, t tree) (syncResult, error) {
+	var res syncResult
+	var err error
+	for attempt := 0; attempt < retries; attempt++ {
+		res, err = pushOnce(ctx, rm, t)
+		if err == nil || ctx.Err() != nil {
+			break
+		}
+	}
+	return res, err
+}
+
+func pushOnce(ctx context.Context, rm *remote, t tree) (syncResult, error) {
+	files, _, err := t.walk()
+	if err != nil {
+		return syncResult{}, fmt.Errorf("Failed to sync: %v", err)
+	}
+	dst, bad, err := rm.listRemote(ctx)
+	if err != nil {
+		return syncResult{}, fmt.Errorf("Failed to sync: %v", err)
+	}
+	res := syncResult{undecryptable: bad}
+	src := map[string]bool{}
+	var errs firstErr
+	sem := make(chan struct{}, transfers)
+	var wg sync.WaitGroup
+	for _, f := range files {
+		src[f.Rel] = true
+		if e, ok := dst[f.Rel]; ok && e.size >= 0 && e.size == f.Size && sameTime(f.ModTime, rm.remoteModTime(ctx, e)) {
+			continue
+		}
+		sem <- struct{}{}
+		wg.Add(1)
+		go func(f localFile, old remoteEntry, had bool) {
+			defer func() { <-sem; wg.Done() }()
+			if err := pushFile(ctx, rm, t, f, old, had); err != nil {
+				errs.add(f.Rel, err)
+			}
+		}(f, dst[f.Rel], dst[f.Rel].key != "")
+	}
+	wg.Wait()
+	if err := errs.result(); err != nil {
+		return res, err
+	}
+	for n, e := range dst {
+		if !src[n] {
+			if err := rm.st.Delete(ctx, e.key); err != nil {
+				errs.add(n, err)
+			}
+		}
+	}
+	return res, errs.result()
+}
+
+func pushFile(ctx context.Context, rm *remote, t tree, f localFile, old remoteEntry, had bool) error {
+	key := f.Rel
+	size := f.Size
+	var n [rclonecrypt.NonceSize]byte
+	if rm.cipher != nil {
+		key = rm.cipher.EncryptFileName(f.Rel)
+		size = rm.cipher.EncryptedSize(f.Size)
+		if _, err := rand.Read(n[:]); err != nil {
+			return err
+		}
+	}
+	var open []io.Closer
+	defer func() {
+		for _, c := range open {
+			c.Close()
+		}
+	}()
+	body := func() (io.Reader, error) {
+		fh, sz, err := t.openRead(f.Rel)
+		if err != nil {
+			return nil, err
+		}
+		open = append(open, fh)
+		if sz != f.Size {
+			return nil, fmt.Errorf("can't copy - source file is being updated (size changed from %d to %d)", f.Size, sz)
+		}
+		var r io.Reader = io.LimitReader(fh, f.Size)
+		if rm.cipher != nil {
+			return rm.cipher.EncryptDataNonce(r, n)
+		}
+		return r, nil
+	}
+	if err := rm.st.Put(ctx, key, body, size, f.ModTime); err != nil {
+		return err
+	}
+	// a re-encrypted name can differ from the old object's (obfuscate/standard are deterministic, so only a key that
+	// listed under another spelling, e.g. a version suffix, is left behind): drop it, as rclone's replace would
+	if had && old.key != key {
+		return rm.st.Delete(ctx, old.key)
+	}
+	return nil
+}
diff --git a/isolation/m2/encvol/testdata/parse_ref.py b/isolation/m2/encvol/testdata/parse_ref.py
new file mode 100644
index 0000000..bb92ea7
--- /dev/null
+++ b/isolation/m2/encvol/testdata/parse_ref.py
@@ -0,0 +1,26 @@
+#!/usr/bin/env python3
+"""The standard runtime's own encVolumes parser, as the reference for encvol.Parse (encvol_test.go).
+
+Reads a JSON list of config objects on stdin, runs wasm/wasm_manager.py's _parse_enc_volumes on each and prints a JSON
+list of {"ok": [spec...]} or {"err": "<message>"}. Imports the real module from this repository with every directory it
+creates redirected to a temp dir; never starts the manager."""
+import json, os, pathlib, sys, tempfile
+
+repo = pathlib.Path(__file__).resolve().parents[4]
+tmp = tempfile.mkdtemp(prefix="encvol-parse-ref-")
+for k in ("WASM_LOG_DIR", "WASM_FS_DIR", "WASM_ENC_DIR", "WASM_APPS_DIR"):
+    os.environ[k] = os.path.join(tmp, k.lower())
+os.environ.setdefault("RCLONE_BIN", sys.argv[1] if len(sys.argv) > 1 else "rclone")
+sys.path.insert(0, str(repo / "wasm"))
+import contextlib  # noqa: E402
+with contextlib.redirect_stdout(sys.stderr):  # the manager announces itself on import; stdout is the JSON alone
+    import wasm_manager as m  # noqa: E402
+
+out = []
+for cfg in json.load(sys.stdin):
+    try:
+        with contextlib.redirect_stdout(sys.stderr):
+            out.append({"ok": m._parse_enc_volumes(cfg)})
+    except ValueError as e:
+        out.append({"err": str(e)})
+print(json.dumps(out))
diff --git a/isolation/m2/front/encvol.go b/isolation/m2/front/encvol.go
new file mode 100644
index 0000000..e7e8433
--- /dev/null
+++ b/isolation/m2/front/encvol.go
@@ -0,0 +1,313 @@
+package main
+
+// encvol in the front: a deployment's encrypted volumes (isolation/m2/encvol), started between the release and the
+// app's start, in the same step as the egress forwarders (provision.go startForwarders):
+//
+//  1. the owner's config (sealed to this guest, resolved here) names the volumes; their S3 endpoints join the egress
+//     allowlist BEFORE the forwarders start, so each gets a forwarder and an /etc/hosts entry like any allowed origin;
+//  2. each volume is staged as its own sized tmpfs at /enc/<name>, owned by the app's uid, EMPTY;
+//  3. the tenant plane listens on this guest's loopback only and joins the listener audit's expected set;
+//  4. init receives, after the config, the plane's URL, the deployment's token and the volume names, and gives the
+//     app the /enc/<name> live preopens and ENCLAVE_ENC / ENCLAVE_ENC_API / ENCLAVE_ENC_TOKEN (dominit.c).
+//
+// The key and the plaintext never leave this guest: the app sends the password to the plane over loopback, the
+// plane keys rclone's crypt cipher in this process (encvol/rclonecrypt), the ciphertext travels TLS end to end to the
+// owner's S3 endpoint through the egress forwarder, and the plaintext lands in guest-memory tmpfs. Nothing of it is
+// printed (console lines name a volume and an outcome), written outside the volumes, or sent to the host.
+
+import (
+	"bytes"
+	"context"
+	"crypto/x509"
+	"errors"
+	"fmt"
+	"net"
+	"net/http"
+	"net/netip"
+	"os"
+	"path/filepath"
+	"sort"
+	"strconv"
+	"strings"
+	"syscall"
+	"time"
+
+	"enclave.host/isolation/m2/appconfig"
+	"enclave.host/isolation/m2/egress"
+	"enclave.host/isolation/m2/encvol"
+)
+
+const (
+	encListenAddr = "127.0.0.1:50080" // above the 1-49999 an app may bind (/app.run, /app.ports): never the app's
+	encAppUID     = 1000              // dominit.c APP_UID / APP_GID
+	encAppGID     = 1000
+	encMarker     = "/rt/encvol.enabled" // the image states the capability (guestd reports it; the supervisor gates on it)
+	encAuditEvery = 10 * time.Second     // the manager's AUDIT_SECS
+)
+
+// encvolHost is what a guest supplies to run volumes; nil = this image has no encrypted-volume engine.
+type encvolHost struct {
+	root   string
+	uid    int
+	gid    int
+	listen string
+	mount  func(dir string, maxMB int) error
+	kill   func(reason string)
+	parse  encvol.ParseOptions                                               // zero in a guest
+	dial   func(ctx context.Context, network, addr string) (net.Conn, error) // tests only
+	memMiB func() (int, error)                                               // the guest's memory; nil = unchecked (tests)
+	roots  *x509.CertPool                                                    // tests only; nil = the embedded public roots
+	shared bool                                                              // a Hyper-V partition domain (encvol.Options.Shared)
+}
+
+// encStarted is a running plane: its listener address (for the audit) and init's trailer.
+type encStarted struct {
+	svc   *encvol.Service
+	addr  netip.AddrPort
+	block []byte // init's trailer (an SNP guest)
+	api   string // the same three facts, for secretrun's pipe (a Hyper-V partition domain)
+	token string
+	names []string
+}
+
+// guestEncvol is the guest's engine (compiled into this front), or nil when the image does not state the capability:
+// an image whose init predates the trailer must not be handed volumes it could not give the app.
+func guestEncvol() *encvolHost {
+	if b, err := os.ReadFile(encMarker); err != nil || string(b) != "1\n" {
+		return nil
+	}
+	return &encvolHost{root: encvol.GuestRoot, uid: encAppUID, gid: encAppGID, listen: encListenAddr,
+		mount: tmpfsMount, kill: killApp, memMiB: guestMemMiB}
+}
+
+// tmpfsMount: a volume's own tmpfs (encvol.TmpfsMiB), owned by the app, never executable.
+func tmpfsMount(dir string, maxMB int) error {
+	opts := fmt.Sprintf("size=%dm,mode=0700,uid=%d,gid=%d", encvol.TmpfsMiB(maxMB), encAppUID, encAppGID)
+	return syscall.Mount("tmpfs", dir, "tmpfs", syscall.MS_NOSUID|syscall.MS_NODEV|syscall.MS_NOEXEC, opts)
+}
+
+// guestMemMiB is this guest's MemTotal.
+func guestMemMiB() (int, error) {
+	b, err := os.ReadFile("/proc/meminfo")
+	if err != nil {
+		return 0, err
+	}
+	for _, line := range strings.Split(string(b), "\n") {
+		if f := strings.Fields(line); len(f) >= 2 && f[0] == "MemTotal:" {
+			kb, err := strconv.Atoi(f[1])
+			return kb / 1024, err
+		}
+	}
+	return 0, errors.New("no MemTotal")
+}
+
+// killApp ends every process running as the app's uid (the runtime); init sees the app exit and
+// powers the domain off, as for any app that ends.
+func killApp(reason string) {
+	fmt.Printf("DOM encvol cap exceeded: ending the app\n") // the reason names a volume and sizes only; the console gets neither
+	_ = reason
+	ents, _ := os.ReadDir("/proc")
+	for _, e := range ents {
+		pid, err := strconv.Atoi(e.Name())
+		if err != nil {
+			continue
+		}
+		b, err := os.ReadFile(filepath.Join("/proc", e.Name(), "status"))
+		if err != nil {
+			continue
+		}
+		for _, line := range strings.Split(string(b), "\n") {
+			if f := strings.Fields(line); len(f) >= 2 && f[0] == "Uid:" && f[1] == strconv.Itoa(encAppUID) {
+				_ = syscall.Kill(pid, syscall.SIGKILL)
+			}
+		}
+	}
+}
+
+// encPrepare reads encVolumes from the resolved config and adds each endpoint's origin to the policy, before the
+// forwarders start. A bad entry is a failed launch, as on the standard tier.
+func encPrepare(config string, pol *egress.Policy, host *encvolHost) ([]encvol.Spec, error) {
+	var po encvol.ParseOptions
+	if host != nil {
+		po = host.parse
+	}
+	specs, err := encvol.Parse(config, po)
+	if err != nil || len(specs) == 0 {
+		return nil, err
+	}
+	if host == nil {
+		return nil, errors.New("the config names encVolumes, and this image carries no encrypted-volume engine: the app is not started without its mounts")
+	}
+	// every volume is guest RAM: refuse a launch whose volumes at their caps would not leave the runtime and app room
+	// (the supervisor refuses the same claim against the version's memMb; this is the guest's own check)
+	if host.memMiB != nil {
+		mem, err := host.memMiB()
+		if err != nil {
+			return nil, fmt.Errorf("encVolumes: the guest's memory could not be read: %v", err)
+		}
+		need := 0
+		for _, s := range specs {
+			need += encvol.TmpfsMiB(s.MaxMB)
+		}
+		if need+encvol.GuestReserveMiB > mem {
+			return nil, fmt.Errorf("encVolumes need %d MiB of this guest's %d MiB (a per-app guest holds each volume in RAM; %d MiB stays for the runtime and app): the app is not started without its mounts",
+				need, mem, encvol.GuestReserveMiB)
+		}
+	}
+	have := map[string]bool{}
+	for _, o := range pol.Origins {
+		have[o.Host] = true
+	}
+	for _, s := range specs {
+		if s.Origin() == "" {
+			continue // a test hook endpoint (local:, loopback http)
+		}
+		o, err := egress.ParseOrigin(s.Origin())
+		if err != nil {
+			return nil, fmt.Errorf("encVolumes '%s': %v", s.Name, err)
+		}
+		if !have[o.Host] {
+			pol.Origins = append(pol.Origins, o)
+			have[o.Host] = true
+		}
+	}
+	sort.Slice(pol.Origins, func(i, j int) bool { return pol.Origins[i].Host < pol.Origins[j].Host })
+	return specs, nil
+}
+
+// encStart stages the volumes and starts the plane for deployment id.
+func encStart(ctx context.Context, id [32]byte, specs []encvol.Spec, host *encvolHost, logf func(string, ...any)) (*encStarted, error) {
+	vid := fmt.Sprintf("0x%x", id[:])
+	svc, err := encvol.New(vid, specs, encvol.Options{Root: host.root, UID: host.uid, GID: host.gid,
+		Mount: host.mount, Kill: host.kill, Logf: logf, Parse: host.parse, Dial: host.dial, Roots: host.roots, Shared: host.shared})
+	if err != nil {
+		return nil, err
+	}
+	ln, err := net.Listen("tcp", host.listen)
+	if err != nil {
+		return nil, fmt.Errorf("the encrypted-volume plane: %v", err)
+	}
+	addr, err := netip.ParseAddrPort(ln.Addr().String())
+	if err != nil {
+		ln.Close()
+		return nil, err
+	}
+	srv := &http.Server{Handler: svc, ReadHeaderTimeout: 10 * time.Second}
+	go srv.Serve(ln)
+	go svc.RunAudit(ctx, encAuditEvery)
+	out := &encStarted{svc: svc, addr: addr, api: fmt.Sprintf("http://%s/encvol/%s", addr, vid), token: svc.Token()}
+	var b bytes.Buffer
+	b.WriteString("E1\n")
+	fmt.Fprintf(&b, "api=%s\n", out.api)
+	fmt.Fprintf(&b, "token=%s\n", out.token)
+	for _, m := range svc.Mounts() {
+		fmt.Fprintf(&b, "vol=%s\n", m[0])
+		out.names = append(out.names, m[0])
+	}
+	out.block = b.Bytes()
+	logf("DOM encvol: %d volume(s) staged locked at %s/<name>; plane on loopback", len(specs), host.root)
+	return out, nil
+}
+
+// handToInitEnc is handToInitMode plus init's encrypted-volume trailer: the config, a NUL (a config never holds one),
+// then the block encStart wrote. No trailer without a config.
+func handToInitEnc(w *os.File, config string, publicHTTPS bool, enc []byte) error {
+	if len(enc) == 0 {
+		return handToInitMode(w, config, publicHTTPS)
+	}
+	defer w.Close()
+	if config == "" {
+		return errors.New("an encrypted-volume trailer without a config")
+	}
+	tag := byte('C')
+	if publicHTTPS {
+		tag = 'P'
+	}
+	msg := make([]byte, 0, 2+len(config)+len(enc))
+	msg = append(msg, tag)
+	msg = append(msg, config...)
+	msg = append(msg, 0)
+	msg = append(msg, enc...)
+	_, err := w.Write(msg)
+	for i := range msg {
+		msg[i] = 0
+	}
+	return err
+}
+
+// ---- a Hyper-V partition domain (isolation/m3: the monitor stages, secretrun preopens) ----------------------------
+
+// encShieldMarker is the monitor's statement that it staged this domain's volumes (monitor stageEncVolumes): root-owned,
+// read-only, one name per line. Without it a domain has no volumes, and a config naming some is refused.
+const encShieldMarker = "/enc.volumes"
+
+// shieldEncvol is a partition domain's engine: this front is not root, so the monitor mounted each volume (a tmpfs,
+// group-shared with the app, sized from the measured config) and domexec put this front in the app's group.
+func shieldEncvol() *encvolHost {
+	fi, err := os.Lstat(encShieldMarker)
+	if err != nil || !fi.Mode().IsRegular() || fi.Mode().Perm()&0o222 != 0 {
+		return nil
+	}
+	if st, ok := fi.Sys().(*syscall.Stat_t); !ok || st.Uid != 0 {
+		return nil
+	}
+	return &encvolHost{root: encvol.GuestRoot, uid: -1, gid: -1, listen: encListenAddr, shared: true, kill: endDomain}
+}
+
+// endDomain is the audit's sanction where this front cannot signal the app's uid: it ends itself, and domexec ends the
+// domain when either workload exits.
+func endDomain(reason string) {
+	fmt.Printf("DOM encvol cap exceeded: ending the domain\n") // the reason names a volume and sizes only; the console gets neither
+	_ = reason
+	os.Exit(3)
+}
+
+// encSpecs: the volumes of a partition domain's MEASURED config, resolved with the domain's secrets (endpoint, bucket
+// and path may be "$SECRET" references, as on the standard runtime), their origins added to the policy; the resolved
+// volumes must be exactly the ones the monitor staged from the measured bytes.
+func (e *shieldEgress) encSpecs(measured string, secrets map[string]string, pol *egress.Policy) ([]encvol.Spec, error) {
+	layout, err := encvol.ParseLayout(measured)
+	if err != nil {
+		return nil, egressStepError{"encrypted volumes"}
+	}
+	if len(layout) == 0 {
+		return nil, nil
+	}
+	resolved, err := appconfig.Resolve(measured, secrets)
+	if err != nil {
+		return nil, egressStepError{"encrypted volumes"}
+	}
+	specs, err := encPrepare(resolved, pol, e.enc)
+	if err != nil || !encvol.SameLayout(layout, specs) || !e.encStaged(specs) {
+		return nil, egressStepError{"encrypted volumes"}
+	}
+	return specs, nil
+}
+
+// encStaged: the monitor's marker names exactly these volumes.
+func (e *shieldEgress) encStaged(specs []encvol.Spec) bool {
+	marker := e.encMarker
+	if marker == "" {
+		marker = encShieldMarker
+	}
+	b, err := os.ReadFile(marker)
+	if err != nil {
+		return false
+	}
+	var want strings.Builder
+	for _, s := range specs {
+		want.WriteString(s.Name + "\n")
+	}
+	return string(b) == want.String()
+}
+
+// addEnc puts the plane's URL, the token and the names on secretrun's pipe (reserved ENCLAVE_ENC* keys, which no owner
+// secret may use: shieldconfig.Validate refuses the ENCLAVE_ prefix).
+func (e *shieldEgress) addEnc(m map[string]string) {
+	if e == nil || e.encOut == nil {
+		return
+	}
+	m["ENCLAVE_ENC"] = strings.Join(e.encOut.names, ",")
+	m["ENCLAVE_ENC_API"] = e.encOut.api
+	m["ENCLAVE_ENC_TOKEN"] = e.encOut.token
+}
