diff --git a/isolation/m2/testdata/modelvol-qemu-init.c b/isolation/m2/testdata/modelvol-qemu-init.c
new file mode 100644
index 0000000..3bbf9c5
--- /dev/null
+++ b/isolation/m2/testdata/modelvol-qemu-init.c
@@ -0,0 +1,62 @@
+/* modelvol-qemu-init.c - TEST ONLY (never in an image): PID 1 of a throwaway QEMU/KVM guest for test-modelvol-qemu.sh.
+ * It runs the per-app init's OWN model-volume code (dominit.c compiled in, its main renamed; modelvol.h + mverity.h)
+ * against a real kernel: insmod the device-mapper modules, read the M1 block the test baked in (/m1), look the name up
+ * in /rt/model-volumes.table, find the virtio disk by serial, bring dm-verity up against the PINNED root, mount ext4
+ * read-only, then read the volume's file back and print its sha256. Every outcome is one "MVTEST ..." console line,
+ * then the guest powers off. */
+#define main dominit_main
+#include "../dominit.c"
+#undef main
+#include <stdarg.h>
+#include <sys/statvfs.h>
+
+static void out(const char *fmt, ...) {
+    va_list ap;
+    va_start(ap, fmt);
+    vprintf(fmt, ap);
+    va_end(ap);
+    fflush(stdout);
+}
+
+int main(void) {
+    mount("proc", "/proc", "proc", 0, 0);
+    mount("sysfs", "/sys", "sysfs", 0, 0);
+    mount("devtmpfs", "/dev", "devtmpfs", 0, 0);
+    mount("tmpfs", "/tmp", "tmpfs", 0, "size=16m");
+    char m1[512] = {0};
+    FILE *f = fopen("/m1", "r");
+    size_t n = f ? fread(m1, 1, sizeof m1 - 1, f) : 0;
+    if (f) fclose(f);
+    const char *why = model_block(m1, n);
+    if (!why) why = mv_table();
+    char who[80] = "";
+    if (!why) why = mv_mount_all(who, sizeof who);
+    if (why) {
+        out("MVTEST mount-refused %s: %s (%s)\n", who, why, errno ? strerror(errno) : "-");
+    } else {
+        struct statvfs sv;
+        char path[300];
+        snprintf(path, sizeof path, MV_ROOT "/%s", mv[0].name);
+        int ro = statvfs(path, &sv) == 0 && (sv.f_flag & ST_RDONLY);
+        out("MVTEST mounted %s ro=%d\n", mv[0].name, ro);
+        snprintf(path, sizeof path, MV_ROOT "/%s/payload.bin", mv[0].name);
+        int fd = open(path, O_RDONLY);
+        static unsigned char buf[16 << 20];
+        ssize_t r = 0;
+        size_t total = 0;
+        while (fd >= 0 && total < sizeof buf && (r = read(fd, buf + total, sizeof buf - total)) > 0) total += (size_t)r;
+        if (fd < 0 || r < 0) {
+            out("MVTEST read-failed %s (%s) after %zu bytes\n", path, strerror(errno), total);
+        } else {
+            char hex[65];
+            sha256_min_hex(buf, total, hex);
+            out("MVTEST read %zu bytes sha256=%s\n", total, hex);
+        }
+        int w = open(path, O_WRONLY);
+        out("MVTEST write-refused=%d\n", w < 0 && errno == EROFS);
+    }
+    out("MVTEST end\n");
+    sync();
+    reboot(RB_POWER_OFF);
+    return 0;
+}
diff --git a/isolation/m2/testdata/modelvol-serve.c b/isolation/m2/testdata/modelvol-serve.c
new file mode 100644
index 0000000..cb2e915
--- /dev/null
+++ b/isolation/m2/testdata/modelvol-serve.c
@@ -0,0 +1,43 @@
+/* modelvol-serve.c - TEST ONLY (never in an image), for isolation/m4/test-modelvol-preload.sh: the per-app init's OWN
+ * model-volume code (modelvol.h, as dominit.c and m3/domexec.c run it) builds the runtime's argv and environment for
+ * volumes already mounted under MV_ROOT, then execs the REAL nn-capable wasmtime with them, serving the app. So what
+ * is tested is the exact staging, budget, -S nn / nn-graph / --dir / --env arguments and values a measured guest gives
+ * its runtime, against the runtime that must honour them.
+ *   modelvol-serve <rtdir> <app.wasm> <addr> <memory MiB>     (MV_ROOT, MV_STAGE, MV_TABLE, MV_NN_MARKER, MV_BACKEND_DIR
+ *                                                             and MV_M1, the "M1" block's file, are compiled in) */
+#define MV_NO_MOUNT
+#include <errno.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <sys/stat.h>
+#include <unistd.h>
+#include "../modelvol.h"
+
+int main(int argc, char **argv) {
+    if (argc != 5) { fprintf(stderr, "usage: modelvol-serve <rtdir> <app.wasm> <addr> <memory MiB>\n"); return 2; }
+    char m1[1025] = {0};
+    FILE *f = fopen(MV_M1, "r");
+    size_t n = f ? fread(m1, 1, sizeof m1 - 1, f) : 0;
+    if (f) fclose(f);
+    const char *why = model_block(m1, n);
+    if (!why) why = mv_table();
+    if (!why) why = mv_dirs();
+    if (why) { fprintf(stderr, "MVSERVE refused: %s\n", why); return 3; }
+    mv_preloads(strtoull(argv[4], NULL, 10) << 20);
+    static char ld[600], wt[600];
+    snprintf(ld, sizeof ld, "%s/ld-linux-x86-64.so.2", argv[1]);
+    snprintf(wt, sizeof wt, "%s/wasmtime", argv[1]);
+    char *app[128] = {ld, "--library-path", argv[1], wt, "serve", "-S", "cli", "-C", "cache=n", "--addr", argv[3], NULL};
+    int k = mv_argv(app, 11);
+    app[k++] = argv[2];
+    app[k] = NULL;
+    char *envp[32] = {"HOME=/tmp", "PATH=/usr/bin:/bin", NULL};
+    envp[mv_env(envp, 2)] = NULL;
+    for (int i = 0; app[i]; i++) fprintf(stderr, "MVSERVE argv %s\n", app[i]);
+    for (int i = 0; envp[i]; i++) fprintf(stderr, "MVSERVE env %s\n", envp[i]);
+    fflush(stderr);
+    execve(app[0], app, envp);
+    fprintf(stderr, "MVSERVE exec: %s\n", strerror(errno));
+    return 127;
+}
