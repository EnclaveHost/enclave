diff --git a/isolation/m4/nn-probe.wat b/isolation/m4/nn-probe.wat
new file mode 100644
index 0000000..a531f85
--- /dev/null
+++ b/isolation/m4/nn-probe.wat
@@ -0,0 +1,12 @@
+;; nn-probe.wat - the runtime's wasi-nn ggml probe (probe-nn-ggml.sh): a graph the runtime PRELOADED at start, under its
+;; directory's name ("probe"), is found by name and gets an execution context, through the witx wasi-nn interface.
+;; run() -> 7 only when both succeed; 1 or 2 says which failed.
+(module
+  (import "wasi_ephemeral_nn" "load_by_name" (func $load_by_name (param i32 i32 i32) (result i32)))
+  (import "wasi_ephemeral_nn" "init_execution_context" (func $init (param i32 i32) (result i32)))
+  (memory (export "memory") 1)
+  (data (i32.const 16) "probe")
+  (func (export "run") (result i32)
+    (if (i32.ne (call $load_by_name (i32.const 16) (i32.const 5) (i32.const 64)) (i32.const 0)) (then (return (i32.const 1))))
+    (if (i32.ne (call $init (i32.load (i32.const 64)) (i32.const 68)) (i32.const 0)) (then (return (i32.const 2))))
+    (i32.const 7)))
diff --git a/isolation/m4/probe-nn-ggml.sh b/isolation/m4/probe-nn-ggml.sh
new file mode 100755
index 0000000..da14031
--- /dev/null
+++ b/isolation/m4/probe-nn-ggml.sh
@@ -0,0 +1,19 @@
+#!/bin/sh
+# Prove the runtime PRELOADS a ggml graph and serves it by name on the CPU backend (the shared runtime's model-volume
+# preloads: wasm/wasm_manager.py stages a dir per volume; isolation/m2/modelvol.h does the same in a measured guest).
+# A real execution: a tiny generated GGUF (tiny-gguf.py) preloaded with -S nn-graph=ggml::<dir>, then nn-probe.wat
+# finds it by name and creates a context. A help listing alone is insufficient. No native cache or precompiled input.
+#   probe-nn-ggml.sh <rtdir>   (rtdir holds ld-linux-x86-64.so.2, wasmtime, its libraries and backends/libggml-cpu.so)
+set -eu
+here=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
+rt=${1:?usage: probe-nn-ggml.sh <rtdir>}
+[ -r "$rt/backends/libggml-cpu.so" ] || exit 1
+t=$(mktemp -d)
+trap 'rm -rf "$t"' EXIT
+mkdir -p "$t/probe"
+python3 "$here/tiny-gguf.py" "$t/probe/model.gguf" --vocab 512 > /dev/null
+result=$(ENCLAVE_GGML_BACKEND_DIR="$rt/backends" ENCLAVE_GGML_N_GPU_LAYERS=0 ENCLAVE_NN_SERVE_BYTES=1073741824 ENCLAVE_NN_SERVE_KIND=RAM \
+  timeout 60 "$rt/ld-linux-x86-64.so.2" --library-path "$rt" "$rt/wasmtime" run -C cache=n -S nn -S "nn-graph=ggml::$t/probe" \
+  --invoke run "$here/nn-probe.wat" 2>/dev/null) || exit 1   # a core module: its export by name (WAVE syntax is for components)
+[ "$result" = 7 ] || exit 1
+printf '1\n'
diff --git a/isolation/m4/runtime-set.sh b/isolation/m4/runtime-set.sh
index 92aac1d..31eae6e 100755
--- a/isolation/m4/runtime-set.sh
+++ b/isolation/m4/runtime-set.sh
@@ -27,6 +27,37 @@ compose)
     echo "runtime-set.sh: $rt is not empty; the set is every file in it, so it must start empty" >&2; exit 2
   fi
   mkdir -p "$rt"
+  if [ -n "${NN_RUNTIME_DIR:-}" ]; then
+    # A runtime built with wasi-nn and the ggml backends (the shared runtime's model-volume preloads): its OWN directory
+    # holds wasmtime, the libraries it links, its loader and backends/. The set takes the ELF, what ldd resolves from
+    # that directory, its loader and the CPU backend ONLY (never the Shield GPU backend), and every probe runs the
+    # composed set through its own loader. nn-ggml.enabled only after a graph really preloads and loads by name.
+    src=$NN_RUNTIME_DIR
+    [ -x "$src/wasmtime" ] && [ -r "$src/ld-linux-x86-64.so.2" ] && [ -r "$src/backends/libggml-cpu.so" ] || {
+      echo "runtime-set.sh: NN_RUNTIME_DIR=$src holds no wasmtime, loader and backends/libggml-cpu.so" >&2; exit 2; }
+    cp -L "$src/wasmtime" "$rt/wasmtime"
+    LD_LIBRARY_PATH="$src" ldd "$src/wasmtime" | awk '/=>/ {print $3}' | while read -r lib; do cp -L "$lib" "$rt/"; done
+    cp -L "$src/ld-linux-x86-64.so.2" "$rt/"
+    mkdir "$rt/backends"
+    cp -L "$src/backends/libggml-cpu.so" "$rt/backends/"
+    pt=$(mktemp -d)
+    trap 'rm -rf "$pt"' EXIT
+    printf '#!/bin/sh\nexec "%s/ld-linux-x86-64.so.2" --library-path "%s" "%s/wasmtime" "$@"\n' "$rt" "$rt" "$rt" > "$pt/wasmtime"
+    chmod 0755 "$pt/wasmtime"
+    "$here/../contract/runtime-identity.sh" "$pt/wasmtime" > "$rt/runtime.json"
+    for feature in set mem64; do
+      if "$here/probe-$feature.sh" "$pt/wasmtime" > "$rt/$feature.enabled.tmp"; then
+        mv "$rt/$feature.enabled.tmp" "$rt/$feature.enabled"
+      else
+        rm -f "$rt/$feature.enabled.tmp"
+      fi
+    done
+    if "$here/probe-nn-ggml.sh" "$rt" > "$pt/nn-ggml.enabled"; then
+      mv "$pt/nn-ggml.enabled" "$rt/nn-ggml.enabled"
+    else
+      echo "runtime-set.sh: NN_RUNTIME_DIR's runtime did not preload and serve a ggml graph; no nn-ggml.enabled" >&2
+    fi
+  else
   W=$(command -v wasmtime)
   cp -L "$W" "$rt/wasmtime"
   "$here/../contract/runtime-identity.sh" "$W" > "$rt/runtime.json"
@@ -42,6 +73,7 @@ compose)
   # "=> not found" makes $3 the word "not", and the cp of it fails the build, which is the right outcome.
   ldd "$W" | awk '/=>/ {print $3}' | while read -r lib; do cp -L "$lib" "$rt/"; done
   cp -L /lib64/ld-linux-x86-64.so.2 "$rt/" 2>/dev/null || cp -L /lib/ld-linux-x86-64.so.2 "$rt/"
+  fi
   ;;
 digest)
   [ -d "$rt" ] || { echo "runtime-set.sh: no directory $rt" >&2; exit 2; }
diff --git a/isolation/m4/test-modelvol-preload.sh b/isolation/m4/test-modelvol-preload.sh
new file mode 100755
index 0000000..a077ef3
--- /dev/null
+++ b/isolation/m4/test-modelvol-preload.sh
@@ -0,0 +1,85 @@
+#!/bin/sh
+# Model-volume PRELOAD, end to end on the CPU: the per-app init's model-volume code (isolation/m2/modelvol.h, through
+# testdata/modelvol-serve.c) stages two mounted volumes, budgets the ggml one against the guest's memory and execs the
+# real nn-capable runtime with exactly the argv and environment a measured guest gives it; a wasi:http app built on
+# load_by_name (enclave-apps/ggml-probe) then decodes through the preloaded graph, by the VOLUME's name. Cases:
+#   preloaded   1024 MiB: GET /?graph=qwen-a decodes (n_vocab of the fixture model), the weights never in the app
+#   data only   GET /?graph=data-b: a volume without a graph is mounted, never preloaded
+#   budget      257 MiB (1 MiB past the reserve): the graph is not preloaded, so load_by_name fails - the shared
+#               runtime's rule, mounted and listed but not preloaded past the tenant's memory
+#   no runtime  without the runtime's nn-ggml marker: no -S nn and no preload in the argv the init builds (an app that
+#               imports wasi:nn then cannot instantiate, as on the shared runtime without NN_ENABLED)
+# The volumes are plain directories here: mounting them over dm-verity is test-modelvol-qemu.sh's subject.
+#
+# usage: test-modelvol-preload.sh <nn runtime dir> <ggml-probe.wasm>
+#   (the runtime dir holds ld-linux-x86-64.so.2, wasmtime and its libraries, and backends/libggml-cpu.so)
+set -eu
+here=$(cd "$(dirname "$0")" && pwd)
+rt=${1:?usage: test-modelvol-preload.sh <nn runtime dir> <ggml-probe.wasm>}
+app=${2:?usage: test-modelvol-preload.sh <nn runtime dir> <ggml-probe.wasm>}
+for tool in gcc python3 curl; do command -v "$tool" >/dev/null || { echo "FAIL $tool is required"; exit 1; }; done
+[ -r "$rt/backends/libggml-cpu.so" ] && [ -x "$rt/wasmtime" ] || { echo "FAIL $rt is not an nn runtime directory"; exit 1; }
+d=$(mktemp -d)
+pid=""
+trap '[ -n "$pid" ] && kill "$pid" 2>/dev/null; rm -rf "$d"' EXIT
+mkdir -p "$d/models/qwen-a" "$d/models/data-b" "$d/backends" "$d/stage"
+python3 "$here/tiny-gguf.py" "$d/models/qwen-a/model.gguf" --vocab 151936 > /dev/null
+echo "fixture data" > "$d/models/data-b/readme"
+cp "$rt/backends/libggml-cpu.so" "$d/backends/"    # the CPU backend only: never the Shield GPU one
+pin=$(printf '%064d' 0 | tr 0 1)
+root=a1b2c3d4e5f60718293a4b5c6d7e8f9011223344556677889900aabbccddeeff
+printf 'data-b %s 00ff 4096 4096 10 11 49152 none - %s\nqwen-a %s 00ff 4096 4096 10 11 49152 ggml model.gguf %s\n' \
+  "$root" "$pin" "$root" "$pin" > "$d/table"
+printf 'M1\nvol=qwen-a\nvol=data-b\n' > "$d/m1"
+gcc -O2 -Wall -o "$d/serve" "$here/../m2/testdata/modelvol-serve.c" -DMV_ROOT="\"$d/models\"" -DMV_STAGE="\"$d/stage/nn-graph\"" \
+  -DMV_TABLE="\"$d/table\"" -DMV_NN_MARKER="\"$d/nn-ggml.enabled\"" -DMV_BACKEND_DIR="\"$d/backends\"" -DMV_M1="\"$d/m1\""
