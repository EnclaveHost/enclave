diff --git a/isolation/m3/secretrun/models.go b/isolation/m3/secretrun/models.go
new file mode 100644
index 0000000..1e8a031
--- /dev/null
+++ b/isolation/m3/secretrun/models.go
@@ -0,0 +1,43 @@
+package main
+
+// Model volumes in a secret partition domain (m3/monitor/modelvol.go, m3/domexec.c model_volumes): domexec already put
+// the preopens, the preloads and the --env NAMES in this process's argv, and their values in its environment. This
+// process execs the runtime with an environment of its own making, so it carries exactly those values across - and
+// only when the monitor's root-owned, read-only /model.volumes says this domain has model volumes. They are ENCLAVE_
+// names, which an owner secret may never be (shieldconfig.Validate), so no secret can shadow one.
+
+import (
+	"errors"
+	"os"
+	"syscall"
+)
+
+const modelMarker = "/model.volumes"
+
+var modelEnvNames = []string{"ENCLAVE_MODELS", "ENCLAVE_NN_PRELOADS", "ENCLAVE_NN_SERVE_BYTES", "ENCLAVE_NN_SERVE_KIND",
+	"ENCLAVE_GGML_BACKEND_DIR", "ENCLAVE_GGML_N_GPU_LAYERS"}
+
+// modelEnviron -> the model values to carry into the runtime's environment, or none without the monitor's marker.
+func modelEnviron(marker string, lookup func(string) (string, bool)) ([]string, error) {
+	fi, err := os.Lstat(marker)
+	if errors.Is(err, os.ErrNotExist) {
+		return nil, nil
+	}
+	if err != nil {
+		return nil, err
+	}
+	st, ok := fi.Sys().(*syscall.Stat_t)
+	if !fi.Mode().IsRegular() || fi.Mode().Perm()&0o222 != 0 || !ok || st.Uid != markerOwner || fi.Size() > 1024 {
+		return nil, errors.New("the model-volume marker is not the monitor's")
+	}
+	var out []string
+	for _, k := range modelEnvNames {
+		if v, ok := lookup(k); ok {
+			out = append(out, k+"="+v)
+		}
+	}
+	if len(out) == 0 {
+		return nil, errors.New("model volumes, and domexec named none")
+	}
+	return out, nil
+}
diff --git a/isolation/m3/secretrun/models_test.go b/isolation/m3/secretrun/models_test.go
new file mode 100644
index 0000000..5db8634
--- /dev/null
+++ b/isolation/m3/secretrun/models_test.go
@@ -0,0 +1,50 @@
+package main
+
+import (
+	"os"
+	"path/filepath"
+	"strings"
+	"testing"
+)
+
+func TestModelEnvironCarriesDomexecsValuesOnlyWithTheMonitorsMarker(t *testing.T) {
+	markerOwner = uint32(os.Getuid())
+	marker := filepath.Join(t.TempDir(), "model.volumes")
+	env := map[string]string{"ENCLAVE_MODELS": "qwen-a", "ENCLAVE_NN_PRELOADS": "qwen-a", "ENCLAVE_NN_SERVE_BYTES": "805306368",
+		"ENCLAVE_NN_SERVE_KIND": "RAM", "ENCLAVE_GGML_BACKEND_DIR": "/plat/rt/backends", "ENCLAVE_GGML_N_GPU_LAYERS": "0", "OTHER": "x"}
+	lookup := func(k string) (string, bool) { v, ok := env[k]; return v, ok }
+
+	// no marker: nothing, whatever the environment holds
+	if got, err := modelEnviron(marker, lookup); err != nil || got != nil {
+		t.Fatalf("no marker: %v %v", got, err)
+	}
+	os.WriteFile(marker, []byte("M1\nvol=qwen-a\n"), 0o444)
+	got, err := modelEnviron(marker, lookup)
+	if err != nil || strings.Join(got, " ") != "ENCLAVE_MODELS=qwen-a ENCLAVE_NN_PRELOADS=qwen-a ENCLAVE_NN_SERVE_BYTES=805306368 ENCLAVE_NN_SERVE_KIND=RAM ENCLAVE_GGML_BACKEND_DIR=/plat/rt/backends ENCLAVE_GGML_N_GPU_LAYERS=0" {
+		t.Fatalf("carried %v %v", got, err)
+	}
+	// a runtime without wasi-nn: only the names
+	got, _ = modelEnviron(marker, func(k string) (string, bool) {
+		if k == "ENCLAVE_MODELS" {
+			return "qwen-a", true
+		}
+		return "", false
+	})
+	if strings.Join(got, " ") != "ENCLAVE_MODELS=qwen-a" {
+		t.Fatalf("names only: %v", got)
+	}
+	// a marker and nothing from domexec: refused, never a runtime without its volumes' names
+	if _, err := modelEnviron(marker, func(string) (string, bool) { return "", false }); err == nil {
+		t.Fatal("a marker with nothing to carry")
+	}
+	// a marker anyone may write is not the monitor's
+	os.Chmod(marker, 0o644)
+	if _, err := modelEnviron(marker, lookup); err == nil || !strings.Contains(err.Error(), "not the monitor's") {
+		t.Fatalf("writable marker: %v", err)
+	}
+	os.Remove(marker)
+	os.Symlink("/etc/hostname", marker)
+	if _, err := modelEnviron(marker, lookup); err == nil {
+		t.Fatal("a symlinked marker")
+	}
+}
