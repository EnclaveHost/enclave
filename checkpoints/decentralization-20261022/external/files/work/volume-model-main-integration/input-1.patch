diff --git a/isolation/m3/monitor/modelvol.go b/isolation/m3/monitor/modelvol.go
new file mode 100644
index 0000000..c8da97f
--- /dev/null
+++ b/isolation/m3/monitor/modelvol.go
@@ -0,0 +1,200 @@
+package main
+
+// Model volumes (the measured config's "volumes", as the shared runtime reads them) in a partition domain.
+//
+// What a name IS comes from the platform tree's measured table (<plat>/rt/model-volumes.table, pinned when the image
+// was built; isolation/m2/modelspec): its dm-verity root, salt and geometry. The host only attaches disks (a Hyper-V
+// partition: SCSI, windows/vbslike/manager wmi-launcher.mjs; QEMU: virtio), and says nothing about which disk is which:
+// the monitor takes the attached disk of the volume's exact size whose hash tree hashes to the PINNED root
+// (modelspec.HoldsRoot), brings dm-verity up over it against that root (/mverity, isolation/m2/mverity.h) and mounts
+// ext4 read-only, nodev, nosuid, noexec at /models/<name>, once per partition. Every block a domain then reads is
+// verified against the root; a disk swapped or altered after the match fails at the read, never returns other bytes.
+//
+// A domain gets exactly the volumes its measured config names, bind-mounted read-only at <domain>/models/<name>, and a
+// root-owned, read-only /model.volumes (modelspec.M1) for domexec, which adds the preopens, the env names and, when the
+// runtime carries wasi-nn with ggml, the preloads (isolation/m2/modelvol.h, the per-app guest's own code). Refused, the
+// domain never started, never a silent drop: a config naming volumes on an image without the table, a name the table
+// lacks, a volume whose disk is not attached (or does not verify), more than modelspec.Max, and a Shield inference
+// domain (its image carries its own measured model).
+
+import (
+	"errors"
+	"fmt"
+	"os"
+	"os/exec"
+	"path/filepath"
+	"sort"
+	"strconv"
+	"strings"
+	"sync"
+	"syscall"
+	"time"
+
+	"enclave.host/isolation/m2/modelspec"
+)
+
+const (
+	modelTableName  = "rt/model-volumes.table" // under the platform tree
+	modelMarkerName = "model.volumes"          // in the domain's root, for domexec
+)
+
+type modelMounts struct {
+	mu      sync.Mutex
+	table   map[string]modelspec.Entry // nil: this image carries no table
+	bad     error                      // the table is present and malformed: every volume is refused
+	mounted map[string]string          // name -> its verified read-only mount
+	claimed map[string]string          // disk -> the volume it carries
+
+	sysBlock, dev, root string
+	wait                time.Duration // how long a load waits for a volume's disk to appear (SCSI scans are asynchronous)
+	setup               func(mapName, disk string, e modelspec.Entry) (string, error)
+	mount               func(node, at string) error
+}
+
+func newModelMounts(plat string) *modelMounts {
+	mm := &modelMounts{mounted: map[string]string{}, claimed: map[string]string{}, sysBlock: "/sys/block", dev: "/dev", root: "/models",
+		wait: 20 * time.Second, setup: verityByHelper("/mverity"), mount: mountVerifiedRO}
+	t, err := modelspec.ReadTable(filepath.Join(plat, modelTableName))
+	switch {
+	case err == nil:
+		mm.table = t
+		fmt.Printf("MON model volumes: the measured table carries %d\n", len(t))
+	case !errors.Is(err, os.ErrNotExist):
+		mm.bad = err
+		fmt.Printf("MON ERROR model volumes: %v; a domain naming any is refused\n", err)
+	}
+	return mm
+}
+
+// verityByHelper runs the measured dm-verity helper (metal/guest/mverity.c over isolation/m2/mverity.h): the table is
+// built from the PINNED entry only, and the helper prints the node it made.
+func verityByHelper(helper string) func(string, string, modelspec.Entry) (string, error) {
+	return func(mapName, disk string, e modelspec.Entry) (string, error) {
+		out, err := exec.Command(helper, mapName, disk, "4096", "4096", strconv.FormatInt(e.DataBlocks, 10),
+			strconv.FormatInt(e.HashStart, 10), "sha256", e.Root, e.Salt).Output()
+		if err != nil {
+			return "", fmt.Errorf("dm-verity: %w", err)
+		}
+		return strings.TrimSpace(string(out)), nil
+	}
+}
+
+func mountVerifiedRO(node, at string) error {
+	return syscall.Mount(node, at, "ext4", syscall.MS_RDONLY|syscall.MS_NODEV|syscall.MS_NOSUID|syscall.MS_NOEXEC, "")
+}
+
+// findDisk: an unclaimed disk of the entry's exact size holding its hash tree, or "".
+func (mm *modelMounts) findDisk(e modelspec.Entry) string {
+	ents, _ := os.ReadDir(mm.sysBlock)
+	names := []string{}
+	for _, de := range ents {
+		n := de.Name()
+		if (strings.HasPrefix(n, "sd") || strings.HasPrefix(n, "vd")) && mm.claimed[n] == "" {
+			names = append(names, n)
+		}
+	}
+	sort.Strings(names)
+	for _, n := range names {
+		raw, err := os.ReadFile(filepath.Join(mm.sysBlock, n, "size")) // 512-byte sectors
+		if err != nil {
+			continue
+		}
+		sectors, err := strconv.ParseInt(strings.TrimSpace(string(raw)), 10, 64)
+		if err != nil || sectors*512 != e.ImageBytes {
+			continue
+		}
+		f, err := os.Open(filepath.Join(mm.dev, n))
+		if err != nil {
+			continue
+		}
+		ok := modelspec.HoldsRoot(f, e)
+		f.Close()
+		if ok {
+			return n
+		}
+	}
+	return ""
+}
+
+// ensure mounts name once per partition and returns where.
+func (mm *modelMounts) ensure(name string) (string, error) {
+	mm.mu.Lock()
+	defer mm.mu.Unlock()
+	if at, ok := mm.mounted[name]; ok {
+		return at, nil
+	}
+	e, ok := mm.table[name]
+	if !ok {
+		return "", fmt.Errorf("model volume %q is not one this image's measured table carries", name)
+	}
+	disk := ""
+	for deadline := time.Now().Add(mm.wait); ; time.Sleep(200 * time.Millisecond) {
+		if disk = mm.findDisk(e); disk != "" || time.Now().After(deadline) {
+			break
+		}
+	}
+	if disk == "" {
+		return "", fmt.Errorf("model volume %q: no attached disk holds its pinned hash tree", name)
+	}
+	node, err := mm.setup("mv-"+name, filepath.Join(mm.dev, disk), e)
+	if err != nil {
+		return "", fmt.Errorf("model volume %q: %w", name, err)
+	}
+	mm.claimed[disk] = name
+	at := filepath.Join(mm.root, name)
+	if err := os.MkdirAll(at, 0o755); err != nil {
+		return "", err
+	}
+	// a disk whose superblock does not verify fails here, through the verity device
+	if err := mm.mount(node, at); err != nil {
+		return "", fmt.Errorf("model volume %q: read-only mount over dm-verity: %w", name, err)
+	}
+	mm.mounted[name] = at
+	fmt.Printf("MON model volume %s verified on %s (root %s) and mounted read-only\n", name, disk, e.Root[:16])
+	return at, nil
+}
+
+// stageModelVolumes gives d the volumes its measured config names, or refuses it. No volumes: nothing.
+func stageModelVolumes(d *domain, mm *modelMounts, bind func(src, dst string) error) error {
+	names := modelspec.ConfigVolumes(string(d.AppConfig))
+	if len(names) == 0 {
+		return nil
+	}
+	switch {
+	case d.Inference != nil:
+		return errors.New("the config names model volumes, and a Shield inference domain carries its own measured model: the app is not started without its volumes")
+	case len(names) > modelspec.Max:
+		return fmt.Errorf("the config names %d model volumes; a domain mounts at most %d", len(names), modelspec.Max)
+	case mm == nil || mm.bad != nil:
+		return errors.New("the config names model volumes, and this image's model-volume table is malformed")
+	case mm.table == nil:
+		return errors.New("the config names model volumes, and this image carries no model-volume table: the app is not started without its volumes")
+	}
+	for _, n := range names {
+		if !modelspec.NameRE.MatchString(n) {
+			return fmt.Errorf("model volume %q is not one this image's measured table carries", n)
+		}
+	}
+	for _, n := range names {
+		src, err := mm.ensure(n)
+		if err != nil {
+			return err
+		}
+		dst := filepath.Join(d.dir, "models", n)
+		if err := os.MkdirAll(dst, 0o755); err != nil {
+			return err
+		}
+		if err := bind(src, dst); err != nil {
+			return fmt.Errorf("model volume %s: %w", n, err)
+		}
+		d.modelMounts = append(d.modelMounts, dst)
+	}
+	return os.WriteFile(filepath.Join(d.dir, modelMarkerName), modelspec.M1(names), 0o444)
+}
+
+func bindReadOnly(src, dst string) error {
+	if err := syscall.Mount(src, dst, "", syscall.MS_BIND, ""); err != nil {
+		return err
+	}
+	return syscall.Mount("", dst, "", syscall.MS_BIND|syscall.MS_REMOUNT|syscall.MS_RDONLY|syscall.MS_NOSUID|syscall.MS_NODEV|syscall.MS_NOEXEC, "")
+}
diff --git a/isolation/m3/monitor/modelvol_kernel_test.go b/isolation/m3/monitor/modelvol_kernel_test.go
new file mode 100644
index 0000000..8666828
--- /dev/null
+++ b/isolation/m3/monitor/modelvol_kernel_test.go
@@ -0,0 +1,87 @@
+//go:build linux && amd64
+
+package main
+
+// The monitor's model-volume code against a REAL kernel: this test binary is PID 1 of a throwaway QEMU/KVM guest
+// (isolation/m3/test-modelvol-qemu.sh) whose disks are SCSI (sd*, as Hyper-V's storvsc presents them). It loads the
+// device-mapper modules as the partition's init does, then stages a domain's volume exactly as a load does:
+// newModelMounts over the measured table, the disk found by its hash tree, /mverity, the read-only ext4 mount, the
+// read-only bind into the domain, the marker. Every outcome is one "MVTEST ..." console line; the guest then powers
+// off. Skipped anywhere else.
+
+import (
+	"crypto/sha256"
+	"encoding/hex"
+	"fmt"
+	"io"
+	"os"
+	"path/filepath"
+	"syscall"
+	"testing"
+	"unsafe"
+)
+
+const sysFinitModule = 313 // linux/amd64; not in package syscall's table
+
+func TestModelVolumesOnARealKernel(t *testing.T) {
+	if os.Getenv("MVQEMU") == "" || os.Getpid() != 1 {
+		t.Skip("runs only as PID 1 of the guest isolation/m3/test-modelvol-qemu.sh boots")
+	}
+	defer func() {
+		fmt.Println("MVTEST end")
+		syscall.Sync()
+		syscall.Reboot(syscall.LINUX_REBOOT_CMD_POWER_OFF)
+	}()
+	for _, m := range [][3]string{{"proc", "/proc", "proc"}, {"sysfs", "/sys", "sysfs"}, {"devtmpfs", "/dev", "devtmpfs"}, {"tmpfs", "/tmp", "tmpfs"}} {
+		os.MkdirAll(m[1], 0o755)
+		syscall.Mount(m[0], m[1], m[2], 0, "")
+	}
+	for _, ko := range []string{"/dm-mod.ko.zst", "/dm-bufio.ko.zst", "/reed_solomon.ko.zst", "/dm-verity.ko.zst"} {
+		f, err := os.Open(ko)
+		if err != nil {
+			fmt.Printf("MVTEST insmod %s: %v\n", ko, err)
+			continue
+		}
+		params := []byte{0} // no module parameters; 4 = MODULE_INIT_COMPRESSED_FILE
+		if _, _, e := syscall.Syscall(sysFinitModule, f.Fd(), uintptr(unsafe.Pointer(&params[0])), 4); e != 0 && e != syscall.EEXIST {
+			fmt.Printf("MVTEST insmod %s: %v\n", ko, e)
+		}
+		f.Close()
+	}
+	mm := newModelMounts("/plat")
+	d := &domain{AppConfig: []byte(`{"volumes":["fixture-a"]}`), dir: "/domains/1"}
+	os.MkdirAll(d.dir, 0o755)
+	if err := stageModelVolumes(d, mm, bindReadOnly); err != nil {
+		fmt.Printf("MVTEST refused: %v\n", err)
+		return
+	}
+	marker, _ := os.ReadFile(filepath.Join(d.dir, modelMarkerName))
+	fmt.Printf("MVTEST staged marker=%q\n", marker)
+	at := filepath.Join(d.dir, "models", "fixture-a")
+	var st syscall.Statfs_t
+	if syscall.Statfs(at, &st) == nil {
+		fmt.Printf("MVTEST bound ro=%v\n", st.Flags&0x1 != 0) // ST_RDONLY
+	}
+	f, err := os.Open(filepath.Join(at, "payload.bin"))
+	if err != nil {
+		fmt.Printf("MVTEST read-failed open: %v\n", err)
+		return
+	}
+	h := sha256.New()
+	n, err := io.Copy(h, f)
+	f.Close()
+	if err != nil {
+		fmt.Printf("MVTEST read-failed after %d bytes: %v\n", n, err)
+	} else {
+		fmt.Printf("MVTEST read %d bytes sha256=%s\n", n, hex.EncodeToString(h.Sum(nil)))
+	}
+	_, werr := os.OpenFile(filepath.Join(at, "payload.bin"), os.O_WRONLY, 0)
+	fmt.Printf("MVTEST write-refused=%v\n", werr != nil && os.IsPermission(werr) || isEROFS(werr))
+	_, cerr := os.Create(filepath.Join(at, "new-file"))
+	fmt.Printf("MVTEST create-refused=%v\n", isEROFS(cerr))
+}
+
+func isEROFS(err error) bool {
+	pe, ok := err.(*os.PathError)
+	return ok && pe.Err == syscall.EROFS
+}
diff --git a/isolation/m3/monitor/modelvol_test.go b/isolation/m3/monitor/modelvol_test.go
new file mode 100644
index 0000000..c938f10
--- /dev/null
+++ b/isolation/m3/monitor/modelvol_test.go
@@ -0,0 +1,152 @@
+package main
+
+import (
+	"crypto/sha256"
+	"encoding/hex"
+	"errors"
+	"fmt"
+	"os"
+	"path/filepath"
+	"strings"
+	"testing"
+	"time"
+
+	"enclave.host/isolation/contract"
+	"enclave.host/isolation/m2/modelspec"
+)
+
+// a disk image whose top-level hash block hashes (salt || block) to the returned root, as a dm-verity tree does; the
+// format itself is checked against veritysetup in isolation/m2/modelspec
+func fakeVerityDisk(t *testing.T, path string, size, hashStart int64, seed byte) string {
+	b := make([]byte, size)
+	for i := range b[hashStart*4096 : hashStart*4096+4096] {
+		b[hashStart*4096+int64(i)] = seed + byte(i)
+	}
+	if err := os.WriteFile(path, b, 0o600); err != nil {
+		t.Fatal(err)
+	}
+	h := sha256.Sum256(append([]byte{0x00, 0xff}, b[hashStart*4096:hashStart*4096+4096]...))
+	return hex.EncodeToString(h[:])
+}
+
+type modelRig struct {
+	mm       *modelMounts
+	setups   []string
+	mounts   []string
+	failNode string
+}
+
+// a partition with disks sda.. (name -> size, seed); the table pins volumes by root
+func newModelRig(t *testing.T, table map[string]modelspec.Entry, disks map[string][2]int64) *modelRig {
+	dir := t.TempDir()
+	r := &modelRig{}
+	r.mm = &modelMounts{table: table, mounted: map[string]string{}, claimed: map[string]string{},
+		sysBlock: filepath.Join(dir, "sys"), dev: filepath.Join(dir, "dev"), root: filepath.Join(dir, "models"), wait: 300 * time.Millisecond,
+		setup: func(mapName, disk string, e modelspec.Entry) (string, error) {
+			r.setups = append(r.setups, mapName+" "+filepath.Base(disk)+" "+e.Root[:8])
+			return "/dev/mapper/" + mapName, nil
+		},
+		mount: func(node, at string) error {
+			if node == r.failNode {
+				return errors.New("bad superblock")
+			}
+			r.mounts = append(r.mounts, node+" "+filepath.Base(at))
+			return nil
+		}}
+	os.MkdirAll(r.mm.dev, 0o755)
+	for name, d := range disks {
+		os.MkdirAll(filepath.Join(r.mm.sysBlock, name), 0o755)
+		os.WriteFile(filepath.Join(r.mm.sysBlock, name, "size"), []byte(fmt.Sprintf("%d\n", d[0]/512)), 0o444)
+		fakeVerityDisk(t, filepath.Join(r.mm.dev, name), d[0], 11, byte(d[1]))
+	}
+	return r
+}
+
+func entry(name string, size, seed int64, t *testing.T) modelspec.Entry {
+	root := fakeVerityDisk(t, filepath.Join(t.TempDir(), "x"), size, 11, byte(seed))
+	return modelspec.Entry{Name: name, Root: root, Salt: "00ff", DataBlocks: 10, HashStart: 11, ImageBytes: size, Preload: "ggml", Graph: "model.gguf", Pin: strings.Repeat("11", 32)}
+}
+
+func TestModelVolumesMountOnlyThePinnedDisk(t *testing.T) {
+	const size = 16 * 4096
+	qwen, data := entry("qwen-a", size, 1, t), entry("data-b", size+4096, 2, t)
+	table := map[string]modelspec.Entry{"qwen-a": qwen, "data-b": data}
+	// sda: the right size, another tree (a decoy); sdb: qwen's; sdc: data's; vda: data's tree at the wrong size
+	r := newModelRig(t, table, map[string][2]int64{"sda": {size, 9}, "sdb": {size, 1}, "sdc": {size + 4096, 2}, "vda": {size + 8192, 2}})
+	var binds []string
+	bind := func(src, dst string) error {
+		binds = append(binds, filepath.Base(src)+"->"+filepath.Base(dst))
+		return nil
+	}
+
+	d := &domain{AppConfig: []byte(`{"volumes":["data-b"," qwen-a ","data-b"]}`), dir: t.TempDir()}
+	if err := stageModelVolumes(d, r.mm, bind); err != nil {
+		t.Fatal(err)
+	}
+	if strings.Join(r.setups, ",") != "mv-data-b sdc "+data.Root[:8]+",mv-qwen-a sdb "+qwen.Root[:8] {
+		t.Fatalf("verity over %v", r.setups)
+	}
+	if strings.Join(r.mounts, ",") != "/dev/mapper/mv-data-b data-b,/dev/mapper/mv-qwen-a qwen-a" || strings.Join(binds, ",") != "data-b->data-b,qwen-a->qwen-a" {
+		t.Fatalf("mounts %v binds %v", r.mounts, binds)
+	}
+	if b, _ := os.ReadFile(filepath.Join(d.dir, "model.volumes")); string(b) != "M1\nvol=data-b\nvol=qwen-a\n" {
+		t.Fatalf("marker %q", b)
+	}
+	if fi, _ := os.Stat(filepath.Join(d.dir, "model.volumes")); fi.Mode().Perm() != 0o444 {
+		t.Fatalf("marker mode %v", fi.Mode())
+	}
+	if len(d.modelMounts) != 2 || d.modelMounts[1] != filepath.Join(d.dir, "models", "qwen-a") {
+		t.Fatalf("reclaim list %v", d.modelMounts)
+	}
+	// a second domain shares the partition's verified mount: no second verity device
+	d2 := &domain{AppConfig: []byte(`{"volumes":["qwen-a"]}`), dir: t.TempDir()}
+	if err := stageModelVolumes(d2, r.mm, bind); err != nil || len(r.setups) != 2 {
+		t.Fatalf("shared: %v %v", err, r.setups)
+	}
+	// no volumes: nothing, on any image
+	for _, cfg := range []string{"", `{"a":1}`, `{"volumes":[]}`} {
+		d := &domain{AppConfig: []byte(cfg), dir: t.TempDir()}
+		if err := stageModelVolumes(d, nil, bind); err != nil || len(d.modelMounts) != 0 {
+			t.Errorf("%q: %v", cfg, err)
+		}
+		if _, err := os.Stat(filepath.Join(d.dir, "model.volumes")); !os.IsNotExist(err) {
+			t.Errorf("%q: a marker without volumes", cfg)
+		}
+	}
+}
+
+func TestModelVolumesRefusedNeverDropped(t *testing.T) {
+	const size = 16 * 4096
+	qwen := entry("qwen-a", size, 1, t)
+	other := entry("other-c", size, 3, t)
+	table := map[string]modelspec.Entry{"qwen-a": qwen, "other-c": other}
+	bind := func(src, dst string) error { return nil }
+	r := newModelRig(t, table, map[string][2]int64{"sda": {size, 1}})
+	for name, c := range map[string]struct {
+		mm        *modelMounts
+		cfg       string
+		want      string
+		inference *contract.Inference
+	}{
+		"a Shield inference domain": {r.mm, `{"volumes":["qwen-a"]}`, "carries its own measured model", &contract.Inference{}},
+		"a name the table lacks":    {r.mm, `{"volumes":["llama-70b"]}`, "not one this image's measured table carries", nil},
+		"a name outside the form":   {r.mm, `{"volumes":["Qwen"]}`, "not one this image's measured table carries", nil},
+		"no disk holds its tree":    {r.mm, `{"volumes":["other-c"]}`, "no attached disk holds its pinned hash tree", nil},
+		"nine volumes":              {r.mm, `{"volumes":["a","b","c","d","e","f","g","h","i"]}`, "at most 8", nil},
+		"an image without a table":  {&modelMounts{}, `{"volumes":["qwen-a"]}`, "carries no model-volume table", nil},
+		"a malformed table":         {&modelMounts{bad: errors.New("x")}, `{"volumes":["qwen-a"]}`, "malformed", nil},
+	} {
+		d := &domain{AppConfig: []byte(c.cfg), dir: t.TempDir(), Inference: c.inference}
+		if err := stageModelVolumes(d, c.mm, bind); err == nil || !strings.Contains(err.Error(), c.want) {
+			t.Errorf("%s: %v", name, err)
+		}
+		if _, err := os.Stat(filepath.Join(d.dir, "model.volumes")); !os.IsNotExist(err) {
+			t.Errorf("%s: a marker for a refused domain", name)
+		}
+	}
+	// a disk whose superblock fails verity: refused
+	r.failNode = "/dev/mapper/mv-qwen-a"
+	if err := stageModelVolumes(&domain{AppConfig: []byte(`{"volumes":["qwen-a"]}`), dir: t.TempDir()}, r.mm, bind); err == nil || !strings.Contains(err.Error(), "read-only mount over dm-verity") {
+		t.Errorf("a failing mount: %v", err)
+	}
+}
