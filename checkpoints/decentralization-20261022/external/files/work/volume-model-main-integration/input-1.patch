diff --git a/isolation/m4/guestd/modelvol.go b/isolation/m4/guestd/modelvol.go
new file mode 100644
index 0000000..63e08db
--- /dev/null
+++ b/isolation/m4/guestd/modelvol.go
@@ -0,0 +1,138 @@
+package main
+
+// modelvol.go: the model volumes this host can attach to a per-app guest.
+//
+// What a volume IS comes from the pinned CPU template's measured table (rt/model-volumes.table; one line per volume:
+// name, dm-verity root, salt, geometry, image bytes, preload kind and graph, distribution pin). What this host HAS is
+// its store (-model-volumes <dir>: metal/volumes.mjs layout, <dir>/<name>/{volume.json,volume.img}, filled by
+// `metal/volumes.mjs fetch` from replicas or built locally). A volume is offered only when the store's record states
+// exactly the table's root and geometry and the image is the table's size: the guest verifies every block against the
+// pinned root anyway, so this only keeps a host from advertising, and a lease from being claimed for, a volume whose
+// guest would refuse to start.
+//
+// The guest learns which disk is which from its virtio serial: "mv" + the root's first 18 hex digits (modelvol.h).
+// guestd writes the attach list beside the image (<image>.volumes, one "<serial> <path>" per line) for run-domain.sh,
+// the way a Shield image carries <image>.shield.
+
+import (
+	"encoding/json"
+	"fmt"
+	"os"
+	"path/filepath"
+	"sort"
+	"strings"
+
+	"enclave.host/isolation/m2/modelspec"
+)
+
+const modelVolumesMax = modelspec.Max
+
+type modelEntry = modelspec.Entry
+
+type modelVolume struct {
+	modelEntry
+	Image string // the store's image path
+}
+
+// parseModelTable reads the measured table (modelspec.ParseTable: sdk/storage/model-volumes.mjs tableLine).
+func parseModelTable(path string) (map[string]modelEntry, error) { return modelspec.ReadTable(path) }
+
+// storeVolumes: the table's volumes this host's store holds intact (record and size agree with the pinned entry).
+// The second result says why each other table volume is absent, for /health.
+func storeVolumes(table map[string]modelEntry, store string) (map[string]modelVolume, map[string]string) {
+	have, missing := map[string]modelVolume{}, map[string]string{}
+	for name, e := range table {
+		dir := filepath.Join(store, name)
+		raw, err := os.ReadFile(filepath.Join(dir, "volume.json"))
+		if err != nil {
+			missing[name] = "not in this host's store"
+			continue
+		}
+		var rec struct {
+			Name       string `json:"name"`
+			Image      string `json:"image"`
+			ImageBytes int64  `json:"imageBytes"`
+			Verity     struct {
+				Alg            string `json:"alg"`
+				Root           string `json:"root"`
+				Salt           string `json:"salt"`
+				DataBlockSize  int64  `json:"dataBlockSize"`
+				HashBlockSize  int64  `json:"hashBlockSize"`
+				DataBlocks     int64  `json:"dataBlocks"`
+				HashStartBlock int64  `json:"hashStartBlock"`
+			} `json:"verity"`
+		}
+		if json.Unmarshal(raw, &rec) != nil || rec.Name != name || rec.Verity.Alg != "sha256" || rec.Verity.Root != e.Root || rec.Verity.Salt != e.Salt ||
+			rec.Verity.DataBlockSize != 4096 || rec.Verity.HashBlockSize != 4096 || rec.Verity.DataBlocks != e.DataBlocks ||
+			rec.Verity.HashStartBlock != e.HashStart || rec.ImageBytes != e.ImageBytes {
+			missing[name] = "the store's record is not the pinned volume"
+			continue
+		}
+		img := filepath.Join(dir, "volume.img")
+		if rec.Image != "" && rec.Image != "volume.img" {
+			missing[name] = "unexpected image name in the store's record"
+			continue
+		}
+		st, err := os.Lstat(img)
+		if err != nil || !st.Mode().IsRegular() || st.Size() != e.ImageBytes || strings.ContainsAny(img, ", \n") {
+			missing[name] = "the store's image is not the pinned size (or not a plain file)"
+			continue
+		}
+		have[name] = modelVolume{modelEntry: e, Image: img}
+	}
+	return have, missing
+}
+
+// modelVolumesHealth: what /health advertises (the names the supervisor's volume gate matches, with what they are).
+func (s *server) modelVolumesHealth() []map[string]any {
+	names := make([]string, 0, len(s.ModelVolumes))
+	for n := range s.ModelVolumes {
+		names = append(names, n)
+	}
+	sort.Strings(names)
+	out := []map[string]any{}
+	for _, n := range names {
+		v := s.ModelVolumes[n]
+		out = append(out, map[string]any{"name": n, "bytes": v.ImageBytes, "backend": v.Preload, "root": v.Root, "pin": v.Pin, "kind": "model"})
+	}
+	return out
+}
+
+// modelRefusal: why a create's volumes cannot be attached here, or "".
+func (s *server) modelRefusal(names []string, inference bool, legacy bool) string {
+	if len(names) == 0 {
+		return ""
+	}
+	switch {
+	case inference:
+		return "model volumes beside a Shield inference model: that image carries its own measured model"
+	case legacy:
+		return "model volumes need this release image, not a legacy guest"
+	case len(names) > modelVolumesMax:
+		return fmt.Sprintf("more than %d model volumes", modelVolumesMax)
+	}
+	seen := map[string]bool{}
+	for _, n := range names {
+		if seen[n] {
+			return "a model volume named twice"
+		}
+		seen[n] = true
+		if _, ok := s.ModelVolumes[n]; !ok {
+			return fmt.Sprintf("model volume %q: this host's pinned table and store do not carry it", n)
+		}
+	}
+	return ""
+}
+
+// writeVolumeAttach writes <image>.volumes for run-domain.sh: "<serial> <path>" per requested volume, in request order.
+func (s *server) writeVolumeAttach(image string, names []string) error {
+	if len(names) == 0 {
+		return nil
+	}
+	var b strings.Builder
+	for _, n := range names {
+		v := s.ModelVolumes[n]
+		fmt.Fprintf(&b, "%s %s\n", v.Serial(), v.Image)
+	}
+	return os.WriteFile(image+".volumes", []byte(b.String()), 0o600)
+}
diff --git a/isolation/m4/guestd/modelvol_test.go b/isolation/m4/guestd/modelvol_test.go
new file mode 100644
index 0000000..053e629
--- /dev/null
+++ b/isolation/m4/guestd/modelvol_test.go
@@ -0,0 +1,159 @@
+package main
+
+import (
+	"fmt"
+	"os"
+	"path/filepath"
+	"strings"
+	"testing"
+
+	"enclave.host/isolation/contract"
+)
+
+const (
+	rootA = "a1b2c3d4e5f60718293a4b5c6d7e8f9011223344556677889900aabbccddeeff"
+	rootB = "0f1e2d3c4b5a69788796a5b4c3d2e1f00112233445566778899aabbccddeeff0"
+	pinX  = "1111111111111111111111111111111111111111111111111111111111111111"
+)
+
+func modelLine(name, root string, preload, graph string) string {
+	return fmt.Sprintf("%s %s 00ff 4096 4096 10 11 49152 %s %s %s\n", name, root, preload, graph, pinX)
+}
+
+// a store volume as metal/volumes.mjs lays it out: its record states 49152 bytes; the image is size bytes
+func storeVolume(t *testing.T, store, name, root string, size int64) {
+	dir := filepath.Join(store, name)
+	os.MkdirAll(dir, 0o755)
+	rec := fmt.Sprintf(`{"name":%q,"image":"volume.img","imageBytes":49152,"verity":{"alg":"sha256","root":%q,"salt":"00ff","dataBlockSize":4096,"hashBlockSize":4096,"dataBlocks":10,"hashOffset":40960,"hashStartBlock":11}}`, name, root)
+	os.WriteFile(filepath.Join(dir, "volume.json"), []byte(rec), 0o644)
+	f, _ := os.Create(filepath.Join(dir, "volume.img"))
+	f.Truncate(size)
+	f.Close()
+}
+
+func TestModelTableIsStrict(t *testing.T) {
+	dir := t.TempDir()
+	good := modelLine("qwen-a", rootA, "ggml", "model.gguf") + modelLine("data-b", rootB, "none", "-")
+	p := filepath.Join(dir, "t")
+	os.WriteFile(p, []byte(good), 0o444)
+	tab, err := parseModelTable(p)
+	if err != nil || len(tab) != 2 || tab["qwen-a"].Serial() != "mva1b2c3d4e5f6071829" || tab["data-b"].Preload != "none" {
+		t.Fatalf("table %v %v", tab, err)
+	}
+	for i, bad := range []string{
+		strings.Replace(good, "qwen-a", "Qwen-A", 1), strings.Replace(good, " 4096 4096 ", " 512 4096 ", 1),
+		strings.Replace(good, " 10 11 ", " 10 10 ", 1), strings.Replace(good, " ggml ", " onnx ", 1),
+		strings.Replace(good, " none - ", " none x.gguf ", 1), good + modelLine("qwen-a", rootA, "ggml", "m.gguf"),
+		strings.Replace(good, " 49152 ", " 49153 ", 1), "short line\n",
+	} {
+		os.Remove(p) // the table is written read-only, as an image carries it
+		os.WriteFile(p, []byte(bad), 0o444)
+		if _, err := parseModelTable(p); err == nil {
+			t.Errorf("bad table %d accepted", i)
+		}
+	}
+}
+
+func TestStoreOffersOnlyThePinnedVolumes(t *testing.T) {
+	store := t.TempDir()
+	tab := map[string]modelEntry{
+		"qwen-a":  {Name: "qwen-a", Root: rootA, Salt: "00ff", DataBlocks: 10, HashStart: 11, ImageBytes: 49152, Preload: "ggml", Graph: "model.gguf", Pin: pinX},
+		"data-b":  {Name: "data-b", Root: rootB, Salt: "00ff", DataBlocks: 10, HashStart: 11, ImageBytes: 49152, Preload: "none", Graph: "-", Pin: pinX},
+		"gone-c":  {Name: "gone-c", Root: rootA, Salt: "00ff", DataBlocks: 10, HashStart: 11, ImageBytes: 49152, Preload: "none", Graph: "-", Pin: pinX},
+		"short-d": {Name: "short-d", Root: rootA, Salt: "00ff", DataBlocks: 10, HashStart: 11, ImageBytes: 49152, Preload: "none", Graph: "-", Pin: pinX},
+	}
+	storeVolume(t, store, "qwen-a", rootA, 49152)
+	storeVolume(t, store, "data-b", rootA, 49152) // the store's record names another root
+	storeVolume(t, store, "short-d", rootA, 4096) // truncated image
+	have, missing := storeVolumes(tab, store)
+	if len(have) != 1 || have["qwen-a"].Image != filepath.Join(store, "qwen-a", "volume.img") {
+		t.Fatalf("have %v", have)
+	}
+	if !strings.Contains(missing["data-b"], "not the pinned volume") || !strings.Contains(missing["gone-c"], "not in this host's store") ||
+		!strings.Contains(missing["short-d"], "not the pinned size") {
+		t.Fatalf("missing %v", missing)
+	}
+}
+
+func TestCreateAttachesExactlyTheRequestedPinnedVolumes(t *testing.T) {
+	r := newRig(t)
+	store := t.TempDir()
+	tab := map[string]modelEntry{
+		"qwen-a": {Name: "qwen-a", Root: rootA, Salt: "00ff", DataBlocks: 10, HashStart: 11, ImageBytes: 49152, Preload: "ggml", Graph: "model.gguf", Pin: pinX},
+		"data-b": {Name: "data-b", Root: rootB, Salt: "00ff", DataBlocks: 10, HashStart: 11, ImageBytes: 49152, Preload: "none", Graph: "-", Pin: pinX},
+	}
+	storeVolume(t, store, "qwen-a", rootA, 49152)
+	storeVolume(t, store, "data-b", rootB, 49152)
+	r.s.ModelVolumes, r.s.ModelMissing = storeVolumes(tab, store)
+	r.s.ModelTable, r.s.RuntimeNN = true, true
+
+	// health: the volumes as the supervisor's gate reads them, and the capability only with -release
+	_, h := r.do("GET", "/health", nil)
+	vols, _ := h["volumes"].([]any)
+	names := []string{}
+	for _, v := range vols {
+		m := v.(map[string]any)
+		if m["kind"] == "model" {
+			names = append(names, fmt.Sprint(m["name"], ":", m["backend"]))
+		}
+	}
+	if strings.Join(names, ",") != "data-b:none,qwen-a:ggml" {
+		t.Fatalf("advertised %v", names)
+	}
+	sup := h["supports"].(map[string]any)
+	if sup["modelVolumes"] != false || sup["nnPreload"] != true {
+		t.Fatalf("supports without -release: %v", sup)
+	}
+	r.s.Release = true
+	_, h = r.do("GET", "/health", nil)
+	if h["supports"].(map[string]any)["modelVolumes"] != true {
+		t.Fatal("supports.modelVolumes with the table and -release")
+	}
+	r.s.Release = false
+
+	p, _ := r.bundle("A", contract.Policy{})
+	body := func(name string, vols ...string) map[string]any {
+		return map[string]any{"image": "file://" + p, "name": name, "cpuShare": 0.25, "gpuShare": 0, "appPort": 8080,
+			"ports": []any{}, "config": "", "configCid": "", "egress": "", "volumes": vols}
+	}
+	for name, c := range map[string]struct {
+		vols []string
+		want string
+	}{
+		"0xb1": {[]string{"llama-70b"}, "do not carry it"},
+		"0xb2": {[]string{"qwen-a", "qwen-a"}, "named twice"},
+		"0xb3": {[]string{"a", "b", "c", "d", "e", "f", "g", "h", "i"}, "more than 8"},
+	} {
+		if code, out := r.do("POST", "/vms", body(name, c.vols...)); code != 422 || !strings.Contains(fmt.Sprint(out["error"]), c.want) {
+			t.Errorf("%v: %d %v", c.vols, code, out)
+		}
+	}
+	// a Shield inference image carries its own measured model; a legacy guest has no table: both refused
+	if why := r.s.modelRefusal([]string{"qwen-a"}, true, false); !strings.Contains(why, "Shield inference") {
+		t.Errorf("beside inference: %q", why)
+	}
+	if why := r.s.modelRefusal([]string{"qwen-a"}, false, true); !strings.Contains(why, "legacy") {
+		t.Errorf("legacy: %q", why)
+	}
+	code, out := r.do("POST", "/vms", body("0xa1", "qwen-a", "data-b"))
+	if code != 201 {
+		t.Fatalf("create: %d %v", code, out)
+	}
+	r.s.launching.Wait()
+	id := out["id"].(string)
+	got, err := os.ReadFile(filepath.Join(r.s.Root, id, "guest.cpio.gz.volumes"))
+	want := "mva1b2c3d4e5f6071829 " + filepath.Join(store, "qwen-a", "volume.img") + "\n" +
+		"mv0f1e2d3c4b5a697887 " + filepath.Join(store, "data-b", "volume.img") + "\n"
+	if err != nil || string(got) != want {
+		t.Fatalf("attach list %q %v, want %q", got, err, want)
+	}
+	// a create without volumes writes no list (an image without one attaches nothing)
+	code, out = r.do("POST", "/vms", body("0xa2"))
+	if code != 201 {
+		t.Fatalf("create: %d %v", code, out)
+	}
+	r.s.launching.Wait()
+	if _, err := os.Stat(filepath.Join(r.s.Root, out["id"].(string), "guest.cpio.gz.volumes")); !os.IsNotExist(err) {
+		t.Fatalf("a list without volumes: %v", err)
+	}
+}
