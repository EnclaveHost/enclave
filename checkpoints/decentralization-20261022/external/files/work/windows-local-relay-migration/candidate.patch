@@ -0,0 +1,305 @@
+// Moving an EXISTING funded lease relay key (the DigitalOcean us-west relay) onto a Windows host as that host's OWN loopback
+// relay (work/windows-local-relay-migration). What runs here is what would be installed:
+//   - the node agent's chain module is the ACTIVATED one (windows/node/chain.mjs 753818e2, plan app-lease-hardening-
+//     20261021), unchanged; only its lease-gas runtime bundle is the new one (d2e363c5, LOCAL_RELAY). A test-only
+//     transport adapter (helpers/windows-lease-runtime-fixture.mjs: loopback RPCs, short timeouts) wraps the REAL bundle;
+//   - every relay is the reviewed release artifact (scripts/build-lease-relay-release.mjs) started as its run loop starts it;
+//   - the migration gate is the bundled check (scripts/build-lease-relay-migration-check.mjs) run as a separate process;
+//   - the node's settings are the staged lease-gas-config.cmd files, read by the config check with the real bundles.
+// Local anvil (chain 8453) behind https RPC proxies; fixture keys only. The "source" relay stands for us-west on
+// DigitalOcean, "eu-central" for the approved secondary, "target" for the same key moved to the Windows host.
+import { before, after, test } from "node:test";
+import assert from "node:assert/strict";
+import fs from "node:fs";
+import os from "node:os";
+import path from "node:path";
+import http from "node:http";
+import https from "node:https";
+import { spawn, execFileSync, spawnSync } from "node:child_process";
+import { registerHooks } from "node:module";
+import { createHash } from "node:crypto";
+import { fileURLToPath } from "node:url";
+import { keccak256 } from "viem";
+import { generatePrivateKey, privateKeyToAccount } from "viem/accounts";
+import { startWorld, haveAnvil, DEPLOYER } from "./helpers/lease-gas-world.mjs";
+
+const REPO = path.resolve(path.dirname(fileURLToPath(import.meta.url)), "..");
+const FIX = path.join(REPO, "test/fixtures/local-relay-migration");
+const hostUrl = new URL("../windows/node/chain.mjs", import.meta.url).href;
+const newFixture = new URL("./helpers/windows-lease-runtime-fixture.mjs", import.meta.url).href;
+const oldFixture = new URL("./helpers/windows-lease-runtime-old-fixture.mjs", import.meta.url).href;
+const hooks = registerHooks({ resolve(specifier, context, nextResolve) {
+  if (context.parentURL?.startsWith(hostUrl) && specifier === "./lease-gas-runtime.bundle.mjs")
+    return { url: context.parentURL.includes("bundle=old") ? oldFixture : newFixture, shortCircuit: true };
+  return nextResolve(specifier, context);
+} });
+const T = { skip: !haveAnvil && "needs anvil", timeout: 600_000 };
