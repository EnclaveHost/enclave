#!/usr/bin/env python3
# TEST-ONLY ssh: answers like the Windows host's PowerShell parse block would, per $MOCK_SSH_MODE (ok | error | silent | short)
import hashlib, os, re, sys
src = sys.stdin.read(); names = re.findall(r"\$files\['([^']+)'\]=", src); mode = os.environ.get("MOCK_SSH_MODE", "ok")
lst = hashlib.sha256(("\n".join(names) + "\n").encode()).hexdigest()
if mode == "silent": print("ssh: connect to host minipc port 22: Connection timed out", file=sys.stderr); sys.exit(255)
bad = 0
for i, n in enumerate(names):
    if mode == "error" and i == 1: bad += 1; print(f"PARSE-ERROR {n}:22:41: Variable reference is not valid.")
    else: print(f"parse ok {n}")
count = len(names) - (1 if mode == "short" else 0)
print(f"PARSE-RESULT files={count} errors={bad} list={lst}")
print("relay data dir: absent")
