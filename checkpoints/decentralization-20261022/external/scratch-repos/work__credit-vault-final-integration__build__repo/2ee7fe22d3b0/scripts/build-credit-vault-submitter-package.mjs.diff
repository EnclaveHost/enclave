--- a/scripts/build-credit-vault-submitter-package.mjs
+++ b/scripts/build-credit-vault-submitter-package.mjs
@@ -0,0 +1,48 @@
+// Build the credit-vault submitter HOST-SERVICE package (network/host-services/credit-vault-submitter.mjs): one
+// dependency-free bundle of network/credit-vault-submitter.mjs and a manifest in the host-service package format of
+// work/hosted-service-placement (enclave-host-service-package/v1: bundle sha256, every input's sha256, runtime, state,
+// secrets, cold-start dependencies, service-index kind), with the esbuild options those packages use. An operator pins the
+// MANIFEST digest; a runner refuses any other bytes. --check: refuse stale outputs. Nothing is published.
+//   node scripts/build-credit-vault-submitter-package.mjs [--check]
+import { build } from 'esbuild';
+import fs from 'node:fs/promises';
+import path from 'node:path';
+import { createHash } from 'node:crypto';
+import { fileURLToPath } from 'node:url';
+import { CREDIT_VAULT_SUBMITTER_ROLE as R, SUBMITTER_KIND } from '../network/host-services/credit-vault-submitter.mjs';
+
+export const PACKAGE_FORMAT = 'enclave-host-service-package/v1';
+const root = path.resolve(path.dirname(fileURLToPath(import.meta.url)), '..');
+const out = path.join(root, 'network/host-services/packages');
+const role = 'credit-vault-submitter';
+const args = process.argv.slice(2);
+if (args.length && !(args.length === 1 && args[0] === '--check')) throw new Error('usage: build-credit-vault-submitter-package.mjs [--check]');
+const check = args.includes('--check');
+const sha = (b) => createHash('sha256').update(b).digest('hex');
+
+const result = await build({ absWorkingDir: root, entryPoints: [R.entry], outfile: path.join(out, `${role}.mjs`), write: false, metafile: true,
+  bundle: true, platform: 'node', format: 'esm', target: 'node22', legalComments: 'none',
+  banner: { js: `// Generated by scripts/build-credit-vault-submitter-package.mjs from ${R.entry} (role ${role}); do not edit.\nimport {createRequire as bundleRequire} from "node:module"; const require=bundleRequire(import.meta.url);` } });
+const bytes = Buffer.from(result.outputFiles[0].contents);
+const inputs = {};
+for (const rel of Object.keys(result.metafile.inputs).sort()) {
+  const normalized = rel.includes('node_modules/') ? 'node_modules/' + rel.split('node_modules/').pop() : rel;
+  const digest = sha(await fs.readFile(path.resolve(root, rel)));
+  if (inputs[normalized] && inputs[normalized] !== digest) throw new Error(`ambiguous bundle input ${normalized}`);
+  inputs[normalized] = digest;
+}
+// a role that holds no secret and starts cold must never reach custody, secrets, storage or lease-relay modules
+const forbidden = Object.keys(inputs).filter((f) => /(^|\/)(custody|lease-relay-service|lease-gas-runtime|storage\/|sdk\/storage|secrets?-release|shield-secrets|relay\/billing|vaultsvc)/.test(f));
+if (forbidden.length) throw new Error(`the bundle reaches modules this role must not depend on: ${forbidden.join(', ')}`);
+const manifest = JSON.stringify({ format: PACKAGE_FORMAT, role, entry: R.entry, bundle: `${role}.mjs`, bundleSha256: sha(bytes), bytes: bytes.length,
+  runtime: R.runtime, kind: R.kind, serviceIndexKind: SUBMITTER_KIND, serves: R.serves, state: R.state, secrets: R.secrets, cold: R.cold, notCold: R.notCold,
+  placement: 'never a DigitalOcean machine (the process refuses one): an Enclave host operator\'s machine', builder: 'scripts/build-credit-vault-submitter-package.mjs', inputs }, null, 2) + '\n';
+await fs.mkdir(out, { recursive: true });
+for (const [name, content] of [[`${role}.mjs`, bytes], [`${role}.package.json`, Buffer.from(manifest)]]) {
+  const file = path.join(out, name);
+  if (check) {
+    const have = await fs.readFile(file).catch(() => null);
+    if (!have || !have.equals(content)) throw new Error(`${name} is stale; run node scripts/build-credit-vault-submitter-package.mjs`);
+  } else await fs.writeFile(file, content);
+}
+console.log(`${role}: bundle ${bytes.length} bytes sha256:${sha(bytes).slice(0, 16)}…, manifest sha256:${sha(Buffer.from(manifest))}, ${Object.keys(inputs).length} inputs${check ? ' (verified current)' : ''}`);
