--- a/scripts/build-metal-lease-gas.mjs
+++ b/scripts/build-metal-lease-gas.mjs
@@ -0,0 +1,36 @@
+// The metal node's lease-gas conduit (network/lease-gas-conduit.mjs) as ONE dependency-free file, for the host launcher
+// (metal/enclave-metal.mjs, run from a release checkout without node_modules) and the measured guest (gsup.mjs and
+// measured-control.mjs under /opt/metal, beside host-policy.bundle.mjs). The same pattern as the Windows node's shared
+// lease runtime (scripts/build-windows-lease-runtime.mjs): exact inputs recorded in a manifest; --check refuses a stale one.
+import { build } from "esbuild";
+import fs from "node:fs/promises";
+import path from "node:path";
+import { fileURLToPath } from "node:url";
+import { createHash } from "node:crypto";
+const root = path.resolve(path.dirname(fileURLToPath(import.meta.url)), "..");
+const entry = "network/lease-gas-conduit.mjs", output = path.join(root, "metal/guest/lease-gas-conduit.bundle.mjs");
+const args = process.argv.slice(2);
+if (args.length && !(args.length === 1 && args[0] === "--check")) throw new Error("usage: build-metal-lease-gas.mjs [--check]");
+const result = await build({
+  absWorkingDir: root, entryPoints: [entry], outfile: output,
+  platform: "node", format: "esm", target: "node20", bundle: true, minify: true, write: false, metafile: true,
+  banner: { js: "// Generated by scripts/build-metal-lease-gas.mjs from network/lease-gas-conduit.mjs; do not edit." },
+});
+const bytes = Buffer.from(result.outputFiles[0].contents);
+const sha = (b) => createHash("sha256").update(b).digest("hex");
+const inputs = {};
+for (const rel of Object.keys(result.metafile.inputs).sort()) {
+  const normalized = rel.includes("node_modules/") ? "node_modules/" + rel.split("node_modules/").pop() : rel;
+  const digest = sha(await fs.readFile(path.resolve(root, rel)));
+  if (inputs[normalized] && inputs[normalized] !== digest) throw new Error(`ambiguous bundle input ${normalized}`);
+  inputs[normalized] = digest;
+}
+const manifest = JSON.stringify({ bundle: "metal/guest/lease-gas-conduit.bundle.mjs", entry, sha256: sha(bytes), bytes: bytes.length, inputs }, null, 2) + "\n";
+if (args.includes("--check")) {
+  if (!bytes.equals(await fs.readFile(output))) throw new Error("metal lease-gas conduit bundle is stale; run node scripts/build-metal-lease-gas.mjs");
+  if (manifest !== await fs.readFile(output + ".manifest.json", "utf8")) throw new Error("metal lease-gas conduit bundle manifest is stale");
+} else {
+  await fs.writeFile(output, bytes);
+  await fs.writeFile(output + ".manifest.json", manifest);
+}
+console.log(`metal lease-gas conduit bundle: ${bytes.length} bytes, sha256:${sha(bytes)}${args.includes("--check") ? " (verified)" : ""}`);
