+    const status = async (kind, enclaveId, op) => {
+      const [st, avail, left, perOp] = await R("statusOf", [id, KIND[kind], enclaveId, op]);
+      return { status: STATUS[Number(st)] || `status ${st}`, availableWei: avail, epochLeftWei: left, maxPerOpWei: perOp };
+    };
