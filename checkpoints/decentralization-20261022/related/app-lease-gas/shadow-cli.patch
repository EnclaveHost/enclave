+    const r = (fn, args = []) => c.readContract({ address: dep.reserve, abi: OWNER_ABI, functionName: fn, args, blockNumber });
+    const [rc, ec, ledger, registry, executor, dch, back, limits, l1Oracle, paused, admin] = await Promise.all([
