+                            Mode::Answer(ip, ttl) if q.questions[0].qtype == ty::A => r.answers.push(Record::new(me.name.clone(), ty::A, ttl, ip.to_vec())),
+                            Mode::Answer(..) => {}
+                            Mode::NxDomain => r.rcode = rcode::NXDOMAIN,
+                            Mode::ServFail => r.rcode = rcode::SERVFAIL,
+                            Mode::Silent => return,
+                        }
+                    } else if matches!(me.mode.get(), Mode::Silent) {
+                        return;
+                    }
+                    // anything else: an empty NOERROR (no DNSKEY for the root, so validation fails)
+                    let _ = sock.send_to(&r.to_bytes(1232), from).await;
+                })
+                .detach();
+            }
+        })
+        .detach();
+        (f, addr)
+    }
+
+    fn resolver(up: SocketAddr, validate: bool) -> Rc<Resolver> {
+        let cfg = Config { forward: vec![Upstream::Udp(up)], validate, transport: Transport::Udp, ..Config::default() };
+        Resolver::new(cfg, Rc::new(tls::Pool::default()))
+    }
+
+    const OLD: [u8; 4] = [192, 0, 2, 1];
+    const NEW: [u8; 4] = [198, 51, 100, 7];
+
+    /// Cache `ip` for `name` as an earlier resolution would have, then age it.
+    fn seed(r: &Resolver, name: &Name, ip: [u8; 4], sec: Sec, ttl: u32, age_ms: u64) {
+        let mut a = Answer::negative(rcode::NOERROR, ttl, "network");
+        a.answer.push(Record::new(name.clone(), ty::A, ttl, ip.to_vec()));
+        a.sec = sec;
+        r.cache_put(name, ty::A, &a);
+        advance(age_ms);
+    }
+
+    /// Let `ms` of bookkeeping time pass at once (the monotonic clock of a
+    /// fresh component starts near 0, so entries cannot be back-dated).
+    fn advance(ms: u64) {
+        net::SKEW_MS.with(|s| s.set(s.get() + ms));
+    }
+
+    fn ips(a: &Answer) -> Vec<IpAddr> {
+        a.answer.iter().filter_map(rr_ip).collect()
+    }
+
+    async fn ask(r: &Rc<Resolver>, name: &Name) -> (Answer, u64) {
+        let t0 = net::now_ms();
+        let a = r.lookup(name, ty::A, &Ctx::new(Duration::from_secs(9)), 0).await;
+        (a, net::now_ms() - t0)
+    }
+
+    async fn settle(r: &Rc<Resolver>) {
+        for _ in 0..200 {
+            if r.refreshing.borrow().is_empty() {
+                return;
+            }
+            net::sleep(Duration::from_millis(50)).await;
+        }
+        panic!("a refresh never finished");
+    }
+
+    /// Run a test body on the reactor; a hang is a failure, not a stuck run.
+    fn run<F: Future<Output = ()>>(body: impl FnOnce() -> F) {
+        wstd::runtime::block_on(async {
+            net::timeout(Duration::from_secs(45), async {
+                body().await;
+                Ok(())
+            })
+            .await
+            .expect("test did not finish in 45 s");
+        })
+    }
+
+    #[test]
+    fn expired_entry_and_healthy_upstream_give_the_new_address_first() {
+        run(|| async {
+            let name = Name::parse("38f368d6.app.enclave.test").unwrap();
+            let (up, addr) = fake("38f368d6.app.enclave.test", Mode::Answer(NEW, 60)).await;
+            let r = resolver(addr, false);
+            seed(&r, &name, OLD, Sec::Insecure, 30, 31_000);
+            let server = Server::new(r.clone(), Vec::new(), None, false, None, true, 1000.0, 1000.0);
+            // the client's very first question after expiry, end to end on the wire
+            let q = Message::query(4242, &name, ty::A, true, false, false).to_bytes(512);
+            let m = Message::parse(&server.handle(&q, Via::Udp).await.unwrap()).unwrap();
+            assert_eq!(m.rcode, rcode::NOERROR);
+            assert_eq!(m.answers.iter().filter_map(rr_ip).collect::<Vec<_>>(), vec![IpAddr::from(NEW)]);
+            assert_eq!(m.answers[0].ttl, 60, "a fresh answer carries its own TTL, not the stale 30");
+            assert_eq!(up.asked.get(), 1);
+            // the DoH JSON's Sources: fresh from the network, never "stale cache"
+            let res = server.resolve(&name, ty::A, false, false).await;
+            assert_eq!(res.sources, vec!["cache"]);
+            assert_eq!(res.answer.iter().filter_map(rr_ip).collect::<Vec<_>>(), vec![IpAddr::from(NEW)]);
+            assert_eq!(r.stats.borrow().stale_served, 0);
+            up.stop.set(true);
+        });
+    }
+
+    #[test]
+    fn unavailable_upstream_falls_back_to_bounded_stale() {
+        run(|| async {
+            let name = Name::parse("www.down.test").unwrap();
+            let (up, addr) = fake("www.down.test", Mode::Silent).await;
+            let r = resolver(addr, false);
+            seed(&r, &name, OLD, Sec::Insecure, 300, 301_000);
+            // no answer: the old address after the bounded wait, with the stale TTL
+            let (a, ms) = ask(&r, &name).await;
+            assert_eq!(a.source, "stale cache");
+            assert_eq!(ips(&a), vec![IpAddr::from(OLD)]);
+            assert!(a.ttl == STALE_TTL && a.answer.iter().all(|x| x.ttl == STALE_TTL));
+            assert!((STALE_WAIT_MS - 50..STALE_WAIT_MS + 700).contains(&ms), "waited {ms} ms");
+            // that refresh failed: stale at once until the recheck timer runs out
+            settle(&r).await;
+            let (a, ms) = ask(&r, &name).await;
+            assert_eq!(a.source, "stale cache");
+            assert!(ms < 300, "waited {ms} ms after a failed refresh");
+            // the upstream refusing (SERVFAIL) is unavailability too: stale, at once
+            up.mode.set(Mode::ServFail);
+            settle(&r).await;
+            r.refresh_failed.borrow_mut().clear();
+            let (a, ms) = ask(&r, &name).await;
+            assert_eq!((a.source, ips(&a)), ("stale cache", vec![IpAddr::from(OLD)]));
+            assert!(ms < 1000, "waited {ms} ms for a SERVFAIL");
+            // it recovers: the refresh kicked by a stale answer refills the cache
+            up.mode.set(Mode::Answer(NEW, 60));
+            settle(&r).await;
+            let (a, _) = ask(&r, &name).await;
+            assert_eq!(a.source, "stale cache");
+            settle(&r).await;
+            let (a, _) = ask(&r, &name).await;
+            assert_eq!((a.source, ips(&a)), ("cache", vec![IpAddr::from(NEW)]));
+            // past STALE_MS nothing old is served, however dead the upstream
+            up.mode.set(Mode::Silent);
+            seed(&r, &name, OLD, Sec::Insecure, 300, 300_000 + STALE_MS + 1_000);
+            let (a, _) = ask(&r, &name).await;
+            assert_eq!(a.rcode, rcode::SERVFAIL);
+            assert!(a.answer.is_empty());
+            up.stop.set(true);
+        });
+    }
+
+    #[test]
+    fn slow_upstream_serves_stale_then_the_refresh_lands() {
+        run(|| async {
+            let name = Name::parse("slow.test").unwrap();
+            let (up, addr) = fake("slow.test", Mode::Answer(NEW, 60)).await;
+            up.delay_ms.set(2_500);
+            let r = resolver(addr, false);
+            seed(&r, &name, OLD, Sec::Insecure, 30, 31_000);
+            let (a, ms) = ask(&r, &name).await;
+            assert_eq!((a.source, ips(&a)), ("stale cache", vec![IpAddr::from(OLD)]));
+            assert!(ms < STALE_WAIT_MS + 700, "waited {ms} ms");
+            // the attempt was not abandoned with the client
+            settle(&r).await;
+            let (a, _) = ask(&r, &name).await;
+            assert_eq!((a.source, ips(&a)), ("cache", vec![IpAddr::from(NEW)]));
+            assert_eq!(up.asked.get(), 1);
+            up.stop.set(true);
+        });
+    }
+
+    #[test]
+    fn fresh_nxdomain_wins_over_stale() {
+        run(|| async {
+            let name = Name::parse("gone.test").unwrap();
+            let (up, addr) = fake("gone.test", Mode::NxDomain).await;
+            let r = resolver(addr, false);
+            seed(&r, &name, OLD, Sec::Insecure, 30, 31_000);
+            let (a, _) = ask(&r, &name).await;
+            assert_eq!((a.rcode, a.source), (rcode::NXDOMAIN, "network"));
+            assert!(a.answer.is_empty());
+            // the denial replaced the old entry: nothing old to fall back on
+            up.mode.set(Mode::Silent);
+            let (a, _) = ask(&r, &name).await;
+            assert_eq!((a.rcode, a.source), (rcode::NXDOMAIN, "cache"));
+            up.stop.set(true);
+        });
+    }
+
+    #[test]
+    fn fresh_bogus_wins_over_stale_and_bogus_is_never_stale() {
+        run(|| async {
+            let name = Name::parse("signed.test").unwrap();
+            // validating: an unsigned answer with no root DNSKEY behind it is bogus
+            let (up, addr) = fake("signed.test", Mode::Answer(NEW, 60)).await;
+            let r = resolver(addr, true);
+            seed(&r, &name, OLD, Sec::Insecure, 30, 31_000);
+            let server = Server::new(r.clone(), Vec::new(), None, false, None, true, 1000.0, 1000.0);
+            let q = Message::query(7, &name, ty::A, true, false, false).to_bytes(512);
+            let m = Message::parse(&server.handle(&q, Via::Udp).await.unwrap()).unwrap();
+            assert_eq!(m.rcode, rcode::SERVFAIL, "bogus is refused, not papered over with stale data");
+            assert!(m.answers.is_empty());
+            assert_eq!(r.stats.borrow().stale_served, 0);
+            // the bogus result replaced the old entry; once it expires it is not served stale either
+            up.mode.set(Mode::Silent);
+            let (a, _) = ask(&r, &name).await;
+            assert_eq!((a.sec, a.source), (Sec::Bogus, "cache"));
+            advance(61_000);
+            let (a, _) = ask(&r, &name).await;
+            assert_eq!(a.rcode, rcode::SERVFAIL);
+            assert_ne!(a.source, "stale cache");
+            up.stop.set(true);
+        });
+    }
+
+    #[test]
+    fn ttl_zero_is_not_cached_and_leaves_nothing_stale() {
+        run(|| async {
+            let name = Name::parse("zero.test").unwrap();
+            let (up, addr) = fake("zero.test", Mode::Answer(NEW, 0)).await;
+            let r = resolver(addr, false);
+            seed(&r, &name, OLD, Sec::Insecure, 30, 31_000);
+            let (a, _) = ask(&r, &name).await;
+            assert_eq!((a.source, ips(&a), a.ttl), ("network", vec![IpAddr::from(NEW)], 0));
+            settle(&r).await;
+            // FWD_MEMO_MS shares one upstream answer briefly: let it lapse
+            advance(FWD_MEMO_MS + 100);
+            let (a, _) = ask(&r, &name).await;
+            assert_eq!((a.source, ips(&a)), ("network", vec![IpAddr::from(NEW)]));
+            assert_eq!(up.asked.get(), 2, "TTL 0 is asked again, never cached");
+            advance(FWD_MEMO_MS + 100);
+            up.mode.set(Mode::Silent);
+            let (a, _) = ask(&r, &name).await;
+            assert_eq!(a.rcode, rcode::SERVFAIL, "the TTL 0 answer superseded the old entry");
+            assert!(a.answer.is_empty());
+            up.stop.set(true);
+        });
+    }
+
+    #[test]
+    fn concurrent_queries_share_one_refresh() {
+        run(|| async {
+            let name = Name::parse("busy.test").unwrap();
+            let (up, addr) = fake("busy.test", Mode::Answer(NEW, 60)).await;
+            up.delay_ms.set(300);
+            let r = resolver(addr, false);
+            seed(&r, &name, OLD, Sec::Insecure, 30, 31_000);
+            let asks: Vec<_> = (0..25).map(|_| ask(&r, &name)).collect();
+            for (a, ms) in net::join_all(asks).await {
+                assert_eq!((a.source, ips(&a)), ("network", vec![IpAddr::from(NEW)]));
+                assert!(ms < STALE_WAIT_MS, "waited {ms} ms");
+            }
+            assert_eq!(up.asked.get(), 1, "one upstream question for 25 clients");
+            assert_eq!(r.stats.borrow().refreshes, 1);
+            assert_eq!(r.stats.borrow().stale_served, 0);
+            up.stop.set(true);
+        });
+    }
+
+    #[test]
+    fn cancelled_waiter_neither_hangs_nor_stops_the_refresh() {
+        run(|| async {
+            let name = Name::parse("gone-client.test").unwrap();
+            let (up, addr) = fake("gone-client.test", Mode::Answer(NEW, 60)).await;
+            up.delay_ms.set(800);
+            let r = resolver(addr, false);
+            seed(&r, &name, OLD, Sec::Insecure, 30, 31_000);
+            // the client goes away while waiting on the fresh answer
+            match net::select2(ask(&r, &name), net::sleep(Duration::from_millis(100))).await {
+                net::Either::Left(_) => panic!("answered before the upstream could"),
+                net::Either::Right(()) => {}
+            }
+            assert_eq!(r.refreshing.borrow().len(), 1, "the refresh outlives its first waiter");
+            // a second client joins the same attempt and gets the new address
+            let (a, ms) = ask(&r, &name).await;
+            assert_eq!((a.source, ips(&a)), ("network", vec![IpAddr::from(NEW)]));
+            assert!(ms < 1_500, "waited {ms} ms");
+            assert_eq!(up.asked.get(), 1);
+            assert!(r.refreshing.borrow().is_empty());
+            // and with every waiter gone, the refresh still fills the cache
+            seed(&r, &name, OLD, Sec::Insecure, 30, 31_000);
+            advance(FWD_MEMO_MS + 100);
+            let _ = net::select2(ask(&r, &name), net::sleep(Duration::from_millis(100))).await;
+            settle(&r).await;
+            let (a, _) = ask(&r, &name).await;
+            assert_eq!((a.source, ips(&a)), ("cache", vec![IpAddr::from(NEW)]));
+            assert_eq!(up.asked.get(), 2);
+            up.stop.set(true);
+        });
+    }
+
+    // Independent review counterexamples (work/enclavedns-stale-review-20261021/review_counterexamples.rs 96eb6022), verbatim.
+
+    /// R1: a validating refresh slower than STALE_WAIT_MS that comes back BOGUS is not cached by the refresh job
+    /// (`answered && a.sec != Sec::Bogus`), so the old NOERROR entry keeps being served stale, for up to STALE_MS,
+    /// although every fresh answer is bogus. Expected: once the refresh has a bogus answer, no stale NOERROR data.
+    #[test]
+    fn slow_bogus_refresh_does_not_keep_old_data_alive() {
+        run(|| async {
+            let name = Name::parse("slow-signed.test").unwrap();
+            let (up, addr) = fake("slow-signed.test", Mode::Answer(NEW, 60)).await;
+            up.delay_ms.set(2_500);
+            let r = resolver(addr, true);   // validating: the fake's unsigned answer is bogus
+            seed(&r, &name, OLD, Sec::Insecure, 30, 31_000);
+            let (a, _) = ask(&r, &name).await;            // times out: stale (allowed: no answer yet)
+            assert_eq!(a.source, "stale cache");
+            settle(&r).await;                              // the refresh got its (bogus) answer
+            up.mode.set(Mode::Silent);
+            advance(FWD_MEMO_MS + 100);
+            let (a, _) = ask(&r, &name).await;
+            assert!(!(a.source == "stale cache" && a.rcode == rcode::NOERROR && !a.answer.is_empty()),
+                "old data served stale after the refresh returned bogus");
+            up.stop.set(true);
+        });
+    }
+
+    /// R2: the client response timer is per lookup, not per client request. A CNAME chain of 3 expired names with a
+    /// silent upstream makes the FIRST client request wait ~3 x 1.8 s (one 9 s Ctx for the whole chain), past common stub
+    /// timeouts; the published behaviour answered at once. Expected (RFC 8767 sec. 5): one bounded wait per request.
+    #[test]
+    fn expired_cname_chain_waits_once_per_request() {
+        run(|| async {
+            let (a_, b_, c_) = (Name::parse("a.chain.test").unwrap(), Name::parse("b.chain.test").unwrap(), Name::parse("c.chain.test").unwrap());
+            let (up, addr) = fake("a.chain.test", Mode::Silent).await;
+            let r = resolver(addr, false);
+            for (n, t) in [(&a_, &b_), (&b_, &c_)] {
+                let mut x = Answer::negative(rcode::NOERROR, 300, "network");
+                x.answer.push(Record::new(n.clone(), ty::CNAME, 300, t.wire().to_vec()));
+                r.cache_put(n, ty::A, &x);
+            }
+            seed(&r, &c_, OLD, Sec::Insecure, 300, 301_000);   // ages all three past their TTL
+            let server = Server::new(r.clone(), Vec::new(), None, false, None, true, 1000.0, 1000.0);
+            let t0 = net::now_ms();
+            let res = server.resolve(&a_, ty::A, false, false).await;
+            let ms = net::now_ms() - t0;
+            assert!(res.answer.iter().filter_map(rr_ip).any(|ip| ip == IpAddr::from(OLD)));
+            assert!(ms < STALE_WAIT_MS + 700, "the first request waited {ms} ms for a 3-name chain");
+            up.stop.set(true);
+        });
+    }
