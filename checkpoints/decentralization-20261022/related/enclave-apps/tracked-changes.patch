+/// How recent the Enclave sign-in proving an ACCOUNT for a link must be.
+const LINK_FRESH_SECS: u64 = 600;
+
+/// The ACCOUNT side of a link: a Sign in with Enclave token minted for THIS
+/// notebook's own deployment (not one it merely accepts) in the last ten
+/// minutes, naming an account. Returns (account, the token as presented).
+fn account_proof(cfg: &Config, req: &IncomingRequest, now: u64) -> Result<(String, String), (u16, String)> {
+    account_proof_of(cfg, header(req, "x-sso-token").map(|t| t.trim().to_string()), now)
+}
+
+fn account_proof_of(cfg: &Config, tok: Option<String>, now: u64) -> Result<(String, String), (u16, String)> {
+    let (Some(s), Some(w)) = (&cfg.sso, &cfg.wallet) else {
+        return Err((404, "this notebook does not offer account links: it needs both an sso and a wallet block".into()));
+    };
+    let tok = tok.filter(|t| t.starts_with("EST1."))
+        .ok_or((401, "[sso_required] sign in with Enclave (X-Sso-Token) to prove the account you are linking".to_string()))?;
+    let c = sso::verify(s, &tok, now).map_err(|e| (401, format!("[sso_required] {e}")))?;
+    if !c.aud.eq_ignore_ascii_case(&s.audience) || !c.aud.eq_ignore_ascii_case(&w.audience) {
+        return Err((401, "that Enclave sign-in was made for another deployment; sign in to this notebook itself".into()));
+    }
+    if c.iat.saturating_add(LINK_FRESH_SECS) < now {
+        return Err((401, "linking needs a fresh Enclave sign-in (the last 10 minutes): sign in again, then link".into()));
+    }
+    if !wallet::is_account_sub(&c.sub) {
+        return Err((401, "that sign-in names no Enclave account".into()));
+    }
+    Ok((c.sub, tok))
+}
