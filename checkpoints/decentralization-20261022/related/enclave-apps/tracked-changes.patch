+    // ---- ?format=car of a CID outside the index (EnclaveDNS upload 502, 2026-10-21) ----------------------------
+
+    /// One request through the real engine and router, as main() serves it (poll -> route -> pump/flush), on a
+    /// loopback port of its own; `connection: close`, so the answer ends at EOF. -> (status, lowercased headers, body)
+    fn http_once(app: &mut App, method: &str, target: &str, accept: Option<&str>) -> (u16, Vec<(String, String)>, Vec<u8>) {
+        use std::io::{ErrorKind, Read, Write};
+        let port = std::net::TcpListener::bind("127.0.0.1:0").unwrap().local_addr().unwrap().port();
+        let mut srv = Server::bind("car404-test", port);
+        let mut c = std::net::TcpStream::connect(("127.0.0.1", port)).unwrap();
+        let accept = accept.map(|a| format!("accept: {a}\r\n")).unwrap_or_default();
+        c.write_all(format!("{method} {target} HTTP/1.1\r\nhost: t\r\n{accept}connection: close\r\n\r\n").as_bytes()).unwrap();
+        c.set_nonblocking(true).unwrap();
+        let (mut got, mut buf, deadline) = (Vec::new(), [0u8; 65536], Instant::now() + Duration::from_secs(30));
+        // the client drains everything the socket holds on each pass
+        'serve: loop {
+            for (key, req) in srv.poll(MAX_BODY, &[], &[]) {
+                route(app, &mut srv, key, &req);
+            }
+            srv.pump();
+            srv.flush();
+            loop {
+                match c.read(&mut buf) {
+                    Ok(0) => break 'serve,
+                    Ok(n) => got.extend_from_slice(&buf[..n]),
+                    Err(e) if e.kind() == ErrorKind::WouldBlock => break,
+                    Err(e) => panic!("{method} {target}: {e}"),
+                }
+            }
+            assert!(Instant::now() < deadline, "{method} {target}: no complete answer ({} bytes)", got.len());
+            std::thread::sleep(Duration::from_millis(1));
+        }
+        let end = got.windows(4).position(|w| w == b"\r\n\r\n").unwrap_or_else(|| panic!("{method} {target}: no header block in {} bytes", got.len()));
+        let head = String::from_utf8_lossy(&got[..end]).to_string();
+        let mut lines = head.split("\r\n");
+        let status: u16 = lines.next().unwrap().split(' ').nth(1).unwrap().parse().unwrap();
+        let headers: Vec<(String, String)> = lines
+            .filter_map(|l| l.split_once(':').map(|(k, v)| (k.trim().to_ascii_lowercase(), v.trim().to_string())))
+            .collect();
+        let mut body = got[end + 4..].to_vec();
+        // a HEAD answer has no body, whatever its transfer-encoding says
+        if method != "HEAD" && headers.iter().any(|(k, v)| k == "transfer-encoding" && v == "chunked") {
+            let (mut out, mut i) = (Vec::new(), 0);
+            loop {
+                let nl = i + body[i..].windows(2).position(|w| w == b"\r\n")
+                    .unwrap_or_else(|| panic!("{method} {target}: chunked body cut at byte {i} of {}", body.len()));
+                let n = usize::from_str_radix(std::str::from_utf8(&body[i..nl]).unwrap().trim(), 16).unwrap();
+                if n == 0 {
+                    break;
+                }
+                out.extend_from_slice(&body[nl + 2..nl + 2 + n]);
+                i = nl + 2 + n + 2;
+            }
+            body = out;
+        }
+        (status, headers, body)
+    }
+
