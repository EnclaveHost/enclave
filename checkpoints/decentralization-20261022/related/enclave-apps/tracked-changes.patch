+/// One JSON-RPC POST to a chain reader the owner pinned in
+/// `wallet.contract_wallets` (EIP-1271 contract wallets, wallet.rs): bounded,
+/// no redirect followed, only the public signature data in the body.
+fn rpc_post(url: &str, body: &[u8], timeout_s: u64, max_bytes: usize) -> Result<Vec<u8>, String> {
+    let (https, rest) = match (url.strip_prefix("https://"), url.strip_prefix("http://")) {
+        (Some(r), _) => (true, r),
+        (None, Some(r)) => (false, r),
+        _ => return Err("reader URL is not http(s)".into()),
+    };
+    let (authority, path) = match rest.find('/') {
+        Some(i) => (&rest[..i], &rest[i..]),
+        None => (rest, "/"),
+    };
+    let headers = vec![("content-type".to_string(), "application/json".to_string())];
+    let r = http::request(&http::HttpReq {
+        method: bindings::wasi::http::types::Method::Post,
+        https,
+        authority,
+        path_with_query: path,
+        headers: &headers,
+        body,
+        timeout_s,
+        max_bytes,
+    })?;
+    if r.status != 200 {
+        return Err(format!("reader answered HTTP {}", r.status));
+    }
+    Ok(r.body)
+}
