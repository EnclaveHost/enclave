+/// The KDS path for one chip at one TCB, from fields the page read out of the
+/// report. Every field is validated; the result is one of AMD's own URL shapes
+/// under the configured origin, never anything the caller spelled.
+pub fn vcek_url(cfg: &AttestCfg, query: &str) -> Result<String, String> {
+    let arg = |k: &str| {
+        query
+            .split('&')
+            .find_map(|kv| kv.strip_prefix(k).and_then(|v| v.strip_prefix('=')))
+            .unwrap_or("")
+    };
+    let spl = |k: &str| -> Result<u8, String> {
+        arg(k).parse::<u8>().map_err(|_| format!("{k} must be 0..255"))
+    };
+    let product = arg("product");
+    let hwid = arg("hwid").to_ascii_lowercase();
+    let hw_len = match product {
+        "Milan" | "Genoa" => 128,
+        "Turin" => 16,
+        _ => return Err("product must be Milan, Genoa or Turin".into()),
+    };
+    if hwid.len() != hw_len || !hwid.bytes().all(|b| b.is_ascii_hexdigit()) {
+        return Err(format!("hwid must be {hw_len} hex digits for {product}"));
+    }
+    let (bl, tee, snp, ucode) = (spl("bl")?, spl("tee")?, spl("snp")?, spl("ucode")?);
+    Ok(if product == "Turin" {
+        let fmc = spl("fmc")?;
+        format!("{}/vcek/v1/Turin/{hwid}?fmcSPL={fmc:02}&blSPL={bl:02}&teeSPL={tee:02}&snpSPL={snp:02}&ucodeSPL={ucode:02}", cfg.kds)
+    } else {
+        format!("{}/vcek/v1/{product}/{hwid}?blSPL={bl}&teeSPL={tee}&snpSPL={snp}&ucodeSPL={ucode}", cfg.kds)
+    })
+}
+
+/// Fetch the VCEK (DER) for the page.
+pub fn vcek(cfg: &AttestCfg, query: &str) -> Result<Vec<u8>, String> {
+    let url = vcek_url(cfg, query)?;
+    let r = http::request(HttpReq::get(&url).timeout(20).max_bytes(8 * 1024))?;
+    if r.status != 200 {
+        return Err(format!("{url} answered HTTP {}", r.status));
+    }
+    if r.truncated || r.body.len() < 64 || r.body[0] != 0x30 {
+        return Err(format!("{url} did not answer a DER certificate"));
+    }
+    Ok(r.body)
 }
 
