+        let big = file("pins/bafkbig");        // a multi-chunk file: a dag-pb root
+        let small = file("pins/bafksmall");    // one chunk: a raw root
+        let leaf = Cid::raw(*app.snap.leaf_of.keys().next().unwrap());
+        let dir = app.snap.root.expect("the bucket's root directory");
+        assert_eq!((big.codec, small.codec, dir.codec), (CODEC_DAG_PB, CODEC_RAW, CODEC_DAG_PB));
