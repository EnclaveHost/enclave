+fn linked_account(cfg: &Config, wallet_sub: &str) -> Result<Option<String>, (u16, String)> {
+    // no link key: no record is believed, so none is even read
+    let Some(ctx) = link_ctx(cfg) else { return Ok(None) };
+    let store = BucketLinks::open(cfg)?;
+    link::resolve(&store, Some(&ctx), wallet_sub).map_err(|e| (502, format!("account link lookup failed: {e}")))
