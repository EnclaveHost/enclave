+// ---- account links (ELK1) -----------------------------------------------------
+//
+// A LINK is the person's own statement, proven with both credentials at once,
+// that a wallet may act as an Enclave account on this deployment: the account
+// side by a FRESH platform sign-in or by this deployment's own derived key
+// for it, the wallet side by an EIP-4361 message naming exactly that account,
+// that credential, this deployment and minutes of validity (wallet.rs,
+// Act::Link). Nothing is stored, so the outcome is a credential, derived
+// exactly like EAK1 under the same seed with its own prefix:
+//
+//   ELK1.<base64url({"acct":…,"aud":…,"v":1,"wallet":"wallet_0x…"})>.<base64url(MAC)>
+//
+// It is a NAME TAG, not a session: it is honoured only beside a live wallet
+// sign-in by that same wallet, for this deployment. Without the wallet it
+// opens nothing; without it the wallet stays its own identity. Limits, stated
+// as the contract: no expiry and no per-link revocation (rotating the seed
+// revokes every link with every derived key); an account may be linked to
+// more than one wallet and a wallet may hold links to more than one account,
+// each needing that account's own proof - nothing records or prevents it,
+// because nothing here can record anything.
+
+/// Derive the link credential for (account, wallet) on deployment `aud`.
+/// The caller has verified both proofs; this function trusts it on that.
+pub fn derive_link(seed: &str, account: &str, wallet_sub: &str, aud: &str) -> Option<String> {
+    let account = canonical_sub(account)?; // an ACCOUNT, never a wallet identity
+    let wallet_sub = canonical_wallet_sub(wallet_sub)?;
+    let aud = aud.to_ascii_lowercase();
+    if aud.len() != 66 || !aud.starts_with("0x") {
+        return None;
+    }
+    let payload = serde_json::json!({ "acct": account, "aud": aud, "v": 1, "wallet": wallet_sub }).to_string();
+    let payload_b64 = URL_SAFE_NO_PAD.encode(payload.as_bytes());
+    let tag = mac(seed, &format!("ELK1.{payload_b64}"));
+    Some(format!("ELK1.{payload_b64}.{}", URL_SAFE_NO_PAD.encode(tag)))
+}
+
+/// A verified link: (account, wallet identity, deployment).
+pub fn verify_link(seed: &str, key: &str) -> Result<(String, String, String), String> {
+    const BAD: &str = "invalid account link";
+    let rest = key.strip_prefix("ELK1.").ok_or(BAD)?;
+    let (payload_b64, tag_b64) = rest.split_once('.').ok_or(BAD)?;
+    let tag = URL_SAFE_NO_PAD.decode(tag_b64).map_err(|_| BAD)?;
+    if !ct_eq(&tag, &mac(seed, &format!("ELK1.{payload_b64}"))) {
+        return Err(BAD.into());
+    }
+    let payload = URL_SAFE_NO_PAD.decode(payload_b64).map_err(|_| BAD)?;
+    let c: serde_json::Value = serde_json::from_slice(&payload).map_err(|_| BAD)?;
+    if c.get("v").and_then(|v| v.as_u64()) != Some(1) {
+        return Err(BAD.into());
+    }
+    let s = |k: &str| c.get(k).and_then(|v| v.as_str()).map(str::to_string).ok_or(BAD);
+    let account = canonical_sub(&s("acct")?).ok_or(BAD)?;
+    let wallet = canonical_wallet_sub(&s("wallet")?).ok_or(BAD)?;
+    Ok((account, wallet, s("aud")?))
 }
 
