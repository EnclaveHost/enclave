+/// An origin the owner may name: https, a host, optionally a fixed path
+/// prefix; no query, fragment, credentials or trailing slash. Config is the
+/// only place these come from - nothing a request says becomes a URL here.
+fn origin_ok(u: &str) -> bool {
+    let Some(rest) = u.strip_prefix("https://") else { return false };
+    let host = rest.split('/').next().unwrap_or("");
+    !host.is_empty()
+        && host.chars().all(|c| c.is_ascii_alphanumeric() || matches!(c, '.' | '-' | ':' | '[' | ']'))
+        && !rest.ends_with('/')
+        && rest.chars().all(|c| c.is_ascii_alphanumeric() || matches!(c, '.' | '-' | ':' | '[' | ']' | '/' | '_'))
+}
+
+impl AttestCfg {
+    pub fn from_raw(raw: &serde_json::Value) -> Result<AttestCfg, String> {
+        let a = match raw.get("attestation") {
+            None | Some(serde_json::Value::Null) => serde_json::json!({}),
+            Some(v) if v.is_object() => v.clone(),
+            Some(_) => return Err("attestation must be an object".into()),
+        };
+        let sources = match a.get("sources") {
+            None | Some(serde_json::Value::Null) => vec![DEFAULT_SOURCE.to_string()],
+            Some(serde_json::Value::Array(xs)) => {
+                let mut out = Vec::new();
+                for x in xs {
+                    let u = x.as_str().map(str::trim).unwrap_or("");
+                    if !origin_ok(u) {
+                        return Err(format!("attestation.sources entry {x} is not an https origin"));
+                    }
+                    out.push(u.to_string());
+                }
+                out
+            }
+            Some(_) => return Err("attestation.sources must be an array of https origins".into()),
+        };
+        let kds = match a.get("kds").and_then(|v| v.as_str()) {
+            None => DEFAULT_KDS.to_string(),
+            Some(u) if origin_ok(u.trim()) => u.trim().to_string(),
+            Some(u) => return Err(format!("attestation.kds {u:?} is not an https origin")),
+        };
+        Ok(AttestCfg { sources, kds })
+    }
