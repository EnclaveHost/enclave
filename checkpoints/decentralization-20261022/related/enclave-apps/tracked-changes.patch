+/// The context link records are bound to, when links are on at all.
+fn link_ctx(cfg: &Config) -> Option<link::Ctx<'_>> {
+    let (Some(key), Some(w)) = (&cfg.link_key, &cfg.wallet) else { return None };
+    Some(link::Ctx { key, aud: &w.audience, bucket: &cfg.bucket, prefix: &cfg.prefix })
