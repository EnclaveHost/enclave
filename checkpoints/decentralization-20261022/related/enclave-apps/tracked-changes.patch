+/// The platform API: the record source when the config names none, so a
+/// deployment that predates the `attestation` block shows what it always did.
+pub const DEFAULT_SOURCE: &str = "https://api.enclave.host";
+/// AMD's Key Distribution Service.
+pub const DEFAULT_KDS: &str = "https://kdsintf.amd.com";
+/// Where the guest front serves the self-served document.
