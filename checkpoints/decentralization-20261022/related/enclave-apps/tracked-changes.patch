+/// wallet.rs's check for one act; the chain readers are attached only when
+/// the owner pinned them, so an EOA never touches the network.
+fn wallet_verify(w: &wallet::WalletConfig, tok: &str, now: u64, act: wallet::Act) -> Result<wallet::Claims, String> {
+    if w.contract.is_some() {
+        let mut readers = wallet::HttpReaders(rpc_post);
+        wallet::verify_act(w, tok, now, act, Some(&mut readers))
+    } else {
+        wallet::verify_act(w, tok, now, act, None)
+    }
+}
