+        match self.client().put(key, body, "application/json", Some(etag)) {
+            Ok(_) => Ok(true),
+            Err(s3::S3Error::Http(412, _)) => Ok(false),
+            Err(e) => Err(e.message()),
+        }
+    }
+    fn any_under(&self, prefix: &str) -> Result<bool, String> {
+        Ok(!self.client().list(prefix, 1).map_err(|e| e.message())?.0.is_empty())
+    }
+}
