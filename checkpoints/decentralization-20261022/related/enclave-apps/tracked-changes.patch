+    fn est1(sub: &str, aud: &str) -> String {
+        let claims = serde_json::json!({ "aud": aud, "exp": now() + 3600, "iat": now(), "sub": sub, "v": 1 });
+        let payload = URL_SAFE_NO_PAD.encode(claims.to_string());
+        let sig = personal_sign(&key(0x42), format!("EST1.{payload}").as_bytes());
+        format!("EST1.{payload}.{}", URL_SAFE_NO_PAD.encode(sig))
+    }
+    /// what the playground does: fetch the challenge, personal_sign it, wrap
+    fn ews1(cfg: &wallet::WalletConfig, host: &str, k: &SigningKey) -> String {
+        let addr = format!("0x{}", hex_of(&Keccak256::digest(&k.verifying_key().to_encoded_point(false).as_bytes()[1..])[12..]));
+        let msg = wallet::challenge(cfg, Some(host), &addr, "0123456789abcdefABCDEF", now()).unwrap();
+        let sig = personal_sign(k, msg.as_bytes());
+        wallet::token(&msg, &hex_of(&sig)).unwrap()
+    }
+    fn hex_of(b: &[u8]) -> String {
+        b.iter().map(|x| format!("{x:02x}")).collect()
+    }
+    fn cfg(v: serde_json::Value) -> AppConfig {
+        let mut raw = config::load_raw().unwrap_or_else(|_| serde_json::json!({}));
+        for (k, x) in v.as_object().unwrap() {
+            raw[k] = x.clone();
+        }
+        config::from_value(raw).unwrap()
+    }
+    fn sso_block() -> serde_json::Value {
+        serde_json::json!({ "signer": SIGNER, "audience": AUD })
+    }
+    fn wallet_block() -> serde_json::Value {
+        serde_json::json!({ "audience": AUD, "domains": ["chat.example.com"] })
+    }
+
+    #[test]
+    fn sign_in_with_enclave_is_unchanged() {
+        let c = cfg(serde_json::json!({ "sso": sso_block() }));
+        let sub = verify_sign_in(c.sso.as_ref(), c.wallet.as_ref(), &est1("acct_0e64d1897f10b32d3a1bc84e", AUD)).unwrap();
+        assert_eq!(sub, "acct_0e64d1897f10b32d3a1bc84e");
+        // an older address-sub token, too
+        let sub = verify_sign_in(c.sso.as_ref(), None, &est1("0x00A329c0648769A73afAc7F9381E08FB43dBEA72", AUD)).unwrap();
+        assert_eq!(sub, "0x00a329c0648769a73afac7f9381e08fb43dbea72");
+        // and adding a wallet block leaves EST1 exactly as it was
+        let both = cfg(serde_json::json!({ "sso": sso_block(), "wallet": wallet_block() }));
+        assert_eq!(verify_sign_in(both.sso.as_ref(), both.wallet.as_ref(), &est1("acct_x1", AUD)).unwrap(), "acct_x1");
+        assert!(verify_sign_in(both.sso.as_ref(), both.wallet.as_ref(), &est1("acct_x1", OTHER)).is_err());
+        // a wallet sign-in is refused where the owner admitted none
+        let w = ews1(&both.wallet.clone().unwrap(), "chat.example.com", &key(0x42));
+        assert!(verify_sign_in(c.sso.as_ref(), c.wallet.as_ref(), &w).unwrap_err().contains("does not accept wallet"));
+    }
+
+    #[test]
+    fn a_wallet_signs_in_with_no_issuer_at_all() {
+        let c = cfg(serde_json::json!({ "wallet": wallet_block() }));
+        assert!(c.sso.is_none());
+        let w = ews1(c.wallet.as_ref().unwrap(), "chat.example.com", &key(0x42));
+        assert_eq!(verify_sign_in(None, c.wallet.as_ref(), &w).unwrap(), format!("wallet_{SIGNER}"));
+        // an EST1 token is refused where no signer is pinned, however valid
+        assert!(verify_sign_in(None, c.wallet.as_ref(), &est1("acct_x1", AUD)).unwrap_err().contains("wallet"));
+        // the gate closes on the wallet block's own `required`
+        assert!(sign_in_required(None, c.wallet.as_ref()));
+        let open = cfg(serde_json::json!({ "wallet": { "audience": AUD, "domains": ["chat.example.com"], "required": false } }));
+        assert!(!sign_in_required(None, open.wallet.as_ref()));
+        // and an optional wallet block never opens a door sso closed
+        let mixed = cfg(serde_json::json!({ "sso": sso_block(), "wallet": { "audience": AUD, "required": false } }));
+        assert!(sign_in_required(mixed.sso.as_ref(), mixed.wallet.as_ref()));
+    }
+
+    #[test]
+    fn the_same_wallet_two_ways_is_two_identities() {
+        let both = cfg(serde_json::json!({ "sso": sso_block(), "wallet": wallet_block(), "api_key_seed": "s33d-0f1e2d3c4b5a69788796a5b4c3d2e1f0" }));
+        let via_platform = verify_sign_in(both.sso.as_ref(), None, &est1(SIGNER, AUD)).unwrap();
+        let via_wallet = verify_sign_in(None, both.wallet.as_ref(), &ews1(both.wallet.as_ref().unwrap(), "chat.example.com", &key(0x42))).unwrap();
+        assert_eq!(via_platform, SIGNER);
+        assert_eq!(via_wallet, format!("wallet_{SIGNER}"));
+        assert_ne!(via_platform, via_wallet, "never silently the same data");
+        // so their derived API keys differ, and each verifies back to its own identity
+        let seed = both.key_seed().unwrap();
+        let (kp, kw) = (apikey::derive(seed, &via_platform).unwrap(), apikey::derive(seed, &via_wallet).unwrap());
+        assert_ne!(kp, kw);
+        assert_eq!(apikey::verify(seed, &kw).unwrap(), via_wallet);
+        // a different wallet is a different identity again
+        let other = verify_sign_in(None, both.wallet.as_ref(), &ews1(both.wallet.as_ref().unwrap(), "chat.example.com", &key(0x43))).unwrap();
+        assert_ne!(other, via_wallet);
+    }
+
+    #[test]
+    fn models_advertises_what_the_page_needs_and_no_secret() {
+        let s = auth_block(Some(&cfg(serde_json::json!({ "sso": sso_block() }))));
+        assert_eq!(s["enabled"], true);
+        assert_eq!(s["required"], true);
+        assert_eq!(s["aud"], AUD);
+        assert_eq!(s["authorize_url"], "https://enclave.host/sso/authorize");
+        assert!(s.get("wallet").is_none());
+        let w = auth_block(Some(&cfg(serde_json::json!({ "wallet": {
+            "audience": AUD, "domains": ["chat.example.com"], "nonce_key": "k3y-not-for-the-page" } }))));
+        assert_eq!(w["enabled"], true);
+        assert_eq!(w["sso"], false);
+        assert_eq!(w["wallet"]["aud"], AUD);
+        assert_eq!(w["wallet"]["chain_id"], 8453);
+        assert!(!w.to_string().contains("k3y-not-for-the-page"));
+        assert_eq!(auth_block(Some(&cfg(serde_json::json!({}))))["enabled"], false);
+    }
+
+    /// The ACCOUNT side of a link: only a sign-in made moments ago, or this
+    /// deployment's own key for the account. Never an old session token,
+    /// never a wallet's key, never another deployment's sign-in.
+    #[test]
+    fn account_proofs_for_links() {
+        let c = cfg(serde_json::json!({ "sso": sso_block(), "wallet": wallet_block(), "api_key_seed": "s33d-0f1e2d3c4b5a69788796a5b4c3d2e1f0" }));
+        assert_eq!(verify_account_proof(&c, &est1("acct_ab12", AUD)).unwrap(), "acct_ab12");
+        // a still-valid session token minted an hour ago proves no intent to link now
+        let claims = serde_json::json!({ "aud": AUD, "exp": now() + 3600, "iat": now() - 3600, "sub": "acct_ab12", "v": 1 });
+        let payload = URL_SAFE_NO_PAD.encode(claims.to_string());
+        let stale = format!("EST1.{payload}.{}", URL_SAFE_NO_PAD.encode(personal_sign(&key(0x42), format!("EST1.{payload}").as_bytes())));
+        assert!(verify_sign_in(c.sso.as_ref(), None, &stale).is_ok(), "still a fine session");
+        assert!(verify_account_proof(&c, &stale).unwrap_err().contains("fresh"));
+        // another deployment's sign-in
+        assert!(verify_account_proof(&c, &est1("acct_ab12", OTHER)).is_err());
+        // this deployment's own API key for the account: no issuer involved at all
+        let seed = c.key_seed().unwrap();
+        let no_sso = cfg(serde_json::json!({ "wallet": wallet_block(), "api_key_seed": "s33d-0f1e2d3c4b5a69788796a5b4c3d2e1f0" }));
+        assert_eq!(verify_account_proof(&no_sso, &apikey::derive(seed, "acct_ab12").unwrap()).unwrap(), "acct_ab12");
+        // but a WALLET's key is not an account, and another seed's key is nothing
+        assert!(verify_account_proof(&no_sso, &apikey::derive(seed, &format!("wallet_{SIGNER}")).unwrap()).is_err());
+        assert!(verify_account_proof(&no_sso, &apikey::derive("other-seed", "acct_ab12").unwrap()).is_err());
+        // and a wallet sign-in is not an account proof
+        let w = ews1(c.wallet.as_ref().unwrap(), "chat.example.com", &key(0x42));
+        assert!(verify_account_proof(&c, &w).is_err());
+    }
+
+    #[test]
+    fn a_malformed_wallet_block_fails_the_config_loudly() {
+        let mut raw = config::load_raw().unwrap_or_else(|_| serde_json::json!({}));
+        raw["wallet"] = serde_json::json!({ "audience": "0x12" });
+        let e = config::from_value(raw.clone()).err().expect("refused");
+        assert!(e.contains("wallet.audience"), "{e}");
+        raw["wallet"] = serde_json::json!({ "audience": AUD, "domains": ["*.example.com"] });
+        assert!(config::from_value(raw).is_err());
+    }
+}
