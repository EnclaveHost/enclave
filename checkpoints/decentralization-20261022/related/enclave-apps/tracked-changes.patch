+/// The identity an X-Sso-Token names, checked only by the block that admits
+/// its kind: an EST1 token against `sso`, an EWS1 wallet sign-in against
+/// `wallet`. Ok(None): this deployment admits no such token, so it names
+/// nobody (as before for EST1 without sso). Err: it was presented and is bad.
+/// Contract wallets (EIP-1271) are checked through the pinned reader quorum
+/// only when the owner configured `wallet.contract_wallets`; an EOA, an EST1
+/// token and a depot token never touch the network.
+pub fn sign_in(cfg: &crate::config::Config, t: &str, now: u64) -> Result<Option<String>, ()> {
+    let mut readers = crate::wallet::HttpReaders(rpc_post);
+    let rpc: Option<crate::wallet::RpcPost> =
+        if cfg.wallet.as_ref().is_some_and(|w| w.contract.is_some()) { Some(&mut readers) } else { None };
+    sign_in_with(cfg, t, now, rpc)
+}
+
+/// sign_in, with the chain-reader transport supplied by the caller.
+pub fn sign_in_with(cfg: &crate::config::Config, t: &str, now: u64, rpc: Option<crate::wallet::RpcPost>) -> Result<Option<String>, ()> {
+    if t.starts_with("EWS1.") {
+        return match &cfg.wallet {
+            Some(w) => crate::wallet::verify_with(w, t, now, rpc).map(|c| Some(c.sub)).map_err(|_| ()),
+            None => Ok(None),
+        };
+    }
+    match &cfg.sso {
+        Some(s) => crate::sso::verify(s, t, now).map(|c| Some(c.sub)).map_err(|_| ()),
+        None => Ok(None),
+    }
+}
+
+/// One JSON-RPC POST to a chain reader the owner pinned (wallet.rs
+/// check_1271), over depot's own client and egress: bounded in time and
+/// size, sent once, no redirect followed, only public signature data.
+fn rpc_post(url: &str, body: &[u8], timeout_s: u64, max_bytes: usize) -> Result<Vec<u8>, String> {
+    let scheme_end = url.find("://").ok_or("reader URL has no scheme")? + 3;
+    let path_at = url[scheme_end..].find('/').map(|i| scheme_end + i).unwrap_or(url.len());
+    let (origin, path) = (&url[..path_at], if path_at < url.len() { &url[path_at..] } else { "/" });
+    let mut c = crate::client::Client::new(origin)?;
+    c.timeout = std::time::Duration::from_secs(timeout_s);
+    c.max_body = max_bytes;
+    let headers = [("content-type".to_string(), "application/json".to_string())];
+    let r = c.send_once("POST", path, &headers, body, false)?;
+    if r.status != 200 {
+        return Err(format!("reader answered HTTP {}", r.status));
+    }
+    Ok(r.body)
+}
