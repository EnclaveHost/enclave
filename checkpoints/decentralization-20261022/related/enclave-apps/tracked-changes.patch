+/// A binary CID (v0 or v1) -> (codec, multihash). CIDv0 is sha2-256 dag-pb.
+fn cid_parts(b: &[u8]) -> Option<(u64, Vec<u8>)> {
+    if b.len() == 34 && b[0] == 0x12 && b[1] == 0x20 {
+        return Some((CODEC_DAG_PB, b.to_vec()));
+    }
+    let (version, n) = varint_read(b)?;
+    let (codec, m) = varint_read(b.get(n..)?)?;
+    let (mh, len) = cid_multihash(b)?;
+    (version == 1 && len == b.len() && n + m <= b.len()).then_some((codec, mh))
