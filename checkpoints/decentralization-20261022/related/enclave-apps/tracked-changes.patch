+            assert_eq!(header(&h, "content-disposition"), Some(format!("attachment; filename=\"{cid}.car\"").as_str()));
+            assert_eq!(body, want, "{cid}: the CAR bytes are unchanged");
+            let (status, h, body) = http_once(&mut app, "HEAD", &format!("/ipfs/{cid}"), Some("application/vnd.ipld.car"));
+            assert_eq!((status, header(&h, "content-type")), (200, Some("application/vnd.ipld.car; version=1")), "{cid}");
