+            assert!(car_root_indexed(&app.snap, &cid), "{cid}");
+            // what the route streamed before this change: CarBody's own bytes
+            let mut want = Vec::new();
+            let mut src = CarBody::new(app.snap.clone(), app.s3.clone().unwrap(), cid);
+            while let Some(part) = src.pull().unwrap() {
+                want.extend(part);
