+    /// PUT one object only if NO object has that key (`If-None-Match: *`):
+    /// Ok(Some(etag)) when this call created it, Ok(None) when one already
+    /// existed (412, or 409 from a store reporting a concurrent create). AWS
+    /// S3, R2 and minio honour the header; a store that ignores it makes this
+    /// an overwrite, which is why callers read their write back.
+    pub fn create(&self, key: &str, body: &[u8], content_type: &str) -> Result<Option<String>, S3Error> {
+        let extra = vec![
+            ("content-type".to_string(), content_type.to_string()),
+            ("if-none-match".to_string(), "*".to_string()),
+        ];
+        let r = self.request(Method::Put, "PUT", key, &[], body, &extra, 64 * 1024)?;
+        match r.status {
+            200 => Ok(Some(etag_of(&r))),
+            409 | 412 => Ok(None),
+            s => Err(S3Error::Http(s, body_head(&r.body))),
+        }
+    }
