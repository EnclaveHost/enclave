+/// One JSON-RPC POST to a chain reader the owner pinned in
+/// `wallet.contract_wallets` (EIP-1271, wallet.rs check_1271): bounded in time
+/// and size, no redirect followed, only the public signature data sent.
+fn rpc_post(url: &str, body: &[u8], timeout_s: u64, max_bytes: usize) -> Result<Vec<u8>, String> {
+    let r = http::request(http::HttpReq {
+        method: bindings::wasi::http::types::Method::Post,
+        url,
+        headers: vec![("content-type".to_string(), b"application/json".to_vec())],
+        body: Some(body),
+        timeout_s,
+        max_bytes,
+    })?;
+    if r.status != 200 {
+        return Err(format!("reader answered HTTP {}", r.status));
+    }
+    if r.truncated {
+        return Err("reader answered too much".into());
+    }
+    Ok(r.body)
+}
