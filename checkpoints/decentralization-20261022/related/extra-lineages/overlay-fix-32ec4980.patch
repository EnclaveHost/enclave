@@ -0,0 +1,47 @@
+// The platform API role (metal/guest/platform-api-role.mjs, docs/network/hosted-platform-api.md) as ONE file for the
+// measured control guest: /opt/metal/platform-api.bundle.mjs, started by gsup.mjs for a bound config with a platformApi
+// member. It carries the role, relay/state-replica.mjs, the verifier it hands the state key with, and the UNCHANGED
+// relay/api-relay.js with its whole closure (run by the same file with --relay-child). The same pattern as
+// scripts/build-mcp-guest-bundle.mjs: exact inputs recorded in a manifest; --check refuses a stale one; not minified, so the
+// bytes inside the measurement stay reviewable.
+// One file the relay reads at RUN time beside its module is a SIDECAR: relay/vbs-policy.mjs resolves ./fixtures/tpm-roots.pem
+// from import.meta.url, which in the bundle is /opt/metal. metal/build-image.mjs copies it to /opt/metal/fixtures/, and the
+// manifest records its hash.
+import { build } from "esbuild";
+import fs from "node:fs/promises";
+import path from "node:path";
+import { fileURLToPath } from "node:url";
+import { createHash } from "node:crypto";
+const root = path.resolve(path.dirname(fileURLToPath(import.meta.url)), "..");
+const entry = "metal/guest/platform-api-role.mjs", output = path.join(root, "metal/guest/platform-api.bundle.mjs");
+export const SIDECARS = Object.freeze({ "fixtures/tpm-roots.pem": "relay/fixtures/tpm-roots.pem" });   // beside the bundle -> source
+const args = process.argv.slice(2);
+const outIdx = args.indexOf("--out");
+if (args.some((a, i) => !(a === "--check" || a === "--out" || (outIdx >= 0 && i === outIdx + 1)))) throw new Error("usage: build-platform-api-guest-bundle.mjs [--check] [--out DIR]");
+const result = await build({
+  absWorkingDir: root, entryPoints: [entry], outfile: output,
+  platform: "node", format: "esm", target: "node20", bundle: true, minify: false, write: false, metafile: true, legalComments: "none", preserveSymlinks: true,
+  banner: { js: "// Generated by scripts/build-platform-api-guest-bundle.mjs from metal/guest/platform-api-role.mjs; do not edit.\nimport { createRequire as __paCreateRequire } from 'node:module'; const require = __paCreateRequire(import.meta.url);" },
+});
+const bytes = Buffer.from(result.outputFiles[0].contents);
+const sha = (b) => createHash("sha256").update(b).digest("hex");
+const inputs = {};
+for (const rel of Object.keys(result.metafile.inputs).sort()) {
+  if (rel.startsWith("..") || path.isAbsolute(rel)) throw new Error(`bundle input outside the tree: ${rel}`);
+  inputs[rel] = sha(await fs.readFile(path.resolve(root, rel)));
+}
+for (const must of ["relay/api-relay.js", "relay/state-replica.mjs", "metal/guest/platform-api-verify.mjs", "metal/measured-control-verify.mjs"])
+  if (!inputs[must]) throw new Error(`the bundle does not carry ${must}`);
+const sidecars = {};
+for (const [beside, src] of Object.entries(SIDECARS)) sidecars[beside] = { source: src, sha256: sha(await fs.readFile(path.join(root, src))) };
+const manifest = JSON.stringify({ bundle: "metal/guest/platform-api.bundle.mjs", entry, sha256: sha(bytes), bytes: bytes.length, inputs, sidecars }, null, 2) + "\n";
+if (args.includes("--check")) {
+  if (!bytes.equals(await fs.readFile(output))) throw new Error("the platform API guest bundle is stale; run node scripts/build-platform-api-guest-bundle.mjs");
+  if (manifest !== await fs.readFile(output + ".manifest.json", "utf8")) throw new Error("the platform API guest bundle manifest is stale");
+} else {
+  const dir = outIdx >= 0 ? path.resolve(args[outIdx + 1]) : path.dirname(output);
+  await fs.mkdir(dir, { recursive: true });
+  await fs.writeFile(path.join(dir, "platform-api.bundle.mjs"), bytes);
+  await fs.writeFile(path.join(dir, "platform-api.bundle.mjs.manifest.json"), manifest);
+}
+console.log(`platform API guest bundle: ${bytes.length} bytes, sha256:${sha(bytes)}, ${Object.keys(inputs).length} inputs, ${Object.keys(sidecars).length} sidecar(s)${args.includes("--check") ? " (verified)" : ""}`);
