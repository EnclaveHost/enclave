+/// the report). Empty = keep the servers known so far.
+pub fn system_dns_from(list: &str) -> Vec<SocketAddr> {
+    let own: [IpAddr; 5] = [
+        IpAddr::V4(DNS_V4),
+        IpAddr::V4(GATEWAY),
+        IpAddr::V4(VPN_V4),
+        IpAddr::V6(DNS_V6),
+        IpAddr::V6(VPN_V6),
+    ];
+    let mut out: Vec<SocketAddr> = Vec::new();
+    for s in list.split(',') {
+        let Some(ip) = s.trim().split('%').next().and_then(|a| a.parse::<IpAddr>().ok()) else {
+            continue;
+        };
+        let link_local_v6 = matches!(ip, IpAddr::V6(v6) if (v6.segments()[0] & 0xffc0) == 0xfe80);
+        if own.contains(&ip) || ip.is_loopback() || ip.is_unspecified() || link_local_v6 {
+            continue;
+        }
+        let a = SocketAddr::new(ip, 53);
+        if !out.contains(&a) {
+            out.push(a);
+        }
+    }
+    out
