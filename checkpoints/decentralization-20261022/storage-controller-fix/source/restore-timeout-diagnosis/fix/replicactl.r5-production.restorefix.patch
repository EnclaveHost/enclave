+    r = subprocess.run(["docker", "exec", node["pg_container"], "timeout", "--version"], capture_output=True, timeout=qb.cap(60))
+    if r.returncode != 0 or "GNU coreutils" not in r.stdout.decode(errors="replace").split("\n", 1)[0]:
