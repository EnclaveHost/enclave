 "lifecycle": [
  {
   "name": "normal life: start, destroy, reclaim once; a later crash changes nothing",
   "ops": [
    "finish_start",
    "state",
    "request_end:destroyed",
    "reclaim",
    "request_end:crashed",
    "reclaim",
    "state"
   ],
   "results": [
    "start:",
    "state:running",
    "end:true",
    "reclaim:1",
    "end:false",
    "reclaim:1",
    "state:ended"
   ],
   "final": "ended"
  },
  {
   "name": "destroy during startup is deferred to startup, which honours it",
   "ops": [
    "request_end:destroyed",
    "state",
    "finish_start",
    "request_end:destroyed",
    "reclaim",
    "state"
   ],
   "results": [
    "end:false",
    "state:starting",
    "start:destroyed",
    "end:true",
    "reclaim:1",
    "state:ended"
   ],
   "final": "ended"
  },
  {
   "name": "the first end request during startup is the one kept",
   "ops": [
    "request_end:crashed",
    "request_end:destroyed",
    "finish_start",
    "request_end:x",
    "reclaim"
   ],
   "results": [
    "end:false",
    "end:false",
    "start:crashed",
    "end:true",
    "reclaim:1"
   ],
   "final": "ended"
  },
  {
   "name": "a failed start goes straight to ending, and finish_start never resurrects an ended domain",
   "ops": [
    "fail_start",
    "state",
    "reclaim",
    "state",
    "finish_start",
    "state"
   ],
   "results": [
    "fail",
    "state:ending",
    "reclaim:1",
    "state:ended",
    "start:",
    "state:ended"
   ],
   "final": "ended"
  },
  {
   "name": "reclamation runs once however often it is asked",
   "ops": [
    "finish_start",
    "request_end:a",
    "reclaim",
    "reclaim",
    "request_end:b",
    "reclaim",
    "state"
   ],
   "results": [
    "start:",
    "end:true",
    "reclaim:1",
    "reclaim:1",
    "end:false",
    "reclaim:1",
    "state:ended"
   ],
   "final": "ended"
  }
 ],
