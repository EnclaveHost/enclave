# Shared by build-domain.sh (to predict the digest) and run-domain.sh (to launch): the measured
# launch inputs other than the initramfs itself. Change one and every domain's identity changes.
# THE FIRMWARE MUST VERIFY THE SEV KERNEL HASH TABLE, and the distro one does not.
#
# kernel-hashes=on makes QEMU write sha256(kernel), sha256(initrd) and sha256(cmdline) into a page the launch
# digest commits to. Whether anything COMPARES the served bytes against that table is a property of the firmware:
# /usr/share/edk2-ovmf/x64/OVMF.4m.fd is OvmfPkgX64, which links BlobVerifierLibNull and never compares, so with
# it "the app is in the measured image" is a statement about hashes and not about what executes. Measured
# 2026-09-24: that firmware boots with kernel-hashes=off (no table at all), and a test-only QEMU that hashes one
# initrd while serving another boots the SERVED image under the HASHED one's measurement.
#
# This is an AmdSevX64 build, which links BlobVerifierLibSevHashes and compares. Against it the same substitution
# is REFUSED and a missing table is REFUSED. See isolation/m4/evidence/firmware-0a-2026-09-24.txt.
#
# Build it with: sh isolation/m2/build-verifying-firmware.sh
# The binary is 4 MiB of build output and is deliberately NOT in the repository. If it is absent, every script
# that sources this file fails HERE rather than quietly launching on a firmware that does not verify.
OVMF=${OVMF:-$HOME/.cache/enclave-isolation/fwbuild/OVMF.amdsev.fd}
if [ ! -r "$OVMF" ]; then
  echo "domain.env: no verifying firmware at $OVMF" >&2
  echo "            build it with: sh isolation/m2/build-verifying-firmware.sh" >&2
  echo "            (the distro OVMF does NOT verify the SEV hash table; see the comment above)" >&2
  return 1 2>/dev/null || exit 1
fi
# THE T0 TIER NEEDS A DIFFERENT FIRMWARE, and the reason is the same property that makes the one above worth
# having. A plain KVM guest has no SEV at all, so there is no kernel hash table for a verifying firmware to
# compare against - and an AmdSevX64 build meets that by refusing to load the kernel and falling through to its
# boot manager. Measured 2026-09-24: the M2 T0 guest on the verifying firmware printed "Failed to mount root
# securely" and "Failed to find any grub configuration on the encrypted volume" instead of booting.
#
# T0 is the explicitly untrusted tier, used for parity comparison against T1: no security claim rests on its
# firmware. So it keeps the distro OVMF, and run-domain.sh picks by mode. Any claim about a T0 domain must say
# it is a T0 domain, which the client's verdict already does ("a T0 domain is never trusted").
OVMF_T0=${OVMF_T0:-/usr/share/edk2-ovmf/x64/OVMF.4m.fd}
KERNEL=/boot/vmlinuz-linux
APPEND="console=ttyS0 rdinit=/init loglevel=3"

# The release of the kernel the GUEST boots, read out of that image rather than from `uname -r`.
#
# This matters as soon as the host and the guest run different kernels, which is exactly the M3b
# situation: the host runs the KVM-planes kernel, the guests keep booting $KERNEL (the distribution
# kernel), and the planes kernel deliberately has no SEV_GUEST/tsm_report because it is a HOST kernel.
# build-domain.sh used /lib/modules/$(uname -r), so it silently took guest modules from whatever the host
# happened to be running - correct only while the two were the same kernel, and a mismatch waiting to
# happen before that. Read from the bzImage setup header: a 2-byte offset at 0x20E, relative to 0x200.
_kv_off=$(od -An -j0x20E -N2 -tu2 < "$KERNEL" | tr -d ' ')
GUEST_KREL=${GUEST_KREL:-$(dd if="$KERNEL" bs=1 skip=$((_kv_off + 0x200)) count=128 status=none | tr -d '\0' | head -c 128 | cut -d' ' -f1)}
[ -d "/lib/modules/$GUEST_KREL/kernel" ] || { echo "no module tree for the guest kernel $GUEST_KREL (from $KERNEL)" >&2; exit 1; }
