# Shared by build-domain.sh (to predict the digest) and run-domain.sh (to launch): the measured
# launch inputs other than the initramfs itself. Change one and every domain's identity changes.
OVMF=/usr/share/edk2-ovmf/x64/OVMF.4m.fd
KERNEL=/boot/vmlinuz-linux
APPEND="console=ttyS0 rdinit=/init loglevel=3"
