-        }
+        // VMGS is host-managed on VBS hosts. Only a complete, successful write
+        // received through guest TPM MMIO in this boot may supply report data.
+        // The private copy is deliberately absent from persistent/saved state.
+        let guest_attestation_input = if is_attestation_report {
+            self.guest_report_input.value()
+        } else {
+            [0u8; ATTESTATION_REPORT_DATA_SIZE]
+        };
 
