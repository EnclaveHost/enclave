diff --git a/vm/devices/tpm/tpm_device/src/guest_report_input.rs b/vm/devices/tpm/tpm_device/src/guest_report_input.rs
new file mode 100644
index 0000000..54a7ddc
--- /dev/null
+++ b/vm/devices/tpm/tpm_device/src/guest_report_input.rs
@@ -0,0 +1,99 @@
+// Copyright (c) Enclave Host, Inc.
+// Licensed under the MIT License.
+
+/// Volatile input provenance for Enclave Shield's VBS app reports. Never restore
+/// this value from VMGS, TPM NVRAM, or a device save-state supplied by the host.
+#[derive(Default)]
+pub(super) struct GuestReportInput(Option<[u8; 64]>);
+
+impl GuestReportInput {
+    pub(super) fn value(&self) -> [u8; 64] {
+        self.0.unwrap_or([0; 64])
+    }
+
+    pub(super) fn clear(&mut self) {
+        self.0 = None;
+    }
+
+    pub(super) fn commit(&mut self, input: Option<[u8; 64]>, reply: &[u8]) {
+        // A failed TPM authorization or malformed request cannot update a binding.
+        if reply.len() >= 10 && reply[6..10] == [0; 4] {
+            if let Some(input) = input {
+                self.0 = Some(input);
+            }
+        }
+    }
+}
+
+/// Parse only a complete, offset-zero TPM2_NV_Write to the guest input index.
+/// TPM itself validates authorization; the caller commits only after success.
+/// Ignore unused bytes at the end of the shared command page.
+pub(super) fn complete_write(command: &[u8]) -> Option<[u8; 64]> {
+    let u32_at =
+        |n| -> Option<u32> { Some(u32::from_be_bytes(command.get(n..n + 4)?.try_into().ok()?)) };
+    if command.get(..2)? != [0x80, 0x02] || u32_at(6)? != 0x137 || u32_at(14)? != 0x01400002 {
+        return None;
+    }
+    let size = usize::try_from(u32_at(2)?).ok()?;
+    let params = 22usize.checked_add(usize::try_from(u32_at(18)?).ok()?)?;
+    if size > command.len() || params.checked_add(68)? != size {
+        return None;
+    }
+    if command.get(params..params + 2)? != [0, 64] || command.get(size - 2..size)? != [0, 0] {
+        return None;
+    }
+    command.get(params + 2..params + 66)?.try_into().ok()
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    fn write(value: u8) -> Vec<u8> {
+        let mut b = vec![0; 4096];
+        b[..2].copy_from_slice(&[0x80, 2]);
+        b[2..6].copy_from_slice(&97u32.to_be_bytes());
+        b[6..10].copy_from_slice(&0x137u32.to_be_bytes());
+        b[10..14].copy_from_slice(&0x40000001u32.to_be_bytes());
+        b[14..18].copy_from_slice(&0x01400002u32.to_be_bytes());
+        b[18..22].copy_from_slice(&7u32.to_be_bytes());
+        b[22..26].copy_from_slice(&0x40000009u32.to_be_bytes());
+        b[29..31].copy_from_slice(&64u16.to_be_bytes());
+        b[31..95].fill(value);
+        b
+    }
+
+    #[test]
+    fn only_successful_guest_write_supplies_binding() {
+        let mut state = GuestReportInput::default();
+        assert_eq!(state.value(), [0; 64]);
+        let mut reply = [0; 10];
+        reply[9] = 1;
+        state.commit(complete_write(&write(42)), &reply);
+        assert_eq!(state.value(), [0; 64]);
+        reply[9] = 0;
+        state.commit(complete_write(&write(42)), &reply);
+        assert_eq!(state.value(), [42; 64]);
+        state.commit(complete_write(&write(43)), &reply);
+        assert_eq!(state.value(), [43; 64]);
+        state.clear();
+        assert_eq!(state.value(), [0; 64]);
+    }
+
+    #[test]
+    fn malformed_partial_and_other_index_writes_cannot_import_nv_state() {
+        let good = write(42);
+        for len in 0..97 {
+            assert!(complete_write(&good[..len]).is_none());
+        }
+        assert_eq!(complete_write(&good), Some([42; 64]));
+        for (at, value) in [(1, 1), (5, 96), (9, 0x4e), (17, 1), (30, 63), (96, 1)] {
+            let mut bad = good.clone();
+            bad[at] = value;
+            assert!(complete_write(&bad).is_none(), "mutation at {at}");
+        }
+        let mut overflow = good;
+        overflow[18..22].fill(255);
+        assert!(complete_write(&overflow).is_none());
+    }
+}
