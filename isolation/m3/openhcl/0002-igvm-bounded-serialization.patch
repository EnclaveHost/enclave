     #[test]
+    fn test_indexed_dedup_collision_and_growth() {
+        use std::hash::{DefaultHasher, Hash, Hasher};
+        let mut data = FileDataSerializer::new(64);
+        assert_eq!(data.write_file_data(b"first"), 64);
+        let mut hasher = DefaultHasher::new();
+        b"other".as_slice().hash(&mut hasher);
+        // Force a hash collision with distinct bytes and the same length.
+        data.file_data_map.insert(hasher.finish(), vec![(0, 5, 64)]);
+        assert_eq!(data.write_file_data(b"other"), 69);
+        assert_eq!(data.write_file_data(b"other"), 69);
+        for byte in 0..100u8 {
+            data.write_file_data(&vec![byte; 4096]);
+        }
+        assert_eq!(data.write_file_data(b"first"), 64);
+        assert_eq!(data.write_file_data(b"other"), 69);
+        assert_eq!(&data.take()[..10], b"firstother");
+    }
