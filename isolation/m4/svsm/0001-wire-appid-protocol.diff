+/// Enclave M4b: a report for the app-naming authority in protocols::appid.
+///
+/// The 64 bytes are assembled by the SVSM - the caller's bind in the low half, the calling plane's measured
+/// app ID in the high half - so this deliberately takes the whole report_data rather than a "nonce" a guest
+/// could shape. Kept next to the standard path so there is one PSP call site, not two.
+/// A report for an app plane, naming THAT PLANE rather than VMPL0.
+///
+/// get_attestation_report_standard leaves SnpReportRequest.vmpl at its zero default, which is right for the
+/// SVSM's own reports and wrong for a plane's: a report signed as VMPL0 for code running at VMPL2 is either
+/// rejected by a verifier that pins the plane or, worse, accepted by one that does not, losing the only field
+/// that distinguishes the monitor's evidence from an app's. The SVSM holds VMPCK0 and may name any level, so
+/// this is its call to make and not the caller's.
+pub fn get_attestation_report_for_app(
+    report_data: &[u8; 64],
+    vmpl: u32,
+) -> Result<Box<SnpReportResponse>, SvsmReqError> {
+    let mut resp = SnpReportResponse::new_box_zeroed()
+        .map_err(|_| SvsmReqError::FatalError(SvsmError::Mem))?;
+    let resp_buffer = resp.as_mut_bytes();
+    let (report_req, _) = SnpReportRequest::mut_from_prefix(resp_buffer)
+        .map_err(|_| SvsmReqError::invalid_parameter())?;
+    report_req.user_data = *report_data;
+    report_req.vmpl = vmpl;
+    let _response_size = get_regular_report(resp_buffer)?;
+    Ok(resp)
+}
