+/// Enclave M4b: a report for the app-naming authority in protocols::appid.
+///
+/// The 64 bytes are assembled by the SVSM - the caller's bind in the low half, the calling plane's measured
+/// app ID in the high half - so this deliberately takes the whole report_data rather than a "nonce" a guest
+/// could shape. Kept next to the standard path so there is one PSP call site, not two.
+pub fn get_attestation_report_for_app(
+    report_data: &[u8; 64],
+) -> Result<Box<SnpReportResponse>, SvsmReqError> {
+    get_attestation_report_standard(report_data)
+}
+
 fn get_attestation_report_standard(nonce: &[u8]) -> Result<Box<SnpReportResponse>, SvsmReqError> {
     let mut resp = SnpReportResponse::new_box_zeroed()
         .map_err(|_| SvsmReqError::FatalError(SvsmError::Mem))?;
