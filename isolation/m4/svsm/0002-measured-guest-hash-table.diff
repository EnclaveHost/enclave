+/// The GUIDs of QEMU's SevHashTable, written exactly as the firmware's own literals are.
+///
+/// These are the four GUIDs in OvmfPkg/AmdSev/BlobVerifierLibSevHashes/BlobVerifierSevHashes.c, in the same
+/// (u32, u16, u16, [u8; 8]) shape as the EDK2 `(GUID) { ... }` initialisers there, so the two can be diffed line
+/// by line. `guid_le` then produces the mixed-endian on-the-wire form. An earlier revision stored the wire bytes
+/// directly and three of the four were wrong; because the verifier SEARCHES for a GUID and treats "not found" as
+/// success, that did not refuse anything - it silently verified nothing. Do not flatten these back to byte
+/// arrays.
+const SEV_HASH_TABLE_HEADER_GUID: Guid = (0x9438d606, 0x4f22, 0x4cc9, [0xb4, 0x79, 0xa7, 0x93, 0xd4, 0x11, 0xfd, 0x21]);
+const SEV_KERNEL_ENTRY_GUID: Guid = (0x4de79437, 0xabd2, 0x427f, [0xb8, 0x35, 0xd5, 0xb1, 0x72, 0xd2, 0x04, 0x5b]);
+const SEV_INITRD_ENTRY_GUID: Guid = (0x44baf731, 0x3a2f, 0x4bd7, [0x9a, 0xf1, 0x41, 0xe2, 0x91, 0x69, 0x78, 0x1d]);
+const SEV_CMDLINE_ENTRY_GUID: Guid = (0x97d02dd8, 0xbd20, 0x4c94, [0xaa, 0x78, 0xe7, 0x71, 0x4d, 0x36, 0xab, 0x2a]);
+
+type Guid = (u32, u16, u16, [u8; 8]);
+
+/// The mixed-endian form: the first three fields little-endian, the last eight bytes as written.
+fn guid_le(g: &Guid) -> [u8; 16] {
+    let mut b = [0u8; 16];
+    b[0..4].copy_from_slice(&g.0.to_le_bytes());
+    b[4..6].copy_from_slice(&g.1.to_le_bytes());
+    b[6..8].copy_from_slice(&g.2.to_le_bytes());
+    b[8..16].copy_from_slice(&g.3);
+    b
+}
+
+/// SevHashTable is packed: header GUID (16) + u16 length (2), then three 50-byte entries back to back, so the
+/// first entry is at offset 18 and the declared length is 168. PaddedSevHashTable then rounds the whole table up
+/// to a 16-byte boundary, adding eight trailing zero bytes that are OUTSIDE the declared length. The firmware
+/// walks Ptr->Len - 18 = 150 bytes, exactly three entries, so it never reads the padding - but the padding is
+/// measured, so it must be emitted.
+const SEV_HASH_ENTRY_LEN: usize = 16 + 2 + 32;
+const SEV_HASH_TABLE_LEN: usize = 16 + 2 + 3 * SEV_HASH_ENTRY_LEN;
+const SEV_HASH_TABLE_PADDED_LEN: usize = SEV_HASH_TABLE_LEN.next_multiple_of(16);
+
+/// The table's real GPA, from the SEV_HASH_TABLE_RV_GUID footer entry.
+///
+/// Separate from `find_kernel_hashes_area` because they answer different questions: that one gives the page the
+/// SVSM must not validate, this one gives the address the FIRMWARE reads.
+fn find_sev_hash_table_gpa(data: &[u8]) -> Result<Option<u32>, Box<dyn Error>> {
+    if data.len() < FOOTER_OFFSET {
+        return Ok(None);
+    }
+    let (uuid, mut body, _) = read_table(&data[..data.len() - FOOTER_OFFSET])?;
+    if uuid != OVMF_TABLE_FOOTER_GUID {
+        return Ok(None);
+    }
+    while !body.is_empty() {
+        let (uuid, entry, remainder) = read_table(body)?;
+        body = remainder;
+        if uuid != SEV_HASH_TABLE_RV_GUID {
+            continue;
+        }
+        if entry.len() < 4 {
+            return Err("the SEV_HASH_TABLE_RV_GUID entry is shorter than the address it must hold".into());
+        }
+        return Ok(Some(u32::from_le_bytes([entry[0], entry[1], entry[2], entry[3]])));
+    }
+    Ok(None)
+}
+
+/// Find the KERNEL_HASHES descriptor's area without disturbing the existing parse.
+///
+/// The area has to be known twice over: to emit the table at its base, and to take that page OUT of the
+/// pre-validated set. Re-scanning is deliberate - threading it out of `parse_metadata` would change three
+/// signatures for a value only this feature wants.
+fn find_kernel_hashes_area(data: &[u8]) -> Result<Option<(u32, u32)>, Box<dyn Error>> {
+    if data.len() < FOOTER_OFFSET {
+        return Ok(None);
+    }
+    let (uuid, mut body, _) = read_table(&data[..data.len() - FOOTER_OFFSET])?;
+    if uuid != OVMF_TABLE_FOOTER_GUID {
+        return Ok(None);
+    }
+    while !body.is_empty() {
+        let (uuid, entry, remainder) = read_table(body)?;
+        body = remainder;
+        if uuid != OVMF_SEV_METADATA_GUID {
+            continue;
+        }
+        // Same arithmetic as parse_metadata, deliberately: an offset from the END of the firmware image.
+        let offset_from_end = GuidBlockMetadata::read_from_bytes(entry)
+            .map_err(|e| format!("Cannot parse OVMF metadata descriptor: {e}"))?
+            .offset_from_end as usize;
+        let offset = data
+            .len()
+            .checked_sub(offset_from_end)
+            .ok_or("Cannot parse OVMF metadata descriptor: invalid offset")?;
+        let (desc, mut buf) = MetadataDesc::read_from_prefix(&data[offset..])
+            .map_err(|e| format!("Cannot parse OVMF metadata descriptor: {e}"))?;
+        for _ in 0..desc.num_desc as usize {
+            let (sev_entry, rest) = SevMetadataEntry::read_from_prefix(buf)
+                .map_err(|e| format!("Cannot parse SEV metadata entry: {e}"))?;
+            buf = rest;
+            if sev_entry.metadata_type == SEV_META_DESC_TYPE_KERNEL_HASHES {
+                return Ok(Some((sev_entry.base, sev_entry.len)));
+            }
+        }
+    }
+    Ok(None)
+}
+
+/// Take one page out of the pre-validated set, splitting the region that contains it.
+///
+/// Removing the KERNEL_HASHES descriptor from the list is NOT enough, and this is the whole reason the function
+/// exists: `add_preval_region` MERGES contiguous regions, so on a real OVMF the hashes area ends up inside a much
+/// larger MEM region - measured on this project's firmware as [0x80a000-0x830000] swallowing the hashes area at
+/// 0x812000. The SVSM validates and ZEROES every pre-validated region when it launches the firmware, so a table
+/// emitted as measured data would be wiped before the firmware ever read it, and the firmware would report
+/// "no hashes table discoverd in MEMFD" exactly as if nothing had been emitted.
+fn unvalidate_page(fw_info: &mut GuestFwInfoBlock, page: u32) -> Result<(), Box<dyn Error>> {
+    let count = fw_info.prevalidated_count as usize;
+    for i in 0..count {
+        let (base, size) = (fw_info.prevalidated[i].base, fw_info.prevalidated[i].size);
+        let end = base as u64 + size as u64;
+        if (page as u64) < base as u64 || (page as u64) + PAGE_SIZE_4K > end {
+            continue;
+        }
+        let before = (base, page - base);
+        let after = (
+            page + PAGE_SIZE_4K as u32,
+            u32::try_from(end - (page as u64 + PAGE_SIZE_4K))?,
+        );
+        println!(
+            "Pre-validated area [{:#x}-{:#x}] split around the measured hash page {:#x}",
+            base, end, page
+        );
+        // Replace this region with the part before the page, then append the part after. A zero-sized half is
+        // dropped rather than recorded, so a hash page at a region boundary does not leave an empty entry the
+        // SVSM would have to interpret.
+        let mut replacement: Vec<GuestFwMemInfo> = Vec::new();
+        if before.1 > 0 {
+            replacement.push(GuestFwMemInfo {
+                base: before.0,
+                size: before.1,
+            });
+        }
+        if after.1 > 0 {
+            replacement.push(GuestFwMemInfo {
+                base: after.0,
+                size: after.1,
+            });
+        }
+        if count - 1 + replacement.len() > fw_info.prevalidated.len() {
+            return Err("splitting the pre-validated area needs more regions than the block holds".into());
+        }
+        // rebuild the list: everything except region i, then the replacement halves
+        let mut regions: Vec<GuestFwMemInfo> = (0..count)
+            .filter(|&j| j != i)
+            .map(|j| fw_info.prevalidated[j])
+            .collect();
+        regions.extend(replacement);
+        for (j, r) in regions.iter().enumerate() {
+            fw_info.prevalidated[j] = *r;
+        }
+        fw_info.prevalidated_count = u32::try_from(regions.len())?;
+        return Ok(());
+    }
+    // Not in any pre-validated area. Nothing would zero the table in that case, but the page would also never be
+    // GRANTED through this path, and an unexamined firmware layout is not something to emit a measured table for.
+    Err(format!(
+        "the hash page {page:#x} is in no pre-validated area, so this firmware's layout is not the one this \
+         feature was built for; refusing rather than emitting a table whose handling is unverified"
+    )
+    .into())
+}
+
+/// Print the pre-validated region list as it was RECORDED in the block.
+///
+/// Unconditional, so every IGVM build states its own list. This exists because a previous reading of these
+/// regions was inferred from two SVSM log lines and got the hash area wrong by 8 KiB and its size wrong by a
+/// factor of twenty; the builder can simply say what it wrote.
+fn print_prevalidated(fw_info: &GuestFwInfoBlock) {
+    let count = fw_info.prevalidated_count as usize;
+    let listed: Vec<String> = (0..count)
+        .map(|i| {
+            let (b, sz) = (fw_info.prevalidated[i].base, fw_info.prevalidated[i].size); // packed: copy out
+            format!("[{:#x}-{:#x}]", b, b as u64 + sz as u64)
+        })
+        .collect();
+    println!("Pre-validated regions recorded ({count}): {}", listed.join(" "));
+}
+
+/// The SevHashTable QEMU would have written, computed here instead.
+///
+/// TWO DIFFERENT FAILURE MODES, and the dangerous one is not the loud one.
+///
+/// Get a DIGEST wrong and the firmware refuses with "Hash comparison failed" on a file nobody touched, which
+/// looks exactly like the substitution a verifying firmware exists to catch. Loud, and self-announcing.
+///
+/// Get the STRUCTURE or a GUID wrong and the firmware verifies nothing and boots anyway. Its constructor only
+/// checks the header GUID and that the declared length is within the area, and its walk SEARCHES for a per-blob
+/// GUID; reaching the end without a match is "If the GUID is not in the hash table, execution can still
+/// continue" and EFI_SUCCESS - for the kernel, the initrd and the cmdline alike. On a RELEASE build the DEBUG
+/// lines that would have said so are compiled out. A revision of this function did exactly that, with three
+/// wrong entry GUIDs and six spurious pad bytes, and its offline check passed because the check compared the
+/// three digests and never the table.
+///
+/// So isolation/m4/hash-table.py now compares the WHOLE table, byte for byte, against sev-snp-measure's
+/// construct_table(), and the step-2 acceptance requires seeing "Hash comparison succeeded" for all three blobs
+/// on the DEBUG firmware: a booting positive control proves nothing on its own.
+///
+/// The three hash constructions are the command line WITH its terminating NUL, the initrd as-is, and the kernel
+/// as-is. The kernel is the file's bytes rather than a patched setup header because QEMU skips that patch for
+/// any confidential guest (hw/i386/x86-common.c:955-964).
+fn sev_hash_table(
+    kernel: &str,
+    initrd: &str,
+    cmdline: &str,
+    area_size: u32,
+) -> Result<Vec<u8>, Box<dyn Error>> {
+    fn entry(guid: &Guid, digest: &[u8]) -> Vec<u8> {
+        let mut e = guid_le(guid).to_vec();
+        e.extend_from_slice(&(SEV_HASH_ENTRY_LEN as u16).to_le_bytes()); // the length covers the whole entry
+        e.extend_from_slice(digest);
+        e
+    }
+    fn digest_of_file(path: &str) -> Result<Vec<u8>, Box<dyn Error>> {
+        let mut f = File::open(path).inspect_err(|_| eprintln!("Cannot open {path}"))?;
+        let mut d = Vec::new();
+        f.read_to_end(&mut d)?;
+        Ok(Sha256::digest(&d).to_vec())
+    }
+
+    let mut cmdline_bytes = cmdline.as_bytes().to_vec();
+    cmdline_bytes.push(0); // the terminating NUL is part of what QEMU hashes
+
+    let mut table = guid_le(&SEV_HASH_TABLE_HEADER_GUID).to_vec();
+    table.extend_from_slice(&(SEV_HASH_TABLE_LEN as u16).to_le_bytes());
+    table.extend(entry(&SEV_CMDLINE_ENTRY_GUID, &Sha256::digest(&cmdline_bytes)));
+    table.extend(entry(&SEV_INITRD_ENTRY_GUID, &digest_of_file(initrd)?));
+    table.extend(entry(&SEV_KERNEL_ENTRY_GUID, &digest_of_file(kernel)?));
+    if table.len() != SEV_HASH_TABLE_LEN {
+        return Err(format!("built a {}-byte SEV hash table, expected {SEV_HASH_TABLE_LEN}", table.len()).into());
+    }
+    table.resize(SEV_HASH_TABLE_PADDED_LEN, 0); // the 16-byte round-up, outside the declared length
+
+    if table.len() > area_size as usize {
+        return Err(format!(
+            "the SEV hash table is {} bytes and the firmware's area is {area_size}",
+            table.len()
+        )
+        .into());
+    }
+    table.resize(area_size as usize, 0);
+    Ok(table)
+}
