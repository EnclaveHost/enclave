build/
dist/
# update.mjs builds beside the live image and keeps the last one for rollback
# (DIST + '.new' / '.prev'), so a box that has ever self-updated carries two
# more copies of a ~220 MB initramfs. `dist/` alone did not cover them.
dist.new/
dist.prev/
*.cpio.gz
# runtime configs carry the tunnel token — keep them out of git (commit only the example)
config.json
config.*.json
!config.example.json
