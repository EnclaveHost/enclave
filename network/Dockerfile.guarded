FROM node:22-bookworm-slim
RUN apt-get update && apt-get install -y --no-install-recommends ca-certificates iptables util-linux && rm -rf /var/lib/apt/lists/*
COPY enclave-tuna enclave-route-discovery circuit-worker.mjs guarded-entrypoint.sh public-guard-entrypoint.sh /opt/enclave-tuna/
RUN chmod 0555 /opt/enclave-tuna/guarded-entrypoint.sh /opt/enclave-tuna/public-guard-entrypoint.sh /opt/enclave-tuna/enclave-tuna
ENTRYPOINT ["/opt/enclave-tuna/guarded-entrypoint.sh"]
