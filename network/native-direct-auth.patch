 )
 
-// ValidateSOCKSProxy permits only an explicit local entry, with no DNS or userinfo.
-func ValidateSOCKSProxy(address string) error {
-	a, err := netip.ParseAddrPort(address)
-	if err != nil || !a.Addr().IsLoopback() || a.Port() == 0 {
-		return errors.New("SOCKS entry must be a loopback IP and nonzero port")
+// Only loopback entries are allowed. Direct entries carry unguessable,
+// per-app credentials; legacy TUNA entries retain their existing no-auth path.
+var proxyCredentials = regexp.MustCompile(`^[a-f0-9]{32}:[a-f0-9]{32}$`)
+
+func proxyParts(proxy string) (endpoint, username, password string, err error) {
+	endpoint = proxy
+	if credentials, host, ok := strings.Cut(proxy, "@"); ok {
+		if !proxyCredentials.MatchString(credentials) {
+			err = errors.New("invalid app proxy credentials")
+			return
+		}
+		endpoint = host
+		username, password, _ = strings.Cut(credentials, ":")
+	}
+	a, e := netip.ParseAddrPort(endpoint)
+	if e != nil || !a.Addr().IsLoopback() || a.Port() == 0 {
+		err = errors.New("SOCKS entry must be a loopback IP and nonzero port")
 	}
-	return nil
+	return
 }
+func ValidateSOCKSProxy(address string) error { _, _, _, err := proxyParts(address); return err }
 
 func dialSOCKS(ctx context.Context, proxy, destination string, timeout time.Duration) (net.Conn, error) {
 	if err := ValidateSOCKSProxy(proxy); err != nil {
@@ -29,7 +44,8 @@ func dialSOCKS(ctx context.Context, proxy, destination string, timeout time.Dura
