--- /dev/null
+++ b/isolation/m2/egress/socks_auth_test.go
@@ -0,0 +1,69 @@
+package egress
+
+import (
+	"context"
+	"io"
+	"net"
+	"strings"
+	"testing"
+	"time"
+)
+
+func TestPerAppProxyCredentials(t *testing.T) {
+	listener, e := net.Listen("tcp", "127.0.0.1:0")
+	if e != nil {
+		t.Fatal(e)
+	}
+	defer listener.Close()
+	user, pass := strings.Repeat("12", 16), strings.Repeat("34", 16)
+	done := make(chan error, 1)
+	go func() {
+		c, e := listener.Accept()
+		if e != nil {
+			done <- e
+			return
+		}
+		defer c.Close()
+		c.SetDeadline(time.Now().Add(time.Second))
+		hello := make([]byte, 3)
+		if _, e = io.ReadFull(c, hello); e != nil {
+			done <- e
+			return
+		}
+		if string(hello) != string([]byte{5, 1, 2}) {
+			done <- io.ErrUnexpectedEOF
+			return
+		}
+		c.Write([]byte{5, 2})
+		auth := make([]byte, 67)
+		if _, e = io.ReadFull(c, auth); e != nil {
+			done <- e
+			return
+		}
+		if string(auth[2:34]) != user || string(auth[35:]) != pass {
+			done <- io.ErrUnexpectedEOF
+			return
+		}
+		c.Write([]byte{1, 0})
+		request := make([]byte, 10)
+		if _, e = io.ReadFull(c, request); e != nil {
+			done <- e
+			return
+		}
+		c.Write([]byte{5, 0, 0, 1, 127, 0, 0, 1, 0, 0})
+		done <- nil
+	}()
+	c, e := dialSOCKS(context.Background(), user+":"+pass+"@"+listener.Addr().String(), "8.8.8.8:443", time.Second)
+	if e != nil {
+		t.Fatal(e)
+	}
+	c.Close()
+	if e = <-done; e != nil {
+		t.Fatal(e)
+	}
+	for _, bad := range []string{"u:p@127.0.0.1:80", user + ":" + pass + "@8.8.8.8:80", user + ":" + pass + "@127.0.0.1:0"} {
+		if ValidateSOCKSProxy(bad) == nil {
+			t.Fatal("accepted invalid proxy")
+		}
+	}
+}
