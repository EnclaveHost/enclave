[Unit]
Description=TUNA public reverse-tunnel provider
Wants=network-online.target
After=network-online.target
StartLimitIntervalSec=0

[Service]
User=tuna-provider
Group=tuna-provider
WorkingDirectory=/var/lib/tuna-provider
ExecStart=/opt/tuna-provider/tuna --wallet /etc/tuna-provider/identity/wallet.json --password-file /etc/tuna-provider/identity/wallet.pswd entry --config /etc/tuna-provider/reverse.json
Restart=always
RestartSec=10
UMask=0077
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
ReadWritePaths=/var/lib/tuna-provider
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
AmbientCapabilities=CAP_NET_BIND_SERVICE
LimitNOFILE=65536
TasksMax=512
MemoryMax=640M

[Install]
WantedBy=multi-user.target
