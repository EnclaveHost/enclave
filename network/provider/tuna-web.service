[Unit]
Description=TLS passthrough to independent TUNA app tunnels
After=network-online.target tuna-reverse.service
Wants=network-online.target

[Service]
ExecStartPre=/usr/sbin/haproxy -c -f /etc/tuna-provider/haproxy.cfg
ExecStart=/usr/sbin/haproxy -Ws -f /etc/tuna-provider/haproxy.cfg -p /run/tuna-web/haproxy.pid
ExecReload=/usr/sbin/haproxy -c -f /etc/tuna-provider/haproxy.cfg
ExecReload=/bin/kill -USR2 $MAINPID
RuntimeDirectory=tuna-web
KillMode=mixed
Restart=on-failure
RestartSec=3
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX AF_NETLINK
CapabilityBoundingSet=CAP_NET_BIND_SERVICE CAP_SETUID CAP_SETGID
ReadWritePaths=/run/tuna-web

[Install]
WantedBy=multi-user.target
