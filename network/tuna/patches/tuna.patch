+// dialProviderTCP is also used by reverse reachability probes, so a configured
+// guard is never bypassed by the SDK's own public-port check.
+func (c *Common) dialProviderTCP(ctx context.Context, addr string) (net.Conn, error) {
+	if c.TcpDialContext != nil {
+		return c.TcpDialContext(ctx, tcp4, addr)
+	}
+	return (&net.Dialer{}).DialContext(ctx, tcp4, addr)
+}
