+    top = pathlib.Path(top or TRUSTED_TOP); p = pathlib.Path(path)
+    assert p.is_absolute() and '..' not in p.parts and (p == top or top in p.parents), f'{p} is not a plain path under {top}'
+    cur, st = top, None
