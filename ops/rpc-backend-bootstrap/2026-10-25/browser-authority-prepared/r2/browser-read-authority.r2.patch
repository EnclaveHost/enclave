+// ---- integration: the real config.js + chain.js, one private copy of their import CLOSURE per scenario ----------------
+// site/js/core/independent.js imports ../../../network/*.mjs, so a copy of site/js alone cannot load (r1 failure). The
+// fixture copies the ACTUAL transitive relative-import closure of config.js and chain.js (static, re-export and literal
+// dynamic imports), each file at its repo-relative path, and links node_modules beside it for bare imports (viem). No
+// product module is stubbed; only read-authority.js is transformed, by the build plugin's own embedReadAuthority.
+const SPEC = /(?:\bimport\s*(?:[\w*{}\s,$]+?\s*from\s*)?|\bexport\s*(?:\*|\{[^}]*\})\s*from\s*|\bimport\s*\(\s*)["'](\.{1,2}\/[^"']+)["']/g;
+function importClosure(entries) {
+  const seen = new Set(), todo = [...entries];
+  while (todo.length) {
+    const rel = todo.pop(); if (seen.has(rel)) continue; seen.add(rel);
+    const src = fs.readFileSync(path.join(ROOT, rel), "utf8");
+    for (const m of src.matchAll(SPEC)) {
+      const dep = path.relative(ROOT, path.resolve(path.dirname(path.join(ROOT, rel)), m[1]));
+      if (dep.startsWith("..") || path.isAbsolute(dep)) throw new Error(`${rel} imports outside the repository: ${m[1]}`);
+      if (fs.existsSync(path.join(ROOT, dep)) && fs.statSync(path.join(ROOT, dep)).isFile()) todo.push(dep);   // a specifier in a comment that names no file is not an import
+    }
+  }
+  return [...seen].sort();
+}
+const CLOSURE = importClosure(["site/js/core/config.js", "site/js/core/chain.js"]);
+test("fixture closure: the real relative-import closure, including the network/ modules the site imports", () => {
+  for (const f of ["site/js/core/config.js", "site/js/core/chain.js", "site/js/core/read-authority.js", "site/js/core/independent.js"]) assert.ok(CLOSURE.includes(f), f);
+  assert.ok(CLOSURE.some((f) => f.startsWith("network/")), "the closure reaches network/ (what r1's fixture missed)");
+});
+function scenario(text) {
+  const dir = fs.mkdtempSync(path.join(os.tmpdir(), "site-closure-"));
+  for (const rel of CLOSURE) { fs.mkdirSync(path.dirname(path.join(dir, rel)), { recursive: true }); fs.copyFileSync(path.join(ROOT, rel), path.join(dir, rel)); }
+  fs.symlinkSync(fs.realpathSync(path.join(ROOT, "node_modules")), path.join(dir, "node_modules"));
+  if (text != null) {
+    const p = path.join(dir, "site/js/core/read-authority.js");
+    fs.writeFileSync(p, embedReadAuthority(fs.readFileSync(p, "utf8"), text, p));
+  }
+  return dir;
+}
+async function load(dir, { hostname = "enclave.host", store = {} } = {}) {
+  const m = new Map(Object.entries(store));
+  globalThis.localStorage = { getItem: (k) => (m.has(k) ? m.get(k) : null), setItem: (k, v) => m.set(k, String(v)), removeItem: (k) => m.delete(k) };
+  globalThis.sessionStorage = { getItem: () => null, setItem() {}, removeItem() {} };
+  globalThis.location = { hostname, href: `https://${hostname}/`, origin: `https://${hostname}` };
+  const config = await import(pathToFileURL(path.join(dir, "site/js/core/config.js")).href);
+  const chain = await import(pathToFileURL(path.join(dir, "site/js/core/chain.js")).href);
+  return { config, chain };
+}
+function fetchSpy(answer) {
+  const urls = []; const real = globalThis.fetch;
+  globalThis.fetch = async (u, init) => { urls.push(String(u)); return answer(String(u), JSON.parse(init.body)); };
+  return { urls, restore: () => { globalThis.fetch = real; } };
+}
+const ok = (result) => new Response(JSON.stringify({ jsonrpc: "2.0", id: 1, result }), { headers: { "content-type": "application/json" } });
