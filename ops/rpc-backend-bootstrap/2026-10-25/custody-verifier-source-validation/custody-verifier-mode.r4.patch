+  for (const [k, val] of [["CUSTODY_RPCS", ""], ["CUSTODY_RPCS", "https://mainnet.base.org"], ["CUSTODY_MIN_AGREE", ""], ["CUSTODY_MIN_AGREE", "1"]])
+    assert.throws(() => custodianConfigFromEnv({ ...V, [k]: val }), /must be unset, not blank/, `${k}=${JSON.stringify(val)}`);
