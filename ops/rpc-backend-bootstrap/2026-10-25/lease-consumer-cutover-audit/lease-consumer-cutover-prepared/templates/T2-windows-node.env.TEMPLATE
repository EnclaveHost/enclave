# Windows node lease-gas TEMPLATE. NOT APPLICABLE: the current source cannot route Windows lease reads to the verifier.
# Code gap (relay-consumer-source 81ba66853): windows/node/chain.mjs:258-259 builds leaseGasEnv from ^(ENCLAVE_)?LEASE_GAS_ keys
# only, and :272 calls loadLeaseGasConfig({ env: leaseGasEnv, ...bindings }) WITHOUT chainAuthority, so
# chainAuthorityFromEnv(leaseGasEnv) never sees ENCLAVE_CHAIN_AUTHORITY (network/chain-authority.mjs:21,102-111) -> null ->
# leases use ENCLAVE_LEASE_GAS_RPCS (public quorum). Setting the variables below therefore does NOT cut over Windows leases.
# Prerequisite P4 (reviewed code change, not made here): pass the host's chain authority into loadLeaseGasConfig at :272, as
# supervisor.js:10211 does, plus a regression that verifier-only leases refuse when the verifier is down.
ENCLAVE_CHAIN_AUTHORITY=verifier
ENCLAVE_CHAIN_VERIFIER=<UNRESOLVED: local verifier URL on the Windows box; no such verifier is inventoried>
ENCLAVE_CHAIN_TX_BACKEND=<UNRESOLVED: own transaction backend; never a public provider>
# KEEP unchanged (values not copied): ENCLAVE_LEASE_GAS_FILE, _DIGEST, _RELAYS/_PINNED_RELAYS/_SERVICE_INDEX, _RESERVE
# ENCLAVE_LEASE_GAS_RPCS/_QUORUM: still REQUIRED by lease-gas-runtime.mjs:60 while no authority reaches it (see gap)
