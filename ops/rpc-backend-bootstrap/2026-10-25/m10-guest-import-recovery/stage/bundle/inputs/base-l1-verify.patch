+            gas_limit: 30_000_000,
+            gas_used: 21_000 * receipts.len() as u64,
+            base_fee_per_gas: Some(1),
+            receipts_root: calculate_receipt_root(receipts),
+            transactions_root,
+            ..Default::default()
+        };
+        let hash = header.hash_slow();
+        (header, hash)
+    }
