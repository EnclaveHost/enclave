+fn chain(m: &Mock) -> (fx::Blk, fx::Blk) {
+    let t = now();
+    let p = blk(9, 0, B256::ZERO, t - 4);
+    let a = blk(10, 1, p.header.hash, t - 2);
+    m.canonical(&p); m.head(&a);
+    (p, a)
+}
