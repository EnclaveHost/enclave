+    for f in [None, Some(false)] { check_block_hash::<Ethereum, _>(&m, &hash_id(a.header.hash, f), now()).await.unwrap(); }
+    assert_eq!(*m.number_reads.lock().unwrap(), 0, "no height lookup without requireCanonical");
+    check_block_hash::<Ethereum, _>(&m, &hash_id(a.header.hash, Some(true)), now()).await.unwrap();
+    assert_eq!(*m.number_reads.lock().unwrap(), 1, "one verified height lookup for requireCanonical:true");
+}
