+    m.head(&b);                      // B is now canonical at 10; A is still known (authenticated) by its hash
+    let e = check_block_hash::<Ethereum, _>(&m, &hash_id(a.header.hash, Some(true)), now()).await.unwrap_err();
+    assert!(matches!(e, ClientError::BlockNotCanonical(_)), "{e:?}");
+}
