+// pre-check, a reorg during the read, post-check: with the real BlockCache (exact-hash index)
+#[tokio::test]
+async fn reorg_during_read_refuses_at_post_check() {
+    let c = BlockCache::<Ethereum>::new(); let t = now();
+    let p = blk(9, 0, B256::ZERO, t - 4); let a = blk(10, 1, p.header.hash, t - 2); let b = blk(10, 2, p.header.hash, t - 1);
+    c.push_block(p.clone(), BlockNumberOrTag::Latest.into()).await; c.push_block(a.clone(), BlockNumberOrTag::Latest.into()).await;
+    let id = hash_id(a.header.hash, Some(true));
+    check_block_hash::<Ethereum, _>(&c, &id, now()).await.unwrap();                       // pre
+    c.push_block(b.clone(), BlockNumberOrTag::Latest.into()).await;                         // reorg A -> B while reading
+    assert!(c.get_block(id, false).await.unwrap().is_none(), "the read by A's hash finds nothing (never B)");
+    let e = check_block_hash::<Ethereum, _>(&c, &id, now()).await.unwrap_err();             // post
+    assert!(matches!(e, ClientError::BlockNotFound(_) | ClientError::BlockNotCanonical(_)), "{e:?}");
+}
+
+#[tokio::test]
+async fn aba_during_read_answers_a_and_post_check_passes() {
+    let c = BlockCache::<Ethereum>::new(); let t = now();
+    let p = blk(9, 0, B256::ZERO, t - 4); let a = blk(10, 1, p.header.hash, t - 2); let b = blk(10, 2, p.header.hash, t - 1);
+    c.push_block(p.clone(), BlockNumberOrTag::Latest.into()).await; c.push_block(a.clone(), BlockNumberOrTag::Latest.into()).await;
+    let id = hash_id(a.header.hash, Some(true));
+    check_block_hash::<Ethereum, _>(&c, &id, now()).await.unwrap();
+    c.push_block(b.clone(), BlockNumberOrTag::Latest.into()).await;
+    c.push_block(a.clone(), BlockNumberOrTag::Latest.into()).await;                         // A, B, A
+    let read = c.get_block(id, false).await.unwrap().expect("A again");
+    assert_eq!(read.header.hash, a.header.hash, "the read is A's own block");
+    check_block_hash::<Ethereum, _>(&c, &id, now()).await.unwrap();
+}
+
+// STRUCTURAL (source text, not behaviour): every BlockId-taking node method is gated before AND after its read.
+#[test]
+fn every_block_id_method_is_gated_before_and_after() {
+    let src = include_str!("../src/client/node.rs");
+    for m in ["call", "estimate_gas", "create_access_list", "get_balance", "get_nonce", "get_code", "get_storage_at",
+              "get_proof", "get_block", "get_block_receipts", "get_transaction_by_block_and_index"] {
+        let start = src.find(&format!("    async fn {m}(")).unwrap_or_else(|| panic!("{m} not found"));
+        let rest = &src[start + 10..];
+        let body = &src[start..start + 10 + rest.find("\n    async fn ").unwrap_or(rest.len())];
+        assert!(body.contains("self.check_block_id(&block"), "{m}: no pre-check");
+        assert!(body.contains("self.recheck_canonical(&block"), "{m}: no post-check");
+    }
+}
