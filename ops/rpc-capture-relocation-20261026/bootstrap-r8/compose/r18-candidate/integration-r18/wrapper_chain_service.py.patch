+def launch_phase(lock):
+    """historical-origin-segments-stage/r5, anchored mode only, under the HELD launch lock, before any coverage gate. Read-only.
+    -> ('initial', None) for armed|rearmed (the anchored first start / rearm: the r4 current-time whole coverage is required);
+       ('continuation', facts) for restart-permitted (an ordinary restart of the bootstrapped DB: the existing STOPPED-DB permit
+       proof, bound to the latest recorded finality floor, replaces the historical coverage);
+    any other journal state refuses here with nothing consumed (bootstrapped/restarted need the unattended permit; consumed needs
+    rearm at N or re-anchor; terminal states only rollback / quarantine / re-anchor)."""
+    assert lock is not None, 'anchored coverage requires the release launch (manifest baseRelease + launch lock)'
+    l_sha, launch, n = launch_record(CONFIG, BASE_RELEASE_SHA256)
+    entries = journal_entries(BOOTSTRAP_DIR / 'journal', ROOT_UID, l_sha)
