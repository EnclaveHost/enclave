+    raise AssertionError(f'anchored launch journal state {state!r}: no start (bootstrapped/restarted: the restart-permit service must '
+                         'prove the STOPPED DB first; consumed: root rearm at N or re-anchor; terminal: rollback/quarantine/re-anchor); '
+                         'nothing consumed')
+
+def continuation_gate(launch, l_sha, entries, n):
+    """The ordinary-restart eligibility of a bootstrapped DB, from records the existing proofs wrote (never from a marker, a saved
+    clock, HTTP or a unit state): the restart permit must name the LATEST recorded finality floor (launch_finality: this launch's own
+    finality-proof watermark entries), carry the floor block's timestamp taken from the hash-verified floor header, and the exact A1
+    L1 block of the floor's qualified finality entry. launch_handshake re-checks the floor and the DB identity when it consumes."""
+    own = launch_finality(launch, l_sha, entries)
+    assert own, 'no recorded finality floor for this launch: no ordinary restart'
+    permit = entries[-1][1].get('evidence') or {}
+    assert permit.get('floor') == {'entrySha256': own[-1][0], 'number': own[-1][1]['number'], 'blockHash': own[-1][1]['blockHash']}, \
+        'restart permit is not for the latest recorded finality floor: refusing'
+    ts = permit.get('floorTimestamp')
+    assert type(ts) is int and ts >= 0, \
+        f"restart permit carries no authenticated floor timestamp ({permit.get('floorTimestampUnavailable', 'absent')}): re-run permit-restart"
+    now = _now()
+    assert ts <= now + 60, 'floor block timestamp is in the future: refusing'
+    assert now - ts <= CONTINUATION_MAX_AGE, (f'floor block is {int(now - ts)} s old, beyond the {CONTINUATION_MAX_AGE} s operational '
+                                              'continuation bound: rollback / quarantine / re-anchor with fresh coverage')
+    l1 = permit.get('floorA1L1')
+    assert isinstance(l1, dict) and set(l1) == {'number', 'hash'} and type(l1['number']) is int and l1['number'] >= 0 \
+        and re.fullmatch(r'0x[0-9a-f]{64}', str(l1['hash'])), \
+        f"restart permit binds no exact A1 L1 block ({permit.get('floorA1L1Unavailable', 'absent')}): re-run permit-restart"
+    assert own[-1][1]['number'] > n, 'the recorded floor is not above the launch anchor'
+    return {'floor': permit['floor'], 'floorTimestamp': ts, 'floorA1L1': l1, 'anchorN': n}
