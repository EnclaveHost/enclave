+CONTINUATION_MAX_AGE = 7 * 86400   # r5 (root decision): OPERATIONAL availability bound for an ordinary restart of a bootstrapped
+                                   # DB (the floor block's age must leave the restart's L1 re-derivation window inside the CL blob
+                                   # retention, ~4096 epochs = 18.2 d). Not consumer freshness, not a cryptographic proof.
