diff --git a/crates/consensus/service/src/service/anchor_safedb.rs b/crates/consensus/service/src/service/anchor_safedb.rs
new file mode 100644
index 0000000..04f80b1
--- /dev/null
+++ b/crates/consensus/service/src/service/anchor_safedb.rs
@@ -0,0 +1,140 @@
+//! M10: an anchored start never keeps the snapshot's safe-head database.
+//!
+//! The derivation actor's first pipeline reset already calls `safe_head_reset(default)`, but it only
+//! LOGS a failure and continues (`actors/derivation/actor.rs`). For a bootstrap anchor that is not
+//! enough: the node wipes the database itself before any actor starts and refuses to start if the
+//! reset fails or the database still holds an entry afterwards.
+
+use alloy_eips::BlockNumHash;
+use base_consensus_safedb::{SafeDBError, SafeDBReader, SafeHeadListener, SafeHeadResponse};
+use base_protocol::L2BlockInfo;
+
+/// Why the anchored start refused to wipe the safe-head database.
+#[derive(Debug, thiserror::Error)]
+pub enum BootstrapSafeDbWipeError {
+    /// The reset itself failed.
+    #[error("safe-head database reset failed: {0}")]
+    Reset(SafeDBError),
+    /// The database could not be read back after the reset.
+    #[error("safe-head database could not be read back after the reset: {0}")]
+    Verify(SafeDBError),
+    /// An entry other than the genesis re-anchor survived the reset.
+    #[error("safe-head database still holds {0:?} after the reset")]
+    NotWiped(SafeHeadResponse),
+}
+
+/// Wipes the safe-head database for an anchored start.
+#[derive(Debug, Clone, Copy, Default)]
+pub struct BootstrapSafeDbWipe;
+
+impl BootstrapSafeDbWipe {
+    /// Resets to the all-zero safe head (deletes every entry; a real database re-anchors at L1 0),
+    /// then reads back the newest entry: it must be that re-anchor, or the database must be
+    /// disabled or empty.
+    pub async fn wipe(
+        listener: &dyn SafeHeadListener,
+        reader: &dyn SafeDBReader,
+    ) -> Result<(), BootstrapSafeDbWipeError> {
+        listener
+            .safe_head_reset(L2BlockInfo::default())
+            .await
+            .map_err(BootstrapSafeDbWipeError::Reset)?;
+        match reader.safe_head_at_l1(u64::MAX).await {
+            Err(SafeDBError::Disabled | SafeDBError::NotFound) => Ok(()),
+            Err(err) => Err(BootstrapSafeDbWipeError::Verify(err)),
+            Ok(entry)
+                if entry.l1_block == BlockNumHash::default() &&
+                    entry.safe_head == BlockNumHash::default() =>
+            {
+                Ok(())
+            }
+            Ok(entry) => Err(BootstrapSafeDbWipeError::NotWiped(entry)),
+        }
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use alloy_primitives::B256;
+    use async_trait::async_trait;
+    use base_consensus_safedb::{DisabledSafeDB, SafeDB};
+    use base_protocol::BlockInfo;
+
+    use super::*;
+
+    /// Hand-rolled: a listener whose reset FAILS and a reader that still returns a snapshot entry.
+    /// The safedb traits are foreign `async_trait`s without an automock, and these two behaviours
+    /// (a failing write, a stale read) are exactly what the wipe must refuse.
+    #[derive(Debug)]
+    struct FailingReset;
+
+    #[async_trait]
+    impl SafeHeadListener for FailingReset {
+        async fn safe_head_updated(&self, _: L2BlockInfo, _: BlockInfo) -> Result<(), SafeDBError> {
+            Ok(())
+        }
+        async fn safe_head_reset(&self, _: L2BlockInfo) -> Result<(), SafeDBError> {
+            Err(SafeDBError::Database("disk full".to_string()))
+        }
+    }
+
+    #[derive(Debug)]
+    struct StaleReader;
+
+    #[async_trait]
+    impl SafeDBReader for StaleReader {
+        async fn safe_head_at_l1(&self, _: u64) -> Result<SafeHeadResponse, SafeDBError> {
+            Ok(snapshot_entry())
+        }
+    }
+
+    const L1: u64 = 21_000_600;
+    const L2: u64 = 53_048_526;
+
+    fn snapshot_entry() -> SafeHeadResponse {
+        SafeHeadResponse {
+            l1_block: BlockNumHash { number: L1, hash: B256::repeat_byte(0x11) },
+            safe_head: BlockNumHash { number: L2, hash: B256::repeat_byte(0x22) },
+        }
+    }
+
+    fn snapshot_safe_head() -> (L2BlockInfo, BlockInfo) {
+        let safe = L2BlockInfo {
+            block_info: BlockInfo { hash: B256::repeat_byte(0x22), number: L2, parent_hash: B256::repeat_byte(0x21), timestamp: L2 },
+            l1_origin: BlockNumHash { number: L1 - 100, hash: B256::repeat_byte(0x10) },
+            seq_num: 0,
+        };
+        let l1 = BlockInfo { hash: B256::repeat_byte(0x11), number: L1, parent_hash: B256::repeat_byte(0x12), timestamp: L1 };
+        (safe, l1)
+    }
+
+    #[tokio::test]
+    async fn real_redb_wipe_removes_snapshot_entries_persistently() {
+        let dir = tempfile::tempdir().unwrap();
+        let path = dir.path().join("safedb.redb");
+        let db = SafeDB::open(&path).unwrap();
+        let (safe, l1) = snapshot_safe_head();
+        db.safe_head_updated(safe, l1).await.unwrap();
+        assert_eq!(db.safe_head_at_l1(u64::MAX).await.unwrap(), snapshot_entry(), "fixture is in the real database");
+
+        BootstrapSafeDbWipe::wipe(&db, &db).await.unwrap();
+        let after = db.safe_head_at_l1(u64::MAX).await.unwrap();
+        assert_eq!((after.l1_block, after.safe_head), (BlockNumHash::default(), BlockNumHash::default()));
+        drop(db);
+        let reopened = SafeDB::open(&path).unwrap();
+        assert_eq!(reopened.safe_head_at_l1(L1).await.unwrap().safe_head, BlockNumHash::default(), "the wipe is on disk");
+    }
+
+    #[tokio::test]
+    async fn a_failing_reset_is_fatal() {
+        let err = BootstrapSafeDbWipe::wipe(&FailingReset, &DisabledSafeDB).await.unwrap_err();
+        assert!(matches!(err, BootstrapSafeDbWipeError::Reset(SafeDBError::Database(_))), "{err}");
+    }
+
+    #[tokio::test]
+    async fn a_surviving_entry_is_refused_and_disabled_is_accepted() {
+        let err = BootstrapSafeDbWipe::wipe(&DisabledSafeDB, &StaleReader).await.unwrap_err();
+        assert!(matches!(err, BootstrapSafeDbWipeError::NotWiped(e) if e == snapshot_entry()), "{err}");
+        BootstrapSafeDbWipe::wipe(&DisabledSafeDB, &DisabledSafeDB).await.unwrap();
+    }
+}
