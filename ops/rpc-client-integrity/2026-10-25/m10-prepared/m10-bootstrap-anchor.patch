+            Arc::clone(&client),
+            Arc::new(anchor_test_rollup_config()),
+            MockEngineDerivationClient::new(),
+            engine,
+        )
+        .with_bootstrap_anchor(Some(anchor));
+        let (_request_tx, request_rx) = mpsc::channel(1);
+        let result = ValidatorEngineRequestHandler::new(processor).start(request_rx).await.expect("no panic");
+        assert!(
+            matches!(result, Err(EngineError::EngineReset(EngineResetError::SyncStart(SyncStartError::BootstrapAnchorHeadMismatch { .. })))),
+            "{result:?}"
+        );
