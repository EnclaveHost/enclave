diff --git a/crates/consensus/engine/src/sync/anchor.rs b/crates/consensus/engine/src/sync/anchor.rs
new file mode 100644
index 0000000..ccdd986
--- /dev/null
+++ b/crates/consensus/engine/src/sync/anchor.rs
@@ -0,0 +1,298 @@
+//! M10: an explicit, opt-in bootstrap anchor for the sync start.
+//!
+//! A [`BootstrapAnchor`] is a block (number, hash) that an EXTERNAL, config-bound launcher has
+//! already authenticated before starting this node: an L1-finalized anchor output root read with
+//! proofs, header N reproducing that output root, the execution database unwound OFFLINE to
+//! exactly N, and a full state rebuild verified at N. **The anchor value itself is not a proof**:
+//! this module only refuses to start unless the execution layer agrees with it exactly, and then
+//! starts derivation with safe = finalized = N instead of the execution layer's persisted labels.
+//!
+//! Without an anchor nothing here runs, and the default sync start is unchanged.
+
+use core::{fmt, str::FromStr};
+
+use alloy_eips::{BlockNumHash, BlockNumberOrTag};
+use alloy_primitives::B256;
+use base_common_genesis::RollupConfig;
+use base_protocol::L2BlockInfo;
+
+use super::{L2ForkchoiceState, SyncStartError, forkchoice::get_block_compat};
+use crate::EngineClient;
+
+/// An L2 block the operator's verified bootstrap pinned: `<number>:0x<32-byte hash>`.
+#[derive(Debug, Clone, Copy, PartialEq, Eq)]
+pub struct BootstrapAnchor {
+    /// The anchor block number.
+    pub number: u64,
+    /// The anchor block hash.
+    pub hash: B256,
+}
+
+impl BootstrapAnchor {
+    /// The anchor as a [`BlockNumHash`].
+    pub const fn num_hash(&self) -> BlockNumHash {
+        BlockNumHash { number: self.number, hash: self.hash }
+    }
+}
+
+impl fmt::Display for BootstrapAnchor {
+    fn fmt(&self, f: &mut fmt::Formatter<'_>) -> fmt::Result {
+        write!(f, "{}:{}", self.number, self.hash)
+    }
+}
+
+/// Why a `--bootstrap.anchor` value was refused.
+#[derive(Debug, Clone, PartialEq, Eq, thiserror::Error)]
+pub enum BootstrapAnchorParseError {
+    /// The value is not `<number>:0x<64 hex>`.
+    #[error("bootstrap anchor must be <number>:0x<64 hex chars>")]
+    Format,
+    /// The genesis block cannot be a bootstrap anchor.
+    #[error("bootstrap anchor number must be above genesis (0)")]
+    Genesis,
+    /// The zero hash is never a block hash.
+    #[error("bootstrap anchor hash must not be zero")]
+    ZeroHash,
+}
+
+impl FromStr for BootstrapAnchor {
+    type Err = BootstrapAnchorParseError;
+
+    fn from_str(s: &str) -> Result<Self, Self::Err> {
+        let (n, h) = s.split_once(':').ok_or(BootstrapAnchorParseError::Format)?;
+        if n.is_empty() || !n.bytes().all(|b| b.is_ascii_digit()) || (n.len() > 1 && n.starts_with('0')) {
+            return Err(BootstrapAnchorParseError::Format);
+        }
+        let number = n.parse::<u64>().map_err(|_| BootstrapAnchorParseError::Format)?;
+        let hex = h.strip_prefix("0x").ok_or(BootstrapAnchorParseError::Format)?;
+        if hex.len() != 64 || !hex.bytes().all(|b| b.is_ascii_hexdigit()) {
+            return Err(BootstrapAnchorParseError::Format);
+        }
+        let hash = B256::from_str(hex).map_err(|_| BootstrapAnchorParseError::Format)?;
+        if number == 0 {
+            return Err(BootstrapAnchorParseError::Genesis);
+        }
+        if hash.is_zero() {
+            return Err(BootstrapAnchorParseError::ZeroHash);
+        }
+        Ok(Self { number, hash })
+    }
+}
+
+impl BootstrapAnchor {
+    /// Converts the execution layer's block at `tag` to an [`L2BlockInfo`]. The hash is RECOMPUTED
+    /// from the header (`from_block_and_genesis` seals it), never taken from the RPC `hash` field.
+    async fn execution_block_info<EngineClient_: EngineClient>(
+        cfg: &RollupConfig,
+        engine_client: &EngineClient_,
+        tag: BlockNumberOrTag,
+    ) -> Result<Option<L2BlockInfo>, SyncStartError> {
+        let Some(rpc_block) = get_block_compat(engine_client, tag.into()).await? else {
+            return Ok(None);
+        };
+        Ok(Some(L2BlockInfo::from_block_and_genesis(
+            &rpc_block
+                .map_header(|header| header.into_inner())
+                .into_consensus()
+                .map_transactions(|tx| tx.inner.inner.into_inner()),
+            &cfg.genesis,
+        )?))
+    }
+
+    /// The OFFLINE precondition, checked once at startup BEFORE anything is sent to the execution
+    /// layer: its head is exactly the anchor (number and recomputed hash), and its persisted finalized
+    /// and safe labels are not above the anchor (an offline `reth stage unwind --to-block N` lowers
+    /// them; a value above N means the database was not unwound, and the node refuses to start).
+    pub async fn verify_execution_head<EngineClient_: EngineClient>(
+        self,
+        cfg: &RollupConfig,
+        engine_client: &EngineClient_,
+    ) -> Result<L2BlockInfo, SyncStartError> {
+        let head = Self::execution_block_info(cfg, engine_client, BlockNumberOrTag::Latest)
+            .await?
+            .ok_or(SyncStartError::BlockNotFound(BlockNumberOrTag::Latest.into()))?;
+        if head.block_info.id() != self.num_hash() {
+            return Err(SyncStartError::BootstrapAnchorHeadMismatch {
+                anchor: self.num_hash(),
+                head: head.block_info.id(),
+            });
+        }
+        for (label, tag) in [("finalized", BlockNumberOrTag::Finalized), ("safe", BlockNumberOrTag::Safe)] {
+            // Only the NUMBER of a persisted label is judged: an absent label is fine, a label above N
+            // refuses. Labels at or below N are ignored by the anchored start (it never reads them).
+            if let Some(block) = get_block_compat(engine_client, tag.into()).await? &&
+                block.header.number > self.number
+            {
+                return Err(SyncStartError::BootstrapAnchorLabelAhead {
+                    label,
+                    number: block.header.number,
+                    anchor: self.number,
+                });
+            }
+        }
+        Ok(head)
+    }
+
+    /// The anchored starting forkchoice, used by the FIRST reset only: block N must still be canonical
+    /// with the anchor hash (the execution layer may have executed descendants since startup), and the
+    /// result is unsafe = the current head (at or above N), safe = finalized = N.
+    pub async fn starting_forkchoice<EngineClient_: EngineClient>(
+        self,
+        cfg: &RollupConfig,
+        engine_client: &EngineClient_,
+    ) -> Result<L2ForkchoiceState, SyncStartError> {
+        let at_n = Self::execution_block_info(cfg, engine_client, BlockNumberOrTag::Number(self.number)).await?;
+        let Some(at_n) = at_n.filter(|info| info.block_info.id() == self.num_hash()) else {
+            return Err(SyncStartError::BootstrapAnchorNotCanonical { anchor: self.num_hash() });
+        };
+        let head = Self::execution_block_info(cfg, engine_client, BlockNumberOrTag::Latest)
+            .await?
+            .ok_or(SyncStartError::BlockNotFound(BlockNumberOrTag::Latest.into()))?;
+        if head.block_info.number < self.number {
+            return Err(SyncStartError::BootstrapAnchorHeadMismatch {
+                anchor: self.num_hash(),
+                head: head.block_info.id(),
+            });
+        }
+        Ok(L2ForkchoiceState { un_safe: head, safe: at_n, finalized: at_n })
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use alloy_eips::{BlockId, BlockNumberOrTag};
+    use alloy_primitives::B256;
+
+    use super::*;
+    use crate::test_utils::{
+        ANCHOR_TEST_L1_ORIGIN, MockL2BlockError, anchor_test_block as block,
+        anchor_test_block_hash as hash_of, anchor_test_rollup_config as cfg,
+        test_engine_client_builder,
+    };
+
+    const N: u64 = 52_746_000;
+
+    #[test]
+    fn parse_accepts_only_number_colon_hash() {
+        let h = "0x".to_string() + &"ab".repeat(32);
+        let a: BootstrapAnchor = format!("{N}:{h}").parse().unwrap();
+        assert_eq!(a.number, N);
+        assert_eq!(a.to_string(), format!("{N}:{h}"));
+        for bad in ["", "52746000", ":0xab", "52746000:ab", "52746000:0x12", "-1:0x00", "052746000:0xab", "5e7:0xab", " 1:0xab"] {
+            assert_eq!(bad.parse::<BootstrapAnchor>(), Err(BootstrapAnchorParseError::Format), "{bad}");
+        }
+        assert_eq!(format!("{N}:0x{}", "zz".repeat(32)).parse::<BootstrapAnchor>(), Err(BootstrapAnchorParseError::Format));
+        assert_eq!(format!("0:{h}").parse::<BootstrapAnchor>(), Err(BootstrapAnchorParseError::Genesis));
+        assert_eq!(format!("{N}:0x{}", "00".repeat(32)).parse::<BootstrapAnchor>(), Err(BootstrapAnchorParseError::ZeroHash));
+    }
+
+    #[tokio::test]
+    async fn precondition_accepts_head_exactly_n_with_labels_at_or_below_n() {
+        let head = block(N, B256::repeat_byte(1));
+        let anchor = BootstrapAnchor { number: N, hash: hash_of(&head) };
+        let client = test_engine_client_builder()
+            .with_l2_block(BlockId::Number(BlockNumberOrTag::Latest), head)
+            .with_l2_block(BlockId::Number(BlockNumberOrTag::Finalized), block(N - 10, B256::repeat_byte(2)))
+            .build();
+        let info = anchor.verify_execution_head(&cfg(), &client).await.unwrap();
+        assert_eq!(info.block_info.id(), anchor.num_hash());
+        assert_eq!(info.l1_origin, ANCHOR_TEST_L1_ORIGIN);
+        // no persisted labels at all is also accepted (nothing above N)
+        let client = test_engine_client_builder()
+            .with_l2_block(BlockId::Number(BlockNumberOrTag::Latest), block(N, B256::repeat_byte(1)))
+            .build();
+        anchor.verify_execution_head(&cfg(), &client).await.unwrap();
+    }
+
+    #[tokio::test]
+    async fn precondition_refuses_wrong_number_wrong_hash_and_rpc_claimed_hash() {
+        let head = block(N, B256::repeat_byte(1));
+        let good = hash_of(&head);
+        // wrong number: the EL head is N+1 (not unwound to N)
+        let client = test_engine_client_builder()
+            .with_l2_block(BlockId::Number(BlockNumberOrTag::Latest), block(N + 1, good))
+            .build();
+        let e = BootstrapAnchor { number: N, hash: good }.verify_execution_head(&cfg(), &client).await.unwrap_err();
+        assert!(matches!(e, SyncStartError::BootstrapAnchorHeadMismatch { .. }), "{e}");
+        // wrong hash at the right height
+        let client = test_engine_client_builder()
+            .with_l2_block(BlockId::Number(BlockNumberOrTag::Latest), head.clone())
+            .build();
+        let e = BootstrapAnchor { number: N, hash: B256::repeat_byte(9) }.verify_execution_head(&cfg(), &client).await.unwrap_err();
+        assert!(matches!(e, SyncStartError::BootstrapAnchorHeadMismatch { .. }), "{e}");
+        // the RPC `hash` field is a claim: a block whose claimed hash is the anchor but whose header differs refuses
+        let mut lying = block(N, B256::repeat_byte(7));
+        lying.header.hash = good;
+        let client = test_engine_client_builder()
+            .with_l2_block(BlockId::Number(BlockNumberOrTag::Latest), lying)
+            .build();
+        let e = BootstrapAnchor { number: N, hash: good }.verify_execution_head(&cfg(), &client).await.unwrap_err();
+        assert!(matches!(e, SyncStartError::BootstrapAnchorHeadMismatch { .. }), "{e}");
+    }
+
+    #[tokio::test]
+    async fn precondition_refuses_replayed_snapshot_labels_above_n() {
+        let head = block(N, B256::repeat_byte(1));
+        let anchor = BootstrapAnchor { number: N, hash: hash_of(&head) };
+        for tag in [BlockNumberOrTag::Finalized, BlockNumberOrTag::Safe] {
+            let client = test_engine_client_builder()
+                .with_l2_block(BlockId::Number(BlockNumberOrTag::Latest), head.clone())
+                .with_l2_block(BlockId::Number(tag), block(N + 302_526, B256::repeat_byte(3)))
+                .build();
+            let e = anchor.verify_execution_head(&cfg(), &client).await.unwrap_err();
+            assert!(matches!(e, SyncStartError::BootstrapAnchorLabelAhead { number, anchor: a, .. } if number == N + 302_526 && a == N), "{tag:?}: {e}");
+        }
+    }
+
+    #[tokio::test]
+    async fn precondition_propagates_execution_layer_errors() {
+        let client = test_engine_client_builder()
+            .with_l2_block_error(
+                BlockId::Number(BlockNumberOrTag::Latest),
+                MockL2BlockError::Custom("connection refused".to_string()),
+            )
+            .build();
+        let e = BootstrapAnchor { number: N, hash: B256::repeat_byte(1) }.verify_execution_head(&cfg(), &client)
+            .await
+            .unwrap_err();
+        assert!(matches!(e, SyncStartError::RpcError(_)), "{e}");
+        // no head at all
+        let client = test_engine_client_builder().build();
+        let e = BootstrapAnchor { number: N, hash: B256::repeat_byte(1) }.verify_execution_head(&cfg(), &client)
+            .await
+            .unwrap_err();
+        assert!(matches!(e, SyncStartError::BlockNotFound(_)), "{e}");
+    }
+
+    #[tokio::test]
+    async fn anchored_forkchoice_is_head_over_n_and_requires_n_canonical() {
+        let at_n = block(N, B256::repeat_byte(1));
+        let anchor = BootstrapAnchor { number: N, hash: hash_of(&at_n) };
+        let head = block(N + 40, B256::repeat_byte(4));
+        let client = test_engine_client_builder()
+            .with_l2_block(BlockId::Number(BlockNumberOrTag::Number(N)), at_n.clone())
+            .with_l2_block(BlockId::Number(BlockNumberOrTag::Latest), head.clone())
+            // a replayed finalized label is never read by the anchored start
+            .with_l2_block(BlockId::Number(BlockNumberOrTag::Finalized), block(N + 39, B256::repeat_byte(5)))
+            .build();
+        let fc = anchor.starting_forkchoice(&cfg(), &client).await.unwrap();
+        assert_eq!(fc.safe.block_info.id(), anchor.num_hash());
+        assert_eq!(fc.finalized, fc.safe);
+        assert_eq!(fc.un_safe.block_info.number, N + 40);
+        assert_eq!(fc.un_safe.block_info.hash, hash_of(&head));
+        // N reorged away (another block at N) or missing: refuse
+        let client = test_engine_client_builder()
+            .with_l2_block(BlockId::Number(BlockNumberOrTag::Number(N)), block(N, B256::repeat_byte(8)))
+            .with_l2_block(BlockId::Number(BlockNumberOrTag::Latest), head.clone())
+            .build();
+        assert!(matches!(anchor.starting_forkchoice(&cfg(), &client).await, Err(SyncStartError::BootstrapAnchorNotCanonical { .. })));
+        let client = test_engine_client_builder().with_l2_block(BlockId::Number(BlockNumberOrTag::Latest), head).build();
+        assert!(matches!(anchor.starting_forkchoice(&cfg(), &client).await, Err(SyncStartError::BootstrapAnchorNotCanonical { .. })));
+        // a head below N refuses
+        let client = test_engine_client_builder()
+            .with_l2_block(BlockId::Number(BlockNumberOrTag::Number(N)), at_n)
+            .with_l2_block(BlockId::Number(BlockNumberOrTag::Latest), block(N - 1, B256::repeat_byte(6)))
+            .build();
+        assert!(matches!(anchor.starting_forkchoice(&cfg(), &client).await, Err(SyncStartError::BootstrapAnchorHeadMismatch { .. })));
+    }
+}
