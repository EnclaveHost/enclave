+//! L2 RPC blocks carrying an L1-info deposit, for bootstrap-anchor tests.
+
+use alloy_consensus::transaction::Recovered;
+use alloy_eips::BlockNumHash;
+use alloy_primitives::{Address, B256, Sealed, b256};
+use alloy_rpc_types_eth::{Block as RpcBlock, BlockTransactions};
+use base_common_consensus::{BaseTxEnvelope, TxDeposit};
+use base_common_genesis::{ChainGenesis, RollupConfig};
+use base_common_rpc_types::Transaction as BaseTransaction;
+use base_protocol::L1BlockInfoBedrock;
+
+/// The L1 origin every [`anchor_test_block`] names in its L1-info deposit.
+pub const ANCHOR_TEST_L1_ORIGIN: BlockNumHash = BlockNumHash {
+    number: 21_000_500,
+    hash: b256!("3db6be2b3db6be2b3db6be2b3db6be2b3db6be2b3db6be2b3db6be2b3db6be2b"),
+};
+
+/// A rollup config whose L2 genesis is distinct from every test block.
+pub fn anchor_test_rollup_config() -> RollupConfig {
+    RollupConfig {
+        genesis: ChainGenesis {
+            l2: BlockNumHash {
+                number: 0,
+                hash: b256!("2222222222222222222222222222222222222222222222222222222222222222"),
+            },
+            ..Default::default()
+        },
+        ..Default::default()
+    }
+}
+
+/// An L2 RPC block at `number` with `parent_hash` whose first transaction is a Bedrock L1-info
+/// deposit naming [`ANCHOR_TEST_L1_ORIGIN`]. Different parents give different block hashes.
+pub fn anchor_test_block(number: u64, parent_hash: B256) -> RpcBlock<BaseTransaction> {
+    let envelope = BaseTxEnvelope::Deposit(Sealed::new_unchecked(
+        TxDeposit {
+            input: L1BlockInfoBedrock::new_from_number_and_block_hash(
+                ANCHOR_TEST_L1_ORIGIN.number,
+                ANCHOR_TEST_L1_ORIGIN.hash,
+            )
+            .encode_calldata(),
+            ..Default::default()
+        },
+        B256::ZERO,
+    ));
+    let deposit = BaseTransaction {
+        inner: alloy_rpc_types_eth::Transaction {
+            inner: Recovered::new_unchecked(envelope, Address::ZERO),
+            block_hash: None,
+            block_number: Some(number),
+            block_timestamp: None,
+            effective_gas_price: Some(0),
+            transaction_index: Some(0),
+        },
+        block_timestamp_ms: None,
+        deposit_nonce: None,
+        deposit_receipt_version: None,
+    };
+    let mut block = RpcBlock::<BaseTransaction>::default();
+    block.header.inner.number = number;
+    block.header.inner.parent_hash = parent_hash;
+    block.header.inner.timestamp = number;
+    block.transactions = BlockTransactions::Full(vec![deposit]);
+    block
+}
+
+/// The block hash RECOMPUTED from the header (what the anchor checks compare), not the RPC field.
+pub fn anchor_test_block_hash(block: &RpcBlock<BaseTransaction>) -> B256 {
+    block.clone().into_consensus().hash_slow()
+}
