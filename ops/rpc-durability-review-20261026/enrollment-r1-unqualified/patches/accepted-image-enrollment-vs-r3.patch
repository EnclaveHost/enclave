+  });
+  proc.on("disconnect", () => { fence("IPC channel closed"); if (pending) settle(pending, fail("derived_commit_fenced", "IPC channel closed")); });
+  function once(t, what, body, accept, value, signal) {
+    if (fenced) return Promise.reject(fail("derived_commit_fenced", `derived state requests are fenced (${fenced})`));
+    if (signal?.aborted) return Promise.reject(fail("derived_commit_aborted", "aborted before it was sent"));
