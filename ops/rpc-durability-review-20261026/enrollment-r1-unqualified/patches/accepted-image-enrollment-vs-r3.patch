+    if (!m || (m.t !== "derived-commit" && m.t !== "derived-enroll-verify")) return;
+    if (!pending || m.t !== pending.t || m.id !== pending.id) { late++; return; }   // unknown, duplicate or late: never resolves anything
+    const p = pending;
+    if (m.v === 1 && m.boot === boot && m.ok === true && p.accept(m)) { committed += p.t === "derived-commit" ? 1 : 0; return settle(p, null, p.value(m)); }
+    fence(m.ok === false ? `refused: ${String(m.error || "unknown").slice(0, 40)}` : "mismatched reply");
