+export const COMMIT_PROTOCOL = "enclave-derived-commit/v1";
+export const STATE_REL = /^(reader|bridge)\/[a-z0-9][a-z0-9.-]{0,63}\.json$/;
+export const MAX_STATE_BYTES = 1 << 20;
+const BOOT = /^[0-9a-f]{32}$/, HEX64 = /^[0-9a-f]{64}$/;
