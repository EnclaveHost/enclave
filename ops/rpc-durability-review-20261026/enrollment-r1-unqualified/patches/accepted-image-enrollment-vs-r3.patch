+  p.emit("message", { t: "derived-commit", v: 1, boot: BOOT, id: 1, ok: true, sha256: s, head: { epoch: 1, seq: 2 } });
+  assert.equal(await one, true); await sleep(10); assert.equal(p.sent.length, 2);
