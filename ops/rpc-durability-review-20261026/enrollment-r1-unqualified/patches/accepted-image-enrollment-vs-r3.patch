+// The platform-api role's side of the derived reader's DURABLE state (logs/derived-state-ipc-contract.md). Role-owned only:
+// KVM's reader/bridge journals (network/derived-reader/*, network/deployment-lifecycle-journal.mjs) are not touched here.
+//   * an admin ENROLLMENT in the replicated, sealed data directory: data/derived-authority/enrollment.json, an existing
+//     platform-api package (kind "derived-enroll", EIP-191 by one of platformApi.admins, bound to the group and the
+//     primary's boot), chained by previousDigest; modes genesis | rotate | recover (no reset);
+//   * the durable journal copies: data/derived-authority/state/<rel>, written ONLY by the role after the relay child asks
+//     over the private IPC channel (enclave-derived-commit/v1) and only acknowledged after the replica majority commit;
+//   * the RAM seed at each relay start: the committed copies into the reader's state directory, and a descriptor
+//     (enclave-derived-state/v1) for the relay. Nothing is initialized, reseeded or repaired automatically.
+// Durability is crash-fault replication over the configured members; co-located members are NOT distinct hosts and no
+// quorum claim is made for them. Nothing here makes writes authorized (the writer's fixed 120 s ceiling is unchanged).
+import fs from "node:fs";
+import path from "node:path";
+import { createHash } from "node:crypto";
+
+export const DERIVED_DIR = "derived-authority";
+export const ENROLL_FILE = `${DERIVED_DIR}/enrollment.json`;
+export const MARKER_FILE = `${DERIVED_DIR}/recovered.json`;
+export const STATE_DIR = `${DERIVED_DIR}/state`;
+export const ENROLL_KIND = "derived-enroll";
+export const ENROLL_PATH = "/platform-api/derived-enroll";
+export const ENROLLMENT_FORMAT = "enclave-derived-enrollment/v1";
+export const STATE_FORMAT = "enclave-derived-state/v1";
+export const COMMIT_PROTOCOL = "enclave-derived-commit/v1";
+export const MODES = Object.freeze(["genesis", "rotate", "recover"]);
+export const STATE_REL = /^(reader|bridge)\/[a-z0-9][a-z0-9.-]{0,63}\.json$/;      // = relay/derived-state-commit.mjs
+export const MAX_STATE_BYTES = 1 << 20, MAX_STATE_FILES = 8;
+export const DURABILITY = "crash-fault replication over the configured platformApi members; distinct hosts NOT proven (co-located members count as separate votes); no SNP-persistent counter";
+const HEX64 = /^[0-9a-f]{64}$/, HASH = /^0x[0-9a-f]{64}$/;
+const sha = (b) => createHash("sha256").update(b).digest("hex");
+const refusal = (status, error, message) => ({ status, error, message });
+function canonicalJson(v) {
+  if (v === null || typeof v === "boolean" || typeof v === "string") return JSON.stringify(v);
+  if (typeof v === "number") { if (!Number.isFinite(v)) throw new Error("canonical JSON: non-finite number"); return JSON.stringify(v); }
+  if (Array.isArray(v)) return `[${v.map(canonicalJson).join(",")}]`;
+  if (typeof v === "object") return `{${Object.keys(v).sort().map((k) => `${JSON.stringify(k)}:${canonicalJson(v[k])}`).join(",")}}`;
+  throw new Error(`canonical JSON cannot carry ${typeof v}`);
+}
+export const packageDigest = (pkg) => sha(canonicalJson(pkg));
+/** the floor an enrollment approves: sha256(canonicalJson(floor)), floor null for a genesis */
+export const floorDigestOf = (floor) => sha(canonicalJson(floor ?? null));
+export const RESULT_FORMAT = "enclave-derived-enrollment-result/v1";
+
+/** the measured image's reader pins: sha256 of the installed record's exact bytes (template, native, Helios, checkpoint, glibc, roleEnv) */
+export function readerPinsOf(imageFile) { try { return sha(fs.readFileSync(imageFile)); } catch { return null; } }
+/** the committed durable files: { rel: sha256 } (sorted), and its digest */
+export function stateManifest(dataDir) {
+  const root = path.join(dataDir, STATE_DIR), out = {};
+  const walk = (rel) => {
+    let es; try { es = fs.readdirSync(path.join(root, rel), { withFileTypes: true }); } catch { return; }
+    for (const e of es) {
+      const r = rel ? `${rel}/${e.name}` : e.name;
+      if (e.name.endsWith(".tmp")) continue;
+      if (e.isDirectory()) walk(r); else if (e.isFile()) out[r] = sha(fs.readFileSync(path.join(root, r)));
+    }
+  };
+  walk("");
+  return Object.fromEntries(Object.entries(out).sort(([x], [y]) => (x < y ? -1 : 1)));
+}
+export const stateDigestOf = (manifest) => (Object.keys(manifest).length ? sha(canonicalJson(manifest)) : null);
+const readJson = (f) => { try { return { bytes: fs.readFileSync(f) }; } catch (e) { return e.code === "ENOENT" ? null : { error: e.message }; } };
+function writeAtomic(file, bytes) {
+  fs.mkdirSync(path.dirname(file), { recursive: true, mode: 0o700 });
+  fs.writeFileSync(file + ".tmp", bytes, { mode: 0o600 }); fs.renameSync(file + ".tmp", file);
+}
+function validAnchor(a) {
+  return !!a && typeof a === "object" && ["l1-finalized-derived", "l1-finalized-asr-anchor"].includes(a.tier) &&
+    [a.base, a.l1].every((b) => b && Number.isSafeInteger(b.number) && b.number >= 0 && Number.isSafeInteger(b.timestamp) && HASH.test(b.hash) && HASH.test(b.stateRoot)) &&
+    HASH.test(a.base.outputRoot);
+}
+/** the held enrollment, its marker and the state, as read now (no signature check: see verifyHeld) */
+export function heldState(dataDir) {
+  const e = readJson(path.join(dataDir, ENROLL_FILE)), m = readJson(path.join(dataDir, MARKER_FILE));
+  let record = null, error = null;
+  if (e?.error || m?.error) error = "unreadable derived-authority state";
+  else if (e) { try { record = JSON.parse(e.bytes.toString("utf8")); } catch { error = "enrollment.json is not JSON"; } }
