+export function createDerivedCommitter({ boot, proc = process, timeoutMs = 10000 } = {}) {
+  if (!BOOT.test(String(boot || ""))) throw fail("derived_commit_config", "the role's commit boot id is missing or malformed");
+  if (typeof proc?.send !== "function" || typeof proc.on !== "function") throw fail("derived_commit_config", "no private IPC channel to the platform-api role");
+  if (!Number.isInteger(timeoutMs) || timeoutMs < 1 || timeoutMs > 120000) throw fail("derived_commit_config", "invalid commit deadline");
+  let nextId = 0, fenced = null, chain = Promise.resolve(), pending = null, late = 0, committed = 0;
+  const fence = (why) => { if (!fenced) fenced = why; };
+  const settle = (p, err, value) => { if (pending === p) pending = null; clearTimeout(p.timer); p.signal?.removeEventListener("abort", p.onAbort); err ? p.reject(err) : p.resolve(value); };
