+}
+
+/**
+ * The package rules (pure; the signer is checked by the caller with packageSigner):
+ * -> { ok: true, record } or a refusal { status, error, message }. `held` = heldState(dataDir).
+ */
+export function checkEnrollment(pkg, { held, groupId, statementSha, readerPins }) {
+  if (pkg.kind !== ENROLL_KIND || pkg.groupId !== groupId || pkg.targetStatementSha256 !== statementSha) return refusal(403, "wrong_target");
+  const allowed = ["format", "kind", "groupId", "targetStatementSha256", "at", "mode", "readerPins", "binding", "floorDigest", "previousDigest", "stateDigest", "markerDigest", "highWater", "signature"];
+  if (Object.keys(pkg).some((k) => !allowed.includes(k)) || allowed.some((k) => !(k in pkg))) return refusal(422, "bad_enrollment", `fields: exactly ${allowed.join(", ")}`);
+  if (!MODES.includes(pkg.mode)) return refusal(422, "bad_enrollment", "mode must be genesis, rotate or recover (there is no reset)");
+  // binding: the reader binding KVM computes for this image (its enrollDerivedState compares it); floorDigest: the exact floor
+  if (!HEX64.test(String(pkg.binding)) || !HEX64.test(String(pkg.floorDigest))) return refusal(422, "bad_enrollment", "binding and floorDigest must be sha256 hex");
+  if (held.error) return refusal(409, "held_state_unreadable", held.error);
+  if (!readerPins || pkg.readerPins !== readerPins) return refusal(409, "reader_pins", "readerPins is not this image's derived reader record");
+  const heldAt = held.record?.package?.at ?? 0;
+  if (!Number.isSafeInteger(pkg.at) || pkg.at <= heldAt) return refusal(409, "not_newer", "the enrollment is not newer than the group's (a replayed or out-of-order package)");
+  if (pkg.previousDigest !== held.digest) return refusal(409, "wrong_previous", "previousDigest is not the group's current enrollment");
+  if (pkg.stateDigest !== held.stateDigest) return refusal(409, "wrong_state", "stateDigest is not the group's committed derived state");
+  if (pkg.markerDigest !== held.markerDigest && pkg.mode !== "recover") return refusal(409, "wrong_marker", "the group was restored from an archive: only a recover enrollment applies");
+  if (pkg.mode === "genesis") {
+    if (held.record || held.stateDigest !== null || held.markerDigest !== null) return refusal(409, "not_genesis", "genesis only for a group with no enrollment, no derived state and no restore");
+    if (pkg.highWater !== null || pkg.floorDigest !== floorDigestOf(null)) return refusal(422, "bad_enrollment", "genesis carries no high-water and the null floor");
+  }
+  if (pkg.mode === "rotate") {
+    if (!held.record) return refusal(409, "not_enrolled", "rotate needs a held enrollment");
+    // a rotate never clears a pending restore: only `recover` (with the admin's high-water) does
+    if (held.record.package.markerDigest !== held.markerDigest) return refusal(409, "wrong_marker", "the group was restored from an archive: only a recover enrollment applies");
+    if (pkg.highWater !== null) return refusal(422, "bad_enrollment", "rotate carries the committed floor, not a high-water");
+  }
+  if (pkg.mode === "recover") {
+    if (!held.markerDigest || pkg.markerDigest !== held.markerDigest) return refusal(409, "not_restored", "recover only after an admin state restore, naming its marker");
+    // an archive alone is not freshness: a previously enrolled group needs the admin's retained, reviewed high-water anchor
+    if (held.record ? !validAnchor(pkg.highWater) : pkg.highWater !== null && !validAnchor(pkg.highWater))
+      return refusal(422, "high_water", "recover of an enrolled group needs the admin-retained high-water anchor (the archive is not proof of freshness)");
+    if (pkg.floorDigest !== floorDigestOf(pkg.highWater)) return refusal(422, "bad_enrollment", "a recover's floorDigest is its high-water's");
+  }
+  return { ok: true, record: { format: ENROLLMENT_FORMAT, package: pkg, previousReaderPins: held.record?.package?.readerPins ?? null } };
+}
+
+/**
+ * Is the held enrollment usable for THIS image now? (signature re-checked by the caller) -> { ok, reason }
+ * The gate the role applies before it gives the relay any derived name.
+ */
+export function gateEnrollment(held, { groupId, readerPins }) {
+  if (held.error) return { ok: false, reason: held.error };
+  if (!held.record) return { ok: false, reason: "derived_reader_unenrolled" };
+  const p = held.record.package;
+  if (p.groupId !== groupId) return { ok: false, reason: "enrollment of another group" };
+  if (!readerPins || p.readerPins !== readerPins) return { ok: false, reason: "enrollment is for another reader image (a rotate enrollment is needed)" };
+  if (held.markerDigest !== p.markerDigest) return { ok: false, reason: "the state was restored from an archive: a recover enrollment with the admin high-water is needed" };
+  if (Object.keys(held.manifest).length > MAX_STATE_FILES || Object.keys(held.manifest).some((r) => !STATE_REL.test(r))) return { ok: false, reason: "unexpected derived state files" };
+  return { ok: true };
+}
+
+/** where a durable file's RAM working copy lives */
+export function ramPathOf(stateDir, rel) {
+  if (!STATE_REL.test(rel)) throw new Error(`not a derived state file: ${rel}`);
+  if (rel === "bridge/anchor-journal.json") return path.join(stateDir, "anchor-journal.json");      // the image roleEnv path (unchanged)
+  return rel.startsWith("reader/") ? path.join(stateDir, "journal", rel.slice(7)) : path.join(stateDir, "journal", rel);
+}
+/**
+ * At a relay start with a verified enrollment: the committed copies replace the RAM working copies (an uncommitted local
+ * write was never acknowledged, so it was never published); coverage and runs are KVM's and left alone. Writes the descriptor.
+ * -> { ENCLAVE_DERIVED_STATE, ENCLAVE_DERIVED_COMMIT_BOOT }
+ */
+export function seedDerivedState({ dataDir, root, stateDir, held, boot }) {
+  const journalDir = path.join(stateDir, "journal"), coverageDir = path.join(stateDir, "coverage"), runsDir = path.join(stateDir, "runs");
+  fs.mkdirSync(stateDir, { recursive: true, mode: 0o700 });
+  fs.rmSync(journalDir, { recursive: true, force: true }); fs.rmSync(path.join(stateDir, "anchor-journal.json"), { force: true });
+  for (const d of [journalDir, coverageDir, runsDir]) fs.mkdirSync(d, { recursive: true, mode: 0o700 });
+  const files = [];
+  for (const [rel, digest] of Object.entries(held.manifest)) {
+    const bytes = fs.readFileSync(path.join(dataDir, STATE_DIR, rel));
+    if (sha(bytes) !== digest) throw new Error(`committed ${rel} changed while seeding`);
+    const p = ramPathOf(stateDir, rel); writeAtomic(p, bytes); files.push({ rel, path: p, sha256: digest });
+  }
+  const p = held.record.package;
+  const descriptor = { format: STATE_FORMAT,
+    enrollment: { digest: held.digest, mode: p.mode, at: p.at, readerPins: p.readerPins, previousReaderPins: p.mode === "rotate" ? held.record.previousReaderPins : null, highWater: p.highWater },
+    journalDir, coverageDir, runsDir, files, commit: { protocol: COMMIT_PROTOCOL, boot }, durability: DURABILITY };
+  const file = path.join(root, "derived-reader", "state.json");
+  writeAtomic(file, JSON.stringify(descriptor, null, 2) + "\n");
+  return { ENCLAVE_DERIVED_STATE: file, ENCLAVE_DERIVED_COMMIT_BOOT: boot };
+}
+
+/** a commit request from THIS child, checked before anything is written -> { rel, bytes } or { error } */
+export function checkCommitRequest(m, { boot, lastId, dataDir }) {
+  if (!m || m.v !== 1 || m.boot !== boot || !Number.isSafeInteger(m.id) || m.id <= lastId || !STATE_REL.test(String(m.file)) ||
+      typeof m.bytes !== "string" || !HEX64.test(String(m.sha256))) return { error: "bad_request" };
+  const bytes = Buffer.from(m.bytes, "base64");
+  if (bytes.length > MAX_STATE_BYTES || bytes.toString("base64") !== m.bytes || sha(bytes) !== m.sha256) return { error: "bad_request" };
+  const have = stateManifest(dataDir);
+  if (!(m.file in have) && Object.keys(have).length >= MAX_STATE_FILES) return { error: "bad_request" };
+  return { rel: m.file, bytes };
+}
+export function writeStateFile(dataDir, rel, bytes) { writeAtomic(path.join(dataDir, STATE_DIR, rel), bytes); }
+export const stateFileSha = (dataDir, rel) => { try { return sha(fs.readFileSync(path.join(dataDir, STATE_DIR, rel))); } catch { return null; } };
+/** the restore marker an admin `recover` bootstrap with archived state leaves in the replicated directory */
+export function restoreMarker({ head, archivedAt, at }) { return JSON.stringify({ format: "enclave-derived-restore/v1", head, archivedAt: archivedAt ?? null, at }); }
+export function writeEnrollment(dataDir, record) { writeAtomic(path.join(dataDir, ENROLL_FILE), JSON.stringify(record)); }
+export function writeMarker(dataDir, text) { writeAtomic(path.join(dataDir, MARKER_FILE), text); }
+/** the bridge floor in the committed copy (read only, for the admin's high-water record): KVM's lifecycle journal format */
+export function bridgeFloor(dataDir) {
+  try { const a = JSON.parse(fs.readFileSync(path.join(dataDir, STATE_DIR, "bridge/anchor-journal.json"), "utf8")).authorityAnchors?.["8453"]; return validAnchor(a) ? a : null; } catch { return null; }
+}
+
+/**
+ * enrollDerivedState's provider answer (KVM calls verifyEnrollment; the relay child asks the role over IPC): the role's
+ * verified enrollment, bound to the binding KVM computed and the exact floor digest the admin signed. A genesis is answered
+ * only while no durable state file exists. -> { result } or { error }
+ */
+export function enrollmentResult(held, { groupId, digest, binding, floorDigest }) {
+  const p = held.record?.package;
+  if (!p || held.digest !== digest) return { error: "not_enrolled" };
+  if (!HEX64.test(String(binding)) || binding !== p.binding) return { error: "binding" };
+  if (!HEX64.test(String(floorDigest)) || floorDigest !== p.floorDigest) return { error: "floor" };
+  if (p.mode === "genesis" && Object.keys(held.manifest).length) return { error: "prior_state" };
+  return { result: { format: RESULT_FORMAT, groupId, digest, mode: p.mode, at: p.at, readerPins: p.readerPins, binding: p.binding, floorDigest: p.floorDigest,
+    highWater: p.highWater, previousReaderPins: p.mode === "rotate" ? held.record.previousReaderPins : null, priorFiles: { ...held.manifest } } };
+}
