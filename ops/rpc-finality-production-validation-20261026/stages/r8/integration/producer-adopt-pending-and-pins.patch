+def adopt_pending(d, finality_dir, *, W, F, owner=0, top='/', now=None, watermark=None):
+    """r8: ONLY the durable-adoption half of record_finality - no new qualification, no live process. An interrupted record (the
+    finality-proof watermark entry landed, the launch journal's `bootstrapped` did not) is adopted exactly as _dangling_proof allows;
+    nothing dangling -> None. Run BEFORE any new capture/qualification (reproof) and before a restart permit (permit-restart-auto), so a
+    newer proof is never recorded on top of an unadopted one. A needed adoption is still HOLD-gated like record_finality."""
+    now = now or datetime.datetime.now(datetime.timezone.utc); d = pathlib.Path(d)
+    lsha, launch = _launch(d, owner, top)
+    if getattr(F, 'OWNER', None) != owner:
+        refuse('finality', 'the finality tool trusts another owner than this launch')
+    store = pathlib.Path(watermark or W.BOOTSTRAP_WATERMARK)
+    fd = _locked(d, owner, top, W)
+    try:
+        entries = _journal(d, lsha, owner, top, W)
+        if entries[-1][1]['event'] not in ('consumed', 'bootstrapped', 'restarted'):
+            return None
+        dg = _dangling_proof(F, launch, lsha, entries, store, finality_dir, owner, top, W)
+        if dg is None:
+            return None
+        if not reviewed('FINALITY_PROOF_REVIEWED'):
+            refuse('hold_finality', 'HOLD: a durable finality proof awaits adoption, but FINALITY_PROOF_REVIEWED is False')
+        fseq, ref, n, h, wsha = dg
+        j = _append(d, lsha, entries, 'bootstrapped', {'watermarkEntrySha256': wsha, 'finalityEntrySha256': ref, 'finalitySeq': fseq, 'number': n,
+                    'blockHash': h}, owner, top, now, W)
+        return {'watermarkEntrySha256': wsha, 'number': n, 'journal': j, 'appended': False, 'adopted': True}
+    finally:
+        os.close(fd)
+
