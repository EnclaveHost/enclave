+LIBNODE_PROBE = 'process.stdout.write(JSON.stringify(process.report.getReport().sharedObjects.filter((s) => /libnode\\.so/.test(s))))'
+
+
+def node_profile(R, node_sha):
+    """runtime-pin: the ACCEPTED entry of this launcher in the capture module's pins - the same identities R.accepted_nodes() reads:
+    host node 22 is self-contained (no `libnode`), guest Ubuntu node 18 is a launcher whose engine is the named libnode."""
+    try:
+        C = R.load_capture(); pins = R.A1_CAPTURE_TEST_PINS() if R.A1_CAPTURE_TEST_PINS else C.Pins()
+    except R.Refused as e:
+        refuse(str(e).split(':', 1)[0], str(e))
+    acc = pins.node_accepted.get(node_sha)
+    if acc is None:
+        refuse('node_pin', f'node {node_sha[:12]}... is not an accepted runtime')
+    return acc
+
+
+def mapped_libnode(nodep, node_fds=(), timeout=60):
+    """the libnode(s) THIS launcher maps, from its own process.report sharedObjects (realpaths, sorted, distinct)"""
+    try:
+        p = subprocess.run([nodep, '-e', LIBNODE_PROBE], capture_output=True, text=True, timeout=timeout, env={'PATH': '/usr/bin:/bin'},
+                           pass_fds=tuple(node_fds))
+        v = json.loads(p.stdout.strip().splitlines()[-1]) if p.returncode == 0 else None
+    except (subprocess.TimeoutExpired, ValueError, IndexError, OSError):
+        v = None
+    if not isinstance(v, list) or not all(isinstance(x, str) for x in v):
+        refuse('node_lib', 'node did not report its shared objects')
+    return sorted({os.path.realpath(x) for x in v})
+
+
+def libnode_identity(acc, nodep, node_fds=(), mapped=None):
+    """runtime-pin. A SPLIT node (accepted entry names `libnode`): that file is OWNER-owned, a regular file not group/other writable, with
+    the accepted sha (hashed from an open fd), and the launcher's OWN process report maps EXACTLY that one libnode (realpath) - a wrong,
+    missing, extra or unapproved libnode refuses. A SELF-CONTAINED node must map NO libnode. -> {path, sha256, identity} | None.
+    Only the launcher and libnode are pinned: node's other shared libraries (libuv, libssl, libicu, ...) are NOT."""
+    mapped = mapped_libnode(nodep, node_fds) if mapped is None else sorted({os.path.realpath(x) for x in mapped})
+    want = acc.get('libnode')
+    if not want:
+        if mapped:
+            refuse('node_lib', f'a self-contained accepted node must map no libnode; it maps {mapped}')
+        return None
+    lp = os.path.realpath(want['path'])
+    try:
+        fd = os.open(lp, os.O_RDONLY | os.O_NOFOLLOW | os.O_CLOEXEC)
+    except OSError as e:
+        refuse('node_lib', f'{lp} cannot be opened ({type(e).__name__})')
+    try:
+        st = os.fstat(fd)
+        if not stat.S_ISREG(st.st_mode) or st.st_uid != OWNER or st.st_mode & 0o022:
+            refuse('node_lib', f'{lp} must be a regular file owned by {OWNER}, not group/other writable')
+        h = hashlib.sha256()
+        while (c := os.read(fd, 1 << 20)):
+            h.update(c)
+    finally:
+        os.close(fd)
+    if h.hexdigest() != want['sha256']:
+        refuse('node_lib', f'{lp} is not the accepted libnode {want["sha256"][:12]}...')
+    if mapped != [lp]:
+        refuse('node_lib', f'node maps {mapped}, not exactly the accepted {lp}')
+    return {'path': lp, 'sha256': want['sha256'], 'identity': {'dev': st.st_dev, 'ino': st.st_ino, 'size': st.st_size, 'mtimeNs': st.st_mtime_ns}}
+
+
+def libnode_unchanged(lib):
+    """the verified libnode file is still the same object (dev, inode, size, mtime) after every node run of this decision"""
+    if lib is None:
+        return
+    try:
+        st = os.stat(lib['path'])
+    except OSError:
+        st = None
+    if st is None or {'dev': st.st_dev, 'ino': st.st_ino, 'size': st.st_size, 'mtimeNs': st.st_mtime_ns} != lib['identity']:
+        refuse('node_lib_changed', f'{lib["path"]} changed during the decision: nothing is recorded')
+
+
+def core_libs_ok(lib, libs):
+    """the finality core's OWN process report: exactly the verified libnode (split) or none (self-contained)"""
+    got = sorted({os.path.realpath(x) for x in libs}) if isinstance(libs, list) and all(isinstance(x, str) for x in libs) else None
+    if got != ([lib['path']] if lib else []):
+        refuse('node_lib', f'the finality core ran with libnode {got}, not {[lib["path"]] if lib else []}')
+
