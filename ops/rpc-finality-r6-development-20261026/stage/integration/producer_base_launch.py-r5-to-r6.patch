+            return False
+    try:
+        me = hashlib.sha256(pathlib.Path(__file__).read_bytes()).hexdigest()
+    except (OSError, NameError):
+        return False
+    return isinstance(doc, dict) and doc.get('format') == 'enclave-finality-activation/v1' and (doc.get('flags') or {}).get(name) == me
