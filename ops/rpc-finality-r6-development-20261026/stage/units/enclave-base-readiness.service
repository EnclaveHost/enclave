# base-finality-proof-stage/r6 (SOURCE ONLY): the unprivileged readiness sampler, published as /run/enclave-rpc-readiness/latest.json
[Unit]
Description=Base RPC readiness sample (post-anchor-finality gate included)
After=enclave-base-finality-status.service
[Service]
Type=oneshot
User=enclave-readiness
Group=enclave-readiness
RuntimeDirectory=enclave-rpc-readiness
RuntimeDirectoryMode=0755
RuntimeDirectoryPreserve=yes
ExecStart=/usr/bin/python3 -I -B /opt/enclave-rpc/readiness/publish_readiness.py /run/enclave-rpc-readiness --finality-status /run/enclave-rpc/base-finality-status.json
SuccessExitStatus=3 4
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
