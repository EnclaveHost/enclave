+def runtime_accepted(rec, files, pins):
+    """verify-side: the node launcher, its libnode (when split) and the interpreter (static or with its libpython) are accepted"""
+    nacc = pins.node_accepted.get((files.get('bin/node') or {}).get('sha256'))
+    if nacc is None:
+        refuse('node_identity', 'the node that executed is not an accepted runtime')
+    if nacc.get('libnode') and ((rec.get('runtimePolicy') or {}).get('libnode') or {}).get('sha256') != nacc['libnode']['sha256']:
+        refuse('node_identity', 'the libnode that executed is not the accepted one')
+    py = rec.get('python') or {}
+    pacc = pins.python_accepted.get(py.get('sha256'))
+    if pacc is None:
+        refuse('python_identity', 'the interpreter that ran the capture is not an accepted runtime')
+    if pacc.get('staticLibpython'):
+        if py.get('libpythonSha256') is not None or py.get('staticLibpython') is not True:
+            refuse('python_identity', 'a static interpreter must have run with no libpython mapped')
+    elif py.get('libpythonSha256') not in pins.libpython_accepted:
+        refuse('python_identity', 'the interpreter that ran the capture is not an accepted runtime')
+
