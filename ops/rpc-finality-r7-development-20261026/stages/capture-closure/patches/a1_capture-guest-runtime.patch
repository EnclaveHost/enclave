+def node_lib_identity(node, pins, probe=None, owner=OWNER):
+    """a split node (accepted entry names `libnode`): that file must be root-owned with the accepted sha AND be the ONE libnode the
+    accepted launcher itself reports mapped (process.report sharedObjects). -> None for a self-contained node."""
+    acc = pins.node_accepted.get(sha(read_once(os.path.realpath(node), CAP_NODE)))
+    if acc is None:
+        refuse('node_identity', f'node {node} is not an accepted runtime')
+    want = acc.get('libnode')
+    if want is None:
+        return None
+    lp = os.path.realpath(want['path']); st = os.stat(lp)
+    if not stat.S_ISREG(st.st_mode) or st.st_uid != owner or st.st_mode & 0o022:
+        refuse('node_identity', f'{lp} must be a root-owned regular file, not group/other writable')
+    if sha(read_once(lp, CAP_NODE)) != want['sha256']:
+        refuse('node_identity', f'{lp} is not the accepted libnode {want["sha256"][:12]}')
+    if probe is None:
+        probe = lambda: run_node_fd(node, pins, ['-e', NODE_LIB_PROBE], capture_output=True, text=True, timeout=60, env={'PATH': '/usr/bin:/bin'}).stdout
+    try:
+        mapped = sorted({os.path.realpath(x) for x in json.loads(probe())})
+    except (ValueError, TypeError):
+        refuse('node_identity', 'node did not report its shared objects')
+    if mapped != [lp]:
+        refuse('node_identity', f'node maps {mapped}, not exactly the accepted {lp}')
+    return {'path': lp, 'sha256': want['sha256'], 'package': want.get('package')}
+
