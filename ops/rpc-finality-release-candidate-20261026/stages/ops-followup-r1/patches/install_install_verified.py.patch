+# ---- RUNTIME DIRECTORIES (r10-ops-followup) ---------------------------------------------------------------------------------
+# the private runtime directories the templates name: reproof capturesRoot + workdir (base-finality-reproof.json) and the Helios
+# dataDir/homeDir (l1-authority.json, with their parent), whose loaders refuse anything but an existing root-owned 0700 directory.
+# /var/lib persists across reboots: created once (before activation), then checked (`runtime-dirs --check`) after any reboot.
+RUNTIME_DIRS = ('/var/lib/enclave-rpc/finality-captures', '/var/lib/enclave-rpc/finality-work', '/var/lib/enclave-rpc/l1-authority',
+                '/var/lib/enclave-rpc/l1-authority/data', '/var/lib/enclave-rpc/l1-authority/home')
+
+
+def runtime_dir_ops(dirs=RUNTIME_DIRS):
+    """preflight, no write: an existing path must already be a real root-owned 0700 directory and is left exactly as it is (never
+    chmod/chown'd or replaced); anything else refuses. Absent ones become journaled `mkdir` ops (root 0700, parents as the installer's)"""
+    if open_journals():
+        refuse(f'an install journal is still open ({open_journals()[0].name}): run `install_verified.py recover` first')
+    ops, plan = [], []
+    for d in dirs:
+        if os.path.lexists(R(d)):
+            st = os.lstat(R(d))
+            if stat.S_ISLNK(st.st_mode) or not stat.S_ISDIR(st.st_mode) or st.st_uid != UID or stat.S_IMODE(st.st_mode) != 0o700:
+                refuse(f'{d} exists but is not a real root-owned 0700 directory: nothing is changed (fix or remove it by hand)')
+            plan.append({'dest': d, 'result': 'present'}); continue
+        ops.append(({'dest': d, 'mode': 0o700, 'action': 'mkdir', 'sha256': None, 'parents': parents_to_create(d)}, b''))
+        plan.append({'dest': d, 'result': 'mkdir 0700'})
+    return ops, plan
+
+
+def runtime_dirs(argv, stamp):
+    if len(argv) > 1 or set(argv) - {'--commit', '--check'}:
+        print('usage: install_verified.py runtime-dirs [--commit | --check]'); return 2
+    try:
+        ops, plan = runtime_dir_ops()
+        if argv == ['--check']:
+            if ops:
+                refuse(f'absent: {[op["dest"] for op, _ in ops]} (run `install_verified.py runtime-dirs --commit`)')
+            result = 'all present, real, root-owned 0700'
+        else:
+            result = 'nothing to do' if not ops else commit(ops, stamp) if argv == ['--commit'] else 'dry-run (nothing written)'
+    except (Refused, OSError, ValueError) as e:
+        print(json.dumps({'ok': False, 'refused': str(e)})); return 1
+    print(json.dumps({'ok': True, 'result': result, 'plan': plan}, indent=1)); return 0
+
