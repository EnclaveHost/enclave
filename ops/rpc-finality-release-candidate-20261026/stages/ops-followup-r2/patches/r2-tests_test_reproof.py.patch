+    def test_r2_kill_before_any_durable_qualification_is_retired_and_the_next_run_proves(self):
+        self.launched()
+        with patch.object(RP, '_settle', lambda *a, **k: None), patch.object(FS, 'qualify', side_effect=OSError('killed at the barrier')):
+            with self.assertRaises(OSError):
+                self.reproof(capture_fn=self.capture_fn(NP), now=self.at(0))
+        cut = self.pairs(); self.assertEqual(len(cut), 1); self.assertTrue((self.t / 'caps' / cut[0] / RP.QUALIFY_BARRIER).exists())
+        self.assertFalse(self.ledger.exists())
+        self.assertEqual(self.reproof(capture_fn=self.capture_fn(NP), now=self.at(5))['action'], 'reproved')
+        self.assertEqual((self.history()[0]['outcome'], self.history()[0]['phase']), ('interrupted', 'after-qualify-barrier, durable records unchanged'))
+        self.assertIn('failed-' + cut[0], self.pairs())
