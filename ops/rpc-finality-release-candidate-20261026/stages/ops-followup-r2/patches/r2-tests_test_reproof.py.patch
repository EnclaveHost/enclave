+    # ---- r2: crash boundaries BEFORE and AFTER durable qualification / record; a kill is emulated by skipping _settle (no receipt) ----
+    def caps_ok(self, n):
+        return (self.t / 'caps' / n / 'initial').exists() and (self.t / 'caps' / n / 'recheck').exists()
