+# ---- N-anchored segmented coverage (historical-origin-segments-stage/r2) -------------------------------------------------
+# Explicit opt-in only: baseBootstrap.mode == 'anchored-segments' selects the anchored overlay; no mode keeps the legacy
+# safe-label path byte-for-byte; any other mode refuses. The overlay code is root-installed, root-owned and sha-pinned here.
+ANCHORED_COVERAGE_LIB = ROOT / 'lib' / 'anchored-coverage'
+ANCHORED_COVERAGE_PINS = {'anchored_acceptance.py': '45675c0b5f0f8668389909c859ad6c856973f475d167e6a2fa61886e1f15469b', 'segments.py': '8764f5cc55cc42307eadbe71695bb986ca5fa86c07db671553d50d0635c51aa1', 'anchored_origin.py': 'ed1a547d4d8aea112cae66479c64cd9e556b531063ef361c9b156c6d2948ddfa'}
+
+def _anchored_overlay(owner=0):
+    _secure_path(ANCHORED_COVERAGE_LIB, owner, leaf='dir')
+    mods = {}
+    for name in ('anchored_origin.py', 'segments.py', 'anchored_acceptance.py'):   # dependency order
+        p = ANCHORED_COVERAGE_LIB / name
+        _secure_path(p, owner)
+        raw = p.read_bytes()
+        assert hashlib.sha256(raw).hexdigest() == ANCHORED_COVERAGE_PINS[name], f'anchored coverage {name} is not the pinned bytes'
+        mod = type(sys)(name[:-3]); mod.__file__ = str(p)
+        sys.modules[name[:-3]] = mod                       # segments imports anchored_origin; anchored_acceptance imports both
+        exec(compile(raw, str(p), 'exec'), mod.__dict__)
+        mods[name] = mod
+    return mods['anchored_acceptance.py']
+
+def base_coverage(cfg, manifest_path, base_binary_sha256, directory=COVERAGE_DIR, owner=0):
+    """-> (binding, bound L1 origin). Legacy: the snapshot safe label's origin. Anchored: N's origin bound to header N."""
+    mode = (cfg.get('baseBootstrap') or {}).get('mode')
+    if mode is None:
+        o = coverage_activation(cfg, manifest_path, base_binary_sha256, directory, owner)
+        return o, o['safeL1Origin']
+    assert mode == 'anchored-segments', f'unknown baseBootstrap.mode {mode!r}: no implicit activation'
+    aa = _anchored_overlay(owner)
+    o = aa.anchored_coverage_activation(sys.modules[__name__], cfg, pathlib.Path(manifest_path), base_binary_sha256,
+                                        pathlib.Path(directory), owner)
+    return o, o['l1Origin']
