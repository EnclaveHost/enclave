Mon Oct 26 01:42:54 UTC 2026
# /etc/systemd/system/enclave-base-holder.service
[Unit]
Description=Enclave own-chain base on dedicated HDD volume
Wants=network-online.target
After=network-online.target enclave-l1-el.service enclave-l1-cl.service
RequiresMountsFor=/srv/enclave-base-holder
StartLimitIntervalSec=0

[Service]
Type=exec
User=rpcbase
Group=rpcbase
ExecStart=/usr/bin/python3 -I /opt/enclave-rpc/chain_service.py base
Restart=on-failure
RestartSec=300
TimeoutStopSec=600
KillMode=control-group
KillSignal=SIGINT
MemoryMax=28G
MemoryHigh=25G
OOMScoreAdjust=500
MemorySwapMax=0
TasksMax=4096
LimitNOFILE=65536
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/srv/enclave-base-holder/data /srv/enclave-base-holder/tmp
PrivateTmp=yes
UMask=0027

[Install]
WantedBy=multi-user.target

# /etc/systemd/system/enclave-base-holder.service.d/50-enclave-rpc-vm.conf
[Unit]
RequiresMountsFor=/srv/enclave-base-holder

[Service]
IPAddressDeny=10.0.2.2/32
MemoryMax=30064771072
CapabilityBoundingSet=cap_chown cap_dac_override cap_dac_read_search cap_fowner cap_fsetid cap_kill cap_setgid cap_setuid cap_setpcap cap_linux_immutable cap_net_bind_service cap_net_broadcast cap_net_admin cap_net_raw cap_ipc_lock cap_ipc_owner cap_sys_module cap_sys_rawio cap_sys_chroot cap_sys_ptrace cap_sys_pacct cap_sys_admin cap_sys_boot cap_sys_nice cap_sys_resource cap_sys_time cap_sys_tty_config cap_mknod cap_lease cap_audit_write cap_audit_control cap_setfcap cap_mac_override cap_mac_admin cap_syslog cap_wake_alarm cap_block_suspend cap_audit_read cap_perfmon cap_bpf cap_checkpoint_restore
AmbientCapabilities=
User=rpcbase
Group=rpcbase
ReadWritePaths=/srv/enclave-base-holder/data /srv/enclave-base-holder/tmp
ProtectSystem=strict
NoNewPrivileges=yes
ActiveState=inactive
rpcbase:x:994:985::/nonexistent:/usr/sbin/nologin
