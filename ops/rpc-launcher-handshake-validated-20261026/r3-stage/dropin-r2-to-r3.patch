--- r2/systemd/50-base-launch-handshake.conf
+++ r3/systemd/60-base-launch-handshake.conf
@@ -1,24 +1,33 @@
-# PROPOSAL (PREPARED; NOT installed): /etc/systemd/system/enclave-base-holder.service.d/50-base-launch-handshake.conf
+# PROPOSAL (PREPARED; NOT installed): /etc/systemd/system/enclave-base-holder.service.d/60-base-launch-handshake.conf
+# Checked against root's capture of the LIVE unit (outputs/.../launcher-service-audit-0143/base-unit.out, sha256 612fee0b...):
+#   enclave-base-holder.service: User=rpcbase, Group=rpcbase, ExecStart=/usr/bin/python3 -I /opt/enclave-rpc/chain_service.py base,
+#     NoNewPrivileges=yes, ProtectSystem=strict, ProtectHome=yes, ReadWritePaths=/srv/enclave-base-holder/data
+#     /srv/enclave-base-holder/tmp, PrivateTmp=yes, UMask=0027, MemoryMax=28G, MemoryHigh=25G, MemorySwapMax=0,
+#     OOMScoreAdjust=500, TasksMax=4096, LimitNOFILE=65536, Restart=on-failure, RestartSec=300;
+#   existing drop-in 50-enclave-rpc-vm.conf: RequiresMountsFor=/srv/enclave-base-holder, IPAddressDeny=10.0.2.2/32;
+#   effective CapabilityBoundingSet = the full default set, AmbientCapabilities empty; rpcbase = uid 994, gid 985.
+# Named 60-*: drop-ins apply in lexical order, so this file comes AFTER 50-enclave-rpc-vm.conf and its User=/Group= win.
 # Release mode ONLY. Install it together with manifest.json baseRelease and an armed journal. Remove it BEFORE reverting to the
-# legacy bin/base, in this order: stop the unit, remove this file, daemon-reload. The r2 wrapper refuses legacy mode while the
+# legacy bin/base, in this order: stop the unit, remove this file, daemon-reload. The wrapper refuses legacy mode while the
 # marker below is set, and refuses release mode without it or without euid 0.
-# Everything else is inherited UNCHANGED from the unit stage_node_units.py writes: Type=exec, ExecStart (python3 -I ... base),
-# Restart=on-failure, RestartSec=300, KillMode/KillSignal/TimeoutStopSec, MemoryMax=28G, MemoryHigh=25G, MemorySwapMax=0,
-# OOMScoreAdjust=500, TasksMax=4096, LimitNOFILE=65536, NoNewPrivileges=yes, ProtectSystem=strict, ProtectHome=yes,
-# PrivateTmp=yes, UMask=0027, and ReadWritePaths=<data> <tmp> (ReadWritePaths in a drop-in APPENDS). No allocation changes.
+# Everything else stays exactly as captured: no ExecStart, allocation, memory, tasks, limit, network or restart change.
+# NoNewPrivileges=yes stays.
 [Service]
-# The python launcher alone runs as root: it takes the journal lock, runs every gate, consumes, then drop_privileges() sets
-# initgroups + setresgid/setresuid to rpcbase in the same process before execve. Base never runs as root.
+# The python launcher alone runs as root: it takes the journal lock, runs every gate, consumes, then drop_privileges() calls
+# initgroups(rpcbase, 985) and setresgid/setresuid to 985/994 in the same process, then execve. Base never runs as root.
 User=root
 Group=root
 Environment=ENCLAVE_BASE_LAUNCH_HANDSHAKE=1
-# ProtectSystem=strict mounts /etc read-only. ONLY the journal directory and the lock file become writable; launch.json,
-# qualification/ and the rest of /etc stay read-only. Both paths must already exist (root `arm` creates them). Until then the
-# unit fails namespace setup (226/NAMESPACE) before any code runs: fail closed, Base not started.
+# ProtectSystem=strict mounts /etc read-only. ONLY the journal directory and the lock file become writable (appended to the
+# data/tmp paths). launch.json, qualification/ and the rest of /etc stay read-only. Both paths must already exist (root `arm`
+# creates them). Until then the unit fails namespace setup (226/NAMESPACE) before any code runs: fail closed, Base not started.
 ReadWritePaths=/etc/enclave-rpc/base-bootstrap/journal /etc/enclave-rpc/base-bootstrap/journal.lock
-# CAP_SETUID and CAP_SETGID: the drop. CAP_DAC_READ_SEARCH: the gates read rpcbase-owned data (reth.toml, the static-file
-# listing) under UMask 0027. The journal is root-owned, so it needs no DAC override. CAP_DAC_OVERRIDE, CAP_SYS_ADMIN and every
-# other capability are absent. After setresuid to a non-zero uid the kernel clears the permitted and effective sets;
-# NoNewPrivileges keeps exec from regaining any.
+# The live set is the full default. This narrows it to three:
+#   CAP_SETUID and CAP_SETGID: the drop;
+#   CAP_DAC_READ_SEARCH: the gates, as root, read rpcbase-owned data (reth.toml, the static-file listing) created under
+#     UMask 0027;
+#   the journal is root-owned and needs no DAC override.
+# After setresuid to 994 the kernel clears the permitted and effective sets (no keepcaps). NoNewPrivileges keeps exec from
+# regaining any.
 CapabilityBoundingSet=CAP_SETUID CAP_SETGID CAP_DAC_READ_SEARCH
 AmbientCapabilities=
