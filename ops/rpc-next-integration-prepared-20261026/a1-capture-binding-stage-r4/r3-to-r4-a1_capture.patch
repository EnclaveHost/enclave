+def load_pinned(b, path, name, want):
+    """the PINNED module from its VERIFIED bytes, compiled and executed in memory. Never importlib's file loader: that reads
+    the path a second time and, unless the CALLER disabled bytecode, writes __pycache__/*.pyc beside the bound copy, i.e.
+    an unbound file inside the capture that the strict file_set check then (correctly) refuses."""
+    import importlib.machinery, types
+    if sha(b) != want:
+        refuse('l1_authority_pin', 'l1_authority.py is not the reviewed launcher')
+    m = types.ModuleType(name); m.__file__ = str(path); m.__loader__ = None
+    m.__spec__ = importlib.machinery.ModuleSpec(name, None, origin=str(path))
+    exec(compile(b, str(path), 'exec', dont_inherit=True), m.__dict__)
     return m
 
 
