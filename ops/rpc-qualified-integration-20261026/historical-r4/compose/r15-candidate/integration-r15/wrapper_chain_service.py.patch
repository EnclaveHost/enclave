+    coverage, all re-verified from root-owned evidence. Any other mode refuses (no implicit activation)."""
+    mode = (cfg.get('baseBootstrap') or {}).get('mode') if isinstance(cfg.get('baseBootstrap'), dict) else None
+    if mode is None:
