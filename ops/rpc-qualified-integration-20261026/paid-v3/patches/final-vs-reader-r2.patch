+++ b/network/wg-provider/derived-anchor-floor.mjs
@@ -0,0 +1,47 @@
+// The paid provider's durable floor of accepted DERIVED anchors (the journal network/lifecycle-finality-bridge.mjs takes:
+// readAnchor(chainId) / acceptAnchor(chainId, anchor)). The bridge refuses an anchor below it or contradicting it at the
+// same height, and records each anchor it publishes BEFORE the read's value is used. A restart therefore never goes back
+// to an older derived Base block or L1 block than one this provider already acted on.
+// The file is a rollback floor only, never authority: nothing is read from it as a chain fact, every snapshot still needs
+// a fresh anchor from the in-process derived reader. A missing file is an empty floor (first start); a file that is not
+// exactly this format refuses (settle it by hand: never delete it to get past a contradiction).
+import fs from 'node:fs';
+import path from 'node:path';
+import { strictWriteFile } from '../lease-release-journal.mjs';
+
+const FORMAT = 'enclave-provider-derived-floor/v1';
+const HASH = /^0x[0-9a-f]{64}$/;
+const int = (n) => Number.isSafeInteger(n) && n >= 0;
+export const DERIVED_FLOOR_MAX_BYTES = 64 * 1024;
+
+function checkAnchor(a, what) {
+  const bad = (why) => { throw new Error(`${what}: not a derived anchor (${why})`); };
+  if (!a || typeof a !== 'object' || a.tier !== 'l1-finalized-derived') bad('tier');
+  for (const k of ['base', 'l1']) if (!a[k] || !int(a[k].number) || !int(a[k].timestamp) || !HASH.test(a[k].hash || '')) bad(k);
+  if (!HASH.test(a.base.stateRoot || '')) bad('base state root');
+  return a;
+}
+
+/** -> { readAnchor(chainId), acceptAnchor(chainId, anchor), file } over `file` (absolute; its directory must exist). */
+export function openDerivedAnchorFloor(file, { chainId = 8453 } = {}) {
+  if (typeof file !== 'string' || !path.isAbsolute(file)) throw new Error('derived anchor floor: an absolute file is required');
+  let floor = null, st = null;
+  try { st = fs.lstatSync(file); } catch (e) { if (e.code !== 'ENOENT') throw e; }
+  if (st) {
+    if (!st.isFile() || st.size > DERIVED_FLOOR_MAX_BYTES) throw new Error(`${file}: not a derived anchor floor (a regular file of at most ${DERIVED_FLOOR_MAX_BYTES} bytes); settle it by hand`);
+    let j; try { j = JSON.parse(fs.readFileSync(file, 'utf8')); } catch { throw new Error(`${file}: not a derived anchor floor (not JSON); settle it by hand`); }
+    if (!j || j.format !== FORMAT || j.chainId !== chainId || Object.keys(j).sort().join(',') !== 'anchor,chainId,format') throw new Error(`${file}: not this provider's derived anchor floor (format or chain); settle it by hand`);
+    floor = checkAnchor(j.anchor, file);
+  }
+  const chain = (c) => { if (c !== chainId) throw new Error(`derived anchor floor is for chain ${chainId}, not ${c}`); };
+  return Object.freeze({ file,
+    readAnchor(c) { chain(c); return floor ? structuredClone(floor) : null; },
+    acceptAnchor(c, anchor) {
+      chain(c); checkAnchor(anchor, 'acceptAnchor');
+      if (floor && ['base', 'l1'].some((k) => anchor[k].number < floor[k].number || (anchor[k].number === floor[k].number && anchor[k].hash !== floor[k].hash)))
+        throw new Error('derived anchor rollback or contradiction (below or beside the durable floor)');
+      const next = { tier: anchor.tier, base: { ...anchor.base }, l1: { ...anchor.l1 } };
+      strictWriteFile(file, JSON.stringify({ format: FORMAT, chainId, anchor: next }));
+      floor = next;
+    } });
+}
