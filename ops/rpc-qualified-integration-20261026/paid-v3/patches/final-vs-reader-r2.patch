+// A PAID provider's on-chain sends under paidFinality "derived" (network/wg-provider/derived-submission.mjs): head, state,
+// receipts and resolution at an L1-finalized DERIVED Base block; a durable contiguous nonce journal rooted in the PROVEN
+// nonce; the own backend for submission only; history bytes from ordinary eth methods, each checked against proven hashes.
+//
+// WHAT IS REAL HERE:
+//   * network/lifecycle-finality-bridge.mjs (KVM commit c66b087, byte-identical to its pinned input), derived-anchor-floor.mjs,
+//     derived-submission.mjs, attested-authority.mjs (config), attested-submission.mjs (providerTxBackend, backendCaller),
+//     network/runtime-lock.mjs (the journal's kernel lock), network/onchain-qualification.mjs ensureHost / submitAttestations;
+//   * the cryptography a receipt is checked with: keccak(RLP) of Isthmus-shaped headers (KVM vendor headerRlp/headerHash), the
+//     transactions trie over bodies RE-ENCODED from eth_getBlockByNumber(M, true) JSON, and the receipts trie / blooms / gas
+//     total (network/op-receipts-root.mjs), over a SYNTHETIC but byte-exact chain: real signed EIP-1559 transactions of the
+//     operator key, real signed legacy (EIP-155) filler transactions, deposit transactions and receipts, logs;
+//   * the own backend (and, in one case, a separate history source) over loopback HTTP with backendCaller's strict JSON-RPC
+//     checks, with injected faults.
+// WHAT IS A FIXTURE / STAND-IN (labelled; nothing here is production or consensus evidence):
+//   * the derived reader is a STAND-IN readAnchor that labels a block of the synthetic chain l1-finalized-derived: NO native
+//     derivation and NO L1 light client run here (real positive Base derivation and SNP image qualification are pending);
+//   * the proof executor is a STAND-IN answering state from the world model, checking NO Merkle proofs; in the attested cases
+//     it carries the attested brand programmatically (markAttestedVerifierClient) - it is NOT the attested channel;
+//   * the transactions roots are computed from the signers' raw bytes, the RPC bodies from viem's parser of those bytes; the
+//     receipts trie is built with the same op-receipts-root encoder that verifies it (its agreement with real Base blocks is
+//     its own suite's evidence). No real Base full-body vector was available offline for the body re-encoder.
+import test, { after } from 'node:test';
+import assert from 'node:assert/strict';
+import fs from 'node:fs';
+import os from 'node:os';
+import net from 'node:net';
+import http from 'node:http';
+import path from 'node:path';
+import { keccak256, toBytes, hexToBytes, bytesToHex, getAddress, parseTransaction, decodeFunctionData, encodeFunctionData, encodeFunctionResult, encodeAbiParameters, recoverTransactionAddress } from 'viem';
+import { privateKeyToAccount } from 'viem/accounts';
+import { headerHash } from '../network/derived-reader/vendor/anchor-bootstrap.mjs';
+import { rlp, consensusReceiptsRoot, logsBloom, orderedTrieRoot } from '../network/op-receipts-root.mjs';
+import { markAttestedVerifierClient } from '../network/attested-verifier-brand.mjs';
+import { createDerivedSubmitter as sourceSubmitter, encodeRpcTransaction, parseSendJournal, HISTORY_STORAGE, HISTORY_WINDOW, DERIVED_BACKEND_USE, DERIVED_HISTORY_USE, JOURNAL_FORMAT } from '../network/wg-provider/derived-submission.mjs';
+import { openDerivedAnchorFloor as sourceFloor } from '../network/wg-provider/derived-anchor-floor.mjs';
+import { pathToFileURL } from 'node:url';
+// PAID_DERIVED_RUNTIME=<release dir>/derived-runtime.mjs (test/paid-derived-packaging.test.mjs): the same cases against the
+// PACKAGED runtime the release pipeline built (its own bundled copy of the adapter, loaded with its pinned schedule reader)
+const PACKAGED = process.env.PAID_DERIVED_RUNTIME ? await import(pathToFileURL(process.env.PAID_DERIVED_RUNTIME).href) : null;
+const createDerivedSubmitter = PACKAGED ? PACKAGED.createDerivedSubmitter : sourceSubmitter;
+const openDerivedAnchorFloor = PACKAGED ? PACKAGED.openDerivedAnchorFloor : sourceFloor;
+if (PACKAGED) console.log(`# runtime: packaged ${process.env.PAID_DERIVED_RUNTIME}`);
+import { providerTxBackend, parseSendRecord } from '../network/wg-provider/attested-submission.mjs';
+import { providerChainAuthority, providerPaidFinality, paidSendPath } from '../network/wg-provider/attested-authority.mjs';
+import { checkOwnBackend } from '../network/chain-authority.mjs';
+import { connectivityQualificationABI, ensureHost, submitAttestations, addressHash, ALL_CHECKS } from '../network/onchain-qualification.mjs';
+
+const tmp = fs.mkdtempSync(path.join(process.env.TMPDIR || os.tmpdir(), 'paid-derived-'));
+const servers = [], open = new Set();
+after(async () => { for (const s of open) await s.close().catch(() => {}); for (const s of servers) { try { s.closeAllConnections?.(); s.close(); } catch {} } fs.rmSync(tmp, { recursive: true, force: true }); });
+// every socket this process opens is recorded by its target host; the last test asserts all of them are loopback
+const connects = [];
+const socketConnect = net.Socket.prototype.connect;
+net.Socket.prototype.connect = function (...args) {
+  const o = Array.isArray(args[0]) ? args[0][0] : args[0];
+  connects.push(o && typeof o === 'object' ? (o.path ? 'unix:' + o.path : (o.host ?? 'localhost')) : typeof args[1] === 'string' ? args[1] : 'localhost');
+  return socketConnect.apply(this, args);
+};
+const hex = (n) => '0x' + BigInt(n).toString(16);
+const lc = (s) => String(s).toLowerCase();
+const kc = (b) => hexToBytes(keccak256(b));
+const tag = (s) => keccak256(toBytes(s));
+const sleep = (ms) => new Promise((r) => setTimeout(r, ms));
+// anvil's well-known development keys (synthetic chain only)
