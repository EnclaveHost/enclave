+// ---- STAND-IN proof executor: answers from the world model, checks NO proofs ------------------------------------------
+function standInExecutor(w, { attested = false } = {}) {
+  const ex = { calls: [], chainId: '0x2105', view: null, gasNeeded: 40_000n, balance: 10n ** 18n };
+  const chain = () => ex.view || w.blocks;
