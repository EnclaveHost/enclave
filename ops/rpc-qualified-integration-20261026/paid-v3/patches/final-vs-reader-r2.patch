+    if (!broadcast && ['eth_sendRawTransaction', 'eth_getTransactionCount', 'eth_maxPriorityFeePerGas'].includes(method)) throw err(`${method} not offered here`, -32601);
+    switch (method) {
+      case 'eth_chainId': return be.fault.chainId || '0x2105';
