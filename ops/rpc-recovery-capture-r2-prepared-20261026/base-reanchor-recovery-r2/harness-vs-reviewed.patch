+    if ra is None:
+        refuse('a1_initial_pin', f'a1InitialSha256 is not the pinned initial A1 receipt {A1_INITIAL_SHA256[:12]}... (a source change, never config)')
+    if 'a1Capture' not in ra:
+        refuse('a1_initial_pin', 'a re-anchor receipt other than the source-pinned one needs a capture-binding record (reanchor.a1Capture)')
+    if A1_CAPTURE_VERIFIER is None:
+        refuse('a1_capture_pending', 'HOLD: no reviewed A1 capture-binding verifier exists (a1-capture-binding-stage); a re-anchor '
+               'receipt other than the source-pinned one cannot be bound')
+    ini = _read_trusted(c['a1InitialEvidence'], 'initial A1 receipt', A1_FILE_CAP)
+    if hashlib.sha256(ini).hexdigest() != c['a1InitialSha256']:
+        refuse('a1_initial_pin', 'the initial receipt bytes are not a1InitialSha256')
+    want = {'captureSha256': ra['a1CaptureSha256'], 'initialSha256': c['a1InitialSha256'], 'N': str(c['N']), 'game': c['game'],
+            'outputRoot': c['outputRoot']}
+    if A1_CAPTURE_VERIFIER(ra['a1Capture'], ini) != want:
+        refuse('a1_capture_binding', 'the capture-bound run did not produce exactly this initial receipt for the planned N/game/root')
+    return 'capture-bound'
