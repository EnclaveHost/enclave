+def header_hash(c, header):
+    """keccak block hash of a header JSON, with the same pinned anchor module authenticate() uses."""
+    script = ("const fs=await import('node:fs');const m=await import(process.env.A);const d=await import(process.env.D);"
+              "const i=JSON.parse(fs.readFileSync(0,'utf8'));console.log(JSON.stringify({blockHash:m.headerHash(i,(b)=>d.keccak_256(b))}))")
+    deps = pathlib.Path(c['depsRoot'], 'node_modules/@noble/hashes/sha3.js')
+    env = dict(os.environ, A=pathlib.Path(c['anchorModule']).as_uri(), D=deps.as_uri())
+    p = subprocess.run([c['node'], '--input-type=module', '-e', script], input=json.dumps(header), capture_output=True, text=True, env=env, timeout=60)
+    try:
+        return json.loads(p.stdout.strip().splitlines()[-1])['blockHash']
+    except Exception:
+        refuse('a2_tool', f'header hash produced no result: {p.stderr[-300:]}')
+
