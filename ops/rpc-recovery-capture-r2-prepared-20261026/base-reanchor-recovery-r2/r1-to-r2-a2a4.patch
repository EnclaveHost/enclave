+def watermark_entries(store):
+    """The verified watermark chain -> [(sha256, entry)] oldest first; [] when the store is absent or holds no entry."""
+    p = pathlib.Path(store)
+    if not os.path.lexists(p):
+        return []
+    st = os.lstat(p)
+    if stat.S_ISLNK(st.st_mode) or not stat.S_ISDIR(st.st_mode) or st.st_uid != TRUSTED_UID or st.st_mode & 0o022:
+        refuse('watermark_tamper', f'{p} is not a real directory owned by uid {TRUSTED_UID} and not group/other-writable')
+    out, prev = [], None
+    for name in sorted(os.listdir(p)):
+        if re.fullmatch(r'\.partial-[0-9]+', name):
+            continue
+        if not re.fullmatch(r'[0-9]{6}\.json', name) or int(name[:6]) != len(out) + 1:
+            refuse('watermark_tamper', f'unexpected watermark entry {name}')
+        b = _read_trusted(str(p / name), 'watermark entry', A1_FILE_CAP)
+        try:
+            e = json.loads(b)
+        except ValueError:
+            refuse('watermark_tamper', f'{name} is not JSON')
+        if not (isinstance(e, dict) and set(e) == WATERMARK_KEYS and e['format'] == WATERMARK_FORMAT and e['seq'] == len(out) + 1
+                and e['prevSha256'] == prev and type(e['number']) is int and re.fullmatch(r'0x[0-9a-f]{64}', str(e['blockHash']))
+                and e['kind'] in WATERMARK_KINDS and re.fullmatch(r'[0-9a-f]{64}', str(e['ref']))):
+            refuse('watermark_tamper', f'watermark chain broken at {name}')
+        if out and not (e['number'] > out[-1][1]['number'] or (e['number'] == out[-1][1]['number'] and e['blockHash'] == out[-1][1]['blockHash'])):
+            refuse('watermark_tamper', f'watermark regresses or conflicts at {name}')
+        h = hashlib.sha256(b).hexdigest(); out.append((h, e)); prev = h
+    return out
+
