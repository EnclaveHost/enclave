+def gate_watermark(c, base, anchor_hash=None):
+    """Re-anchor only. The chosen anchor must not lie below the latest accepted authenticated-finality watermark, nor at its
+    height with another block; with `base` (after gate_static) the STOPPED DB's header at the watermark height must be the
+    watermarked block. No watermark -> refuses unless reanchor.legacyNoWatermark is explicitly true (and then only while none
+    exists). -> the binding produce records in the launch."""
+    ra = c['reanchor']; es = watermark_entries(ra['watermarkStore'])
+    if not es:
+        if ra.get('legacyNoWatermark') is not True:
+            refuse('watermark_missing', 'no accepted authenticated-finality watermark is recorded: a re-anchor without one must be declared '
+                   'explicitly (reanchor.legacyNoWatermark = true)')
+        return {'legacy': True}
+    if ra.get('legacyNoWatermark'):
+        refuse('watermark_legacy', 'legacyNoWatermark is only for a store with no entry; an accepted watermark exists')
+    head_sha, head = es[-1]
+    if c['N'] < head['number']:
+        refuse('watermark_below', f'N {c["N"]} is below the accepted authenticated-finality watermark {head["number"]} ({head["kind"]}): '
+               'an accepted finalized guarantee is never discarded')
+    if anchor_hash is not None and c['N'] == head['number'] and anchor_hash != head['blockHash']:
+        refuse('watermark_conflict', f'the anchor block at {c["N"]} is not the watermarked block {head["blockHash"][:14]}...')
+    if base is not None and header_hash(c, read_header(c, base, head['number'])) != head['blockHash']:
+        refuse('watermark_conflict', f'the stopped DB header {head["number"]} is not the watermarked block (another chain)')
+    return {'seq': len(es), 'entrySha256': head_sha, 'number': head['number'], 'blockHash': head['blockHash'], 'kind': head['kind']}
+
