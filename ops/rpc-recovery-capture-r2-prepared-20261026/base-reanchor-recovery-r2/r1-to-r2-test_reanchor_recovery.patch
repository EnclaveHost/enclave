+        self.rollback('crash'); prev = self.retire()['retired']
+        self.gen += 1; self.cfg['workdir'] = str(self.d / f'work-{self.gen}'); self.fresh_recheck()
+        return prev
+
+    def wm_put(self, number, block_hash, kind='finality-proof', ref='ab' * 32):
