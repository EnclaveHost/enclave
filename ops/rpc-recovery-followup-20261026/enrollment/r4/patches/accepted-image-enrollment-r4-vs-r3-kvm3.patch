+test("interleaved writers (barrier, credentials, derived) and commits: no member ever holds bytes other than the committed scan of its head", async () => {
+  const g = group();
+  try {
+    await quiet(g);
+    assert.equal(await g.nodes[0].campaign(), true);
+    g.hook.delayMs = 15;
+    const writes = [], commits = [];
+    for (let k = 0; k < 6; k++) {
+      writes.push(sleep(k * 7).then(() => { g.write(0, ["relay-state.json", "platform-credentials.json", "derived-authority/state/reader/derived-state.json"][k % 3], `w${k}`); }));
+      commits.push(sleep(k * 5).then(() => g.nodes[0].commit()));
+    }
+    await Promise.all(writes); const results = await Promise.all(commits);
+    g.hook.delayMs = 0;
+    assert.ok(results.every((r) => r === true), "every round reached a majority");
+    assert.equal(await g.nodes[0].commit(), true);
+    for (const i of [1, 2]) { assert.deepEqual(g.nodes[i].head, g.nodes[0].head); assert.ok(g.holdsIndexOf(i, 0), `member ${i} holds exactly the committed scan`); }
+    assert.ok(g.holdsIndexOf(0, 0), "the primary's directory is its committed scan once the writers stopped");
+  } finally { g.cleanup(); }
