+test("election: the new primary's epoch snapshot carries exactly its scanned bytes; every member then holds its committed scan", async () => {
+  const g = group();
+  try {
+    await quiet(g);
+    assert.equal(await g.nodes[0].campaign(), true);
+    g.write(0, "platform-credentials.json", '{"at":1}'); g.write(0, "derived-authority/enrollment.json", '{"e":1}'); assert.equal(await g.nodes[0].commit(), true);
+    g.nodes[0].stop(); g.down.add(0);
+    await sleep(g.nodes[0].leaseMs * 2);
+    assert.equal(await g.nodes[1].campaign(), true);
+    assert.ok(g.holdsIndexOf(2, 1), "member 2 holds exactly the elected member's committed scan");
+    assert.deepEqual(g.nodes[2].head, g.nodes[1].head);
+  } finally { g.cleanup(); }
+});
