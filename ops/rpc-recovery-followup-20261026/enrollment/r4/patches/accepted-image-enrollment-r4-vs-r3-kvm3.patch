+// relay/state-replica.mjs: a catch-up snapshot carries EXACTLY the bytes of the scan its head commits (readAllExact). Before the
+// fix, the snapshot was read AFTER the append round's await, so a file written in between (a derived commit, the credentials
+// writer, a relay barrier write) could travel under an older head whose scan recorded other bytes. Real ReplicaNode members in
+// this process over a partitionable transport with an injection hook; driven by hand (campaign / commit) so every case is exact.
+//   run: node --test --test-concurrency=1 test/state-replica-exact.test.mjs
+import { test } from "node:test";
+import assert from "node:assert/strict";
+import fs from "node:fs";
+import os from "node:os";
+import path from "node:path";
+import { createHash, randomBytes } from "node:crypto";
+import { ReplicaNode, scanDir, readAllExact, cmpHead } from "../relay/state-replica.mjs";
+
+const sleep = (ms) => new Promise((r) => setTimeout(r, ms));
+const sha = (b) => createHash("sha256").update(b).digest("hex");
+function group({ n = 3, leaseMs = 300 } = {}) {
+  const root = fs.mkdtempSync(path.join(os.tmpdir(), "replica-exact-")), key = randomBytes(32), down = new Set(), nodes = [];
+  const hook = { after: null, delayMs: 0 };                  // after(from, to): runs once a member answered, before the sender continues
+  const send = (from) => async (to, buf) => {
+    if (down.has(to) || down.has(from)) throw new Error("unreachable");
+    if (hook.delayMs) await sleep(hook.delayMs);
+    const out = await nodes[to].handle(buf);
+    if (hook.after) await hook.after(from, to);
+    return out;
+  };
+  for (let i = 0; i < n; i++) nodes.push(new ReplicaNode({ self: i, n, key, group: "exact", dir: path.join(root, `m${i}/data`), metaFile: path.join(root, `m${i}/meta.json`),
+    send: send(i), leaseMs, info: { name: `m${i}` } }));
+  const write = (i, rel, text) => { const f = path.join(nodes[i].dir, rel); fs.mkdirSync(path.dirname(f), { recursive: true }); fs.writeFileSync(f + ".tmp", text); fs.renameSync(f + ".tmp", f); };
+  const read = (i, rel) => { try { return fs.readFileSync(path.join(nodes[i].dir, rel), "utf8"); } catch { return null; } };
+  /** every file of member i is exactly the bytes member j's committed scan (index) records */
+  const holdsIndexOf = (i, j) => { const idx = nodes[j].index, mine = scanDir(nodes[i].dir); return idx.size === mine.size && [...idx].every(([rel, f]) => mine.get(rel)?.sha === f.sha); };
+  return { root, nodes, down, hook, write, read, holdsIndexOf, cleanup: () => { for (const x of nodes) x.stop(); fs.rmSync(root, { recursive: true, force: true }); } };
+}
+const quiet = (g) => sleep(g.nodes[0].leaseMs + 30);
+
+test("catch-up: a file written after the scan is NOT shipped under that head; the member's answer does not count; the next round ships the exact new bytes", async () => {
+  const g = group();
+  try {
+    await quiet(g);
+    assert.equal(await g.nodes[0].campaign(), true);
+    g.write(0, "derived-authority/state/bridge/anchor-journal.json", "v1"); assert.equal(await g.nodes[0].commit(), true);
+    g.down.add(2); g.write(0, "derived-authority/state/bridge/anchor-journal.json", "v2"); assert.equal(await g.nodes[0].commit(), true, "majority without member 2");
+    g.down.clear();
+    g.write(0, "derived-authority/state/bridge/anchor-journal.json", "v3");
+    let injected = false;
+    g.hook.after = async (from, to) => { if (to === 2 && !injected) { injected = true; g.write(0, "derived-authority/state/bridge/anchor-journal.json", "v4"); } };
+    assert.equal(await g.nodes[0].commit(), true, "majority from members 0 and 1");
+    g.hook.after = null;
+    assert.equal(injected, true, "member 2 needed a snapshot after the scan of v3");
+    assert.equal(g.nodes[0].index.get("derived-authority/state/bridge/anchor-journal.json").sha, sha("v3"), "the committed head records v3");
+    assert.equal(g.read(1, "derived-authority/state/bridge/anchor-journal.json"), "v3");
+    assert.notEqual(g.read(2, "derived-authority/state/bridge/anchor-journal.json"), "v4", "v4 never travelled under the v3 head");
+    assert.ok(cmpHead(g.nodes[2].head, g.nodes[0].head) < 0, "member 2 is still behind, not at the v3 head with other bytes");
+    assert.equal(await g.nodes[0].commit(), true);
+    for (const i of [1, 2]) { assert.equal(g.read(i, "derived-authority/state/bridge/anchor-journal.json"), "v4"); assert.deepEqual(g.nodes[i].head, g.nodes[0].head); assert.ok(g.holdsIndexOf(i, 0)); }
