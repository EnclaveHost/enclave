+test("readAllExact: a changed or vanished file refuses the snapshot (code changed); unchanged files are returned exactly", () => {
+  const d = fs.mkdtempSync(path.join(os.tmpdir(), "replica-exact-unit-"));
+  try {
+    fs.mkdirSync(path.join(d, "x")); fs.writeFileSync(path.join(d, "x/a.json"), "one"); fs.writeFileSync(path.join(d, "b.json"), "two");
+    const scan = scanDir(d);
+    assert.deepEqual(readAllExact(d, scan), { "x/a.json": Buffer.from("one").toString("base64"), "b.json": Buffer.from("two").toString("base64") });
+    fs.writeFileSync(path.join(d, "b.json"), "TWO"); assert.throws(() => readAllExact(d, scan), { code: "changed" });
+    fs.writeFileSync(path.join(d, "b.json"), "two"); assert.ok(readAllExact(d, scan), "the same bytes again are exact");
+    fs.rmSync(path.join(d, "x/a.json")); assert.throws(() => readAllExact(d, scan), { code: "changed" });
+  } finally { fs.rmSync(d, { recursive: true, force: true }); }
+});
