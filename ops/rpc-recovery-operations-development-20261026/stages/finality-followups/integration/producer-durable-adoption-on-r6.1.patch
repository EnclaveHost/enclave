+def _dangling_proof(F, launch, lsha, entries, store, finality_dir, owner, top, W):
+    """r6.2 -> (finalitySeq, ref, number, blockHash, watermarkEntrySha256) of the ONE adoptable interrupted record, or None. Adoptable
+    only if: the store's LAST entry is a finality-proof not yet named by this launch's journal; everything before it is exactly this
+    launch's recorded proofs (launch_finality with it appended passes); and the finality journal holds exactly one `qualified` entry
+    with that sha, the same N and block, and no terminal entry. Anything else dangling refuses (root resolves it)."""
+    if not os.path.lexists(store):
+        return None
+    try:
+        es = W.watermark_entries(store, owner, top)
+    except AssertionError as e:
+        refuse('watermark', str(e))
+    try:
+        W.launch_finality(launch, lsha, entries, store, owner, top)
+        return None                                   # consistent: nothing dangling
+    except AssertionError:
+        pass
+    if not es or es[-1][1]['kind'] != 'finality-proof':
+        return None
+    t_sha, t = es[-1]
+    try:
+        W.launch_finality(launch, lsha, entries + [(None, {'event': 'bootstrapped', 'evidence': {'watermarkEntrySha256': t_sha}})], store, owner, top)
+    except AssertionError:
+        return None
+    try:
+        q = F.entries(finality_dir, lsha, top)
+    except F.Refused as e:
+        refuse('finality', str(e))
+    hit = [e for e in q if e.get('sha') == t['ref']]
+    if len(hit) != 1 or hit[0].get('event') != 'qualified' or any(e.get('event') in ('contradicted', 'revoked') for e in q) \
+            or ((hit[0].get('evidence') or {}).get('fresh', {}).get('N'), (hit[0].get('evidence') or {}).get('fresh', {}).get('blockHash')) != (t['number'], t['blockHash']):
+        refuse('watermark', 'a dangling finality-proof watermark entry names no qualified finality entry of this launch: root resolves it')
+    return hit[0]['seq'], t['ref'], t['number'], t['blockHash'], t_sha
+
