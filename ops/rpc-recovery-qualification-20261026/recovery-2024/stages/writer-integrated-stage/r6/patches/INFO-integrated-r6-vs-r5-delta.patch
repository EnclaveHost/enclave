+// integrated r6 fixture (root 1619/1621): ONE primary term per positive admin request. A primary WITH its relay (past any quiesce or
+// restart), a fresh majority round on that member (its lease renewed now), the package bound to its boot statement, and the request
+// sent only while the SAME member still leads the SAME epoch with a valid lease. A retry happens ONLY on a PROVEN loss of that term:
+// before sending (nothing was sent), or that member's own 409 not_primary (returned before any signature check, lock or write).
+// Bounded to `tries`; every other answer (403/409/422, 503 not_committed / outcome_unknown) is returned unchanged for the assertion.
+const termOf = (m) => ({ i: m.i, statementSha: m.role.statementSha, epoch: m.role.status().epoch });
+const holds = (m, t) => { const s = m.role.status(); return !m.stopped && s.role === "leader" && s.leaseValid === true && s.epoch === t.epoch && m.role.statementSha === t.statementSha; };
+async function onPrimary(make, { tries = 3 } = {}) {
+  const lost = [];
+  for (let k = 0; k < tries; k++) {
+    const m = await live(), t = termOf(m);
+    if ((await m.role.node().commit()) !== true || !holds(m, t)) { lost.push(`m${m.i} e${t.epoch}: no fresh majority round`); continue; }
+    const pkg = await make(m);
+    if (!holds(m, t)) { lost.push(`m${m.i} e${t.epoch}: term lost before sending`); continue; }
+    const r = await enroll(m, pkg);
+    if (r.status === 409 && r.json?.error === "not_primary" && !holds(m, t)) { lost.push(`m${m.i} e${t.epoch}: ${JSON.stringify(r.json)}`); continue; }
+    return { r, pkg, m };
+  }
+  throw new Error(`no primary held its term for one admin request in ${tries} attempts: ${lost.join("; ")}`);
+}
