+  return Object.freeze({ format: p.format, schedule, witness: Object.freeze({ ...p.witness }), targets: Object.freeze({ ...p.targets }),
+    rollupConfigTemplateFile: p.rollupConfigTemplateFile, rollupConfigTemplateSha256: p.rollupConfigTemplateSha256 });
+}
+/** witness-placement r2: the producer runs in the separate RPC VM, so its URL is the operator's OWN backend - a private IPv4
+ *  literal (the HOST_DATA-bound host-link forward, e.g. http://10.0.2.2:28747/witness) or a loopback literal - checked by the
+ *  existing network/chain-authority.mjs checkOwnBackend; never a name or public address. The bytes are untrusted either way. */
