+test('REAL transport to a producer on the private host-link address 10.0.2.2 (namespaced): exact request, bounded answer; bad answers refused', async () => {
+  const seen = []; let mode = 'ok';
+  const s = http.createServer(async (req, res) => {
+    let b = ''; for await (const c of req) b += c; seen.push({ method: req.method, url: req.url, ct: req.headers['content-type'], body: JSON.parse(b) });
+    if (mode === 'redirect') { res.writeHead(302, { location: 'http://8.8.8.8/' }); return res.end(); }
+    if (mode === 'json') { res.writeHead(200, { 'content-type': 'application/json' }); return res.end('{}'); }
+    if (mode === 'big') { res.writeHead(200, { 'content-type': 'application/octet-stream' }); return res.end(Buffer.alloc(2048)); }
+    if (mode === 'slow') return;                                                           // never answers
+    res.writeHead(200, { 'content-type': 'application/octet-stream' }); res.end(Buffer.from('witness-bytes'));
+  });
+  s.listen(0, '10.0.2.2'); await once(s, 'listening');
+  try {
+    const url = `http://10.0.2.2:${s.address().port}/witness`;
+    const w = createWitnessTransport({ url, timeoutMs: 1500, maxBytes: 1024 });
+    const req = { track: 'final', ticket: 'SECRET-TICKET', trusted: { chainId: 8453 }, agreedL2BlockNumber: 1, maximumWitnessBytes: 4096 };
+    assert.equal(Buffer.from(await w(req)).toString(), 'witness-bytes');
+    assert.deepEqual(Object.keys(seen[0].body), ['format', 'track', 'trusted', 'agreedL2BlockNumber', 'maximumWitnessBytes']);
+    assert.equal(seen[0].body.format, WITNESS_REQUEST_FORMAT); assert.equal(seen[0].body.maximumWitnessBytes, 1024);      // min(ticket, policy)
+    assert.ok(!JSON.stringify(seen[0]).includes('SECRET-TICKET'));                                                     // the ticket never leaves
+    for (const m of ['redirect', 'json', 'big', 'slow']) { mode = m; await assert.rejects(w(req), undefined, m); }
+  } finally { s.closeAllConnections?.(); s.close(); }
+});
