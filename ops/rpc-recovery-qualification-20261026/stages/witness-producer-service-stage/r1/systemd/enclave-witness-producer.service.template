# witness-producer-service-stage/r1 (PREPARED; NOT installed). OPT-IN: no [Install] target pulls it in; root enables it explicitly
# after the measured tests. Loopback-only, unprivileged; it can reach nothing but 127.0.0.1 (IPAddressDeny=any), so no public RPC
# can ever be a witness source, whatever the config says. @MEMORY_MAX@ is REQUIRED: set it from the measured fetch peak (never guessed).
[Unit]
Description=Enclave in-guest witness producer (loopback pull service for the derived reader driver; untrusted bytes, native decides)
After=enclave-witness-bridge-base.service enclave-witness-bridge-l1.service

[Service]
Type=simple
User=rpcwitness
Group=rpcwitness
ExecStart=/usr/bin/python3 -I -B /opt/enclave-rpc/witness/witness_producer.py serve --config /etc/enclave-rpc/witness-producer.json
StateDirectory=enclave-witness-producer
StateDirectoryMode=0700
Restart=no
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_INET AF_UNIX
IPAddressDeny=any
IPAddressAllow=localhost
LockPersonality=yes
MemoryMax=@MEMORY_MAX@
MemorySwapMax=0
TasksMax=64
UMask=0077
