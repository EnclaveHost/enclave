@@ -0,0 +1,98 @@
+// witness-placement r2 (PREPARED by Claude; NOT run): the witness producer lives in the separate RPC VM. Its URL must be the
+// operator's own backend (private IPv4 literal of the HOST_DATA-bound forward, or loopback), bound by BOTH the admin-signed driver
+// policy and the measured role's HOST_DATA composition. The transport test needs 10.0.2.2 on the namespace's lo (jobs/tests.sh).
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import http from 'node:http';
+import { once } from 'node:events';
+import fs from 'node:fs';
+import os from 'node:os';
+import path from 'node:path';
+import { createHash } from 'node:crypto';
+import { driverPolicy, createWitnessTransport, startReaderDriver, bindWitnessUrl, DRIVER_POLICY_FORMAT, WITNESS_REQUEST_FORMAT } from '../relay/derived-reader-driver-wiring.mjs';
+import { derivedReaderEndpoints, witnessForwardUrl, ownBackendLiteral, DERIVED_READER_ENDPOINTS_FORMAT } from '../metal/guest/measured-control.mjs';
+import { composeDerivedReader } from '../metal/guest/platform-api-role.mjs';
+
+const SCHEDULE = JSON.parse(process.env.WP_SCHEDULE || 'null');
+const FWD = 'http://10.0.2.2:28747/witness';
+const EP = { format: DERIVED_READER_ENDPOINTS_FORMAT, l1ConsensusUrl: 'http://10.0.2.2:25052', l1ExecutionUrl: 'http://10.0.2.2:28645', baseUrl: 'http://10.0.2.2:28545' };
+const PUBLICISH = ['http://8.8.8.8:8545/witness', 'http://example.com:80/witness', 'https://10.0.2.2:28747/witness', 'http://10.0.2.2/witness',
+  'http://u:p@10.0.2.2:28747/witness', 'http://10.0.2.2:28747/witness?x=1', 'http://10.0.2.2:28747/witness#f', 'http://0.0.0.0:28747/witness',
+  'http://169.254.1.1:28747/witness', 'http://100.64.0.1:28747/witness', 'http://172.32.0.1:28747/witness', 'http://10.0.2.2:28747/', 'ftp://10.0.2.2:28747/witness'];
+
+function policyWith(url, base) { return { ...base, witness: { ...base.witness, url } }; }
+
+test('driver witness URL: own private/loopback literal only; every public, named or malformed form refused', async () => {
+  const { readFileSync } = fs;
+  const base = JSON.parse(readFileSync(new URL('./fixtures/witness-placement-policy.json', import.meta.url), 'utf8'));
+  for (const ok of [FWD, 'http://127.0.0.1:9000/witness', 'http://192.168.1.5:9/w', 'http://172.16.0.1:9/w'])
+    assert.equal(driverPolicy(policyWith(ok, base)).witness.url, ok);
+  for (const bad of PUBLICISH) assert.throws(() => driverPolicy(policyWith(bad, base)), /own backend|not a URL/, bad);
+});
+
+test('both approvals must name the same producer: signed policy url == HOST_DATA-bound witnessUrl, else no transport or driver', async () => {
+  const base = JSON.parse(fs.readFileSync(new URL('./fixtures/witness-placement-policy.json', import.meta.url), 'utf8'));
+  const d = fs.mkdtempSync(path.join(os.tmpdir(), 'wp-')); const tpl = path.join(d, 't.json'); fs.writeFileSync(tpl, JSON.stringify({ l2_chain_id: 8453 }));
+  const p = { ...policyWith(FWD, base), rollupConfigTemplateFile: tpl };
+  for (const bound of [undefined, null, 'http://10.0.2.2:28748/witness', 'http://10.0.2.3:28747/witness', 'http://10.0.2.2:28747/other', FWD + '/']) {
+    let made = 0;
+    await assert.rejects(startReaderDriver({ policy: p, boundWitnessUrl: bound, reader: {}, journal: {}, journalPath: '/x', baseRequest: async () => null,
+      readFile: async (f) => fs.readFileSync(f), createDriver: () => { made++; return { start() {} }; }, createTransport: () => { made++; return async () => null; } }),
+      /HOST_DATA-bound derivedReader.witnessUrl/, String(bound));
+    assert.equal(made, 0, 'nothing is constructed without both approvals');
+  }
+  let made = null;
+  await startReaderDriver({ policy: p, boundWitnessUrl: FWD, reader: {}, journal: { readProvisional: () => null }, journalPath: '/x', baseRequest: async () => null,
+    readFile: async (f) => fs.readFileSync(f), createDriver: (o) => { made = o; return { start() {} }; }, createTransport: (w) => async () => w });
+  assert.ok(made && typeof made.witness === 'function');
+  assert.throws(() => bindWitnessUrl(driverPolicy(p), 'http://127.0.0.1:28747/witness'), /HOST_DATA-bound/);
+});
+
+test('HOST_DATA canonicaliser: optional witnessUrl, exact previous bytes when absent; loopback/public/named/malformed refused', () => {
+  assert.deepEqual(derivedReaderEndpoints(EP, { verifierBound: true }), EP);                       // absent = the previous output
+  assert.deepEqual(derivedReaderEndpoints({ ...EP, witnessUrl: FWD }, { verifierBound: true }), { ...EP, witnessUrl: FWD });
+  for (const bad of [...PUBLICISH, 'http://127.0.0.1:28747/witness', 'http://[::1]:28747/witness', 'http://localhost:28747/witness', 28747, null])
+    assert.throws(() => derivedReaderEndpoints({ ...EP, witnessUrl: bad }, { verifierBound: true }), /witnessUrl/, String(bad));
+  assert.throws(() => derivedReaderEndpoints({ ...EP, witness: FWD }, { verifierBound: true }));
+  assert.equal(witnessForwardUrl(FWD, ownBackendLiteral), true);
+});
+
+test('measured role compose: writes ONLY the bound witnessUrl; a template carrying one is tamper; an invalid bound one refuses', () => {
+  const d = fs.mkdtempSync(path.join(os.tmpdir(), 'wpr-'));
+  const tpl = { l1: { consensusUrl: null, executionUrl: null }, baseUrl: null, initializeState: false, stateDir: '/run/measured-control/platform-api/derived-reader-v3' };
+  const write = (t) => { const f = path.join(d, 'tpl.json'); fs.writeFileSync(f, JSON.stringify(t));
+    const img = path.join(d, 'img.json'); fs.writeFileSync(img, JSON.stringify({ format: 'enclave-derived-reader-image/v1', config: { path: f, sha256: createHash('sha256').update(fs.readFileSync(f)).digest('hex') },
+      private: { stateDir: tpl.stateDir }, roleEnv: {} })); return img; };
+  const root = path.join(d, 'root'); fs.mkdirSync(root);
+  const img = write(tpl);
+  composeDerivedReader({ cfg: { platformApi: { derivedReader: { ...EP, witnessUrl: FWD } } }, root, image: img });
+  assert.equal(JSON.parse(fs.readFileSync(path.join(root, 'derived-reader', 'derived-reader-v3.json'), 'utf8')).witnessUrl, FWD);
+  composeDerivedReader({ cfg: { platformApi: { derivedReader: EP } }, root, image: img });
+  assert.ok(!('witnessUrl' in JSON.parse(fs.readFileSync(path.join(root, 'derived-reader', 'derived-reader-v3.json'), 'utf8'))));
+  assert.throws(() => composeDerivedReader({ cfg: { platformApi: { derivedReader: EP } }, root, image: write({ ...tpl, witnessUrl: FWD }) }), (e) => e.code === 'derived_reader_tamper');
+  for (const bad of ['http://127.0.0.1:28747/witness', 'http://8.8.8.8:1/w', 'http://10.0.2.2:28747/'])
+    assert.throws(() => composeDerivedReader({ cfg: { platformApi: { derivedReader: { ...EP, witnessUrl: bad } } }, root, image: img }), (e) => e.code === 'derived_reader_endpoint', bad);
+});
+
+test('REAL transport to a producer on the private host-link address 10.0.2.2 (namespaced): exact request, bounded answer; bad answers refused', async () => {
+  const seen = []; let mode = 'ok';
+  const s = http.createServer(async (req, res) => {
+    let b = ''; for await (const c of req) b += c; seen.push({ method: req.method, url: req.url, ct: req.headers['content-type'], body: JSON.parse(b) });
+    if (mode === 'redirect') { res.writeHead(302, { location: 'http://8.8.8.8/' }); return res.end(); }
+    if (mode === 'json') { res.writeHead(200, { 'content-type': 'application/json' }); return res.end('{}'); }
+    if (mode === 'big') { res.writeHead(200, { 'content-type': 'application/octet-stream' }); return res.end(Buffer.alloc(2048)); }
