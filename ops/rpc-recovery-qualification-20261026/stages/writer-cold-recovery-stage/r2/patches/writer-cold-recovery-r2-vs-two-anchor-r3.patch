+// AUTHENTICATED BACKWARD LEASE HISTORY (writer-cold-recovery r2; root decision 1554/1556, review §Alt).
+// Every start's runtime-verified native coverage begins at the ASR bootstrap anchor N+1; lease claims older than N would be
+// unservable. This module recovers EVERY lease event of the signed ledgers in [floor, N] (floor INCLUSIVE) with no new trust:
+//   - N's block hash is the one authenticateAnchor bound to the ASR output root (proof.mjs authenticateBootstrap seed);
+//   - walking DOWN, each header's keccak(RLP) (vendor/anchor-bootstrap.mjs headerHash, Isthmus fields required) must equal
+//     its child's parentHash: a block hash commits to its parent, so every header down to the floor is authenticated by N;
+//   - a block is skipped ONLY when its authenticated logsBloom EXCLUDES the ledger address or EXCLUDES every lease topic0
+//     (a bloom has no false negatives: such a block holds no lease log of that ledger);
+//   - every other block: the complete ordered receipt list must reproduce receiptsRoot, blooms and gas total, with OP/Base
+//     typed and deposit receipts per pinned base v1.5.1 (network/op-receipts-root.mjs verifyBlockReceipts: log positions
+//     recomputed; an RPC logIndex is only accepted when equal), and every transaction hash is bound by recomputing
+//     transactionsRoot from the block's RAW transactions (keccak(raw) = the hash; a receipt alone never binds one).
+// The own node is untrusted transport. Nothing here is persisted as authority: the optional header cache is untrusted bytes,
+// re-hashed and re-linked from N on every use. Fail closed: missing, malformed, non-canonical, oversized, truncated, gapped,
+// mismatched-root or unsupported-type input refuses the whole scan.
+import { headerHash } from './vendor/anchor-bootstrap.mjs';
+import { verifyBlockReceipts, orderedTrieRoot, BASE_MAINNET } from '../op-receipts-root.mjs';
+import { LEASE_TOPICS } from './coverage.mjs';
+import fs from 'node:fs';
+import path from 'node:path';
+
+export const BACKWARD_HISTORY_FORMAT = 'enclave-derived-backward-lease-history/v1';
+export const BACKWARD_HISTORY_POLICY_FORMAT = 'enclave-lease16-backward-history-policy/v1';
+const HASH = /^0x[0-9a-f]{64}$/, ADDRESS = /^0x[0-9a-f]{40}$/, RAW = /^0x(?:[0-9a-f]{2})+$/;
+const uint = n => Number.isSafeInteger(n) && n >= 0;
+const lc = s => String(s).toLowerCase();
+const hex = n => `0x${n.toString(16)}`;
+const fail = (code, message) => { throw Object.assign(new Error(`backward history: ${message}`), { code }); };
+const bytesOf = h => Uint8Array.from(h.slice(2).match(/../g) || [], x => parseInt(x, 16));
+const toHex = b => '0x' + Array.from(b, x => x.toString(16).padStart(2, '0')).join('');
+
+/** The signed policy (in the reader binding only when configured; absent = disabled). */
+export function backwardHistoryPolicy(p) {
+  const keys = ['format', 'ledgers', 'floor', 'chunk', 'maxScanBlocks', 'maxLogs'];
+  if (!p || typeof p !== 'object' || Array.isArray(p) || Object.keys(p).length !== keys.length || keys.some(k => !Object.hasOwn(p, k)) ||
+      p.format !== BACKWARD_HISTORY_POLICY_FORMAT || !Array.isArray(p.ledgers) || !p.ledgers.length || p.ledgers.length > 4 ||
+      p.ledgers.some(a => !ADDRESS.test(a)) || new Set(p.ledgers).size !== p.ledgers.length || !uint(p.floor) || p.floor < 1 ||
+      !Number.isInteger(p.chunk) || p.chunk < 1 || p.chunk > 1024 || !Number.isInteger(p.maxScanBlocks) || p.maxScanBlocks < 1 || p.maxScanBlocks > 100_000_000 ||
+      !Number.isInteger(p.maxLogs) || p.maxLogs < 1 || p.maxLogs > 1_000_000) throw Error('invalid backward history policy');
+  return Object.freeze({ ...p, ledgers: Object.freeze([...p.ledgers].sort()) });
+}
+
+// ---- bloom membership (the exact bit selection of op-receipts-root.mjs bloomAdd) -----------------------------------------
+export function bloomMayContain(bloomHex, itemHex, keccak) {
+  const bloom = bytesOf(bloomHex), d = keccak(bytesOf(itemHex));
+  for (const i of [0, 2, 4]) { const bit = ((d[i] << 8) | d[i + 1]) & 2047; if (!(bloom[255 - (bit >> 3)] & (1 << (bit & 7)))) return false; }
+  return true;
+}
+/** may this authenticated header hold a lease log of one of the ledgers? false ONLY when the bloom excludes it */
+export const mayHoldLeaseLog = (logsBloom, ledgers, keccak) =>
+  ledgers.some(a => bloomMayContain(logsBloom, a, keccak)) && LEASE_TOPICS.some(t => bloomMayContain(logsBloom, t, keccak));
+
+// ---- untrusted header cache (never authority) --------------------------------------------------------------------------
+/** A private directory of header chunks keyed by their lowest number. Whatever it returns is re-verified by the scan. */
+export function fileHeaderCache(directory, { maxBytes = 2 << 30 } = {}) {
+  if (!path.isAbsolute(directory)) throw Error('header cache directory must be absolute');
+  fs.mkdirSync(directory, { recursive: true, mode: 0o700 });
+  const st = fs.lstatSync(directory);
+  if (!st.isDirectory() || st.isSymbolicLink() || st.uid !== process.getuid() || (st.mode & 0o077)) throw Error('header cache directory must be private');
+  const file = lo => path.join(directory, `headers-${lo}.json`);
+  const used = () => fs.readdirSync(directory).reduce((n, f) => n + fs.statSync(path.join(directory, f)).size, 0);
+  return Object.freeze({
+    get(lo) { try { const v = JSON.parse(fs.readFileSync(file(lo), 'utf8')); return Array.isArray(v) ? v : null; } catch { return null; } },
+    put(lo, headers) { const bytes = JSON.stringify(headers); if (used() + bytes.length <= maxBytes) { fs.writeFileSync(file(lo) + '.tmp', bytes, { mode: 0o600 }); fs.renameSync(file(lo) + '.tmp', file(lo)); } },
+    drop(lo) { fs.rmSync(file(lo), { force: true }); },
+  });
+}
+
+/**
+ * scanBackwardLeaseHistory({ request, anchor, ledgers, floor, keccak, signal, chunk, maxScanBlocks, maxLogs, cache, rawTransactions })
+ *   request(method, params, {signal}) the OWN node (untrusted transport, bounded); anchor { number, hash } AUTHENTICATED (ASR seed)
+ *   rawTransactions 'debug' (debug_getRawTransactions(blockHash)) | 'per-index' (eth_getRawTransactionByBlockHashAndIndex)
+ * -> frozen { format, anchor, floor, ledgers, logs (ascending; native coverage log shape), stats }
+ */
+export async function scanBackwardLeaseHistory({ request, anchor, ledgers, floor, keccak, signal, chunk = 256, maxScanBlocks, maxLogs,
+  cache = null, rawTransactions = 'debug', chain = BASE_MAINNET }) {
+  if (typeof request !== 'function' || typeof keccak !== 'function') fail('bad_input', 'request and keccak are required');
+  if (!anchor || !uint(anchor.number) || !HASH.test(lc(anchor.hash))) fail('no_anchor', 'an authenticated anchor {number, hash} is required');
+  if (!Array.isArray(ledgers) || !ledgers.length || ledgers.some(a => !ADDRESS.test(a))) fail('bad_input', 'ledgers must be lowercase addresses');
+  if (!uint(floor) || !Number.isInteger(chunk) || chunk < 1 || !Number.isInteger(maxScanBlocks) || !Number.isInteger(maxLogs)) fail('bad_input', 'invalid bounds');
+  if (!['debug', 'per-index'].includes(rawTransactions)) fail('bad_input', 'rawTransactions must be debug or per-index');
+  const top = anchor.number, collected = [], stats = { headers: 0, bloomHits: 0, receiptBlocks: 0, cacheHits: 0, cacheRejected: 0 };
+  if (floor > top) return freeze({ logs: [] });
+  if (top - floor + 1 > maxScanBlocks) fail('resource_bound', `scan of ${top - floor + 1} blocks exceeds maxScanBlocks ${maxScanBlocks}`);
+  let expectHash = lc(anchor.hash), expectNumber = top;
+  const fetchChunk = (lo, hi) => Promise.all(Array.from({ length: hi - lo + 1 }, (_, i) => request('eth_getBlockByNumber', [hex(lo + i), false], { signal })));
+  // verify one ascending chunk [lo, hi] DOWNWARD against the authenticated expectation; -> the per-block verified headers
+  const verifyChunk = (headers, lo, hi) => {
+    if (!Array.isArray(headers) || headers.length !== hi - lo + 1) fail('truncated', `header chunk ${lo}..${hi} is incomplete`);
+    const out = [];
+    let want = expectHash;
+    for (let n = hi; n >= lo; n--) {
+      const h = headers[n - lo];
+      if (!h || typeof h !== 'object') fail('missing', `header ${n} is missing`);
+      let hash;
+      try { hash = headerHash(h, keccak, { requireIsthmus: true }); } catch (e) { fail('malformed', `header ${n}: ${String(e?.message || e).slice(0, 160)}`); }
+      if (h.hash !== undefined && lc(h.hash) !== hash) fail('hash_claim', `header ${n}'s claimed hash is not keccak(RLP(header))`);
+      if (Number(BigInt(h.number)) !== n) fail('discontinuity', `header at ${n} names block ${h.number}`);
+      if (hash !== want) fail('unlinked', n === top ? 'the anchor header does not hash to the authenticated anchor' : `header ${n} is not the parent of ${n + 1} (non-canonical)`);
+      if (!HASH.test(lc(h.parentHash)) || !HASH.test(lc(h.receiptsRoot)) || !HASH.test(lc(h.transactionsRoot)) || !/^0x[0-9a-f]{512}$/.test(lc(h.logsBloom)))
+        fail('malformed', `header ${n} lacks parentHash, roots or a 256-byte bloom`);
+      out.push({ n, h, hash });
+      want = lc(h.parentHash);
+    }
+    return { out, want };
+  };
+  for (let hi = top; hi >= floor; hi -= chunk) {
+    signal?.throwIfAborted();
+    const lo = Math.max(floor, hi - chunk + 1);
+    let verified = null;
+    const cached = cache?.get(lo);
+    if (cached) {
+      try { verified = verifyChunk(cached, lo, hi); stats.cacheHits++; }
+      catch { stats.cacheRejected++; cache.drop(lo); }           // tampered or stale cache: discarded, fetched again
+    }
+    if (!verified) {
+      const fetched = await fetchChunk(lo, hi);
+      verified = verifyChunk(fetched, lo, hi);
+      if (cache) try { cache.put(lo, fetched); } catch { /* cache is optional */ }
+    }
+    for (const { n, h, hash } of verified.out) {
+      stats.headers++;
+      if (!mayHoldLeaseLog(lc(h.logsBloom), ledgers, keccak)) continue;
+      stats.bloomHits++;
+      const logs = await verifiedBlockLeaseLogs(h, hash, n);
+      for (let i = logs.length - 1; i >= 0; i--) collected.push(logs[i]);   // collected descending; reversed at the end
+      if (collected.length > maxLogs) fail('resource_bound', `more than ${maxLogs} lease logs`);
+    }
+    expectHash = verified.want; expectNumber = lo - 1;
+  }
+  if (expectNumber !== floor - 1) fail('gap', 'the scan did not reach the floor');
+  return freeze({ logs: collected.reverse() });
+
+  async function verifiedBlockLeaseLogs(header, blockHash, n) {
+    stats.receiptBlocks++;
+    const receipts = await request('eth_getBlockReceipts', [blockHash], { signal });
+    if (!Array.isArray(receipts)) fail('missing', `no receipt list for block ${n}`);
+    let raws;
+    if (rawTransactions === 'debug') raws = await request('debug_getRawTransactions', [blockHash], { signal });
+    else raws = await Promise.all(receipts.map((_, i) => request('eth_getRawTransactionByBlockHashAndIndex', [blockHash, hex(i)], { signal })));
+    if (!Array.isArray(raws) || raws.some(r => typeof r !== 'string' || !RAW.test(lc(r)))) fail('missing', `raw transactions of block ${n} are missing or malformed`);
+    const txs = raws.map(r => bytesOf(lc(r)));
+    if (orderedTrieRoot(txs, keccak) !== lc(header.transactionsRoot)) fail('root_mismatch', `raw transactions of block ${n} do not reproduce transactionsRoot`);
+    const txHashes = txs.map(t => toHex(keccak(t)));
+    let v;
+    try { v = verifyBlockReceipts({ header, expectedBlockHash: blockHash, receipts, txHashes, chain }, { keccak, headerHash: (x, k) => headerHash(x, k, { requireIsthmus: true }) }); }
+    catch (e) { fail(e?.code || 'receipts', `block ${n}: ${String(e?.message || e).slice(0, 200)}`); }
+    return v.logs.filter(l => ledgers.includes(l.address) && LEASE_TOPICS.includes(l.topics[0]))
+      .map(l => ({ address: l.address, blockNumber: l.blockNumber, blockHash: l.blockHash, logIndex: l.logIndex, topics: [...l.topics], data: l.data, txHash: l.transactionHash }));
+  }
+  function freeze({ logs }) {
+    const deep = o => { if (o && typeof o === 'object') { for (const v of Object.values(o)) deep(v); Object.freeze(o); } return o; };
+    return deep({ format: BACKWARD_HISTORY_FORMAT, anchor: { number: top, hash: lc(anchor.hash) }, floor, ledgers: [...ledgers], logs, stats: { ...stats } });
+  }
+}
