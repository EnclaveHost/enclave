+// ---- r5 (root 1606): RETAINED bytes, not only in-flight bytes ------------------------------------------------------------
+/** a node whose every call is counted while in flight (the scan's limiter frees its budget on resolution; this counts the node) */
+function counted(own, ms = 10) {
+  const st = { inFlight: 0, max: 0, started: 0, aborted: 0 };
+  const request = (m, p, o) => new Promise((resolve, reject) => {
+    st.started++; st.inFlight++; st.max = Math.max(st.max, st.inFlight);
+    let open = true;
+    const end = () => { if (!open) return false; open = false; st.inFlight--; o?.signal?.removeEventListener('abort', onAbort); return true; };
+    const onAbort = () => { if (end()) { clearTimeout(t); st.aborted++; reject(o.signal.reason); } };
+    const t = setTimeout(() => { if (end()) own.request(m, p, o).then(resolve, reject); }, ms);
+    o?.signal?.addEventListener('abort', onAbort, { once: true });
+  });
+  return { request, st };
+}
+const quiet = ms => new Promise(r => setTimeout(r, ms));
+/** a refused scan left nothing behind: nothing in flight at the rejection, nothing started afterwards, nothing committed */
+async function noStragglers(p, own, progress, code, top) {
+  await refuses(p, code);
+  assert.equal(own.st.inFlight, 0, 'every call of the refused batch settled before the rejection');
+  const started = own.st.started; await quiet(120);
+  assert.equal(own.st.started, started, 'no call started after the rejection'); assert.equal(own.st.inFlight, 0);
+  assert.equal(progress.nextHi, top, 'no progress was committed'); assert.equal(progress.collected.length, 0);
+}
