+  assert.equal(MAX_RETAINED_HEADER_BYTES, 8192);
+  const c = buildChain({ from: 1000, to: 1063 });
+  // every reply carries ~14 KB of non-hashed baggage (64 replies: ~0.9 MB in total, each far below the 4 MiB transport cap)
+  const baggage = (h) => ({ ...h, transactions: Array.from({ length: 200 }, (_, i) => `0x${(i + 1).toString(16).padStart(64, 'c')}`), size: '0x1', uncles: [] });
+  const fat = counted(node(c, { header: h => baggage(h) }));
+  // a chunk budget far below the baggage total but above 64 lean headers: it holds only because baggage is never retained
+  const r = await scan(c, fat, { chunk: 64, retainLimits: { chunkHeaderBytes: 160 << 10, blockRawHexBytes: RETAIN_LIMITS.blockRawHexBytes } });
+  assert.equal(r.stats.headers, 64); assert.deepEqual(r.logs, []);
+  assert.ok(64 * Buffer.byteLength(JSON.stringify(baggage(c.headers.get(1000)))) > (160 << 10), 'the replies together exceed the retained budget');
+  // the lean bytes themselves are bounded too: the same 64 lean headers under a 20 KiB chunk budget refuse, with no straggler
+  const progress = {}, slow = counted(node(c), 30);
