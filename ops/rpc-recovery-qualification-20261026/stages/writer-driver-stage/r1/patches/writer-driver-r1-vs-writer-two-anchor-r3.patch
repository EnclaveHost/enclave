+test('single flight across all tracks: one owned step at a time; urgent finality before cold recovery before routine finality', async () => {
+  let coldSteps = 0;
+  const cold = { needed: () => true, step: async () => { coldSteps++; return { done: false }; } };
+  const w = world({ cold, status: { baseAgeSec: 100 }, hints: { finalized: 5000, safe: 5000 } });
+  assert.equal((await w.driver.tick()).track, 'cold', 'cold recovery precedes routine finality');
+  assert.equal(coldSteps, 1); assert.deepEqual(w.names(), []);
+  const u = world({ cold, status: { baseAgeSec: 1600 } });
+  assert.equal((await u.driver.tick()).track, 'final', 'a due finalized deadline precedes cold recovery');
+  const g = world({ status: { baseAgeSec: 1600 } }); g.gate = {};
+  const first = g.driver.tick();
+  await new Promise(resolve => setImmediate(resolve));
+  await assert.rejects(g.driver.tick(), /single flight/);
+  assert.equal(g.driver.status().slot, 'final');
+  g.gate.release(); await first;
+  assert.deepEqual(g.names(), ['prepare', 'submit']);
+});
