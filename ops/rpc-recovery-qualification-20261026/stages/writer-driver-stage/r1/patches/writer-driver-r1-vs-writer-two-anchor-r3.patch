+test('shutdown cancels and AWAITS the owned run (the provider aborts its own native run); nothing runs afterwards', async () => {
+  const w = world({ status: { baseAgeSec: 1600 } }); w.gate = {};
+  w.driver.start();
+  await new Promise(resolve => setImmediate(resolve)); await new Promise(resolve => setImmediate(resolve));
+  assert.deepEqual(w.names(), ['prepare'], 'the submit is in flight');
+  await w.driver.stop();
+  assert.deepEqual(w.aborts, ['submit'], 'the owned run saw its abort signal');
+  assert.equal(w.driver.status().slot, 'stopped');
+  assert.equal((await w.driver.tick()).reason, 'stopping');
+  assert.deepEqual(w.names(), ['prepare'], 'no step after stop');
+  assert.equal(w.driver.status().failures.final, 0, 'a cancelled run is not counted as a failure');
+});
