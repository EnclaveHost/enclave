+test('bounded failures: oversized or unknown witnesses are never submitted; refusals halve the range and back off; busy is retry-later', async () => {
+  const big = world({ status: { baseAgeSec: 1600 }, witness: async () => 'x'.repeat(1001) });
+  const r = await big.driver.tick();
+  assert.match(r.error, /witness rejected before submit/); assert.deepEqual(big.names(), ['prepare']);
+  assert.equal(big.driver.status().failures.final, 1); assert.equal(big.driver.status().backoffUntil.final, T0 + 1000);
+  assert.equal((await big.driver.tick()).track, null, 'backing off: finality due but no retry storm');
+  const obj = world({ status: { baseAgeSec: 1600 }, witness: async () => ({ not: 'bytes' }) });
+  assert.match((await obj.driver.tick()).error, /unknown shape/); assert.deepEqual(obj.names(), ['prepare']);
+  const busy = world({ status: { baseAgeSec: 1600 }, prepare: () => { throw Error('derived provider busy'); } });
+  await busy.driver.tick();
+  assert.equal(busy.driver.status().failures.final, 0, 'busy is not failure evidence'); assert.equal(busy.driver.status().backoffUntil.final, T0 + 1000);
+  const bad = world({ status: { baseAgeSec: 1600 }, prepare: () => { throw Error('candidate source returned another block number'); } });
+  for (let i = 0; i < 3; i++) { await bad.driver.tick(); bad.t = bad.driver.status().backoffUntil.final; }
+  const s = bad.driver.status();
+  assert.equal(s.failures.final, 3); assert.equal(s.ranges.final, 10);
+  assert.match(s.staleReason, /paused after repeated failures/);
+});
