+test('cannotMeet120s: only a provider-confirmed S from this driver counts; 120 s is never relaxed; fixtures cannot make S fresh', async () => {
+  const w = world({ status: { provisional: PROV }, ev: EV(), sLagSec: 10, hints: { finalized: 1000, safe: 5000 } });
+  assert.equal(w.driver.status().cannotMeet120s, true);
+  await w.driver.tick();
+  let s = w.driver.status(); assert.equal(s.sAgeSec, 10); assert.equal(s.cannotMeet120s, false);
+  w.t += 110_000; s = w.driver.status(); assert.equal(s.sAgeSec, 120); assert.equal(s.cannotMeet120s, false, 'exactly 120 s still meets it');
+  w.t += 1000; assert.equal(w.driver.status().cannotMeet120s, true, '121 s does not');
+  w.st.provisional = { ...w.st.provisional, stateThrough: 999_999 };
+  w.t -= 100_000; assert.equal(w.driver.status().cannotMeet120s, true, 'a provider tip this driver did not produce is never taken as S');
+  const f = world({ status: { provisional: { ...PROV, stateThrough: 4000 } }, ev: EV() });
+  assert.equal(f.driver.status().cannotMeet120s, true, 'a fixture claiming an S without a driver result cannot enable it');
+});
