+                           ['full bytes', world({ status: { provisional: PROV }, ev: EV({ bytes: MAX_EVIDENCE_JOURNAL_BYTES }), hints: H })],
+                           ['durable marker', world({ status: { provisional: PROV }, ev: EV({ fenced: true }), hints: H })],
+                           ['provider fence', world({ status: { provisional: { ...PROV, fenced: { reason: 'contradiction' } } }, ev: EV(), hints: H })],
+                           ['unreadable evidence', world({ status: { provisional: PROV }, ev: () => { throw Error('closed'); }, hints: H })]]) {
+    assert.equal((await w.driver.tick()).track, null, name); assert.ok(!w.names().includes('prepareProvisional'), name);
