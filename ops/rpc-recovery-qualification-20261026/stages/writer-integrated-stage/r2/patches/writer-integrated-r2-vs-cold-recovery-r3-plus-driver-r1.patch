index 0000000000000000000000000000000000000000..9390c435be62e08163f9c8034bb0c6227598b05a
--- /dev/null
+++ b/relay/derived-reader-driver-wiring.mjs
@@ -0,0 +1,125 @@
+// writer-integrated-stage/r1: the production WIRING of the single-native-slot driver (relay/derived-reader-driver.mjs) into the
+// relay's ENROLLED derived reader. Loaded only inside the separate derived-reader runtime bundle (relay/derived-reader-runtime.mjs),
+// and started by relay/derived-writer-authority.mjs only on the enrolled-state branch when the reader config (the measured template
+// whose bytes the admin-signed binding covers) carries a `driver` section. Nothing here is authority: the provider and its pinned
+// native executable accept or refuse every result; the hints and the witness producer are untrusted inputs.
+//   effects supplied to the driver:
+//     targets  the OWN Base node (the role-bound baseUrl, untrusted): eth_getBlockByNumber('finalized'|'safe') numbers as hints only
+//     witness  a LOOPBACK-only pull transport to the in-guest witness producer; the one-shot ticket is never sent; capped, timed out,
+//              abortable, no redirects. The producer itself is NOT in this tree (concrete gap: logs/claude-writer-integrated-r1.md)
+//     evidence the role-committed anchor journal's provisional section (readProvisional) and its committed byte length
+//     cold     null: the provider's own authenticated backward-history scan already runs in the background (never duplicated; history r3:
+//              policy v2, bounded receipt concurrency, yields after each chunk/block but NOT worker-isolated: not "I/O only")
+//   writer-integrated r2: the Base rollup-config template is pinned TWICE: the signed policy carries its sha256 (rollupConfigTemplateSha256,
+//   checked here on the bytes read) and the platform-api role refuses a template whose driver section does not name the measured image
+//   record's files.rollupConfig {path, sha256} (metal/guest/platform-api-role.mjs). No such file ships yet: enabling is an explicit gate.
+import fs from 'node:fs';
+import path from 'node:path';
+import { createHash } from 'node:crypto';
+import { createDerivedReaderDriver, driverConfig } from './derived-reader-driver.mjs';
+
+export const DRIVER_POLICY_FORMAT = 'enclave-derived-reader-driver-policy/v2';   // v1 (r1, never shipped) refused
+export const WITNESS_REQUEST_FORMAT = 'enclave-derived-witness-request/v1';
+export const MAX_TEMPLATE_BYTES = 1 << 20, MAX_WITNESS_POLICY_BYTES = 128 << 20;
+const exact = (o, keys) => !!o && typeof o === 'object' && !Array.isArray(o) && Object.keys(o).length === keys.length && keys.every((k) => Object.hasOwn(o, k));
+const int = (v, lo, hi) => Number.isSafeInteger(v) && v >= lo && v <= hi;
+const LOOPBACK = new Set(['127.0.0.1', '[::1]']);
+
+/** The exact signed `driver` section. Throws on anything else (the relay then refuses to start). */
+export function driverPolicy(p) {
+  if (!exact(p, ['format', 'schedule', 'witness', 'targets', 'rollupConfigTemplateFile', 'rollupConfigTemplateSha256']) || p.format !== DRIVER_POLICY_FORMAT)
+    throw new Error('invalid derived reader driver policy (exact keys format, schedule, witness, targets, rollupConfigTemplateFile, rollupConfigTemplateSha256)');
+  const schedule = driverConfig(p.schedule);
+  if (!exact(p.witness, ['url', 'timeoutMs', 'maxBytes']) || !int(p.witness.timeoutMs, 1000, 3_600_000) || !int(p.witness.maxBytes, 1, MAX_WITNESS_POLICY_BYTES))
+    throw new Error('invalid driver witness transport policy');
+  witnessUrl(p.witness.url);
+  if (!exact(p.targets, ['timeoutMs']) || !int(p.targets.timeoutMs, 100, 60_000)) throw new Error('invalid driver targets policy');
+  if (typeof p.rollupConfigTemplateFile !== 'string' || !path.isAbsolute(p.rollupConfigTemplateFile) || path.resolve(p.rollupConfigTemplateFile) !== p.rollupConfigTemplateFile)
+    throw new Error('the rollup config template must be an absolute, canonical file path (a measured image file)');
+  if (typeof p.rollupConfigTemplateSha256 !== 'string' || !/^[0-9a-f]{64}$/.test(p.rollupConfigTemplateSha256))
+    throw new Error('the rollup config template sha256 must be 64 lowercase hex characters (the measured image record pin)');
+  return Object.freeze({ format: p.format, schedule, witness: Object.freeze({ ...p.witness }), targets: Object.freeze({ ...p.targets }),
+    rollupConfigTemplateFile: p.rollupConfigTemplateFile, rollupConfigTemplateSha256: p.rollupConfigTemplateSha256 });
+}
+/** Only an in-guest producer on loopback: no public or host endpoint is ever a witness source (it is untrusted either way). */
+function witnessUrl(url) {
+  let u; try { u = new URL(url); } catch { throw new Error('the driver witness URL is not a URL'); }
+  if (u.protocol !== 'http:' || !LOOPBACK.has(u.hostname) || !u.port || u.username || u.password || u.search || u.hash)
+    throw new Error('the driver witness producer must be a loopback http://127.0.0.1:<port>/<path> endpoint (in-guest, owned)');
+  return u;
+}
+
+/**
+ * createWitnessTransport({ url, timeoutMs, maxBytes }, { fetchImpl })
+ * -> async ({ track, trusted, agreedL2BlockNumber, maximumWitnessBytes, signal }) => Uint8Array
+ * POSTs { format, track, trusted, agreedL2BlockNumber, maximumWitnessBytes } (never the ticket) and reads at most
+ * min(maximumWitnessBytes, maxBytes) bytes of application/octet-stream. Anything else refuses; the bytes are only native input.
+ */
+export function createWitnessTransport({ url, timeoutMs, maxBytes }, { fetchImpl = fetch } = {}) {
+  const target = witnessUrl(url);
+  return async function witness({ track, trusted, agreedL2BlockNumber, maximumWitnessBytes, signal } = {}) {
+    if (!['final', 'provisional'].includes(track) || !trusted || typeof trusted !== 'object' || !int(agreedL2BlockNumber, 0, Number.MAX_SAFE_INTEGER) ||
+        !int(maximumWitnessBytes, 1, Number.MAX_SAFE_INTEGER)) throw new Error('invalid witness request');
+    const cap = Math.min(maximumWitnessBytes, maxBytes), controller = new AbortController();
+    const abort = () => controller.abort(signal.reason); signal?.addEventListener('abort', abort, { once: true });
+    const timer = setTimeout(() => controller.abort(new Error('witness producer deadline')), timeoutMs);
+    try {
+      signal?.throwIfAborted();
+      const response = await fetchImpl(target, { method: 'POST', redirect: 'error', signal: controller.signal, headers: { 'content-type': 'application/json' },
+        body: JSON.stringify({ format: WITNESS_REQUEST_FORMAT, track, trusted, agreedL2BlockNumber, maximumWitnessBytes: cap }) });
+      if (response.status !== 200) throw new Error(`witness producer answered HTTP ${response.status}`);
+      if (response.headers.get('content-type') !== 'application/octet-stream') throw new Error('witness producer answered another content type');
+      const declared = response.headers.get('content-length');
+      if (declared !== null && (!/^\d+$/.test(declared) || Number(declared) > cap)) throw new Error(`witness exceeds ${cap} bytes`);
+      const chunks = []; let size = 0;
+      for await (const part of response.body) {
+        size += part.length;
+        if (size > cap) { controller.abort(new Error('witness too large')); throw new Error(`witness exceeds ${cap} bytes`); }
+        chunks.push(part);
+      }
+      if (size === 0) throw new Error('witness producer answered no bytes');
+      return new Uint8Array(Buffer.concat(chunks));
+    } finally { clearTimeout(timer); signal?.removeEventListener('abort', abort); }
+  };
+}
+
+/** untrusted target hints from the own Base node: the block NUMBERS of its finalized and safe heads (never authority) */
+export function ownNodeTargets(request) {
+  const number = (b) => { try { const n = Number(BigInt(b?.number)); return Number.isSafeInteger(n) && n >= 0 ? n : null; } catch { return null; } };
+  return async ({ signal } = {}) => {
+    const [f, s] = await Promise.all(['finalized', 'safe'].map((tag) => request('eth_getBlockByNumber', [tag, false], { signal }).catch(() => null)));
+    return { finalized: number(f), safe: number(s) };
+  };
+}
+
+/** the provisional evidence view: the committed anchor journal's section and its committed byte length (throws = fail closed) */
+export function journalEvidence(journal, journalPath, { statImpl = fs.statSync } = {}) {
+  return () => {
+    if (typeof journal?.readProvisional !== 'function') throw new Error('the anchor journal has no provisional evidence section');
+    const p = journal.readProvisional();
+    return { states: p.states.length, facts: p.states.reduce((n, e) => n + e.facts.length, 0), bytes: statImpl(journalPath).size, fenced: p.fence !== null };
+  };
+}
+
+/**
+ * startReaderDriver({ policy, reader, journal, journalPath, baseRequest, readFile, now, log, createDriver, createTransport })
+ * Validates everything BEFORE anything runs; returns the started driver (stop() before closing the reader).
+ */
+export async function startReaderDriver({ policy, reader, journal, journalPath, baseRequest, readFile, now = Date.now, log = () => {},
+                                          createDriver = createDerivedReaderDriver, createTransport = createWitnessTransport } = {}) {
+  const p = driverPolicy(policy);
+  if (typeof baseRequest !== 'function') throw new Error('the driver needs the own Base node transport for its hints');
+  if (typeof readFile !== 'function') throw new Error('the driver needs readFile for its rollup config template');
+  const bytes = await readFile(p.rollupConfigTemplateFile);
+  if (!Buffer.isBuffer(bytes) || bytes.length > MAX_TEMPLATE_BYTES) throw new Error('the rollup config template is missing or larger than 1 MiB');
+  if (createHash('sha256').update(bytes).digest('hex') !== p.rollupConfigTemplateSha256)
+    throw new Error('the rollup config template is not the bytes the signed driver policy pins (rollupConfigTemplateSha256)');
+  let template; try { template = JSON.parse(bytes.toString('utf8')); } catch { throw new Error('the rollup config template is not JSON'); }
+  if (!template || typeof template !== 'object' || Array.isArray(template) || template.l2_chain_id !== 8453)
+    throw new Error('the rollup config template is not a Base (8453) rollup config object');
+  const driver = createDriver({ provider: reader, targets: ownNodeTargets(baseRequest), witness: createTransport(p.witness),
+    evidence: journalEvidence(journal, journalPath), cold: null, clock: { now }, rollupConfigTemplate: template, config: p.schedule });
+  driver.start();
+  log(`derived reader driver STARTED (single native slot; finality first; provisional only under the signed binding; witness producer ${p.witness.url}; no completeness or freshness claim)`);
+  return driver;
+}
