+/** the REAL provider over a header-by-number base, with its anchor journal file present (as in production: requireExisting) */
+async function wired(t, { gated = false, producer = 'ok' } = {}) {
+  const f = await readerFixture(t, { gated });
+  await f.reader.close();
+  const byNumber = { 101: f.h101, 102: f.h102, 103: f.h103, 104: f.h104 };
+  f.reader = await createDerivedProvider({ ...f.options, base: async (_m, p) => byNumber[Number(BigInt(p[0]))] });
+  fs.writeFileSync(f.lifecycleFile, JSON.stringify({ version: 1, deployments: [], authorityAnchors: {} }));
+  f.requests = [];
+  const url = await server(t, async (q, s) => {
+    const r = await body(q); f.requests.push(r);
+    if (producer === 'down') { s.writeHead(503); return s.end(); }
+    const headers = []; for (let n = r.agreedL2BlockNumber + 1; n <= r.trusted.claimedL2BlockNumber; n++) headers.push(byNumber[n]);
+    s.writeHead(200, { 'content-type': 'application/octet-stream' });
+    s.end(Buffer.from(JSON.stringify(result({ trusted: r.trusted, agreedL2BlockNumber: r.agreedL2BlockNumber }, headers))));
+  });
+  f.template = path.join(f.directory, 'base-rollup-template.json'); fs.writeFileSync(f.template, JSON.stringify(TEMPLATE));
+  f.hints = { finalized: 101, safe: 103 };
+  f.start = (manual = true) => startReaderDriver({ policy: policy(url, { rollupConfigTemplateFile: f.template, rollupConfigTemplateSha256: sha(fs.readFileSync(f.template)) }), reader: f.reader, journal: f.lifecycle,
+    journalPath: f.lifecycleFile, baseRequest: async (_m, [tag]) => ({ number: `0x${f.hints[tag].toString(16)}` }), readFile: p => fs.promises.readFile(p),
+    now: () => f.now, createDriver: manual ? o => ({ ...createDerivedReaderDriver(o), start() {} }) : createDerivedReaderDriver });
+  return f;
+}
