+test('REAL provider + REAL driver: finality first, the floor only from finalized runs, S only from the provisional track, strict 120 s, A2 marker stops it', async t => {
+  const f = await wired(t), d = await f.start();
+  t.after(() => d.stop());
+  assert.equal((await d.tick()).track, 'final', 'no served anchor: finality first (bootstraps the ASR root)');
+  assert.equal(f.journal.read().floor.base.number, 101);
+  assert.equal(f.requests[0].track, 'final'); assert.equal('ticket' in f.requests[0], false);
+  const p = await d.tick();
+  assert.deepEqual([p.track, p.status, p.target], ['provisional', 'provisional', 102]);
+  assert.equal(f.journal.read().floor.base.number, 101, 'a provisional run never moves the finalized floor');
+  assert.equal((await f.reader.readStateAnchor()).base.number, 102);
+  assert.equal(d.status().sAgeSec, 20); assert.equal(d.status().cannotMeet120s, false);
+  assert.equal((await d.tick()).reason, 'S is fresh');
+  // strict 120 s: the same S 121 s old is refused by the provider and reported by the driver; nothing relaxes it
+  f.now += 101_000;
+  await assert.rejects(f.reader.readStateAnchor(), /stale/);
+  assert.equal(d.status().sAgeSec, 121); assert.equal(d.status().cannotMeet120s, true);
+  // the A2 durable marker in the role-committed anchor journal stops the provisional track (no run is attempted)
+  await f.lifecycle.recordProvisionalFence({ reason: 'contradiction', block: 102, provisionalHash: f.h102.hash, finalizedHash: null, at: f.now });
+  const before = f.requests.length, r = await d.tick();
+  assert.equal(r.track, null); assert.match(r.reason, /durable marker/); assert.equal(f.requests.length, before);
+  assert.equal(journalEvidence(f.lifecycle, f.lifecycleFile)().fenced, true);
+});
