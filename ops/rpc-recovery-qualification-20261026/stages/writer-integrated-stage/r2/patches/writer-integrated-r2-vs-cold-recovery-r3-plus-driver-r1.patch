+test('witness transport: the exact request without the ticket; capped, typed, timed out, abortable, no redirects', async t => {
+  let seen, mode = 'ok';
+  const url = await server(t, async (q, s) => {
+    seen = { method: q.method, type: q.headers['content-type'], body: await body(q) };
+    if (mode === 'ok') { s.writeHead(200, { 'content-type': 'application/octet-stream' }); return s.end(Buffer.from('witness-bytes')); }
+    if (mode === '503') { s.writeHead(503); return s.end(); }
+    if (mode === 'json') { s.writeHead(200, { 'content-type': 'application/json' }); return s.end('{}'); }
+    if (mode === 'declared') { s.writeHead(200, { 'content-type': 'application/octet-stream', 'content-length': '64' }); return s.end(Buffer.alloc(64)); }
+    if (mode === 'chunked') { s.writeHead(200, { 'content-type': 'application/octet-stream' }); s.write(Buffer.alloc(20)); return s.end(Buffer.alloc(20)); }
+    if (mode === 'empty') { s.writeHead(200, { 'content-type': 'application/octet-stream' }); return s.end(); }
+    if (mode === 'redirect') { s.writeHead(302, { location: 'http://example.com/' }); return s.end(); }
+    // 'hang': never answers
+  });
+  const w = createWitnessTransport({ url, timeoutMs: 300, maxBytes: 32 });
+  const ask = { track: 'final', trusted: { l1Head: hash('l1') }, agreedL2BlockNumber: 100, maximumWitnessBytes: 1000 };
+  assert.equal(Buffer.from(await w(ask)).toString(), 'witness-bytes');
+  assert.deepEqual(seen, { method: 'POST', type: 'application/json', body: { format: WITNESS_REQUEST_FORMAT, track: 'final', trusted: { l1Head: hash('l1') },
+    agreedL2BlockNumber: 100, maximumWitnessBytes: 32 } }, 'no ticket; the cap is min(ticket cap, policy cap)');
+  for (const [m, re] of [['503', /HTTP 503/], ['json', /content type/], ['declared', /exceeds 32/], ['chunked', /exceeds 32/], ['empty', /no bytes/], ['redirect', /fetch failed|redirect/], ['hang', /deadline|abort/]]) {
+    mode = m; await assert.rejects(w(ask), re, m);
+  }
+  mode = 'hang'; const ac = new AbortController(); setTimeout(() => ac.abort(Error('driver stopping')), 20);
+  await assert.rejects(createWitnessTransport({ url, timeoutMs: 5000, maxBytes: 32 })({ ...ask, signal: ac.signal }), /driver stopping/);
+  await assert.rejects(w({ ...ask, track: 'other' }), /invalid witness request/);
+});
