index 0000000000000000000000000000000000000000..f4a8865e302f4d1b7e76cfc6f2f025e284f6f788
--- /dev/null
+++ b/test/derived-reader-driver-integration.test.mjs
@@ -0,0 +1,262 @@
+// writer-integrated-stage/r1: the driver WIRED to the enrolled derived reader (relay/derived-reader-driver-wiring.mjs, the runtime
+// exports and relay/derived-writer-authority.mjs startup/shutdown). FIXTURES: the fake L1 process, the echo native executable and a
+// loopback witness-producer fixture that answers with the native result the echo returns; they prove orchestration only, never
+// derivation, witness collection, own-node behaviour or timing. The real witness producer is NOT in the tree (concrete gap).
+// Shown: strict policy and loopback-only witness transport (the ticket is never sent; capped, timed out, abortable); the REAL
+// provider + REAL driver: finalized first, the journal floor only from finalized runs, S from the provisional track only under the
+// signed policy, the strict 120 s and the A2 durable marker; shutdown aborts an in-flight native run; producer outage is bounded;
+// the relay starts the driver only on the enrolled branch with the signed section, refuses every other combination, closes in order.
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import fs from 'node:fs';
+import os from 'node:os';
+import path from 'node:path';
+import http from 'node:http';
+import { once } from 'node:events';
+import { createHash } from 'node:crypto';
+import { driverPolicy, createWitnessTransport, startReaderDriver, ownNodeTargets, journalEvidence, DRIVER_POLICY_FORMAT, WITNESS_REQUEST_FORMAT } from '../relay/derived-reader-driver-wiring.mjs';
+import { createDerivedReaderDriver } from '../relay/derived-reader-driver.mjs';
+import { createDerivedProvider, derivedReaderBinding, startDerivedReader } from '../network/derived-reader/provider.mjs';
+import { sha256File } from '../network/derived-reader/process.mjs';
+import { derivedWriterAuthorityFromEnv, DERIVED_STATE_API } from '../relay/derived-writer-authority.mjs';
+import * as DS from '../metal/guest/derived-state.mjs';
+import { hash, TEMPLATE, result, readerFixture, l1Fixture } from './derived-reader/two-anchor-fixtures.mjs';
+import { composeDerivedReader } from '../metal/guest/platform-api-role.mjs';
+const sha = b => createHash('sha256').update(b).digest('hex');
+
+const SCHEDULE = Object.freeze({ finalizedDeadlineSec: 1800, finalMarginSec: 60, finalIntervalSec: 1, minFinalStep: 1, stateRefreshSec: 60, minStateIntervalSec: 1,
+  budgetSec: { final: 60, provisional: 30 }, minRange: 1, maxRange: { final: 1800, provisional: 100 }, retry: { baseMs: 10, maxMs: 100, maxConsecutive: 3 }, idleMs: 20 });
+const policy = (url, extra = {}) => ({ format: DRIVER_POLICY_FORMAT, schedule: SCHEDULE, witness: { url, timeoutMs: 5000, maxBytes: 64 << 20 }, targets: { timeoutMs: 1000 },
+  rollupConfigTemplateFile: '/opt/enclave/policy/base-rollup-template.json', rollupConfigTemplateSha256: 'ab'.repeat(32), ...extra });
+const until = async (cond, ms = 10000) => { const end = Date.now() + ms; while (!(await cond())) { if (Date.now() > end) throw Error('condition not reached'); await new Promise(r => setTimeout(r, 10)); } };
+async function server(t, handler) {
+  const s = http.createServer(handler); s.listen(0, '127.0.0.1'); await once(s, 'listening');
+  t.after(() => { s.closeAllConnections?.(); s.close(); });
+  return `http://127.0.0.1:${s.address().port}/witness`;
+}
+const body = async q => { const a = []; for await (const c of q) a.push(c); return JSON.parse(Buffer.concat(a)); };
+
+test('policy: exact signed section; the witness producer only on loopback; the template a canonical absolute file', () => {
+  assert.equal(driverPolicy(policy('http://127.0.0.1:9000/witness')).witness.url, 'http://127.0.0.1:9000/witness');
+  for (const url of ['https://127.0.0.1:9000/w', 'http://10.0.2.2:9000/w', 'http://example.com:80/w', 'http://127.0.0.1/w', 'http://127.0.0.1:9000/w?x=1', 'http://u:p@127.0.0.1:9000/w', 'ftp://127.0.0.1:9/w'])
+    assert.throws(() => driverPolicy(policy(url)), /loopback|not a URL/, url);
