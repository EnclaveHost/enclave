+  fs.writeFileSync(path.join(d, 'reader.json'), JSON.stringify(readerConfig));
+  fs.writeFileSync(R, JSON.stringify({ format: 'enclave-derived-root-journal/v1', binding: BINDING, floor: null, entries: [], enrollment: { digest: DG, phase: 'committed' } }));
+  fs.writeFileSync(path.join(d, 'state.json'), JSON.stringify({ format: DS.STATE_FORMAT, enrollment: { mode: 'genesis', digest: DG, binding: BINDING, highWater: null },
+    files: [{ rel: 'reader/derived-state.json', path: R }, { rel: BR, path: J }], journalDir: JD, coverageDir: path.join(d, 'coverage', BINDING), runsDir: path.join(d, 'runs'),
+    paths: { 'reader/derived-state.json': R, [BR]: J }, commit: { protocol: DS.COMMIT_PROTOCOL, boot: 'a'.repeat(32) } }));
+  const calls = [], journal = { journal: true };
+  const fresh = { getBlockNumber: async () => 1n, request: async () => [], readContract: async () => '0x' + '66'.repeat(20) };
+  const service = { reader: { readDerivedLogs: async () => { throw Error('unused'); } }, snapshot: async () => { throw Error('unused'); }, close: async () => { calls.push('service.close'); } };
+  const runtime = { DERIVED_STATE_API, derivedReaderBinding: () => BINDING, derivedEnrollmentFloorDigest: DS.floorDigestOf, enrollDerivedState: async () => { throw Error('no'); },
+    openLifecycleJournal: () => journal, startDerivedLifecycleReader: async (c) => { calls.push(['reader.start', Object.keys(c).includes('driver')]); return service; },
+    boundedRpc: (url, o) => { calls.push(['boundedRpc', url, o.maxBytes]); return async () => null; },
+    startReaderDriver: async (o) => { calls.push(['driver.start', o.reader === service.reader, o.journal === journal, o.journalPath === J, typeof o.baseRequest]);
+      return { stop: async () => { calls.push('driver.stop'); }, status: () => ({ slot: 'idle' }) }; }, ...runtimeExtra };
+  const env = { ENCLAVE_WRITER_AUTHORITY_SOURCE: 'derived', ENCLAVE_DERIVED_READER_CONFIG: path.join(d, 'reader.json'), ENCLAVE_DERIVED_ANCHOR_JOURNAL: J,
+    ENCLAVE_DERIVED_STATE: path.join(d, 'state.json'), ENCLAVE_DERIVED_COMMIT_BOOT: 'a'.repeat(32), ADDRESS_BOOK_ADDRESS: '0x' + '77'.repeat(20) };
+  const opts = { relayChain: { client: fresh }, readFile: (f, e) => fs.promises.readFile(f, e), loadRuntime: async () => runtime,
+    createCommitter: () => ({ commit: async () => true, verifyEnrollment: async () => ({}), status: () => ({}) }), log: () => {} };
+  return { env, opts, calls, J };
+}
