   assert.deepEqual(derivedReaderEndpoints({ ...EP, witnessUrl: FWD }, { verifierBound: true }), { ...EP, witnessUrl: FWD });
   for (const bad of [...PUBLICISH, 'http://127.0.0.1:28747/witness', 'http://[::1]:28747/witness', 'http://localhost:28747/witness', 28747, null])
     assert.throws(() => derivedReaderEndpoints({ ...EP, witnessUrl: bad }, { verifierBound: true }), /witnessUrl/, String(bad));
-  assert.throws(() => derivedReaderEndpoints({ ...EP, witness: FWD }, { verifierBound: true }));
+  // integrated r4 (root 1612): absent is NOT missing (above); a PRESENT key is validated even when undefined; unknown and missing
+  // required keys are refused exactly as before, with or without witnessUrl
+  assert.throws(() => derivedReaderEndpoints({ ...EP, witnessUrl: undefined }, { verifierBound: true }), /witnessUrl must be/);
+  assert.throws(() => derivedReaderEndpoints({ ...EP, witness: FWD }, { verifierBound: true }), /unknown field\(s\): witness$/);
+  assert.throws(() => derivedReaderEndpoints({ ...EP, witnessUrl: FWD, extra: 1 }, { verifierBound: true }), /unknown field\(s\): extra/);
+  for (const ep of [EP, { ...EP, witnessUrl: FWD }])
+    assert.throws(() => derivedReaderEndpoints((({ baseUrl, ...r }) => r)(ep), { verifierBound: true }), /is missing: baseUrl$/);
+  assert.equal(JSON.stringify(derivedReaderEndpoints(EP, { verifierBound: true })), JSON.stringify(EP), 'absent: the exact previous bytes (key order too)');
   assert.equal(witnessForwardUrl(FWD, ownBackendLiteral), true);
 });
 
