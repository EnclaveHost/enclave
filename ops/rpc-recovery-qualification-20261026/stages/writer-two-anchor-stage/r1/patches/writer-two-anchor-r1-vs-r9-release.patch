+
+test("anchor binding: relabelled tiers, a state anchor not after B_f, mismatched snapshot blocks or a moved ledger refuse", async () => {
+  await refuses(authority(world({ evidence: { tier: CLAIM_TIER, claimTier: CLAIM_TIER } })).writerAuthority(ID), "anchor_mismatch");
+  await refuses(authority(world({ evidence: { tier: STATE_TIER } })).writerAuthority(ID), "anchor_mismatch");
+  await refuses(authority(world({ snapState: { blockHash: h("ee") } })).writerAuthority(ID), "anchor_mismatch");
