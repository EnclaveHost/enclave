+// writer-two-anchor-stage/r1: relay/derived-writer-authority.mjs in TWO-ANCHOR mode (capability.stateSnapshot), ADAPTER LOGIC ONLY.
+// The capability is an in-test fake: its `complete: true` and its anchors prove nothing; these tests show what the adapter does WITH
+// a finalized claim anchor B_f and a provisional state anchor S (claim finality, 120 s on S, B_f liveness, complete coverage through
+// S, deny-only verifier, selector). The reader side (attested L1, RAM-only overlay, reorg discard) is test/derived-reader/two-anchor.test.mjs.
+import { test } from "node:test";
+import assert from "node:assert/strict";
+import { CLAIMED, RENEWED, RELEASED, LeaseGenerationError } from "../relay/lease-generation.mjs";
+import { createDerivedWriterAuthority, derivedWriterAuthorityFromEnv, MAX_ANCHOR_AGE_SEC, MAX_FINALIZED_AGE_SEC, STATE_TIER, CLAIM_TIER } from "../relay/derived-writer-authority.mjs";
+
+const h = (b, n = 32) => "0x" + b.repeat(n);
+const ID = h("11"), RUNNER = h("22"), OTHER_RUNNER = h("33"), OP = "0x" + "44".repeat(20), OP2 = "0x" + "55".repeat(20);
+const LEDGER = "0x" + "66".repeat(20), LEDGER2 = "0x" + "67".repeat(20), BOOK = "0x" + "77".repeat(20);
+const O = 53_000_000, BF = O + 1_000, S = O + 1_300, HF = h("af"), HS = h("a5"), NOW = 1_700_000_000;
+const TF = NOW - 900, TS = NOW - 30;                     // a typical finalized lag, a provisional state anchor 30 s old
+const word = (n) => BigInt(n).toString(16).padStart(64, "0");
+const pad = (a) => "0x" + "0".repeat(24) + a.slice(2);
+let seq = 0;
+const tx = () => "0x" + (++seq).toString(16).padStart(64, "0");
+const bh = (n) => "0x" + n.toString(16).padStart(64, "c");
+const claimed = (n, i, until, { runner = RUNNER, op = OP } = {}) =>
+  ({ address: LEDGER, blockNumber: O + n, blockHash: bh(O + n), logIndex: i, topics: [CLAIMED, ID, runner, pad(op)], data: "0x" + word(until) + word(5), txHash: tx() });
+const renewed = (n, i, until, { runner = RUNNER } = {}) =>
+  ({ address: LEDGER, blockNumber: O + n, blockHash: bh(O + n), logIndex: i, topics: [RENEWED, ID, runner], data: "0x" + word(until) + word(5), txHash: tx() });
+const released = (n, i) => ({ address: LEDGER, blockNumber: O + n, blockHash: bh(O + n), logIndex: i, topics: [RELEASED, ID, RUNNER], data: "0x" + word(7), txHash: tx() });
+const row = (o = {}) => ({ id: ID, owner: OP, appRef: "", ports: "", configCid: "", gpuMilli: 0, cpuMilli: 1, appPort: 80, isPublic: false, active: true,
+  createdAt: 1n, rate: 1n, balance6: 1n, spent6: 1n, runner: RUNNER, runnerOperator: OP, leaseUntil: BigInt(NOW + 1200), ...o });
+const NONE = row({ id: h("00") });
+
+/** A fake two-anchor world: rows/book at B_f and at S, the complete lease logs through S, the deny-only verifier after S. */
+function world({ logs = [claimed(950, 3, NOW + 1200)], rowF = row(), rowS = row(), bookF = LEDGER, bookS = bookF, schema = 16, availableFrom = O + 900,
+                 availableTo = S, tf = TF, ts = TS, sNumber = S, snapState = {}, evidence = { tier: STATE_TIER, claimTier: CLAIM_TIER },
+                 later = [], headRow, headBook = bookS, head = S + 50, mutate = (r) => r, readerFails = null } = {}) {
+  const calls = [];
+  const side = (name, B, hash, time, book, r) => ({
+    number: BigInt(B),
+    client: {
+      getBlock: async () => ({ number: BigInt(B), hash, timestamp: BigInt(time) }),
+      readContract: async ({ address, functionName }) => {
+        calls.push([name, functionName, address]);
+        if (functionName === "addr") { assert.equal(address, BOOK); return book; }
+        if (functionName === "deploymentsSchema") return BigInt(schema);
+        if (functionName === "get") return address === LEDGER ? r : NONE;
+        throw new Error(functionName);
+      },
+    },
+  });
+  const capability = {
+    async snapshot() { calls.push(["legacy-snapshot"]); throw new Error("the single-anchor snapshot must not be used in two-anchor mode"); },
+    async stateSnapshot(read) {
+      calls.push(["stateSnapshot"]);
+      const value = await read({ claim: side("claim", BF, HF, tf, bookF, rowF), state: side("state", sNumber, HS, ts, bookS, rowS) });
+      return { blockNumber: BigInt(BF), blockHash: HF, value, state: { blockNumber: BigInt(sNumber), blockHash: HS, ...snapState }, evidence };
+    },
+    async readDerivedLogs(q) {
+      calls.push(["logs", q.fromBlock, q.toBlock, q.anchor.number]);
+      if (readerFails) throw new Error(readerFails);
+      if (q.anchor.number !== sNumber || q.anchor.hash !== HS) throw new Error("anchor is not current");
+      if (q.fromBlock < availableFrom) throw new Error("requested history is outside runtime-verified coverage");
+      const sel = logs.filter((l) => l.blockNumber >= q.fromBlock && l.blockNumber <= q.toBlock);
+      return mutate({ format: "enclave-derived-logs/v1", logs: sel, anchor: { tier: STATE_TIER, base: { number: sNumber, hash: HS } },
+        filter: { address: q.address, topic0s: q.topic0s, topic1: q.topic1, fromBlock: q.fromBlock, toBlock: q.toBlock },
+        coverage: { format: "enclave-lease16-coverage/v1", filterId: "lease16-events/v1", fromBlock: q.fromBlock, toBlock: q.toBlock, complete: true,
+                    availableFromBlock: availableFrom, availableToBlock: availableTo } }, q);
+    },
+  };
+  const fresh = {
+    getBlockNumber: async () => BigInt(head),
+    request: async ({ method, params }) => { calls.push(["fresh", method, params[0].fromBlock]); assert.equal(method, "eth_getLogs"); return later; },
+    readContract: async ({ functionName }) => functionName === "addr" ? headBook : (headRow ?? rowS),
+  };
+  return { capability, fresh, calls };
+}
+const authority = (w, o = {}) => createDerivedWriterAuthority({ capability: w.capability, fresh: w.fresh, addressBook: BOOK, now: () => NOW * 1000, ...o });
+const refuses = async (p, code) => {
+  await assert.rejects(p, (e) => { assert.ok(e instanceof LeaseGenerationError, String(e)); assert.equal(e.code, code, e.message); return true; });
+};
+
+test("two anchors: the FINAL claim's unchanged lease16 fact, current-ness at S, coverage asked at S, deny-only after S", async () => {
+  const w = world({ logs: [claimed(950, 3, NOW + 600), renewed(1200, 0, NOW + 1200)], rowF: row({ leaseUntil: BigInt(NOW + 600) }) });
+  const r = await authority(w).writerAuthority(ID, { runner: RUNNER });
+  assert.equal(r.factJson, JSON.stringify({ source: "lease16", chainId: 8453, ledger: LEDGER, deployment: ID, claimBlock: O + 950, claimLogIndex: 3 }));
+  assert.deepEqual(r.block, { number: S, hash: HS, time: TS, finalized: BF });
+  assert.deepEqual(r.evidence, { authority: "consumer-domain-derivation", tier: "l1-attested-derived", claimTier: "l1-finalized-derived", coverageFromBlock: O + 900,
+    finalized: { number: BF, hash: HF, time: TF }, state: { number: S, hash: HS, time: TS } });
+  assert.deepEqual(w.calls.filter((c) => c[0] === "logs"), [["logs", S, S, S], ["logs", O + 900, S, S]]);
+  assert.deepEqual(w.calls.filter((c) => c[0] === "fresh"), [["fresh", "eth_getLogs", "0x" + (S + 1).toString(16)]]);
+  assert.ok(!w.calls.some((c) => c[0] === "legacy-snapshot"));
+  assert.ok(w.calls.some((c) => c[0] === "claim" && c[1] === "get") && w.calls.some((c) => c[0] === "state" && c[1] === "get"), "the row is read at BOTH anchors");
+});
+
+test("the 120 s ceiling applies to S unchanged: 120 accepted, 121 refused, +5 accepted, +6 refused; never raised; refused before the verifier", async () => {
+  assert.equal(MAX_ANCHOR_AGE_SEC, 120);
+  assert.equal((await authority(world({ ts: NOW - 120 })).writerAuthority(ID)).block.time, NOW - 120);
+  await refuses(authority(world({ ts: NOW - 121 })).writerAuthority(ID), "stale_snapshot");
+  assert.ok(await authority(world({ ts: NOW + 5 })).writerAuthority(ID));
+  await refuses(authority(world({ ts: NOW + 6 })).writerAuthority(ID), "stale_snapshot");
+  for (const bad of [121, 600, 3600]) assert.throws(() => authority(world(), { maxAnchorAgeSec: bad }), /maxAnchorAgeSec must be 1\.\.120/);
+  const w = world({ ts: NOW - 121, head: S + 10_000 });          // a much newer unsafe head never refreshes S
+  await refuses(authority(w).writerAuthority(ID), "stale_snapshot");
+  assert.ok(!w.calls.some((c) => c[0] === "fresh"));
+});
+
+test("B_f has its own liveness bound: an old finalized anchor refuses even with a fresh S; S never refreshes it", async () => {
+  assert.ok(await authority(world({ tf: NOW - 1800 })).writerAuthority(ID));
+  await refuses(authority(world({ tf: NOW - 1801 })).writerAuthority(ID), "stale_finalized");
+  await refuses(authority(world({ tf: NOW - 900 }), { maxFinalizedAgeSec: 600 }).writerAuthority(ID), "stale_finalized");
+  await refuses(authority(world({ tf: NOW + 6 })).writerAuthority(ID), "stale_finalized");
+  for (const bad of [0, MAX_FINALIZED_AGE_SEC + 1, 1.5, "600"]) assert.throws(() => authority(world(), { maxFinalizedAgeSec: bad }), /maxFinalizedAgeSec/);
+});
+
+test("claim finality: a claim anywhere in (B_f, S] is claim_not_final, never a fact; a claim AT B_f is final", async () => {
+  for (const n of [1001, 1150, 1300]) {
+    const c = claimed(n, 0, NOW + 1200, { runner: OTHER_RUNNER, op: OP2 });
+    const w = world({ logs: [claimed(950, 3, NOW + 600), O + n === S ? { ...c, blockHash: HS } : c],
+                      rowS: row({ runner: OTHER_RUNNER, runnerOperator: OP2 }) });
+    await refuses(authority(w).writerAuthority(ID), "claim_not_final");
+    assert.ok(!w.calls.some((c) => c[0] === "fresh"), "refused before the deny-only check");
+  }
+  await refuses(authority(world({ logs: [claimed(1100, 0, NOW + 1200, { runner: OTHER_RUNNER, op: OP2 })], rowS: row({ runner: OTHER_RUNNER, runnerOperator: OP2 }) }))
+    .writerAuthority(ID, { runner: RUNNER }), "runner_mismatch");
+  assert.equal((await authority(world({ logs: [claimed(1000, 7, NOW + 1200)] })).writerAuthority(ID)).fact.claimBlock, BF);
+});
+
+test("same-runner release + re-claim in (B_f, S]: the rows at B_f and S look identical, only the complete coverage shows it -> claim_not_final", async () => {
+  const logs = [claimed(950, 3, NOW + 1200), released(1050, 0), claimed(1100, 1, NOW + 1200)];
+  const w = world({ logs, rowF: row(), rowS: row() });
