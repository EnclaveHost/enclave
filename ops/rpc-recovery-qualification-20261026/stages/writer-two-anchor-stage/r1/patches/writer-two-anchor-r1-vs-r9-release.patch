+  // the row alone is never accepted: the coverage is always asked through S, never only up to B_f
+  assert.deepEqual(w.calls.filter((c) => c[0] === "logs").map((c) => c[2]), [S, S]);
+});
+
+test("positive coverage: a Released in (B_f, S] refuses (row released at S), and a replay through B_f must agree with the row at B_f", async () => {
+  await refuses(authority(world({ logs: [claimed(950, 3, NOW + 1200), released(1200, 0)], rowS: row({ active: false, runner: h("00"), runnerOperator: "0x" + "00".repeat(20) }) }))
+    .writerAuthority(ID), "lease_not_current");
+  await refuses(authority(world({ logs: [claimed(950, 3, NOW + 1200), released(1200, 0)] })).writerAuthority(ID), "inconsistent_logs");
+  await refuses(authority(world({ rowF: row({ runner: OTHER_RUNNER }) })).writerAuthority(ID), "claim_not_final");
+  await refuses(authority(world({ rowF: row({ active: false }) })).writerAuthority(ID), "claim_not_final");
+  await refuses(authority(world({ rowF: row({ leaseUntil: BigInt(NOW + 999) }) })).writerAuthority(ID), "inconsistent_logs");
+});
+
+test("incomplete coverage through S refuses (coverage_incomplete); coverage starting after B_f is claim_not_covered", async () => {
+  await refuses(authority(world({ readerFails: "provisional coverage gap or overlap" })).writerAuthority(ID), "coverage_incomplete");
+  await refuses(authority(world({ readerFails: "requested history is outside runtime-verified coverage" })).writerAuthority(ID), "coverage_incomplete");
+  await refuses(authority(world({ availableTo: S - 1 })).writerAuthority(ID), "coverage_incomplete");
+  await refuses(authority(world({ mutate: (r) => ({ ...r, coverage: { ...r.coverage, complete: false } }) })).writerAuthority(ID), "coverage_incomplete");
