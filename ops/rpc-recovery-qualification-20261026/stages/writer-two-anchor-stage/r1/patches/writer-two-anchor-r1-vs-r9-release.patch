+  await refuses(two.writerAuthority(ID), "stale_finalized");                     // the reader config's 600 s bounds B_f (900 s old)
+  // the same world without the runtime's stateSnapshot, plus any env knob: the legacy single finalized anchor, which stays refused
+  const legacy = world({ sNumber: BF });                                        // its logs answer at the single anchor (BF, hash HS)
+  const one = await derivedWriterAuthorityFromEnv({ ...base, ENCLAVE_DERIVED_PROVISIONAL: "1", ENCLAVE_WRITER_AUTHORITY_TIER: "l1-attested-derived" },
