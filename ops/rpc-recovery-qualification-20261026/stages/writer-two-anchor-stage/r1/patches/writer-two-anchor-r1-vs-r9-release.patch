+
+test("selector: two anchors only when the runtime's service carries stateSnapshot (signed binding); no env enables it; legacy default unchanged", async () => {
+  const base = { ENCLAVE_WRITER_AUTHORITY_SOURCE: "derived", ENCLAVE_DERIVED_READER_CONFIG: "/etc/r.json", ENCLAVE_DERIVED_ANCHOR_JOURNAL: "/var/j", ADDRESS_BOOK_ADDRESS: BOOK };
