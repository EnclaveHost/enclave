+  const blocks = headers.map(h => ({ ...anchorOf(h, {}).base, receiptsRoot: h.receiptsRoot, transactionsRoot: h.transactionsRoot }));
+  return { ...nativeResult(ticket, headers.at(-1)), format: 'enclave-base-derivation-result/v3',
+    intermediateRoots: '0x' + blocks.map(b => b.outputRoot.slice(2)).join(''),
+    coverage: { format: COVERAGE_FORMAT, filterId: FILTER_ID, fromBlock: blocks[0].number, toBlock: blocks.at(-1).number, blocks, logs } };
+}
+
+/** The owned L1 runtime over a fixture process that serves `finalized` (900 s old) and `latest` (attested, 20 s old) separately.
+ *  gated: the echo native waits until f.openGate() (a native run that stays in flight for as long as a test needs). */
+export async function l1Fixture(t, { gated = false } = {}) {
+  const directory = fs.mkdtempSync(path.join(os.tmpdir(), 'two-anchor-test-'));
+  const f = { directory, now: Date.now(), l1: null };
+  t.after(async () => { await f.l1?.close(); fs.rmSync(directory, { recursive: true, force: true }); });
+  const server = net.createServer(); server.listen(0, '127.0.0.1'); await once(server, 'listening');
+  const port = server.address().port; await new Promise(resolve => server.close(resolve));
+  const seconds = Math.floor(f.now / 1000);
