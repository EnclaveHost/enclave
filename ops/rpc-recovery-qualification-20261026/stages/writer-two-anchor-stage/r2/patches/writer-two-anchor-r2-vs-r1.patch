+// Shared FIXTURES for the two-anchor reader suites (writer-two-anchor-stage r1/r2). Transport/composition only, exactly as
+// helpers.mjs: the fake L1 process (it serves distinct `finalized` and `latest` headers) and the echo native executable are NEVER
+// evidence of consensus verification, of the real Helios attested-head lag, of native derivation or of its timing (M1-M6 unmeasured).
+import fs from 'node:fs';
+import os from 'node:os';
+import path from 'node:path';
