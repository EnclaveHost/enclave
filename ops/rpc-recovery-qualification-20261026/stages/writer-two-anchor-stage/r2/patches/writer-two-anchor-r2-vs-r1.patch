+import { startL1Runtime } from '../../network/derived-reader/l1-runtime.mjs';
+import { createDerivedProvider } from '../../network/derived-reader/provider.mjs';
+import { openDerivedJournal } from '../../network/derived-reader/journal.mjs';
+import { openCoverageStore } from '../../network/derived-reader/coverage-store.mjs';
+import { LEASE_TOPICS, COVERAGE_FORMAT, FILTER_ID } from '../../network/derived-reader/coverage.mjs';
+import { sha256File } from '../../network/derived-reader/process.mjs';
+import { provisionalEvidence } from '../../network/derived-reader/lifecycle.mjs';
+import { openLifecycleJournal } from '../../network/deployment-lifecycle-journal.mjs';
+import { header, anchorOf, nativeResult } from './helpers.mjs';
+
+export const hash = s => keccak256(toBytes(s));
+export const word = n => BigInt(n).toString(16).padStart(64, '0');
+export const hex = n => `0x${n.toString(16)}`;
+export const SCHEDULE = `0x${word(32)}${word(15)}${Array.from({ length: 15 }, (_, i) => word(i < 13 ? 1686789347 : 0)).join('')}`;
+export const VERSION = `0x${word((1n << 96n) | (5n << 64n) | (1n << 32n))}`;
+export const SELECTOR = keccak256(toBytes('getSchedule()')).slice(0, 10);
+export const A = `0x${'aa'.repeat(20)}`, ID = `0x${'cc'.repeat(32)}`, binding = 'e'.repeat(64);
+export const POLICY = Object.freeze({ format: 'enclave-derived-provisional/v1', l1Head: 'helios-attested-latest', l1MaxAgeSec: 60, maxStateAgeSec: 120,
+  maxBlocks: 1800, maxSpanBlocks: 3600, maxSegments: 64, maxOverlayBytes: 64 << 20, maxWitnessBytes: 64 << 20, nativeTimeoutMs: 120000, maxMemoryMiB: 1536 });
+export const TEMPLATE = { l2_chain_id: 8453 };
+export const l1Header = (number, timestamp) => ({ number: hex(number), hash: hash(`l1-${number}`), stateRoot: hash(`l1state-${number}`), timestamp: hex(timestamp) });
+export const log = (h, index = 0) => ({ address: A, blockNumber: Number(BigInt(h.number)), blockHash: h.hash, logIndex: index, topics: [LEASE_TOPICS[0], ID], data: '0x',
+  txHash: `0x${'dd'.repeat(32)}` });
