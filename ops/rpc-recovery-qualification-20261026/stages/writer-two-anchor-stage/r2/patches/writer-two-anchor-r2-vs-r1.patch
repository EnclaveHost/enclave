+/** A v3 provider (journal + coverage store) with the provisional policy unless policy: null, and its DURABLE evidence in the
+ *  anchor journal f.lifecycle (a local lifecycle journal here; the role-committed one in production). B_f = 101 (950 s old). */
+export async function readerFixture(t, { policy = POLICY, gated = false } = {}) {
+  const f = await l1Fixture(t, { gated }), seconds = Math.floor(f.now / 1000);
+  f.agreed = anchorOf(header(100, seconds - 960), { number: 9990, hash: hash('l1-9990'), stateRoot: hash('l1state-9990'), timestamp: seconds - 1000 });
+  f.h101 = header(101, seconds - 950); f.h102 = header(102, seconds - 20); f.h103 = header(103, seconds - 10); f.h104 = header(104, seconds - 5);
+  f.journal = await openDerivedJournal(f.directory, { binding, initialize: true });
+  f.store = await openCoverageStore(path.join(f.directory, 'coverage'), { binding, initialize: true });
+  f.lifecycleFile = path.join(f.directory, 'anchor-journal.json');
+  f.lifecycle = openLifecycleJournal(f.lifecycleFile);
+  f.evidence = provisionalEvidence(f.lifecycle);
+  f.options = { l1: f.l1, journal: f.journal, executable: f.native, workDir: f.directory, now: () => f.now, resultVersion: 3, coverageStore: f.store,
+    bootstrap: async () => f.agreed, base: async () => f.candidate, ...(policy ? { provisional: policy, provisionalEvidence: f.evidence } : {}) };
+  f.reader = await createDerivedProvider(f.options);
+  t.after(async () => { await f.reader.close(); f.store.close(); f.journal.close(); });
+  const run = async (prepare, submit, headers, logs) => {
+    f.candidate = headers.at(-1);
+    const ticket = await prepare({ blockNumber: Number(BigInt(f.candidate.number)), rollupConfigTemplate: TEMPLATE });
+    return submit({ ticket: ticket.ticket, witness: Buffer.from(JSON.stringify(result(ticket, headers, logs))) });
+  };
+  f.final = (headers, logs) => run(f.reader.prepare, f.reader.submit, headers, logs);
+  f.provisional = (headers, logs) => run(f.reader.prepareProvisional, f.reader.submitProvisional, headers, logs);
+  f.query = (anchor, extras = {}) => ({ address: A, topic0s: [...LEASE_TOPICS], topic1: ID, fromBlock: 101, toBlock: anchor.base.number,
+    anchor: { number: anchor.base.number, hash: anchor.base.hash }, ...extras });
+  f.chunks = () => fs.readdirSync(path.join(f.directory, 'coverage')).filter(n => /^[a-f0-9]{64}\.json$/.test(n)).length;
+  return f;
+}
