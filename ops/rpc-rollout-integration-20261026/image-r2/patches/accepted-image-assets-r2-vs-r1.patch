+    [url("l1ConsensusUrl", "http://[::1]:5052"), /private \(not loopback\) IPv4/],
+    [url("baseUrl", "http://user:pw@10.0.2.2:28545"), /private \(not loopback\) IPv4/],
+    [url("baseUrl", "http://10.0.2.2:28545/?key=x"), /private \(not loopback\) IPv4/],
