+    [PA({ derivedReader: (({ baseUrl, ...r }) => r)(DR()) }), /missing: baseUrl/],
+    [PA({ derivedReader: "http://10.0.2.2:28545" }), /must be an object/],
+    [PA({ derivedReader: DR(), relayEnv: (({ ENCLAVE_CHAIN_AUTHORITY, ENCLAVE_CHAIN_VERIFIER, ...r }) => r)(RELAY()) }), /needs ENCLAVE_CHAIN_AUTHORITY=verifier/],
+    ...MC.DERIVED_READER_ROLE_ENV.map((k) => [PA({ relayEnv: { ...RELAY(), [k]: "/host/file" } }), /set by the role from the bound platformApi.derivedReader/]),
+  ];
+  for (const [pa, re] of cases) assert.throws(() => bind(pa), re, JSON.stringify(pa.derivedReader ?? pa.relayEnv));
+});
+
+// a measured-image fixture: the COMMITTED template and record, with the template path moved into tmp (same bytes, same pin)
+const TEMPLATE = fs.readFileSync(new URL("../metal/derived-reader-config.v3.json", import.meta.url));
+const RECORD = JSON.parse(fs.readFileSync(new URL("../metal/derived-reader-image.json", import.meta.url), "utf8"));
+let n = 0;
+function image({ template = TEMPLATE, record = (r) => r } = {}) {
+  const d = path.join(tmp, `img-${++n}`); fs.mkdirSync(d);
+  fs.writeFileSync(path.join(d, "template.json"), template);
+  const r = record(JSON.parse(JSON.stringify({ ...RECORD, config: { ...RECORD.config, path: path.join(d, "template.json") } })));
+  fs.writeFileSync(path.join(d, "record.json"), JSON.stringify(r));
+  return { image: path.join(d, "record.json"), root: path.join(d, "root") };
+}
+const CFG = (dr = DR()) => bind(PA(dr === null ? {} : { derivedReader: dr }));
+
+test("compose: the bound endpoints into the pinned template, 0600 in a 0700 RAM dir; never initializing; env = exactly the role names", () => {
+  const { image: img, root } = image();
+  const env = composeDerivedReader({ cfg: CFG(), root, image: img });
+  const file = path.join(root, "derived-reader", "derived-reader-v3.json");
+  assert.deepEqual(env, { ENCLAVE_WRITER_AUTHORITY_SOURCE: "derived", ENCLAVE_DERIVED_READER_CONFIG: file,
+    ENCLAVE_DERIVED_ANCHOR_JOURNAL: path.join(root, "derived-reader-v3", "anchor-journal.json") });
+  assert.equal(fs.statSync(file).mode & 0o777, 0o600);
+  assert.equal(fs.statSync(path.dirname(file)).mode & 0o777, 0o700);
+  const c = JSON.parse(fs.readFileSync(file, "utf8")), t = JSON.parse(TEMPLATE);
+  assert.deepEqual([c.l1.consensusUrl, c.l1.executionUrl, c.baseUrl], ["http://10.0.2.2:25052", "http://10.0.2.2:28645", "http://10.0.2.2:28545"]);
+  assert.equal(c.initializeState, false);
+  assert.equal(c.stateDir, path.join(root, "derived-reader-v3"));
+  assert.equal(fs.existsSync(c.stateDir), false, "the role creates no reader state");
+  assert.deepEqual({ ...c, stateDir: t.stateDir, baseUrl: null, l1: { ...c.l1, consensusUrl: null, executionUrl: null } }, t, "everything else is the template");
+  // nothing bound -> nothing composed, and a previous start's file is not left either
+  assert.deepEqual(composeDerivedReader({ cfg: CFG(null), root, image: img }), {});
+});
+
+test("compose refusals: absent image or template, tampered template, template with endpoints, wrong record, never a partial file", () => {
+  const sha = (b) => createHash("sha256").update(b).digest("hex");
+  const withUrl = Buffer.from(JSON.stringify({ ...JSON.parse(TEMPLATE), baseUrl: "https://mainnet.base.org" }));
+  const init = Buffer.from(JSON.stringify({ ...JSON.parse(TEMPLATE), initializeState: true }));
+  const cases = [
+    [() => { const f = image(); fs.rmSync(f.image); return f; }, "derived_reader_absent"],
+    [() => { const f = image(); fs.rmSync(path.join(path.dirname(f.image), "template.json")); return f; }, "derived_reader_absent"],
+    [() => image({ template: Buffer.concat([TEMPLATE, Buffer.from(" ")]) }), "derived_reader_tamper"],
+    [() => image({ template: withUrl, record: (r) => ({ ...r, config: { ...r.config, sha256: sha(withUrl) } }) }), "derived_reader_tamper"],
+    [() => image({ template: init, record: (r) => ({ ...r, config: { ...r.config, sha256: sha(init) } }) }), "derived_reader_tamper"],
+    [() => image({ record: (r) => ({ ...r, format: "enclave-derived-reader-image/v0" }) }), "derived_reader_tamper"],
+    [() => image({ record: (r) => ({ ...r, private: { ...r.private, stateDir: "/var/lib/reader" } }) }), "derived_reader_tamper"],
+  ];
+  for (const [mk, code] of cases) {
+    const { image: img, root } = mk();
+    assert.throws(() => composeDerivedReader({ cfg: CFG(), root, image: img }), (e) => e.code === code, code);
+    assert.equal(fs.existsSync(path.join(root, "derived-reader")), false);
+  }
+  // an unbound (forged) endpoint at the role is refused too (defence in depth: bind already refuses it)
+  const { image: img, root } = image(), cfg = CFG();
+  cfg.platformApi.derivedReader = { ...cfg.platformApi.derivedReader, baseUrl: "http://203.0.113.9:8545" };
+  assert.throws(() => composeDerivedReader({ cfg, root, image: img }), (e) => e.code === "derived_reader_endpoint");
+});
+
+test("relay env: the derived names are exactly the composition; a sealed credential or the base cannot set or redirect them", () => {
+  const cfg = { ...CFG(), relayEnvBase: { ENCLAVE_DERIVED_READER_CONFIG: "/host/x" } };
+  const credEnv = { ENCLAVE_WRITER_AUTHORITY_SOURCE: "derived", ENCLAVE_DERIVED_READER_CONFIG: "/run/x.json", ENCLAVE_DERIVED_READER_API_PORT: "1" };
+  const none = relayChildEnv({ cfg, credEnv, dataDir: tmp });
+  for (const k of DERIVED_READER_ROLE_ENV) assert.equal(none[k], undefined, k);
+  const derivedEnv = { ENCLAVE_WRITER_AUTHORITY_SOURCE: "derived", ENCLAVE_DERIVED_READER_CONFIG: "/run/c.json", ENCLAVE_DERIVED_ANCHOR_JOURNAL: "/run/j.json" };
+  const env = relayChildEnv({ cfg, credEnv, dataDir: tmp, derivedEnv });
+  assert.deepEqual(Object.fromEntries(DERIVED_READER_ROLE_ENV.filter((k) => k in env).map((k) => [k, env[k]])), derivedEnv);
+});
+
+// The handler the reader uses on these endpoints (KVM network/derived-reader/rpc.mjs boundedRpc) against a local fixture
+// backend: it forwards a well-formed answer and refuses a malformed one. It is transport only: a forwarded VALUE is not
+// trusted (Helios checks L1 consensus and eth_chainId 0x1; the native v3 derivation checks Base) - nothing here claims a chain.
+test("transport: forwards a well-formed JSON-RPC answer; refuses wrong id, error, redirect, oversize, HTTP error, credentials/query", async () => {
+  let mode = "ok";
+  const srv = http.createServer((req, res) => {
+    let body = ""; req.on("data", (c) => { body += c; });
+    req.on("end", () => {
+      const q = JSON.parse(body);
+      if (mode === "redirect") { res.writeHead(307, { location: "http://203.0.113.9/" }); return res.end(); }
+      if (mode === "http") { res.writeHead(502); return res.end(); }
+      const reply = { ok: { jsonrpc: "2.0", id: q.id, result: q.method === "eth_chainId" ? "0x2105" : null },
+        id: { jsonrpc: "2.0", id: q.id + 1, result: "0x2105" }, error: { jsonrpc: "2.0", id: q.id, error: { code: -32000, message: "x" } },
+        big: { jsonrpc: "2.0", id: q.id, result: "0x" + "0".repeat(4096) } }[mode];
+      res.writeHead(200, { "content-type": "application/json" }); res.end(JSON.stringify(reply));
+    });
+  });
+  await new Promise((r) => srv.listen(0, "127.0.0.1", r));
+  after(() => srv.close());
+  const u = `http://127.0.0.1:${srv.address().port}`, rpc = boundedRpc(u, { maxBytes: 1024, timeoutMs: 5000 });
+  assert.equal(await rpc("eth_chainId", []), "0x2105");   // forwarded as untrusted input, nothing more
+  for (const m of ["id", "error", "redirect", "big", "http"]) { mode = m; await assert.rejects(rpc("eth_chainId", []), undefined, m); }
+  for (const bad of [`http://u:p@127.0.0.1:1`, `${u}/?k=1`, `${u}/#x`, "file:///etc/passwd", "ws://127.0.0.1:1"]) assert.throws(() => boundedRpc(bad), /invalid reader transport URL/, bad);
+});
