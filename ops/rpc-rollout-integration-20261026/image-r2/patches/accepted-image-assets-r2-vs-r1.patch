+// accepted-image-assets r2: the derived reader's endpoints. Bound (public, HOST_DATA) private-literal backends in
+// platformApi.derivedReader; the role composes them into the image's endpoint-free template at relay start; the transport
+// to them is KVM's boundedRpc (untrusted: Helios and the native derivation verify). Offline: no chain, no SNP is claimed.
+import { test, after } from "node:test";
+import assert from "node:assert/strict";
+import fs from "node:fs";
+import os from "node:os";
+import path from "node:path";
+import http from "node:http";
+import { createHash } from "node:crypto";
+import * as MC from "../metal/guest/measured-control.mjs";
+import { composeDerivedReader, relayChildEnv, DERIVED_READER_ROLE_ENV, groupIdOf } from "../metal/guest/platform-api-role.mjs";
+import { boundedRpc } from "../network/derived-reader/rpc.mjs";
+
+const tmp = fs.mkdtempSync(path.join(os.tmpdir(), "derived-endpoints-"));
+after(() => fs.rmSync(tmp, { recursive: true, force: true }));
+const a = (n) => "0x" + n.toString(16).padStart(40, "0");
+// the fixture of test/platform-api-config.test.mjs, with the local verifier bound (the derived source needs it)
+const BASE = () => ({ format: MC.CONFIG_FORMAT, chainId: 8453,
+  contracts: { registry: a(0x11), deployments: a(0x12), appCatalog: a(0x13), proofOfTime: a(0x14), enclavePay: a(0), verificationFees: a(0), sessionVaultFactory: a(0), secretVaultV2: a(0) },
+  profileDigest: null, rpcs: ["https://rpc-a.example/v1", "https://rpc-b.example"], quorum: 2, releaseId: "ab".repeat(32),
+  replicas: { gateways: ["http://192.0.2.10:8189"], storagePlan: null },
+  identity: { publicUrl: "https://host-1.example.org", repo: "owner/enclave", operator: a(0xb1) },
+  selling: { cpuPrice6: null, payout: null }, isolation: { managerUrl: "http://10.0.2.2:8095", dataAddr: "10.0.2.2:8096" }, hostAdmissionSha256: null, controlPort: 8444 });
+const RELAY = () => ({ ADDRESS_BOOK_ADDRESS: "0xab214342d5a490150a4a977063a2f88e21f80907", SIWE_DOMAIN: "enclave.host", SIWE_URI: "https://enclave.host",
+  ENCLAVE_CHAIN_AUTHORITY: "verifier", ENCLAVE_CHAIN_VERIFIER: "http://127.0.0.1:8547" });
+// the RPC VM's private backends as the guest reaches them (host link 10.0.2.2: l1-cl 25052, l1-el 28645, base-rpc 28545)
+const DR = () => ({ format: MC.DERIVED_READER_ENDPOINTS_FORMAT, l1ConsensusUrl: "http://10.0.2.2:25052", l1ExecutionUrl: "http://10.0.2.2:28645", baseUrl: "http://10.0.2.2:28545" });
+const PA = (extra = {}) => ({ apiPort: 8098, peerPort: 8099, hostname: "api.enclave.host",
+  members: [0, 1, 2].map((i) => ({ operator: a(0xb0 + i), publicUrl: `https://host-${i}.example.org`, controlUrl: `https://198.51.100.${10 + i}:8444` })),
+  measurements: ["77".repeat(48)], minTcb: null, admins: [a(0xad)], recovery: ["11".repeat(32)], archives: ["https://archive.example"], archiveMs: 30000,
+  relayEnv: RELAY(), leaseMs: 10000, ...extra });
+const bind = (pa) => MC.canonicalDirectConfig({ ...BASE(), platformApi: pa });
+
+test("bind: the endpoints are bound public data (in the canonical config and the group id); absent keeps the previous shape", () => {
+  const withDr = bind(PA({ derivedReader: DR() })), without = bind(PA());
+  assert.deepEqual(withDr.platformApi.derivedReader, DR());
+  assert.equal("derivedReader" in without.platformApi, false);
+  assert.notEqual(groupIdOf(withDr.platformApi), groupIdOf(without.platformApi));
+  assert.deepEqual(MC.DERIVED_READER_ROLE_ENV, DERIVED_READER_ROLE_ENV);
+});
+
+test("bind refusals: name, public or loopback address, credentials, path/query/fragment, other schemes, shape, no verifier, role names", () => {
+  const url = (k, v) => PA({ derivedReader: { ...DR(), [k]: v } });
+  const cases = [
+    [url("baseUrl", "http://base-rpc.internal:28545"), /private \(not loopback\) IPv4/],
+    [url("baseUrl", "https://mainnet.base.org"), /private \(not loopback\) IPv4/],
+    [url("l1ExecutionUrl", "http://8.8.8.8:8545"), /private \(not loopback\) IPv4/],
