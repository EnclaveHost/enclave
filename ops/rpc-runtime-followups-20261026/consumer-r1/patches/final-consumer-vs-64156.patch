+ * network/onchain-qualification.mjs submitAttestations (UNCHANGED, shared with the relay runtime and its pinned bundles) with
+ * one difference for a submitter that keeps several sends pending (derived-submission.mjs): every current attestation is
+ * SUBMITTED first, then each receipt is awaited in the same order (the first that is not confirmed throws; the rest stay
+ * pending in the nonce journal, never re-signed). The same selection rules and the same contract reads. -> the number confirmed.
+ */
+export async function submitAttestationsPipelined({ wallet, client, connectivity, hostId, address, attestations, minRemainingS = 60, now = Date.now() }) {
+  let sent = 0; const t = Math.floor(now / 1000), hash = addressHash(address), later = [];
+  for (const raw of attestations) {
+    let o; try { o = validateOnchain(raw); } catch { continue; }
