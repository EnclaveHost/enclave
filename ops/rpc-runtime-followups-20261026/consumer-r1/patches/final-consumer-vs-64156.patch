+const out = (c) => JSON.parse(fs.readFileSync(new URL(`../contracts/foundry/out/${c}.sol/${c}.json`, import.meta.url), "utf8")).abi;
+const shape = (f) => JSON.stringify({ name: f.name, inputs: f.inputs.map((i) => i.type),
+  outputs: f.outputs.map((o) => o.type + (o.components ? "(" + o.components.map((c) => `${c.name}:${c.type}`).join(",") + ")" : "")) });
+
+test("ledger get/deploymentsSchema and book addr fragments equal the compiled ABI", () => {
+  const ledger = out("EnclaveDeployments"), book = out("EnclaveAddressBook");
+  for (const f of LEDGER_ABI) assert.equal(shape(f), shape(ledger.find((x) => x.type === "function" && x.name === f.name)), f.name);
+  assert.equal(shape(BOOK_ABI[0]), shape(book.find((x) => x.type === "function" && x.name === "addr")));
+});
+
+test("the queried topic0s are the ABI's Claimed/Renewed/Released, in the reader's order", () => {
+  const ev = Object.fromEntries(out("EnclaveDeployments").filter((x) => x.type === "event").map((e) => [e.name, e]));
+  const sig = (e) => keccak256(toHex(`${e.name}(${e.inputs.map((i) => i.type).join(",")})`));
+  assert.deepEqual([...LEASE_TOPIC0S], [sig(ev.Claimed), sig(ev.Renewed), sig(ev.Released)]);
+  assert.deepEqual([...LEASE_TOPIC0S], [CLAIMED, RENEWED, RELEASED]);
+});
diff --git a/test/derived-writer-authority-kvm-store.test.mjs b/test/derived-writer-authority-kvm-store.test.mjs
new file mode 100644
index 0000000000000000000000000000000000000000..442e55069c1a405e119c45f92130f08a53340eea
--- /dev/null
+++ b/test/derived-writer-authority-kvm-store.test.mjs
@@ -0,0 +1,133 @@
+// relay/derived-writer-authority.mjs over KVM's ACTUAL coverage validator + durable coverage store (network/derived-reader/
+// coverage.mjs + coverage-store.mjs, imported READ-ONLY from KVM's worktree; their in-progress R2/R3, sha256 recorded by the job).
+// What is real here: KVM's v3 coverage validation, its hash-linked manifest/chunk store, its query validation (exact current anchor,
+// lease topics, bounded range), its runtime-verified-segment rule, gap and tamper refusals. What is NOT proven here: completeness of
+// the coverage itself - the native results below are FIXTURES shaped like the pinned v3 binary's output (blocks and logs are
+// invented); completeness is the native executable's property (root's r2 Rust tests) and needs a real witness to be shown.
+// The bridge snapshot (row reads at the anchor) is an in-test stand-in; KVM's provider.readDerivedLogs is mirrored as
+// store.read(query, currentAnchor) (its exclusive lock and freshness recheck are KVM's, integration pending).
+import { test } from "node:test";
+import assert from "node:assert/strict";
+import fs from "node:fs";
+import os from "node:os";
+import path from "node:path";
+import { pathToFileURL } from "node:url";
+import { keccak256 } from "viem";
+import { CLAIMED, RENEWED, LeaseGenerationError } from "../relay/lease-generation.mjs";
+import { createDerivedWriterAuthority } from "../relay/derived-writer-authority.mjs";
+
+const KVM = process.env.KVM_TREE;
+const skip = !KVM ? "KVM_TREE unset (the job sets it)" : false;
+const kvm = async (f) => import(pathToFileURL(path.join(KVM, "network/derived-reader", f)).href);
+
+const O = 53_000_000, NOW = 1_700_000_000;
+const h = (b) => "0x" + b.repeat(32);
+const ID = h("11"), RUNNER = h("22"), OP = "0x" + "44".repeat(20), LEDGER = "0x" + "66".repeat(20), OTHER = "0x" + "67".repeat(20), BOOK = "0x" + "77".repeat(20);
+const word = (n) => BigInt(n).toString(16).padStart(64, "0");
+const hx = (n, tag) => "0x" + (tag + n.toString(16)).padStart(64, "0");
+const blockOf = (n, t) => {
+  const b = { number: n, hash: hx(n, "b"), stateRoot: hx(n, "5"), messagePasserStorageRoot: hx(n, "9"), receiptsRoot: hx(n, "e"), transactionsRoot: hx(n, "7"), timestamp: t };
+  b.outputRoot = keccak256(`0x${"0".repeat(64)}${b.stateRoot.slice(2)}${b.messagePasserStorageRoot.slice(2)}${b.hash.slice(2)}`);
+  return b;
+};
+const anchorOf = (b) => ({ tier: "l1-finalized-derived", base: { number: b.number, hash: b.hash, stateRoot: b.stateRoot, messagePasserStorageRoot: b.messagePasserStorageRoot,
+  outputRoot: b.outputRoot, timestamp: b.timestamp }, l1: { number: 26_000_000 + b.number - O, hash: hx(b.number, "1"), stateRoot: hx(b.number, "2"), timestamp: b.timestamp + 60 } });
+/** A native v3 result FIXTURE for (agreed, to]: every block, plus `logs` (full native log objects). */
+function segment(agreed, to, logs) {
+  const blocks = []; for (let n = agreed + 1; n <= to; n++) blocks.push(blockOf(n, NOW - 260 + (n - O)));
+  const byNum = new Map(blocks.map((b) => [b.number, b]));
+  const full = logs.map((l) => ({ ...l, blockHash: byNum.get(l.blockNumber).hash }));
+  return { result: { format: "enclave-base-derivation-result/v3", intermediateRoots: "0x" + blocks.map((b) => b.outputRoot.slice(2)).join(""),
+    coverage: { format: "enclave-lease16-coverage/v1", filterId: "lease16-events/v1", fromBlock: agreed + 1, toBlock: to, blocks, logs: full } },
+    input: { trusted: { intermediateBlockInterval: 1 }, bound: { agreedL2BlockNumber: agreed } }, anchor: anchorOf(blocks.at(-1)), agreedBlock: blockOf(agreed, NOW - 260 + (agreed - O)) };
+}
+const claimedLog = (n, i, until, address = LEDGER) => ({ address, blockNumber: n, logIndex: i, topics: [CLAIMED, ID, RUNNER, "0x" + "0".repeat(24) + OP.slice(2)],
+  data: "0x" + word(until) + word(5), txHash: hx(n * 10 + i, "f") });
+const renewedLog = (n, i, until) => ({ address: LEDGER, blockNumber: n, logIndex: i, topics: [RENEWED, ID, RUNNER], data: "0x" + word(until) + word(5), txHash: hx(n * 10 + i, "f") });
+
+async function harness(segments) {
+  const { validateCoverage } = await kvm("coverage.mjs");
+  const { openCoverageStore } = await kvm("coverage-store.mjs");
+  const dir = fs.mkdtempSync(path.join(process.env.TEST_TMP || os.tmpdir(), "kvm-cov-")); fs.chmodSync(dir, 0o700);
+  const store = await openCoverageStore(path.join(dir, "store"), { binding: "a".repeat(64), initialize: true, maximumBytes: 64 << 20 });
+  let current = null;
+  for (const s of segments) {
+    const checked = validateCoverage(s.result, s.input, s.anchor);
+    const publish = store.stage(checked, anchorOf(s.agreedBlock), s.anchor);
+    publish(); current = s.anchor;
+  }
+  const leaseUntil = BigInt(NOW + 1200);
+  const capability = {
+    snapshot: async (read) => {
+      const a = current, client = {
+        getBlock: async () => ({ number: BigInt(a.base.number), hash: a.base.hash, timestamp: BigInt(a.base.timestamp) }),
+        readContract: async ({ functionName }) => functionName === "addr" ? LEDGER : functionName === "deploymentsSchema" ? 16n
+          : { id: ID, active: true, runner: RUNNER, runnerOperator: OP, leaseUntil },
+      };
+      return { blockNumber: BigInt(a.base.number), blockHash: a.base.hash, value: await read(client, BigInt(a.base.number), {}) };
+    },
+    readDerivedLogs: (q) => store.read(q, current, { signal: q.signal }),
+  };
+  const fresh = { getBlockNumber: async () => BigInt(current.base.number + 5), request: async () => [],
+    readContract: async ({ functionName }) => functionName === "addr" ? LEDGER : { id: ID, active: true, runner: RUNNER, runnerOperator: OP, leaseUntil } };
+  const authority = createDerivedWriterAuthority({ capability, fresh, addressBook: BOOK, now: () => NOW * 1000 });
+  return { store, dir, authority, setAnchor: (a) => { current = a; }, current: () => current };
+}
+const code = async (p, c) => assert.rejects(p, (e) => { assert.ok(e instanceof LeaseGenerationError, String(e)); assert.equal(e.code, c, e.message); return true; });
+
+test("actual KVM store: two contiguous runtime-verified segments -> the lease16 fact (claim in the first, renewal in the second)", { skip }, async () => {
+  const s1 = segment(O + 100, O + 150, [claimedLog(O + 120, 2, NOW + 600), claimedLog(O + 121, 0, 1, OTHER)]);   // an innocuous other-address collision
+  const s2 = segment(O + 150, O + 200, [renewedLog(O + 170, 1, NOW + 1200)]);
+  const k = await harness([s1, s2]);
+  const r = await k.authority.writerAuthority(ID, { runner: RUNNER });
+  assert.equal(r.factJson, JSON.stringify({ source: "lease16", chainId: 8453, ledger: LEDGER, deployment: ID, claimBlock: O + 120, claimLogIndex: 2 }));
+  assert.equal(r.block.number, O + 200);
+  assert.equal(r.evidence.coverageFromBlock, O + 101);
+  k.store.close();
+});
+
+test("actual KVM store: the claim before the store's first runtime-verified block (pre-bootstrap) stays claim_not_covered", { skip }, async () => {
+  const s2 = segment(O + 150, O + 200, [renewedLog(O + 170, 1, NOW + 1200)]);         // the claim at O+120 was never covered
+  const k = await harness([s2]);
+  await assert.rejects(k.authority.writerAuthority(ID), (e) => e.code === "claim_not_covered" && e.retry === false);
+  k.store.close();
+});
+
+test("actual KVM store: a chunk altered on disk (a dropped renewal) is refused by the store's hash link, and the store then fails closed", { skip }, async () => {
+  const s1 = segment(O + 100, O + 150, [claimedLog(O + 120, 2, NOW + 600)]);
+  const s2 = segment(O + 150, O + 200, [renewedLog(O + 170, 1, NOW + 1200)]);
+  const k = await harness([s1, s2]);
+  const sdir = path.join(k.dir, "store");
+  const chunk = fs.readdirSync(sdir).map((f) => path.join(sdir, f)).find((f) => /[0-9a-f]{64}\.json$/.test(f) && fs.readFileSync(f, "utf8").includes(RENEWED.slice(2)));
+  const raw = fs.readFileSync(chunk, "utf8");
+  fs.writeFileSync(chunk, raw.replace(RENEWED.slice(2), CLAIMED.slice(2)));          // same size, other content
+  await code(k.authority.writerAuthority(ID), "derived_unavailable");
+  await code(k.authority.writerAuthority(ID), "derived_unavailable");                // failed store: every later read refuses too
+  k.store.close();
+});
+
+test("actual KVM store: a query for any anchor but the store's current one is refused (no stale or foreign anchor)", { skip }, async () => {
+  const s1 = segment(O + 100, O + 150, [claimedLog(O + 120, 2, NOW + 1200)]);
+  const k = await harness([s1]);
+  const real = k.current();
+  // the snapshot is pinned to another block hash than the reader's current anchor
+  k.setAnchor({ ...real, base: { ...real.base, hash: h("ee") } });
+  const readCurrent = (q) => k.store.read(q, real, { signal: q.signal });
+  const auth = createDerivedWriterAuthority({ capability: { snapshot: async (read) => {
+      const client = { getBlock: async () => ({ number: BigInt(real.base.number), hash: h("ee"), timestamp: BigInt(real.base.timestamp) }),
+        readContract: async ({ functionName }) => functionName === "addr" ? LEDGER : functionName === "deploymentsSchema" ? 16n
+          : { id: ID, active: true, runner: RUNNER, runnerOperator: OP, leaseUntil: BigInt(NOW + 1200) } };
+      return { blockNumber: BigInt(real.base.number), blockHash: h("ee"), value: await read(client, BigInt(real.base.number), {}) }; },
+    readDerivedLogs: readCurrent }, fresh: { getBlockNumber: async () => 0n, request: async () => [], readContract: async () => null }, addressBook: BOOK, now: () => NOW * 1000 });
+  await code(auth.writerAuthority(ID), "derived_unavailable");
+  k.store.close();
+});
+
+test("actual KVM store: a gap between segments is refused at staging; nothing beyond the gap ever becomes readable", { skip }, async () => {
+  const s1 = segment(O + 100, O + 150, [claimedLog(O + 120, 2, NOW + 1200)]);
+  const s3 = segment(O + 160, O + 200, []);                                           // O+151..O+160 never derived
+  const { validateCoverage } = await kvm("coverage.mjs");
+  const k = await harness([s1]);
+  assert.throws(() => k.store.stage(validateCoverage(s3.result, s3.input, s3.anchor), anchorOf(s3.agreedBlock), s3.anchor), /gap|predecessor/);
+  k.store.close();
+});
diff --git a/test/derived-writer-authority.test.mjs b/test/derived-writer-authority.test.mjs
new file mode 100644
index 0000000000000000000000000000000000000000..4d8c5ed40b5a424d61e49f09fe168f509d5d0012
--- /dev/null
+++ b/test/derived-writer-authority.test.mjs
@@ -0,0 +1,260 @@
+// relay/derived-writer-authority.mjs: ADAPTER LOGIC ONLY. The capability below is an in-test fake whose `complete: true` proves
+// nothing: these tests show what the adapter does WITH a complete coverage answer (replay, same-anchor binding, filter/range/order
+// checks, refusals, deny-only freshness, no public fallback). Omission detection itself is the native v3 executable's and the
+// derived reader's property: test/derived-writer-authority-kvm-store.test.mjs drives the ACTUAL (in-progress) KVM coverage store.
+import { test } from "node:test";
+import assert from "node:assert/strict";
+import { CLAIMED, RENEWED, RELEASED, LeaseGenerationError } from "../relay/lease-generation.mjs";
+import { createDerivedWriterAuthority, derivedWriterAuthorityFromEnv, checkDerivedLogs, LEASE_TOPIC0S, MAX_ANCHOR_AGE_SEC } from "../relay/derived-writer-authority.mjs";
+
+const h = (b, n = 32) => "0x" + b.repeat(n);
+const ID = h("11"), RUNNER = h("22"), OTHER_RUNNER = h("33"), OP = "0x" + "44".repeat(20), OP2 = "0x" + "55".repeat(20);
+const LEDGER = "0x" + "66".repeat(20), LEDGER2 = "0x" + "67".repeat(20), BOOK = "0x" + "77".repeat(20);
+const O = 53_000_000, B = O + 1_000, HASH = h("ab"), NOW = 1_700_000_000, T = NOW - 60;                        // anchor 60 s old: inside the 120 s ceiling
+const word = (n) => BigInt(n).toString(16).padStart(64, "0");
+const pad = (a) => "0x" + "0".repeat(24) + a.slice(2);
+let seq = 0;
+const tx = () => "0x" + (++seq).toString(16).padStart(64, "0");
+const bh = (n) => "0x" + n.toString(16).padStart(64, "c");
+const claimed = (n, i, until, { runner = RUNNER, op = OP, id = ID, address = LEDGER } = {}) =>
+  ({ address, blockNumber: O + n, blockHash: bh(O + n), logIndex: i, topics: [CLAIMED, id, runner, pad(op)], data: "0x" + word(until) + word(5), txHash: tx() });
+const renewed = (n, i, until, { runner = RUNNER, id = ID, address = LEDGER } = {}) =>
+  ({ address, blockNumber: O + n, blockHash: bh(O + n), logIndex: i, topics: [RENEWED, id, runner], data: "0x" + word(until) + word(5), txHash: tx() });
+const released = (n, i, { id = ID, address = LEDGER } = {}) =>
+  ({ address, blockNumber: O + n, blockHash: bh(O + n), logIndex: i, topics: [RELEASED, id, RUNNER], data: "0x" + word(7), txHash: tx() });
+const row = (o = {}) => ({ id: ID, owner: OP, appRef: "", ports: "", configCid: "", gpuMilli: 0, cpuMilli: 1, appPort: 80, isPublic: false, active: true,
+  createdAt: 1n, rate: 1n, balance6: 1n, spent6: 1n, runner: RUNNER, runnerOperator: OP, leaseUntil: BigInt(NOW + 1200), ...o });
+
+/** A fake world. `logs`: the ledger's complete lease logs (any order the test wants to check); `calls` records every read. */
+function world({ logs = [claimed(950, 3, NOW + 1200)], rows = { [LEDGER]: row() }, bookAt = LEDGER, schema = 16, availableFrom = O + 900, time = T,
+                 later = [], headRow, headBook = bookAt, head = B + 300, mutate = (r) => r, freshFails = false } = {}) {
+  const calls = [];
+  const capability = {
+    async snapshot(read) {
+      const client = {
+        getBlock: async () => ({ number: BigInt(B), hash: HASH, timestamp: BigInt(time) }),
+        readContract: async ({ address, functionName, args }) => {
+          calls.push(["snapshot", functionName, address]);
+          if (functionName === "addr") { assert.equal(address, BOOK); return bookAt; }
+          if (functionName === "deploymentsSchema") return BigInt(schema);
+          if (functionName === "get") return rows[address] ?? row({ id: h("00") });
+          throw new Error(functionName);
+        },
+      };
+      const value = await read(client, BigInt(B), {});
+      return { blockNumber: BigInt(B), blockHash: HASH, value };
+    },
+    async readDerivedLogs(q) {
+      calls.push(["logs", q.fromBlock, q.toBlock, q.address]);
+      if (q.anchor.number !== B || q.anchor.hash !== HASH) throw new Error("anchor is not current");
+      if (q.fromBlock < availableFrom) throw new Error("requested history is outside runtime-verified coverage");
+      const sel = logs.filter((l) => l.blockNumber >= q.fromBlock && l.blockNumber <= q.toBlock);
+      return mutate({ format: "enclave-derived-logs/v1", logs: sel, anchor: { tier: "l1-finalized-derived", base: { number: B, hash: HASH } },
+        filter: { address: q.address, topic0s: q.topic0s, topic1: q.topic1 },
+        coverage: { format: "enclave-lease16-coverage/v1", filterId: "lease16-events/v1", fromBlock: q.fromBlock, toBlock: q.toBlock, complete: true,
+                    availableFromBlock: availableFrom, availableToBlock: B } }, q);
+    },
+  };
+  const fresh = {
+    getBlockNumber: async () => { if (freshFails) throw new Error("verifier down"); return BigInt(head); },
+    request: async ({ method, params }) => { calls.push(["fresh", method]); assert.equal(method, "eth_getLogs"); assert.equal(params[0].fromBlock, "0x" + (B + 1).toString(16)); return later; },
+    readContract: async ({ functionName, address }) => functionName === "addr" ? headBook : (headRow ?? rows[address] ?? row({ id: h("00") })),
+  };
+  return { capability, fresh, calls };
+}
+const authority = (w, o = {}) => createDerivedWriterAuthority({ capability: w.capability, fresh: w.fresh, addressBook: BOOK, now: () => NOW * 1000, ...o });
+const refuses = async (p, code) => {
+  await assert.rejects(p, (e) => { assert.ok(e instanceof LeaseGenerationError, String(e)); assert.equal(e.code, code, e.message); return true; });
+};
+
+test("a complete-coverage answer yields exactly the legacy lease16 fact of the last claim, bound to the snapshot's anchor", async () => {
+  const w = world({ logs: [claimed(950, 3, NOW + 600), renewed(980, 0, NOW + 1200)] });
+  const r = await authority(w).writerAuthority(ID, { runner: RUNNER });
+  assert.equal(r.factJson, JSON.stringify({ source: "lease16", chainId: 8453, ledger: LEDGER, deployment: ID, claimBlock: O + 950, claimLogIndex: 3 }));
+  assert.deepEqual(r.block, { number: B, hash: HASH, time: T, finalized: B });
+  assert.equal(r.evidence.tier, "l1-finalized-derived");
+  // the reader was asked at the snapshot's own anchor: a probe at B, then [availableFrom, B]
+  assert.deepEqual(w.calls.filter((c) => c[0] === "logs"), [["logs", B, B, LEDGER], ["logs", O + 900, B, LEDGER]]);
+});
+
+test("the coverage query starts at max(ledger floor, reader's availableFrom); the default floor is the live 16d ledger's first block", async () => {
+  const w = world({ logs: [claimed(950, 3, NOW + 1200)] });
+  await authority(w, { fromBlock: O + 940 }).writerAuthority(ID);
+  assert.deepEqual(w.calls.filter((c) => c[0] === "logs").map((c) => c[1]), [B, O + 940]);
+  const d = world();
+  await authority(d).writerAuthority(ID);                                                     // default floor 52,515,705 < availableFrom
+  assert.deepEqual(d.calls.filter((c) => c[0] === "logs").map((c) => c[1]), [B, O + 900]);
+});
+
+test("same-runner re-claim after expiry: the LATER claim is the fact (complete logs make the older generation unusable)", async () => {
+  const w = world({ logs: [claimed(910, 0, NOW - 4000), renewed(920, 1, NOW - 3000), claimed(960, 2, NOW + 600), renewed(990, 0, NOW + 1200)] });
+  const r = await authority(w).writerAuthority(ID);
+  assert.equal(r.fact.claimBlock, O + 960);
+  assert.equal(r.fact.claimLogIndex, 2);
+});
+
+test("replay refusals: released after the claim, renewals not replaying, another runner/operator, released row", async () => {
+  await refuses(authority(world({ logs: [claimed(950, 0, NOW + 1200), released(960, 0)] })).writerAuthority(ID), "inconsistent_logs");
+  await refuses(authority(world({ logs: [claimed(950, 0, NOW + 600), renewed(960, 0, NOW + 900)] })).writerAuthority(ID), "inconsistent_logs");
+  await refuses(authority(world({ logs: [claimed(950, 0, NOW + 1200, { runner: OTHER_RUNNER })] })).writerAuthority(ID), "inconsistent_logs");
+  await refuses(authority(world({ logs: [claimed(950, 0, NOW + 1200, { op: OP2 })] })).writerAuthority(ID), "inconsistent_logs");
+  await refuses(authority(world({ logs: [claimed(950, 0, NOW + 1200), renewed(960, 0, NOW + 1200, { runner: OTHER_RUNNER })] })).writerAuthority(ID), "inconsistent_logs");
+  await refuses(authority(world({ rows: { [LEDGER]: row({ runner: h("00"), runnerOperator: "0x" + "00".repeat(20) }) } })).writerAuthority(ID), "lease_not_current");
+  await refuses(authority(world()).writerAuthority(ID, { runner: OTHER_RUNNER }), "runner_mismatch");
+});
+
+test("a claim older than the derived coverage (pre-bootstrap) stays REFUSED: no fact, not retried, nothing signed", async () => {
+  const w = world({ logs: [claimed(850, 0, NOW - 100), renewed(950, 0, NOW + 1200)], availableFrom: O + 900 });
+  await assert.rejects(authority(w).writerAuthority(ID), (e) => e.code === "claim_not_covered" && e.retry === false);
+  // the coverage start is the reader's: asking below it is never attempted
+  assert.ok(w.calls.filter((c) => c[0] === "logs").every((c) => c[1] >= O + 900));
+});
+
+test("anchor binding: logs of another anchor, another filter or another range are refused", async () => {
+  const bad = (mutate) => authority(world({ mutate })).writerAuthority(ID);
+  await refuses(bad((r) => ({ ...r, anchor: { ...r.anchor, base: { number: B, hash: h("ac") } } })), "anchor_mismatch");
+  await refuses(bad((r) => ({ ...r, anchor: { ...r.anchor, base: { number: B - 1, hash: HASH } } })), "anchor_mismatch");
+  await refuses(bad((r) => ({ ...r, filter: { ...r.filter, topic1: h("12") } })), "derived_logs_invalid");
+  await refuses(bad((r) => ({ ...r, filter: { ...r.filter, topic0s: [CLAIMED] } })), "derived_logs_invalid");
+  // KVM's store echoes the range too: accepted when it is exactly the asked range, refused otherwise or with any other key
+  assert.equal((await authority(world({ mutate: (r, q) => ({ ...r, filter: { ...r.filter, fromBlock: q.fromBlock, toBlock: q.toBlock } }) })).writerAuthority(ID)).fact.claimBlock, O + 950);
+  await refuses(bad((r) => ({ ...r, filter: { ...r.filter, fromBlock: 0 } })), "derived_logs_invalid");
+  await refuses(bad((r) => ({ ...r, filter: { ...r.filter, complete: true } })), "derived_logs_invalid");
+  await refuses(bad((r) => ({ ...r, coverage: { ...r.coverage, fromBlock: r.coverage.fromBlock + 1 } })), "coverage_incomplete");
+  await refuses(bad((r) => ({ ...r, coverage: { ...r.coverage, complete: false } })), "coverage_incomplete");
+  await refuses(bad((r) => ({ ...r, coverage: { ...r.coverage, availableToBlock: B - 1 } })), "coverage_incomplete");
+  await refuses(bad((r) => ({ ...r, format: "enclave-derived-logs/v0" })), "derived_logs_invalid");
+  // the reader itself refusing (its anchor moved on, a gap, a tampered chunk, cancellation...) is a refusal, never a fallback
+  const w = world(); w.capability.readDerivedLogs = async () => { throw new Error("runtime coverage gap"); };
+  await refuses(authority(w).writerAuthority(ID), "derived_unavailable");
+});
+
