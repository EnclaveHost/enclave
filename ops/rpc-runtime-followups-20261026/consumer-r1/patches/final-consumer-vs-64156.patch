+    delete be.fault.hint;
+  }
+  assert.ok(r.logs.some((m) => /not provable here/.test(m)));
+});
+
+test('reorg: a receipt on a non-canonical fork is not a receipt; the same bytes land on the derived chain and resolve there', async () => {
+  const r = await rig(), { w, be } = r, sub = await r.make();
+  const hash = await setHost(sub);
+  const M = await w.mine(); await w.mine();
+  assert.ok(M.txHashes.includes(lc(hash)));
+  const oldFork = await w.reorg(M.number, 2);
+  be.view = oldFork; w.anchorAt = M.number + 1;                                     // both forks have M+1; the anchor is the new one
+  await assert.rejects(sub.client.waitForTransactionReceipt({ hash, timeout: 80 }), /no receipt proven/);
+  await assert.rejects(sub.settle(), /another block .* than the derived anchor/);   // the forked backend is not bound
+  assert.equal(sub.pending().length, 1);
+  be.view = null; w.mempool.length = 0;
+  assert.equal((await sub.settle()).state, 'pending');                              // re-broadcast: the pool lacked the own bytes
+  assert.ok(w.mempool.includes(be.sent[0]));
+  const M2 = await w.mine(); w.anchorAt = M2.number;
+  const rc = await sub.client.waitForTransactionReceipt({ hash, timeout: 1_000 });
+  assert.equal(rc.blockHash, M2.hash); assert.notEqual(rc.blockHash, M.hash); assert.equal(r.signed.length, 1);
+});
+
+test('restart and the derived floor: an older or contradicting anchor is refused; a foreign-signed journal is refused', async () => {
+  const r = await rig(), { w } = r;
+  const sub = await r.make();
+  const read = (s) => s.client.readContract({ address: CONN, abi: connectivityQualificationABI, functionName: 'hosts', args: [HOST_ID] });
+  w.anchorAt += 1; await w.mine(); await read(sub);
+  const floorN = JSON.parse(fs.readFileSync(r.floorFile, 'utf8')).anchor.base.number; assert.equal(floorN, w.anchorAt);
+  r.anchorOverride = () => w.anchor(floorN - 1);
+  await assert.rejects(read(await r.make()), /rollback/);
+  r.anchorOverride = () => { const a = w.anchor(floorN); a.l1.hash = tag('contradicting L1'); return a; };
+  await assert.rejects(read(await r.make()), /rollback or contradiction/);
+  delete r.anchorOverride;
+  const keep = fs.readFileSync(r.floorFile, 'utf8');
+  fs.writeFileSync(r.floorFile, JSON.stringify({ ...JSON.parse(keep), chainId: 1 }));
+  assert.throws(() => openDerivedAnchorFloor(r.floorFile), /not this provider's derived anchor floor/);
+  fs.writeFileSync(r.floorFile, keep);
+  await read(await r.make());
+  const foreign = await STRANGER.signTransaction({ chainId: 8453, type: 'eip1559', nonce: 0, to: CONN, data: '0x', gas: 21_000n, maxFeePerGas: 1n, maxPriorityFeePerGas: 1n });
+  fs.writeFileSync(r.stateFile, JSON.stringify({ nonce: 0, raw: foreign, hash: keccak256(foreign) }));
+  await assert.rejects((await r.make()).ready, /signed by another key/);
+  assert.equal(await recoverTransactionAddress({ serializedTransaction: foreign }), STRANGER.address);
+});
+
+test('own-backend broadcast only; the executor saw only state pinned to served derived hashes; no public, debug or unsafe path', async () => {
+  for (const s of open) await s.close();
+  assert.ok(rigs.length >= 12);
+  const names = (list) => new Set(list.map((m) => m.split(' ')[0].replace(/\(.*$/, '')));
+  const allowed = new Set([...names(DERIVED_BACKEND_USE), ...names(DERIVED_HISTORY_USE)]);
+  for (const r of rigs) {
+    for (const srv of [r.be, r.hist].filter(Boolean)) for (const c of srv.calls) assert.ok(allowed.has(c.method), `server method ${c.method}`);
+    if (r.hist) for (const c of r.hist.calls) assert.ok(names(DERIVED_HISTORY_USE).has(c.method), `history method ${c.method}`);
+    for (const c of r.ex.calls) {
+      assert.notEqual(c.method, 'eth_sendRawTransaction');
+      assert.ok(!['eth_getTransactionReceipt', 'eth_blockNumber', 'eth_getLogs'].includes(c.method), `executor method ${c.method} (unsafe-head paths)`);
+      if (['eth_call', 'eth_getBalance', 'eth_getTransactionCount', 'eth_getStorageAt'].includes(c.method))
+        assert.ok(r.w.served.has(lc(c.params.at(-1).blockHash)), `${c.method} pinned to a derived hash`);
+    }
+  }
+  assert.ok(rigs.some((r) => sends(r) > 1));
+  assert.ok(connects.length > 0 && connects.every((h) => h === '127.0.0.1' || h === 'localhost' || h === '::1'), `sockets: ${[...new Set(connects)].join(',')}`);
+});
diff --git a/test/paid-derived-packaging.test.mjs b/test/paid-derived-packaging.test.mjs
new file mode 100644
index 0000000000000000000000000000000000000000..e1a76e2f66838e1b069f5286bbed1cdf09a00794
--- /dev/null
+++ b/test/paid-derived-packaging.test.mjs
@@ -0,0 +1,113 @@
+// The PACKAGED paid provider under paidFinality "derived" and without it: the actual release pipeline
+// (scripts/network/build-consumers.mjs) and the actual entrypoints (network/wg-provider/main.mjs from the source tree, and the
+// release's provider.mjs), run as processes with --check-config, plus the adapter suite's journal cases against the RELEASE's
+// derived-runtime.mjs.
+//
+// Regression (root full-1268, r4): the provider bundle statically carried the derived reader, whose pinned schedule input
+// bridge (network/derived-reader/vendor/schedule-input-r2.mjs) checks ./schedule_reader.mjs beside its import.meta.url at load:
+// inside a bundle that is the bundle's directory, so EVERY packaged provider (quorum and attested too) died with ENOENT.
+// r6 (root full-1282): the pipeline's gitignored GENERATED input relay/network-runtime.bundle.mjs (relay/build-network.mjs) was
+// absent from the composed tree, and the nested `node --test` inherited NODE_TEST_CONTEXT and skipped its files. Now: that
+// input must be present and byte-identical to a fresh rebuild (the guard scripts/build-host-service-packages.mjs applies; the
+// release runs `node relay/build-network.mjs` first, and the root job does exactly that), and every child process runs
+// without the parent's test-runner context; the nested suite must report its exact counts and every test ok.
+// What is real here: the pipeline, the bundles, node, the pinned reader file and its own pin check. Nothing here starts a
+// derived reader, a native derivation or an L1 client: --check-config loads the runtime and stops; the journal cases use the
+// adapter suite's labelled stand-ins (test/paid-derived-adapter.test.mjs).
+import test, { after } from 'node:test';
+import assert from 'node:assert/strict';
+import fs from 'node:fs';
+import os from 'node:os';
+import path from 'node:path';
+import { execFile } from 'node:child_process';
+import { createHash } from 'node:crypto';
+import { fileURLToPath } from 'node:url';
+
+const REPO = path.resolve(path.dirname(fileURLToPath(import.meta.url)), '..');
+const tmp = fs.mkdtempSync(path.join(process.env.TMPDIR || os.tmpdir(), 'paid-derived-pkg-'));
+after(() => fs.rmSync(tmp, { recursive: true, force: true }));
+// a child never inherits the parent's test-runner context (NODE_TEST_CONTEXT makes a nested `node --test` skip its files)
+const childEnv = (extra = {}) => Object.fromEntries(Object.entries({ ...process.env, ...extra }).filter(([k]) => !k.startsWith('NODE_TEST')));
+const run = (args, opts = {}) => new Promise((resolve) => execFile(process.execPath, args, { cwd: REPO, timeout: 240_000, maxBuffer: 16 << 20, env: childEnv(), ...opts },
+  (e, so, se) => resolve({ code: e ? (e.code ?? 1) : 0, out: String(so) + String(se) })));
+const last = (r) => JSON.parse(r.out.trim().split('\n').pop());
+const READER_PIN = JSON.parse(fs.readFileSync(path.join(REPO, 'network/derived-reader/vendor/provenance.json'), 'utf8'))['schedule_reader.mjs'].sha256;
+const sha = (f) => createHash('sha256').update(fs.readFileSync(f)).digest('hex');
+
+// provider configurations as install.sh's --check-config sees them (no key is read, no reader is started)
+const base = { publicAddress: '203.0.114.7', roles: ['exit'], directories: ['https://directory.example'], stateDir: path.join(tmp, 'state'),
+  rpc: ['https://rpc-a.example/', 'https://rpc-b.example/'] };
+const write = (name, cfg) => { const f = path.join(tmp, name); fs.writeFileSync(f, JSON.stringify(cfg)); return f; };
+const QUORUM = write('quorum.json', base);
+const VERIFIER = write('verifier.json', { ...base, chainAuthority: 'verifier', chainVerifier: 'http://127.0.0.1:28590/' });
+const DERIVED = write('derived.json', { ...base, chainAuthority: 'verifier', chainVerifier: 'http://127.0.0.1:28590/', pricePerGiB6: 5, kind: 'community', hostId: '0x' + '11'.repeat(32),
+  txBackend: { url: 'http://127.0.0.1:18545' }, paidFinality: 'derived',
+  derivedFinality: { readerConfigFile: path.join(REPO, 'network/derived-reader/config.example.json'), historyUrl: 'http://127.0.0.1:18546' } });
+
+let release;
+test('the release pipeline: provider.mjs carries no derived code; derived-runtime.mjs and the pinned schedule_reader.mjs ship beside it', { timeout: 300_000 }, async () => {
+  // the release prerequisite: the generated runtime bundle relay/dns-relay.js imports, current with this tree (never a stub)
+  const have = path.join(REPO, 'relay/network-runtime.bundle.mjs'), fresh = path.join(tmp, 'network-runtime.bundle.mjs');
+  assert.ok(fs.existsSync(have), 'relay/network-runtime.bundle.mjs is missing: run node relay/build-network.mjs first (the release prerequisite)');
+  const pre = await run([path.join(REPO, 'relay/build-network.mjs'), fresh]); assert.equal(pre.code, 0, pre.out);
+  assert.ok(fs.readFileSync(have).equals(fs.readFileSync(fresh)), 'relay/network-runtime.bundle.mjs is stale: run node relay/build-network.mjs first');
+  release = path.join(tmp, 'release');
+  const r = await run([path.join(REPO, 'scripts/network/build-consumers.mjs'), release]);
+  assert.equal(r.code, 0, r.out);
+  const m = JSON.parse(fs.readFileSync(path.join(release, 'build-manifest.json'), 'utf8')).files;
+  for (const f of ['provider.mjs', 'derived-runtime.mjs', 'schedule_reader.mjs']) assert.equal(sha(path.join(release, f)), m[f].sha256, f);
+  assert.equal(m['schedule_reader.mjs'].sha256, READER_PIN, 'the resource is the frozen reader, byte for byte');
+  assert.deepEqual(fs.readFileSync(path.join(release, 'schedule_reader.mjs')), fs.readFileSync(path.join(REPO, 'network/derived-reader/vendor/schedule_reader.mjs')));
+  assert.deepEqual(m['provider.mjs'].inputs.filter((i) => /derived-reader\/|lifecycle-finality-bridge|op-receipts-root|wg-provider\/derived-/.test(i)), []);
+  assert.ok(m['derived-runtime.mjs'].inputs.includes('network/derived-reader/vendor/schedule-input-r2.mjs'));
+  assert.ok(m['derived-runtime.mjs'].inputs.includes('network/wg-provider/derived-submission.mjs'));
+  assert.ok(!m['derived-runtime.mjs'].inputs.includes('network/derived-reader/main.mjs'), 'not the reader CLI (its main-script check would fire inside a bundle)');
+  const text = fs.readFileSync(path.join(release, 'provider.mjs'), 'utf8');
+  assert.ok(!text.includes('reader_pin') && !text.includes('enclave-provider-send-journal/v1'));
+});
+
+test('packaged provider WITHOUT the derived files: quorum and local-verifier configurations run; a derived one refuses explicitly', { timeout: 120_000 }, async () => {
+  const alone = path.join(tmp, 'alone'); fs.mkdirSync(alone); fs.copyFileSync(path.join(release, 'provider.mjs'), path.join(alone, 'wg-provider.mjs'));
+  const entry = path.join(alone, 'wg-provider.mjs');
+  let r = await run([entry, '--check-config', QUORUM]); assert.equal(r.code, 0, r.out); assert.equal(last(r).chainAuthority, 'quorum'); assert.equal(last(r).paidFinality, undefined);
+  r = await run([entry, '--check-config', VERIFIER]); assert.equal(r.code, 0, r.out); assert.equal(last(r).chainAuthority, 'verifier');
+  r = await run([entry, '--check-config', DERIVED]); assert.notEqual(r.code, 0);
+  assert.match(r.out, new RegExp(`paidFinality "derived": the derived runtime ${alone.replace(/[.*+?^${}()|[\]\\]/g, '\\$&')}/derived-runtime\\.mjs did not load`));
+});
+
+test('packaged release WITH the derived files: --check-config loads the runtime beside it; a missing or altered schedule reader refuses', { timeout: 120_000 }, async () => {
+  const rel = path.join(tmp, 'opt-release'); fs.mkdirSync(rel);
+  fs.copyFileSync(path.join(release, 'provider.mjs'), path.join(rel, 'wg-provider.mjs'));
+  for (const f of ['derived-runtime.mjs', 'schedule_reader.mjs']) fs.copyFileSync(path.join(release, f), path.join(rel, f));
+  // the install.sh layout: /opt/enclave-network/current -> <release>; node runs current/wg-provider.mjs
+  const current = path.join(tmp, 'current'); fs.symlinkSync(rel, current);
+  let r = await run([path.join(current, 'wg-provider.mjs'), '--check-config', DERIVED]);
+  assert.equal(r.code, 0, r.out); assert.equal(last(r).paidFinality, 'derived'); assert.equal(last(r).derivedRuntime, path.join(rel, 'derived-runtime.mjs'));
+  r = await run([path.join(current, 'wg-provider.mjs'), '--check-config', QUORUM]); assert.equal(r.code, 0, r.out);
+  fs.appendFileSync(path.join(rel, 'schedule_reader.mjs'), '\n// altered\n');
+  r = await run([path.join(current, 'wg-provider.mjs'), '--check-config', DERIVED]); assert.notEqual(r.code, 0); assert.match(r.out, /reader_pin: .*is not the frozen reader 688b7a1f09c8/);
+  fs.rmSync(path.join(rel, 'schedule_reader.mjs'));
+  r = await run([path.join(current, 'wg-provider.mjs'), '--check-config', DERIVED]); assert.notEqual(r.code, 0); assert.match(r.out, /did not load \(ENOENT/);
+  r = await run([path.join(current, 'wg-provider.mjs'), '--check-config', QUORUM]); assert.equal(r.code, 0, 'a quorum provider never needs the derived files');
+});
+
+test('source entry: the same configurations, the runtime resolved from the source tree', { timeout: 120_000 }, async () => {
+  const entry = path.join(REPO, 'network/wg-provider/main.mjs');
+  let r = await run([entry, '--check-config', DERIVED]);
+  assert.equal(r.code, 0, r.out); assert.equal(last(r).derivedRuntime, path.join(REPO, 'network/wg-provider/derived-runtime.mjs'));
+  r = await run([entry, '--check-config', QUORUM]); assert.equal(r.code, 0, r.out); assert.equal(last(r).chainAuthority, 'quorum');
+});
+
+test('the RELEASE derived-runtime.mjs runs the WHOLE adapter suite: exact counts, every test ok, no skipped or recursive run', { timeout: 300_000 }, async (t) => {
+  const suite = path.join(REPO, 'test/paid-derived-adapter.test.mjs');
+  const expected = (fs.readFileSync(suite, 'utf8').match(/^test\(/gm) || []).length;
+  assert.equal(expected, 15);
+  const runtime = path.join(release, 'derived-runtime.mjs');
+  const r = await run(['--test', '--test-reporter=tap', '--test-concurrency=1', '--test-timeout=120000', suite], { env: childEnv({ PAID_DERIVED_RUNTIME: runtime }) });
+  assert.equal(r.code, 0, r.out);
+  assert.doesNotMatch(r.out, /called recursively|skipping running files/, 'the nested runner ran its files');
+  assert.ok(r.out.includes(`# runtime: packaged ${runtime}`), 'the suite ran against the RELEASE runtime');
+  for (const [k, v] of [['tests', expected], ['pass', expected], ['fail', 0], ['skipped', 0], ['todo', 0], ['cancelled', 0]]) assert.match(r.out, new RegExp(`^# ${k} ${v}$`, 'm'), k);
+  assert.equal((r.out.match(/^ok \d+ - /gm) || []).length, expected); assert.doesNotMatch(r.out, /^not ok /m); assert.doesNotMatch(r.out, /# (SKIP|TODO)\b/);
+  t.diagnostic(`nested adapter suite: tests ${expected} pass ${expected} fail 0 skipped 0 todo 0 cancelled 0 against ${runtime}`);
+});
