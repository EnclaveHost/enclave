+// The paid provider's derived-finality runtime (paidFinality "derived"), loaded by main.mjs ONLY under that mode, through a
+// module-relative import that no bundler inlines: in the source tree this file; in a release the separately bundled
+// derived-runtime.mjs beside wg-provider.mjs (scripts/network/build-consumers.mjs). The quorum and attested modes, source or
+// packaged, never load it - so they need none of its resources.
+//
+// Its one module-relative resource: network/derived-reader/vendor/schedule-input-r2.mjs checks at load that
+// ./schedule_reader.mjs NEXT TO IT (import.meta.url) is the frozen reader (sha256 688b7a1f…, verifyReaderPin) and imports
+// it. In the source tree that is the vendor copy; in a release it is the pinned copy build-consumers.mjs writes beside this
+// bundle. A missing or different file refuses at load ("reader_pin" / ENOENT): no unpinned reader ever runs.
+//
+// The reader composition is network/derived-reader/main.mjs runDerivedReader exactly (startDerivedReader, then its loopback
+// witness API serveDerivedReader with the same bounds; close both), taken from its modules rather than from main.mjs: that
+// file's own "am I the main script?" check would be TRUE inside a bundle and run the reader's command line in the provider.
+import { startDerivedReader } from '../derived-reader/provider.mjs';
+import { serveDerivedReader } from '../derived-reader/api.mjs';
