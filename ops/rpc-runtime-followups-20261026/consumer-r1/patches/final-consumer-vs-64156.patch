+    const [, , held] = await client.readContract({ address: connectivity, abi: connectivityQualificationABI, functionName: 'attestations', args: [hostId, signer] });
+    if (Number(held) >= o.expires) continue;
+    later.push(await wallet.writeContract({ address: connectivity, abi: connectivityQualificationABI, functionName: 'qualify',
+      args: [o.hostId, o.addressHash, BigInt(o.issuedAt), BigInt(o.expires), o.checks, o.signature] }));
+  }
+  for (const tx of later) { if ((await client.waitForTransactionReceipt({ hash: tx, timeout: 60000 })).status !== 'success') throw new Error('qualify reverted (tx ' + tx + ')'); sent++; }
+  return sent;
+}
+
+/** -> { reader, port, close } : the in-process derived reader and its loopback witness API (local orchestration, never authority). */
+export async function runDerivedReader(config, options = {}) {
+  const reader = await startDerivedReader(config, options);
+  let api;
+  try { api = await serveDerivedReader(reader, { port: config.apiPort, maxWitnessBytes: config.maxWitnessBytes, operationTimeoutMs: config.nativeTimeoutMs }); }
+  catch (e) { await reader.close(); throw e; }
+  let closing;
+  return { reader, port: api.port, close() { return closing ||= (async () => { await api.close(); await reader.close(); })(); } };
+}
