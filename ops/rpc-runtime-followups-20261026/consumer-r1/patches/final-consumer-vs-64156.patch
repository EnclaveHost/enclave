+    return b;
+  };
+  ex.request = async (method, params = []) => {
+    ex.calls.push({ method, params });
+    switch (method) {
+      case 'eth_chainId': return ex.chainId;
+      case 'eth_getBlockByNumber': { const b = w.at(Number(BigInt(params[0])), chain()); return b && { number: hex(b.number), hash: b.hash, stateRoot: b.header.stateRoot, timestamp: hex(b.timestamp), baseFeePerGas: b.header.baseFeePerGas }; }
