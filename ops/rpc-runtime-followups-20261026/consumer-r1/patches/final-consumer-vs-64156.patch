+    acceptAnchor(c, anchor) {
+      chain(c); checkAnchor(anchor, 'acceptAnchor');
+      if (floor && ['base', 'l1'].some((k) => anchor[k].number < floor[k].number || (anchor[k].number === floor[k].number && anchor[k].hash !== floor[k].hash)))
+        throw new Error('derived anchor rollback or contradiction (below or beside the durable floor)');
+      const next = { tier: anchor.tier, base: { ...anchor.base }, l1: { ...anchor.l1 } };
+      strictWriteFile(file, JSON.stringify({ format: FORMAT, chainId, anchor: next }));
+      floor = next;
+    } });
+}
