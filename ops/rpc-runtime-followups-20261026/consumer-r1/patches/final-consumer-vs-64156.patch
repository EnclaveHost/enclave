+                  ...(hasNonce ? { depositNonce: qty(r.depositNonce, `${what}.depositNonce`) } : {}),
+                  ...(hasVer ? { depositReceiptVersion: qty(r.depositReceiptVersion, `${what}.depositReceiptVersion`) } : {}) };
