@@ -15,6 +15,30 @@ import { startDerivedReader } from '../derived-reader/provider.mjs';
 import { serveDerivedReader } from '../derived-reader/api.mjs';
 export { createDerivedSubmitter } from './derived-submission.mjs';
 export { openDerivedAnchorFloor } from './derived-anchor-floor.mjs';
+import { recoverMessageAddress } from 'viem';
+import { connectivityQualificationABI, validateOnchain, addressHash } from '../onchain-qualification.mjs';
+
+/**
+ * network/onchain-qualification.mjs submitAttestations (UNCHANGED, shared with the relay runtime and its pinned bundles) with
+ * one difference for a submitter that keeps several sends pending (derived-submission.mjs): every current attestation is
+ * SUBMITTED first, then each receipt is awaited in the same order (the first that is not confirmed throws; the rest stay
+ * pending in the nonce journal, never re-signed). The same selection rules and the same contract reads. -> the number confirmed.
+ */
+export async function submitAttestationsPipelined({ wallet, client, connectivity, hostId, address, attestations, minRemainingS = 60, now = Date.now() }) {
+  let sent = 0; const t = Math.floor(now / 1000), hash = addressHash(address), later = [];
+  for (const raw of attestations) {
+    let o; try { o = validateOnchain(raw); } catch { continue; }
+    if (o.hostId !== hostId || o.addressHash !== hash || o.expires <= t + minRemainingS || o.issuedAt > t + 60) continue;
+    const digest = await client.readContract({ address: connectivity, abi: connectivityQualificationABI, functionName: 'qualificationDigest', args: [o.hostId, o.addressHash, BigInt(o.issuedAt), BigInt(o.expires), o.checks] });
+    const signer = await recoverMessageAddress({ message: { raw: digest }, signature: o.signature });
+    const [, , held] = await client.readContract({ address: connectivity, abi: connectivityQualificationABI, functionName: 'attestations', args: [hostId, signer] });
+    if (Number(held) >= o.expires) continue;
+    later.push(await wallet.writeContract({ address: connectivity, abi: connectivityQualificationABI, functionName: 'qualify',
+      args: [o.hostId, o.addressHash, BigInt(o.issuedAt), BigInt(o.expires), o.checks, o.signature] }));
+  }
+  for (const tx of later) { if ((await client.waitForTransactionReceipt({ hash: tx, timeout: 60000 })).status !== 'success') throw new Error('qualify reverted (tx ' + tx + ')'); sent++; }
+  return sent;
+}
 
