index 0000000000000000000000000000000000000000..376956263dc9c65f5b16ad047ad9d2bf4fb4d7a3
--- /dev/null
+++ b/relay/derived-reader-runtime.mjs
@@ -0,0 +1,13 @@
+// The relay's derived-reader runtime: KVM's committed reader (network/derived-reader, 34a3c0d6d) for the lease writer authority
+// under ENCLAVE_WRITER_AUTHORITY_SOURCE=derived (relay/derived-writer-authority.mjs). It is built SEPARATELY from
+// network-runtime.bundle.mjs (relay/build-derived-reader-runtime.mjs -> derived-reader-runtime.bundle.mjs, with the pinned
+// schedule_reader.mjs beside it) and loaded by api-relay.js only under that selector, through a module-relative path no bundler
+// inlines. network-runtime.bundle.mjs - and everything that pins its bytes (host-service packages, the platform-api guest
+// manifest, challenge replicas) - is untouched, and no other relay mode needs or loads these files.
+// The reader is an in-process capability only: it starts from the operator's private config file; no URL, status endpoint or
+// saved JSON is ever reader authority (the selector refuses them before this module is loaded).
+export { startDerivedLifecycleReader } from '../network/derived-reader/lifecycle.mjs';
+export { serveDerivedReader } from '../network/derived-reader/api.mjs';
+export { openLifecycleJournal } from '../network/deployment-lifecycle-journal.mjs';
+/** The file this runtime was loaded from (for startup logs). */
+export const DERIVED_READER_RUNTIME_URL = import.meta.url;
diff --git a/test/relay-derived-reader-runtime.test.mjs b/test/relay-derived-reader-runtime.test.mjs
new file mode 100644
index 0000000000000000000000000000000000000000..a6ae8c9558801d56d7f3c64eb198200ec13166a1
--- /dev/null
+++ b/test/relay-derived-reader-runtime.test.mjs
@@ -0,0 +1,87 @@
+// The relay's SEPARATE derived-reader runtime (relay/derived-reader-runtime.mjs -> relay/build-derived-reader-runtime.mjs ->
+// derived-reader-runtime.bundle.mjs + its pinned schedule_reader.mjs): the lease writer authority's only path to KVM's committed
+// 34a3 reader under ENCLAVE_WRITER_AUTHORITY_SOURCE=derived.
+// What is real: the builder, the bundle (the committed reader code inside it, its own verifyReaderPin at load), the relay
+// entrypoint api-relay.js, the writer authority module, and KVM's startDerivedLifecycleReader running in this process.
+// What is a FIXTURE (labelled; never derivation or consensus evidence): KVM's own test fake L1 process and echo native
+// (test/derived-reader/helpers.mjs), accepted only through programmatic test options - so the reader starts, owns its private
+// state and answers "no locally derived anchor"; no Base block is derived, no anchor exists, nothing is fresh.
+// Freshness: the writer authority keeps its 120 s ceiling (an L1-finalized anchor is normally far older); it is not widened here.
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import fs from 'node:fs';
+import os from 'node:os';
+import path from 'node:path';
+import { execFile } from 'node:child_process';
+import { createHash } from 'node:crypto';
+import { fileURLToPath, pathToFileURL } from 'node:url';
+import { setup } from './derived-reader/helpers.mjs';
+import { sha256File } from '../network/derived-reader/process.mjs';
+import { createDerivedWriterAuthority, MAX_ANCHOR_AGE_SEC } from '../relay/derived-writer-authority.mjs';
+
+const REPO = path.resolve(path.dirname(fileURLToPath(import.meta.url)), '..'), RELAY = path.join(REPO, 'relay');
+const tmp = fs.mkdtempSync(path.join(process.env.TMPDIR || os.tmpdir(), 'relay-derived-'));
+test.after(() => fs.rmSync(tmp, { recursive: true, force: true }));
+const childEnv = (extra = {}) => Object.fromEntries(Object.entries({ PATH: process.env.PATH, HOME: tmp, TMPDIR: tmp, ...extra }).filter(([k]) => !k.startsWith('NODE_TEST')));
+const run = (args, opts = {}) => new Promise((resolve) => execFile(process.execPath, args, { cwd: REPO, timeout: 120_000, maxBuffer: 16 << 20, env: childEnv(), ...opts },
+  (e, so, se) => resolve({ code: e ? (e.code ?? e.signal ?? 1) : 0, out: String(so) + String(se) })));
+const sha = (f) => createHash('sha256').update(fs.readFileSync(f)).digest('hex');
+const READER_PIN = JSON.parse(fs.readFileSync(path.join(REPO, 'network/derived-reader/vendor/provenance.json'), 'utf8'))['schedule_reader.mjs'].sha256;
+const out = path.join(tmp, 'build');
+
+test('the relay reader runtime builds reproducibly: committed reader inside, pinned reader beside, never the shared network runtime', async () => {
+  const r = await run([path.join(RELAY, 'build-derived-reader-runtime.mjs'), out]); assert.equal(r.code, 0, r.out);
+  const m = JSON.parse(fs.readFileSync(path.join(out, 'derived-reader-runtime.bundle.mjs.manifest.json'), 'utf8'));
+  assert.equal(m.sha256, sha(path.join(out, 'derived-reader-runtime.bundle.mjs')));
+  assert.equal(sha(path.join(out, 'schedule_reader.mjs')), READER_PIN); assert.equal(m.scheduleReaderSha256, READER_PIN);
+  for (const f of ['network/derived-reader/lifecycle.mjs', 'network/derived-reader/provider.mjs', 'network/derived-reader/coverage-store.mjs',
+    'network/lifecycle-finality-bridge.mjs', 'network/deployment-lifecycle-journal.mjs', 'network/derived-reader/vendor/schedule-input-r2.mjs']) assert.ok(m.inputs.includes(f), f);
+  assert.ok(!m.inputs.includes('network/derived-reader/main.mjs') && !m.inputs.includes('relay/network-runtime.mjs'));
+  // the release copy in relay/ (built by deploy.sh's step; the root job runs it) is exactly this build
+  for (const f of ['derived-reader-runtime.bundle.mjs', 'derived-reader-runtime.bundle.mjs.manifest.json', 'schedule_reader.mjs']) {
+    assert.ok(fs.existsSync(path.join(RELAY, f)), `relay/${f} is missing: run node relay/build-derived-reader-runtime.mjs first (the release prerequisite)`);
+    assert.ok(fs.readFileSync(path.join(RELAY, f)).equals(fs.readFileSync(path.join(out, f))), `relay/${f} is stale`);
+  }
+});
+
+test('the PACKAGED runtime starts the committed reader in-process and yields the writer capability; with no derived anchor the writer refuses', async (t) => {
+  const rt = await import(pathToFileURL(path.join(out, 'derived-reader-runtime.bundle.mjs')).href);
+  for (const k of ['startDerivedLifecycleReader', 'openLifecycleJournal', 'serveDerivedReader']) assert.equal(typeof rt[k], 'function', k);
+  const f = await setup(t); await f.l1.close();
+  const digest = await sha256File(f.native), stateDir = path.join(f.directory, 'relay-reader-state');
+  const config = { stateDir, initializeState: true, native: { path: f.native, sha256: digest, resultVersion: 3 }, l1: f.l1Config, baseUrl: 'http://127.0.0.1:1', maxAnchorAgeSec: 1800 };
+  const verifier = { request: async () => { throw new Error('fixture: no proof transport'); } };
+  const service = await rt.startDerivedLifecycleReader(config, { verifier, journal: rt.openLifecycleJournal(path.join(f.directory, 'relay-lifecycle.json')),
+    now: () => f.now, l1Options: f.l1Options, acceptedDerivationBuilds: { [digest]: 'relay composition fixture' } });
+  t.after(() => service.close());
+  assert.equal(typeof service.reader.readDerivedLogs, 'function'); assert.equal(typeof service.snapshot, 'function');
+  assert.equal(service.reader.status().resultVersion, 3); assert.equal(service.reader.status().hasDerivedAnchor, false);
+  await assert.rejects(service.snapshot(async () => 1), /no locally derived anchor/);
+  const capability = { snapshot: service.snapshot, readDerivedLogs: (q) => service.reader.readDerivedLogs(q) };
+  const fresh = { getBlockNumber: async () => 1n, request: async () => [], readContract: async () => { throw new Error('unused'); } };
+  const authority = createDerivedWriterAuthority({ capability, fresh, addressBook: '0x' + '77'.repeat(20), now: () => f.now });
+  await assert.rejects(authority.writerAuthority('0x' + 'ab'.repeat(32), { runner: '0x' + '11'.repeat(20) }), (e) => e.code === 'derived_unavailable');
+  // the freshness ceiling stays 120 s and cannot be widened (the reader config's own 1800 s bounds the reader only)
+  assert.equal(MAX_ANCHOR_AGE_SEC, 120);
+  assert.throws(() => createDerivedWriterAuthority({ capability, fresh, addressBook: '0x' + '77'.repeat(20), maxAnchorAgeSec: 121 }), /never raised/);
+});
+
+test('the relay entrypoint loads the committed reader under the derived selector and stops with KVM\'s own refusal; unset is unchanged', async () => {
+  const base = { API_RELAY_PORT: '0', ADDRESS_BOOK_ADDRESS: '0x7777777777777777777777777777777777777777', ENCLAVE_CHAIN_AUTHORITY: 'verifier', ENCLAVE_CHAIN_VERIFIER: 'http://127.0.0.1:9' };
+  const relay = (extra, timeout = 90_000) => run(['api-relay.js'], { cwd: RELAY, timeout, env: childEnv({ ...base, ...extra }) });
+  const cfg = (name, c) => { const p = path.join(tmp, name); fs.writeFileSync(p, JSON.stringify(c)); return p; };
+  const derived = (c) => ({ ENCLAVE_WRITER_AUTHORITY_SOURCE: 'derived', ENCLAVE_DERIVED_READER_CONFIG: c, ENCLAVE_DERIVED_ANCHOR_JOURNAL: path.join(tmp, 'anchor-journal.json') });
+  // an unqualified native pin: KVM's committed startDerivedReader refuses before creating anything
+  let r = await relay(derived(cfg('unqualified.json', { stateDir: path.join(tmp, 's1'), native: { path: '/nonexistent', sha256: '1'.repeat(64), resultVersion: 3 } })));
+  assert.equal(r.code, 1, r.out); assert.match(r.out, /fatal: writer authority: no qualified native derivation build configured/); assert.doesNotMatch(r.out, /not composed/);
+  // the production v3 shape (pinned native 49f4d7e3): the reader proceeds to its measured-image assets, absent here -> refused
+  const v3 = JSON.parse(fs.readFileSync(path.join(REPO, 'network/derived-reader/config.v3.example.json'), 'utf8'));
+  r = await relay(derived(cfg('v3.json', { ...v3, stateDir: path.join(tmp, 's2') })));
+  assert.equal(r.code, 1, r.out); assert.match(r.out, /fatal: writer authority: .*(ENOENT|checkpoint|no such file)/i); assert.doesNotMatch(r.out, /not composed/);
+  // a URL is never a reader capability (refused before the runtime is loaded)
+  r = await relay(derived('http://127.0.0.1:9/reader'));
+  assert.equal(r.code, 1); assert.match(r.out, /absolute file path/);
+  // unset: exactly the existing behaviour (the explicit writer_authority_unproven refusal; the relay keeps starting)
+  r = await relay({}, 25_000);
+  assert.match(r.out, /\[lease-generation\] REFUSED under the verifier authority/); assert.doesNotMatch(r.out, /fatal: writer authority/);
+});
