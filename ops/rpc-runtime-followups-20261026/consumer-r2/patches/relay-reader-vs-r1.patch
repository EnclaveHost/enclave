+#!/usr/bin/env node
+// Builds the relay's SEPARATE derived-reader runtime (relay/derived-reader-runtime.mjs) into OUTDIR (default relay/):
+//   derived-reader-runtime.bundle.mjs (+ .manifest.json: sha256 and inputs) and schedule_reader.mjs beside it - the one file the
+//   bundled reader resolves at load from its own location (network/derived-reader/vendor/schedule-input-r2.mjs verifyReaderPin),
+//   copied byte for byte after checking its provenance pin. The same recipe as scripts/network/build-consumers.mjs for the
+//   provider's derived-runtime.mjs. relay/deploy.sh runs it after build-network.mjs; network-runtime.bundle.mjs is not touched.
+import {build} from 'esbuild';
+import fs from 'node:fs/promises';
+import path from 'node:path';
+import {fileURLToPath} from 'node:url';
+import {createHash} from 'node:crypto';
+import {checkBundle} from '../network/bundle-checks.mjs';
+const here=path.dirname(fileURLToPath(import.meta.url)),root=path.resolve(here,'..');
+const out=path.resolve(process.argv[2]||here);
+await fs.mkdir(out,{recursive:true});
+const outfile=path.join(out,'derived-reader-runtime.bundle.mjs');
+const result=await build({absWorkingDir:root,entryPoints:['relay/derived-reader-runtime.mjs'],outfile,bundle:true,platform:'node',format:'esm',target:'node22',metafile:true,
+ banner:{js:'import {createRequire as __enclaveDerivedReaderRequire} from "node:module"; const require=__enclaveDerivedReaderRequire(import.meta.url);'}});
+const inputs=Object.keys(result.metafile.inputs).sort();
+if(inputs.includes('network/derived-reader/main.mjs'))throw Error('the reader CLI (its main-script check) must not be bundled');
+if(!inputs.includes('network/derived-reader/vendor/schedule-input-r2.mjs'))throw Error('the bundle does not carry the schedule input bridge');
+checkBundle(outfile);
+const pin=JSON.parse(await fs.readFile(path.join(root,'network/derived-reader/vendor/provenance.json'),'utf8'))['schedule_reader.mjs']?.sha256;
+const reader=await fs.readFile(path.join(root,'network/derived-reader/vendor/schedule_reader.mjs')),readerSha=createHash('sha256').update(reader).digest('hex');
+if(!/^[0-9a-f]{64}$/.test(pin||'')||readerSha!==pin)throw Error(`network/derived-reader/vendor/schedule_reader.mjs is not its provenance pin ${pin}`);
+await fs.writeFile(path.join(out,'schedule_reader.mjs'),reader);
+const sha256=createHash('sha256').update(await fs.readFile(outfile)).digest('hex');
+await fs.writeFile(outfile+'.manifest.json',JSON.stringify({sha256,scheduleReaderSha256:readerSha,inputs},null,2)+'\n');
+console.log(JSON.stringify({outfile,sha256,scheduleReaderSha256:readerSha}));
