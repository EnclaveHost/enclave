 if (args.some((a, i) => !(a === "--check" || a === "--out" || (outIdx >= 0 && i === outIdx + 1)))) throw new Error("usage: build-platform-api-guest-bundle.mjs [--check] [--out DIR]");
diff --git a/test/relay-derived-reader-runtime.test.mjs b/test/relay-derived-reader-runtime.test.mjs
index a6ae8c9558801d56d7f3c64eb198200ec13166a1..b0a06537211b77d4d98eb1f15ce42bec0175961a 100644
--- a/test/relay-derived-reader-runtime.test.mjs
+++ b/test/relay-derived-reader-runtime.test.mjs
@@ -85,3 +85,25 @@ test('the relay entrypoint loads the committed reader under the derived selector
   r = await relay({}, 25_000);
   assert.match(r.out, /\[lease-generation\] REFUSED under the verifier authority/); assert.doesNotMatch(r.out, /fatal: writer authority/);
 });
+
+test('the MEASURED guest ships the runtime: platform-api sidecars carry it (hashed), the guest resolves it beside itself and loads it, a missing pin refuses', async () => {
+  // metal/build-image.mjs copies every manifest sidecar beside /opt/metal/platform-api.bundle.mjs and verifies its sha256
+  const man = JSON.parse(fs.readFileSync(path.join(REPO, 'metal/guest/platform-api.bundle.mjs.manifest.json'), 'utf8'));
+  assert.deepEqual(man.sidecars['derived-reader-runtime.bundle.mjs'], { source: 'relay/derived-reader-runtime.bundle.mjs', sha256: sha(path.join(RELAY, 'derived-reader-runtime.bundle.mjs')) });
+  assert.deepEqual(man.sidecars['schedule_reader.mjs'], { source: 'relay/schedule_reader.mjs', sha256: READER_PIN });
+  assert.ok(!Object.keys(man.inputs).some((i) => i.startsWith('network/derived-reader/') || i === 'relay/derived-reader-runtime.mjs'), 'the guest bundle itself carries no reader code');
+  const guest = fs.readFileSync(path.join(REPO, 'metal/guest/platform-api.bundle.mjs'), 'utf8');
+  assert.ok(guest.includes('new URL("./derived-reader-runtime.bundle.mjs", import.meta.url)'), 'the guest resolves the runtime beside its own bundle');
+  const opt = path.join(tmp, 'opt-metal');
+  fs.mkdirSync(opt, { recursive: true }); fs.copyFileSync(path.join(REPO, 'metal/guest/platform-api.bundle.mjs'), path.join(opt, 'platform-api.bundle.mjs'));
+  for (const [beside, s] of Object.entries(man.sidecars)) {
+    const to = path.join(opt, beside); fs.mkdirSync(path.dirname(to), { recursive: true }); fs.copyFileSync(path.join(REPO, s.source), to);
+    assert.equal(sha(to), s.sha256, `sidecar ${beside}`);
+  }
+  assert.equal(sha(path.join(opt, 'platform-api.bundle.mjs')), man.sha256);
+  const load = () => run(['--input-type=module', '-e', 'const m = await import(process.argv[1]); console.log(["startDerivedLifecycleReader","openLifecycleJournal","serveDerivedReader"].map((k) => typeof m[k]).join(","))',
+    pathToFileURL(path.join(opt, 'derived-reader-runtime.bundle.mjs')).href], { cwd: opt });
+  let r = await load(); assert.equal(r.code, 0, r.out); assert.match(r.out, /^function,function,function$/m);
+  fs.rmSync(path.join(opt, 'schedule_reader.mjs'));
+  r = await load(); assert.notEqual(r.code, 0); assert.match(r.out, /ENOENT|schedule_reader/);
+});
