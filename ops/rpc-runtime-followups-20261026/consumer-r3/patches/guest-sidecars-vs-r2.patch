-export const SIDECARS = Object.freeze({ "fixtures/tpm-roots.pem": "relay/fixtures/tpm-roots.pem" });   // beside the bundle -> source
+// relay/api-relay.js loads the lease writer's derived-reader runtime by a module-relative URL (never bundled) only under
