+  const retry = await p.prepare({ blockNumber: 101, rollupConfigTemplate: { l2_chain_id: 8453 } });
+  const forged = nativeResult(retry, f.candidate); forged.l2OutputRoot = `0x${'ff'.repeat(32)}`;
