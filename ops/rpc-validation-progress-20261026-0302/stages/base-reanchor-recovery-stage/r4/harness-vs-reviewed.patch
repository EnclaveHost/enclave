+        wfd = os.open(p, os.O_WRONLY | os.O_APPEND | os.O_NOFOLLOW | os.O_CLOEXEC | (os.O_CREAT | os.O_EXCL if created else 0), 0o600)
+        try:
+            if os.fstat(wfd).st_size != len(raw):
+                refuse('a1_ledger', 'the ledger changed while the lock was held')
