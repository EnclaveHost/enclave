# base-finality-proof-stage/r6 (SOURCE ONLY; not installed): root publishes the post-anchor finality status of the RUNNING Base node.
[Unit]
Description=Publish Base post-anchor finality status (finality_state status-publish)
[Service]
Type=oneshot
User=root
ExecStart=/usr/bin/python3 -I -B /opt/enclave-rpc/finality/src/finality_state.py status-publish /etc/enclave-rpc/base-bootstrap /etc/enclave-rpc/chain.json /etc/enclave-rpc/base-bootstrap/finality http://127.0.0.1:18545/ /run/enclave-rpc/base-finality-status.json
RuntimeDirectory=enclave-rpc
RuntimeDirectoryMode=0755
RuntimeDirectoryPreserve=yes
NoNewPrivileges=yes
PrivateTmp=yes
PrivateNetwork=no
ProtectSystem=strict
ReadWritePaths=/run/enclave-rpc
ProtectHome=yes
