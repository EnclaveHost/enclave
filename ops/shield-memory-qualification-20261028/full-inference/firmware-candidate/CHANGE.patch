   //
   // Iterate through the system RAM and validate it.
   //
+  // Resource HOBs appended by this loop (the deferred tails below) are visited
+  // later in the same walk. They are EFI_RESOURCE_MEMORY_UNACCEPTED, so they
+  // are skipped and never split again.
+  //
+  PhitHob         = GetHobList ();
+  WindowRemaining = SNP_BOOT_WINDOW_LIMIT - SNP_BOOT_WINDOW_BASE;
+  WindowAcceptedEnd = SNP_BOOT_WINDOW_BASE;
   for (Hob.Raw = GetHobList (); !END_OF_HOB_LIST (Hob); Hob.Raw = GET_NEXT_HOB (Hob)) {
     if ((Hob.Raw != NULL) && (GET_HOB_TYPE (Hob) == EFI_HOB_TYPE_RESOURCE_DESCRIPTOR)) {
       ResourceHob = Hob.ResourceDescriptor;
@@ -159,8 +173,53 @@
         if ((ResourceHob->PhysicalStart >= SIZE_4GB) &&
             ((ResourceHob->ResourceAttribute & EFI_RESOURCE_ATTRIBUTE_SPECIAL_PURPOSE) == 0))
         {
-          ResourceHob->ResourceType = EFI_RESOURCE_MEMORY_UNACCEPTED;
-          continue;
+          //
+          // Pre-validate only the part of this range that lies inside the boot
+          // window [4GB, 6GB), so boot services can place large buffers (for
+          // example the initrd that the Linux EFI stub copies) above 4GB. The
+          // rest stays unaccepted for the OS. Anything unusual (unaligned,
+          // empty, overflowing, over budget) keeps the original behaviour of
+          // deferring the whole range. See SnpBootWindow.h.
+          //
+          // Reject overlapping or out-of-order high heads. A byte budget alone
+          // cannot prevent a short duplicate from being pre-validated twice.
+          WindowAction = SnpBootWindowDeferAll;
+          if (ResourceHob->PhysicalStart >= WindowAcceptedEnd) {
+            WindowAction = SnpBootWindowClassify (
+                             ResourceHob->PhysicalStart,
+                             ResourceHob->ResourceLength,
+                             WindowRemaining,
+                             &HeadLength
+                             );
+          }
+          if (WindowAction == SnpBootWindowSplit) {
+            //
+            // Append the tail as a new unaccepted HOB before shrinking this
+            // one, so a failed append loses no memory. HobLib returns nothing
+            // on failure, so detect it from the PHIT end-of-list pointer.
+            //
+            EndOfHobList = PhitHob->EfiEndOfHobList;
+            BuildResourceDescriptorWithOwnerHob (
+              EFI_RESOURCE_MEMORY_UNACCEPTED,
+              ResourceHob->ResourceAttribute,
+              ResourceHob->PhysicalStart + HeadLength,
+              ResourceHob->ResourceLength - HeadLength,
+              &ResourceHob->Owner
+              );
+            if (PhitHob->EfiEndOfHobList == EndOfHobList) {
+              WindowAction = SnpBootWindowDeferAll;
+            } else {
+              ResourceHob->ResourceLength = HeadLength;
+            }
+          }
+
+          if (WindowAction == SnpBootWindowDeferAll) {
+            ResourceHob->ResourceType = EFI_RESOURCE_MEMORY_UNACCEPTED;
+            continue;
+          }
+
+          WindowRemaining -= HeadLength;
+          WindowAcceptedEnd = ResourceHob->PhysicalStart + HeadLength;
         }
 
