+int sh_link_p24_corrupt_ready(sh_link *l, int group) {
+    if (!l || !l->pack24 || group < 0 || (size_t)group >= l->n_groups) return -1;
+    pthread_mutex_lock(&l->pool_mu);
+    sh_group *g = &l->groups[group];
+    int n = 0;
+    if (g->r_p24)
+        for (int i = 0; i < g->count; i++, n++) {
+            uint8_t *rs = g->r_p24 + (size_t)((g->head + i) % g->depth) * (size_t)g->K * SH_P24_BYTES;
+            sh_p24_put(rs, SH_P24_R_LIMIT);              /* r == M: one past the field */
+        }
+    pthread_mutex_unlock(&l->pool_mu);
+    return n;
+}
