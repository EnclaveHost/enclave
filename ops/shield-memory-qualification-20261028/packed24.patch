+/* SHIELDED_POOL_PACK24: b staged rows into ring slots first.. (mod depth),
+ * which this thread reserved and nobody reads until they are marked ready. A
+ * value out of range is a producer bug, not a pad: nothing of the batch is
+ * kept (every slot is poisoned again) and the link retires. */
+static int p24_store(sh_link *l, sh_group *g, int first, int b, const int32_t *r, const int32_t *u) {
+    const size_t K = (size_t)g->K, U = (size_t)g->u_len;
+    for (int i = 0; i < b; i++) {
+        const size_t slot = (size_t)((first + i) % g->depth);
+        if (sh_p24_pack_r(r + (size_t)i * K, K, g->r_p24 + slot * K * SH_P24_BYTES) &&
+            sh_p24_pack_u(u + (size_t)i * U, U, g->u_p24 + slot * U * SH_P24_BYTES)) continue;
+        for (int j = 0; j < b; j++) {
+            const size_t sj = (size_t)((first + j) % g->depth);
+            sh_p24_poison_r(g->r_p24 + sj * K * SH_P24_BYTES, K);
+            sh_p24_poison_u(g->u_p24 + sj * U * SH_P24_BYTES, U);
+        }
+        snprintf(l->err, sizeof l->err, "pad ring: a generated pad is outside the field range (group %s); link retired",
+                 l->nodes[g->nodes[0]].name);
+        __atomic_store_n(&l->pad_integrity_failed, true, __ATOMIC_RELEASE);
+        return SH_ERR_VERIFY;
     }
     return SH_OK;
 }
