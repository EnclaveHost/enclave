+/* ensure() for buffers that hold pad values: the contents are scratch, so
+ * growth is a fresh block and the old one is wiped, never realloc'd away
+ * with the values still in it. want = count x size, overflow-checked. */
+static int ensure_wiped(void **p, size_t *cap, size_t count, size_t size) {
+    size_t want;
+    if (!sh_p24_mul(count, size, &want)) return SH_ERR_NOMEM;
+    if (*cap >= want) return SH_OK;
+    void *n = malloc(want);
+    if (!n) return SH_ERR_NOMEM;
+    sh_p24_wipe(*p, *cap); free(*p);
+    *p = n; *cap = want;
+    return SH_OK;
+}
