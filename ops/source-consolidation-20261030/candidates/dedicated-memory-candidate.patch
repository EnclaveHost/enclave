+			for _, dev := range []string{"ivshmem-plain,memdev=sh0,addr=5", "ivshmem-plain,memdev=sh1,addr=6"} {
+				if !strings.Contains(parts[1], dev) || strings.Contains(parts[0], dev) {
+					t.Fatalf("missing/misplaced Shield device %s: %s", dev, out)
+				}
+			}
+		})
+	}
