index e052cbc48..6142998be 100755
--- a/isolation/m2/run-domain.sh
+++ b/isolation/m2/run-domain.sh
@@ -91,12 +91,21 @@ start)
     fi
   fi
   unit="m2-$tag-$$"
+  # Production guests belong to the independently reserved pool. The unset
+  # case remains for standalone lab launches, which make no reservation claim.
+  # Keep QEMU's Shield arguments in "$@"; these options belong to systemd only.
+  run_guest() { systemd-run "$@"; }
+  case "${ENCLAVE_GUEST_SLICE:-}" in
+    enclave.slice) run_guest() { systemd-run --slice=enclave.slice -p MemoryMin="$((mem + 768))M" -p MemorySwapMax=0 "$@"; } ;;
