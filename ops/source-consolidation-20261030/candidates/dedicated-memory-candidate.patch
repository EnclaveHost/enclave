+import importlib.util
+from pathlib import Path
+import tempfile
+from types import SimpleNamespace
+import unittest
+from unittest.mock import patch
+
+spec = importlib.util.spec_from_file_location('partition', Path(__file__).with_name('partition.py'))
+p = importlib.util.module_from_spec(spec)
+spec.loader.exec_module(p)
+
+
+class PartitionTests(unittest.TestCase):
+    def fixture(self):
+        temp = tempfile.TemporaryDirectory()
+        self.addCleanup(temp.cleanup)
+        root = Path(temp.name)
+        manager = '/enclave.slice/user@991.service'
+        pool = manager + '/enclave.slice'
+        plan = {'schema': 1, 'user': 'enclave-host', 'poolCgroup': pool, 'budgetMiB': 400,
+                'kernelHeadroomMiB': 100, 'hostCapsMiB': {'/system.slice': 100, '/user.slice': 300, manager + '/app.slice': 100}}
+        def write(path, name, value):
+            d = root / path.lstrip('/')
+            d.mkdir(parents=True, exist_ok=True)
+            (d / name).write_text(str(value))
+        for path in [pool, manager, '/enclave.slice']:
+            write(path, 'memory.min', 400*p.MIB)
+            write(path, 'memory.max', 'max')
+        write(pool, 'memory.max', 400*p.MIB)
+        write(pool, 'memory.swap.max', 0)
+        for path, cap in plan['hostCapsMiB'].items():
+            write(path, 'memory.max', cap*p.MIB)
+            write(path, 'memory.min', 0)
+        self.enterContext(patch.object(p, 'CG', root))
+        # Default arguments capture constants, so explicitly point the walker
+        # at this fixture while keeping the production walker itself tested.
+        walker = p.boundaries
+        self.enterContext(patch.object(p, 'boundaries', lambda path: walker(path, root)))
+        self.enterContext(patch.object(p, 'total_mib', lambda: 1000))
+        self.enterContext(patch.object(p, 'dedicated_account', lambda _: SimpleNamespace(pw_uid=991)))
+        return plan, write, root
+
+    def test_verified_partition(self):
+        plan, _, _ = self.fixture()
+        p.verify(plan)
+
+    def test_new_login_stays_inside_host_cap(self):
+        plan, write, _ = self.fixture()
+        write('/user.slice/user-1001.slice/session-c8.scope', 'memory.max', 'max')
+        # New host users/sessions need no per-session plan update. Their
+        # combined allocation is bounded by the ONE user.slice cap.
+        p.verify(plan)
+
+    def test_new_uncapped_root_branch_refuses_verification(self):
+        plan, write, _ = self.fixture()
+        write('/unexpected.slice', 'memory.max', 'max')
+        with self.assertRaisesRegex(ValueError, 'boundaries changed'):
+            p.verify(plan)
+
+    def test_host_caps_cannot_spend_the_pool(self):
+        plan, _, _ = self.fixture()
+        plan['hostCapsMiB']['/user.slice'] += 1
+        with self.assertRaisesRegex(ValueError, 'committed enclave pool'):
+            p.verify(plan)
+
+    def test_manifest_without_kernel_enforcement_is_not_enough(self):
+        plan, write, _ = self.fixture()
+        write('/user.slice', 'memory.max', 'max')
+        with self.assertRaisesRegex(ValueError, 'outside limit'):
+            p.verify(plan)
+
+    def test_absent_mount_keeps_its_budget_reserved(self):
+        plan, _, _ = self.fixture()
+        plan['hostCapsMiB']['/inactive.mount'] = 0
+        p.verify(plan)
+
+    def test_apply_requires_administrator(self):
+        self.enterContext(patch.object(p.os, 'geteuid', lambda: 1000))
+        with self.assertRaisesRegex(ValueError, 'administrator'):
+            p.apply({}, False)
+
+    def test_apply_does_not_stop_existing_guests(self):
+        plan, write, root = self.fixture()
+        write('/user.slice/user-1000.slice/app.slice/m2-gdold.service', 'cgroup.events', 'populated 1')
+        self.enterContext(patch.object(p.os, 'geteuid', lambda: 0))
+        run = self.enterContext(patch.object(p.subprocess, 'run'))
+        with self.assertRaisesRegex(ValueError, 'restart migration required'):
+            p.apply(plan, False)
+        run.assert_not_called()
+
+    def test_apply_refuses_to_squeeze_existing_host_work(self):
+        plan, write, _ = self.fixture()
+        for path, cap in plan['hostCapsMiB'].items():
+            write(path, 'memory.current', (cap + 1)*p.MIB)
+        self.enterContext(patch.object(p.os, 'geteuid', lambda: 0))
+        run = self.enterContext(patch.object(p.subprocess, 'run'))
+        with self.assertRaisesRegex(ValueError, 'currently exceeds'):
+            p.apply(plan, False)
+        run.assert_not_called()
+
+
+if __name__ == '__main__':
+    unittest.main()
