diff --git a/isolation/m4/guestd/reservation.go b/isolation/m4/guestd/reservation.go
new file mode 100644
index 000000000..95c5c4df7
--- /dev/null
+++ b/isolation/m4/guestd/reservation.go
@@ -0,0 +1,255 @@
+package main
+
+// A configured budget is not a reservation. A dedicated pool must be backed by
+// a cgroup partition: every branch OUTSIDE the pool has a finite hard limit,
+// whose sum leaves the entire pool plus explicit kernel headroom untouched.
+// memory.min alone protects only used pages and cannot reserve an idle pool.
+// This is resource enforcement by the host kernel, not a new attestation claim
+// or a guarantee against a malicious host administrator changing the kernel.
+
+import (
+	"encoding/json"
+	"fmt"
+	"os"
+	"path/filepath"
+	"strconv"
+	"strings"
+	"syscall"
+)
+
+const mib = int64(1 << 20)
+
+type memoryPartition struct {
+	Schema            int              `json:"schema"`
+	PoolCgroup        string           `json:"poolCgroup"`
+	BudgetMiB         int64            `json:"budgetMiB"`
+	KernelHeadroomMiB int64            `json:"kernelHeadroomMiB"`
+	HostCapsMiB       map[string]int64 `json:"hostCapsMiB"`
+}
+
+func cgroupPath(p string) bool {
+	return strings.HasPrefix(p, "/") && p != "/" && filepath.Clean(p) == p
+}
+
+func cgroupNumber(root, path, name string) (int64, error) {
+	b, err := os.ReadFile(filepath.Join(root, path, name))
+	if err != nil {
+		return 0, err
+	}
+	x := strings.TrimSpace(string(b))
+	if x == "max" {
+		return -1, nil
+	}
+	n, err := strconv.ParseInt(x, 10, 64)
+	if err != nil || n < 0 {
+		return 0, fmt.Errorf("invalid %s in %s", name, path)
+	}
+	return n, nil
+}
+
+func memoryTotalMiB(path string) (int64, error) {
+	b, err := os.ReadFile(path)
+	if err != nil {
+		return 0, err
+	}
+	for _, line := range strings.Split(string(b), "\n") {
+		f := strings.Fields(line)
+		if len(f) == 3 && f[0] == "MemTotal:" && f[2] == "kB" {
+			n, e := strconv.ParseInt(f[1], 10, 64)
+			if e == nil && n > 0 {
+				return n / 1024, nil
+			}
+		}
+	}
+	return 0, fmt.Errorf("cannot read physical memory total")
+}
+
+// Kernel threads are covered by explicit kernel headroom. An ordinary process
+// directly in an ancestor (especially the root cgroup) would escape all of the
+// outside branch caps. Inspect PF_KTHREAD, not a process name or PID range.
+func verifyNoUncappedProcesses(pool, root, proc string) error {
+	for path := filepath.Dir(pool); ; path = filepath.Dir(path) {
+		b, err := os.ReadFile(filepath.Join(root, path, "cgroup.procs"))
+		if err != nil {
+			return err
+		}
+		for _, pid := range strings.Fields(string(b)) {
+			if _, err := strconv.ParseUint(pid, 10, 32); err != nil {
+				return fmt.Errorf("invalid ancestor process id")
+			}
+			stat, err := os.ReadFile(filepath.Join(proc, pid, "stat"))
+			if os.IsNotExist(err) {
+				continue
+			} // exited since the snapshot
+			if err != nil {
+				return fmt.Errorf("cannot check ancestor process %s", pid)
+			}
+			end := strings.LastIndexByte(string(stat), ')')
+			if end < 0 {
+				return fmt.Errorf("invalid ancestor process status")
+			}
+			fields := strings.Fields(string(stat)[end+1:])
+			if len(fields) < 7 {
+				return fmt.Errorf("invalid ancestor process status")
+			}
+			flags, err := strconv.ParseUint(fields[6], 10, 64) // /proc/PID/stat field 9
+			if err != nil || flags&0x00200000 == 0 {
+				return fmt.Errorf("userspace process %s escapes the host memory caps", pid)
+			}
+		}
+		if path == "/" {
+			return nil
+		}
+	}
+}
+
+// verifyPartition reads the kernel's current enforcement, never just the
+// configuration. New uncapped sibling groups, lost ancestor protection, or a
+// budget change immediately make the pool unavailable for new admissions.
+func verifyPartition(p memoryPartition, root string, totalMiB, budgetMiB int64) error {
+	if p.Schema != 1 || p.BudgetMiB != budgetMiB || budgetMiB <= 0 || budgetMiB > totalMiB ||
+		p.KernelHeadroomMiB <= 0 || p.KernelHeadroomMiB > totalMiB || !cgroupPath(p.PoolCgroup) {
+		return fmt.Errorf("invalid memory partition or budget mismatch")
+	}
+	var caps int64
+	for path, n := range p.HostCapsMiB {
+		if !cgroupPath(path) || n < 0 || n > totalMiB || caps > totalMiB-n {
+			return fmt.Errorf("invalid host memory cap")
+		}
+		caps += n
+	}
+	if budgetMiB+p.KernelHeadroomMiB > totalMiB-caps {
+		return fmt.Errorf("host caps leave less than the committed enclave memory")
+	}
+	seen := map[string]bool{}
+	below := int64(0)
+	for path := p.PoolCgroup; path != "/"; path = filepath.Dir(path) {
+		min, err := cgroupNumber(root, path, "memory.min")
+		if err != nil || min < budgetMiB*mib {
+			return fmt.Errorf("%s does not protect the full enclave budget", path)
+		}
+		max, err := cgroupNumber(root, path, "memory.max")
+		if err != nil || (max != -1 && max < (budgetMiB+below)*mib) {
+			return fmt.Errorf("%s restricts the committed pool", path)
+		}
+		if path == p.PoolCgroup {
+			if max != budgetMiB*mib {
+				return fmt.Errorf("enclave pool must have its own exact hard limit")
+			}
+			swap, e := cgroupNumber(root, path, "memory.swap.max")
+			if e != nil || swap != 0 {
+				return fmt.Errorf("enclave pool must not use swap")
+			}
+		}
+		parent := filepath.Dir(path)
+		entries, err := os.ReadDir(filepath.Join(root, parent))
+		if err != nil {
+			return err
+		}
+		for _, ent := range entries {
+			if !ent.IsDir() || ent.Name() == filepath.Base(path) {
+				continue
+			}
+			sibling := filepath.Join(parent, ent.Name())
+			capMiB, ok := p.HostCapsMiB[sibling]
+			if !ok {
+				return fmt.Errorf("unbudgeted host cgroup %s", sibling)
+			}
+			limit, e := cgroupNumber(root, sibling, "memory.max")
+			if e != nil || limit < 0 || limit > capMiB*mib {
+				return fmt.Errorf("host cgroup %s lacks its hard memory limit", sibling)
+			}
+			protection, e := cgroupNumber(root, sibling, "memory.min")
+			if e != nil || protection != 0 {
+				return fmt.Errorf("host cgroup %s competes for protected memory", sibling)
+			}
+			seen[sibling] = true
+			below += capMiB
+		}
+	}
+	for path := range p.HostCapsMiB {
+		if !seen[path] {
+			if _, err := os.Stat(filepath.Join(root, path)); !os.IsNotExist(err) {
+				return fmt.Errorf("host cap %s is not a partition boundary", path)
+			}
+			// An inactive, persistently capped mount/slice consumes nothing. Its
+			// full ceiling still counts in the host sum, and is checked on return.
+		}
+	}
+	return nil
+}
+
+func (s *server) checkMemoryReservation() error {
+	if s.ReservationCheck != nil {
+		return s.ReservationCheck()
+	}
+	info, err := os.Stat(s.MemoryReservation)
+	if err != nil {
+		return fmt.Errorf("memory reservation is not installed")
+	}
+	st, ok := info.Sys().(*syscall.Stat_t)
+	if !ok || st.Uid != 0 || !info.Mode().IsRegular() || info.Mode().Perm()&0022 != 0 {
+		return fmt.Errorf("memory reservation must be an administrator-owned configuration")
+	}
+	b, err := os.ReadFile(s.MemoryReservation)
+	if err != nil {
+		return err
+	}
+	var p memoryPartition
+	if json.Unmarshal(b, &p) != nil {
+		return fmt.Errorf("invalid memory reservation configuration")
+	}
+	// The launcher uses the enclave.slice in THIS user manager. A manifest for
+	// a different manager must never certify where these guests will be placed.
+	self, err := os.ReadFile("/proc/self/cgroup")
+	if err != nil {
+		return err
+	}
+	manager := ""
+	for _, l := range strings.Split(string(self), "\n") {
+		if strings.HasPrefix(l, "0::/") {
+			for path := strings.TrimPrefix(l, "0::"); path != "/"; path = filepath.Dir(path) {
+				if strings.HasPrefix(filepath.Base(path), "user@") && strings.HasSuffix(path, ".service") {
+					manager = path
+					break
+				}
+			}
+		}
+	}
+	if manager == "" || filepath.Dir(manager) != "/enclave.slice" || p.PoolCgroup != filepath.Join(manager, "enclave.slice") {
+		return fmt.Errorf("memory reservation is not for this guest manager")
+	}
+	total, err := memoryTotalMiB("/proc/meminfo")
+	if err != nil {
+		return err
+	}
+	if err = verifyPartition(p, "/sys/fs/cgroup", total, int64(s.Budget.MemMiB)); err != nil {
+		return err
+	}
+	if err = verifyNoUncappedProcesses(p.PoolCgroup, "/sys/fs/cgroup", "/proc"); err != nil {
+		return err
+	}
+	// Adoption is non-destructive, but old guests outside the protected slice
+	// block new sales until migrated through a controlled restart.
+	for _, v := range s.vms {
+		if !v.holds() || v.Status == "starting" {
+			continue
+		}
+		unit := v.unit
+		if !strings.HasSuffix(unit, ".service") {
+			unit += ".service"
+		}
+		if filepath.Base(unit) != unit || unit == ".service" {
+			return fmt.Errorf("invalid held guest unit")
+		}
+		limit, e := cgroupNumber("/sys/fs/cgroup", filepath.Join(p.PoolCgroup, unit), "memory.max")
+		if e != nil || limit != int64(v.reservation().MemMiB)*mib {
+			return fmt.Errorf("a held guest is outside the reserved pool or has a changed limit")
+		}
+		minimum, e := cgroupNumber("/sys/fs/cgroup", filepath.Join(p.PoolCgroup, unit), "memory.min")
+		if e != nil || minimum < limit {
+			return fmt.Errorf("a held guest has lost its memory protection")
+		}
+	}
+	return nil
+}
diff --git a/isolation/m4/guestd/reservation_test.go b/isolation/m4/guestd/reservation_test.go
new file mode 100644
index 000000000..4a6313e72
--- /dev/null
+++ b/isolation/m4/guestd/reservation_test.go
@@ -0,0 +1,144 @@
+package main
+
+import (
+	"fmt"
+	"os"
+	"path/filepath"
+	"strings"
+	"testing"
+)
+
+func partitionFixture(t *testing.T) (memoryPartition, string, func(string, string, string)) {
+	t.Helper()
+	root := t.TempDir()
+	write := func(path, name, value string) {
+		t.Helper()
+		dir := filepath.Join(root, path)
+		if err := os.MkdirAll(dir, 0755); err != nil {
+			t.Fatal(err)
+		}
+		if err := os.WriteFile(filepath.Join(dir, name), []byte(value), 0644); err != nil {
+			t.Fatal(err)
+		}
+	}
+	p := memoryPartition{Schema: 1, PoolCgroup: "/user.slice/manager/enclave.slice", BudgetMiB: 400,
+		KernelHeadroomMiB: 100, HostCapsMiB: map[string]int64{"/system.slice": 200, "/user.slice/other": 50, "/user.slice/manager/app.slice": 250}}
+	for _, path := range []string{p.PoolCgroup, "/user.slice/manager", "/user.slice"} {
+		write(path, "memory.min", fmt.Sprint(400*mib))
+		write(path, "memory.max", "max")
+	}
+	write(p.PoolCgroup, "memory.max", fmt.Sprint(400*mib))
+	write(p.PoolCgroup, "memory.swap.max", "0")
+	for path, n := range p.HostCapsMiB {
+		write(path, "memory.max", fmt.Sprint(n*mib))
+		write(path, "memory.min", "0")
+	}
+	return p, root, write
+}
+
+func TestDedicatedPartitionLeavesEntireUnusedPoolAvailable(t *testing.T) {
+	p, root, _ := partitionFixture(t)
+	if err := verifyPartition(p, root, 1000, 400); err != nil {
+		t.Fatal(err)
+	}
+	// Exactly 40% remains committed, even if EVERY outside cgroup grows to
+	// its limit. No MemAvailable sample participates in the verification.
+	if err := verifyPartition(p, root, 999, 400); err == nil {
+		t.Fatal("accepted a physically overcommitted pool")
+	}
+}
+
+func TestReservationCannotBeReplacedByAnAccountingPromise(t *testing.T) {
+	for _, scenario := range []string{"uncapped-host", "lost-parent-min", "new-host-group", "pool-too-small", "swap", "competing-min", "parent-cap", "wrong-budget", "bad-path", "stale-cap"} {
+		t.Run(scenario, func(t *testing.T) {
+			p, root, write := partitionFixture(t)
+			switch scenario {
+			case "uncapped-host":
+				write("/system.slice", "memory.max", "max")
+			case "lost-parent-min":
+				write("/user.slice", "memory.min", "0")
+			case "new-host-group":
+				write("/new.slice", "memory.max", "max")
+			case "pool-too-small":
+				write(p.PoolCgroup, "memory.max", fmt.Sprint(399*mib))
+			case "swap":
+				write(p.PoolCgroup, "memory.swap.max", "max")
+			case "competing-min":
+				write("/system.slice", "memory.min", "1")
+			case "parent-cap":
+				write("/user.slice", "memory.max", fmt.Sprint(500*mib))
+			case "wrong-budget":
+				p.BudgetMiB = 399
+			case "bad-path":
+				p.PoolCgroup = "/user.slice/../enclave.slice"
+			case "stale-cap":
+				p.HostCapsMiB["/user.slice/manager/app.slice/nested"] = 0
+				write("/user.slice/manager/app.slice/nested", "memory.max", "0")
+			}
+			if err := verifyPartition(p, root, 1000, 400); err == nil {
+				t.Fatal("unbacked reservation accepted")
+			}
+		})
+	}
+}
+
+func TestDedicatedAdmissionDoesNotDiscountHostActivity(t *testing.T) {
+	s := newServer(nil, t.TempDir())
+	s.Budget = poolBudget{MemMiB: 400, CPUPct: 100}
+	s.MemoryReservation = "/test/partition.json"
+	s.ReservationCheck = func() error { return nil }
+	s.HostFloorMiB = 16384
+	s.MemAvailable = func() (int, error) { t.Fatal("dedicated admission read live host memory"); return 0, nil }
+	if why := s.admitLocked(reservation{MemMiB: 400, CPUPct: 100}); why != nil {
+		t.Fatal(why)
+	}
+	if why := s.admitLocked(reservation{MemMiB: 401, CPUPct: 100}); why["error"] != "pool_full" {
+		t.Fatal(why)
+	}
+	// A lost enforcement configuration immediately stops sales, without
+	// changing the configured size or terminating already-held guests.
+	s.ReservationCheck = func() error { return fmt.Errorf("host limit removed") }
+	if why := s.admitLocked(reservation{MemMiB: 1, CPUPct: 1}); why["error"] != "memory_not_reserved" {
+		t.Fatal(why)
+	}
+	s.MemAvailable = func() (int, error) { return 64000, nil }
+	report := s.poolLocked()
+	if report["free"].(reservation) != (reservation{}) {
+		t.Fatal(report)
+	}
+	if report["budget"].(poolBudget).MemMiB != 400 {
+		t.Fatal("budget changed")
+	}
+	if !strings.Contains(report["memoryReservation"].(map[string]any)["reason"].(string), "removed") {
+		t.Fatal(report)
+	}
+}
+
+func TestUncappedRootUserspaceCannotBorrowIdleCapacity(t *testing.T) {
+	p, root, write := partitionFixture(t)
+	proc := t.TempDir()
+	for path := filepath.Dir(p.PoolCgroup); ; path = filepath.Dir(path) {
+		write(path, "cgroup.procs", "")
+		if path == "/" {
+			break
+		}
+	}
+	if err := os.Mkdir(filepath.Join(proc, "2"), 0755); err != nil {
+		t.Fatal(err)
+	}
+	stat := filepath.Join(proc, "2", "stat")
+	if err := os.WriteFile(stat, []byte("2 (kthreadd) S 0 0 0 0 0 2097152"), 0644); err != nil {
+		t.Fatal(err)
+	}
+	write("/", "cgroup.procs", "2")
+	if err := verifyNoUncappedProcesses(p.PoolCgroup, root, proc); err != nil {
+		t.Fatal(err)
+	}
+	// Naming a userspace process like a kernel thread grants no exemption.
+	if err := os.WriteFile(stat, []byte("2 (kthreadd) S 0 0 0 0 0 4194304"), 0644); err != nil {
+		t.Fatal(err)
+	}
+	if err := verifyNoUncappedProcesses(p.PoolCgroup, root, proc); err == nil {
+		t.Fatal("uncapped userspace accepted")
+	}
+}
