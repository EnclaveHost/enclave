+// Execute the real shell launcher with a recording systemd-run. Resource
+// options must reach systemd, while both Shield devices must still reach QEMU.
+func TestDomainLauncherKeepsResourceAndShieldArgumentsSeparate(t *testing.T) {
+	for _, slice := range []string{"", "enclave.slice"} {
+		t.Run("slice="+slice, func(t *testing.T) {
+			dir := t.TempDir()
+			for _, sub := range []string{"m1", "m2", "bin", "rings"} {
+				if err := os.Mkdir(filepath.Join(dir, sub), 0700); err != nil {
+					t.Fatal(err)
+				}
+			}
+			write := func(path, content string) {
+				t.Helper()
+				if err := os.WriteFile(filepath.Join(dir, path), []byte(content), 0700); err != nil {
+					t.Fatal(err)
+				}
+			}
+			script, err := os.ReadFile("../../m2/run-domain.sh")
+			if err != nil {
+				t.Fatal(err)
+			}
+			write("m2/run-domain.sh", string(script))
+			write("m1/domain.env", "OVMF=firmware\nKERNEL=kernel\nAPPEND=console=ttyS0\n")
+			write("bin/systemd-run", "#!/bin/sh\nprintf '%s\\n' \"$@\" > \"$CAPTURE\"\n")
+			write("guest.cpio.gz", "fixture")
+			write("guest.cpio.gz.shield", "qwen2.5-0.5b-q8-gguf")
+			for _, ring := range []string{"card-0", "card-1"} {
+				write("rings/"+ring, "")
+				if err := os.Truncate(filepath.Join(dir, "rings", ring), 67108864); err != nil {
+					t.Fatal(err)
+				}
+			}
+			capture := filepath.Join(dir, "args")
+			cmd := exec.Command("sh", filepath.Join(dir, "m2/run-domain.sh"), "start", filepath.Join(dir, "guest.cpio.gz"), "snp", "gdtest", dir, "1", "1024", "100")
+			cmd.Env = append(os.Environ(), "PATH="+filepath.Join(dir, "bin")+":"+os.Getenv("PATH"), "CAPTURE="+capture, "ENCLAVE_GUEST_SLICE="+slice, "GUEST_CID=140000", "SHIELDED_SHM_DIR="+filepath.Join(dir, "rings"))
+			if out, err := cmd.CombinedOutput(); err != nil {
+				t.Fatalf("%v: %s", err, out)
+			}
+			out, err := os.ReadFile(capture)
+			if err != nil {
+				t.Fatal(err)
+			}
+			parts := strings.SplitN(string(out), "qemu-system-x86_64\n", 2)
+			if len(parts) != 2 {
+				t.Fatalf("missing QEMU command: %s", out)
+			}
+			for _, opt := range []string{"--slice=enclave.slice", "MemoryMin=1792M", "MemorySwapMax=0"} {
+				if strings.Contains(parts[0], opt) != (slice != "") || strings.Contains(parts[1], opt) {
+					t.Fatalf("misplaced option %s: %s", opt, out)
