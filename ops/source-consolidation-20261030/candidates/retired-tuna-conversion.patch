+import test from 'node:test';
+import assert from 'node:assert/strict';
+import {ASSETS} from '../network/conversion/policy.mjs';
+import {querySwft} from '../network/conversion/swft-discovery.mjs';
+import {discoverMultihop,pairAvailability,quoteEvmIntermediate} from '../network/conversion/multihop-discovery.mjs';
+
+const baseUsdc={coinCode:'USDC(BASE)',mainNetwork:'BASE',contact:ASSETS.USDC.id.split('erc20:')[1],coinDecimal:6};
+const nativeNkn={coinCode:'NKN',mainNetwork:'NKN',contact:'',coinDecimal:8};
+const evmNkn={coinCode:'NKN(ERC20)',mainNetwork:'ETH',contact:'0x5cf04716ba20127f1e2297addcf4b5035000c9eb',coinDecimal:18};
+const placeholder='0x0000000000000000000000000000000000000001';
+const response=data=>({ok:true,text:async()=>JSON.stringify(data)});
+function evmQuote(){return {
+ action:{fromChainId:8453,toChainId:1,fromAmount:'10000000',fromAddress:placeholder,toAddress:placeholder,
+  fromToken:{chainId:8453,address:baseUsdc.contact,decimals:6},
+  toToken:{chainId:1,address:evmNkn.contact,decimals:18}},
+ estimate:{fromAmount:'10000000',toAmount:'1500000000000000000000',toAmountMin:'1485000000000000000000',feeCosts:[],gasCosts:[]},
+ transactionRequest:{to:'do-not-expose',data:'do-not-execute'},
+};}
+function fixture({supported=false,catalogue=[baseUsdc,evmNkn],brokenCode,quote=evmQuote()}={}){
+ const calls=[];
+ const fetcher=async(url,options={})=>{
+  calls.push({url,options});
+  if(new URL(url).hostname==='li.quest')return response(quote);
+  if(url.endsWith('queryCoinList'))return response({resCode:'800',data:catalogue});
+  assert.ok(url.endsWith('queryBaseInfo'),'only public read-only calls are allowed');
+  const body=JSON.parse(options.body);
+  if(body.depositCoinCode===brokenCode)throw Error('test timeout');
+  return response({resCode:'800',data:{isSupport:supported,instantRate:'1',depositMin:'1',depositMax:'100000'}});
+ };
+ return {fetcher,calls};
+}
+
+test('tries direct and six exact-network intermediary final hops without orders',async()=>{
+ const f=fixture(),r=await discoverMultihop({fetcher:f.fetcher});
+ assert.equal(r.state,'unavailable');assert.equal(r.executable,false);
+ assert.equal(r.outputAsset,ASSETS.NKN.id);assert.equal(r.paths.length,8);
+ assert.deepEqual(f.calls.slice(1).map(c=>JSON.parse(c.options.body).depositCoinCode),
+  ['USDC(BASE)','USDT(ERC20)','USDT(TRON)','USDC','ETH','BTC','NKN(ERC20)']);
+ assert.ok(r.paths.slice(0,7).every(p=>p.reason==='native_final_hop_unsupported'));
+ assert.equal(f.calls.some(c=>c.url.includes('li.quest')),false);
+ for(const c of f.calls){assert.equal(c.options.method,'POST');assert.equal(c.options.redirect,'error');}
+});
+
+test('intermediate quote can succeed without declaring native conversion available',async()=>{
+ const f=fixture(),r=await discoverMultihop({fetcher:f.fetcher,probeIntermediates:true});
+ const hop=r.paths.at(-1).firstHop;
+ assert.equal(hop.status,'intermediate_quote_only');assert.equal(hop.nativeDelivery,false);
+ assert.equal(hop.outputAsset,'eip155:1/erc20:'+evmNkn.contact);
+ assert.equal(r.executable,false);assert.ok(r.paths.every(p=>p.executable===false));
+ assert.equal(JSON.stringify(r).includes('do-not-execute'),false);
+ assert.ok(f.calls.at(-1).url.includes('li.quest'));
+});
+
+test('supported indications alone never produce a protected executable path',async()=>{
+ const f=fixture({supported:true,catalogue:[baseUsdc,nativeNkn,evmNkn]});
+ const r=await discoverMultihop({fetcher:f.fetcher});
+ assert.equal(r.catalogue.nativeNKN,true);
+ assert.equal(r.paths[0].finalHop.status,'indicative_only');
+ assert.equal(r.paths[0].reason,'protected_end_to_end_quote_unverified');
+ assert.equal(r.executable,false);
+});
+
+test('timeouts remain unknown and do not suppress other intermediary checks',async()=>{
+ const f=fixture({brokenCode:'ETH'}),r=await discoverMultihop({fetcher:f.fetcher});
+ const eth=r.paths.find(p=>p.via[0]==='ETH on Ethereum');
+ assert.equal(eth.finalHop.status,'unknown');assert.equal(eth.reason,'native_final_hop_unknown');
+ assert.equal(r.paths.find(p=>p.via[0]==='BTC on Bitcoin').finalHop.status,'unsupported');
+});
+
+test('rate of one and HTTP/application success cannot override isSupport=false',()=>{
+ assert.equal(pairAvailability({isSupport:false,instantRate:'1'}).status,'unsupported');
+ for(const data of [null,{}, {isSupport:'false'}, {isSupport:1}])assert.throws(()=>pairAvailability(data));
+});
+
+test('asset catalogue matches token contract, network and precision',async()=>{
+ for(const mutation of [{contact:'0x123'}, {mainNetwork:'BSC'}, {coinDecimal:8}]){
+  const f=fixture({catalogue:[baseUsdc,{...evmNkn,...mutation}]});
+  const r=await discoverMultihop({fetcher:f.fetcher});
+  assert.equal(r.paths.find(p=>p.provider==='SWFT'&&p.via[0]==='NKN on Ethereum').intermediateListed,false);
+ }
+});
+
+test('EVM diagnostic rejects changed amounts, recipients, network and precision',async()=>{
+ for(const mutate of [
+  q=>q.action.fromAmount='9999999',q=>q.action.toAddress='0x123',q=>q.action.toChainId=8453,
+  q=>q.action.toToken.chainId=8453,q=>q.action.toToken.decimals=8,q=>q.action.toToken.address='0x123',
+  q=>q.estimate.fromAmount='9999999',
+  q=>q.estimate.toAmountMin='0',q=>q.estimate.toAmountMin='999999999999999999999999',
+ ]){
+  const q=evmQuote();mutate(q);
+  await assert.rejects(quoteEvmIntermediate({amountUsdc6:'10000000',fetcher:fixture({quote:q}).fetcher}));
+ }
+});
+
+test('invalid input amounts fail before network calls',async()=>{
+ for(const amountUsdc6 of ['0','-1','1e6','1.5',10000000]){
+  const f=fixture();await assert.rejects(discoverMultihop({amountUsdc6,fetcher:f.fetcher}));
+  assert.equal(f.calls.length,0);
+ }
+});
+
+test('large exact USDC amounts are formatted without floating point',async()=>{
+ const f=fixture();await discoverMultihop({amountUsdc6:'9007199254740993',fetcher:f.fetcher});
+ assert.equal(JSON.parse(f.calls[1].options.body).depositCoinAmt,'9007199254.740993');
+});
+
+test('read-only client refuses mutation endpoints and application errors',async()=>{
+ let calls=0;
+ await assert.rejects(querySwft('accountExchange',{},async()=>{calls++;}),/read-only/);
+ assert.equal(calls,0);
+ await assert.rejects(querySwft('queryCoinList',{},async()=>response({resCode:'900'})),/discovery failed/);
+ await assert.rejects(querySwft('queryCoinList',{},async()=>({ok:false})),/unavailable/);
+});
