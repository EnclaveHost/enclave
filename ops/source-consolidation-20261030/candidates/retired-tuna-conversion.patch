+const policy={version:1,payoutCurrency:'NKN',allowExternal:true,reserveNkn8:'100000000000',refillBelowNkn8:'100000000',
+ buyUsdc6:'5000000',maxConversionUsdc6:'5100000',dailyConversionUsdc6:'10000000',maxSellNkn8:'100000000000',
