+const limits={maxDepositWei:'2000000000000000',maxEthGasWei:'10000000000000',maxBridgeGasUsdc6:'100000',
+ maxNkn8:'1000000000000',minimumFundingWindowMs:1800000,maxWaitMs:86400000};
+const response=body=>new Response(typeof body==='string'?body:JSON.stringify(body),{status:200,headers:{'content-type':'application/json'}});
+const listing={listingId:'23',nkn8:'50000000000',orderType:'market',seller:ESCROW,ethWei:null,usd6:null,createdAt:100};
+
+test('external money parsing preserves JSON precision and exponent notation',async()=>{
+ const data=await externalJson('https://nblock.net/api/otc/gas-estimate',{fetcher:async()=>response('{"gas_fee_eth":9.015541164e-6,"nkn_amount":500.00000001,"id":23}')});
+ assert.equal(money(data.gas_fee_eth,18),'9015541164000');assert.equal(money(data.nkn_amount,8),'50000000001');
+ assert.equal(money('0.010000000000000000',18),'10000000000000000');
+ for(const value of ['-1','NaN','Infinity','1e999','0.000000001'])assert.throws(()=>money(value,8));
+ assert.throws(()=>money(0.01,18));
+});
+test('external HTTP client rejects redirects, HTTP errors and oversized responses',async()=>{
+ let options;
+ await externalJson('https://nblock.net/api/otc/price',{fetcher:async(u,o)=>{options=o;return response({success:true});}});
+ assert.equal(options.redirect,'error');
+ await assert.rejects(externalJson('https://nblock.net',{fetcher:async()=>new Response('secret',{status:401})}),/HTTP 401/);
+ await assert.rejects(externalJson('https://nblock.net',{fetcher:async()=>response(' '.repeat(2000001))}),/too large/);
+});
+test('nBlock client follows observed endpoints and keeps credentials off public calls',async()=>{
+ const calls=[],now=100000000;
+ const c=new NblockClient({token:'private-token',now:()=>now,fetcher:async(u,o)=>{
+  calls.push({u,o});
+  if(u.includes('listings?page'))return response({success:true,data:[{id:23,nkn_amount:'500',order_type:'market',listing_type:'SELL_NKN',seller_eth_address:ESCROW,erc20_amount:null,usd_target:null,created_at:new Date(100).toISOString()}],pagination:{pages:1}});
+  if(u.endsWith('gas-estimate'))return response({success:true,gas_fee_eth:0.000009});
+  if(u.endsWith('/quote'))return response({success:true,data:{quote_id:'q1',erc20_amount:0.0012,expires_in_seconds:60}});
+  if(u.endsWith('/accept'))return response({success:true});
+  throw Error('unexpected endpoint');
+ }});
