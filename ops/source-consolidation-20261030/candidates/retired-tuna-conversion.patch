@@ -0,0 +1,89 @@
+// Availability preflight, not an execution adapter. Never opens orders or loads
+// wallets. Intermediates do not count as successful native-NKN conversion.
+import {ASSETS,units} from './policy.mjs';
+import {querySwft,classifyAssets} from './swft-discovery.mjs';
+
+const BASE_USDC=ASSETS.USDC.id.split('erc20:')[1];
+const EVM_NKN='0x5cf04716ba20127f1e2297addcf4b5035000c9eb';
+const PLACEHOLDER='0x0000000000000000000000000000000000000001';
+const intermediates=Object.freeze([
+ {name:'USDT on Ethereum',code:'USDT(ERC20)',network:'ETH',contract:'0xdac17f958d2ee523a2206206994597c13d831ec7',decimals:6,probeAmount:'20'},
+ {name:'USDT on Tron',code:'USDT(TRON)',network:'TRX',contract:'TR7NHqjeKQxGTCi8q8ZY4pL8otSzgjLj6t',decimals:6,probeAmount:'20'},
+ {name:'USDC on Ethereum',code:'USDC',network:'ETH',contract:'0xa0b86991c6218b36c1d19d4a2e9eb0ce3606eb48',decimals:6,probeAmount:'20'},
+ {name:'ETH on Ethereum',code:'ETH',network:'ETH',contract:'',decimals:18,probeAmount:'0.01'},
+ {name:'BTC on Bitcoin',code:'BTC',network:'BTC',contract:'',decimals:8,probeAmount:'0.001'},
+ {name:'NKN on Ethereum',code:'NKN(ERC20)',network:'ETH',contract:EVM_NKN,decimals:18,probeAmount:'1000'},
+]);
+function listed(data,asset){
+ return data.some(x=>x.coinCode===asset.code&&x.mainNetwork===asset.network&&
+  Number(x.coinDecimal)===asset.decimals&&
+  (asset.network==='ETH'?(x.contact||'').toLowerCase()===(asset.contract||'').toLowerCase():(x.contact||'')===(asset.contract||'')));
+}
+function decimal(amount,precision){
+ const value=units(amount,{zero:false}).toString().padStart(precision+1,'0');
+ return value.slice(0,-precision)+'.'+value.slice(-precision);
+}
+export function pairAvailability(data){
+ if(!data||typeof data.isSupport!=='boolean')throw Error('invalid SWFT pair availability');
+ return {status:data.isSupport?'indicative_only':'unsupported',supported:data.isSupport,
+  rate:data.instantRate,minimumInput:data.depositMin,maximumInput:data.depositMax,
+  serviceFeeRate:data.depositCoinFeeRate,receiveFee:data.receiveCoinFee,
+  executable:false};
+}
+
+// The placeholder is only for public quote diagnostics. Returned calldata is
+// discarded so it cannot accidentally become a transaction to this address.
+export async function quoteEvmIntermediate({amountUsdc6,fetcher=fetch}){
+ units(amountUsdc6,{zero:false});
+ const query=new URLSearchParams({fromChain:'8453',toChain:'1',fromToken:BASE_USDC,
+  toToken:EVM_NKN,fromAmount:amountUsdc6,fromAddress:PLACEHOLDER,toAddress:PLACEHOLDER,slippage:'0.005'});
+ const response=await fetcher('https://li.quest/v1/quote?'+query,{redirect:'error',signal:AbortSignal.timeout(20000)});
+ if(!response.ok)throw Error('EVM intermediate quote unavailable');
+ const text=await response.text();if(text.length>2000000)throw Error('EVM quote response too large');
+ const q=JSON.parse(text),a=q.action,e=q.estimate;
+ if(a?.fromChainId!==8453||a?.toChainId!==1||a?.fromToken?.chainId!==8453||a?.toToken?.chainId!==1||
+  a.fromToken.address?.toLowerCase()!==BASE_USDC||a.toToken.address?.toLowerCase()!==EVM_NKN||
+  a.fromToken.decimals!==6||a.toToken.decimals!==18||a.fromAmount!==amountUsdc6||
+  a.fromAddress?.toLowerCase()!==PLACEHOLDER||a.toAddress?.toLowerCase()!==PLACEHOLDER||
+  !e||e.fromAmount!==amountUsdc6||units(e.toAmountMin,{zero:false})>units(e.toAmount,{zero:false}))throw Error('EVM quote asset, amount or recipient mismatch');
+ return {provider:'LI.FI',status:'intermediate_quote_only',inputAsset:ASSETS.USDC.id,
+  outputAsset:'eip155:1/erc20:'+EVM_NKN,amountIn:amountUsdc6,expectedOut:e.toAmount,
+  minimumOut:e.toAmountMin,decimals:18,tool:q.tool,feeCosts:e.feeCosts,gasCosts:e.gasCosts,
+  executable:false,nativeDelivery:false};
+}
+
+export async function discoverMultihop({amountUsdc6='10000000',probeIntermediates=false,fetcher=fetch,now=Date.now}={}){
+ units(amountUsdc6,{zero:false});
+ const startedAt=now(),catalogue=await querySwft('queryCoinList',{},fetcher);
+ const assets=classifyAssets(catalogue),paths=[];
+ async function probe(code,amount){
+  try{return {...pairAvailability(await querySwft('queryBaseInfo',{
+   depositCoinCode:code,receiveCoinCode:'NKN',depositCoinAmt:amount,walletAddress:''},fetcher)),
+   inputCode:code,outputCode:'NKN',supportProbeAmount:amount};}
+  catch(e){return {status:'unknown',executable:false,inputCode:code,outputCode:'NKN',error:e.message};}
+ }
+ const direct=await probe('USDC(BASE)',decimal(amountUsdc6,6));
+ paths.push({via:[],provider:'SWFT',finalHop:direct,executable:false,
+  reason:direct.status==='unsupported'?'native_final_hop_unsupported':direct.status==='unknown'?
+   'native_final_hop_unknown':'protected_end_to_end_quote_unverified'});
+ // Probe the final hop first. Do not buy an intermediate merely because its
+ // first-leg quote exists. Fixed probe amounts test support, not chained prices.
+ for(const asset of intermediates){
+  const finalHop=await probe(asset.code,asset.probeAmount);
+  paths.push({via:[asset.name],provider:'SWFT',intermediateListed:listed(catalogue,asset),
+   finalHop,executable:false,reason:finalHop.status==='unsupported'?
+    'native_final_hop_unsupported':finalHop.status==='unknown'?'native_final_hop_unknown':'protected_end_to_end_quote_unverified'});
+ }
+ const official={via:['NKN on Ethereum'],provider:'LI.FI + official NKN swap',
+  finalHop:{status:'adapter_not_configured',executable:false},executable:false,
+  reason:'supported_unattended_native_bridge_required'};
+ if(probeIntermediates){
+  try{official.firstHop=await quoteEvmIntermediate({amountUsdc6,fetcher});}
+  catch(e){official.firstHop={status:'unknown',executable:false,error:e.message};}
+ }
+ paths.push(official);
+ return {version:1,startedAt,observedAt:now(),inputAsset:ASSETS.USDC.id,
+  outputAsset:ASSETS.NKN.id,amountIn:amountUsdc6,catalogue:assets,paths,
+  executable:false,state:'unavailable',reason:'no_verified_end_to_end_native_route',
+  note:'Read-only preflight. Pair support and intermediate quotes are not execution guarantees. No orders or transfers created.'};
+}
diff --git a/network/conversion/nblock-relay.mjs b/network/conversion/nblock-relay.mjs
new file mode 100644
index 000000000..f1cc56fba
--- /dev/null
+++ b/network/conversion/nblock-relay.mjs
@@ -0,0 +1,177 @@
+import path from 'node:path';
+import {randomUUID} from 'node:crypto';
+import {DurableState} from '../durable-state.mjs';
+import {ASSETS,units,validatePolicy,conversionIntent} from './policy.mjs';
+import {ETH_ASSET} from './relay-deposit.mjs';
+import {id} from './external-http.mjs';
+
+const queues=new Map();
+const terminal=new Set(['EXPIRED','CANCELLED','REFUNDED','DISPUTED']);
+export function validateNblockLimits(limits) {
+ for(const k of ['maxDepositWei','maxEthGasWei','maxBridgeGasUsdc6','maxNkn8'])units(limits?.[k],{zero:false});
+ for(const k of ['minimumFundingWindowMs','maxWaitMs'])if(!Number.isSafeInteger(limits[k]))throw Error('invalid nBlock time limits');
+ if(limits.minimumFundingWindowMs<1800000||limits.minimumFundingWindowMs>86400000||limits.maxWaitMs<3600000||limits.maxWaitMs>172800000)throw Error('unsafe nBlock time limits');
+ return Object.freeze({...limits});
+}
+
+// This is intentionally separate from the atomic/direct conversion engine:
+// intermediate ETH can remain in the wallet, and refunds can be partial.
+export class NblockRelayConversion {
+ constructor({directory,policy,limits,addresses,nblock,bridge,wallet,enabled=false,now=Date.now}) {
+  this.policy=validatePolicy(policy);this.limits=validateNblockLimits(limits);
+  if(!this.policy.allowExternal)throw Error('nBlock requires explicit external custody consent');
+  if(typeof enabled!=='boolean')throw Error('explicit nBlock enabled flag required');
+  Object.assign(this,{addresses:{...addresses},nblock,bridge,wallet,enabled,now});
+  this.store=new DurableState(directory);this.key=path.resolve(directory);
+ }
+ tick() {
+  const run=(queues.get(this.key)||Promise.resolve()).then(()=>this.run());
+  const tail=run.catch(()=>{});queues.set(this.key,tail);
+  void tail.then(()=>{if(queues.get(this.key)===tail)queues.delete(this.key);});return run;
+ }
+ save(s) {return this.store.set('nblock-conversion',s);}
+ async review(s,reason) {s.job.phase='needs_review';s.job.reason=reason;await this.save(s);return {state:'needs_review',reason};}
+ async finish(s,state,details={}) {
+  s.last={id:s.job.id,state,...details};s.job=null;await this.save(s);return {state,...details};
+ }
+ canSpend(job) {return this.enabled&&this.now()<this.policy.expiresAt&&(!job||
+  (JSON.stringify(job.policy)===JSON.stringify(this.policy)&&JSON.stringify(job.limits)===JSON.stringify(this.limits)));}
+ async run() {
+  const s=await this.store.get('nblock-conversion')||{version:1,days:{},usedTransfers:{},usedListings:{},job:null};
+  if(s.version!==1||!s.days||!s.usedTransfers||!s.usedListings)throw Error('damaged nBlock journal');
+  if(s.job)return this.resume(s);
+  if(!this.canSpend())return {state:'disabled'};
+  const actual=await this.wallet.addresses();
+  if(JSON.stringify(actual)!==JSON.stringify(this.addresses))throw Error('nBlock funding wallet identity changed');
+  const balances=await this.wallet.balances();
+  const intent=conversionIntent(this.policy,balances,this.now());
+  if(!intent)return {state:'ready'};
+  if(intent.direction!=='USDC_TO_NKN')return {state:'unavailable',reason:'nblock_buy_only'};
+  const cost=units(intent.amount)+units(this.limits.maxBridgeGasUsdc6);
+  const day=String(Math.floor(this.now()/86400000));
+  if(cost>units(this.policy.maxConversionUsdc6)||cost+units(s.days[day]||'0')>units(this.policy.dailyConversionUsdc6))return {state:'limited'};
+  const listings=(await this.nblock.listings()).filter(x=>!s.usedListings[x.listingId]&&
+   units(x.nkn8)<=units(this.limits.maxNkn8)&&units(x.nkn8)*1000000n>=cost*units(this.policy.minNknPerUsdc8));
+  listings.sort((a,b)=>units(a.nkn8)<units(b.nkn8)?-1:units(a.nkn8)>units(b.nkn8)?1:0);
+  if(!listings.length)return {state:'unavailable',reason:'no_bounded_nblock_listing'};
+  const quote=await this.nblock.quote(listings[0]);
+  const quotedCap=units(quote.depositWei)*(10000n+BigInt(this.policy.maxSlippageBps))/10000n;
+  const maxDepositWei=quotedCap<units(this.limits.maxDepositWei)?quotedCap:units(this.limits.maxDepositWei);
+  if(units(quote.depositWei)>maxDepositWei)return {state:'limited',reason:'nblock_price_cap'};
+  const beforeIds=(await this.nblock.trades()).map(t=>id(t.id));
+  s.days[day]=(units(s.days[day]||'0')+cost).toString();s.usedListings[quote.listingId]=true;
+  s.job={id:randomUUID(),phase:'opening',quote,beforeIds,maxDepositWei:maxDepositWei.toString(),
+   amountUsdc6:intent.amount,allInUsdc6:cost.toString(),addresses:this.addresses,createdAt:this.now(),policy:this.policy,limits:this.limits};
+  // Reserve money and record reconciliation identifiers before accepting.
+  await this.save(s);
+  await this.nblock.accept(quote,this.addresses);
+  return this.resume(s);
+ }
+ async proof(s,asset,recipient,hash,minimum) {
+  const j=s.job,p=await this.wallet.verifyTransfer({asset,recipient,hash,notBefore:j.createdAt});
+  if(!p)return null;
+  if(p.finalized!==true||p.asset!==asset||p.recipient!==recipient||p.hash!==hash||!p.transferId||
+   !Number.isSafeInteger(p.timestamp)||p.timestamp<j.createdAt||p.timestamp>this.now()+5000)throw Error('unverified conversion receipt');
+  const key=asset+':'+p.transferId;
+  if(s.usedTransfers[key]&&s.usedTransfers[key]!==j.id)throw Error('conversion receipt reused');
+  if(units(p.amount,{zero:false})<units(minimum))throw Error('conversion receipt below required amount');
+  s.usedTransfers[key]=j.id;return p;
+ }
+ async readyTrade(s) {
+  const j=s.job,trade=await this.nblock.status(j);
+  if(trade.state!=='AWAITING_BUYER_DEPOSIT')return null;
+  if(trade.deadline<this.now()+this.limits.minimumFundingWindowMs)return null;
+  if(units(trade.depositWei)>units(j.maxDepositWei)||units(trade.depositWei)>units(this.limits.maxDepositWei))throw Error('nBlock deposit cap exceeded');
+  return trade;
+ }
+ async funding(s,field,nextPhase,expiresAt) {
+  const j=s.job,signed=j[field],status=await this.wallet.fundingStatus(signed);
+  if(status==='reverted')return this.review(s,field+'_reverted');
+  if(status==='confirmed'){j.phase=nextPhase;await this.save(s);return null;}
+  if(status!=='unknown')throw Error('unknown wallet funding state');
+  if(!this.canSpend(j)||this.now()>=expiresAt)return {state:'pending',reason:field+'_reconciliation'};
+  if(!await this.readyTrade(s))return {state:'pending',reason:'seller_or_deadline_reconciliation'};
+  await this.wallet.broadcast(signed);return {state:'pending',reason:field+'_confirmation'};
+ }
+ async resume(s) {
+  const j=s.job;
+  if(JSON.stringify(j.addresses)!==JSON.stringify(this.addresses))throw Error('pending nBlock wallet identity changed');
+  if(j.phase==='needs_review')return {state:'needs_review',reason:j.reason};
+  if(j.phase==='opening') {
+   const trade=await this.nblock.lookup(j);
+   if(!trade)return this.now()>j.createdAt+this.limits.maxWaitMs?this.review(s,'order_acceptance_unknown'):{state:'pending',reason:'order_reconciliation'};
+   j.trade=trade;j.phase='seller_wait';await this.save(s);
+  }
+  if(j.phase==='seller_wait') {
+   const trade=await this.nblock.status(j);
+   if(terminal.has(trade.state))return this.finish(s,'cancelled',{reason:'seller_unavailable'});
+   if(trade.state!=='AWAITING_BUYER_DEPOSIT')return this.now()>j.createdAt+this.limits.maxWaitMs?this.review(s,'seller_timeout'):{state:'pending',reason:'seller_deposit'};
+   if(!this.canSpend(j))return {state:'disabled',reason:'spending_disabled_or_policy_changed'};
+   j.trade=trade;
+   if(!await this.readyTrade(s))return this.review(s,'insufficient_funding_window');
+   j.phase='bridge_quote';await this.save(s);
+  }
+  if(j.phase==='bridge_quote') {
+   if(!this.canSpend(j))return {state:'disabled'};
+   if(!await this.readyTrade(s))return this.review(s,'seller_not_ready');
+   const quote=await this.bridge.quote({amountUsdc6:j.amountUsdc6,addresses:this.addresses});
+   if(units(quote.minimumEthWei)<units(j.trade.depositWei)+units(this.limits.maxEthGasWei))return this.review(s,'bridge_output_insufficient');
+   j.bridge=quote;j.phase='bridge_prepare';await this.save(s);
+  }
+  if(j.phase==='bridge_prepare') {
+   if(!this.canSpend(j))return {state:'disabled'};
+   if(this.now()>=j.bridge.expiresAt)return this.review(s,'bridge_quote_expired');
+   if(!await this.readyTrade(s))return this.review(s,'seller_not_ready');
+   j.baseFunding=await this.wallet.prepareTransfer({key:j.id+'_base',transfer:{asset:ASSETS.USDC.id,
+    from:this.addresses.USDC,to:j.bridge.depositAddress,amount:j.amountUsdc6},allInUsdc6:j.allInUsdc6,
+    minimumOut:j.quote.nkn8,minUsdcPerNkn6:this.policy.minUsdcPerNkn6});
+   j.phase='bridge_prepared';await this.save(s);
+  }
+  if(j.phase==='bridge_prepared') {
+   // A deposit already broadcast is reconciled even after the seller expires.
+   const result=await this.funding(s,'baseFunding','bridge_wait',j.bridge.expiresAt);
+   if(result)return result;
+  }
+  if(j.phase==='bridge_wait') {
+   const status=await this.bridge.status(j.bridge,j.baseFunding.hash);
+   if(status.state==='needs_review')return this.review(s,status.reason);
+   if(status.state==='refunded') {
+    const p=await this.proof(s,ASSETS.USDC.id,this.addresses.USDC,status.hash,'1');
+    if(!p)return {state:'pending',reason:'bridge_refund_finality'};
+    return this.finish(s,'refunded',{asset:ASSETS.USDC.id,amount:p.amount,hash:status.hash});
+   }
+   if(status.state!=='received')return this.now()>j.createdAt+this.limits.maxWaitMs?this.review(s,'bridge_timeout'):{state:'pending',reason:'bridge_delivery'};
+   const required=units(j.trade.depositWei)+units(this.limits.maxEthGasWei);
+   const minimum=required>units(j.bridge.minimumEthWei)?required.toString():j.bridge.minimumEthWei;
+   let p;
+   try {p=await this.proof(s,ETH_ASSET,this.addresses.ETH,status.hash,minimum);}
+   catch(e){return this.review(s,e.message);}
+   if(!p)return {state:'pending',reason:'intermediate_eth_finality'};
+   j.ethReceipt=p;j.phase='eth_prepare';await this.save(s);
+  }
+  if(j.phase==='eth_prepare') {
+   if(!this.canSpend(j))return {state:'disabled',reason:'intermediate_eth_retained'};
+   if(!await this.readyTrade(s))return this.review(s,'intermediate_eth_retained_seller_unavailable');
+   j.ethFunding=await this.wallet.prepareTransfer({key:j.id+'_eth',transfer:{asset:ETH_ASSET,
+    from:this.addresses.ETH,to:j.trade.depositAddress,amount:j.trade.depositWei},maxGasWei:this.limits.maxEthGasWei});
+   j.phase='eth_prepared';await this.save(s);
+  }
+  if(j.phase==='eth_prepared') {
+   const result=await this.funding(s,'ethFunding','native_wait',j.trade.deadline-this.limits.minimumFundingWindowMs);
+   if(result)return result;
+  }
+  if(j.phase==='native_wait') {
+   const trade=await this.nblock.status(j);
+   if(terminal.has(trade.state))return this.review(s,'nblock_funded_'+trade.state.toLowerCase());
+   if(trade.state!=='COMPLETED'||!trade.nativeHash)return this.now()>j.createdAt+this.limits.maxWaitMs?this.review(s,'native_delivery_timeout'):{state:'pending',reason:'native_delivery'};
+   let proof;
+   try {proof=await this.proof(s,ASSETS.NKN.id,this.addresses.NKN,trade.nativeHash,j.quote.nkn8);}
+   catch(e){return this.review(s,e.message);}
+   if(!proof)return {state:'pending',reason:'native_finality'};
+   return this.finish(s,'completed',{asset:ASSETS.NKN.id,amount:proof.amount,hash:proof.hash,
+    intermediateEthRemainingWei:(units(j.ethReceipt.amount)-units(j.trade.depositWei)).toString(),
+    note:'ETH remainder is before actual Ethereum gas; retained in the provider wallet.'});
+  }
+  throw Error('invalid nBlock workflow phase');
+ }
+}
diff --git a/network/conversion/nblock-runtime.mjs b/network/conversion/nblock-runtime.mjs
new file mode 100644
index 000000000..b27560716
--- /dev/null
+++ b/network/conversion/nblock-runtime.mjs
@@ -0,0 +1,42 @@
+import fs from 'node:fs/promises';
+import path from 'node:path';
+import {DurableState} from '../durable-state.mjs';
+import {NblockClient} from './nblock.mjs';
+import {RelayDepositClient} from './relay-deposit.mjs';
+import {NblockRelayConversion} from './nblock-relay.mjs';
+import {privateJson} from './external-http.mjs';
+
+export async function startNblockConversion({config,directory,log=()=>{},loadAdapter}) {
+ const state=new DurableState(directory);
+ const pendingJournal=await new DurableState(path.join(directory,'journal')).get('nblock-conversion');
+ if(config.enabled!==true&&!pendingJournal?.job) {
+  await state.set('status',{updatedAt:Date.now(),state:'disabled',reason:'nblock_explicit_opt_in_required'});
+  return {async close(){}};
+ }
+ if(config.reviewedNblockApi!==true)throw Error('nBlock authenticated API review must be acknowledged');
+ await fs.mkdir(directory,{recursive:true,mode:0o700});
+ const lock=path.join(directory,'nblock-runner.lock');
+ await fs.mkdir(lock,{mode:0o700});
+ let wallet;
+ try {
+  const credentials=await privateJson(config.credentialsFile);
+  const passwordLogin=typeof credentials.username==='string'&&credentials.username&&typeof credentials.password==='string'&&credentials.password;
+  if(!passwordLogin&&(typeof credentials.token!=='string'||!credentials.token||credentials.token.length>16384||/[\r\n]/.test(credentials.token)))throw Error('invalid nBlock credentials');
+  wallet=await loadAdapter(config.wallet,'nblock-wallet');
+  const addresses=await wallet.addresses();
+  for(const key of ['USDC','NKN','ETH'])if(!addresses[key]||addresses[key]!==config.addresses?.[key])throw Error('nBlock wallet configuration mismatch');
+  const worker=new NblockRelayConversion({directory:path.join(directory,'journal'),policy:config.policy,
+   limits:config.limits,addresses,wallet,enabled:config.enabled===true,nblock:new NblockClient({token:credentials.token,credentials}),
+   bridge:new RelayDepositClient({slippageBps:config.policy.maxSlippageBps})});
+  let pending,closed=false;
+  const tick=()=>{
+   if(closed||pending)return pending;
+   pending=worker.tick().then(value=>state.set('status',{updatedAt:Date.now(),...value}))
+    .catch(async()=>{log('nBlock conversion is blocked; inspect its private journal before retrying.');
+     await state.set('status',{updatedAt:Date.now(),state:'unavailable',reason:'nblock_execution_or_reconciliation_failed'});})
+    .finally(()=>{pending=null;});return pending;
+  };
+  const timer=setInterval(()=>void tick(),30000);timer.unref();void tick();
+  return {async close(){closed=true;clearInterval(timer);await pending;try{await wallet.close?.();}finally{await fs.rmdir(lock);}}};
+ } catch(e) {try{await wallet?.close?.();}finally{await fs.rmdir(lock);}throw e;}
+}
diff --git a/network/conversion/nblock-wallet.mjs b/network/conversion/nblock-wallet.mjs
new file mode 100644
index 000000000..4f552fa14
--- /dev/null
+++ b/network/conversion/nblock-wallet.mjs
@@ -0,0 +1,134 @@
+import path from 'node:path';
+import {createPublicClient,createWalletClient,http,parseTransaction,recoverTransactionAddress,keccak256} from 'viem';
+import {mainnet} from 'viem/chains';
+import {create as createProviderWallet} from './provider-wallet.mjs';
+import {DurableState} from '../durable-state.mjs';
+import {exactJSON} from './native-rpc.mjs';
+import {units} from './policy.mjs';
+import {evmAddress} from './external-http.mjs';
+import {ETH_ASSET} from './relay-deposit.mjs';
+
+export class NblockWallet {
+ constructor({provider,clients,wallet,directory,maxGasWei,now=Date.now}) {
+  units(maxGasWei,{zero:false});Object.assign(this,{provider,clients,wallet,maxGasWei,now});
+  this.store=new DurableState(directory);this.tail=Promise.resolve();
+ }
+ async addresses() {const a=await this.provider.addresses();return {...a,ETH:a.USDC};}
+ balances() {return this.provider.balances();}
+ async quorum(fn) {
+  const results=await Promise.all(this.clients.map(c=>fn(c).catch(()=>undefined)));
+  for(const value of results)if(value!==undefined&&results.filter(v=>v!==undefined&&exactJSON(v)===exactJSON(value)).length>=2)return value;
+  throw Error('Ethereum RPC quorum unavailable');
+ }
+ async finalBlock() {
+  if(await this.quorum(c=>c.getChainId())!==1)throw Error('Ethereum mainnet required');
+  const heads=await Promise.all(this.clients.map(c=>c.getBlock({blockTag:'finalized'}).catch(()=>null)));
+  const heights=heads.filter(b=>b?.number!==undefined).map(b=>b.number).sort((a,b)=>a>b?-1:a<b?1:0);
+  if(heights.length<2)throw Error('Ethereum finality unavailable');
+  const b=await this.quorum(c=>c.getBlock({blockNumber:heights[1]}));
+  const now=BigInt(Math.floor(this.now()/1000));
+  if(!b.hash||b.timestamp>now+10n||b.timestamp<now-3600n)throw Error('Ethereum finalized chain stale');
+  return b;
+ }
+ prepareTransfer(request) {
+  if(this.closed)return Promise.reject(Error('nBlock wallet closed'));
+  if(request.transfer.asset!==ETH_ASSET)return this.provider.prepareTransfer(request);
+  const result=this.tail.then(()=>this.prepareEth(request));this.tail=result.catch(()=>{});return result;
+ }
+ async prepareEth({key,transfer,maxGasWei}) {
+  if(!/^[a-zA-Z0-9_-]{1,128}$/.test(key||''))throw Error('ETH transfer key required');
+  const prior=await this.store.get('eth-current');
+  if(prior?.key===key) {
+   if(exactJSON(prior.transfer)!==exactJSON(transfer)||prior.maxGasWei!==maxGasWei)throw Error('ETH transfer key reused');
+   await this.validateEth(prior.signed,transfer,maxGasWei);return prior.signed;
+  }
+  if(prior&&!['confirmed','reverted'].includes(await this.fundingStatus(prior.signed)))throw Error('previous ETH transfer unresolved');
+  const from=(await this.addresses()).ETH,to=evmAddress(transfer.to);
+  if(evmAddress(transfer.from)!==evmAddress(from)||units(transfer.amount,{zero:false})===0n)throw Error('provider-owned ETH transfer required');
+  const block=await this.finalBlock();
+  const balance=await this.quorum(c=>c.getBalance({address:from,blockNumber:block.number}));
+  if(balance<units(transfer.amount)+units(maxGasWei))throw Error('insufficient finalized Ethereum balance');
+  const code=await this.quorum(async c=>(await c.getCode({address:to}))||'0x');
+  if(code!=='0x')throw Error('nBlock ETH escrow must be an EOA');
+  const nonce=await this.quorum(c=>c.getTransactionCount({address:from,blockTag:'pending'}));
+  const request=await this.wallet.prepareTransactionRequest({account:this.provider.account,chain:mainnet,
+   to,value:units(transfer.amount),data:'0x',gas:21000n,nonce});
+  const raw=await this.wallet.signTransaction(request);
+  const signed={asset:ETH_ASSET,raw,hash:keccak256(raw)};
+  await this.validateEth(signed,transfer,maxGasWei);
+  await this.store.set('eth-current',{key,signed,transfer,maxGasWei});return signed;
+ }
+ async validateEth(signed,transfer,maxGasWei) {
+  const tx=parseTransaction(signed.raw),sender=await recoverTransactionAddress({serializedTransaction:signed.raw});
+  const from=(await this.addresses()).ETH;
+  if(signed.asset!==ETH_ASSET||tx.chainId!==1||evmAddress(sender)!==evmAddress(from)||evmAddress(transfer.from)!==evmAddress(from)||
+   evmAddress(tx.to)!==evmAddress(transfer.to)||tx.value!==units(transfer.amount,{zero:false})||(tx.data&&tx.data!=='0x')||
+   tx.gas!==21000n||keccak256(signed.raw)!==signed.hash||tx.authorizationList?.length)throw Error('signed ETH transfer differs from intent');
+  const price=tx.maxFeePerGas??tx.gasPrice;
+  if(typeof price!=='bigint'||price<=0n||price*tx.gas>units(maxGasWei)||units(maxGasWei)>units(this.maxGasWei))throw Error('ETH gas cap exceeded');
+ }
+ async fundingStatus(signed) {
+  if(signed.asset!==ETH_ASSET)return this.provider.fundingStatus(signed);
+  const b=await this.finalBlock();
+  const r=await this.quorum(c=>c.getTransactionReceipt({hash:signed.hash})).catch(()=>null);
+  if(!r||r.blockNumber>b.number)return 'unknown';
+  const block=await this.quorum(c=>c.getBlock({blockNumber:r.blockNumber}));
+  if(block.hash!==r.blockHash)throw Error('Ethereum funding receipt reorganized');
+  return r.status==='success'?'confirmed':'reverted';
+ }
+ async broadcast(signed) {
+  if(this.closed)throw Error('nBlock wallet closed');
+  if(signed.asset!==ETH_ASSET)return this.provider.broadcast(signed);
+  const record=await this.store.get('eth-current');
+  if(!record||exactJSON(record.signed)!==exactJSON(signed))throw Error('only journaled ETH can be broadcast');
+  await this.validateEth(signed,record.transfer,record.maxGasWei);await this.finalBlock();
+  const hash=await this.clients[0].sendRawTransaction({serializedTransaction:signed.raw});
+  if(hash!==signed.hash)throw Error('ETH broadcast hash mismatch');return hash;
+ }
+ async verifyTransfer({asset,recipient,hash,notBefore}) {
+  if(asset!==ETH_ASSET)return this.provider.verifyTransfer({asset,recipient,hash,notBefore});
+  if(evmAddress(recipient)!==evmAddress((await this.addresses()).ETH)||!/^0x[0-9a-f]{64}$/i.test(hash))throw Error('Ethereum receipt destination mismatch');
+  const head=await this.finalBlock();
+  const receipt=await this.quorum(c=>c.getTransactionReceipt({hash}));
+  if(receipt.status!=='success'||receipt.blockNumber>head.number)return null;
+  const block=await this.quorum(c=>c.getBlock({blockNumber:receipt.blockNumber}));
+  const time=Number(block.timestamp)*1000;
+  if(block.hash!==receipt.blockHash||time<notBefore)return null;
+  const tx=await this.quorum(c=>c.getTransaction({hash}));
+  if(tx.blockHash!==block.hash||tx.hash!==hash)throw Error('Ethereum transaction block mismatch');
+  let amount=0n;
+  if(tx.to?.toLowerCase()===recipient.toLowerCase()) {
+   // A direct transfer is sufficient only for an EOA, which cannot forward it.
+   const code=await this.quorum(async c=>(await c.getCode({address:recipient,blockNumber:block.number}))||'0x');
+   if(code!=='0x')throw Error('Ethereum recipient is not an EOA');amount=tx.value;
+  } else {
+   // Relay fills can be internal ETH transfers. Never infer them from a token
+   // ticker or a balance increase; require matching traces from two RPCs.
+   const traces=await this.quorum(c=>c.request({method:'trace_transaction',params:[hash]}));
+   if(!Array.isArray(traces))throw Error('Ethereum transfer traces unavailable');
+   const failed=traces.filter(t=>t.error).map(t=>t.traceAddress);
+   for(const t of traces) {
+    if(!Array.isArray(t.traceAddress)||failed.some(p=>Array.isArray(p)&&p.every((n,i)=>t.traceAddress[i]===n)))continue;
+    if(t.transactionHash!==hash||t.blockHash!==block.hash)throw Error('Ethereum trace anchor mismatch');
+    if(t.type==='call'&&t.action?.callType==='call'&&t.action?.to?.toLowerCase()===recipient.toLowerCase()&&!t.error)
+     amount+=BigInt(t.action.value);
+    if(t.type==='call'&&t.action?.from?.toLowerCase()===recipient.toLowerCase()&&BigInt(t.action.value||'0')>0n)
+     throw Error('Ethereum recipient forwards receipt funds');
+   }
+  }
+  if(amount<=0n)return null;
+  return {asset,recipient,hash,amount:String(amount),transferId:hash.toLowerCase(),timestamp:time,finalized:true};
+ }
+ async close() {this.closed=true;await this.tail;await this.provider.close();}
+}
+export async function create(config) {
+ const rpc=config.ethereumRpc;
+ if(!path.isAbsolute(config.directory||'')||!Array.isArray(rpc)||rpc.length<2||
+  new Set(rpc.map(u=>new URL(u).hostname)).size!==rpc.length||rpc.some(u=>{const x=new URL(u);return x.protocol!=='https:'||x.username||x.password;}))throw Error('independent Ethereum HTTPS RPCs and wallet directory required');
+ const provider=await createProviderWallet(config.providerWallet);
+ try {
+  const clients=rpc.map(url=>createPublicClient({chain:mainnet,transport:http(url,{timeout:15000,retryCount:0})}));
+  const wallet=createWalletClient({account:provider.account,chain:mainnet,transport:http(rpc[0],{timeout:15000,retryCount:0})});
+  return new NblockWallet({provider,clients,wallet,directory:config.directory,maxGasWei:config.maxGasWei});
+ } catch(e) {await provider.close();throw e;}
+}
diff --git a/network/conversion/nblock.mjs b/network/conversion/nblock.mjs
new file mode 100644
index 000000000..b9d7267b3
--- /dev/null
+++ b/network/conversion/nblock.mjs
@@ -0,0 +1,105 @@
+import {units} from './policy.mjs';
+import {externalJson,evmAddress,id,money,timestamp} from './external-http.mjs';
+
+const ORIGIN='https://nblock.net';
+const STATES=new Set(['MATCHED','AWAITING_SELLER_DEPOSIT','SELLER_DEPOSITED','AWAITING_BUYER_DEPOSIT','BUYER_DEPOSITED','COMPLETING','COMPLETED','EXPIRED','CANCELLED','DISPUTED','REFUNDED']);
+export class NblockClient {
+ constructor({token,credentials,fetcher=fetch,now=Date.now}={}) {Object.assign(this,{token,credentials,fetcher,now});}
+ async authenticate() {
+  let expiresAt=Infinity;
+  if(this.token)try{expiresAt=JSON.parse(Buffer.from(this.token.split('.')[1],'base64url').toString()).exp*1000;}catch{}
+  if(this.token&&(!Number.isFinite(expiresAt)||expiresAt>this.now()+30000))return;
+  if(!this.credentials?.username||!this.credentials?.password)throw Error('nBlock credentials missing or expired');
+  const data=await externalJson(ORIGIN+'/api/login',{fetcher:this.fetcher,body:{username:this.credentials.username,password:this.credentials.password}});
+  if(typeof data?.token!=='string'||!data.token||/[\r\n]/.test(data.token))throw Error('nBlock login failed');
+  this.token=data.token;
+ }
+ async request(path,{body,authenticated=false}={}) {
+  if(authenticated)await this.authenticate();
+  if(authenticated&&(!this.token||/[\r\n]/.test(this.token)))throw Error('nBlock authentication required');
+  let data;
+  try{data=await externalJson(ORIGIN+'/api/otc/'+path,{fetcher:this.fetcher,body,token:authenticated?this.token:undefined});}
+  catch(e){if(authenticated&&e.message==='external HTTP 401')this.token=null;throw e;}
+  if(data?.success!==true)throw Error('nBlock request rejected');
+  return data;
+ }
+ async listings() {
+  const result=await this.request('listings?page=1&sort=created_at');
+  if(!Array.isArray(result.data)||result.pagination?.pages>1)throw Error('nBlock listings incomplete');
+  return result.data.filter(x=>x.listing_type==='SELL_NKN').map(x=>{
+   const nkn8=money(x.nkn_amount,8);units(nkn8,{zero:false});
+   if(!['market','limit','usd_target'].includes(x.order_type))throw Error('unsupported nBlock listing type');
+   return {listingId:id(x.id),nkn8,orderType:x.order_type,seller:evmAddress(x.seller_eth_address),
+    ethWei:x.erc20_amount===null?null:money(x.erc20_amount,18),
+    usd6:x.usd_target===null?null:money(x.usd_target,6),createdAt:timestamp(x.created_at)};
+  });
+ }
+ async quote(listing) {
+  const current=(await this.listings()).find(x=>x.listingId===listing.listingId);
+  if(!current||JSON.stringify(current)!==JSON.stringify(listing))throw Error('nBlock listing changed');
+  const gas=await this.request('gas-estimate');
+  const gasWei=money(gas.gas_fee_eth,18);let ethWei=listing.ethWei,quoteId=null,expiresAt=this.now()+30000;
+  if(listing.orderType==='market') {
+   const result=await this.request('listings/'+listing.listingId+'/quote',{body:{},authenticated:true});
+   const q=result.data;
+   quoteId=id(q?.quote_id);ethWei=money(q?.erc20_amount,18);
+   if(!Number.isInteger(q.expires_in_seconds)||q.expires_in_seconds<1||q.expires_in_seconds>60)throw Error('invalid nBlock quote expiry');
+   expiresAt=this.now()+q.expires_in_seconds*1000;
+  } else if(listing.orderType==='usd_target') {
+   const price=await this.request('price');const ethUsd6=units(money(price.data?.eth_usd,6),{zero:false});
+   ethWei=((units(listing.usd6)*10n**18n+ethUsd6-1n)/ethUsd6).toString();
+  }
+  units(ethWei,{zero:false});
+  return {...listing,ethWei,gasWei,quoteId,expiresAt,depositWei:(units(ethWei)+units(gasWei)).toString()};
+ }
+ async trades() {
+  const result=await this.request('trades',{authenticated:true});
+  if(!Array.isArray(result.data)||result.pagination?.pages>1)throw Error('nBlock trades incomplete');
+  return result.data;
+ }
+ async accept(quote,addresses) {
+  if(this.now()>=quote.expiresAt-5000)throw Error('nBlock quote expired');
+  // No retry: callers journal a snapshot of trade IDs before this side effect.
+  await this.request('listings/'+id(quote.listingId)+'/accept',{authenticated:true,body:{
+   buyer_nkn_address:addresses.NKN,buyer_eth_address:evmAddress(addresses.ETH),
+   ...(quote.quoteId?{quote_id:quote.quoteId}:{})}});
+ }
+ normalizeTrade(t,{quote,addresses,createdAt,maxDepositWei}) {
+  if(id(t.listing_id)!==quote.listingId||t.listing_type!=='SELL_NKN'||t.buyer_nkn_address!==addresses.NKN||
+   (t.seller_eth_address&&evmAddress(t.seller_eth_address)!==quote.seller)||
+   evmAddress(t.buyer_eth_address)!==evmAddress(addresses.ETH)||money(t.nkn_amount,8)!==quote.nkn8||
+   timestamp(t.created_at)<createdAt-5000||!STATES.has(t.status))throw Error('nBlock trade does not match reserved intent');
+  const ethWei=money(t.erc20_amount,18);
+  if(units(ethWei,{zero:false})>units(maxDepositWei))throw Error('nBlock trade exceeds price cap');
+  const depositWei=t.buyer_deposit_required==null?null:money(t.buyer_deposit_required,18);
+  if(depositWei!==null&&(units(depositWei)<units(ethWei)||units(depositWei)>units(maxDepositWei)))throw Error('nBlock deposit exceeds reserved cap');
+  const ready=t.status==='AWAITING_BUYER_DEPOSIT';
+  const depositAddress=t.eth_escrow_address?evmAddress(t.eth_escrow_address):null;
+  const deadline=t.buyer_deposit_deadline?timestamp(t.buyer_deposit_deadline):null;
+  if(ready&&(!depositWei||!depositAddress||!deadline))throw Error('nBlock funding instructions incomplete');
+  const hash=t.mainnet_release_tx;
+  if(hash!=null&&!/^[0-9a-f]{64}$/.test(hash))throw Error('invalid nBlock native receipt hash');
+  return {id:id(t.id),listingId:quote.listingId,state:t.status,nkn8:quote.nkn8,ethWei,depositWei,depositAddress,deadline,
+   nativeHash:hash||null,createdAt:timestamp(t.created_at)};
+ }
+ async lookup(intent) {
+  const trades=await this.trades();
+  const candidates=trades.filter(t=>!intent.beforeIds.includes(id(t.id))&&String(t.listing_id)===intent.quote.listingId);
+  if(candidates.length>1)throw Error('ambiguous nBlock order reconciliation');
+  return candidates.length?this.normalizeTrade(candidates[0],intent):null;
+ }
+ async status(intent) {
+  const trade=(await this.trades()).find(t=>id(t.id)===intent.trade.id);
+  if(!trade)throw Error('nBlock trade missing');
+  const result=this.normalizeTrade(trade,intent);
+  if(result.ethWei!==intent.trade.ethWei||(intent.trade.depositAddress&&result.depositAddress!==intent.trade.depositAddress)||
+   (intent.trade.depositWei&&result.depositWei!==intent.trade.depositWei))throw Error('nBlock accepted trade changed');
+  if(result.state==='COMPLETED'&&!result.nativeHash) {
+   const settled=await this.request('public/settlements');
+   if(!Array.isArray(settled.data))throw Error('invalid nBlock settlement list');
+   const matches=settled.data.filter(x=>String(x.id)===result.id&&money(x.nkn_amount,8)===result.nkn8);
+   if(matches.length===1&&/^[0-9a-f]{64}$/.test(matches[0].mainnet_release_tx))result.nativeHash=matches[0].mainnet_release_tx;
+  }
+  return result;
+ }
+}
