+const account=privateKeyToAccount('0x'+'13'.repeat(32));
+const TO='0x'+'34'.repeat(20),HASH='0x'+'ab'.repeat(32),BLOCK='0x'+'cd'.repeat(32);
+async function fixture(t) {
+ const directory=await fs.mkdtemp(path.join(os.tmpdir(),'nblock-wallet-'));t.after(()=>fs.rm(directory,{recursive:true,force:true}));
+ const f={now:100000000,signed:0,broadcasts:[],code:'0x',receipt:null,trace:[],tx:null,balance:10n**18n};
+ const client={getChainId:async()=>1,getBlock:async()=>({number:100n,hash:BLOCK,timestamp:100000n}),
+  getBalance:async()=>f.balance,getCode:async()=>f.code,getTransactionCount:async()=>0,
+  getTransactionReceipt:async()=>{if(!f.receipt)throw Error('not found');return f.receipt;},
+  getTransaction:async()=>f.tx,request:async()=>f.trace,
+  sendRawTransaction:async({serializedTransaction})=>{f.broadcasts.push(serializedTransaction);return keccak256(serializedTransaction);}};
+ const provider={account,addresses:async()=>({USDC:account.address,NKN:'native'}),balances:async()=>({usdc6:'1',nkn8:'1'}),
+  prepareTransfer:async x=>({delegated:x}),verifyTransfer:async()=>({native:true}),close:async()=>{f.closed=true;}};
+ const signer={prepareTransactionRequest:async({to,value,data,gas,nonce})=>({to,value,data,gas,nonce,chainId:1,gasPrice:2n,type:'legacy'}),
+  signTransaction:async tx=>{f.signed++;return account.signTransaction(tx);}};
+ f.options={provider,clients:[client,{...client}],wallet:signer,directory,maxGasWei:'100000',now:()=>f.now};
+ f.wallet=new NblockWallet(f.options);
