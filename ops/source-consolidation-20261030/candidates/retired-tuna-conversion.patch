+import {encodeFunctionData,parseAbi} from 'viem';
+import {ASSETS,units} from './policy.mjs';
+import {externalJson,evmAddress} from './external-http.mjs';
+export const ETH_ASSET='eip155:1/native';
+const TOKEN=ASSETS.USDC.id.split('erc20:')[1],ZERO='0x'+'0'.repeat(40);
+const abi=parseAbi(['function transfer(address,uint256) returns (bool)']);
+const hash=value=>typeof value==='string'&&/^0x[0-9a-f]{64}$/i.test(value);
+function currency(c,chain,address,decimals) {return c?.chainId===chain&&c?.address?.toLowerCase()===address&&c.decimals===decimals;}
+export class RelayDepositClient {
+ constructor({fetcher=fetch,now=Date.now,slippageBps=50}={}) {
+  if(!Number.isInteger(slippageBps)||slippageBps<0||slippageBps>1000)throw Error('invalid Relay slippage');
+  Object.assign(this,{fetcher,now,slippageBps});
+ }
+ async quote({amountUsdc6,addresses}) {
+  units(amountUsdc6,{zero:false});const from=evmAddress(addresses.USDC),to=evmAddress(addresses.ETH);
+  const q=await externalJson('https://api.relay.link/quote/v2',{fetcher:this.fetcher,body:{
+   user:from,recipient:to,refundTo:from,refundOnOrigin:true,originChainId:8453,destinationChainId:1,
+   originCurrency:TOKEN,destinationCurrency:ZERO,amount:amountUsdc6,tradeType:'EXACT_INPUT',
+   useDepositAddress:true,strict:true,slippageTolerance:String(this.slippageBps)}});
+  const d=q.details,s=q.steps?.[0],item=s?.items?.[0],tx=item?.data;
+  if(q.steps?.length!==1||s.id!=='deposit'||s.kind!=='transaction'||s.items?.length!==1||!hash(q.requestId)||s.requestId!==q.requestId||
+   !currency(d?.currencyIn?.currency,8453,TOKEN,6)||!currency(d?.refundCurrency?.currency,8453,TOKEN,6)||!currency(d?.currencyOut?.currency,1,ZERO,18)||
+   d.currencyIn.amount!==amountUsdc6||evmAddress(d.sender)!==from||evmAddress(d.recipient)!==to||tx?.chainId!==8453||
+   evmAddress(tx.from)!==from||evmAddress(tx.to)!==TOKEN||BigInt(tx.value)!==0n)throw Error('Relay quote assets or route changed');
+  const depositAddress=evmAddress(s.depositAddress),minimumEthWei=d.currencyOut.minimumAmount,expectedEthWei=d.currencyOut.amount;
+  if(units(minimumEthWei,{zero:false})>units(expectedEthWei,{zero:false})||
+   units(minimumEthWei)<units(expectedEthWei)*BigInt(10000-this.slippageBps)/10000n)throw Error('Relay minimum output invalid');
+  const expectedData=encodeFunctionData({abi,functionName:'transfer',args:[depositAddress,units(amountUsdc6)]});
+  if(tx.data?.toLowerCase()!==expectedData.toLowerCase())throw Error('Relay deposit is not the exact USDC transfer');
+  return {id:q.requestId,depositAddress,amountUsdc6,minimumEthWei,expectedEthWei,recipient:to,refundAddress:from,
+   // Strict addresses are single-order. Limit local submission age regardless
+   // of the longer protocol deadline; never renew a funded address.
+   expiresAt:this.now()+30000};
+ }
+ async status(quote,fundingHash) {
+  if(!hash(quote.id)||!hash(fundingHash))throw Error('invalid Relay reconciliation id');
+  const q=await externalJson('https://api.relay.link/intents/status/v3?requestId='+quote.id,{fetcher:this.fetcher});
+  if(!['success','refund','failure'].includes(q.status))return {state:'pending'};
+  if(!Array.isArray(q.inTxHashes)||!q.inTxHashes.some(h=>h.toLowerCase()===fundingHash.toLowerCase())||q.originChainId!==8453)throw Error('Relay status does not match funding');
+  if(q.status==='failure')return {state:'needs_review',reason:'relay_failure'};
+  if(!Array.isArray(q.txHashes)||q.txHashes.length!==1||!hash(q.txHashes[0]))return {state:'needs_review',reason:'relay_receipt_ambiguous'};
+  if(q.status==='success'&&q.destinationChainId!==1)throw Error('Relay destination chain changed');
+  return {state:q.status==='success'?'received':'refunded',hash:q.txHashes[0]};
+ }
+}
