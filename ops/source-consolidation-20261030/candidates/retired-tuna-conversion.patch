diff --git a/network/conversion/external-http.mjs b/network/conversion/external-http.mjs
new file mode 100644
index 000000000..c99887305
--- /dev/null
+++ b/network/conversion/external-http.mjs
@@ -0,0 +1,57 @@
+import fs from 'node:fs/promises';
+import path from 'node:path';
+import {getAddress} from 'viem';
+import {decimalUnits} from './policy.mjs';
+
+export function evmAddress(value) {
+ const address=getAddress(value);
+ if(/^0x0{40}$/i.test(address))throw Error('zero funding address');
+ return address.toLowerCase();
+}
+export function id(value) {
+ const text=String(value??'');
+ if(!/^[a-zA-Z0-9_-]{1,128}$/.test(text))throw Error('invalid external order id');
+ return text;
+}
+export function timestamp(value) {
+ const result=Date.parse(value);
+ if(!Number.isSafeInteger(result))throw Error('invalid external timestamp');
+ return result;
+}
+// Preserve numeric JSON money lexemes, including scientific notation, before
+// JavaScript can round them. Refuse excess precision rather than round a price.
+export function money(value,decimals) {
+ if(typeof value!=='string')throw Error('exact external amount required');
+ const m=/^(0|[1-9]\d*)(?:\.(\d+))?(?:[eE]([+-]?\d{1,3}))?$/.exec(value);
+ if(!m)throw Error('invalid external amount');
+ const exponent=Number(m[3]||0),digits=m[1]+(m[2]||''),point=m[1].length+exponent;
+ if(Math.abs(exponent)>80||digits.length>80)throw Error('external amount too large');
+ let text=point<=0?'0.'+'0'.repeat(-point)+digits:point>=digits.length?digits+'0'.repeat(point-digits.length):digits.slice(0,point)+'.'+digits.slice(point);
+ text=text.replace(/^0+(?=\d)/,'').replace(/(\.\d*?)0+$/,'$1').replace(/\.$/,'');
+ return decimalUnits(text,decimals).toString();
+}
+export async function privateJson(file) {
+ if(!path.isAbsolute(file||''))throw Error('absolute credentials file required');
+ const stat=await fs.stat(file);
+ if(!stat.isFile()||(process.platform!=='win32'&&(stat.mode&0o077)))throw Error('private credentials file permissions required');
+ return JSON.parse(await fs.readFile(file,'utf8'));
+}
+export async function externalJson(url,{fetcher=fetch,token,body}={}) {
+ let response;
+ try {response=await fetcher(url,{method:body===undefined?'GET':'POST',redirect:'error',
+  signal:AbortSignal.timeout(15000),headers:{accept:'application/json',...(body===undefined?{}:{'content-type':'application/json'}),...(token?{authorization:'Bearer '+token}:{})},
+  body:body===undefined?undefined:JSON.stringify(body)});}
+ catch {throw Error('external request outcome unknown');}
+ if(!response.ok)throw Error('external HTTP '+response.status);
+ const reader=response.body.getReader(),chunks=[];let size=0;
+ try {for(;;){const {done,value}=await reader.read();if(done)break;size+=value.byteLength;if(size>2000000)throw Error('external response too large');chunks.push(value);}}
+ finally {await reader.cancel().catch(()=>{});reader.releaseLock();}
+ return JSON.parse(Buffer.concat(chunks).toString('utf8'),(key,value,context)=>{
+  if(typeof value==='number'&&(/amount|gas_fee_eth|usd_target|eth_usd|nkn_usd/.test(key))){
+   if(!context?.source)throw Error('Node 22 or newer required for exact external amounts');
+   return context.source;
+  }
+  if(typeof value==='number'&&(!Number.isFinite(value)||(Number.isInteger(value)&&!Number.isSafeInteger(value))))throw Error('unsafe external JSON number');
+  return value;
+ });
+}
diff --git a/network/conversion/multihop-discovery.mjs b/network/conversion/multihop-discovery.mjs
