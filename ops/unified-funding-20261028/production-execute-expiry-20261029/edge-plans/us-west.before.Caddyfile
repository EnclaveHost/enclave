    @uploads path /add-wasm /add-json /add-image /healthz
    handle @uploads {
        reverse_proxy https://7ae476a3.app.enclave.host {
            header_up Host {upstream_hostport}
        }
    }
    # --- trustless-gateway block serving for published sites (enclavehost.eth / IPNS) -------------------------------
    # Insert inside the `ipfs.enclave.host { ... }` site block of each front, BEFORE `handle /ipfs/* { ... }`.
    # Blocks: /opt/enclave-site-blocks/ipfs/<cid>, written by extract-site-blocks.mjs from the site CARs already in
    # /opt/enclave-site (hash-verified; content-addressed, so a file can only ever hold its CID's bytes).
    #
    # 1. The dedicated probe path (trustless-gateway spec "dedicated probe paths"; boxo bitswap/network/httpnet
    #    pingCid = "bafkqaaa"): the empty identity CID. Kubo/Rainbow/boxo gateways use an HTTP provider ONLY after this
    #    answers 200. Its block is the empty byte string.
    @trustlessProbe path /ipfs/bafkqaaa
    handle @trustlessProbe {
        header Content-Type application/vnd.ipld.raw
        header Cache-Control "public, max-age=29030400, immutable"
        respond 200
    }
    # 2. Any block of a published site as a raw block: GET/HEAD /ipfs/<cid>?format=raw (what boxo sends), or with
    #    Accept: application/vnd.ipld.raw and no ?format. Only when the block file exists; every other CID falls through
    #    to the existing /ipfs/* route (bootstrap replica, then the storage adapter) exactly as before.
    @siteBlockRaw {
        path_regexp ^/ipfs/baf[ky][a-z2-7]{55}$
        query format=raw
        file {
            root /opt/enclave-site-blocks
            try_files {path}
        }
    }
    @siteBlockAccept {
        path_regexp ^/ipfs/baf[ky][a-z2-7]{55}$
        header Accept *application/vnd.ipld.raw*
        not query format=*
        file {
            root /opt/enclave-site-blocks
            try_files {path}
        }
    }
    handle @siteBlockRaw {
        root * /opt/enclave-site-blocks
        header Content-Type application/vnd.ipld.raw
        header Cache-Control "public, max-age=29030400, immutable"
        file_server
    }
    handle @siteBlockAccept {
        root * /opt/enclave-site-blocks
        header Content-Type application/vnd.ipld.raw
        header Cache-Control "public, max-age=29030400, immutable"
        file_server
    }
    # --- end trustless-gateway block serving ---------------------------------------------------------------------------
    handle /ipfs/* {
        reverse_proxy 127.0.0.1:8189 {
            @missing status 403 404 500 502 503 504
            handle_response @missing {
                reverse_proxy https://7ae476a3.app.enclave.host {
                    header_up Host {upstream_hostport}
                }
            }
        }
    }
    handle {
        respond 404
    }
}

http://enclave.host, http://www.enclave.host, http://ipfs.enclave.host {
    bind 127.0.0.1
    @forwardChallenge {
        path /.well-known/acme-challenge/*
        not header X-Enclave-ACME-Hop 1
        method GET
    }
    handle @forwardChallenge {
        reverse_proxy http://134.209.248.172 {
            header_up Host {http.request.host}
            header_up X-Enclave-ACME-Hop 1
            @missing status 404
            handle_response @missing {
                reverse_proxy http://165.245.191.129 {
                    header_up Host {http.request.host}
                    header_up X-Enclave-ACME-Hop 1
                    @missing status 404
                    handle_response @missing {
                        reverse_proxy http://146.190.246.39 {
                            header_up Host {http.request.host}
                            header_up X-Enclave-ACME-Hop 1
                        }
                    }
                }
            }
        }
    }
    handle /.well-known/acme-challenge/* {
        respond 404
    }
    handle {
        redir https://{host}{uri} permanent
    }
}

https://134.199.235.187 {
    # App-funded lease relay: exact paths, no control-server dependency.
    @leaseRelayInfo {
        path /v1/info
        method GET
    }
    handle @leaseRelayInfo {
        reverse_proxy 127.0.0.1:8549
    }
    @leaseRelaySend {
        path /v1/lease
        method POST
    }
    handle @leaseRelaySend {
        reverse_proxy 127.0.0.1:8549
    }
    @leaseRelayWrongMethod path /v1/info /v1/lease
    handle @leaseRelayWrongMethod {
        respond 405
    }
    bind 127.0.0.1
    tls {
        issuer acme {
            profile shortlived
        }
    }
    header X-Content-Type-Options nosniff
    # BEGIN platform policy mirror
    # Untrusted public transport. Clients verify the administrator signature and chain anchor.
    @platformPolicyRead {
        method GET HEAD
        path_regexp policyMirror ^/platform-policy/(0x[0-9a-f]{64}|latest|ready)\.json$
    }
    handle @platformPolicyRead {
        root * /var/lib/enclave-platform-policy
        uri strip_prefix /platform-policy
        header Access-Control-Allow-Origin "*"
        header Cache-Control "no-cache"
        header X-Content-Type-Options "nosniff"
        file_server
    }
    @platformPolicyPreflight {
        method OPTIONS
        path_regexp policyMirrorPreflight ^/platform-policy/(0x[0-9a-f]{64}|latest|ready)\.json$
        header_regexp Access-Control-Request-Method ^(GET|HEAD)$
    }
    handle @platformPolicyPreflight {
        header Access-Control-Allow-Origin "*"
        header Access-Control-Allow-Methods "GET, HEAD"
        respond 204
    }
    @platformPolicyUnknown {
        path_regexp ^/platform-policy/
    }
    handle @platformPolicyUnknown {
        header Access-Control-Allow-Origin "*"
        respond 404
    }
    # END platform policy mirror
    # BEGIN public signed-record directory (work/directory-https-activation)
    # Credential-free GET and POST of the public signed-record grammar are answered by THIS host's
    # local directory (127.0.0.1:8188, network/directory-server.mjs), never by the control tunnel below.
    # The directory checks every signature/owner/lease itself. Legacy compatibility only (@recovery):
    # /v1/network/{byo,status}/*, other policy-id spellings, other methods, Authorization/Cookie requests.
    # Dialed from 127.0.0.2: public traffic must not use the directory's loopback-reserved DNS budget.
    @publicDirectory {
        method GET POST
        path_regexp ^/v1/network/(providers|qualifications|routes|records|management|policy/0x[0-9a-f]{64})$
        not header Authorization *
        not header Cookie *
    }
    handle @publicDirectory {
        # Set once here (also on Caddy's own 413/502); the directory's copy is dropped below.
        header Access-Control-Allow-Origin "*"
        request_body {
            max_size 65536
        }
        reverse_proxy 127.0.0.1:8188 {
            header_up -Authorization
            header_up -Cookie
            header_down -Access-Control-Allow-Origin
            header_down -Access-Control-Allow-Credentials
            header_down -Set-Cookie
            header_down -X-Content-Type-Options
            transport http {
                local_address 127.0.0.2
                dial_timeout 3s
                response_header_timeout 15s
            }
        }
    }
    @publicDirectoryPreflight {
        method OPTIONS
        path_regexp ^/v1/network/(providers|qualifications|routes|records|management|policy/0x[0-9a-f]{64})$
        header_regexp Access-Control-Request-Method ^(GET|POST)$
        not header Access-Control-Request-Headers *authorization*
        not header Cookie *
    }
    handle @publicDirectoryPreflight {
        header Access-Control-Allow-Origin "*"
        header Access-Control-Allow-Methods "GET, POST"
        header Access-Control-Allow-Headers "content-type"
        header Access-Control-Max-Age "600"
        respond 204
    }
    # Any other /v1/network/* path is not a public record: answered 404 here, never by the control tunnel, so an
    # origin advertised as a directory cannot pass off a legacy answer. Legacy-only API paths stay below.
    @publicDirectoryUnknown {
        path_regexp (?i)^/v1/network/
        not path /v1/network/byo/* /v1/network/status/* /v1/network/policy/*
        not path_regexp ^/v1/network/(providers|qualifications|routes|records|management|policy/0x[0-9a-f]{64})$
    }
    handle @publicDirectoryUnknown {
        header Access-Control-Allow-Origin "*"
        header Content-Type application/json
        respond `{"error":"not a public-record path"}` 404
    }
    # END public signed-record directory
    # BEGIN immutable site CAR recovery
    @siteRecoveryCar0 {
        method GET HEAD
        path /ipfs/bafybeieuxt6vy424gnmtb5eo6mey6x5p5xbu2mpr4xkiwvz25cbeotzaou
        query format=car
    }
    handle @siteRecoveryCar0 {
        root * /opt/enclave-site/bafybeieuxt6vy424gnmtb5eo6mey6x5p5xbu2mpr4xkiwvz25cbeotzaou
        rewrite * /site.car
        header {
            Content-Type application/vnd.ipld.car
            Access-Control-Allow-Origin *
            Cache-Control "public, max-age=31536000, immutable"
            Content-Security-Policy "default-src 'none'; sandbox"
        }
        file_server
    }
    @siteRecoveryCar1 {
        method GET HEAD
        path /ipfs/bafybeig3rai3tyoimbhb32vo6hkkw3o336wluht7owbs7mefhtiridwp6y
        query format=car
    }
    handle @siteRecoveryCar1 {
        root * /opt/enclave-site/bafybeig3rai3tyoimbhb32vo6hkkw3o336wluht7owbs7mefhtiridwp6y
        rewrite * /site.car
        header {
            Content-Type application/vnd.ipld.car
            Access-Control-Allow-Origin *
            Cache-Control "public, max-age=31536000, immutable"
            Content-Security-Policy "default-src 'none'; sandbox"
        }
        file_server
    }
    # END immutable site CAR recovery
    @recovery path /native/* /recovery-health /v1/* /health /enclaves /availability /route /t/* /mcp
    handle @recovery {
        reverse_proxy https://127.0.0.1:30443 {
            transport http {
                tls_server_name api.enclave.host
            }
            header_up Host api.enclave.host
        }
    }
    handle {
        respond 404
    }
}
