{
    admin unix//run/enclave-bootstrap-tls/admin.sock
    default_sni 134.199.235.187
    http_port 28080
    https_port 28443
    servers {
        protocols h1 h2
    }
    auto_https disable_redirects ignore_loaded_certs
}
bootstrap-us-west.enclave.host {
    bind 127.0.0.1
    reverse_proxy 127.0.0.1:8189
}

enclave.host {
    bind 127.0.0.1
    tls {
        issuer acme {
            disable_tlsalpn_challenge
        }
    }
    header {
        Content-Security-Policy "default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'self'; form-action 'self' https://js.stripe.com https://crypto-js.stripe.com; img-src 'self' data: blob: https:; font-src 'self' data: https://fonts.reown.com; style-src 'self' 'unsafe-inline'; script-src 'self' 'wasm-unsafe-eval' 'sha256-GXyZ2lypzpsF7B3nzXTrDPNLm9gU5HX+HeLZ3yQyT/A=' 'sha256-NixHWnlpLxeQjpDSyeZVwLuOb66H7vUPRcqQ5j62g+w=' 'sha256-jsK7R5UyLOvKAJlV4BIByjWHMXRlFFpt5gXT73deC9o=' 'sha256-sHqhQSr+M9m1FuGTTpDJGl03KUDdC6jhjMfBS/LDMBE=' 'sha256-xZDwSsvKL1ByYsnakgpDiC37RCFF67/32Ojic7PXvi4=' 'sha256-xuOj4HwcIEPne9UnHNw8gwl/+usgJf7X5Dar+HyMitg='    ; frame-src 'self' https://*.stripe.com https://*.privy.io https://*.hcaptcha.com https://challenges.cloudflare.com https://*.walletconnect.org https://*.walletconnect.com https://*.coinbase.com; connect-src 'self' https: wss:; worker-src 'self' blob:"
        Cross-Origin-Opener-Policy "same-origin-allow-popups"
        Permissions-Policy "accelerometer=(), camera=(), display-capture=(), geolocation=(), gyroscope=(), magnetometer=(), microphone=(), payment=(self), usb=(), xr-spatial-tracking=()"
        Referrer-Policy "strict-origin-when-cross-origin"
        Strict-Transport-Security "max-age=31536000; includeSubDomains"
        X-Content-Type-Options "nosniff"
    }
    # the SSO authorize page is opened as a POPUP by tenant apps (eyesoff.ai): COOP here severs
    # window.opener, so the app's /sso-return cannot hand the token back to the window that asked
    @ssoPopup path /sso/authorize /sso/authorize.html /sso-authorize /sso-authorize.html
    header @ssoPopup -Cross-Origin-Opener-Policy
    encode zstd gzip
    @siteEntry path /js/boot.js / /index.html /dashboard /dashboard.html /apps /apps.html /sessions /sessions.html
    header @siteEntry Cache-Control "no-cache"
    @install path /install.sh /install.ps1
    handle @install {
        root * /opt/enclave-site/site-166bf9d33/installers
        header Content-Type "text/plain; charset=utf-8"
        file_server
    }
    handle {
        root * /opt/enclave-site/bafybeihlkkgon5gdwozoklu6adjigqiipraghyfthnibfdkleqjltkd664/site
        # BEGIN generated site pretty routes
        @sitePretty0 {
            path /apps
            not file {path} {path}/index.html
        }
        rewrite @sitePretty0 /apps.html
        @sitePretty1 {
            path /develop
            not file {path} {path}/index.html
        }
        rewrite @sitePretty1 /develop.html
        @sitePretty2 {
            path /dashboard
            not file {path} {path}/index.html
        }
        rewrite @sitePretty2 /dashboard.html
        @sitePretty3 {
            path /checkout
            not file {path} {path}/index.html
        }
        rewrite @sitePretty3 /checkout.html
        @sitePretty4 {
            path /link
            not file {path} {path}/index.html
        }
        rewrite @sitePretty4 /link.html
        @sitePretty5 {
            path /authorize
            not file {path} {path}/index.html
        }
        rewrite @sitePretty5 /authorize.html
        @sitePretty6 {
            path /sso/authorize
            not file {path} {path}/index.html
        }
        rewrite @sitePretty6 /sso/authorize.html
        @sitePretty7 {
            path /host
            not file {path} {path}/index.html
        }
        rewrite @sitePretty7 /host.html
        @sitePretty8 {
            path /architecture
            not file {path} {path}/index.html
        }
        redir @sitePretty8 /develop?{http.request.uri.query} 301
        @sitePretty9 {
            path /admin
            not file {path} {path}/index.html
        }
        rewrite @sitePretty9 /admin.html
        @sitePretty10 {
            path /terms
            not file {path} {path}/index.html
        }
        rewrite @sitePretty10 /terms.html
        @sitePretty11 {
            path /privacy
            not file {path} {path}/index.html
        }
        rewrite @sitePretty11 /privacy.html
        @sitePretty12 {
            path /sessions
            not file {path} {path}/index.html
        }
        rewrite @sitePretty12 /sessions.html
        @sitePretty13 {
            path /grant
            not file {path} {path}/index.html
        }
        rewrite @sitePretty13 /grant.html
        @sitePretty14 {
            path /payout
            not file {path} {path}/index.html
        }
        redir @sitePretty14 /host?{http.request.uri.query} 301
        @sitePretty15 {
            path /apps/publish
            not file {path} {path}/index.html
        }
        rewrite @sitePretty15 /apps/publish.html
        @sitePretty16 {
            path /publish
            not file {path} {path}/index.html
        }
        rewrite @sitePretty16 /apps.html
        @sitePretty17 {
            path /apps/deploy
            not file {path} {path}/index.html
        }
        redir @sitePretty17 /apps/?{http.request.uri.query} 301
        @sitePretty18 {
            path /deploy
            not file {path} {path}/index.html
        }
        redir @sitePretty18 /apps/?{http.request.uri.query} 301
        # END generated site pretty routes
        file_server
    }
    handle_errors {
        root * /opt/enclave-site/bafybeihlkkgon5gdwozoklu6adjigqiipraghyfthnibfdkleqjltkd664/site
        rewrite * /404.html
        file_server
    }
}
www.enclave.host {
    bind 127.0.0.1
    tls {
        issuer acme {
            disable_tlsalpn_challenge
        }
    }
    redir https://enclave.host{uri} permanent
}
