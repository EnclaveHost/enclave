+def diagnostic_wait(directory_fd):
+    value=diagnostic_read(directory_fd,'wchan',128).strip()
+    if not value or len(value)>96 or not all(c.isalnum() or c in '._' for c in value):
+        raise ValueError('invalid-wchan')
+    return value
