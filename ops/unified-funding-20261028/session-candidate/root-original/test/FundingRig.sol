pragma solidity ^0.8.24;

import { Test } from "forge-std/Test.sol";
// the successor (generated by prepare.py) and its linked gas library
import { FundingSessionVault, FundingSessionVaultFactory, CreateArgs, ISVToken, ISVBook, ISVRouter, ISVKeyAttestations }
    from "../src/FundingSessionVault.sol";
import { FundingGasLib } from "../src/FundingGasLib.sol";
// the ORIGINAL SessionVault source, unmodified, as the trusted legacy factory and its vaults
import { SessionVault as LegacyVault, SessionVaultFactory as LegacyFactory, ISVToken as LToken, ISVBook as LBook,
    ISVRouter as LRouter, ISVKeyAttestations as LKA } from "enclave-src/SessionVault.sol";
// the real platform contracts
import { EnclaveDeployments } from "enclave-src/EnclaveDeployments.sol";
import { EnclaveAppCatalog } from "enclave-src/EnclaveAppCatalog.sol";
import { EnclaveAddressBook } from "enclave-src/EnclaveAddressBook.sol";
import { PaymentRouter } from "enclave-src/PaymentRouter.sol";
import { EnclaveLeaseGasReserve, IRegistryR, IL1FeeOracle } from "enclave-src/EnclaveLeaseGasReserve.sol";
import { MockUSDC3009, SessionRegistryStub, MockKeyAttestations } from "enclave-src/foundry/test/mocks/SessionMocks.sol";
// the real dex-r1 adapter, its intent type and its mock DEX (WETH9, V3 factory/pools, SwapRouter02 shape)
import { LeaseGasDexAdapter } from "dex-r1/src/LeaseGasDexAdapter.sol";
import { DexGasIntent } from "dex-r1/src/ILeaseGasDexAdapter.sol";
import { MockWETH9, MockV3Factory, MockSwapRouter02 } from "dex-r1/test/mocks/DexMocks.sol";

/// A contract that owns a ledger record and ANSWERS like an old vault of `owner` - but is not one of the pinned
/// legacy factory's clones. gas.fund must refuse it.
contract FakeOldVault {
    address public owner;
    constructor(address o) { owner = o; }
    function held(bytes32) external pure returns (uint8, bytes32, bytes32) { return (1, bytes32(0), bytes32(0)); }
    function make(EnclaveDeployments L, string calldata ref) external returns (bytes32) {
        return L.create(ref, 0, 1000, 8080, "", false, "", address(0), 0, 1000);
    }
}

/// Shared world. Real: ledger, catalog, address book, PaymentRouter, EnclaveLeaseGasReserve, LeaseGasDexAdapter, the
/// ORIGINAL SessionVaultFactory (legacy) and the generated successor. Mock: USDC (EIP-3009), WETH9, the V3 factory /
/// pools / SwapRouter02 (dex-r1 mocks: linear price, V3-style round-up). Every digest is computed HERE from the type
/// strings (a different word split than the vault's), and every session signature is a real P-256 signature
/// (vm.signP256) checked by the NATIVE precompile - this rig never installs a verifier and never skips.
abstract contract FundingRig is Test {
    address constant P256 = 0x0000000000000000000000000000000000000100;
    uint256 constant T0 = 1_800_000_000;
    uint256 constant OWNER_PK = 0x0A11CE;
    uint256 constant OTHER_PK = 0xBADBAD;
    uint256 constant SK = 0x5E55;
    uint256 constant SK2 = 0x5E56;

    uint8 constant CREATE = 0; uint8 constant FUND = 1; uint8 constant REFUND = 7; uint8 constant GAS = 10;
    uint8 constant STAGING = 1; uint8 constant PROD = 2;

    // gas.fund defaults: $20 max input per op, $3000/ETH worst price, 0.01 ETH per op; the price fixture is $2400
    uint256 constant MAX_GAS6 = 20e6;
    uint256 constant MAX_PX6 = 3_000e6;
    uint256 constant MAX_ETH_OP = 0.01 ether;
    uint256 constant PRICE6 = 2_400e6;
    uint24 constant TIER = 500;
    uint256 constant ETH_OUT = 0.004 ether;
    uint256 constant MAX_IN = 11e6;

    bytes32 constant DOMAIN_TYPEHASH =
        keccak256("EIP712Domain(string name,string version,uint256 chainId,address verifyingContract)");
    bytes32 constant GRANT2_TYPEHASH = keccak256(
        "SessionGrant(string label,string preset,bytes32 sessionKey,string[] actions,string[] apps,"
        "string[] environments,uint256 budget,uint256 spendPerPeriod,uint32 periodSeconds,uint32 opsPerPeriod,"
        "uint256 maxFeePerOp,uint256 maxAppFeePerHour,uint256 maxRatePerHour,uint256 maxGasUsdcPerOp,"
        "uint256 maxUsdcPerEth6,uint256 maxEthPerOp,uint64 expiresAt,bytes32 measurement,bytes32 grantNonce,"
        "uint64 signBefore)");
    bytes32 constant GRANT1_TYPEHASH = keccak256(
        "SessionGrant(string label,string preset,bytes32 sessionKey,string[] actions,string[] apps,"
        "string[] environments,uint256 budget,uint256 spendPerPeriod,uint32 periodSeconds,uint32 opsPerPeriod,"
        "uint256 maxFeePerOp,uint256 maxAppFeePerHour,uint256 maxRatePerHour,uint64 expiresAt,bytes32 measurement,"
        "bytes32 grantNonce,uint64 signBefore)");
    bytes32 constant CALL_TYPEHASH = keccak256(
        "SessionCall(bytes32 sessionId,uint256 nonce,uint8 action,bytes32 argsHash,uint256 fee,uint64 deadline)");
    bytes32 constant RECEIVE_TYPEHASH = keccak256(
        "ReceiveWithAuthorization(address from,address to,uint256 value,uint256 validAfter,uint256 validBefore,bytes32 nonce)");

    MockUSDC3009 usdc;
    EnclaveAddressBook book;
    EnclaveDeployments ledger;
    EnclaveAppCatalog catalog;
    PaymentRouter payRouter;
    SessionRegistryStub reg;
    MockKeyAttestations ka;
    EnclaveLeaseGasReserve reserve;
    MockWETH9 weth;
    MockV3Factory v3;
    MockSwapRouter02 swapRouter;
    LeaseGasDexAdapter adapter;
    LegacyFactory legacyFactory;
    FundingSessionVaultFactory factory;

    address owner;
    address treasury = makeAddr("treasury");
    address payout = makeAddr("payout");
    address publisher = makeAddr("publisher");
    address relayer = makeAddr("relayer");
    address relayer2 = makeAddr("relayer2");
    FundingSessionVault vault;       // the owner's successor vault (CREATE2, created lazily by the factory)
    LegacyVault oldVault;            // the owner's vault at the ORIGINAL factory
    uint256 kx; uint256 ky;
    bytes32 keyHash;

    bytes32 storeAppId; string storeRef;   // paid app (100/s fee)
    bytes32 freeAppId;  string freeRef;    // free app
    uint256 private _n;

    function setUp() public virtual {
        vm.warp(T0);
        _requireNativeP256();
        owner = vm.addr(OWNER_PK);
        usdc = new MockUSDC3009();
        book = new EnclaveAddressBook();
        reg = new SessionRegistryStub();
        ka = new MockKeyAttestations();
        ledger = new EnclaveDeployments(address(usdc), payout, address(reg), address(0));
        ledger.setProofRequiredFrom(0);
        catalog = new EnclaveAppCatalog();
        payRouter = new PaymentRouter(address(usdc), treasury);
        book.set("deployments", address(ledger));
        book.set("appCatalog", address(catalog));

        // the old world: the original factory, as the book's current factory entry
        legacyFactory = new LegacyFactory(LToken(address(usdc)), LBook(address(book)), LRouter(address(payRouter)),
            LKA(address(ka)), 1_000e6);
        book.set("sessionVaultFactory", address(legacyFactory));
        oldVault = LegacyVault(legacyFactory.vaultFor(owner));

        // the gas route: real reserve on the real ledger, real adapter on the mock DEX
        reserve = new EnclaveLeaseGasReserve(address(ledger), IRegistryR(makeAddr("registry")), IL1FeeOracle(address(0)),
            EnclaveLeaseGasReserve.Limits({maxGasPriceCeiling: 1 gwei, overheadClaimGas: 0, overheadRenewGas: 0,
                overheadReleaseGas: 0, minClaimInterval: 0, l1Bps: 0}));
        weth = new MockWETH9();
        v3 = new MockV3Factory();
        swapRouter = new MockSwapRouter02(address(v3), address(weth));
        v3.setRouter(address(swapRouter));
        _pool(100); _pool(500); _pool(3000);
        adapter = new LeaseGasDexAdapter(address(usdc), address(weth), address(swapRouter), address(v3),
            address(ledger), address(reserve), 0.05 ether);

        // the successor, opt-in: its own factory, pinned to that adapter and the legacy factory
        factory = new FundingSessionVaultFactory(ISVToken(address(usdc)), ISVBook(address(book)),
            ISVRouter(address(payRouter)), ISVKeyAttestations(address(ka)), 1_000e6, address(adapter),
            address(legacyFactory));
        vault = FundingSessionVault(factory.vaultFor(owner));

        (kx, ky) = vm.publicKeyP256(SK);
        keyHash = keccak256(abi.encode(kx, ky));
        usdc.mint(owner, 10_000e6);
        vm.deal(owner, 0);                       // the owner never holds or spends ETH in this suite

        uint32[4] memory res = [uint32(0), 0, 256, 10];
        vm.startPrank(publisher);
        (storeAppId, ) = catalog.publishVersion("store", "Store", "", "1.0.0", "bafystore", res, "", "", 100);
        (freeAppId, ) = catalog.publishVersion("freeapp", "Free", "", "2.0.0", "bafyfree", res, "", "", 0);
        vm.stopPrank();
        catalog.setApproval(storeAppId, 0, 1);
        catalog.setApproval(freeAppId, 0, 1);
        storeRef = _ref(storeAppId, 0);
        freeRef = _ref(freeAppId, 0);
    }

    /// FAILS (never skips, never etches a verifier) unless the EVM's own P256VERIFY answers at 0x100.
    function _requireNativeP256() internal view {
        bytes32 digest = keccak256("p256 probe");
        (bytes32 r, bytes32 s) = vm.signP256(0xA1CE, digest);
        (uint256 x, uint256 y) = vm.publicKeyP256(0xA1CE);
        (bool ok, bytes memory ret) = P256.staticcall(abi.encodePacked(digest, r, s, x, y));
        require(ok && ret.length == 32 && ret[31] == 0x01, "native P256VERIFY (0x100) unavailable: suite FAILS, no etch");
        (ok, ret) = P256.staticcall(abi.encodePacked(keccak256("other"), r, s, x, y));
        require(ok && (ret.length == 0 || ret[31] == 0x00), "P256VERIFY accepted a wrong digest");
    }

    function _pool(uint24 fee) internal {
        address p = v3.createPool(address(usdc), address(weth), fee);
        swapRouter.setPrice(fee, PRICE6);
        vm.deal(address(this), address(this).balance + 100 ether);
        weth.deposit{value: 100 ether}();
        weth.transfer(p, 100 ether);
        usdc.mint(p, 1_000_000e6);
    }

    // ---- independent EIP-712 --------------------------------------------------------------------------------------

    function _domain(address v, string memory version) internal view returns (bytes32) {
        return keccak256(abi.encode(DOMAIN_TYPEHASH, keccak256("Enclave Sessions"), keccak256(bytes(version)),
            block.chainid, v));
    }

    function _typed(address v, string memory version, bytes32 structHash) internal view returns (bytes32) {
        return keccak256(abi.encodePacked("\x19\x01", _domain(v, version), structHash));
    }

    function _hs(string[] memory a) internal pure returns (bytes32) {
        bytes memory packed;
        for (uint256 i = 0; i < a.length; i++) packed = bytes.concat(packed, keccak256(bytes(a[i])));
        return keccak256(packed);
    }

    /// v2: 20 words, split 10 / 10 (the vault splits 8 / 6 / 7)
    function _grantHash2(FundingSessionVault.Grant memory g) internal pure returns (bytes32) {
        bytes memory a = abi.encode(GRANT2_TYPEHASH, keccak256(bytes(g.label)), keccak256(bytes(g.preset)), g.sessionKey,
            _hs(g.actions), _hs(g.apps), _hs(g.environments), g.budget, g.spendPerPeriod, g.periodSeconds);
        bytes memory b = abi.encode(g.opsPerPeriod, g.maxFeePerOp, g.maxAppFeePerHour, g.maxRatePerHour,
            g.maxGasUsdcPerOp, g.maxUsdcPerEth6, g.maxEthPerOp, g.expiresAt, g.measurement, g.grantNonce);
        return keccak256(bytes.concat(a, b, abi.encode(g.signBefore)));
    }

    function _grantHash1(LegacyVault.Grant memory g) internal pure returns (bytes32) {
        bytes memory a = abi.encode(GRANT1_TYPEHASH, keccak256(bytes(g.label)), keccak256(bytes(g.preset)), g.sessionKey,
            _hs(g.actions), _hs(g.apps), _hs(g.environments), g.budget);
        bytes memory b = abi.encode(g.spendPerPeriod, g.periodSeconds, g.opsPerPeriod, g.maxFeePerOp,
            g.maxAppFeePerHour, g.maxRatePerHour, g.expiresAt, g.measurement, g.grantNonce, g.signBefore);
        return keccak256(bytes.concat(a, b));
    }

    function _ecdsa(uint256 pk, bytes32 digest) internal pure returns (bytes memory) {
        (uint8 v, bytes32 r, bytes32 s) = vm.sign(pk, digest);
        return abi.encodePacked(r, s, v);
    }

    // ---- grants ---------------------------------------------------------------------------------------------------

    function _strs(string memory a) internal pure returns (string[] memory o) { o = new string[](1); o[0] = a; }
    function _strs(string memory a, string memory b) internal pure returns (string[] memory o) {
        o = new string[](2); o[0] = a; o[1] = b;
    }

    function _oldActions() internal pure returns (string[] memory o) {
        o = new string[](9);
        o[0] = "deploy.create"; o[1] = "deploy.fund"; o[2] = "deploy.setAppRef"; o[3] = "deploy.setConfig";
        o[4] = "deploy.setShares"; o[5] = "deploy.setMaxRate"; o[6] = "deploy.setActive"; o[7] = "deploy.refund";
        o[8] = "app.publish";
    }

    function _gasActions() internal pure returns (string[] memory o) {
        string[] memory a = _oldActions();
        o = new string[](10);
        for (uint256 i = 0; i < 9; i++) o[i] = a[i];
        o[9] = "gas.fund";
    }

    /// a v2 grant WITH gas.fund (limits set) - the shape a new owner signs
    function _gasGrant(uint256 budget) internal returns (FundingSessionVault.Grant memory g) {
        g = _plainGrant(budget);
        g.actions = _gasActions();
        g.maxGasUsdcPerOp = MAX_GAS6;
        g.maxUsdcPerEth6 = MAX_PX6;
        g.maxEthPerOp = MAX_ETH_OP;
    }

    /// a v2 grant WITHOUT gas.fund (all three gas limits 0) - the old action set on the successor
    function _plainGrant(uint256 budget) internal returns (FundingSessionVault.Grant memory g) {
        g.label = "test session";
        g.preset = "custom";
        g.sessionKey = keyHash;
        g.actions = _oldActions();
        g.apps = _strs("*", "mine");
        g.environments = _strs("staging", "prod");
        g.budget = budget;
        g.spendPerPeriod = budget;
        g.periodSeconds = 1 days;
        g.maxFeePerOp = 50_000;
        g.maxAppFeePerHour = 1e6;
        g.maxRatePerHour = 10e6;
        g.expiresAt = uint64(vm.getBlockTimestamp() + 7 days);
        g.grantNonce = keccak256(abi.encode("grant", _n++));
        g.signBefore = uint64(vm.getBlockTimestamp() + 10 minutes);
    }

    function _signGrant(FundingSessionVault.Grant memory g) internal view returns (bytes memory) {
        return _ecdsa(OWNER_PK, _typed(address(vault), "2", _grantHash2(g)));
    }

    function _receiveSig(uint256 pk, address to, uint256 value, uint256 a, uint256 b, bytes32 nonce)
        internal view returns (bytes memory)
    {
        bytes32 d = keccak256(abi.encodePacked("\x19\x01", usdc.DOMAIN_SEPARATOR(),
            keccak256(abi.encode(RECEIVE_TYPEHASH, vm.addr(pk), to, value, a, b, nonce))));
        return _ecdsa(pk, d);
    }

    /// The zero-ETH onboarding: the owner signs (grant + EIP-3009 for exactly the budget), a relayer submits.
    function _openWithDeposit(FundingSessionVault.Grant memory g) internal returns (bytes32 sid) {
        bytes32 gd = _typed(address(vault), "2", _grantHash2(g));
        bytes memory auth = _receiveSig(OWNER_PK, address(vault), g.budget, 0, vm.getBlockTimestamp() + 1 hours, gd);
        vm.prank(relayer);
        (, sid) = factory.openWithDepositFor(owner, g, _signGrant(g), 0, vm.getBlockTimestamp() + 1 hours, auth);
    }

    /// Budget-0 sessions (record makers): the free balance is not touched.
    function _open(FundingSessionVault.Grant memory g) internal returns (bytes32 sid) {
        vm.prank(relayer);
        (, sid) = factory.openFor(owner, g, _signGrant(g));
    }

    // ---- session calls --------------------------------------------------------------------------------------------

    function _callDigest(address v, string memory version, bytes32 sid, uint256 nonce, uint8 action, bytes memory args,
        uint256 fee, uint64 deadline) internal view returns (bytes32)
    {
        return _typed(v, version, keccak256(abi.encode(CALL_TYPEHASH, sid, nonce, action, keccak256(args), fee, deadline)));
    }

    struct Call { address v; string version; uint256 sk; bytes32 sid; uint256 nonce; uint8 action; bytes args;
        uint256 fee; uint64 deadline; address sender; }

    function _call(bytes32 sid, uint256 nonce, uint8 action, bytes memory args, uint256 fee)
        internal returns (Call memory c)
    {
        c = Call(address(vault), "2", SK, sid, nonce, action, args, fee, uint64(vm.getBlockTimestamp() + 120), relayer);
    }

    function _sig(Call memory c) internal view returns (uint256 x, uint256 y, bytes32 r, bytes32 s) {
        bytes32 d = _callDigest(c.v, c.version, c.sid, c.nonce, c.action, c.args, c.fee, c.deadline);
        (r, s) = vm.signP256(c.sk, sha256(abi.encodePacked(d)));
        (x, y) = vm.publicKeyP256(c.sk);
    }

    function _send(Call memory c) internal returns (bytes memory) {
        (uint256 x, uint256 y, bytes32 r, bytes32 s) = _sig(c);
        vm.prank(c.sender);
        // the legacy and successor execute() share one ABI
        return FundingSessionVault(c.v).execute(c.sid, c.nonce, c.action, c.args, c.fee, c.deadline, x, y, r, s);
    }

    function _sendExpect(Call memory c, bytes memory err) internal {
        (uint256 x, uint256 y, bytes32 r, bytes32 s) = _sig(c);
        vm.prank(c.sender);
        if (err.length == 0) vm.expectRevert();
        else vm.expectRevert(err);
        FundingSessionVault(c.v).execute(c.sid, c.nonce, c.action, c.args, c.fee, c.deadline, x, y, r, s);
    }

    function _exec(bytes32 sid, uint256 nonce, uint8 action, bytes memory args, uint256 fee) internal returns (bytes memory) {
        return _send(_call(sid, nonce, action, args, fee));
    }

    function _execExpect(bytes32 sid, uint256 nonce, uint8 action, bytes memory args, uint256 fee, bytes memory err)
        internal
    {
        _sendExpect(_call(sid, nonce, action, args, fee), err);
    }

    // ---- gas intents ----------------------------------------------------------------------------------------------

    function _intent(bytes32 id, address holder, uint256 ethOut, uint256 maxIn) internal view returns (DexGasIntent memory) {
        return DexGasIntent({ payer: address(vault), deployment: id, expectedOwner: holder, ethOut: ethOut,
            maxUsdcIn6: maxIn, fee: TIER, deadline: uint64(vm.getBlockTimestamp() + 5 minutes) });
    }

    function _gasArgs(bytes32 id, address holder) internal view returns (bytes memory) {
        return abi.encode(_intent(id, holder, ETH_OUT, MAX_IN));
    }

    function _quote(uint256 ethOut) internal view returns (uint256) { return swapRouter.quoteIn(TIER, ethOut); }

    // ---- records --------------------------------------------------------------------------------------------------

    function _createArgs(string memory ref, uint8 env, uint256 fund6) internal pure returns (bytes memory) {
        return abi.encode(CreateArgs({ appRef: ref, gpuMilli: 0, cpuMilli: 1000, appPort: 8080, ports: "",
            isPublic: false, configCid: "", maxRate6: 1000, env: env, fund6: fund6 }));
    }

    function _ref(bytes32 appId, uint256 idx) internal pure returns (string memory) {
        return string.concat("catalog://", vm.toString(appId), "/", vm.toString(idx));
    }

    /// a record the SUCCESSOR vault holds (adopted at `env`), made by a separate budget-0 session
    function _vaultRecord(uint8 env) internal returns (bytes32 id) {
        bytes32 tsid = _open(_plainGrant(0));
        id = abi.decode(_exec(tsid, 0, CREATE, _createArgs(freeRef, env, 0), 0), (bytes32));
    }

    /// a record the owner's WALLET holds (created directly; no session, no vault)
    function _walletRecord(string memory ref, address feeTo, uint256 feeSec, uint256 maxRate) internal returns (bytes32 id) {
        vm.prank(owner);
        id = ledger.create(ref, 0, 1000, 8080, "", false, "", feeTo, feeSec, maxRate);
    }

    /// a record the owner's OLD vault holds (adopted at `env`), made through the ORIGINAL contract with a v1 grant
    function _legacyRecord(uint8 env) internal returns (bytes32 id) {
        LegacyVault.Grant memory g = _legacyGrant(_oldActions());
        vm.prank(relayer);
        (, bytes32 lsid) = legacyFactory.openFor(owner, g, _ecdsa(OWNER_PK, _typed(address(oldVault), "1", _grantHash1(g))));
        Call memory c = Call(address(oldVault), "1", SK, lsid, 0, CREATE, _createArgs(freeRef, env, 0), 0,
            uint64(vm.getBlockTimestamp() + 120), relayer);
        id = abi.decode(_send(c), (bytes32));
    }

    function _legacyGrant(string[] memory actions) internal returns (LegacyVault.Grant memory g) {
        g.label = "legacy";
        g.preset = "custom";
        g.sessionKey = keyHash;
        g.actions = actions;
        g.apps = _strs("*");
        g.environments = _strs("staging", "prod");
        g.periodSeconds = 1 days;
        g.maxFeePerOp = 50_000;
        g.maxAppFeePerHour = 1e6;
        g.maxRatePerHour = 10e6;
        g.expiresAt = uint64(vm.getBlockTimestamp() + 7 days);
        g.grantNonce = keccak256(abi.encode("legacy", _n++));
        g.signBefore = uint64(vm.getBlockTimestamp() + 10 minutes);
    }

    function _sess(bytes32 sid) internal view returns (FundingSessionVault.Session memory s) {
        (s, , ) = vault.sessionOf(sid);
    }

    function _seq(bytes32 sid, uint256 nonce) internal view returns (uint64) {
        return vault.seqOf(sid, uint192(nonce >> 64));
    }
}
