{
  "name": "@enclavehost/sessions",
  "version": "0.1.0",
  "description": "Enclave sessions SDK: one client for browser sign-in and agents. Generates a P-256 session key, builds the EIP-712 grant the owner signs once, then signs intents that the relayer submits to the owner's SessionVault.",
  "type": "module",
  "license": "MIT",
  "main": "./dist/node.mjs",
  "types": "./dist/types/node.d.ts",
  "exports": {
    ".": {
      "types": "./dist/types/node.d.ts",
      "import": "./dist/node.mjs"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "node build.mjs",
    "typecheck": "tsc --noEmit",
    "test": "node --test test/*.test.mjs"
  },
  "peerDependencies": {
    "viem": "^2.53.1"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "esbuild": "^0.28.1",
    "typescript": "^5.9.3",
    "viem": "^2.53.1"
  }
}
