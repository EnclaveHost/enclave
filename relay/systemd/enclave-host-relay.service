# A DESIGNATED app-funded lease relay as an Enclave HOST ROLE (network/host-services/lease-relay-host.mjs), for a Linux
# Enclave host whose operator chose to serve relays for zero-ETH compute hosts. Template: review every value. NOT for the
# DigitalOcean transport machines (they stay bare-minimum WireGuard transport): a relay there would keep the shared-provider
# failure domain this role exists to remove.
#   /opt/enclave                          a reviewed checkout of this repository (the role supervisor and its modules)
#   /etc/enclave/host-relay.json          enclave-host-relay/v1 (stateRoot MUST be /var/lib/enclave-host-relay; set
#                                         platformHostPolicyCarriers (e.g. importDir, or a policy-mirror's documents
#                                         directory, peers, serviceIndex: true) so it starts with every fleet mirror down; packagesDir
#                                         holds lease-relay.mjs + lease-relay.package.json from build-lease-relay-host-package.mjs,
#                                         pinned by relay.package)
#   /var/lib/enclave-host-relay/lease-relay/relay.key       generated by `init` on first start, create-only 0600, in this
#                                         service's own state directory (never imported, never in the configuration)
# The relay key holds the operator's capped float (relay.maxFloatEth; the relay refuses to start above it). Fund it only
# after review: `cat /var/lib/enclave-host-relay/lease-relay/relay.address` is its address. Then publish the advertisement
# (`lease-relay-host.mjs descriptor` + `advertise`, signed by the operator) so compute hosts find it in the service index.
[Unit]
Description=Enclave designated lease relay (host role)
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=600
StartLimitBurst=5

[Service]
DynamicUser=yes
StateDirectory=enclave-host-relay
StateDirectoryMode=0700
WorkingDirectory=/var/lib/enclave-host-relay
# the key is created once, by this service's own identity, inside its own state directory (idempotent: an existing key is kept)
ExecStartPre=/usr/bin/node /opt/enclave/network/host-services/lease-relay-host.mjs init /etc/enclave/host-relay.json
ExecStartPre=/usr/bin/node /opt/enclave/network/host-services/lease-relay-host.mjs check /etc/enclave/host-relay.json
# the supervisor: pinned package, platform host policy gate (a ban stops the relay), no inherited environment, restart backoff
ExecStart=/usr/bin/node /opt/enclave/network/host-services/lease-relay-host.mjs run /etc/enclave/host-relay.json
Restart=on-failure
RestartSec=10
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=yes
LockPersonality=yes
SystemCallArchitectures=native
# THE process memory limit (this supervisor plus its one relay child). relay.heapMiB (earlier name relay.memoryMiB) only caps
# the relay's V8 old-space heap (--max-old-space-size); buffers, native and code memory are bounded here, not there.
MemoryMax=512M
TasksMax=64
LimitNOFILE=4096

[Install]
WantedBy=multi-user.target
