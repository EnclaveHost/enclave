# The permissionless app-funded lease relay (network/lease-relay-service.mjs), from a standalone release directory built
# by scripts/build-lease-relay-release.mjs. Template: review every value; docs/network/lease-relay-release.md has the
# staging, TLS route and rollback steps. Nothing in the repository installs or starts this unit.
#   /opt/enclave-lease-relay/releases/<artifact sha256>/   lease-relay.mjs, lease-relay-check.mjs, manifest.json
#   /opt/enclave-lease-relay/current -> releases/<sha256>   the release this unit runs (switch it to stage or roll back)
#   /etc/enclave-lease-relay/relay.env                      every setting, explicit (relay.env.example)
#   /etc/enclave-lease-relay/relay.key                      the hot key (0600 root): handed to the service as a credential,
#                                                           copied 0600 into the service's private runtime directory
#   /var/lib/enclave-lease-relay-state/relay-send.json      the key's unresolved signed send (StateDirectory; survives restarts)
[Unit]
Description=Enclave app-funded lease relay
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=600
StartLimitBurst=5

[Service]
EnvironmentFile=/etc/enclave-lease-relay/relay.env
# the key reaches the service only as a systemd credential (a private, read-only copy). systemd may present it 0440, which
# the strict owner-only check refuses (2026-10-21, both relays), so the FIRST ExecStartPre copies it 0600 into this
# service's own runtime directory (0700, removed when it stops); the env names that copy. The original is never changed.
LoadCredential=relay-key:/etc/enclave-lease-relay/relay.key
RuntimeDirectory=enclave-lease-relay-credentials
RuntimeDirectoryMode=0700
Environment=LEASE_RELAY_KEY_FILE=%t/enclave-lease-relay-credentials/relay.key
ExecStartPre=/usr/bin/install -m 0600 %d/relay-key %t/enclave-lease-relay-credentials/relay.key
# a send whose outcome is unknown is re-broadcast from here as the SAME signed bytes after a restart, never re-signed
# its OWN directory, never one holding a key: with DynamicUser, systemd chowns a StateDirectory recursively at every start
StateDirectory=enclave-lease-relay-state
StateDirectoryMode=0700
Environment=LEASE_RELAY_STATE=%S/enclave-lease-relay-state/relay-send.json
WorkingDirectory=/opt/enclave-lease-relay/current
# refuses to start unless every setting is explicit and valid and the directory holds the reviewed artifact
ExecStartPre=/usr/bin/node /opt/enclave-lease-relay/current/lease-relay-check.mjs
# --preserve-symlinks-main: the service starts only when its module URL equals the path it was run by; through the
# `current` symlink Node would otherwise resolve the URL to releases/<sha256>/ and the relay would exit without serving
ExecStart=/usr/bin/node --preserve-symlinks-main /opt/enclave-lease-relay/current/lease-relay.mjs
Restart=on-failure
RestartSec=10
DynamicUser=yes
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=yes
LockPersonality=yes
SystemCallArchitectures=native
# measured (test/lease-relay-release.test.mjs, docs/network/lease-relay-release.md): at least twice the measured peak. Node
# v22.23.3, 2026-10-25: 13 runs peaked at 92.2-104.6 MiB (base and verifier-authority builds alike), so 192M no longer left
# 2x; 224M does (2.14x the worst run). Template value only: an installed unit changes only by its own reviewed rollout.
MemoryMax=224M
TasksMax=64
LimitNOFILE=4096

[Install]
WantedBy=multi-user.target
