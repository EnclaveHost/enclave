[Unit]
Description=Enclave Alchemy RPC gateway with shared read cache
After=network-online.target
Wants=network-online.target
[Service]
DynamicUser=yes
LoadCredential=config.json:/etc/enclave-rpc/config.json
ExecStart=/usr/bin/node /opt/enclave-rpc/gateway.mjs ${CREDENTIALS_DIRECTORY}/config.json
Restart=on-failure
RestartSec=3
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
MemoryMax=192M
TasksMax=64
UMask=0077
[Install]
WantedBy=multi-user.target
