# Installed to ~/.config/systemd/user/ (user manager, Linger=yes). See rpc/snp/systemd/README.md.
[Unit]
Description=Stop the Enclave RPC enclave (r11) before its chain disks exhaust /vm
PartOf=enclave-rpc-snp-prod-r11.service
After=enclave-rpc-snp-prod-r11.service

[Service]
# 100 GiB keeps room for the other workloads sharing /vm; the guard stops the enclave once and exits.
ExecStart=/usr/bin/python3 -I %h/.local/share/enclave-rpc-snp/disk_guard.py enclave-rpc-snp-prod-r11.service /vm 100
Restart=no
MemoryMax=128M
NoNewPrivileges=yes

[Install]
WantedBy=enclave-rpc-snp-prod-r11.service
