# Installed to ~/.config/systemd/user/ (user manager, Linger=yes). See rpc/snp/systemd/README.md.
[Unit]
Description=Keep the Enclave RPC enclave (r12) chain disks from exhausting /vm
PartOf=enclave-rpc-snp-prod-r12.service
After=enclave-rpc-snp-prod-r12.service

[Service]
# 100 GiB keeps room for the other workloads sharing /vm. Under 150 GiB with at least 50 GiB the guest freed
# but never discarded, the guard starts the offline trim; under 100 GiB otherwise it stops the enclave and exits.
ExecStart=/usr/bin/python3 -I %h/.local/share/enclave-rpc-snp/disk_guard.py enclave-rpc-snp-prod-r12.service /vm 100 \
  --launch-config %h/.local/share/enclave-rpc-snp/prod-r12.json \
  --trim-unit enclave-rpc-snp-offline-trim-r12.service --trim-state %h/.local/state/enclave-rpc-snp/offline-trim-r12.json \
  --trim-at 150 --warn-at 250 --min-reclaim 50
Restart=no
MemoryMax=128M
NoNewPrivileges=yes

[Install]
WantedBy=enclave-rpc-snp-prod-r12.service
