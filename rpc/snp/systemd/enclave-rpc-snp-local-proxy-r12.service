# Installed to ~/.config/systemd/user/ (user manager, Linger=yes). See rpc/snp/systemd/README.md.
[Unit]
Description=Plain-HTTP view of the attested enclave for host-local tools (L1 EL :18645, beacon :15052), pinned to r12
After=enclave-rpc-snp-prod-r12.service

[Service]
WorkingDirectory=%h/.local/share/enclave-rpc-snp/releases/e4b7243d4
ExecStart=/usr/bin/node rpc/snp/local-proxy.mjs https://127.0.0.1:18443 220e5ec06282a00b9bbaefc2e43f4b4729da37ee79692422392bf34ecdf4b15dd72ba15ee7bde72aadb97f86bcb91159 18645 15052
Restart=always
RestartSec=10s

[Install]
WantedBy=default.target
