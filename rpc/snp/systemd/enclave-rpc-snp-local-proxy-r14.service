# Installed to ~/.config/systemd/user/ (user manager, Linger=yes). See rpc/snp/systemd/README.md.
[Unit]
Description=Plain-HTTP view of the attested enclave for host-local tools (L1 EL :18645, beacon :15052), pinned to r14
After=enclave-snpvm-manager.service

[Service]
WorkingDirectory=%h/.local/share/enclave-rpc-snp/releases/19572bf2c
ExecStart=/usr/bin/node rpc/snp/local-proxy.mjs https://127.0.0.1:18443 aa1807f53d8d9e0eaca69289be7125545cf2dbc1744009b9624e703c5a24c5aa5e03d67be92d5436c20e18cb0fba42e0 18645 15052
Restart=always
RestartSec=10s

[Install]
WantedBy=default.target
