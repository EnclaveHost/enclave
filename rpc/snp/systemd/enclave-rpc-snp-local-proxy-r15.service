# Installed to ~/.config/systemd/user/ (user manager, Linger=yes). See rpc/snp/systemd/README.md.
[Unit]
Description=Plain-HTTP view of the attested enclave for host-local tools (L1 EL :18645, beacon :15052), pinned to r15
After=enclave-snpvm-manager.service

[Service]
WorkingDirectory=%h/.local/share/enclave-rpc-snp/releases/19572bf2c
ExecStart=/usr/bin/node rpc/snp/local-proxy.mjs https://127.0.0.1:18443 92901f814e7b6b3c6b466aaaf303c458f32286057640f3db1feda3a6ed5ce896d48504eb4a5496aa4e9a394d45b6f97b 18645 15052
Restart=always
RestartSec=10s

[Install]
WantedBy=default.target
