# Installed to ~/.config/systemd/user/ (user manager, Linger=yes). See rpc/snp/systemd/README.md.
[Unit]
Description=Plain-HTTP view of the attested enclave for host-local tools (L1 EL :18645, beacon :15052), pinned to r17
After=enclave-snpvm-manager.service

[Service]
WorkingDirectory=%h/.local/share/enclave-rpc-snp/releases/19572bf2c
ExecStart=/usr/bin/node rpc/snp/local-proxy.mjs https://127.0.0.1:18443 8d5a96926cf0f0047db04780678d5c62ba0c8d3688bb5f0476ab29f423b6ed3616d8991814b5b40580b69938244bda0e 18645 15052
Restart=always
RestartSec=10s

[Install]
WantedBy=default.target
