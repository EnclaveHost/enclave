// stream-probe (LAB, PVM-CPU.md "streaming sealed responses"): ggml-probe's decode, streamed -- one fixed-width NDJSON
// line per token, flushed as it is decoded, so a sealed response can arrive incrementally; a failed write (the client
// cancelled) stops the decode. Loads a HOST-PRELOADED GGUF by name, like ggml-probe.
// WIT deps vendored verbatim from wasmtime v45 (wasi@0.2.6,
// wasi:nn@0.2.0-rc-2024-10-28) so guest and host always agree.
package enclave:stream-probe;

world stream-probe {
  import wasi:nn/tensor@0.2.0-rc-2024-10-28;
  import wasi:nn/errors@0.2.0-rc-2024-10-28;
  import wasi:nn/inference@0.2.0-rc-2024-10-28;
  import wasi:nn/graph@0.2.0-rc-2024-10-28;
  export wasi:http/incoming-handler@0.2.6;
}
