+// The conv, with its state read and written where it lies when build_rs handed
+// back the live cache (the identity gather: rs_identity, which the graph-reuse
+// checks already compare). Then one op replaces the concat, the convolution and
+// the one or two copy-backs per layer: on the 27B that is 48 CONCATs and up to
+// 96 CPYs per pass, each a whole-team barrier over ~160 KB. Bit-identical: the
+// op sums the same window in the same order and writes the same columns to the
+// same slots (ggml_compute_forward_ssm_conv_state). ENCLAVE_GGML_CONV_INPLACE=0
+// restores the concat form.
+static bool conv_inplace_enabled() {
+    static const bool on = []{
+        const char * e = getenv("ENCLAVE_GGML_CONV_INPLACE");
+        return !(e && e[0] == '0');
+    }();
+    return on;
+}
