+// ggml_ssm_conv_state
+
+struct ggml_tensor * ggml_ssm_conv_state(
+        struct ggml_context * ctx,
+        struct ggml_tensor  * state,
+        struct ggml_tensor  * x,
+        struct ggml_tensor  * c,
+        int64_t               K,
+        size_t                snap_stride) {
+    GGML_ASSERT(ggml_is_3d(state));
+    GGML_ASSERT(ggml_is_matrix(c));
+    GGML_ASSERT(state->type == GGML_TYPE_F32 && x->type == GGML_TYPE_F32 && c->type == GGML_TYPE_F32);
+    GGML_ASSERT(ggml_is_contiguous(state));
+    GGML_ASSERT(x->nb[0] == sizeof(float));
+    GGML_ASSERT(c->nb[0] == sizeof(float));
+
+    const int64_t d_conv  = c->ne[0];
+    const int64_t d_inner = c->ne[1];
+    const int64_t n_t     = x->ne[1];
+    const int64_t n_s     = x->ne[2];
+
+    GGML_ASSERT(d_conv >= 2 && d_conv <= 16);
+    GGML_ASSERT(state->ne[0] == d_conv - 1);
+    GGML_ASSERT(state->ne[1] == d_inner);
+    GGML_ASSERT(state->ne[2] == n_s);
+    GGML_ASSERT(x->ne[0] == d_inner);
+    GGML_ASSERT(n_t >= 1);
+    GGML_ASSERT(K >= 1 && K <= 64);
+    /* Slots past the first are written at snap_stride; one slot needs none. */
+    GGML_ASSERT(K == 1 || snap_stride >= (size_t) ggml_nbytes(state));
+
+    struct ggml_tensor * result = ggml_new_tensor_3d(ctx, GGML_TYPE_F32, d_inner, n_t, n_s);
+
+    const int32_t params[3] = { (int32_t) K, (int32_t) (uint32_t) (snap_stride & 0xffffffffu), (int32_t) (uint32_t) ((uint64_t) snap_stride >> 32) };
+    ggml_set_op_params(result, params, sizeof(params));
+
+    result->op     = GGML_OP_SSM_CONV_STATE;
+    result->src[0] = state;
+    result->src[1] = c;
+    result->src[2] = x;
+
+    return result;
+}
 
