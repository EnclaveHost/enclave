+// Opt-in numeric CPU diagnostics. Timings include existing synchronization;
+// no new barriers, tensor reads, output changes, or model data are introduced.
+#define ENCLAVE_CPU_BUCKETS (GGML_OP_COUNT + 2)
+static atomic_bool enclave_cpu_profile_on = false;
+static atomic_uint_fast64_t enclave_cpu_counters[ENCLAVE_CPU_BUCKETS][6];
+static void enclave_cpu_note(int op, uint64_t us, const struct ggml_tensor * node) {
+    atomic_fetch_add_explicit(&enclave_cpu_counters[op][0], 1, memory_order_relaxed);
+    atomic_fetch_add_explicit(&enclave_cpu_counters[op][1], us, memory_order_relaxed);
+    if (node) for (int j=0;j<4;j++) {
+        uint64_t v=(uint64_t) node->ne[j];
+        uint64_t old=atomic_load_explicit(&enclave_cpu_counters[op][2+j],memory_order_relaxed);
+        while(old<v && !atomic_compare_exchange_weak_explicit(&enclave_cpu_counters[op][2+j],&old,v,memory_order_relaxed,memory_order_relaxed)) {}
+    }
+}
+int ggml_backend_cpu_profile_snapshot(uint64_t *out, size_t count) {
+    const size_t needed=2+ENCLAVE_CPU_BUCKETS*6;
+    if(!out || count<needed) return -1;
+    if(!enclave_cpu_profile_on) return 0;
+    out[0]=1; out[1]=ENCLAVE_CPU_BUCKETS;
+    for(int i=0;i<ENCLAVE_CPU_BUCKETS;i++) for(int j=0;j<6;j++)
+        out[2+i*6+j]=atomic_load_explicit(&enclave_cpu_counters[i][j],memory_order_relaxed);
+    return (int)needed;
+}
