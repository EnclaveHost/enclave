     struct node_properties {
@@ -1446,6 +1448,22 @@ struct ggml_backend_cuda_context {
         auto it = cuda_graphs.find(first_node_ptr);
         if (it == cuda_graphs.end()) {
             it = cuda_graphs.emplace(first_node_ptr, std::make_unique<ggml_cuda_graph>()).first;
+            // enclave slot cap (mm7): with shape-keyed graph keys a workload
+            // that cycles many ubatch shapes (a confidence-gated draft: k16/
+            // p0.3 produced 17+ verify/re-feed lengths) would capture a graph
+            // per shape, and capture+instantiate cost far exceeds one direct
+            // pass (the mm3 regression, 39 -> 30 tok/s). Slots past the cap
+            // are created (they still count visits and evict on idle) but are
+            // never allowed to capture - they execute directly forever, which
+            // is stock behavior. Fixed-shape speculation needs at most
+            // {1-token, verify k+1, a couple of re-feed lengths} = well under
+            // the default of 6.
+            static const size_t slot_cap = [] {
+                const char * env = getenv("GGML_CUDA_GRAPH_SLOTS");
+                const int v = env ? atoi(env) : 6;
+                return (size_t) (v > 0 ? v : 6);
+            }();
+            it->second->capture_allowed = cuda_graphs.size() <= slot_cap;
         }
         it->second->last_used_time = time_now;
         return it->second.get();
