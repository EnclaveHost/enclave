# NOT APPLIED -- validated but not integrated (shielded/REPORT.md 18.51, 18.53-18.54).
#
# GATED_DELTA_NET, register-resident row kernel (ENCLAVE_GGML_GDN_REGROW; =0
# restores the four vector calls). For the scalar gate and S_v = 128 (both
# qwen35 models here), each state row is loaded once, taken through scale,
# dot(k), d*k update and dot(q) in registers, and stored once, using ggml's own
# GGML_F32_VEC operations in exactly the order of ggml_vec_scale_f32 /
# ggml_vec_dot_f32 / ggml_vec_mad_f32 -- bit-identical by construction, checked
# by wasm/llamacpp-conv-inplace/gdn-equiv.cpp and the real-graph test. Compiled
# only at 16 floats per vector (AVX-512): on the production AVX2 build a row is
# all 16 ymm registers and measured ~55% slower, so there it compiles out.
#
# Why it is not in the llamacpp-toolchain workflow: that build is AVX2-only
# (GGML_NATIVE=OFF), where this kernel compiles out, so it would ship dead code.
# And this diff is FORK-RELATIVE: its context is the development fork's
# fused-rows delta-net loop (ENCLAVE_GGML_GDN_SWEEPS, rejected as neutral in
# section 16 and carried by no patch in this repo) plus llamacpp-conv-inplace.patch;
# it does not apply to the workflow's tree. Porting it means writing it against
# the four-sweep loop the workflow builds, and only pays on an AVX-512 build.
--- a/ggml/src/ggml-cpu/ops.cpp	2026-09-23 17:35:02.724488683 -0700
+++ b/ggml/src/ggml-cpu/ops.cpp	2026-09-23 17:35:02.725191964 -0700
@@ -11003,6 +11003,69 @@
     return on;
 }

+// One state row through all four steps of a scalar-gate token WITHOUT leaving
+// registers (ENCLAVE_GGML_GDN_REGROW=0 restores the four vector calls). The row
+// is loaded once, scaled, dotted with k, updated by d*k, dotted with q, and
+// stored once, where the calls load and store it around every step. Each step
+// uses ggml's own GGML_F32_VEC operations in exactly the order of
+// ggml_vec_scale_f32 / ggml_vec_dot_f32 / ggml_vec_mad_f32 for a length that is
+// a multiple of GGML_F32_STEP (no leftovers): the same multiplies and fused
+// multiply-adds on the same values, the dot products over the same
+// GGML_F32_ARR accumulators reduced by the same GGML_F32_VEC_REDUCE. So the
+// row, the output and every snapshot are bit-identical to the calls on every
+// ISA this path compiles for; any other length or ISA keeps the calls.
+static bool gdn_regrow() {
+    static const bool on = []{
+        const char * e = getenv("ENCLAVE_GGML_GDN_REGROW");
+        return !(e && e[0] == '0');
+    }();
+    return on;
+}
+
+// Only where a row fits the register file: at 16 floats per vector (AVX-512) the
+// row is 8 registers; at 8 (AVX2) it is all 16 ymm registers before a single
+// accumulator, the compiler spills, and the production toolchain's AVX2 build
+// measured the register row ~55% SLOWER than the calls (gdn-bench, GCC 11.4).
+#if defined(GGML_SIMD) && !defined(__ARM_FEATURE_SVE) && !defined(__riscv_v_intrinsic) && !defined(GGML_USE_ACCELERATE) && GGML_F32_EPR >= 16
+#define GDN_REGROW_SV 128
+static_assert(GDN_REGROW_SV % GGML_F32_STEP == 0, "the register row must have no dot/mad leftovers");
+// returns dot(row after the update, q); updates the row in place
+static inline float gdn_regrow_row(float * GGML_RESTRICT rowp, const float * GGML_RESTRICT k, const float * GGML_RESTRICT q,
+                                   float expg, float v_j, float beta) {
+    constexpr int NV = GDN_REGROW_SV / GGML_F32_EPR;
+    GGML_F32_VEC r[NV];
+    for (int i = 0; i < NV; i++) r[i] = GGML_F32_VEC_LOAD(rowp + i*GGML_F32_EPR);
+    // ggml_vec_scale_f32: ay = MUL(ay, vx)
+    const GGML_F32_VEC vg = GGML_F32_VEC_SET1(expg);
+    for (int i = 0; i < NV; i++) r[i] = GGML_F32_VEC_MUL(r[i], vg);
+    // ggml_vec_dot_f32(row, k): sum[j] = FMA(sum[j], x, y) over STEP-blocks, then REDUCE
+    float sk;
+    {
+        GGML_F32_VEC sum[GGML_F32_ARR] = { GGML_F32_VEC_ZERO };
+        for (int b = 0; b < NV; b += GGML_F32_ARR)
+            for (int j = 0; j < GGML_F32_ARR; j++)
+                sum[j] = GGML_F32_VEC_FMA(sum[j], r[b + j], GGML_F32_VEC_LOAD(k + (b + j)*GGML_F32_EPR));
+        GGML_F32_VEC_REDUCE(sk, sum);
+    }
+    const float d = (v_j - sk) * beta;
+    // ggml_vec_mad_f32(row, k, d): ay = FMA(ay, ax, vx)
+    const GGML_F32_VEC vd = GGML_F32_VEC_SET1(d);
+    for (int i = 0; i < NV; i++) r[i] = GGML_F32_VEC_FMA(r[i], GGML_F32_VEC_LOAD(k + i*GGML_F32_EPR), vd);
+    for (int i = 0; i < NV; i++) GGML_F32_VEC_STORE(rowp + i*GGML_F32_EPR, r[i]);
+    // ggml_vec_dot_f32(row, q)
+    float sq;
+    {
+        GGML_F32_VEC sum[GGML_F32_ARR] = { GGML_F32_VEC_ZERO };
+        for (int b = 0; b < NV; b += GGML_F32_ARR)
+            for (int j = 0; j < GGML_F32_ARR; j++)
+                sum[j] = GGML_F32_VEC_FMA(sum[j], r[b + j], GGML_F32_VEC_LOAD(q + (b + j)*GGML_F32_EPR));
+        GGML_F32_VEC_REDUCE(sq, sum);
+    }
+    return sq;
+}
+#define GDN_HAVE_REGROW 1
+#endif
