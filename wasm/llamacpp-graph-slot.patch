+llama_context::alt_slot * llama_context::ensure_slot_alt(uint32_t n_tokens) {
+    // LLAMA_GRAPH_SLOT_ALT=0 disables the ring wholesale (config-only
+    // rollback lever, mirrors LLAMA_GRAPH_REUSE_DISABLE).
+    static const bool disabled = [] {
+        const char * e = getenv("LLAMA_GRAPH_SLOT_ALT");
+        return e && atoi(e) == 0;
+    }();
+    if (disabled) {
+        return nullptr;
+    }
+    if (backend_ptrs.empty()) {
+        return nullptr;
+    }
+    slot_tick++;
+    // exact-shape hit
+    for (auto & sl : slots_alt) {
+        if (sl.sched && sl.n_tokens == n_tokens) {
+            sl.last_use = slot_tick;
+            return &sl;
+        }
+    }
+    // miss: take an empty entry, else evict the LRU one
+    alt_slot * pick = nullptr;
+    for (auto & sl : slots_alt) {
+        if (!sl.sched) { pick = &sl; break; }
+    }
+    if (!pick) {
+        pick = &slots_alt[0];
+        for (auto & sl : slots_alt) {
+            if (sl.last_use < pick->last_use) pick = &sl;
+        }
+        pick->sched = nullptr;
+        pick->res = nullptr;
+    }
+    const size_t max_nodes = this->graph_max_nodes(n_tokens);
+    pick->res.reset(new llm_graph_result(max_nodes));
+    pick->sched.reset(ggml_backend_sched_new(backend_ptrs.data(), backend_buft.data(), backend_ptrs.size(), max_nodes, false, cparams.op_offload));
+    llama_memory_context_ptr mctx;
+    if (memory) {
+        mctx = memory->init_full();
+        if (!mctx) {
+            pick->sched = nullptr;
+            pick->res = nullptr;
+            slot_alt_state = -1;
+            return nullptr;
+        }
+    }
+    const auto save_active = sched_active;
+    auto * gf = graph_reserve(n_tokens, 1, n_tokens, mctx.get(), false, nullptr, pick->sched.get());
+    sched_active = save_active;
+    if (!gf) {
+        LLAMA_LOG_WARN("%s: graph-slot reserve failed for n_tokens=%u - shared slot fallback\n", __func__, n_tokens);
+        pick->sched = nullptr;
+        pick->res = nullptr;
+        slot_alt_state = -1;
+        return nullptr;
+    }
+    pick->n_tokens = n_tokens;
+    pick->last_use = slot_tick;
+    LLAMA_LOG_INFO("%s: graph slot ready for n_tokens=%u\n", __func__, n_tokens);
+    slot_alt_state = 1;
+    return pick;
+}
