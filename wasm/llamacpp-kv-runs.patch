+ggml_tensor * llm_graph_context::build_attn_mha_runs(
+         ggml_tensor * q,
+         const llama_kv_cache_context * mctx_cur,
+         const std::vector<uint32_t> & runs,
+         ggml_tensor * kq_mask,
+         ggml_tensor * sinks,
+               float   kq_scale,
+                 int   il) const {
+    // build_attn_mha's unfused path over the runs' cells only: KQ of each run, joined along the cells into one
+    // softmax row, then KQV per run, summed. The cells between runs hold only other sequences (or nothing), so
+    // every query here masks them to -INF and they add exact zeros to the softmax sum and to KQV.
+    GGML_ASSERT(!cparams.flash_attn && arch != LLM_ARCH_GROK && !hparams.attn_soft_cap);
+    GGML_ASSERT(runs.size() >= 2 && runs.size() % 2 == 0);
+
+    q = ggml_permute(ctx0, q, 0, 2, 1, 3);
+
+    ggml_tensor * kq = nullptr;
+    for (size_t r = 0; r < runs.size(); r += 2) {
+        ggml_tensor * k = ggml_permute(ctx0, mctx_cur->get_k_run(ctx0, il, runs[r], runs[r + 1]), 0, 2, 1, 3);
+        GGML_ASSERT(k->ne[3] == 1);
+
+        ggml_tensor * kq_r = ggml_mul_mat(ctx0, k, q);
+        ggml_mul_mat_set_prec(kq_r, GGML_PREC_F32);
+
+        kq = kq ? ggml_concat(ctx0, kq, kq_r, 0) : kq_r;
+    }
+    cb(kq, "kq", il);
+
+    kq = ggml_soft_max_ext(ctx0, kq, kq_mask, kq_scale, hparams.f_max_alibi_bias);
+    ggml_soft_max_add_sinks(kq, sinks);
+    cb(kq, "kq_soft_max", il);
+
+    // KQV per run, summed: each run's V view is read in place (joining the runs' V into one tensor would keep
+    // the [0, n_kv) accumulation order bit for bit, but the copy costs about as much as the attention it saves
+    // on the 27B). Only the order of the KQV sum changes - the same rounding a split with nothing skipped shows.
+    ggml_tensor * kqv = nullptr;
+    size_t off = 0;
+    for (size_t r = 0; r < runs.size(); r += 2) {
+        const uint32_t n = runs[r + 1];
+
+        ggml_tensor * v = ggml_permute(ctx0, mctx_cur->get_v_run(ctx0, il, runs[r], n), 0, 2, 1, 3); // [n, d, h_kv]
+        ggml_tensor * p = ggml_view_4d(ctx0, kq, n, kq->ne[1], kq->ne[2], kq->ne[3],
+                                       kq->nb[1], kq->nb[2], kq->nb[3], off*kq->nb[0]);
+
+        ggml_tensor * part = ggml_mul_mat(ctx0, v, p);
+        kqv = kqv ? ggml_add(ctx0, kqv, part) : part;
+        off += n;
+    }
+    GGML_ASSERT((int64_t) off == kq->ne[0]);
+    cb(kqv, "kqv", il);
+
+    ggml_tensor * cur = ggml_permute(ctx0, kqv, 0, 2, 1, 3);
+    cur = ggml_cont_2d(ctx0, cur, cur->ne[0]*cur->ne[1], cur->ne[2]*cur->ne[3]);
+
+    if (!cparams.offload_kqv) {
+        // all nodes between the KV store and the attention output are run on the CPU
+        ggml_backend_sched_set_tensor_backend(sched, cur, backend_cpu);
+    }
+
+    ggml_build_forward_expand(gf, cur);
+
+    return cur;
+}
