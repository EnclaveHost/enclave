+// A process-wide native team serves serialized CPU islands even when async
+// HTTP requests resume on different OS threads. External caller-owned pools
+// retain their existing semantics. Separate sizes remain alive for old plans.
+static std::mutex enclave_pool_mutex;
+struct enclave_pool_owner {
+    ggml_threadpool_t pool;
+    ~enclave_pool_owner() { ggml_threadpool_free(pool); }
+};
+static std::map<int, std::unique_ptr<enclave_pool_owner>> enclave_pools;
+static bool enclave_pool_enabled() {
+    static const bool on = [] {
+        const char * e = getenv("ENCLAVE_GGML_SHARED_CPU_POOL");
+        return e && !strcmp(e, "1");
+    }();
+#ifdef GGML_USE_OPENMP
+    if (on) GGML_ABORT("shared CPU pool requires native threads, not OpenMP");
+#endif
+    return on;
+}
+// Caller holds enclave_pool_mutex.
+static ggml_threadpool_t enclave_pool_get(int n) {
+    auto found = enclave_pools.find(n);
+    if (found != enclave_pools.end()) return found->second->pool;
+    std::vector<int> cpus;
+    const char * s = getenv("SHIELDED_CPU_COMPUTE");
+    GGML_ASSERT(s && *s && n > 0 && n <= GGML_MAX_N_THREADS);
+    bool seen[GGML_MAX_N_THREADS] = {};
+    for (;;) {
+        GGML_ASSERT(*s >= '0' && *s <= '9');
+        char * end; long cpu = strtol(s, &end, 10);
+        GGML_ASSERT(cpu >= 0 && cpu < GGML_MAX_N_THREADS && !seen[cpu]);
+        seen[cpu] = true; cpus.push_back((int)cpu);
+        if (!*end) break;
+        GGML_ASSERT(*end == ',' && end[1]); s = end + 1;
+    }
+    GGML_ASSERT(cpus.size() >= (size_t)n);
+    auto params = ggml_threadpool_params_default(n);
+    auto owner = std::make_unique<enclave_pool_owner>();
+    owner->pool = ggml_threadpool_new_enclave(&params, cpus.data(), cpus.size());
+    auto * result = owner->pool;
+    enclave_pools.emplace(n, std::move(owner));
+    return result;
+}
