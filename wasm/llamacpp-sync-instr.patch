+// enclave sync-instr (mm20 investigation): cumulative wall time spent
+// INSIDE stream synchronization. Every decode on the CVM carries a
+// model-size-independent ~5-8 ms fixed cost (measured 2026-08-03: 1-layer
+// head decodes 8-12 ms, 65-layer batch-1 15.4, verify b5 30) and the CC
+// host<->device round trip on sync is the prime suspect. The counter names
+// it: sync_us / decode ~= the tax, directly. Exported C symbol so the
+// enclave shim can dlsym it from the dlopened module (no link-time dep).
+static std::atomic<int64_t> g_enclave_sync_us{0};
+static std::atomic<int64_t> g_enclave_sync_calls{0};
+static cudaError_t enclave_timed_sync(cudaStream_t s) {
+    const int64_t t0 = ggml_time_us();
+    const cudaError_t e = cudaStreamSynchronize(s);
+    g_enclave_sync_us.fetch_add(ggml_time_us() - t0, std::memory_order_relaxed);
+    g_enclave_sync_calls.fetch_add(1, std::memory_order_relaxed);
+    return e;
+}
+extern "C" int64_t ggml_backend_cuda_sync_stats(int64_t * calls) {
+    if (calls) {
+        *calls = g_enclave_sync_calls.load(std::memory_order_relaxed);
+    }
+    return g_enclave_sync_us.load(std::memory_order_relaxed);
+}
