+// enclave mm23: cudaMallocHost fails inside CVM tenant environments
+// (suspect: the MPS pinned-device limit in the tenant env), and ggml's
+// silent pageable fallback turns every logits extraction into a BLOCKING
+// full-stream wait (measured: out_get = 14.20 of the 15.6 ms/token fleet
+// budget). Pinning caller-provided pages via cudaHostRegister takes a
+// different driver path; when it works, D2H into the output buffer is
+// async again. Freed via unregister + free, mirroring the buffer's own
+// allocation.
+static void ggml_backend_cuda_hostreg_free_buffer(ggml_backend_buffer_t buffer) {
+    CUDA_CHECK(cudaHostUnregister(buffer->context));
+    free(buffer->context);
+}
