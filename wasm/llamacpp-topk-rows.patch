+// enclave topk-rows: backend sampling is no longer restricted to one output
+// row per sequence (build_sampling instantiates the chain per output row),
+// but only for small batches - a prefill chunk with hundreds of output rows
+// would explode the sampler graph. Batches with more output rows than this
+// take the raw-logits path unchanged. Must match sampler_graph_max_rows()
+// in llama-graph.cpp (same env, same default).
+static int32_t sampler_max_rows() {
+    static int32_t v = 0;
+    if (v == 0) {
+        const char * e = getenv("LLAMA_SAMPLER_MAX_ROWS");
+        v = e ? atoi(e) : 8;
+        if (v < 1) {
+            v = 8;
+        }
+    }
+    return v;
+}
