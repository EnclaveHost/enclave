+;;;; Rules for atomics (the threads proposal) ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
+
+;; Pulley had no atomic instructions at all, which is why wasmtime refused the
+;; `threads` proposal for a pulley target before these existed. The opcodes are
+;; in pulley/src/lib.rs and its interpreter, and every one of them is
+;; sequentially consistent - what the wasm threads proposal specifies.
+;;
+;; The address is an `o32` amode: Pulley has no guard pages, so the wasm bounds
+;; check is already lowered separately, and the ALIGNMENT check is emitted by
+;; the wasm frontend before the access (TRAP_HEAP_MISALIGNED). What arrives here
+;; is a plain host address.
+;;
+;; `little_or_native_endian` is the same guard every other backend uses: a
+;; big-endian atomic access has no lowering anywhere, and matching it here would
+;; produce a silently byte-swapped result rather than a clear refusal. The types
+;; are matched literally rather than through riscv64's `valid_atomic_transaction`,
+;; which is that backend's own helper - the four widths ARE the valid set.
+
+(rule (lower (fence)) (side_effect (pulley_xatomic_fence)))
+
+(decl atomic_amode (Value) AddrO32)
+;; `offset32` is an extractor, not a constructor - a CLIF atomic carries no
+;; offset operand anyway, so the address is used as it is.
+(rule (atomic_amode addr) (addro32 addr (i32_to_offset32 0)))
+
+;; ---- atomic_load / atomic_store ----------------------------------------------
+
+(rule (lower (atomic_load $I8 (little_or_native_endian _flags) p))
+  (pulley_xatomic_load8_o32 (atomic_amode p)))
+(rule (lower (atomic_load $I16 (little_or_native_endian _flags) p))
+  (pulley_xatomic_load16le_o32 (atomic_amode p)))
+(rule (lower (atomic_load $I32 (little_or_native_endian _flags) p))
+  (pulley_xatomic_load32le_o32 (atomic_amode p)))
+(rule (lower (atomic_load $I64 (little_or_native_endian _flags) p))
+  (pulley_xatomic_load64le_o32 (atomic_amode p)))
+
+(rule (lower (atomic_store (little_or_native_endian _flags) src @ (value_type $I8) p))
+  (side_effect (pulley_xatomic_store8_o32 (atomic_amode p) src)))
+(rule (lower (atomic_store (little_or_native_endian _flags) src @ (value_type $I16) p))
+  (side_effect (pulley_xatomic_store16le_o32 (atomic_amode p) src)))
+(rule (lower (atomic_store (little_or_native_endian _flags) src @ (value_type $I32) p))
+  (side_effect (pulley_xatomic_store32le_o32 (atomic_amode p) src)))
+(rule (lower (atomic_store (little_or_native_endian _flags) src @ (value_type $I64) p))
+  (side_effect (pulley_xatomic_store64le_o32 (atomic_amode p) src)))
+
+;; ---- atomic_cas --------------------------------------------------------------
+;; Answers the value FOUND, which is what wasm's cmpxchg wants: the guest
+;; compares it itself rather than being told success or failure.
+
+(rule (lower (atomic_cas $I8 (little_or_native_endian _flags) p e x))
+  (pulley_xatomic_cas8_o32 (atomic_amode p) e x))
+(rule (lower (atomic_cas $I16 (little_or_native_endian _flags) p e x))
+  (pulley_xatomic_cas16le_o32 (atomic_amode p) e x))
+(rule (lower (atomic_cas $I32 (little_or_native_endian _flags) p e x))
+  (pulley_xatomic_cas32le_o32 (atomic_amode p) e x))
+(rule (lower (atomic_cas $I64 (little_or_native_endian _flags) p e x))
+  (pulley_xatomic_cas64le_o32 (atomic_amode p) e x))
+
+;; ---- atomic_rmw --------------------------------------------------------------
+;; The six operations wasm has. CLIF also defines nand/umin/umax/smin/smax,
+;; which no wasm guest can emit; they are left without a rule so a caller that
+;; somehow reaches them gets Cranelift's own "should be implemented in ISLE"
+;; rather than a wrong answer.
+
