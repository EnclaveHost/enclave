+(rule (lower (atomic_rmw $I8 (little_or_native_endian _flags) (AtomicRmwOp.Sub) p x))
+  (pulley_xatomic_rmw8_sub_o32 (atomic_amode p) x))
+(rule (lower (atomic_rmw $I8 (little_or_native_endian _flags) (AtomicRmwOp.And) p x))
+  (pulley_xatomic_rmw8_and_o32 (atomic_amode p) x))
+(rule (lower (atomic_rmw $I8 (little_or_native_endian _flags) (AtomicRmwOp.Or) p x))
+  (pulley_xatomic_rmw8_or_o32 (atomic_amode p) x))
+(rule (lower (atomic_rmw $I8 (little_or_native_endian _flags) (AtomicRmwOp.Xor) p x))
+  (pulley_xatomic_rmw8_xor_o32 (atomic_amode p) x))
+(rule (lower (atomic_rmw $I8 (little_or_native_endian _flags) (AtomicRmwOp.Xchg) p x))
+  (pulley_xatomic_rmw8_xchg_o32 (atomic_amode p) x))
+(rule (lower (atomic_rmw $I16 (little_or_native_endian _flags) (AtomicRmwOp.Add) p x))
+  (pulley_xatomic_rmw16le_add_o32 (atomic_amode p) x))
+(rule (lower (atomic_rmw $I16 (little_or_native_endian _flags) (AtomicRmwOp.Sub) p x))
+  (pulley_xatomic_rmw16le_sub_o32 (atomic_amode p) x))
+(rule (lower (atomic_rmw $I16 (little_or_native_endian _flags) (AtomicRmwOp.And) p x))
+  (pulley_xatomic_rmw16le_and_o32 (atomic_amode p) x))
+(rule (lower (atomic_rmw $I16 (little_or_native_endian _flags) (AtomicRmwOp.Or) p x))
+  (pulley_xatomic_rmw16le_or_o32 (atomic_amode p) x))
+(rule (lower (atomic_rmw $I16 (little_or_native_endian _flags) (AtomicRmwOp.Xor) p x))
+  (pulley_xatomic_rmw16le_xor_o32 (atomic_amode p) x))
+(rule (lower (atomic_rmw $I16 (little_or_native_endian _flags) (AtomicRmwOp.Xchg) p x))
+  (pulley_xatomic_rmw16le_xchg_o32 (atomic_amode p) x))
+(rule (lower (atomic_rmw $I32 (little_or_native_endian _flags) (AtomicRmwOp.Add) p x))
+  (pulley_xatomic_rmw32le_add_o32 (atomic_amode p) x))
+(rule (lower (atomic_rmw $I32 (little_or_native_endian _flags) (AtomicRmwOp.Sub) p x))
+  (pulley_xatomic_rmw32le_sub_o32 (atomic_amode p) x))
+(rule (lower (atomic_rmw $I32 (little_or_native_endian _flags) (AtomicRmwOp.And) p x))
+  (pulley_xatomic_rmw32le_and_o32 (atomic_amode p) x))
+(rule (lower (atomic_rmw $I32 (little_or_native_endian _flags) (AtomicRmwOp.Or) p x))
+  (pulley_xatomic_rmw32le_or_o32 (atomic_amode p) x))
+(rule (lower (atomic_rmw $I32 (little_or_native_endian _flags) (AtomicRmwOp.Xor) p x))
+  (pulley_xatomic_rmw32le_xor_o32 (atomic_amode p) x))
+(rule (lower (atomic_rmw $I32 (little_or_native_endian _flags) (AtomicRmwOp.Xchg) p x))
+  (pulley_xatomic_rmw32le_xchg_o32 (atomic_amode p) x))
+(rule (lower (atomic_rmw $I64 (little_or_native_endian _flags) (AtomicRmwOp.Add) p x))
+  (pulley_xatomic_rmw64le_add_o32 (atomic_amode p) x))
+(rule (lower (atomic_rmw $I64 (little_or_native_endian _flags) (AtomicRmwOp.Sub) p x))
+  (pulley_xatomic_rmw64le_sub_o32 (atomic_amode p) x))
+(rule (lower (atomic_rmw $I64 (little_or_native_endian _flags) (AtomicRmwOp.And) p x))
+  (pulley_xatomic_rmw64le_and_o32 (atomic_amode p) x))
+(rule (lower (atomic_rmw $I64 (little_or_native_endian _flags) (AtomicRmwOp.Or) p x))
+  (pulley_xatomic_rmw64le_or_o32 (atomic_amode p) x))
+(rule (lower (atomic_rmw $I64 (little_or_native_endian _flags) (AtomicRmwOp.Xor) p x))
+  (pulley_xatomic_rmw64le_xor_o32 (atomic_amode p) x))
+(rule (lower (atomic_rmw $I64 (little_or_native_endian _flags) (AtomicRmwOp.Xchg) p x))
+  (pulley_xatomic_rmw64le_xchg_o32 (atomic_amode p) x))
