index 98090ec..19c59be 100644
--- a/crates/wasmtime/src/config.rs
+++ b/crates/wasmtime/src/config.rs
@@ -2420,12 +2420,25 @@ impl Config {
         #[cfg(any(feature = "cranelift", feature = "winch"))]
         match self.compiler_config.as_ref().and_then(|c| c.strategy) {
             None | Some(Strategy::Cranelift) => {
-                // Pulley at this time fundamentally doesn't support the
-                // `threads` proposal, notably shared memory, because Rust can't
-                // safely implement loads/stores in the face of shared memory.
-                // Stack switching is not implemented, either.
+                // Pulley now implements the `threads` proposal: the atomic
+                // instructions are in pulley/src/lib.rs and its interpreter, and
+                // the lowerings are in isa/pulley_shared/lower.isle. They exist
+                // because an app that uses threads has to be runnable where
+                // there is nothing to JIT into - inside a VBS enclave.
+                //
+                // Upstream's reason for excluding it was that "Rust can't safely
+                // implement loads/stores in the face of shared memory". Pulley's
+                // ordinary loads and stores already go through RAW POINTERS
+                // rather than Rust slices (`AddressingMode::addr` returns
+                // `*mut T`), so the change is not structural: the atomic ops use
+                // `AtomicNN::from_ptr` on that same pointer, which is exactly
+                // the operation the wasm threads proposal describes. Non-atomic
+                // racing accesses remain as the spec allows - they may read
+                // garbage, and they go through `read_unaligned`/`write_unaligned`
+                // on a raw pointer rather than through a reference.
+                //
+                // Stack switching is still not implemented.
                 if self.compiler_target().is_pulley() {
-                    unsupported |= WasmFeatures::THREADS;
                     unsupported |= WasmFeatures::STACK_SWITCHING;
                 }
 
