index b06b8e6..eb4c5ee 100644
--- a/libc-bottom-half/headers/private/wasi/descriptor_table.h
+++ b/libc-bottom-half/headers/private/wasi/descriptor_table.h
@@ -3,6 +3,46 @@
 
 #include <wasi/api.h>
 
+/// enclave/SET: state that must be PER-THREAD under shared-everything-threads.
+///
+/// A SET thread shares linear memory with its siblings but NOT the component
+/// instance it runs in: the engine gives each spawned thread its own
+/// instantiation, because Cranelift bakes direct calls to statically-known
+/// imports into compiled code and a thread running anything less would execute
+/// another thread's code against a foreign vmctx. Component resource handles
+/// (`own<descriptor>`, `own<output-stream>`, ...) are indices into the handle
+/// table of ONE instance, so a handle another thread cached in shared memory
+/// names nothing here: using it traps `unknown handle index`.
+///
+/// Everything that stores or derives such a handle therefore has to live in
+/// TLS: the descriptor table, the lazily-cached stdio streams, and the preopen
+/// table (whose entries are libc fds, i.e. descriptor-table indices). Each
+/// thread lazily rebuilds its own from its own instance's imports.
+///
+/// The honest consequence, identical to the wasi-threads (p1) model: file
+/// descriptors are NOT shared between threads. A thread can open, read, write
+/// and close its own; it cannot inherit a sibling's. Compute parallelism and
+/// per-thread I/O — the point of SET — are unaffected.
+#ifdef __wasilibc_set_threads__
+#define __wasilibc_thread_state _Thread_local
+
+/// Release everything this thread's descriptor state holds: the table's
+/// entries (each owning a component resource handle in this thread's own
+/// instance), its `entries` array, the preopen prefixes, and the
+/// fd-namespace slot. Called from `__pthread_exit`.
+void __wasilibc_set_release_thread_state(void);
+
+/// Release only the fd-namespace slot. Called from the engine-invoked
+/// `__enclave_set_thread_died` hook, where making further component calls to
+/// drop resource handles would be unwise.
+void __wasilibc_set_release_thread_fd_slot(void);
+
+/// Drop this thread's preopen table (implemented in `preopens.c`).
+void __wasilibc_set_release_preopens(void);
+#else
+#define __wasilibc_thread_state
+#endif
+
 #ifndef __wasip1__
 #include <assert.h>
 #include <netinet/in.h>
