+ *  - `ofl_lock` is RELEASED before the write. `f->write` is a host call that
+ *    can block indefinitely (slow file, full pipe, socket with no reader), and
+ *    blocking in one while holding the process-global, OWNERLESS `ofl_lock`
+ *    would wedge every other thread's `fopen`/`fclose`/`fflush(NULL)`/`exit`
+ *    with nothing able to recover it -- strictly worse than the leak this
+ *    fixes. Hence one victim per pass and restart from the head: we never hold
+ *    a `FILE *` across an unlocked window.
+ *
+ *  - `ftrylockfile`, never `__lockfile`/`FLOCK`. A blocking acquire here is a
+ *    NEW hang axis in `__pthread_exit` -- before `__tl_lock`, so the thread
+ *    would never wake its joiner -- and `f->lock` can be held by a thread that
+ *    died holding it. A contended FILE is skipped and loses its bytes, which
+ *    is exactly today's behaviour, so the try can never be a regression.
+ *    `ftrylockfile` also REGISTERS on `stdio_locks`, so if `f->write` traps the
+ *    death hook can still release the lock; a raw `a_cas` here would leave an
+ *    orphan the sweep cannot see, which is the round-3 defect all over again.
+ *
+ *  - It terminates: `__stdio_write` sets `wpos == wbase` on BOTH its success
+ *    and its failure path, so every pass either drains one FILE or finds none.
+ *
+ *  - Owned-here only, so the shared standard streams are never flushed from a
+ *    worker's exit (that would race main, and main flushes them at
+ *    `__stdio_exit` anyway).
+ *
+ * Called from `__pthread_exit` and NOWHERE else -- in particular NOT from
+ * `__enclave_set_thread_died`, which runs holding `__thread_list_lock`: a
+ * blocking host call under that lock wedges every sibling's `pthread_create`
+ * and `pthread_join` permanently, at zero CPU. It must also run BEFORE
+ * `__wasilibc_set_release_thread_state`, which closes this thread's
+ * descriptors; after it, every write here would be EBADF and the flush would
+ * silently do nothing while looking done.
+ *
+ * Residual, stated rather than hidden: a worker that TRAPS reaches neither this
+ * nor `__stdio_exit`, so its buffered bytes are still lost. That is inherent --
+ * a trapped thread cannot be made to run a host call safely -- and it is the
+ * same residual a trapped thread already has for its descriptors. */
+void __wasilibc_set_flush_owned_files(void)
+{
+	for (;;) {
+		FILE **head = __ofl_lock();
+		FILE *victim = 0;
+		for (FILE *f = *head; f; f = f->next) {
+			if (!__wasilibc_file_owned_here(f)) continue;
+			if (f->wpos == f->wbase) continue;
+			if (ftrylockfile(f) != 0) continue;
+			victim = f;
+			break;
+		}
+		__ofl_unlock();
+		if (!victim) break;
+		victim->write(victim, 0, 0);
+		funlockfile(victim);
+	}
+
+	/* Now HAND THEM BACK. Namespaces are monotonic and never reused, so once
+	 * this thread is gone no thread can ever satisfy `__wasilibc_file_mine`
+	 * for a FILE it owned: `fclose` would be refused forever, `fflush(NULL)`
+	 * and `__stdio_exit` would skip it, and `__ofl` would grow without bound
+	 * with no API by which the guest could reclaim it. Measured at 1,212 bytes
+	 * per thread creation -- a regression against both the previous revision
+	 * and native, introduced by the (correct) `fclose` ownership check.
+	 *
+	 * HONEST LIMIT, because the previous comment here asserted otherwise:
+	 * the flush loop above SKIPS any FILE another thread holds `flockfile`d
+	 * (the try-lock is load-bearing -- a blocking acquire in `__pthread_exit`
+	 * is a new hang axis), and this loop re-stamps unconditionally, dirty or
+	 * not. So a contended FILE is handed back with its bytes still buffered
+	 * and they are then lost: measured, native keeps the worker's 21 bytes and
+	 * every SET build loses all 21, `fclose` returning EOF. Nothing is
+	 * MISDELIVERED -- the dead tagged fd fails EBADF on every live thread, so
+	 * no stray bytes reach another stream -- so this is loss, not leak. The
+	 * previous wording, "the bytes were already drained by the loop above",
+	 * was simply false.
+	 *
+	 * Re-stamping SHARED is safe precisely BECAUSE the namespace is dead:
+	 * `f->fd` is a tagged descriptor no live thread can resolve, so
+	 * `fd_to_index` still fails EBADF and every write, read and seek still
+	 * refuses. What it restores is the ability to `fclose` and therefore free
+	 * the object. The bytes were already drained by the loop above.
+	 *
+	 * A thread that TRAPS runs neither the flush nor this, so its FILEs stay
+	 * owned and leak -- the residual already stated for its descriptors. */
+	for (;;) {
+		FILE **head = __ofl_lock();
+		FILE *f;
+		for (f = *head; f; f = f->next)
+			if (__wasilibc_file_owned_here(f)) break;
+		if (f) f->set_ns = __WASILIBC_FILE_SHARED;
+		__ofl_unlock();
+		if (!f) break;
+	}
+}
+#endif
diff --git a/libc-top-half/musl/src/stdio/putc.h b/libc-top-half/musl/src/stdio/putc.h
index 7ef38ca..eb56068 100644
--- a/libc-top-half/musl/src/stdio/putc.h
+++ b/libc-top-half/musl/src/stdio/putc.h
@@ -13,7 +13,28 @@ static int locking_putc(int c, FILE *f)
