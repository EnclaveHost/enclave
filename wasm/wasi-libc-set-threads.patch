+#define SET_FD_SLOT_SHIFT 22
+#define SET_FD_INDEX_MASK ((1 << SET_FD_SLOT_SHIFT) - 1)
+#define SET_FD_MAX_SLOTS 512
+#define SET_FD_UNTAGGED 3
