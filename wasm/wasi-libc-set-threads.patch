+/* Which slots are taken. Ordinary (shared-memory) statics: this is the one
+   piece of descriptor state that MUST be common to all threads. */
+static _Atomic uint64_t set_fd_slots_taken[SET_FD_MAX_SLOTS / 64];
+
+/* This thread's slot, or -1 before it has claimed one. */
+static _Thread_local int set_fd_slot = -1;
