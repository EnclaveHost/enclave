+/* Set by `__wasi_thread_start_C` on every spawned SET thread, so the MAIN
+   thread — the one that never runs it — is the one that gets slot 0. */
+extern _Thread_local int __wasilibc_set_is_worker;
+
+/* Claim this thread's slot, or return -1 if all 512 are in use. Slots are
+   released at thread exit (`__wasilibc_set_release_thread_state`), so the
+   bound is on LIVE threads, which the engine caps far below 512. */
+static int set_fd_slot_claim(void) {
+  if (set_fd_slot >= 0)
+    return set_fd_slot;
+  if (!__wasilibc_set_is_worker) {
+    /* The main thread. Slot 0 is RESERVED for it — never handed to a worker —
+       so its descriptors keep the numbering they would have had without
+       threads at all. */
+    atomic_fetch_or(&set_fd_slots_taken[0], 1);
+    set_fd_slot = 0;
+    return 0;
+  }
+  const int words = (int)(sizeof set_fd_slots_taken / sizeof *set_fd_slots_taken);
+  for (int w = 0; w < words; w++) {
+    uint64_t cur = atomic_load(&set_fd_slots_taken[w]);
+    for (;;) {
+      /* Bit 0 of word 0 is the main thread's; mask it out of the candidates. */
+      uint64_t avail = ~(w == 0 ? (cur | 1) : cur);
+      if (avail == 0)
+        break;
+      int b = __builtin_ctzll(avail);
+      uint64_t want = cur | ((uint64_t)1 << b);
+      if (atomic_compare_exchange_weak(&set_fd_slots_taken[w], &cur, want)) {
+        set_fd_slot = w * 64 + b;
+        return set_fd_slot;
+      }
+      /* `cur` was refreshed by the failed exchange; retry this word. */
+    }
+  }
+  return -1;
+}
+
+static void set_fd_slot_release(void) {
+  if (set_fd_slot < 0)
+    return;
+  int w = set_fd_slot / 64;
+  uint64_t bit = (uint64_t)1 << (set_fd_slot % 64);
+  atomic_fetch_and(&set_fd_slots_taken[w], ~bit);
+  set_fd_slot = -1;
+}
+
+/* fd -> table index for THIS thread, or -1 with EBADF if the fd names another
+   thread's namespace (or none at all). */
+static int fd_to_index(int fd) {
+  if (fd < 0) {
+    errno = EBADF;
+    return -1;
+  }
+  if (fd < SET_FD_UNTAGGED)
+    return fd;
+  int slot = fd >> SET_FD_SLOT_SHIFT;
+  if (slot != set_fd_slot_claim()) {
+    /* Either another thread's descriptor or, if this thread could not claim a
+       slot at all, nothing this thread can name. Fail; never alias. */
+    errno = EBADF;
+    return -1;
+  }
+  return fd & SET_FD_INDEX_MASK;
+}
+
+/* table index -> the fd this thread hands to the program. */
+static int index_to_fd(size_t index) {
+  if (index < SET_FD_UNTAGGED)
+    return (int)index;
+  int slot = set_fd_slot_claim();
+  if (slot < 0) {
+    errno = EMFILE;
+    return -1;
+  }
+  if (index > SET_FD_INDEX_MASK) {
+    errno = EMFILE;
+    return -1;
+  }
+  return (slot << SET_FD_SLOT_SHIFT) | (int)index;
+}
+#define SET_DUP_UNTAGGED_LIMIT (1 << SET_FD_SLOT_SHIFT)
+#else
+#define fd_to_index(fd) (fd)
+#define index_to_fd(index) ((int)(index))
+#define SET_DUP_UNTAGGED_LIMIT MAX_DESCRIPTOR
+#endif
