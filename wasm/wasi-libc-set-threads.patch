+// the wasi-threads (posix) thread model over shared linear memory; spawning
+// goes through the componentizer-patched table slot (see
+// musl/src/thread/set-threads/set_spawn.c).
+#cmakedefine __wasilibc_set_threads__
+
 #cmakedefine __wasi_sdk_major__ @__wasi_sdk_major__@
 #cmakedefine __wasi_sdk_version__ "@__wasi_sdk_version__@"
 
