 #ifdef __wasilibc_unmodified_upstream
 	__block_app_sigs(&set);
 #endif
@@ -267,9 +298,150 @@ struct start_args {
 	void *tls_base;
 	void *(*start_func)(void *);
 	void *start_arg;
+#ifdef __wasilibc_set_threads__
+	/*
+	 * enclave/SET: the spawn builtin's start ABI carries only one i32, so
+	 * the tid cannot be delivered as a host argument the way wasi-threads
+	 * delivers it. It is assigned in __pthread_create BEFORE spawning and
+	 * read by wasi_set_thread_start (offset hardcoded there, like "stack"
