+++ b/libc-top-half/musl/src/thread/wasi-threads/pthread_create.c
@@ -16,6 +16,37 @@
 #include <assert.h>
 #include <wasi/api.h>
 
+#ifdef __wasilibc_set_threads__
+/* enclave/SET: spawn is not a host import — it is provided by
