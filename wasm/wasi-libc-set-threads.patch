diff --git a/libc-top-half/musl/src/thread/set-threads/set_spawn.c b/libc-top-half/musl/src/thread/set-threads/set_spawn.c
new file mode 100644
index 0000000..d57ac1b
--- /dev/null
+++ b/libc-top-half/musl/src/thread/set-threads/set_spawn.c
@@ -0,0 +1,91 @@
+/* enclave/SET: thread spawning for shared-everything threads.
+ *
+ * wasi-threads spawns via a host import (`wasi.thread-spawn`). Under the
+ * component model there is no such import — spawning is the
+ * `thread.spawn-indirect` canonical builtin, and no linker today can wire a
+ * canonical builtin into a core module's import. So the libc calls spawn
+ * through a VOLATILE function pointer that initially targets an honest
+ * in-module stub returning -1 ("spawn failed": pthread_create reports EAGAIN
+ * and the program takes its single-threaded fallback).
+ *
+ * The enclave componentizer (`set-componentize`) then appends a fixup core
+ * module to the linked component which
+ *
+ *   1. calls the exported `__enclave_set_spawn_slot` / `__enclave_set_ap_slot`
+ *      getters — each returns the TABLE SLOT its stub occupies (a wasm C
+ *      function pointer IS its `__indirect_function_table` index), and
+ *   2. `table.set`s the real canonical builtins into those very slots.
+ *
+ * After that the same volatile-fp call reaches the engine's spawn. The
+ * pointer VALUE never changes — only the table slot's contents do. `volatile`
+ * exists so LTO cannot prove "never reassigned" and devirtualize the call
+ * back into the stub.
+ *
+ * A SET execution view rebuilds its tables from the module's own element
+ * segments, so on a SPAWNED thread the slot holds the stub again: a nested
+ * pthread_create fails cleanly with EAGAIN instead of trapping the worker.
+ * That is the intended semantic, not an accident.
+ */
+
+#include <stdint.h>
+#include <stddef.h>
+
+#include "pthread_impl.h"
+
+void wasi_set_thread_start(void *);
+
+static int __set_spawn_stub(uintptr_t slot, void *arg)
+{
+	(void)slot;
+	(void)arg;
+	return -1;
+}
+
+static int __set_ap_stub(void)
+{
+	return -1;
+}
+
+int (*volatile __enclave_set_spawn_fp)(uintptr_t, void *) = __set_spawn_stub;
+int (*volatile __enclave_set_ap_fp)(void) = __set_ap_stub;
+
+__attribute__((export_name("__enclave_set_spawn_slot")))
+uintptr_t __enclave_set_spawn_slot(void)
+{
+	return (uintptr_t)(void *)__enclave_set_spawn_fp;
+}
+
+__attribute__((export_name("__enclave_set_ap_slot")))
+uintptr_t __enclave_set_ap_slot(void)
+{
+	return (uintptr_t)(void *)__enclave_set_ap_fp;
+}
+
+int __wasi_thread_spawn(void *start_arg)
+{
+	return __enclave_set_spawn_fp((uintptr_t)(void *)&wasi_set_thread_start,
+	                              start_arg);
+}
+
+/* Libc-assigned TIDs. wasi-threads tids come from the HOST (range
+ * 1..0x1FFFFFFF; the main thread uses 0x3fffffff; 0 means "unlocked" to
+ * tid-based locks, and __lockfile needs the top two bits clear). A SET spawn
+ * returns the engine's thread id only to the PARENT, after the child may
+ * already be running — the child needs its tid immediately. So tids are
+ * assigned HERE, before spawn, and ride to the child in start_args; the
+ * engine's id is used only as a success/failure signal. Same numeric
+ * contract as the host range. */
+hidden int __wasilibc_set_next_tid(void)
+{
+	static volatile int next = 0;
+	return 1 + (a_fetch_add((int *)&next, 1) & 0x0FFFFFFF);
+}
+
+/* Engine-answered `thread.available_parallelism`, sized to the tenant's
+ * purchased share (ENCLAVE_AVAILABLE_PARALLELISM), through the same
+ * fixup-slot mechanism as spawn. Fallback: 1. */
+hidden int __wasilibc_set_available_parallelism(void)
+{
+	int n = __enclave_set_ap_fp();
+	return n > 0 ? n : 1;
+}
diff --git a/libc-top-half/musl/src/thread/set-threads/wasi_set_thread_start.s b/libc-top-half/musl/src/thread/set-threads/wasi_set_thread_start.s
new file mode 100644
index 0000000..9edf5bd
--- /dev/null
+++ b/libc-top-half/musl/src/thread/set-threads/wasi_set_thread_start.s
@@ -0,0 +1,65 @@
+# enclave/SET thread entry.
+#
+# wasi-threads' `wasi_thread_start` is an EXPORT the host invokes with
+# `(tid, start_arg)`. A SET (shared-everything-threads) thread instead enters
+# through the engine's `thread.spawn-indirect` canonical builtin, whose start
+# ABI is a single i32 context argument — so the tid cannot come from the host.
+# It is assigned by the libc BEFORE spawning (see pthread_create.c) and rides
+# to the child inside the start_args block, at offset 16.
+#
+# Everything else matches wasi_thread_start.s: set up the stack pointer and
+# TLS base from start_args (this must be assembly — no C can run before the
+# stack pointer is valid, and in a fresh execution view `__stack_pointer`
+# still holds the module's initial value, i.e. the MAIN thread's stack), call
+# the C continuation, then release the thread list lock exactly as
+# CLONE_CHILD_CLEARTID would (safe only here in asm, after the C stack and
+# pthread_t are no longer in use — a joiner may free them the moment the lock
+# clears).
+
+	.text
+
+	.globaltype	__stack_pointer, i32
+	.globaltype	__tls_base, i32
+	.functype	__wasi_thread_start_C (i32, i32) -> ()
+
+	.hidden	wasi_set_thread_start
+	.globl	wasi_set_thread_start
+	.type	wasi_set_thread_start,@function
+
+wasi_set_thread_start:
+	.functype	wasi_set_thread_start (i32) -> ()
+
+	# Set up the minimum C environment.
+	# Note: offsetof(start_args, stack) == 0
+	local.get   0  # start_arg
+	i32.load    0  # stack
+	global.set  __stack_pointer
+
+	local.get   0  # start_arg
+	i32.load    4  # tls_base
+	global.set  __tls_base
+
+	# Make the C function do the rest of work.
+	local.get   0  # start_arg
+	i32.load    16 # tid (libc-assigned; see pthread_create.c)
+	local.get   0  # start_arg
+	call __wasi_thread_start_C
+
+	# Unlock thread list. (as CLONE_CHILD_CLEARTID would do for Linux)
+	#
+	# Note: once we unlock the thread list, our "map_base" can be freed
+	# by a joining thread. It's safe as we are in ASM and no longer use
+	# our C stack or pthread_t. It's impossible to do this safely in C
+	# because there is no way to tell the C compiler not to use C stack.
+	i32.const   __thread_list_lock
+	i32.const   0
+	i32.atomic.store 0
+	# As an optimization, we can check tl_lock_waiters here.
+	# But for now, simply wake up unconditionally as
+	# CLONE_CHILD_CLEARTID does.
+	i32.const   __thread_list_lock
+	i32.const   1
+	memory.atomic.notify 0
+	drop
+
+	end_function
diff --git a/libc-top-half/musl/src/thread/wasi-threads/pthread_create.c b/libc-top-half/musl/src/thread/wasi-threads/pthread_create.c
index f6ff846..6a852c7 100644
--- a/libc-top-half/musl/src/thread/wasi-threads/pthread_create.c
+++ b/libc-top-half/musl/src/thread/wasi-threads/pthread_create.c
@@ -16,6 +16,14 @@
 #include <assert.h>
 #include <wasi/api.h>
 
+#ifdef __wasilibc_set_threads__
+/* enclave/SET: spawn is not a host import — it is provided by
+ * musl/src/thread/set-threads/set_spawn.c, along with the libc-side tid
+ * allocator (the SET spawn ABI cannot deliver a host tid to the child). */
+int __wasi_thread_spawn(void *start_arg);
+hidden int __wasilibc_set_next_tid(void);
+#endif
+
 static void dummy_0()
 {
 }
@@ -73,6 +81,103 @@ static void process_map_base_deferred_free()
 }
 #endif
 
+#ifdef __wasilibc_set_threads__
+/* enclave/SET: engine-called epilogue for a thread that died by TRAP.
+ *
+ * `__pthread_exit` and the tail of `wasi_set_thread_start` run only when a
+ * thread RETURNS. A thread that traps skips both, so it never stores
+ * DT_EXITED, never wakes its joiner, and never releases __thread_list_lock —
+ * whose value is its own tid. Every joiner then blocks forever: first in
+ * __timedwait_cp on detach_state, and if that were fixed, again in __tl_sync
+ * on the thread list lock. In practice that hangs the whole program, because
+ * the main thread is usually the one in pthread_join.
+ *
+ * The engine calls this export on the dying thread's own execution view after
+ * the trap has unwound, so `__pthread_self()` here IS the dead thread. It does
+ * the parts of the normal epilogue that other threads depend on, and skips the
+ * parts that only the dying thread itself would have observed.
+ *
+ * Deliberately NOT done, and why:
+ *  - cancel buffers and TSD destructors: arbitrary guest code, on a thread
+ *    whose invariants we already know are broken. Running it could trap again.
+ *  - killlock: the normal path takes it and releases it. We do not know
+ *    whether the trap happened while it was held, and unlocking a lock we do
+ *    not hold is worse than leaving it. A concurrent pthread_kill against a
+ *    trapped thread may therefore block; it is a far narrower residual than
+ *    hanging every join.
+ *  - the `self->next == self` last-thread `exit(0)`: a trapped last thread
+ *    must not run atexit handlers.
+ *
+ * The argument is the same `start_args` pointer the entry point received. It
+ * is unused today (the thread's identity comes from TLS, which the view still
+ * has) and is passed for symmetry and future use.
+ */
+__attribute__((export_name("__enclave_set_thread_died")))
+void __enclave_set_thread_died(void *start_arg)
+{
+	(void)start_arg;
+	pthread_t self = __pthread_self();
+
+	/* Give joiners a defined result rather than whatever the trap left. */
+	self->result = PTHREAD_CANCELED;
+	self->canceldisable = 1;
+	self->cancelasync = 0;
+
+	int state = a_cas(&self->detach_state, DT_JOINABLE, DT_EXITING);
+	if (state == DT_EXITED)
+		return; /* already reaped; nothing to do */
+
+	/* If the trap happened while this thread held the thread list lock,
+	 * take ownership of it back so the unlock below actually releases it.
+	 * __tl_lock() itself would recurse (the lock word holds our tid) and
+	 * bump tl_lock_count, so force the count flat instead. */
+	if (__thread_list_lock == self->tid) {
+		tl_lock_count = 0;
+	} else {
+		__tl_lock();
+		tl_lock_count = 0;
+	}
+
+	/* Mark this thread's robust mutexes owner-died and wake their waiters,
+	 * or every sibling blocked on one stays blocked. */
+	volatile void *volatile *rp;
+	while ((rp = self->robust_list.head) && rp != &self->robust_list.head) {
+		pthread_mutex_t *m = (void *)((char *)rp
+			- offsetof(pthread_mutex_t, _m_next));
+		int waiters = m->_m_waiters;
+		int priv = (m->_m_type & 128) ^ 128;
+		self->robust_list.pending = rp;
+		self->robust_list.head = *rp;
+		int cont = a_swap(&m->_m_lock, 0x40000000);
+		self->robust_list.pending = 0;
+		if (cont < 0 || waiters)
+			__wake(&m->_m_lock, 1, priv);
+	}
+
+	__do_orphaned_stdio_locks();
+
+	self->tid = 0;
+	if (!--libc.threads_minus_1) libc.need_locks = -1;
+	self->next->prev = self->prev;
+	self->prev->next = self->next;
+	self->prev = self->next = self;
+
+	if (state == DT_DETACHED && self->map_base) {
+		/* Nobody will join, so nobody will free the stack. Defer it the
+		 * same way the normal detached path does. */
+		process_map_base_deferred_free();
+		map_base_deferred_free = self->map_base;
+	} else {
+		/* Release the joiner: it waits for detach_state to reach
+		 * DT_EXITED (0), then for the thread list lock to reach 0. */
+		a_store(&self->detach_state, DT_EXITED);
+		__wake(&self->detach_state, 1, 1);
+	}
+
+	__tl_unlock();
+}
+#endif
+
 #ifdef __wasilibc_unmodified_upstream
