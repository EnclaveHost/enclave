+pub async fn default_send_request(
+    req: Request<impl Body<Data = Bytes, Error = Error> + Send + 'static>,
+    options: Option<RequestOptions>,
+) -> Result<(Response<WireBody>, WireDriver), Error> {
+    use http_body_util::BodyExt;
+    if std::env::var("ENCLAVE_HTTP_POOL").as_deref() == Ok("1") {
+        let response = pool::send(req.map(BodyExt::boxed_unsync), options).await?;
+        return Ok((response, Box::pin(async { Ok(()) })));
+    }
+    let (response, driver) = send_unpooled(req, options).await?;
+    Ok((response.map(BodyExt::boxed_unsync), Box::pin(driver)))
