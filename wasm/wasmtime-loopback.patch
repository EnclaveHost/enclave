+// ---- in-CVM loopback policy ------------------------------------------------
+//
+// The carve-out above (a literal loopback IP dials DIRECT) is what keeps the
+// enclave's own loopback planes reachable — /encvol behind ENCLAVE_ENC_API, and
+// the SOCKS front itself for a phase-1 guest. But EVERY TENANT ON THE BOX
+// listens on that same loopback: one wasmtime process per deployment, each
+// bound to 127.0.0.1:<its port> in ONE shared network namespace. So an
+// unqualified carve-out lets a guest dial a SIBLING TENANT's port and land
+// inside its app — around the supervisor's /x/:id, which is where a PRIVATE
+// deployment's owner-token check and the deployer's WAF live. Nothing at the
+// services can close that: another tenant's app is not the platform's to gate.
+//
+// `-S loopback-allow=<port[+port...]>` names the loopback ports this process
+// may dial: its own listeners, the manager's control port, the egress front.
+// Everything else on loopback is refused here, at the only place that sees the
+// dial. Unset keeps the previous behaviour (any loopback port) so a
+// hand-launched wasmtime — the manager's own probe processes — is unchanged;
+// the launcher is what makes the policy universal, and wasm_manager.py passes
+// the flag on every tenant launch.
+static LOOPBACK_ALLOW: OnceLock<Option<Vec<u16>>> = OnceLock::new();
+
+/// Install the loopback policy from the `-S loopback-allow=` value. Idempotent
+/// (first call wins, like `init`). An empty list is meaningful and strict: it
+/// means NO loopback destination at all.
+pub fn set_loopback_allow(spec: &str) -> Result<(), String> {
+    let mut ports = Vec::new();
+    // '+' is the CLI separator: wasmtime's `-S` splits its argument on commas
+    // itself, so a comma-joined list loses everything after the first port to
+    // an "unknown -S option" error. ',' stays accepted for callers that are
+    // not the command line (tests, embedders), where it cannot do harm.
+    for part in spec.split(['+', ',']) {
+        let part = part.trim();
+        if part.is_empty() {
+            continue;
+        }
+        let port: u16 = part
+            .parse()
+            .map_err(|_| format!("-S loopback-allow expects ports, got `{part}`"))?;
+        if port == 0 {
+            return Err("-S loopback-allow: port 0 is not a destination".to_string());
+        }
+        ports.push(port);
+    }
+    let _ = LOOPBACK_ALLOW.set(Some(ports));
+    Ok(())
+}
+
+/// May this process dial `port` on loopback? True when no policy was installed.
+pub fn loopback_allowed(port: u16) -> bool {
+    match LOOPBACK_ALLOW.get() {
+        Some(Some(ports)) => ports.contains(&port),
+        _ => true,
+    }
+}
+
+/// True once a policy has been installed (the CLI uses this to decide whether
+/// a socket-address check is needed even with egress off).
+pub fn loopback_policy_set() -> bool {
+    matches!(LOOPBACK_ALLOW.get(), Some(Some(_)))
+}
+
+/// Dial `authority` (`host:port`) DIRECTLY, applying the loopback policy.
+///
+/// The `wasi:http` outbound path does not go through the socket-address check
+/// (it is a different context), so with transparent egress OFF a serve-mode app
+/// could reach any loopback port over HTTP even when a policy is set. This is
+/// that path's enforcement point. It resolves first and judges the RESOLVED
+/// addresses, so a NAME that points at loopback is refused too - the case a
+/// literal-only check would miss.
+pub async fn connect_direct(authority: &str) -> io::Result<TcpStream> {
+    if !loopback_policy_set() {
+        return TcpStream::connect(authority).await;
+    }
+    let mut last: Option<io::Error> = None;
+    for addr in tokio::net::lookup_host(authority).await? {
+        if addr.ip().is_loopback() && !loopback_allowed(addr.port()) {
+            last = Some(loopback_refused(addr.port()));
+            continue;
+        }
+        match TcpStream::connect(addr).await {
+            Ok(s) => return Ok(s),
+            Err(e) => last = Some(e),
+        }
+    }
+    Err(last.unwrap_or_else(|| {
+        io::Error::new(io::ErrorKind::AddrNotAvailable, "no address for authority")
+    }))
+}
+
+/// The refusal a blocked loopback dial produces. Named so both call sites and
+/// the socket-address check read the same way in a tenant's log.
+pub fn loopback_refused(port: u16) -> io::Error {
+    io::Error::new(
+        io::ErrorKind::PermissionDenied,
+        format!(
+            "loopback port {port} is not this deployment's to dial \
+             (in-CVM loopback is the enclave's service plane, not a tenant network; \
+             reach other apps at their public address)"
+        ),
+    )
+}
