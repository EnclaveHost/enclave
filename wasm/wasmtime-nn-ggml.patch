+/// One decode request from one sequence, queued for the next merged batch.
+struct PendingItem {
+    ticket: u64,
+    seq_id: i32,
+    pos0: i32,
+    tokens: Vec<i32>,
+}
+
+struct DecodeQueue {
+    next_ticket: u64,
+    pending: VecDeque<PendingItem>,
+    results: HashMap<u64, Result<Vec<f32>, String>>,
+    /// a leader is inside ell_decode_batch — exactly one at a time, and
+    /// seq removal (Drop) must also wait on this
+    decoding: bool,
+}
+
+/// The shared serving context for one graph: one llama context whose unified
+/// KV pool holds every concurrent sequence. All shim calls on `raw` are
+/// serialized by the leader protocol (submit) + the `decoding` flag (Drop);
+/// the shim itself adds no locking.
+struct GgmlServer {
+    raw: *mut c_void,
+    model: Arc<GgmlModel>,
+    n_batch: u32,
+    n_seq_max: u32,
+    n_vocab: usize,
+    slots: Mutex<Vec<i32>>,
+    q: Mutex<DecodeQueue>,
+    cv: Condvar,
+    /// context geometry kept for the lazily created MTP head context (it
+    /// mirrors the server's window/quantization so both price the same way)
+    n_ctx: u32,
+    type_k: i32,
+    type_v: i32,
+    flash_attn: i32,
+    /// the MTP head driver (shim-owned): created on FIRST mtp-flavored call,
+    /// under the decode turn so enabling nextn output on the target cannot
+    /// race a decode. None + model.mtp=false => the verbs error and guests
+    /// fall back to plain decode. Head decodes serialize on THIS lock and
+    /// deliberately do NOT take the decode turn — a tiny head step may
+    /// overlap another stream's trunk decode on the GPU.
+    mtp: Mutex<Option<MtpHandle>>,
+    /// the vision projector (shim-owned), created on the FIRST image and kept
+    /// for the graph's lifetime. Deferred because the encoder's weights and
+    /// compute buffers cost VRAM that a text-only deployment should never pay:
+    /// a chat that never attaches a picture never loads it.
+    mtmd: Mutex<Option<MtmdHandle>>,
+}
+
+struct MtpHandle(*mut c_void);
+unsafe impl Send for MtpHandle {}
+impl Drop for MtpHandle {
+    fn drop(&mut self) {
+        unsafe { ell_mtp_free(self.0) };
+    }
+}
+
+struct MtmdHandle(*mut c_void);
+unsafe impl Send for MtmdHandle {}
+impl Drop for MtmdHandle {
+    fn drop(&mut self) {
+        // resolved when the handle was created, so it exists here
+        if let Some(syms) = mtmd_syms() {
+            unsafe { (syms.free)(self.0) };
+        }
+    }
+}
+unsafe impl Send for GgmlServer {}
+unsafe impl Sync for GgmlServer {}
+impl Drop for GgmlServer {
+    fn drop(&mut self) {
+        unsafe { ell_free_context(self.raw) };
+    }
+}
+
+/// llama_decode rc -> caller-facing message. rc 1 = the pool momentarily
+/// cannot hold the step; llama RESTORES state on it, so it is retryable.
+/// Host-side top-k reduction of a logits row block: the guest sampler only
+/// ever looks at a bounded candidate set (top_k <= 256 in practice), so
+/// shipping the full vocab row (~1MB at 248320 floats) across the wasi-nn
+/// boundary per position - and scanning it in wasm - is pure per-token tax.
+/// An {"topk": K} input beside "tokens" replaces the "logits" output with
+/// "topk_ids" I32 [n,K] + "topk_logits" Fp32 [n,K], each row sorted by
+/// logit descending. Selection runs on the host CPU; K clamps to 16..=1024.
+fn topk_rows(flat: &[f32], rows: usize, vocab: usize, k: usize) -> (Tensor, Tensor) {
+    let k = k.min(vocab);
+    let mut ids_data = Vec::with_capacity(rows * k * 4);
+    let mut val_data = Vec::with_capacity(rows * k * 4);
+    // total-order key: monotone f32 -> u32 bit trick (negatives flipped,
+    // positives offset), so the heap never touches partial_cmp. Selection
+    // runs INSIDE the exclusive decode turn - it must stay O(n log k) with
+    // a one-branch-per-element scan, not an O(n*k) rescan-the-min loop
+    // (the first cut of this function cost MTP rounds ~30ms each).
+    fn fkey(v: f32) -> u32 {
+        let b = v.to_bits();
+        if b & 0x8000_0000 != 0 { !b } else { b | 0x8000_0000 }
+    }
+    for r in 0..rows {
+        let row = &flat[r * vocab..(r + 1) * vocab];
+        let mut heap: std::collections::BinaryHeap<std::cmp::Reverse<(u32, u32)>> =
+            std::collections::BinaryHeap::with_capacity(k + 1);
+        for (i, &v) in row.iter().enumerate() {
+            let kk = fkey(v);
+            if heap.len() < k {
+                heap.push(std::cmp::Reverse((kk, i as u32)));
+            } else if kk > heap.peek().unwrap().0 .0 {
+                *heap.peek_mut().unwrap() = std::cmp::Reverse((kk, i as u32));
+            }
+        }
+        let mut cand: Vec<(u32, u32)> = heap.into_iter().map(|std::cmp::Reverse(p)| p).collect();
+        cand.sort_unstable_by(|a, b| b.0.cmp(&a.0));
+        for (kk, i) in cand {
+            let _ = kk;
+            ids_data.extend_from_slice(&(i as i32).to_le_bytes());
+            val_data.extend_from_slice(&row[i as usize].to_le_bytes());
+        }
+    }
+    (
+        Tensor { dimensions: vec![rows as u32, k as u32], ty: TensorType::I32, data: ids_data },
+        Tensor { dimensions: vec![rows as u32, k as u32], ty: TensorType::Fp32, data: val_data },
+    )
+}
+
+fn decode_err(rc: i32) -> String {
+    if rc == 1 {
+        "[kv_pool_full] the shared KV pool cannot hold this step right now — too many (or too \
+         long) concurrent chats; retry shortly, or redeploy with a larger share"
+            .to_string()
+    } else {
+        format!("llama_decode failed (rc {rc}; context window exhausted?)")
+    }
+}
+
+impl GgmlServer {
+    fn new(model: &Arc<GgmlModel>) -> Result<Arc<GgmlServer>, BackendError> {
+        let n_ctx = env_u32("ENCLAVE_GGML_N_CTX", 8192);
+        let n_batch = env_u32("ENCLAVE_GGML_N_BATCH", 512);
+        let n_seq_max = env_u32("ENCLAVE_GGML_MAX_SESSIONS", 1).max(1);
+        // KV-cache quantization: ENCLAVE_GGML_KV_CACHE_TYPE sets both sides
+        // (f16|q8_0|q4_0|f32); ..._K / ..._V override per side. A quantized KV
+        // cache roughly halves (q8_0) or quarters (q4_0) the up-front VRAM the
+        // pool costs. Default f16 = unchanged behavior.
+        let kv_both = std::env::var("ENCLAVE_GGML_KV_CACHE_TYPE").unwrap_or_default();
+        let type_k = kv_type_code(
+            &std::env::var("ENCLAVE_GGML_KV_CACHE_TYPE_K").unwrap_or_else(|_| kv_both.clone()),
+        );
+        let type_v = kv_type_code(
+            &std::env::var("ENCLAVE_GGML_KV_CACHE_TYPE_V").unwrap_or_else(|_| kv_both.clone()),
+        );
+        // A quantized V cache is only valid with Flash Attention; if one was
+        // asked for but FA left on auto, force it on so llama.cpp doesn't abort
+        // context creation. Explicit ENCLAVE_GGML_FLASH_ATTN=off is honored
+        // (and will then fail loudly, which is the intended signal).
+        let mut flash_attn =
+            flash_attn_code(&std::env::var("ENCLAVE_GGML_FLASH_ATTN").unwrap_or_default());
+        if matches!(type_v, 1 | 2) && flash_attn == 0 {
+            flash_attn = 2;
+        }
+        let raw = unsafe {
+            ell_new_server(model.raw, n_ctx, n_batch, n_seq_max, type_k, type_v, flash_attn)
+        };
+        if raw.is_null() {
+            return Err(err(
+                "llama.cpp context allocation failed — the n_ctx KV pool does not fit the \
+                 share's free VRAM (lower ENCLAVE_GGML_N_CTX or buy a larger share)",
+            ));
+        }
+        Ok(Arc::new(GgmlServer {
+            raw,
+            model: model.clone(),
+            n_batch,
+            n_seq_max,
+            n_vocab: model.n_vocab as usize,
+            slots: Mutex::new((0..n_seq_max as i32).collect()),
+            q: Mutex::new(DecodeQueue {
+                next_ticket: 0,
+                pending: VecDeque::new(),
+                results: HashMap::new(),
+                decoding: false,
+            }),
+            cv: Condvar::new(),
+            n_ctx,
+            type_k,
+            type_v,
+            flash_attn,
+            mtp: Mutex::new(None),
+            mtmd: Mutex::new(None),
+        }))
+    }
+
+    /// Decode `tokens` as the next step of `seq_id` (whose first new token
+    /// sits at position `pos0`) and return the last token's logits row.
+    /// Concurrent callers MERGE: whoever finds the queue idle becomes the
+    /// leader, drains everything that fits one llama batch, runs the single
+    /// FFI decode, posts every item's result, and wakes the rest —
+    /// continuous batching by natural queueing, no artificial delay window
+    /// (requests that arrive while a batch is on the GPU merge into the
+    /// next one).
+    fn submit(&self, seq_id: i32, pos0: i32, tokens: Vec<i32>) -> Result<Vec<f32>, String> {
+        if tokens.is_empty() {
+            return Err("empty token batch".into());
+        }
+        if tokens.len() > self.n_batch as usize {
+            return Err(format!(
+                "batch of {} tokens exceeds n_batch {} (chunk your prefill)",
+                tokens.len(),
+                self.n_batch
+            ));
+        }
+        let ticket = {
+            let mut q = self.q.lock().unwrap();
+            let t = q.next_ticket;
+            q.next_ticket += 1;
+            q.pending.push_back(PendingItem { ticket: t, seq_id, pos0, tokens });
+            t
+        };
+        let mut q = self.q.lock().unwrap();
+        loop {
+            if let Some(r) = q.results.remove(&ticket) {
+                return r;
+            }
+            if !q.decoding && !q.pending.is_empty() {
+                // become the leader: take from the front while it fits the
+                // batch, one item per sequence (positions within one call
+                // are per-item contiguous)
+                let mut items: Vec<PendingItem> = Vec::new();
+                let mut total = 0usize;
+                while let Some(it) = q.pending.front() {
+                    if total + it.tokens.len() > self.n_batch as usize && !items.is_empty() {
+                        break;
+                    }
+                    if items.iter().any(|p| p.seq_id == it.seq_id) {
+                        break;
+                    }
+                    let it = q.pending.pop_front().unwrap();
+                    total += it.tokens.len();
+                    items.push(it);
+                }
+                q.decoding = true;
+                drop(q);
+                let results = self.decode_items(&items);
+                q = self.q.lock().unwrap();
+                for (it, res) in items.into_iter().zip(results) {
+                    q.results.insert(it.ticket, res);
+                }
+                q.decoding = false;
+                self.cv.notify_all();
+                continue; // our own result may be among them
+            }
+            q = self.cv.wait(q).unwrap();
+        }
+    }
+
+    /// One merged decode over `items` (results in item order). On a
+    /// pool-full rc 1 with several items, fall back to per-item decodes so
+    /// one over-long request cannot fail its batchmates (llama restores
+    /// state on rc 1, so the retry is sound).
+    fn decode_items(&self, items: &[PendingItem]) -> Vec<Result<Vec<f32>, String>> {
+        match self.decode_raw(items) {
+            Ok(rows) => rows.into_iter().map(Ok).collect(),
+            Err(1) if items.len() > 1 => items
+                .iter()
+                .map(|it| match self.decode_raw(std::slice::from_ref(it)) {
+                    Ok(mut rows) => Ok(rows.pop().expect("one row per item")),
+                    Err(rc) => Err(decode_err(rc)),
+                })
+                .collect(),
+            Err(rc) => items.iter().map(|_| Err(decode_err(rc))).collect(),
+        }
+    }
+
+    /// EXCLUSIVE decode of one sequence with logits for EVERY position (the
+    /// speculative verify step: the target consumes the draft's tokens in one
+    /// pass and hands back each position's distribution). Takes the decode
+    /// turn like a leader, but alone - full-logits rows don't merge with
+    /// last-row batchmates.
+    ///
+    /// `mtp_for`: harvest the pass's per-position MTP hidden rows for that
+    /// sequence's head state, INSIDE the decode turn (a later decode would
+    /// overwrite them). The MTP head context is created on the first such
+    /// call — also inside the turn, because creation enables nextn output on
+    /// the target and must precede the decode being harvested.
+    fn submit_full(
+        &self,
+        seq_id: i32,
+        pos0: i32,
+        tokens: &[i32],
+        mtp_for: Option<i32>,
+    ) -> Result<Vec<f32>, String> {
+        if tokens.is_empty() {
+            return Err("empty token batch".into());
+        }
+        if tokens.len() > self.n_batch as usize {
+            return Err(format!(
+                "batch of {} tokens exceeds n_batch {} (chunk your prefill)",
+                tokens.len(),
+                self.n_batch
+            ));
+        }
+        let mut q = self.q.lock().unwrap();
+        while q.decoding {
+            q = self.cv.wait(q).unwrap();
+        }
+        q.decoding = true;
+        drop(q);
+        let mut harvest_err = None;
+        if let Some(ms) = mtp_for {
+            if let Err(e) = self.ensure_mtp() {
+                harvest_err = Some(e);
+            } else {
+                let _ = ms; // harvested after the decode below
+            }
+        }
+        let mut logits = vec![0f32; tokens.len() * self.n_vocab];
+        let rc = if harvest_err.is_none() {
+            unsafe {
+                ell_decode_seq_full(self.raw, self.model.raw, seq_id, pos0,
+                                    tokens.as_ptr(), tokens.len() as i32, logits.as_mut_ptr())
+            }
+        } else {
+            0
+        };
+        if rc == 0 && harvest_err.is_none() {
+            if let Some(ms) = mtp_for {
+                let mtp = self.mtp.lock().unwrap();
+                if let Some(h) = mtp.as_ref() {
+                    unsafe { ell_mtp_harvest(h.0, self.raw, ms, tokens.len() as i32) };
+                }
+            }
+        }
+        let mut q = self.q.lock().unwrap();
+        q.decoding = false;
+        self.cv.notify_all();
+        drop(q);
+        if let Some(e) = harvest_err {
+            return Err(e);
+        }
+        if rc != 0 {
+            return Err(decode_err(rc));
+        }
+        Ok(logits)
+    }
+
+    /// Create the MTP head context if it does not exist yet. Caller holds the
+    /// decode turn (creation flips the target's nextn-output flag).
+    fn ensure_mtp(&self) -> Result<(), String> {
+        let mut mtp = self.mtp.lock().unwrap();
+        if mtp.is_some() {
+            return Ok(());
+        }
+        if !self.model.mtp {
+            return Err("[mtp_unavailable] this model has no MTP head".into());
+        }
+        let raw = unsafe {
+            ell_mtp_new(self.model.raw, self.raw, self.n_ctx, self.n_batch,
+                        self.n_seq_max, self.type_k, self.type_v, self.flash_attn)
+        };
+        if raw.is_null() {
+            return Err(
+                "[mtp_unavailable] MTP head context creation failed (VRAM, or a \
+                 toolchain predating the MTP shim)"
+                    .to_string(),
+            );
+        }
+        *mtp = Some(MtpHandle(raw));
+        Ok(())
+    }
+
+    /// Encode one image into `seq_id` at `pos0` and return the POSITIONS it
+    /// consumed (M-RoPE numbers an image's positions by its grid, not by its
+    /// token count, so only libmtmd can say). Takes the decode turn
+    /// EXCLUSIVELY: the shim drives llama_decode itself here and, on models
+    /// that want it, flips the causal mask off and back around the image, so
+    /// nothing else may be decoding on this context meanwhile.
+    fn eval_image(&self, seq_id: i32, pos0: i32, bytes: &[u8]) -> Result<i32, String> {
+        if bytes.is_empty() {
+            return Err("empty image".into());
+        }
+        if bytes.len() > u32::MAX as usize {
+            return Err("image too large".into());
+        }
+        let syms = mtmd_syms().ok_or(
+            "[vision_unavailable] this node's llama.cpp toolchain predates the vision \
+             entry points (no libmtmd in the shim)",
+        )?;
+        let mut q = self.q.lock().unwrap();
+        while q.decoding {
+            q = self.cv.wait(q).unwrap();
+        }
+        q.decoding = true;
+        drop(q);
+        let mut n_pos = 0i32;
+        let outcome = match self.ensure_mtmd() {
+            Err(e) => Err(e),
+            Ok(handle) => {
+                let rc = unsafe {
+                    (syms.eval_image)(
+                        handle,
+                        self.raw,
+                        seq_id,
+                        pos0,
+                        bytes.as_ptr(),
+                        bytes.len() as u32,
+                        self.n_batch as i32,
+                        &mut n_pos,
+                    )
+                };
+                match rc {
+                    0 if n_pos > 0 => Ok(n_pos),
+                    0 => Err("the projector consumed no positions for this image".to_string()),
+                    1 => Err(decode_err(1)),
+                    2 => Err("[image_undecodable] not a readable image (png, jpeg, webp, \
+                              gif and bmp are what the encoder reads)"
+                        .to_string()),
+                    3 => Err(
+                        "[image_too_wide] this model decodes images with a non-causal mask, \
+                         which needs the whole image in one physical batch - raise \
+                         ENCLAVE_GGML_N_UBATCH on this node (or send a smaller image)"
+                            .to_string(),
+                    ),
+                    other => Err(format!("image encode failed (rc {other})")),
+                }
+            }
+        };
+        let mut q = self.q.lock().unwrap();
+        q.decoding = false;
+        self.cv.notify_all();
+        drop(q);
+        outcome
+    }
+
+    /// Load the vision projector if it is not loaded yet, returning its
+    /// handle. Caller holds the decode turn (the load allocates on the same
+    /// device the decode is about to use).
+    fn ensure_mtmd(&self) -> Result<*mut c_void, String> {
+        let mut m = self.mtmd.lock().unwrap();
+        if let Some(h) = m.as_ref() {
+            return Ok(h.0);
+        }
+        let syms = mtmd_syms().ok_or("[vision_unavailable] no libmtmd in this shim")?;
+        let path = self.model.mmproj.as_ref().ok_or(
+            "[vision_unavailable] this model volume carries no vision projector \
+             (add an *mmproj*.gguf beside the model)",
+        )?;
+        // 4 CPU threads is llama.cpp's own default for the preprocessing side;
+        // the encode itself rides the GPU whenever the model did.
+        let threads = env_i32("ENCLAVE_GGML_MTMD_THREADS", 4);
+        let max_tokens = env_i32("ENCLAVE_GGML_IMAGE_MAX_TOKENS", 0);
+        let raw = unsafe {
+            (syms.new)(
+                self.model.raw,
+                path.as_ptr(),
+                threads,
+                self.model.gpu as i32,
+                max_tokens,
+            )
+        };
+        if raw.is_null() {
+            return Err(
+                "[vision_unavailable] the vision projector failed to load (VRAM, or an \
+                 mmproj that does not match this model)"
+                    .to_string(),
+            );
+        }
+        *m = Some(MtmdHandle(raw));
+        Ok(raw)
+    }
+
+    /// Mirror a round's ACCEPTED tokens into the head's KV (pairs them with
+    /// the harvested hidden rows; the boundary row becomes the next draft
+    /// seed). Head-only work: serializes on the mtp lock, not the decode turn.
+    fn mtp_observe(&self, seq: i32, pos0: i32, tokens: &[i32]) -> Result<(), String> {
+        let mtp = self.mtp.lock().unwrap();
+        let h = mtp.as_ref().ok_or("[mtp_unavailable] no MTP state (harvest first)")?;
+        let rc = unsafe {
+            ell_mtp_observe(h.0, seq, pos0, tokens.as_ptr(), tokens.len() as i32)
+        };
+        if rc != 0 {
+            return Err(format!("mtp observe failed (rc {rc}; harvested rows stale?)"));
+        }
+        Ok(())
+    }
+
+    /// Propose up to k tokens from the head (greedy, confidence-gated).
+    fn mtp_draft(&self, seq: i32, id_last: i32, n_past: i32, k: i32, p_min: f32)
+        -> Result<Vec<i32>, String>
+    {
+        let mtp = self.mtp.lock().unwrap();
+        let h = mtp.as_ref().ok_or("[mtp_unavailable] no MTP state (prefill with mtp first)")?;
+        let mut out = vec![0i32; k.max(0) as usize];
+        let n = unsafe { ell_mtp_draft(h.0, seq, id_last, n_past, k, p_min, out.as_mut_ptr()) };
+        out.truncate(n.max(0) as usize);
+        Ok(out)
+    }
+
+    /// Forget one sequence's head state (session teardown; slots get reused).
+    fn mtp_reset(&self, seq: i32) {
+        let mtp = self.mtp.lock().unwrap();
+        if let Some(h) = mtp.as_ref() {
+            unsafe { ell_mtp_reset(h.0, seq) };
+        }
+    }
+
+    /// Drop a sequence's tokens from n_keep onward (a speculative round's
+    /// rejected tail). Holding the queue lock excludes decode leaders, the
+    /// same discipline as seq removal in Drop. Err = the memory REFUSED the
+    /// partial removal (recurrent/hybrid models keep no per-token state
+    /// history; nothing was mutated) — the caller must not decode on as-if
+    /// rewound. Branch-verify (`seq_copy`) is the strategy that needs no
+    /// rewind on any architecture.
+    fn rewind(&self, seq_id: i32, n_keep: i32) -> Result<(), String> {
+        let mut q = self.q.lock().unwrap();
+        while q.decoding {
+            q = self.cv.wait(q).unwrap();
+        }
+        let rc = unsafe { ell_seq_rewind(self.raw, seq_id, n_keep) };
+        drop(q);
+        if rc != 0 {
+            return Err(
+                "[rewind_unsupported] this model keeps recurrent state with no per-token \
+                 history; use branch-verify (copy_from) for speculative rounds"
+                    .to_string(),
+            );
+        }
+        Ok(())
+    }
+
+    /// Make dst an exact branch of src (dst's previous contents dropped).
+    /// Attention KV cells are shared; recurrent state is copy-on-write and
+    /// diverges only when dst next decodes — so branching costs nothing
+    /// until used, on every architecture. Same lock discipline as rewind.
+    fn seq_copy(&self, src_seq: i32, dst_seq: i32) {
+        let mut q = self.q.lock().unwrap();
+        while q.decoding {
+            q = self.cv.wait(q).unwrap();
+        }
+        unsafe { ell_seq_copy(self.raw, src_seq, dst_seq) };
+        drop(q);
+    }
+
+    /// The FFI call itself; Err carries the raw llama_decode rc.
+    fn decode_raw(&self, items: &[PendingItem]) -> Result<Vec<Vec<f32>>, i32> {
+        let n = items.len();
+        let seq_ids: Vec<i32> = items.iter().map(|i| i.seq_id).collect();
+        let counts: Vec<i32> = items.iter().map(|i| i.tokens.len() as i32).collect();
+        let positions: Vec<i32> = items.iter().map(|i| i.pos0).collect();
+        let flat: Vec<i32> = items.iter().flat_map(|i| i.tokens.iter().copied()).collect();
+        let mut logits = vec![0f32; n * self.n_vocab];
+        let rc = unsafe {
+            ell_decode_batch(
+                self.raw,
+                self.model.raw,
+                n as i32,
+                seq_ids.as_ptr(),
+                counts.as_ptr(),
+                positions.as_ptr(),
+                flat.as_ptr(),
+                logits.as_mut_ptr(),
+            )
+        };
+        if rc != 0 {
+            return Err(rc);
+        }
+        Ok(logits.chunks_exact(self.n_vocab).map(|c| c.to_vec()).collect())
+    }
+}
+
+struct GgmlGraph {
+    model: Arc<GgmlModel>,
+    /// the shared server, created on FIRST use (that is when the KV pool
+    /// claims its VRAM) and kept for the graph's lifetime. Creation failure
+    /// is NOT cached — a later request retries (VRAM may have freed).
+    server: Mutex<Option<Arc<GgmlServer>>>,
+}
+unsafe impl Send for GgmlGraph {}
+unsafe impl Sync for GgmlGraph {}
+
+impl BackendGraph for GgmlGraph {
+    fn init_execution_context(&self) -> Result<ExecutionContext, BackendError> {
+        let server = {
+            let mut s = self.server.lock().unwrap();
+            match &*s {
+                Some(srv) => srv.clone(),
+                None => {
+                    let srv = GgmlServer::new(&self.model)?;
+                    *s = Some(srv.clone());
+                    srv
+                }
+            }
+        };
+        // Slot gate: a free seq id or an immediate, marker-tagged refusal.
+        // FAIL FAST, not a blocking wait — a waiter would pin an executor
+        // thread inside a sync host call, and enough waiters starve the
+        // slot holders into a deadlock. Guests turn this into their own
+        // wait-and-retry (llm-chat sleeps on a monotonic-clock pollable).
+        let seq_id = match server.slots.lock().unwrap().pop() {
+            Some(id) => id,
+            None => {
+                return Err(err(format!(
+                    "[sessions_busy] all {} inference session slot(s) are in use; retry \
+                     shortly (ENCLAVE_GGML_MAX_SESSIONS caps concurrent sequences in the \
+                     shared KV pool)",
+                    server.n_seq_max
+                )));
+            }
+        };
+        let ctx: Box<dyn BackendExecutionContext> = Box::new(GgmlExecutionContext {
+            server,
+            seq_id,
+            n_past: 0,
+            pending: None,
+            logits: None,
+        });
+        Ok(ctx.into())
+    }
+}
+
+/// A sequence handle: one chat's stateful cursor into the shared server.
+struct GgmlExecutionContext {
+    server: Arc<GgmlServer>,
+    seq_id: i32,
+    n_past: i32,
+    pending: Option<Vec<i32>>,  // WITX-style set_input staging
+    logits: Option<Tensor>,     // last compute's output for get_output
+}
+unsafe impl Send for GgmlExecutionContext {}
+unsafe impl Sync for GgmlExecutionContext {}
+impl Drop for GgmlExecutionContext {
+    fn drop(&mut self) {
+        // seq removal mutates the llama context: wait out any in-flight
+        // batch (bounded — one llama_decode), remove under the queue lock so
+        // no leader starts meanwhile, then free the slot. The slot lock is
+        // held through the idle check below: all slots free means no handle
+        // exists to submit, and init_execution_context can't mint one while
+        // we hold it — the reset can never race a live sequence.
+        let mut q = self.server.q.lock().unwrap();
+        while q.decoding {
+            q = self.server.cv.wait(q).unwrap();
+        }
+        unsafe { ell_seq_remove(self.server.raw, self.seq_id) };
+        // the MTP head keeps per-seq state (KV + draft seed); slots get
+        // reused by other streams, so forget this one before the slot frees
+        self.server.mtp_reset(self.seq_id);
+        let mut slots = self.server.slots.lock().unwrap();
+        slots.push(self.seq_id);
+        // IDLE RESET: a unified pool FRAGMENTS under churn — used cells
+        // scatter upward and every decode step's attention then spans the
+        // high-water mark, which decayed live decode ~20 -> ~7 tok/s over a
+        // few hours of traffic (2026-07-24; defrag_thold is deprecated at
+        // our llama.cpp pin, nothing heals it). Sessions are transient and
+        // the pool holds NOTHING between them, so the moment the last one
+        // ends, clear the memory outright — fragmentation can only build
+        // within one continuous busy burst, and any quiet moment heals it.
+        if slots.len() == self.server.n_seq_max as usize {
+            unsafe { ell_reset(self.server.raw) };
+        }
+        drop(slots);
+        drop(q);
+    }
+}
+
+fn tokens_from_tensor(tensor: &Tensor) -> Result<Vec<i32>, BackendError> {
+    match tensor.ty {
+        TensorType::I32 => {}
+        _ => return Err(BackendError::UnsupportedTensorType(format!("{:?}", tensor.ty))),
+    }
+    if tensor.data.len() % 4 != 0 {
+        return Err(err("token tensor data is not a whole number of i32s"));
+    }
+    Ok(tensor
+        .data
+        .chunks_exact(4)
+        .map(|b| i32::from_le_bytes([b[0], b[1], b[2], b[3]]))
+        .collect())
+}
+
+impl GgmlExecutionContext {
+    fn decode(&mut self, tokens: &[i32]) -> Result<Tensor, BackendError> {
+        let row = self
+            .server
+            .submit(self.seq_id, self.n_past, tokens.to_vec())
+            .map_err(err)?;
+        self.n_past += tokens.len() as i32;
+        let mut data = Vec::with_capacity(row.len() * 4);
+        for v in row {
+            data.extend_from_slice(&v.to_le_bytes());
+        }
+        Ok(Tensor {
+            dimensions: vec![1, self.server.model.n_vocab],
+            ty: TensorType::Fp32,
+            data,
+        })
+    }
+}
+
+impl BackendExecutionContext for GgmlExecutionContext {
+    fn set_input(&mut self, id: Id, tensor: &Tensor) -> Result<(), BackendError> {
+        match id {
+            Id::Index(0) => {}
+            Id::Name(ref n) if n == "tokens" => {}
+            other => return Err(err(format!("unknown input {other:?} (expected \"tokens\")"))),
+        }
+        self.pending = Some(tokens_from_tensor(tensor)?);
+        Ok(())
+    }
+
+    fn compute(
+        &mut self,
+        inputs: Option<Vec<NamedTensor>>,
+    ) -> Result<Option<Vec<NamedTensor>>, BackendError> {
+        // {"timing": I32 [1] = 1} beside any verb: append "elapsed_us" I32 [1]
+        // (wall time of this whole compute call, lock waits included) to the
+        // outputs - the per-verb decomposition instrument that ended the
+        // speculation round-cost guessing game. Requested per call by the
+        // guest, so it costs nothing when unused.
+        let t_start = std::time::Instant::now();
+        let want_timing = inputs.as_ref().map_or(false, |v| {
+            v.iter().any(|nt| nt.name == "timing"
+                && tokens_from_tensor(&nt.tensor).map(|t| t.first() == Some(&1)).unwrap_or(false))
+        });
+        let out = self.compute_inner(inputs);
+        if want_timing {
+            if let Ok(Some(mut v)) = out {
+                let us = t_start.elapsed().as_micros().min(i32::MAX as u128) as i32;
+                v.push(NamedTensor {
+                    name: "elapsed_us".to_string(),
+                    tensor: Tensor { dimensions: vec![1], ty: TensorType::I32, data: us.to_le_bytes().to_vec() },
+                });
+                return Ok(Some(v));
+            } else {
+                return out;
+            }
+        }
+        out
+    }
+
+    fn get_output(&mut self, id: Id) -> Result<Tensor, BackendError> {
+        match id {
+            Id::Index(0) => {}
+            Id::Name(ref n) if n == "logits" => {}
+            other => return Err(err(format!("unknown output {other:?} (expected \"logits\")"))),
+        }
+        self.logits
+            .clone()
+            .ok_or_else(|| err("no logits available (has `compute` been called?)"))
+    }
+}
+
+impl GgmlExecutionContext {
+    fn compute_inner(
+        &mut self,
+        inputs: Option<Vec<NamedTensor>>,
+    ) -> Result<Option<Vec<NamedTensor>>, BackendError> {
+        match inputs {
+            // WIT path: named tensors in, named tensors out
+            Some(inputs) => {
+                // control verb {"caps": I32 [1]} (value ignored): this
+                // sequence handle's identity and its model's capabilities,
+                // for speculative callers - "caps" I32 [seq_id, recurrent].
+                // seq_id names this handle as a copy_from source; recurrent
+                // 1 = partial rewind is impossible on this model (branch-
+                // verify is the only speculative strategy).
+                if inputs.iter().any(|nt| nt.name == "caps") {
+                    let vals = [
+                        self.seq_id,
+                        self.server.model.recurrent as i32,
+                        self.server.model.mtp as i32,
+                        self.server.model.vision as i32,
+                    ];
+                    let mut data = Vec::with_capacity(vals.len() * 4);
+                    for v in vals {
+                        data.extend_from_slice(&v.to_le_bytes());
+                    }
+                    let t = Tensor {
+                        dimensions: vec![vals.len() as u32],
+                        ty: TensorType::I32,
+                        data,
+                    };
+                    return Ok(Some(vec![NamedTensor { name: "caps".to_string(), tensor: t }]));
+                }
+                // {"image": U8 [n]} = one image FILE (png/jpeg/webp/gif/bmp
+                // bytes, exactly as uploaded): encode it into this sequence at
+                // the current position and answer "image_pos" I32 [1] with the
+                // positions it consumed. No logits - an image is never the end
+                // of a prompt, the text turn that follows produces the row the
+                // guest samples from. Interleaving is therefore just: feed the
+                // text before the picture as "tokens", feed the picture, feed
+                // the text after it. Everything model-specific (the marker
+                // tokens around the image, the mask, M-RoPE's 2-D positions)
+                // happens inside libmtmd, which is why the guest sends raw file
+                // bytes and does no vision work of its own.
+                if let Some(img) = inputs.iter().find(|nt| nt.name == "image") {
+                    if img.tensor.ty != TensorType::U8 {
+                        return Err(err(format!(
+                            "\"image\" must be a U8 tensor of file bytes (got {:?})",
+                            img.tensor.ty
+                        )));
+                    }
+                    let n_pos = self
+                        .server
+                        .eval_image(self.seq_id, self.n_past, &img.tensor.data)
+                        .map_err(err)?;
+                    self.n_past += n_pos;
+                    let t = Tensor {
+                        dimensions: vec![1],
+                        ty: TensorType::I32,
+                        data: n_pos.to_le_bytes().to_vec(),
+                    };
+                    return Ok(Some(vec![NamedTensor {
+                        name: "image_pos".to_string(),
+                        tensor: t,
+                    }]));
+                }
+                // control verb {"copy_from": I32 [2] = [src_seq, src_n_past]}:
+                // make THIS sequence an exact branch of src_seq (previous
+                // contents dropped; recurrent state copy-on-write). src_seq
+                // comes from the source handle's "caps" probe; src_n_past is
+                // the caller's token count for it (positions are the guest's
+                // own bookkeeping - a wrong count only breaks its own
+                // stream). The speculative pattern: branch the target, verify
+                // draft tokens on the branch, then adopt the branch back on
+                // full accept or re-feed only the accepted tokens on the
+                // real sequence - no rewind on any architecture.
+                if let Some(cp) = inputs.iter().find(|nt| nt.name == "copy_from") {
+                    let v = tokens_from_tensor(&cp.tensor)?;
+                    let (src, src_n_past) = match v.as_slice() {
+                        [s, n] => (*s, *n),
+                        _ => return Err(err("copy_from needs [src_seq, src_n_past]")),
+                    };
+                    if src < 0 || src >= self.server.n_seq_max as i32 || src == self.seq_id {
+                        return Err(err(format!(
+                            "copy_from src {src} outside this graph's sequences"
+                        )));
+                    }
+                    if src_n_past < 0 {
+                        return Err(err("copy_from src_n_past must be >= 0"));
+                    }
+                    self.server.seq_copy(src, self.seq_id);
+                    self.n_past = src_n_past;
+                    return Ok(Some(vec![]));
+                }
+                // control verb {"rewind": I32 [1]}: drop this sequence's
+                // tokens from the given position on (a speculative round's
+                // rejected tail) - no decode, no outputs. Errors (nothing
+                // mutated) on recurrent/hybrid models, which keep no
+                // per-token state history - branch via copy_from instead.
+                if let Some(rw) = inputs.iter().find(|nt| nt.name == "rewind") {
+                    let v = tokens_from_tensor(&rw.tensor)?;
+                    let n_keep = *v.first().ok_or_else(|| err("rewind needs one i32"))?;
+                    if n_keep < 0 || n_keep > self.n_past {
+                        return Err(err(format!("rewind to {n_keep} outside 0..={}", self.n_past)));
+                    }
+                    self.server.rewind(self.seq_id, n_keep).map_err(err)?;
+                    self.n_past = n_keep;
+                    return Ok(Some(vec![]));
+                }
+                // control verb {"mtp_draft": I32 [3] = [id_last, k, p_min_milli]}:
+                // the model's own MTP head proposes up to k tokens continuing
+                // this sequence (greedy, stops below p_min confidence) -
+                // output "draft" I32 [n], possibly empty. Near-zero cost: the
+                // head is one layer riding state harvested from prior passes.
+                if let Some(md) = inputs.iter().find(|nt| nt.name == "mtp_draft") {
+                    let v = tokens_from_tensor(&md.tensor)?;
+                    let (id_last, k, pmm) = match v.as_slice() {
+                        [i, k, p] => (*i, *k, *p),
+                        _ => return Err(err("mtp_draft needs [id_last, k, p_min_milli]")),
+                    };
+                    let k = k.clamp(1, 16);
+                    let p_min = (pmm.clamp(0, 1000) as f32) / 1000.0;
+                    let toks = self
+                        .server
+                        .mtp_draft(self.seq_id, id_last, self.n_past, k, p_min)
+                        .map_err(err)?;
+                    let mut data = Vec::with_capacity(toks.len() * 4);
+                    for t in &toks {
+                        data.extend_from_slice(&t.to_le_bytes());
+                    }
+                    let t = Tensor {
+                        dimensions: vec![toks.len() as u32],
+                        ty: TensorType::I32,
+                        data,
+                    };
+                    return Ok(Some(vec![NamedTensor { name: "draft".to_string(), tensor: t }]));
+                }
+                // control verb {"mtp_accept": I32 [1+n] = [pos0, tokens...]}:
+                // mirror a verify round's ACCEPTED tokens into the head's KV
+                // (pairs them with the rows harvested by the last mtp-flagged
+                // pass). Rejected proposals never reach the head.
+                if let Some(ma) = inputs.iter().find(|nt| nt.name == "mtp_accept") {
+                    let v = tokens_from_tensor(&ma.tensor)?;
+                    let (pos0, toks) = match v.split_first() {
+                        Some((p, rest)) if !rest.is_empty() => (*p, rest),
+                        _ => return Err(err("mtp_accept needs [pos0, tokens...]")),
+                    };
+                    if pos0 < 0 {
+                        return Err(err("mtp_accept pos0 must be >= 0"));
+                    }
+                    self.server.mtp_observe(self.seq_id, pos0, toks).map_err(err)?;
+                    return Ok(Some(vec![]));
+                }
+                let tokens = inputs
+                    .iter()
+                    .find(|nt| nt.name == "tokens" || nt.name == "0")
+                    .ok_or_else(|| err("missing \"tokens\" input"))?;
+                let ids = tokens_from_tensor(&tokens.tensor)?;
+                let flag = |name: &str| {
+                    inputs.iter().any(|nt| nt.name == name
+                        && tokens_from_tensor(&nt.tensor).map(|v| v.first() == Some(&1)).unwrap_or(false))
+                };
+                // {"all": I32 [1] = 1} beside "tokens": logits for EVERY fed
+                // position, dims [n, vocab] - the speculative verify step.
+                // {"mtp_for": I32 [1] = seq} harvests the pass's MTP hidden
+                // rows for that sequence (the verify runs on a scratch branch
+                // but the head state belongs to the REAL sequence).
+                let want_all = flag("all");
+                // {"topk": I32 [1] = K}: reduce every logits row host-side
+                // to its top-K before crossing the guest boundary (see
+                // topk_rows). Engines predating this input simply ignore it
+                // and return dense "logits" - guests sniff the output name.
+                let topk = inputs
+                    .iter()
+                    .find(|nt| nt.name == "topk")
+                    .map(|nt| tokens_from_tensor(&nt.tensor))
+                    .transpose()?
+                    .and_then(|v| v.first().copied())
+                    .map(|kv| kv.clamp(16, 1024) as usize);
+                let mtp_for = inputs
+                    .iter()
+                    .find(|nt| nt.name == "mtp_for")
+                    .map(|nt| tokens_from_tensor(&nt.tensor))
+                    .transpose()?
+                    .and_then(|v| v.first().copied());
+                if let Some(ms) = mtp_for {
+                    if ms < 0 || ms >= self.server.n_seq_max as i32 {
+                        return Err(err(format!("mtp_for seq {ms} outside this graph's sequences")));
+                    }
+                }
+                if want_all {
+                    let flat = self
+                        .server
+                        .submit_full(self.seq_id, self.n_past, &ids, mtp_for)
+                        .map_err(err)?;
+                    self.n_past += ids.len() as i32;
+                    if let Some(kv) = topk {
+                        let (ti, tv) = topk_rows(&flat, ids.len(), self.server.n_vocab, kv);
+                        return Ok(Some(vec![
+                            NamedTensor { name: "topk_ids".to_string(), tensor: ti },
+                            NamedTensor { name: "topk_logits".to_string(), tensor: tv },
+                        ]));
+                    }
+                    let mut data = Vec::with_capacity(flat.len() * 4);
+                    for v in flat {
+                        data.extend_from_slice(&v.to_le_bytes());
+                    }
+                    let t = Tensor {
+                        dimensions: vec![ids.len() as u32, self.server.model.n_vocab],
+                        ty: TensorType::Fp32,
+                        data,
+                    };
+                    self.logits = Some(t.clone());
+                    return Ok(Some(vec![NamedTensor { name: "logits".to_string(), tensor: t }]));
+                }
+                // {"mtp": I32 [1] = 1} beside "tokens" (no "all"): an
+                // MTP-aware feed of this sequence - exclusive all-positions
+                // decode (the head needs every position's hidden row), rows
+                // harvested + mirrored into the head, but only the LAST
+                // logits row returned. The speculative prefill path.
+                if flag("mtp") {
+                    let pos0 = self.n_past;
+                    let flat = self
+                        .server
+                        .submit_full(self.seq_id, pos0, &ids, Some(self.seq_id))
+                        .map_err(err)?;
+                    self.server.mtp_observe(self.seq_id, pos0, &ids).map_err(err)?;
+                    self.n_past += ids.len() as i32;
+                    let last = &flat[(ids.len() - 1) * self.server.n_vocab..];
+                    if let Some(kv) = topk {
+                        let (ti, tv) = topk_rows(last, 1, self.server.n_vocab, kv);
+                        return Ok(Some(vec![
+                            NamedTensor { name: "topk_ids".to_string(), tensor: ti },
+                            NamedTensor { name: "topk_logits".to_string(), tensor: tv },
+                        ]));
+                    }
+                    let mut data = Vec::with_capacity(last.len() * 4);
+                    for v in last {
+                        data.extend_from_slice(&v.to_le_bytes());
+                    }
+                    let t = Tensor {
+                        dimensions: vec![1, self.server.model.n_vocab],
+                        ty: TensorType::Fp32,
+                        data,
+                    };
+                    self.logits = Some(t.clone());
+                    return Ok(Some(vec![NamedTensor { name: "logits".to_string(), tensor: t }]));
+                }
+                if let Some(kv) = topk {
+                    let row = self
+                        .server
+                        .submit(self.seq_id, self.n_past, ids.to_vec())
+                        .map_err(err)?;
+                    self.n_past += ids.len() as i32;
+                    let (ti, tv) = topk_rows(&row, 1, self.server.n_vocab, kv);
+                    return Ok(Some(vec![
+                        NamedTensor { name: "topk_ids".to_string(), tensor: ti },
+                        NamedTensor { name: "topk_logits".to_string(), tensor: tv },
+                    ]));
+                }
+                let logits = self.decode(&ids)?;
+                self.logits = Some(logits.clone());
+                Ok(Some(vec![NamedTensor {
+                    name: "logits".to_string(),
+                    tensor: logits,
+                }]))
+            }
+            // WITX path: tokens staged via set_input, result via get_output
+            None => {
+                let ids = self
+                    .pending
+                    .take()
+                    .ok_or_else(|| err("no input staged (call set_input first)"))?;
+                self.logits = Some(self.decode(&ids)?);
+                Ok(None)
+            }
+        }
+    }
+
+}
