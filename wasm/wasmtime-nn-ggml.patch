@@ -0,0 +1,787 @@
+//! A ggml/llama.cpp backend for wasi-nn — GGUF language models behind the
+//! standard `wasi:nn` interface.
+//!
+//! The heavy lifting happens in the system-linked `enclave_llama` shim (a
+//! flat pointer/scalar C ABI over llama.cpp, shipped next to libllama in the
+//! enclave-llamacpp toolchain artifact — see wasm/llama-shim in the platform
+//! repo). This file binds nine shim functions and adapts them to the
+//! wasi-nn backend traits. No new crates: std + FFI only, so the toolchain
+//! patch carries no Cargo.lock delta.
+//!
+//! The llama.cpp libs are built GGML_BACKEND_DL: the compute backends (cpu,
+//! cuda) are dlopened modules, loaded by `ell_init()` from
+//! ENCLAVE_GGML_BACKEND_DIR — the wasmtime binary carries no DT_NEEDED on
+//! libcuda.so.1, so it starts on driverless (CPU-flavor) nodes. The flip
+//! side is that a broken CUDA module load degrades SILENTLY to CPU, so
+//! `load_path` enforces: GPU offload requested but no ggml GPU device
+//! loaded = loud failure, never a silent CPU fallback (tenants BUY the
+//! share — same discipline as the strict-GPU ONNX patch).
+//!
+//! Model delivery is `load_by_name()` via the CLI preload registry
+//! (`-S nn-graph=ggml::<dir>`): the HOST opens the GGUF straight off the
+//! (read-only, attested) model volume, so weights never transit the guest's
+//! 32-bit linear memory — the whole point for large models. `load()` from
+//! guest bytes also works for small models: the bytes are staged to a temp
+//! file because llama.cpp wants a path.
+//!
+//! Inference contract (WIT named tensors):
+//!   input  "tokens"  I32  dims [1, n] (n <= n_batch)   token ids
+//!   output "logits"  Fp32 dims [1, n_vocab]            last-token logits
+//!
+//! SERVING MODEL (continuous batching): an execution context is a SEQUENCE
+//! HANDLE into its graph's shared server context. llama.cpp serves up to
+//! ENCLAVE_GGML_MAX_SESSIONS concurrent sequences out of ONE unified KV pool
+//! of n_ctx tokens TOTAL — a slot costs no pre-allocated VRAM of its own,
+//! each chat consumes only the pool space its actual tokens need. Concurrent
+//! requests' decode steps MERGE into single batched llama_decode calls (the
+//! leader protocol in GgmlServer::submit): decode is memory-bandwidth-bound,
+//! one pass over the weights serves every active chat, so aggregate
+//! throughput scales with concurrency instead of dividing by it. A fresh
+//! wasi-nn execution context = a fresh sequence; dropping it frees its
+//! tokens back to the pool. NOTE: batched and serial decodes may differ in
+//! floating-point reduction order — greedy token streams are deterministic
+//! only for a fixed batch composition (compare like with like).
+//!
+//! Isolation: one server per GRAPH per tenant PROCESS. Cross-app isolation
+//! is the process boundary (each tenant is its own `wasmtime serve` with its
+//! own MPS partition) — batching only ever merges requests of the same
+//! deployment, and sequences are kept apart by llama.cpp's seq_id-keyed KV
+//! masking (the llama-server production mechanism).
+//!
+//! Tuning env (host process only, set per tenant by the wasm-manager):
+//!   ENCLAVE_GGML_N_CTX          KV pool size in TOKENS, shared by all of a
+//!                               graph's concurrent sequences (default 8192;
+//!                               0 = model max)
+//!   ENCLAVE_GGML_N_BATCH        max tokens per llama_decode (default 512)
+//!   ENCLAVE_GGML_N_GPU_LAYERS   -1 = offload all (default when built with
+//!                               CUDA-enabled libllama), 0 = pure CPU
+//!   ENCLAVE_GGML_KV_CACHE_TYPE  KV-cache element type: f16 (default) | q8_0 |
+//!                               q4_0 | f32. q8_0 ~halves / q4_0 ~quarters the
+//!                               VRAM the pool costs up front.
+//!                               ..._K / ..._V override one side only.
+//!   ENCLAVE_GGML_FLASH_ATTN     auto (default) | on | off. A quantized V cache
+//!                               requires Flash Attention, so a q8_0/q4_0 V is
+//!                               auto-promoted to on unless explicitly off.
+//!   ENCLAVE_GGML_MAX_SESSIONS   concurrent sequences per graph (default 1).
+//!                               Slots into the SHARED pool — raising it costs
+//!                               no extra pre-allocated VRAM (the pool is
+//!                               sized once by N_CTX). No free slot = fail
+//!                               fast with [sessions_busy] for guests to
+//!                               wait-and-retry on; pool pressure at decode
+//!                               time surfaces as [kv_pool_full] (retryable —
+//!                               llama restores state on that failure).
+//!   ENCLAVE_GGML_BACKEND_DIR    dir holding the dlopened libggml-* backend
+//!                               modules (unset = exe dir + cwd)
+
+use super::{
+    BackendError, BackendExecutionContext, BackendFromDir, BackendGraph, BackendInner, Id,
+    NamedTensor,
+};
+use crate::wit::types::{ExecutionTarget, GraphEncoding, Tensor, TensorType};
+use crate::{ExecutionContext, Graph};
+use std::collections::{HashMap, VecDeque};
+use std::ffi::{c_char, c_void, CString};
+use std::path::Path;
+use std::sync::{Arc, Condvar, Mutex, Once};
+
+unsafe extern "C" {
+    fn ell_init();
+    fn ell_gpu_devices() -> i32;
+    fn ell_load_model(path: *const c_char, n_gpu_layers: i32) -> *mut c_void;
+    fn ell_free_model(model: *mut c_void);
+    fn ell_n_vocab(model: *mut c_void) -> i32;
+    fn ell_free_context(ctx: *mut c_void);
+    fn ell_reset(ctx: *mut c_void);
+    fn ell_new_server(
+        model: *mut c_void,
+        n_ctx: u32,
+        n_batch: u32,
+        n_seq_max: u32,
+        type_k: i32,
+        type_v: i32,
+        flash_attn: i32,
+    ) -> *mut c_void;
+    fn ell_decode_batch(
+        ctx: *mut c_void,
+        model: *mut c_void,
+        n_items: i32,
+        seq_ids: *const i32,
+        counts: *const i32,
+        positions: *const i32,
+        tokens_flat: *const i32,
+        logits_flat: *mut f32,
+    ) -> i32;
+    fn ell_seq_remove(ctx: *mut c_void, seq_id: i32);
+    fn ell_decode_seq_full(
+        ctx: *mut c_void,
+        model: *mut c_void,
+        seq_id: i32,
+        pos0: i32,
+        tokens: *const i32,
+        n: i32,
+        logits_out: *mut f32,
+    ) -> i32;
+    fn ell_seq_rewind(ctx: *mut c_void, seq_id: i32, n_keep: i32);
+}
+
+static INIT: Once = Once::new();
+
+fn err(msg: impl Into<String>) -> BackendError {
+    BackendError::BackendAccess(wasmtime::format_err!("{}", msg.into()))
+}
+
+fn env_u32(name: &str, default: u32) -> u32 {
+    std::env::var(name).ok().and_then(|v| v.parse().ok()).unwrap_or(default)
+}
+
+fn env_i32(name: &str, default: i32) -> i32 {
+    std::env::var(name).ok().and_then(|v| v.parse().ok()).unwrap_or(default)
+}
+
+/// KV-cache element type string -> the shim's `ell_kv_type` code (0 F16 default,
+/// 1 Q8_0, 2 Q4_0, 3 F32). Empty/unknown = F16, i.e. current behavior.
+fn kv_type_code(s: &str) -> i32 {
+    match s.trim().to_ascii_lowercase().as_str() {
+        "q8_0" | "q8" => 1,
+        "q4_0" | "q4" => 2,
+        "f32" | "fp32" => 3,
+        _ => 0,
+    }
+}
+
+/// Flash-attention selector string -> the shim's `ell_flash_attn` code
+/// (0 AUTO default, 1 DISABLED, 2 ENABLED).
+fn flash_attn_code(s: &str) -> i32 {
+    match s.trim().to_ascii_lowercase().as_str() {
+        "on" | "1" | "true" | "enabled" | "enable" => 2,
+        "off" | "0" | "false" | "disabled" | "disable" => 1,
+        _ => 0,
+    }
+}
+
+#[derive(Default)]
+pub struct GgmlBackend();
+unsafe impl Send for GgmlBackend {}
+unsafe impl Sync for GgmlBackend {}
+
+impl GgmlBackend {
+    fn load_path(&self, path: &Path, target: ExecutionTarget) -> Result<Graph, BackendError> {
+        INIT.call_once(|| unsafe { ell_init() });
+        // GPU offload only when asked for AND the linked libllama carries a
+        // GPU backend; a CPU-only libllama silently ignores n_gpu_layers.
+        let ngl = match target {
+            ExecutionTarget::Cpu => 0,
+            _ => env_i32("ENCLAVE_GGML_N_GPU_LAYERS", -1),
+        };
+        // Strict GPU: the CUDA backend is a dlopened module whose load
+        // failure (missing libcuda, wrong SASS, future lib drift) is silent
+        // by design — a 122B model "working" at CPU speed is the failure
+        // mode, so offload-requested + no GPU device = refuse loudly.
+        if ngl != 0 && unsafe { ell_gpu_devices() } == 0 {
+            return Err(err(
+                "ggml: GPU offload requested (ENCLAVE_GGML_N_GPU_LAYERS != 0) but no ggml GPU \
+                 device is available — CUDA backend module or driver missing",
+            ));
+        }
+        let cpath = CString::new(path.to_string_lossy().as_bytes())
+            .map_err(|_| err("model path contains NUL"))?;
+        let model = unsafe { ell_load_model(cpath.as_ptr(), ngl) };
+        if model.is_null() {
+            return Err(err(format!("llama.cpp failed to load {}", path.display())));
+        }
+        let n_vocab = unsafe { ell_n_vocab(model) };
+        if n_vocab <= 0 {
+            unsafe { ell_free_model(model) };
+            return Err(err("model reports no vocabulary"));
+        }
+        let graph: Box<dyn BackendGraph> = Box::new(GgmlGraph {
+            model: Arc::new(GgmlModel {
+                raw: model,
+                n_vocab: n_vocab as u32,
+            }),
+            server: Mutex::new(None),
+        });
+        Ok(graph.into())
+    }
+}
+
+impl BackendInner for GgmlBackend {
+    fn encoding(&self) -> GraphEncoding {
+        GraphEncoding::Ggml
+    }
+
+    fn load(&mut self, builders: &[&[u8]], target: ExecutionTarget) -> Result<Graph, BackendError> {
+        if builders.len() != 1 {
+            return Err(BackendError::InvalidNumberOfBuilders(1, builders.len()));
+        }
+        // llama.cpp opens files, not buffers: stage guest bytes to a temp
+        // GGUF. Only viable for small models (the bytes crossed the guest's
+        // 32-bit memory to get here); big models come via load_by_name.
+        let dir = std::env::temp_dir().join(format!("wasi-nn-ggml-{}", std::process::id()));
+        std::fs::create_dir_all(&dir).map_err(|e| err(format!("staging dir: {e}")))?;
+        let path = dir.join(format!("model-{:x}.gguf", builders[0].len()));
+        std::fs::write(&path, builders[0]).map_err(|e| err(format!("staging model: {e}")))?;
+        let graph = self.load_path(&path, target);
+        // the shim mmaps/reads it during load; safe to unlink either way
+        let _ = std::fs::remove_file(&path);
+        graph
+    }
+
+    fn as_dir_loadable<'a>(&'a mut self) -> Option<&'a mut dyn BackendFromDir> {
+        Some(self)
+    }
+}
+
+/// Part 00001 of the split-GGUF family covering EXACTLY the given file names
+/// (llama.cpp's "<prefix>-NNNNN-of-MMMMM.gguf" split convention, forced on
+/// >50GB models by HF's per-file cap), if there is one. llama.cpp opens part
+/// 00001 and derives the sibling paths from its file name, so handing it the
+/// first part loads the whole model; extra ggufs outside the family stay an
+/// error (an ambiguous pick would misload).
+fn split_family_first(names: &std::collections::BTreeSet<String>) -> Option<String> {
+    for name in names {
+        let Some(stem) = name.strip_suffix(".gguf") else { continue };
+        let Some((rest, count)) = stem.rsplit_once("-of-") else { continue };
+        let Some((prefix, no)) = rest.rsplit_once('-') else { continue };
+        if no != "00001" || count.len() != 5 {
+            continue;
+        }
+        let Some(n) = count.parse::<u32>().ok().filter(|n| *n >= 1) else { continue };
+        let family: std::collections::BTreeSet<String> = (1..=n)
+            .map(|i| format!("{prefix}-{i:05}-of-{count}.gguf"))
+            .collect();
+        if family == *names {
+            return Some(name.clone());
+        }
+    }
+    None
+}
+
+impl BackendFromDir for GgmlBackend {
+    fn load_from_dir(&mut self, path: &Path, target: ExecutionTarget) -> Result<Graph, BackendError> {
+        // model.gguf wins; otherwise exactly one *.gguf in the directory;
+        // otherwise one complete split family (part 00001 is the model).
+        let preferred = path.join("model.gguf");
+        let model_path = if preferred.is_file() {
+            preferred
+        } else {
+            let mut ggufs: Vec<_> = std::fs::read_dir(path)
+                .map_err(|e| err(format!("reading {}: {e}", path.display())))?
+                .filter_map(|e| e.ok().map(|e| e.path()))
+                .filter(|p| p.extension().map(|x| x == "gguf").unwrap_or(false))
+                .collect();
+            let names: std::collections::BTreeSet<String> = ggufs
+                .iter()
+                .filter_map(|p| p.file_name().and_then(|n| n.to_str()).map(String::from))
+                .collect();
+            match (ggufs.len(), ggufs.pop()) {
+                (1, Some(p)) => p,
+                (n, _) => match split_family_first(&names) {
+                    Some(first) => path.join(first),
+                    None => {
+                        return Err(err(format!(
+                            "expected model.gguf, exactly one *.gguf, or one complete \
+                             *-00001-of-NNNNN.gguf split family in {} (found {n})",
+                            path.display()
+                        )))
+                    }
+                },
+            }
+        };
+        // Preloads arrive with ExecutionTarget::Cpu from the registry; the
+        // env override decides real offload so operators control it per
+        // process without patching the registry call.
+        let ngl_env = env_i32("ENCLAVE_GGML_N_GPU_LAYERS", i32::MIN);
+        let target = if ngl_env != i32::MIN && ngl_env != 0 {
+            ExecutionTarget::Gpu
+        } else {
+            target
+        };
+        self.load_path(&model_path, target)
+    }
+}
+
+struct GgmlModel {
+    raw: *mut c_void,
+    n_vocab: u32,
+}
+unsafe impl Send for GgmlModel {}
+unsafe impl Sync for GgmlModel {}
+impl Drop for GgmlModel {
+    fn drop(&mut self) {
+        unsafe { ell_free_model(self.raw) };
+    }
+}
+
+/// One decode request from one sequence, queued for the next merged batch.
+struct PendingItem {
+    ticket: u64,
+    seq_id: i32,
+    pos0: i32,
+    tokens: Vec<i32>,
+}
+
+struct DecodeQueue {
+    next_ticket: u64,
+    pending: VecDeque<PendingItem>,
+    results: HashMap<u64, Result<Vec<f32>, String>>,
+    /// a leader is inside ell_decode_batch — exactly one at a time, and
+    /// seq removal (Drop) must also wait on this
+    decoding: bool,
+}
+
+/// The shared serving context for one graph: one llama context whose unified
+/// KV pool holds every concurrent sequence. All shim calls on `raw` are
+/// serialized by the leader protocol (submit) + the `decoding` flag (Drop);
+/// the shim itself adds no locking.
+struct GgmlServer {
+    raw: *mut c_void,
+    model: Arc<GgmlModel>,
+    n_batch: u32,
+    n_seq_max: u32,
+    n_vocab: usize,
+    slots: Mutex<Vec<i32>>,
+    q: Mutex<DecodeQueue>,
+    cv: Condvar,
+}
+unsafe impl Send for GgmlServer {}
+unsafe impl Sync for GgmlServer {}
+impl Drop for GgmlServer {
+    fn drop(&mut self) {
+        unsafe { ell_free_context(self.raw) };
+    }
+}
+
+/// llama_decode rc -> caller-facing message. rc 1 = the pool momentarily
+/// cannot hold the step; llama RESTORES state on it, so it is retryable.
+fn decode_err(rc: i32) -> String {
+    if rc == 1 {
+        "[kv_pool_full] the shared KV pool cannot hold this step right now — too many (or too \
+         long) concurrent chats; retry shortly, or redeploy with a larger share"
+            .to_string()
+    } else {
+        format!("llama_decode failed (rc {rc}; context window exhausted?)")
+    }
+}
+
+impl GgmlServer {
+    fn new(model: &Arc<GgmlModel>) -> Result<Arc<GgmlServer>, BackendError> {
+        let n_ctx = env_u32("ENCLAVE_GGML_N_CTX", 8192);
+        let n_batch = env_u32("ENCLAVE_GGML_N_BATCH", 512);
+        let n_seq_max = env_u32("ENCLAVE_GGML_MAX_SESSIONS", 1).max(1);
+        // KV-cache quantization: ENCLAVE_GGML_KV_CACHE_TYPE sets both sides
+        // (f16|q8_0|q4_0|f32); ..._K / ..._V override per side. A quantized KV
+        // cache roughly halves (q8_0) or quarters (q4_0) the up-front VRAM the
+        // pool costs. Default f16 = unchanged behavior.
+        let kv_both = std::env::var("ENCLAVE_GGML_KV_CACHE_TYPE").unwrap_or_default();
+        let type_k = kv_type_code(
+            &std::env::var("ENCLAVE_GGML_KV_CACHE_TYPE_K").unwrap_or_else(|_| kv_both.clone()),
+        );
+        let type_v = kv_type_code(
+            &std::env::var("ENCLAVE_GGML_KV_CACHE_TYPE_V").unwrap_or_else(|_| kv_both.clone()),
+        );
+        // A quantized V cache is only valid with Flash Attention; if one was
+        // asked for but FA left on auto, force it on so llama.cpp doesn't abort
+        // context creation. Explicit ENCLAVE_GGML_FLASH_ATTN=off is honored
+        // (and will then fail loudly, which is the intended signal).
+        let mut flash_attn =
+            flash_attn_code(&std::env::var("ENCLAVE_GGML_FLASH_ATTN").unwrap_or_default());
+        if matches!(type_v, 1 | 2) && flash_attn == 0 {
+            flash_attn = 2;
+        }
+        let raw = unsafe {
+            ell_new_server(model.raw, n_ctx, n_batch, n_seq_max, type_k, type_v, flash_attn)
+        };
+        if raw.is_null() {
+            return Err(err(
+                "llama.cpp context allocation failed — the n_ctx KV pool does not fit the \
+                 share's free VRAM (lower ENCLAVE_GGML_N_CTX or buy a larger share)",
+            ));
+        }
+        Ok(Arc::new(GgmlServer {
+            raw,
+            model: model.clone(),
+            n_batch,
+            n_seq_max,
+            n_vocab: model.n_vocab as usize,
+            slots: Mutex::new((0..n_seq_max as i32).collect()),
+            q: Mutex::new(DecodeQueue {
+                next_ticket: 0,
+                pending: VecDeque::new(),
+                results: HashMap::new(),
+                decoding: false,
+            }),
+            cv: Condvar::new(),
+        }))
+    }
+
+    /// Decode `tokens` as the next step of `seq_id` (whose first new token
+    /// sits at position `pos0`) and return the last token's logits row.
+    /// Concurrent callers MERGE: whoever finds the queue idle becomes the
+    /// leader, drains everything that fits one llama batch, runs the single
+    /// FFI decode, posts every item's result, and wakes the rest —
+    /// continuous batching by natural queueing, no artificial delay window
+    /// (requests that arrive while a batch is on the GPU merge into the
+    /// next one).
+    fn submit(&self, seq_id: i32, pos0: i32, tokens: Vec<i32>) -> Result<Vec<f32>, String> {
+        if tokens.is_empty() {
+            return Err("empty token batch".into());
+        }
+        if tokens.len() > self.n_batch as usize {
+            return Err(format!(
+                "batch of {} tokens exceeds n_batch {} (chunk your prefill)",
+                tokens.len(),
+                self.n_batch
+            ));
+        }
+        let ticket = {
+            let mut q = self.q.lock().unwrap();
+            let t = q.next_ticket;
+            q.next_ticket += 1;
+            q.pending.push_back(PendingItem { ticket: t, seq_id, pos0, tokens });
+            t
+        };
+        let mut q = self.q.lock().unwrap();
+        loop {
+            if let Some(r) = q.results.remove(&ticket) {
+                return r;
+            }
+            if !q.decoding && !q.pending.is_empty() {
+                // become the leader: take from the front while it fits the
+                // batch, one item per sequence (positions within one call
+                // are per-item contiguous)
+                let mut items: Vec<PendingItem> = Vec::new();
+                let mut total = 0usize;
+                while let Some(it) = q.pending.front() {
+                    if total + it.tokens.len() > self.n_batch as usize && !items.is_empty() {
+                        break;
+                    }
+                    if items.iter().any(|p| p.seq_id == it.seq_id) {
+                        break;
+                    }
+                    let it = q.pending.pop_front().unwrap();
+                    total += it.tokens.len();
+                    items.push(it);
+                }
+                q.decoding = true;
+                drop(q);
+                let results = self.decode_items(&items);
+                q = self.q.lock().unwrap();
+                for (it, res) in items.into_iter().zip(results) {
+                    q.results.insert(it.ticket, res);
+                }
+                q.decoding = false;
+                self.cv.notify_all();
+                continue; // our own result may be among them
+            }
+            q = self.cv.wait(q).unwrap();
+        }
+    }
+
+    /// One merged decode over `items` (results in item order). On a
+    /// pool-full rc 1 with several items, fall back to per-item decodes so
+    /// one over-long request cannot fail its batchmates (llama restores
+    /// state on rc 1, so the retry is sound).
+    fn decode_items(&self, items: &[PendingItem]) -> Vec<Result<Vec<f32>, String>> {
+        match self.decode_raw(items) {
+            Ok(rows) => rows.into_iter().map(Ok).collect(),
+            Err(1) if items.len() > 1 => items
+                .iter()
+                .map(|it| match self.decode_raw(std::slice::from_ref(it)) {
+                    Ok(mut rows) => Ok(rows.pop().expect("one row per item")),
+                    Err(rc) => Err(decode_err(rc)),
+                })
+                .collect(),
+            Err(rc) => items.iter().map(|_| Err(decode_err(rc))).collect(),
+        }
+    }
+
+    /// EXCLUSIVE decode of one sequence with logits for EVERY position (the
+    /// speculative verify step: the target consumes the draft's tokens in one
+    /// pass and hands back each position's distribution). Takes the decode
+    /// turn like a leader, but alone - full-logits rows don't merge with
+    /// last-row batchmates.
+    fn submit_full(&self, seq_id: i32, pos0: i32, tokens: &[i32]) -> Result<Vec<f32>, String> {
+        if tokens.is_empty() {
+            return Err("empty token batch".into());
+        }
+        if tokens.len() > self.n_batch as usize {
+            return Err(format!(
+                "batch of {} tokens exceeds n_batch {} (chunk your prefill)",
+                tokens.len(),
+                self.n_batch
+            ));
+        }
+        let mut q = self.q.lock().unwrap();
+        while q.decoding {
+            q = self.cv.wait(q).unwrap();
+        }
+        q.decoding = true;
+        drop(q);
+        let mut logits = vec![0f32; tokens.len() * self.n_vocab];
+        let rc = unsafe {
+            ell_decode_seq_full(self.raw, self.model.raw, seq_id, pos0,
+                                tokens.as_ptr(), tokens.len() as i32, logits.as_mut_ptr())
+        };
+        let mut q = self.q.lock().unwrap();
+        q.decoding = false;
+        self.cv.notify_all();
+        drop(q);
+        if rc != 0 {
+            return Err(decode_err(rc));
+        }
+        Ok(logits)
+    }
+
+    /// Drop a sequence's tokens from n_keep onward (a speculative round's
+    /// rejected tail). Holding the queue lock excludes decode leaders, the
+    /// same discipline as seq removal in Drop.
+    fn rewind(&self, seq_id: i32, n_keep: i32) {
+        let mut q = self.q.lock().unwrap();
+        while q.decoding {
+            q = self.cv.wait(q).unwrap();
+        }
+        unsafe { ell_seq_rewind(self.raw, seq_id, n_keep) };
+        drop(q);
+    }
+
+    /// The FFI call itself; Err carries the raw llama_decode rc.
+    fn decode_raw(&self, items: &[PendingItem]) -> Result<Vec<Vec<f32>>, i32> {
+        let n = items.len();
+        let seq_ids: Vec<i32> = items.iter().map(|i| i.seq_id).collect();
+        let counts: Vec<i32> = items.iter().map(|i| i.tokens.len() as i32).collect();
+        let positions: Vec<i32> = items.iter().map(|i| i.pos0).collect();
+        let flat: Vec<i32> = items.iter().flat_map(|i| i.tokens.iter().copied()).collect();
+        let mut logits = vec![0f32; n * self.n_vocab];
+        let rc = unsafe {
+            ell_decode_batch(
+                self.raw,
+                self.model.raw,
+                n as i32,
+                seq_ids.as_ptr(),
+                counts.as_ptr(),
+                positions.as_ptr(),
+                flat.as_ptr(),
+                logits.as_mut_ptr(),
+            )
+        };
+        if rc != 0 {
+            return Err(rc);
+        }
+        Ok(logits.chunks_exact(self.n_vocab).map(|c| c.to_vec()).collect())
+    }
+}
+
+struct GgmlGraph {
+    model: Arc<GgmlModel>,
+    /// the shared server, created on FIRST use (that is when the KV pool
+    /// claims its VRAM) and kept for the graph's lifetime. Creation failure
+    /// is NOT cached — a later request retries (VRAM may have freed).
+    server: Mutex<Option<Arc<GgmlServer>>>,
+}
+unsafe impl Send for GgmlGraph {}
+unsafe impl Sync for GgmlGraph {}
+
+impl BackendGraph for GgmlGraph {
+    fn init_execution_context(&self) -> Result<ExecutionContext, BackendError> {
+        let server = {
+            let mut s = self.server.lock().unwrap();
+            match &*s {
+                Some(srv) => srv.clone(),
+                None => {
+                    let srv = GgmlServer::new(&self.model)?;
+                    *s = Some(srv.clone());
+                    srv
+                }
+            }
+        };
+        // Slot gate: a free seq id or an immediate, marker-tagged refusal.
+        // FAIL FAST, not a blocking wait — a waiter would pin an executor
+        // thread inside a sync host call, and enough waiters starve the
+        // slot holders into a deadlock. Guests turn this into their own
+        // wait-and-retry (llm-chat sleeps on a monotonic-clock pollable).
+        let seq_id = match server.slots.lock().unwrap().pop() {
+            Some(id) => id,
+            None => {
+                return Err(err(format!(
+                    "[sessions_busy] all {} inference session slot(s) are in use; retry \
+                     shortly (ENCLAVE_GGML_MAX_SESSIONS caps concurrent sequences in the \
+                     shared KV pool)",
+                    server.n_seq_max
+                )));
+            }
+        };
+        let ctx: Box<dyn BackendExecutionContext> = Box::new(GgmlExecutionContext {
+            server,
+            seq_id,
+            n_past: 0,
+            pending: None,
+            logits: None,
+        });
+        Ok(ctx.into())
+    }
+}
+
+/// A sequence handle: one chat's stateful cursor into the shared server.
+struct GgmlExecutionContext {
+    server: Arc<GgmlServer>,
+    seq_id: i32,
+    n_past: i32,
+    pending: Option<Vec<i32>>,  // WITX-style set_input staging
+    logits: Option<Tensor>,     // last compute's output for get_output
+}
+unsafe impl Send for GgmlExecutionContext {}
+unsafe impl Sync for GgmlExecutionContext {}
+impl Drop for GgmlExecutionContext {
+    fn drop(&mut self) {
+        // seq removal mutates the llama context: wait out any in-flight
+        // batch (bounded — one llama_decode), remove under the queue lock so
+        // no leader starts meanwhile, then free the slot. The slot lock is
+        // held through the idle check below: all slots free means no handle
+        // exists to submit, and init_execution_context can't mint one while
+        // we hold it — the reset can never race a live sequence.
+        let mut q = self.server.q.lock().unwrap();
+        while q.decoding {
+            q = self.server.cv.wait(q).unwrap();
+        }
+        unsafe { ell_seq_remove(self.server.raw, self.seq_id) };
+        let mut slots = self.server.slots.lock().unwrap();
+        slots.push(self.seq_id);
+        // IDLE RESET: a unified pool FRAGMENTS under churn — used cells
+        // scatter upward and every decode step's attention then spans the
+        // high-water mark, which decayed live decode ~20 -> ~7 tok/s over a
+        // few hours of traffic (2026-07-24; defrag_thold is deprecated at
+        // our llama.cpp pin, nothing heals it). Sessions are transient and
+        // the pool holds NOTHING between them, so the moment the last one
+        // ends, clear the memory outright — fragmentation can only build
+        // within one continuous busy burst, and any quiet moment heals it.
+        if slots.len() == self.server.n_seq_max as usize {
+            unsafe { ell_reset(self.server.raw) };
+        }
+        drop(slots);
+        drop(q);
+    }
+}
+
+fn tokens_from_tensor(tensor: &Tensor) -> Result<Vec<i32>, BackendError> {
+    match tensor.ty {
+        TensorType::I32 => {}
+        _ => return Err(BackendError::UnsupportedTensorType(format!("{:?}", tensor.ty))),
+    }
+    if tensor.data.len() % 4 != 0 {
+        return Err(err("token tensor data is not a whole number of i32s"));
+    }
+    Ok(tensor
+        .data
+        .chunks_exact(4)
+        .map(|b| i32::from_le_bytes([b[0], b[1], b[2], b[3]]))
+        .collect())
+}
+
+impl GgmlExecutionContext {
+    fn decode(&mut self, tokens: &[i32]) -> Result<Tensor, BackendError> {
+        let row = self
+            .server
+            .submit(self.seq_id, self.n_past, tokens.to_vec())
+            .map_err(err)?;
+        self.n_past += tokens.len() as i32;
+        let mut data = Vec::with_capacity(row.len() * 4);
+        for v in row {
+            data.extend_from_slice(&v.to_le_bytes());
+        }
+        Ok(Tensor {
+            dimensions: vec![1, self.server.model.n_vocab],
+            ty: TensorType::Fp32,
+            data,
+        })
+    }
+}
+
+impl BackendExecutionContext for GgmlExecutionContext {
+    fn set_input(&mut self, id: Id, tensor: &Tensor) -> Result<(), BackendError> {
+        match id {
+            Id::Index(0) => {}
+            Id::Name(ref n) if n == "tokens" => {}
+            other => return Err(err(format!("unknown input {other:?} (expected \"tokens\")"))),
+        }
+        self.pending = Some(tokens_from_tensor(tensor)?);
+        Ok(())
+    }
+
+    fn compute(
+        &mut self,
+        inputs: Option<Vec<NamedTensor>>,
+    ) -> Result<Option<Vec<NamedTensor>>, BackendError> {
+        match inputs {
+            // WIT path: named tensors in, named tensors out
+            Some(inputs) => {
+                // control verb {"rewind": I32 [1]}: drop this sequence's
+                // tokens from the given position on (a speculative round's
+                // rejected tail) - no decode, no outputs
+                if let Some(rw) = inputs.iter().find(|nt| nt.name == "rewind") {
+                    let v = tokens_from_tensor(&rw.tensor)?;
+                    let n_keep = *v.first().ok_or_else(|| err("rewind needs one i32"))?;
+                    if n_keep < 0 || n_keep > self.n_past {
+                        return Err(err(format!("rewind to {n_keep} outside 0..={}", self.n_past)));
+                    }
+                    self.server.rewind(self.seq_id, n_keep);
+                    self.n_past = n_keep;
+                    return Ok(Some(vec![]));
+                }
+                let tokens = inputs
+                    .iter()
+                    .find(|nt| nt.name == "tokens" || nt.name == "0")
+                    .ok_or_else(|| err("missing \"tokens\" input"))?;
+                let ids = tokens_from_tensor(&tokens.tensor)?;
+                // {"all": I32 [1] = 1} beside "tokens": logits for EVERY fed
+                // position, dims [n, vocab] - the speculative verify step
+                let want_all = inputs.iter().any(|nt| nt.name == "all"
+                    && tokens_from_tensor(&nt.tensor).map(|v| v.first() == Some(&1)).unwrap_or(false));
+                if want_all {
+                    let flat = self
+                        .server
+                        .submit_full(self.seq_id, self.n_past, &ids)
+                        .map_err(err)?;
+                    self.n_past += ids.len() as i32;
+                    let mut data = Vec::with_capacity(flat.len() * 4);
+                    for v in flat {
+                        data.extend_from_slice(&v.to_le_bytes());
+                    }
+                    let t = Tensor {
+                        dimensions: vec![ids.len() as u32, self.server.model.n_vocab],
+                        ty: TensorType::Fp32,
+                        data,
+                    };
+                    self.logits = Some(t.clone());
+                    return Ok(Some(vec![NamedTensor { name: "logits".to_string(), tensor: t }]));
+                }
+                let logits = self.decode(&ids)?;
+                self.logits = Some(logits.clone());
+                Ok(Some(vec![NamedTensor {
+                    name: "logits".to_string(),
+                    tensor: logits,
+                }]))
+            }
+            // WITX path: tokens staged via set_input, result via get_output
+            None => {
+                let ids = self
+                    .pending
+                    .take()
+                    .ok_or_else(|| err("no input staged (call set_input first)"))?;
+                self.logits = Some(self.decode(&ids)?);
+                Ok(None)
+            }
+        }
+    }
+
+    fn get_output(&mut self, id: Id) -> Result<Tensor, BackendError> {
+        match id {
+            Id::Index(0) => {}
+            Id::Name(ref n) if n == "logits" => {}
+            other => return Err(err(format!("unknown output {other:?} (expected \"logits\")"))),
+        }
+        self.logits
+            .clone()
+            .ok_or_else(|| err("no logits available (has `compute` been called?)"))
+    }
+}
