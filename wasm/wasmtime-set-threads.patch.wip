diff --git a/crates/environ/src/component/translate/adapt.rs b/crates/environ/src/component/translate/adapt.rs
index 69d310a..8901e7f 100644
--- a/crates/environ/src/component/translate/adapt.rs
+++ b/crates/environ/src/component/translate/adapt.rs
@@ -191,7 +191,60 @@ impl<'data> Translator<'_, 'data> {
     ///
     /// This will mutate the provided `component` in-place and fill out the dfg
     /// metadata for adapter modules.
-    pub(super) fn partition_adapter_modules(&mut self, component: &mut dfg::ComponentDfg) {
+    pub(super) fn partition_adapter_modules(
+        &mut self,
+        component: &mut dfg::ComponentDfg,
+    ) -> Result<()> {
+        // enclave/SET: refuse, HERE, any fused adapter whose canonical options
+        // name a `shared` linear memory.
+        //
+        // Two reasons this is a compile-time refusal rather than a runtime one.
+        //
+        // 1. It is the only place it can be COMPLETE. FACT generates a core
+        //    module that IMPORTS the adapter's memory, and every adapter that
+        //    moves a string, list or record through memory needs one — not just
+        //    the string transcoders an earlier revision singled out. An
+        //    instantiation-time check over "memories reachable by a transcoder"
+        //    was both narrower than the real set and, as it turned out,
+        //    unreachable.
+        // 2. It is the only place it can be a clean ERROR. FACT emits its
+        //    memory import with `maximum: None`, which is invalid wasm for a
+        //    shared memory, so a component that got this far used to blow up in
+        //    `.expect("invalid adapter module generated")` below — a
+        //    guest-controlled PANIC inside `Component::new`, not a `bail!`.
+        //
+        // Why refuse at all: the host side of these adapters (the transcoder
+        // libcalls, `utf8_to_utf16` and friends) reads raw guest pointers with
+        // no way back to the memory's sharedness, so it cannot be made
+        // copy-safe the way the canonical ABI's own lift/lower paths were. A
+        // component that needs one over memory another thread can write
+        // concurrently is refused, never raced.
+        //
+        // Nothing the SET toolchain emits hits this: a `clang -pthread`
+        // component is one core module plus host imports, and fused adapters
+        // only appear between two core instances of the same component.
+        for (_, adapter) in component.adapters.iter() {
+            for (which, options) in [
+                ("lift", &adapter.lift_options),
+                ("lower", &adapter.lower_options),
+            ] {
+                if let DataModel::LinearMemory {
+                    memory: Some((_, ty)),
+                    ..
+                } = &options.data_model
+                {
+                    if ty.shared {
+                        bail!(
+                            "this component needs a fused adapter ({which}) over a \
+                             `shared` linear memory, which is not supported: the \
+                             adapter's host-side helpers would read memory another \
+                             thread can write concurrently"
+                        );
+                    }
+                }
+            }
+        }
+
         // Visit each adapter, in order of its original definition, during the
         // partitioning. This allows for the guarantee that dependencies are
         // visited in a topological fashion ideally.
@@ -275,6 +328,7 @@ impl<'data> Translator<'_, 'data> {
             let id = component.adapter_modules.push((static_module_index, args));
             assert_eq!(id, module_id);
         }
+        Ok(())
     }
 }
 
