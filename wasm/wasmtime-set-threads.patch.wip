+        // enclave: wasi-threads style REAL parallel threads.
+        //
+        // Upstream deleted `crates/wasi-threads` together with `wasi-common`
+        // (b4b23fe583) and the reason those went in one commit matters: the old
+        // clonable wasi-common ctx was what let each spawned thread get a
+        // `Store` of its own. The modern `wasmtime_wasi` ctx is NOT `Clone`.
+        //
+        // Cloning was never the requirement though — each thread just needs *a*
+        // context. So we build a FRESH one per thread (inheriting stdio, so
+        // printf from a worker still lands on the terminal). The consequence is
+        // honest and worth stating: threads share LINEAR MEMORY, which is what
+        // pthreads actually needs, but they do NOT share a file-descriptor
+        // table. Compute-parallel workloads are unaffected; a program that
+        // opens an fd on one thread and reads it on another is not supported.
+        //
+        // Mechanism (the one measured at 7.8x in tools/parallelism-probe): one
+        // `SharedMemory` imported by every per-thread instance, one `Store` per
+        // OS thread. A `Store` is `!Sync`, so what is shared is the MEMORY,
+        // never the store.
+        let mut wasi_threads_active = false;
+        if let CliLinker::Core(linker) = &mut *linker {
+            let module = main_target.unwrap_core().clone();
+            let wants_threads = module
+                .imports()
+                .any(|i| i.module() == "wasi" && i.name() == "thread-spawn");
+            if wants_threads {
+                let engine = store.engine().clone();
+                // the shared memory every instance (main + threads) imports
+                let Some(mem_ty) = module
+                    .imports()
+                    .find(|i| i.module() == "env" && i.name() == "memory")
+                    .and_then(|i| i.ty().memory().cloned())
+                else {
+                    bail!(
+                        "a wasi-threads module must import its shared memory as `env`/`memory` \
+                         (link with -Wl,--import-memory,--shared-memory)"
+                    );
+                };
+                let shared = wasmtime::SharedMemory::new(&engine, mem_ty)?;
+                linker.define(&mut *store, "env", "memory", shared.clone())?;
+
+                let pre: Arc<OnceLock<wasmtime::InstancePre<Host>>> = Arc::new(OnceLock::new());
+                let tid = Arc::new(std::sync::atomic::AtomicI32::new(1));
+                let argv = self.compute_argv()?;
+                {
+                    let pre = pre.clone();
+                    let tid = tid.clone();
+                    let engine = engine.clone();
+                    linker.func_wrap(
+                        "wasi",
+                        "thread-spawn",
+                        move |_caller: wasmtime::Caller<'_, Host>, start_arg: i32| -> i32 {
+                            let Some(pre) = pre.get().cloned() else {
+                                return -1;
+                            };
+                            let id = tid.fetch_add(1, std::sync::atomic::Ordering::SeqCst);
+                            let engine = engine.clone();
+                            let argv = argv.clone();
+                            let spawned = std::thread::Builder::new()
+                                .name(format!("wasi-thread-{id}"))
+                                .spawn(move || {
+                                    // a FRESH context for this thread
+                                    let mut b = wasmtime_wasi::WasiCtxBuilder::new();
+                                    b.args(&argv);
+                                    b.inherit_stdin();
+                                    b.inherit_stdout();
+                                    b.inherit_stderr();
