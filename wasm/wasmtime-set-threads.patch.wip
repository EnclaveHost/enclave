diff --git a/Cargo.toml b/Cargo.toml
index 6aafcf9..651816f 100644
--- a/Cargo.toml
+++ b/Cargo.toml
@@ -790,3 +790,9 @@ fpr = "fpr"
 
 [workspace.metadata.typos.files]
 extend-exclude = [ "docs/js/mermaid*.js", "crates/wasi-nn/**/*.txt", "*.isle" ]
+
+# enclave/SET: wasmparser fork — accepts a PLAIN spawn type/table for the
+# thread.spawn-* canon builtins (this engine gives workers per-thread views,
+# so unshared state is per-thread; see vendor/wasmparser edits + docs).
+[patch.crates-io]
+wasmparser = { path = "vendor/wasmparser" }
