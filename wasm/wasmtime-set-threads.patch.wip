diff --git a/tests/all/component_model/set_threads.rs b/tests/all/component_model/set_threads.rs
new file mode 100644
index 0000000..f0c7211
--- /dev/null
+++ b/tests/all/component_model/set_threads.rs
@@ -0,0 +1,189 @@
+//! enclave/SET: tests for the shared-everything-threads worker model that a
+//! guest probe cannot reach.
+//!
+//! The guest-side behaviour (spawning, teardown, WASI on a worker, the death
+//! hook) is covered by `tools/parallelism-probe` in the enclave repo, which
+//! runs real programs through the real toolchain. What lives here is the
+//! HOST-side contract with the embedder, which no guest can exercise.
+
+use super::*;
+use std::sync::Arc;
+use std::sync::atomic::{AtomicUsize, Ordering};
+use wasmtime::component::{Component, Linker, SetWorkerHost, SetWorkerRequest};
+use wasmtime::{Config, Engine, Store};
+
+fn set_config() -> Config {
+    let mut config = Config::new();
+    config.wasm_component_model(true);
+    config.wasm_component_model_threading(true);
+    config.wasm_shared_everything_threads(true);
+    config.wasm_threads(true);
+    config.shared_memory(true);
+    config
+}
+
+/// A component whose exported `run` spawns one worker and returns the spawn
+/// result: `>= 0` for a thread id, `-1` for the ABI's "spawn failed".
+///
+/// It deliberately does NOT join: these tests are about what the HOST does
+/// with a worker, and store teardown is what collects it.
+const SPAWN_AND_RETURN: &str = r#"
+(component
+  (core type $start (shared (func (param i32))))
+
+  ;; The module that DEFINES the shared memory and the worker table is the one
+  ;; a worker is spawned from, which is what the spawn guards require.
+  (core module $a
+    (type $start_t (shared (func (param i32))))
+    (memory (export "memory") 1 1 shared)
+    (table (export "workers") shared 1 1 (ref null (shared func)))
+    (func $worker (type $start_t) (param $ctx i32)
+      (drop (i32.atomic.rmw.add (i32.const 0) (i32.const 1)))
+      (drop (memory.atomic.notify (i32.const 0) (i32.const -1))))
+    (elem (table 0) (i32.const 0) (ref null (shared func)) (ref.func $worker))
+  )
+  (core instance $ia (instantiate $a))
+  (alias core export $ia "workers" (core table $t))
+  (alias core export $ia "memory" (core memory $mem))
+
+  (core func $spawn (canon thread.spawn-indirect $start (table $t)))
+
+  (core module $b
+    (type $spawn_t (shared (func (param i32 i32) (result i32))))
+    (import "env" "memory" (memory 1 1 shared))
+    (import "env" "spawn" (func $spawn (type $spawn_t)))
+    ;; Returns the spawn result verbatim: a thread id, or the ABI's -1.
+    (func (export "run") (result i32)
+      (call $spawn (i32.const 0) (i32.const 0)))
+  )
+  (core instance $ib (instantiate $b (with "env" (instance
+    (export "memory" (memory $mem))
+    (export "spawn" (func $spawn))))))
+  (alias core export $ib "run" (core func $run))
+  (func (export "run") (result s32) (canon lift (core func $run)))
+)
+"#;
+
+/// A panic on a worker must NOT take the process down.
+///
+/// It used to: `worker_main` caught the panic and called
+/// `std::process::abort()`. That turned any engine- or EMBEDDER-side panic
+/// into a whole-process kill, and the embedder side is guest-reachable — the
+/// wasmtime CLI's own WASI accessors `unwrap()` per-subsystem contexts, so a
+/// worker whose `Host` was missing one panicked on the guest's first call to
+/// that subsystem. Three guest instructions under `-S http` were enough.
+///
+/// If this regresses, the test binary dies rather than failing, which is
+/// exactly the point being made.
+#[tokio::test]
+async fn worker_panic_does_not_abort_the_process() -> Result<()> {
+    struct PanickingHost {
+        entered: Arc<AtomicUsize>,
+    }
+    impl SetWorkerHost for PanickingHost {
+        fn run_worker(&self, _req: SetWorkerRequest) -> Result<()> {
+            self.entered.fetch_add(1, Ordering::SeqCst);
+            panic!("embedder-side panic on a SET worker");
+        }
+    }
+
+    let engine = Engine::new(&set_config())?;
+    let component = Component::new(&engine, SPAWN_AND_RETURN)?;
+    let linker = Linker::new(&engine);
+    let mut store = Store::new(&engine, ());
+    let entered = Arc::new(AtomicUsize::new(0));
+    store.set_set_worker_host(Arc::new(PanickingHost {
+        entered: entered.clone(),
+    }));
+
+    let instance = linker.instantiate_async(&mut store, &component).await?;
+    let run = instance.get_typed_func::<(), (i32,)>(&mut store, "run")?;
+    let (tid,) = run.call_async(&mut store, ()).await?;
+    assert!(tid >= 0, "spawn should have succeeded, got {tid}");
+
+    // Teardown asks the worker to stop and joins with a BOUND, detaching a
+    // straggler rather than blocking (that is the whole point of the design
+    // this file also tests). So `drop` returning says nothing about whether the
+    // worker has been entered yet, and asserting on `entered` straight
+    // afterwards is a race against that design -- it failed 3/3 serially,
+    // reading 0.
+    //
+    // Wait for the observation instead of assuming teardown produced it. The
+    // property under test is unchanged and is still the important one: a PANIC
+    // on a worker must not take the process down, so reaching the end of this
+    // function at all is the assertion. The wait only makes the secondary check
+    // ("the host really was entered") deterministic.
+    drop(store);
+    let deadline = std::time::Instant::now() + std::time::Duration::from_secs(10);
+    while entered.load(Ordering::SeqCst) == 0 && std::time::Instant::now() < deadline {
+        // `sleep`, not `yield_now`: the awaited event is one OS thread doing a
+        // single `fetch_add`, so latency is irrelevant, while a tight
+        // `sched_yield` loop burns a core for the whole deadline and only
+        // yields to runnable same-priority threads -- on an oversubscribed CI
+        // box that makes this test MORE flaky, not less.
+        std::thread::sleep(std::time::Duration::from_millis(1));
+    }
+    assert_eq!(entered.load(Ordering::SeqCst), 1);
+    Ok(())
+}
+
+/// A worker that never returns must not wedge teardown.
+///
+/// `Store::drop` used to join unconditionally, on a rule inherited from the
+/// revision where a worker really did borrow the primary's import records. It
+/// does not any more, so the join is bounded and a straggler is detached.
+/// Without the bound this test hangs forever.
+#[tokio::test]
+async fn teardown_does_not_wedge_on_a_worker_that_never_returns() -> Result<()> {
+    struct BlockingHost {
+        stop: Arc<AtomicUsize>,
+    }
+    impl SetWorkerHost for BlockingHost {
+        fn run_worker(&self, req: SetWorkerRequest) -> Result<()> {
+            // Not a guest at all: an embedder that simply does not return.
+            // Teardown must not depend on it.
+            while !req.thread_group().stop_requested() {
+                std::thread::sleep(std::time::Duration::from_millis(500));
+            }
+            self.stop.fetch_add(1, Ordering::SeqCst);
+            Ok(())
+        }
+    }
+
+    let engine = Engine::new(&set_config())?;
+    let component = Component::new(&engine, SPAWN_AND_RETURN)?;
+    let linker = Linker::new(&engine);
+    let mut store = Store::new(&engine, ());
+    store.set_set_worker_host(Arc::new(BlockingHost {
+        stop: Arc::new(AtomicUsize::new(0)),
+    }));
+
+    let instance = linker.instantiate_async(&mut store, &component).await?;
+    let run = instance.get_typed_func::<(), (i32,)>(&mut store, "run")?;
+    let (tid,) = run.call_async(&mut store, ()).await?;
+    assert!(tid >= 0);
+
+    let start = std::time::Instant::now();
+    drop(store);
+    let elapsed = start.elapsed();
+    assert!(
+        elapsed < std::time::Duration::from_secs(20),
+        "teardown took {elapsed:?}; the join is supposed to be bounded"
+    );
+    Ok(())
+}
+
+/// Spawn refuses rather than half-building a thread when no host is registered.
+#[tokio::test]
+async fn spawn_refuses_without_an_embedder_host() -> Result<()> {
+    let engine = Engine::new(&set_config())?;
+    let component = Component::new(&engine, SPAWN_AND_RETURN)?;
+    let linker = Linker::new(&engine);
+    let mut store = Store::new(&engine, ());
+
+    let instance = linker.instantiate_async(&mut store, &component).await?;
+    let run = instance.get_typed_func::<(), (i32,)>(&mut store, "run")?;
+    let (tid,) = run.call_async(&mut store, ()).await?;
+    assert_eq!(tid, -1, "spawn must return the ABI's failure, not a thread");
+    Ok(())
+}
