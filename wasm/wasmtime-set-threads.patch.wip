diff --git a/crates/wasmtime/src/runtime/vm/component/libcalls.rs b/crates/wasmtime/src/runtime/vm/component/libcalls.rs
index f62ea58d9c..aee8f6802d 100644
--- a/crates/wasmtime/src/runtime/vm/component/libcalls.rs
+++ b/crates/wasmtime/src/runtime/vm/component/libcalls.rs
@@ -693,6 +693,64 @@ fn exit_sync_call(store: &mut dyn VMStore, instance: Instance) -> Result<()> {
     store.exit_guest_sync_call()
 }
 
+// enclave/SET: `thread.available-parallelism`.
+//
+// How many threads can ACTUALLY run at once. On a multi-tenant node the honest
+// answer is not the host's core count — a guest that sizes its pool from
+// `nproc` on a 32-core box while holding a 0.25 share just builds 32 threads
+// to contend over 8 cores' worth of cgroup weight. So the tenant's slice wins
+// when the embedder tells us what it is: ENCLAVE_AVAILABLE_PARALLELISM is set
+// per-deployment by the app manager from the purchased cpuShare (the same
+// shape as the MPS/VRAM caps it already passes). Absent that, fall back to the
+// host's parallelism, which is the right answer for a plain `wasmtime run`.
+//
+// Never returns 0: a guest that reads 0 typically divides by it.
+fn thread_available_parallelism(_store: &mut dyn VMStore, _instance: Instance) -> Result<u32> {
+    let n = match std::env::var("ENCLAVE_AVAILABLE_PARALLELISM") {
+        Ok(v) => v.trim().parse::<u32>().unwrap_or(0),
+        Err(_) => 0,
+    };
+    if n > 0 {
+        return Ok(n);
+    }
+    Ok(std::thread::available_parallelism()
+        .map(|n| n.get() as u32)
+        .unwrap_or(1))
+}
+
+// enclave/SET: `thread.spawn-ref` / `thread.spawn-indirect`.
+//
+// Returns -1, the ABI's "spawn failed", and that is the honest answer on this
+// engine rather than a placeholder. Shared-everything-threads means the new
+// thread runs in the SAME instance — same memory, same tables, same globals —
+// and wasmtime cannot do that today: entering guest code takes `&mut Store`,
+// which is exclusive by construction (the borrow checker refuses two threads
+// on one store). The trick that made wasi-threads work — a separate `Store`
+// per thread over one IMPORTED shared memory — does not generalise to
+// components either, because a component instantiates its own memory
+// internally and cannot import a memory instance from outside. Two component
+// instances are two memories, which is the opposite of shared-everything.
+//
+// Making this return a real thread id needs wasmtime's execution model to
+// become thread-safe (store bookkeeping, fuel, epoch interruption, trap
+// handling, stack limits, GC roots). Until then the RIGHT behaviour is the
+// spec's documented failure path, because it keeps SET components LOADABLE
+// and RUNNABLE: a guest calls spawn, sees the failure, and takes its
+// sequential fallback — instead of the whole component being rejected at
+// translation time, which is what happened before this.
+//
+// Pairs with `thread.available_parallelism`, which reports the tenant's real
+// slice: a guest that checks it first never asks to spawn in the first place.
+// See docs/wasm-parallelism.md.
+fn thread_spawn(
+    _store: &mut dyn VMStore,
+    _instance: Instance,
+    _args: *mut u8,
+    _nargs: usize,
+) -> Result<u32> {
+    Ok(-1i32 as u32)
+}
+
 #[cfg(feature = "component-model-async")]
 fn backpressure_modify(
     store: &mut dyn VMStore,
