+/// enclave/SET: the parts every worker of this server needs, built once.
+#[cfg(feature = "threads")]
+struct SetWorkerShared {
+    cmd: ServeCommand,
+    engine: Engine,
+    pre: wasmtime::component::InstancePre<Host>,
+}
+
+/// enclave/SET: runs one spawned worker for `wasmtime serve`.
+///
+/// A worker gets a store built exactly the way a request's store is built —
+/// its own `WasiCtx`, resource table and HTTP context — because component
+/// resource handles are per-instance and cannot be shared across threads. What
+/// IS shared is linear memory, which is what pthreads needs.
+///
+/// Not carried into a worker: the guest profiler and the profile writer, which
+/// are per-request artifacts of the primary store.
+#[cfg(feature = "threads")]
+struct SetWorkerHostForServe {
+    shared: std::sync::Arc<SetWorkerShared>,
+}
+
+#[cfg(feature = "threads")]
+impl wasmtime::component::SetWorkerHost for SetWorkerHostForServe {
+    /// See `run.rs`: a worker that called `proc_exit` ends the component, and
+    /// only the embedder can recognise the WASI error that says so.
+    fn exit_status(&self, err: &wasmtime::Error) -> Option<i32> {
+        err.downcast_ref::<wasmtime_wasi::I32Exit>().map(|e| e.0)
+    }
+
+    fn run_worker(&self, req: wasmtime::component::SetWorkerRequest) -> Result<()> {
+        let shared = &self.shared;
+        // `new_store` is the SAME function that builds a request's store, so a
+        // worker has every context the linker's accessors `unwrap()`. That is
+        // load-bearing, not tidy: a worker instantiates against the primary's
+        // linker, and a missing context is a guest-triggerable panic. See
+        // `run.rs::build_host` for the version of this that had to be fixed.
+        let mut store = shared.cmd.new_store(&shared.engine, None)?;
+        let group = req.thread_group().clone();
+        // See `run.rs` for why the guest future is raced against the stop flag:
+        // a worker blocked in a host call reaches no epoch check and is not
+        // parked in a futex, and under `serve` each one permanently consumes a
+        // tokio worker.
+        let stop = group.clone();
+        let result = wasmtime_wasi::runtime::in_tokio(async {
+            tokio::select! {
+                biased;
+                r = req.run_async(&mut store, &shared.pre) => r,
+                _ = async {
+                    while !stop.stop_requested() {
+                        tokio::time::sleep(Duration::from_millis(5)).await;
+                    }
+                } => Err(wasmtime::Error::msg(
+                    "shared-everything-threads worker cancelled while blocked in a host                      call (its store is being torn down, or another thread called                      `proc_exit`)",
+                )),
+            }
+        });
