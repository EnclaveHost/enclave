diff --git a/crates/wasmtime/src/runtime/vm/component/libcalls.rs b/crates/wasmtime/src/runtime/vm/component/libcalls.rs
index f62ea58..31a4314 100644
--- a/crates/wasmtime/src/runtime/vm/component/libcalls.rs
+++ b/crates/wasmtime/src/runtime/vm/component/libcalls.rs
@@ -693,6 +693,116 @@ fn exit_sync_call(store: &mut dyn VMStore, instance: Instance) -> Result<()> {
     store.exit_guest_sync_call()
 }
 
+// enclave/SET: `thread.available-parallelism`.
+//
+// How many threads can ACTUALLY run at once. On a multi-tenant node the honest
+// answer is not the host's core count — a guest that sizes its pool from
+// `nproc` on a 32-core box while holding a 0.25 share just builds 32 threads
+// to contend over 8 cores' worth of cgroup weight. So the tenant's slice wins
+// when the embedder tells us what it is: ENCLAVE_AVAILABLE_PARALLELISM is set
+// per-deployment by the app manager from the purchased cpuShare (the same
+// shape as the MPS/VRAM caps it already passes). Absent that, fall back to the
+// host's parallelism, which is the right answer for a plain `wasmtime run`.
+//
+// Never returns 0: a guest that reads 0 typically divides by it.
+fn thread_available_parallelism(_store: &mut dyn VMStore, _instance: Instance) -> Result<u32> {
+    let n = match std::env::var("ENCLAVE_AVAILABLE_PARALLELISM") {
+        Ok(v) => v.trim().parse::<u32>().unwrap_or(0),
+        Err(_) => 0,
+    };
+    if n > 0 {
+        return Ok(n);
+    }
+    Ok(std::thread::available_parallelism()
+        .map(|n| n.get() as u32)
+        .unwrap_or(1))
+}
+
+// enclave/SET: `thread.spawn-ref` / `thread.spawn-indirect`.
+//
+// REAL OS threads: each spawned thread runs the shared start function in a
+// per-thread execution view of the defining instance — its own `Store` (so
+// per-execution state stays exclusive by construction), its own vmctx, and
+// the PRIMARY's `SharedMemory` re-pointed into it so linear memory is
+// physically shared. Design, guards and soundness argument live in
+// `super::set_threads`; the measured result lives in docs/wasm-parallelism.md.
+//
+// Returns the new thread's id (>= 1), or -1 ("spawn failed", which the ABI
+// defines and guests are required to handle) for module shapes the view
+// cannot faithfully represent yet — those log a diagnostic. Traps only on
+// guest bugs (null/ill-typed start function).
+//
+// The result type is NOT `Result<u32>`: its unwind sentinel is `u64::MAX`,
+// aka -1, which the NegativeTwo trampoline arm would pass through to the
+// guest as a fake "spawn failed" while leaving the recorded trap pending in
+// TLS. `ThreadSpawnResult` puts the unwind sentinel at `u64::MAX - 1` (-2),
+// matching the trampoline.
+#[derive(Copy, Clone)]
+pub(crate) struct ThreadSpawnResult(pub i32);
+
+impl ThreadSpawnResult {
+    pub(crate) const FAILED: ThreadSpawnResult = ThreadSpawnResult(-1);
+}
+
+unsafe impl crate::runtime::vm::HostResultHasUnwindSentinel for ThreadSpawnResult {
+    type Abi = u64;
+    const SENTINEL: u64 = u64::MAX - 1;
+    fn into_abi(self) -> u64 {
+        // Zero-extend the i32: -1 becomes 0xFFFF_FFFF, which the trampoline
+        // truncates back to the guest-visible i32 -1 and which can never
+        // collide with the trap sentinel above.
+        self.0 as u32 as u64
+    }
+}
+
+#[cfg(all(feature = "std", feature = "threads"))]
+fn thread_spawn_ref(
+    store: &mut dyn VMStore,
+    _instance: Instance,
+    funcref: *mut u8,
+    arg: u32,
+) -> Result<ThreadSpawnResult> {
+    super::set_threads::spawn_ref(store, funcref, arg)
+}
+
+#[cfg(all(feature = "std", feature = "threads"))]
+fn thread_spawn_indirect(
+    store: &mut dyn VMStore,
+    instance: Instance,
+    table: u32,
+    elem: u32,
+    arg: u32,
+) -> Result<ThreadSpawnResult> {
+    super::set_threads::spawn_indirect(
+        store,
+        instance,
+        wasmtime_environ::component::RuntimeTableIndex::from_u32(table),
+        elem,
+        arg,
+    )
+}
+
+#[cfg(not(all(feature = "std", feature = "threads")))]
+fn thread_spawn_ref(
+    _store: &mut dyn VMStore,
+    _instance: Instance,
+    _funcref: *mut u8,
+    _arg: u32,
+) -> Result<ThreadSpawnResult> {
+    Ok(ThreadSpawnResult::FAILED)
+}
+
+#[cfg(not(all(feature = "std", feature = "threads")))]
+fn thread_spawn_indirect(
+    _store: &mut dyn VMStore,
+    _instance: Instance,
+    _table: u32,
+    _elem: u32,
+    _arg: u32,
+) -> Result<ThreadSpawnResult> {
+    Ok(ThreadSpawnResult::FAILED)
+}
+
 #[cfg(feature = "component-model-async")]
 fn backpressure_modify(
     store: &mut dyn VMStore,
diff --git a/crates/wasmtime/src/runtime/vm/component/set_threads.rs b/crates/wasmtime/src/runtime/vm/component/set_threads.rs
new file mode 100644
index 0000000..f4a7901
--- /dev/null
+++ b/crates/wasmtime/src/runtime/vm/component/set_threads.rs
@@ -0,0 +1,391 @@
+//! enclave/SET: real OS-thread spawning for the shared-everything-threads
+//! `thread.spawn-ref` / `thread.spawn-indirect` component intrinsics.
+//!
+//! # Design: per-thread execution views over shared instance state
+//!
+//! Wasmtime's execution model requires `&mut Store` to enter guest code, and
+//! per-execution state (stack limits, last-wasm entry/exit SP+FP, the epoch
+//! deadline, fuel) lives in the store's `VMStoreContext`, reached from the
+//! instance's vmctx. Two OS threads through one vmctx would therefore corrupt
+//! each other's execution state — that, not codegen, is what makes a naive
+//! "share the Store" implementation unsound, and `unsafe impl Sync for Store`
+//! would merely hide it.
+//!
+//! Instead each spawned thread gets its OWN `Store` (so the borrow checker
+//! keeps enforcing execution exclusivity everywhere, unchanged) holding an
+//! *execution view* of the primary instance:
+//!
+//! * the view is a fresh instantiation of the SAME module, against the SAME
+//!   already-resolved import records the primary was instantiated with;
+//! * its defined shared memories are then re-pointed at the primary's
+//!   `SharedMemory` (an `Arc` whose `VMMemoryDefinition` all instances share,
+//!   with growth behind a lock — the exact mechanism wasmtime already uses
+//!   for shared memories between stores), so linear memory is PHYSICALLY the
+//!   same memory;
+//! * its plain (numeric/vector) globals are snapshotted from the primary at
+//!   spawn time;
+//! * the start function is invoked through the VIEW's own funcref, so all
+//!   code the thread runs enters through the view's vmctx and the worker
+//!   store's `VMStoreContext`. Traps, backtraces, signals and epochs work
+//!   because N threads × N stores is already-supported wasmtime usage.
+//!
+//! Sharedness of the state a *valid* SET guest can actually reach from a
+//! spawned function on this engine:
+//!
+//! * memory: physically shared (above);
+//! * tables: per-view, materialized from the same initializers. Cranelift
+//!   rejects `table.atomic.*` ("not yet implemented" upstream), so no guest
+//!   this engine can compile is able to express cross-thread table mutation;
+//! * globals: snapshot at spawn. `global.atomic.*` equally does not compile,
+//!   and modules with MUTABLE `shared` globals are refused at spawn (below)
+//!   rather than silently diverging.
+//!
+//! # Lifetime / soundness invariants
+//!
+//! The worker holds raw pointers into the primary store (import records whose
+//! `vmctx`/`from` pointers target the primary component and its instances).
+//! Those stay valid because:
+//!
+//! 1. every spawn registers its `JoinHandle` with the PRIMARY store, and
+//!    `StoreOpaque::drop` joins them before deallocating anything;
+//! 2. a worker thread never calls back into the primary store: component
+//!    intrinsics and canon-lowered host imports all enter through
+//!    `ComponentInstance::enter_host_from_wasm`, which aborts the process if
+//!    entered from a thread that does not own the component's store. This is
+//!    defense in depth — shared-everything-threads validation already forbids
+//!    shared functions from calling unshared imports — and failing closed is
+//!    the correct posture for a runtime measured into a TEE attestation.
+//!
+//! Spawn refuses (returns the ABI's `-1` failure, with a diagnostic on
+//! stderr) any module shape whose view would NOT be faithful: non-shared
+//! defined memories, imported tables/globals, imported core-wasm functions,
+//! mutable `shared` globals, a wasm `start` section, or GC use.
+
+use crate::prelude::*;
+use crate::runtime::vm::component::libcalls::ThreadSpawnResult;
+use crate::runtime::vm::instance::CopiedImports;
+use crate::runtime::vm::memory::SharedMemory;
+use crate::runtime::vm::{Instance as VmInstance, VMFuncRef, VMStore};
+use crate::store::{Asyncness, StoreOpaque};
+use crate::{AsContextMut, Engine, Module, Store, Val};
+use core::pin::Pin;
+use core::ptr::NonNull;
+use core::sync::atomic::{AtomicU64, Ordering};
+use wasmtime_environ::component::RuntimeTableIndex;
+use wasmtime_environ::{DefinedGlobalIndex, DefinedMemoryIndex, FuncIndex, VMCONTEXT_MAGIC};
+
+/// Monotonic SET thread ids handed back to guests. Non-negative i32 range;
+/// starts at 1 (0 is reserved by convention for "the main thread").
+static NEXT_SET_THREAD_ID: AtomicU64 = AtomicU64::new(1);
+
+/// Everything a worker thread needs to build and run its execution view.
+struct SpawnPayload {
+    engine: Engine,
+    module: Module,
+    imports: CopiedImports,
+    shared_memories: Vec<(DefinedMemoryIndex, SharedMemory)>,
+    global_snapshot: Vec<(DefinedGlobalIndex, [u8; 16])>,
+    func_index: FuncIndex,
+    start_arg: i32,
+    thread_id: i64,
+}
+
+// SAFETY: the raw pointers inside `imports` point at engine-lifetime data
+// (compiled code, builtin arrays) and at the primary store's component and
+// core instances. The primary store joins every spawned worker in its `Drop`
+// before any of that is deallocated, and the cross-thread entry guard in
+// `enter_host_from_wasm` prevents the worker from ever turning those pointers
+// into `&mut` access of the primary store.
+unsafe impl Send for SpawnPayload {}
+
+/// `thread.spawn-ref`: `funcref` is the guest's `(ref null (shared func))`
+/// argument, passed by the trampoline as a raw pointer.
+pub(crate) fn spawn_ref(
+    store: &mut dyn VMStore,
+    funcref: *mut u8,
+    arg: u32,
+) -> Result<ThreadSpawnResult> {
+    let Some(funcref) = NonNull::new(funcref.cast::<VMFuncRef>()) else {
+        // A null start function can never run; the ABI's failure result is
+        // reserved for resource exhaustion, so this is a guest bug => trap.
+        bail!("thread.spawn-ref: start function reference is null");
+    };
+    spawn_funcref(store.store_opaque_mut(), funcref, arg)
+}
+
+/// `thread.spawn-indirect`: resolve `elem` in the canon-declared table, on
+/// the calling (store-owning) thread, then spawn like `spawn-ref`.
+pub(crate) fn spawn_indirect(
+    store: &mut dyn VMStore,
+    instance: crate::component::Instance,
+    table: RuntimeTableIndex,
+    elem: u32,
+    arg: u32,
+) -> Result<ThreadSpawnResult> {
+    let store = store.store_opaque_mut();
+    let func = {
+        let (component, registry) = instance.id().get_mut_and_registry(store);
+        component.index_runtime_func_table(registry, table, u64::from(elem))?
+    };
+    let Some(func) = func else {
+        bail!("thread.spawn-indirect: table element {elem} is uninitialized");
+    };
+    let funcref = func.vm_func_ref(store);
+    spawn_funcref(store, funcref, arg)
+}
+
+/// Common spawn path. Runs on the thread that owns the primary store, with
+/// `&mut StoreOpaque` legally held — every read of primary state happens
+/// here, not on the worker.
+fn spawn_funcref(
+    store: &mut StoreOpaque,
+    funcref: NonNull<VMFuncRef>,
+    arg: u32,
+) -> Result<ThreadSpawnResult> {
+    // The ABI's graceful failure: log why, hand the guest -1, let it take its
+    // sequential fallback.
+    //
+    // The stderr copy is printed ONCE per process. A guest whose module shape
+    // is unsupported typically calls spawn in a loop (once per worker it
+    // wanted), and the diagnostic is there to tell a developer why their
+    // threads did not appear — not to reprint that answer thousands of times
+    // into a tenant's logs. `log::warn!` still fires every time for anyone
+    // who wants the full trace.
+    macro_rules! refuse {
+        ($($msg:tt)*) => {{
+            log::warn!($($msg)*);
+            static ONCE: std::sync::Once = std::sync::Once::new();
+            ONCE.call_once(|| {
+                eprintln!(
+                    "wasmtime: thread.spawn refused: {} (further refusals logged at warn level only)",
+                    format_args!($($msg)*)
+                );
+            });
+            return Ok(ThreadSpawnResult::FAILED);
+        }};
+    }
+
+    let fr = unsafe { funcref.as_ref() };
+
+    // The start function must be plain core wasm — a component trampoline or
+    // host function cannot be the body of a spawned thread.
+    let vmctx_magic = unsafe { *funcref.as_ref().vmctx.as_non_null().cast::<u32>().as_ref() };
+    if vmctx_magic != VMCONTEXT_MAGIC {
+        bail!("thread.spawn: start function is not a core wasm function");
+    }
+
+    // Signature check: the SET spawn ABI start type is `(func (param i32))`.
+    {
+        let ty = crate::FuncType::from_shared_type_index(store.engine(), fr.type_index);
+        let ok = ty.results().len() == 0
+            && ty.params().len() == 1
+            && matches!(ty.params().next(), Some(crate::ValType::I32));
+        if !ok {
+            bail!("thread.spawn: start function must have type (param i32) -> ()");
+        }
+    }
+
+    // SAFETY: the magic check above proved this is a core-module vmctx, and
+    // it belongs to this store's component (checked right below), so deriving
+    // a shared reference while we hold `&mut StoreOpaque` is sound.
+    let defining: NonNull<VmInstance> =
+        unsafe { VmInstance::from_vmctx(funcref.as_ref().vmctx.as_non_null().cast()) };
+    let defining = unsafe { defining.as_ref() };
+    if !defining.belongs_to_store(store) {
+        bail!("thread.spawn: start function belongs to a different store");
+    }
+
+    let Some(func_index) = defining.func_index_of_func_ref(funcref) else {
+        refuse!("start funcref is not one of its defining instance's escaped functions");
+    };
+
+    // ---- v1 module-shape guards: refuse any shape whose execution view ----
+    // ---- would not faithfully share state with the primary instance.  ----
+    let module = defining.env_module();
+
+    if module.has_guest_start {
+        refuse!("module has a wasm `start` section (unsupported on SET threads)");
+    }
+    if module.needs_gc_heap {
+        refuse!("module requires a GC heap (unsupported on SET threads)");
+    }
+    for (idx, mem) in module.memories.iter() {
+        if !mem.shared {
+            refuse!(
+                "memory {} is not `shared`; every memory of a module spawning \
+                 SET threads must be shared",
+                idx.as_u32()
+            );
+        }
+    }
+    if module.num_imported_tables != 0 {
+        refuse!("module imports a table (unsupported on SET threads)");
+    }
+    if module.num_imported_globals != 0 {
+        refuse!("module imports a global (unsupported on SET threads)");
+    }
+    for (idx, global) in module.globals.iter() {
+        if global.shared && global.mutability {
+            refuse!(
+                "global {} is mutable and `shared`; cross-thread global \
+                 mutation is not implemented (guests coordinate through \
+                 shared memory)",
+                idx.as_u32()
+            );
+        }
+    }
+    let Some(runtime_module) = defining.runtime_module() else {
+        refuse!("cannot spawn from a synthetic module");
+    };
+    let runtime_module = runtime_module.clone();
+
+    let imports = defining.copy_raw_imports();
+
+    // Imported functions must not be other core-wasm functions: a view
+    // calling one would execute a foreign instance with the PRIMARY's
+    // execution state from the worker thread. Component trampolines are fine
+    // to import (the cross-thread entry guard makes calling one fail closed,
+    // and validation prevents valid guests from doing so).
+    for (i, import) in imports.functions.iter().enumerate() {
+        let magic = unsafe { *import.vmctx.as_non_null().cast::<u32>().as_ref() };
+        if magic == VMCONTEXT_MAGIC {
+            refuse!(
+                "imported function {i} is another core module's function \
+                 (cross-instance SET threads are unsupported)"
+            );
+        }
+    }
+
+    // ---- capture ----
+    let thread_id = NEXT_SET_THREAD_ID.fetch_add(1, Ordering::Relaxed) as i64;
+    if thread_id > i64::from(i32::MAX) {
+        return Ok(ThreadSpawnResult::FAILED);
+    }
+    let payload = SpawnPayload {
+        engine: store.engine().clone(),
+        module: runtime_module,
+        imports,
+        shared_memories: defining.defined_shared_memories_cloned(),
+        global_snapshot: defining.snapshot_plain_globals(),
+        func_index,
+        start_arg: arg as i32,
+        thread_id,
+    };
+
+    let handle = std::thread::Builder::new()
+        .name(format!("set-thread-{thread_id}"))
+        .spawn(move || worker_main(payload));
+    match handle {
+        Ok(handle) => {
+            store.push_set_thread_join(handle);
+            Ok(ThreadSpawnResult(thread_id as i32))
+        }
+        Err(e) => {
+            log::warn!("thread.spawn: OS thread creation failed: {e}");
+            Ok(ThreadSpawnResult::FAILED)
+        }
+    }
+}
+
+/// Body of a spawned SET thread: build the execution view, run the start
+/// function, tear the view down.
+fn worker_main(payload: SpawnPayload) {
+    let thread_id = payload.thread_id;
+
+    // A guest TRAP is normal operation: it unwinds into `call` inside
+    // `run_view` and arrives here as `Err`. wasi-threads precedent applies —
+    // a thread that traps takes the program with it, the way a segfault
+    // would, because its siblings are mid-computation over memory whose
+    // invariants the trapping thread may have been halfway through
+    // re-establishing.
+    //
+    // A Rust PANIC is different: it means an engine bug, on a thread holding
+    // raw pointers into another store, with shared memory in an unknown
+    // state. Letting it unwind into `std::thread`'s backstop would leave the
+    // process running on state we have no story for, and would surface only
+    // as a warning at join time. Catch it and stop.
+    let result =
+        std::panic::catch_unwind(std::panic::AssertUnwindSafe(|| run_view(payload)));
+    match result {
+        Ok(Ok(())) => {}
+        Ok(Err(e)) => {
+            eprintln!("set-thread-{thread_id}: {e:?}");
+            std::process::exit(1);
+        }
+        Err(_) => {
+            // The default panic hook has already printed the payload and
+            // location by this point.
+            eprintln!(
+                "wasmtime: fatal: panic on shared-everything-threads worker \
+                 set-thread-{thread_id}; aborting"
+            );
+            std::process::abort();
+        }
+    }
+}
+
+fn run_view(payload: SpawnPayload) -> Result<()> {
+    let mut store: Store<()> = Store::new(&payload.engine, ());
+    // A fresh store's epoch deadline is 0, which means "trap at the first
+    // epoch check" once the engine's epoch has ever been bumped. SET workers
+    // are not individually interruptible in v1; the process watchdog owns
+    // their lifetime.
+    store.set_epoch_deadline(u64::MAX / 2);
+    let _ = store.set_fuel(u64::MAX);
+
+    let mut ctx = store.as_context_mut();
+
+    // Re-instantiate the defining module against the primary's own resolved
+    // import records. Element segments and (complex) global initializers run
+    // against THIS view; active data segments are applied to the view's
+    // freshly-created memories, which are thrown away below when the shared
+    // ones are re-pointed at the primary's. There is no wasm `start` section
+    // (guarded at spawn).
+    //
+    // SAFETY (new_started): the import records come verbatim from an
+    // instantiation of this exact module, so they are type-correct by
+    // construction; `Send`ing them here is covered by the invariants on
+    // `SpawnPayload`.
+    let instance = crate::runtime::vm::assert_ready(unsafe {
+        crate::Instance::new_started(
+            &mut ctx,
+            &payload.module,
+            payload.imports.as_imports(),
+            Asyncness::No,
+        )
+    })?;
+    let id = instance.id();
+
+    {
+        let opaque = ctx.0.store_opaque_mut();
+        let mut vminstance: Pin<&mut VmInstance> = opaque.instance_mut(id);
+        for (index, shared) in payload.shared_memories {
+            // SAFETY: no guest code has run in this view yet; the memory is
+            // declared shared (enforced at spawn), so the vmctx slot is the
+            // out-of-line pointer form.
+            unsafe {
+                vminstance
+                    .as_mut()
+                    .replace_defined_memory_with_shared(index, shared);
+            }
+        }
+        vminstance.write_plain_globals(&payload.global_snapshot);
+    }
+
+    // Invoke the start function through the VIEW's funcref: same compiled
+    // code as the primary, entered with the view's vmctx and this store's
+    // execution state.
+    let func = {
+        let opaque = ctx.0.store_opaque_mut();
+        let store_id = opaque.id();
+        let (vminstance, registry) = opaque.instance_and_module_registry_mut(id);
+        let funcref = vminstance
+            .get_func_ref(registry, payload.func_index)
+            .expect("escaped funcref must exist");
+        // SAFETY: the funcref lives in an instance owned by this store.
+        unsafe { crate::Func::from_vm_func_ref(store_id, funcref) }
+    };
+
+    func.call(&mut store, &[Val::I32(payload.start_arg)], &mut [])?;
+    Ok(())
+}
