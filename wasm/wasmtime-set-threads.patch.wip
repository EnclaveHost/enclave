+// enclave/SET: `thread.available-parallelism`.
+//
+// How many threads can ACTUALLY run at once. On a multi-tenant node the honest
+// answer is not the host's core count — a guest that sizes its pool from
+// `nproc` on a 32-core box while holding a 0.25 share just builds 32 threads
+// to contend over 8 cores' worth of cgroup weight. So the tenant's slice wins
+// when the embedder tells us what it is: ENCLAVE_AVAILABLE_PARALLELISM is set
+// per-deployment by the app manager from the purchased cpuShare (the same
+// shape as the MPS/VRAM caps it already passes). Absent that, fall back to the
+// host's parallelism, which is the right answer for a plain `wasmtime run`.
+//
+// Never returns 0: a guest that reads 0 typically divides by it.
+//
+// Cached: this is read on every call of a guest-facing intrinsic, and
+// `std::env::var` allocates and takes a lock.
+pub(crate) fn available_parallelism() -> u32 {
+    use std::sync::OnceLock;
+    static CACHED: OnceLock<u32> = OnceLock::new();
+    *CACHED.get_or_init(|| {
+        let n = match std::env::var("ENCLAVE_AVAILABLE_PARALLELISM") {
+            Ok(v) => v.trim().parse::<u32>().unwrap_or(0),
+            Err(_) => 0,
+        };
+        if n > 0 {
+            return n;
+        }
+        std::thread::available_parallelism()
+            .map(|n| n.get() as u32)
+            .unwrap_or(1)
+    })
+}
+
+fn thread_available_parallelism(_store: &mut dyn VMStore, _instance: Instance) -> Result<u32> {
+    Ok(available_parallelism())
+}
+
+// enclave/SET: `thread.spawn-ref` / `thread.spawn-indirect`.
+//
+// REAL OS threads: each spawned thread runs the shared start function in a
+// per-thread execution view of the defining instance — its own `Store` (so
+// per-execution state stays exclusive by construction), its own vmctx, and
+// the PRIMARY's `SharedMemory` re-pointed into it so linear memory is
+// physically shared. Design, guards and soundness argument live in
+// `super::set_threads`; the measured result lives in docs/wasm-parallelism.md.
+//
+// Returns the new thread's id (>= 1), or -1 ("spawn failed", which the ABI
+// defines and guests are required to handle) for module shapes the view
+// cannot faithfully represent yet — those log a diagnostic. Traps only on
+// guest bugs (null/ill-typed start function).
+//
+// The result type is NOT `Result<u32>`: its unwind sentinel is `u64::MAX`,
+// aka -1, which the NegativeTwo trampoline arm would pass through to the
+// guest as a fake "spawn failed" while leaving the recorded trap pending in
+// TLS. `ThreadSpawnResult` puts the unwind sentinel at `u64::MAX - 1` (-2),
+// matching the trampoline.
+#[derive(Copy, Clone)]
+pub(crate) struct ThreadSpawnResult(pub i32);
+
+impl ThreadSpawnResult {
+    pub(crate) const FAILED: ThreadSpawnResult = ThreadSpawnResult(-1);
+}
+
+unsafe impl crate::runtime::vm::HostResultHasUnwindSentinel for ThreadSpawnResult {
+    type Abi = u64;
+    const SENTINEL: u64 = u64::MAX - 1;
+    fn into_abi(self) -> u64 {
+        // Zero-extend the i32: -1 becomes 0xFFFF_FFFF, which the trampoline
+        // truncates back to the guest-visible i32 -1 and which can never
+        // collide with the trap sentinel above.
+        self.0 as u32 as u64
+    }
+}
+
+#[cfg(all(feature = "std", feature = "threads"))]
+fn thread_spawn_ref(
+    store: &mut dyn VMStore,
+    _instance: Instance,
+    funcref: *mut u8,
+    arg: u32,
+) -> Result<ThreadSpawnResult> {
+    super::set_threads::spawn_ref(store, funcref, arg)
+}
+
+#[cfg(all(feature = "std", feature = "threads"))]
+fn thread_spawn_indirect(
+    store: &mut dyn VMStore,
+    instance: Instance,
+    table: u32,
+    elem: u32,
+    arg: u32,
+) -> Result<ThreadSpawnResult> {
+    super::set_threads::spawn_indirect(
+        store,
+        instance,
+        wasmtime_environ::component::RuntimeTableIndex::from_u32(table),
+        elem,
+        arg,
+    )
+}
+
+#[cfg(not(all(feature = "std", feature = "threads")))]
+fn thread_spawn_ref(
+    _store: &mut dyn VMStore,
+    _instance: Instance,
+    _funcref: *mut u8,
+    _arg: u32,
+) -> Result<ThreadSpawnResult> {
+    Ok(ThreadSpawnResult::FAILED)
+}
+
+#[cfg(not(all(feature = "std", feature = "threads")))]
+fn thread_spawn_indirect(
+    _store: &mut dyn VMStore,
+    _instance: Instance,
+    _table: u32,
+    _elem: u32,
+    _arg: u32,
+) -> Result<ThreadSpawnResult> {
+    Ok(ThreadSpawnResult::FAILED)
+}
+
