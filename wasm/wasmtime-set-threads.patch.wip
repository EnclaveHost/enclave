+/// enclave/SET: a by-value copy of an instance's resolved raw import records,
+/// used to re-instantiate the same module (as a per-thread execution view)
+/// against the same arguments. See `vm::component::set_threads`.
+pub(crate) struct CopiedImports {
+    pub functions: Vec<VMFunctionImport>,
+    pub tables: Vec<VMTableImport>,
+    pub memories: Vec<VMMemoryImport>,
+    pub globals: Vec<VMGlobalImport>,
+    pub tags: Vec<VMTagImport>,
+}
+
+impl CopiedImports {
+    pub(crate) fn as_imports(&self) -> crate::runtime::vm::Imports<'_> {
+        crate::runtime::vm::Imports {
+            functions: &self.functions,
+            tables: &self.tables,
+            memories: &self.memories,
+            globals: &self.globals,
+            tags: &self.tags,
+        }
+    }
