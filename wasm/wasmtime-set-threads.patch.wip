+pub(crate) fn set_entry_is_cross_thread(own: NonNull<VMStoreContext>) -> bool {
+    match current_vm_store_context() {
+        Some(current) => current != own,
+        // No wasm is executing on this thread, so there is no other store's
+        // `&mut` to alias. Unreachable from the wasm-entry paths this guards
+        // (they are only called FROM wasm, which means an activation exists),
+        // but permitting is the correct answer rather than merely the safe
+        // default: a host-initiated call is exactly the legitimate case.
