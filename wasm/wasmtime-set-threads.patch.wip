+    fn run_worker(&self, req: wasmtime::component::SetWorkerRequest) -> Result<()> {
+        let shared = &self.shared;
+        let mut store = shared.cmd.new_store(&shared.engine, None)?;
+        wasmtime_wasi::runtime::in_tokio(req.run_async(&mut store, &shared.pre))
+    }
+}
