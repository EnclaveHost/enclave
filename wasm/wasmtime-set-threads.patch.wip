+                    Some(sentinel)
+                        if crate::runtime::vm::traphandlers::record_unwind_on_this_thread(err) =>
+                    {
+                        return sentinel;
+                    }
+                    _ => {
+                        eprintln!(
+                            "wasmtime: fatal: a shared-everything-threads worker entered a core \
+                             libcall that cannot report a trap; aborting rather than aliasing \
+                             the owning thread's store"
+                        );
+                        std::process::abort();
+                    }
+                }
+            }
+        }
+
         // SAFETY: It's a contract of this function that `vmctx` is a valid
         // pointer with neither the store nor other instances actively in use
         // when this is called, so it should be safe to acquire a mutable
@@ -506,6 +560,144 @@ impl Instance {
         unsafe { self.vmctx_plus_offset_raw(self.offsets().vmctx_vmglobal_definition(index)) }
     }
 
+    // ===== enclave/SET: support for shared-everything-threads execution =====
+    //
+    // A spawned SET thread executes in an "execution view" of the primary
+    // instance: a fresh instantiation of the same module, in a per-thread
+    // `Store`, whose defined shared memories are re-pointed at the primary's
+    // `SharedMemory` and whose plain globals are snapshotted from the primary
+    // at spawn time. The helpers below are the primary-side capture and the
+    // view-side surgery for that. See `vm::component::set_threads`.
+
+    /// Does this instance belong to `store`?
+    pub(crate) fn belongs_to_store(&self, store: &StoreOpaque) -> bool {
+        match &self.store {
+            Some(ptr) => core::ptr::eq(
+                ptr.0.as_ptr() as *const u8,
+                store.traitobj().as_ptr() as *const u8,
+            ),
+            None => false,
+        }
+    }
+
+    /// Reverse-map a funcref pointer to the `FuncIndex` it was created for,
+    /// if it is one of THIS instance's escaped-function funcrefs (i.e. it
+    /// lives inside this instance's vmctx `func_refs` array).
+    pub(crate) fn func_index_of_func_ref(&self, fr: NonNull<VMFuncRef>) -> Option<FuncIndex> {
+        let module = self.env_module();
+        for (func_index, f) in module.functions.iter() {
+            if !f.is_escaping() {
+                continue;
+            }
+            let entry = unsafe {
+                self.vmctx_plus_offset_raw::<VMFuncRef>(self.offsets().vmctx_func_ref(f.func_ref))
+            };
+            if entry.as_ptr() == fr.as_ptr() {
+                return Some(func_index);
+            }
+        }
+        None
+    }
+
+    /// Clone handles to every defined shared memory of this instance.
+    pub(crate) fn defined_shared_memories_cloned(
+        &self,
+    ) -> Vec<(DefinedMemoryIndex, crate::runtime::vm::memory::SharedMemory)> {
+        let mut out = Vec::new();
+        for (idx, (_, mem)) in self.memories.iter() {
+            if let Some(shared) = mem.as_shared_memory() {
+                out.push((idx, shared.clone()));
+            }
+        }
+        out
+    }
+
+    /// Snapshot the current values of defined `shared` globals of PLAIN
+    /// (numeric / vector) type.
+    ///
+    /// NON-shared globals are deliberately excluded, and that is a
+    /// correctness requirement rather than caution. Under
+    /// shared-everything-threads an unshared global is per-THREAD state — the
+    /// canonical one being `__stack_pointer`. Copying the spawning thread's
+    /// value into a worker would start that worker on the spawner's C shadow
+    /// stack, and both would then push into the same region of shared linear
+    /// memory: silent in-sandbox corruption with no trap. A worker must get
+    /// the module's initial value and let the guest's own thread-start code
+    /// install per-thread state from its context argument.
+    ///
+    /// Reference-typed globals are skipped too: their values are pointers
+    /// tied to this instance and must not leak into a view.
+    pub(crate) fn snapshot_plain_globals(&self) -> Vec<(DefinedGlobalIndex, [u8; 16])> {
+        // The raw [u8; 16] copies below are only correct while that IS the
+        // storage width. Break the build, not the guests, if it changes.
+        const _: () = assert!(core::mem::size_of::<VMGlobalDefinition>() == 16);
+        let module = self.env_module();
+        let mut out = Vec::new();
+        for (index, global) in module.globals.iter() {
+            let Some(def_index) = module.defined_global_index(index) else {
+                continue;
+            };
+            if !global.shared {
+                continue;
+            }
+            if !matches!(
+                global.wasm_ty,
+                wasmtime_environ::WasmValType::I32
+                    | wasmtime_environ::WasmValType::I64
+                    | wasmtime_environ::WasmValType::F32
+                    | wasmtime_environ::WasmValType::F64
+                    | wasmtime_environ::WasmValType::V128
+            ) {
+                continue;
+            }
+            let bytes = unsafe { *self.global_ptr(def_index).cast::<[u8; 16]>().as_ref() };
+            out.push((def_index, bytes));
+        }
+        out
+    }
+
+    /// Write a snapshot produced by `snapshot_plain_globals` (on the primary)
+    /// into THIS instance's globals. Only sound before this instance has
+    /// started executing guest code.
+    pub(crate) fn write_plain_globals(&self, snapshot: &[(DefinedGlobalIndex, [u8; 16])]) {
+        for (def_index, bytes) in snapshot {
+            unsafe {
+                self.global_ptr(*def_index)
+                    .cast::<[u8; 16]>()
+                    .write(*bytes);
+            }
+        }
+    }
+
+    /// Re-point the defined memory `index` of this instance at `shared`,
+    /// which must be another instantiation's `SharedMemory` of a compatible
+    /// type. The previously-created memory for that slot is dropped.
+    ///
+    /// # Safety
+    ///
+    /// Only sound before this instance has started executing guest code, and
+    /// only for a defined memory that is declared `shared` (so the vmctx slot
+    /// is a pointer to an out-of-line `VMMemoryDefinition`).
+    pub(crate) unsafe fn replace_defined_memory_with_shared(
+        mut self: Pin<&mut Self>,
+        index: DefinedMemoryIndex,
+        shared: crate::runtime::vm::memory::SharedMemory,
+    ) {
+        debug_assert!({
+            let module = self.env_module();
+            module.memories[module.memory_index(index)].shared
+        });
+        let def_ptr = shared.vmmemory_ptr();
+        let offset = self.offsets().vmctx_vmmemory_pointer(index);
+        unsafe {
+            self.as_mut()
+                .vmctx_plus_offset_raw::<VmPtr<VMMemoryDefinition>>(offset)
+                .write(VmPtr::from(def_ptr));
+        }
+        let entry = &mut self.memories_mut()[index];
+        entry.1 = Memory::Shared(shared);
+    }
