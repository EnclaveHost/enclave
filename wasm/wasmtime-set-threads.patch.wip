@@ -129,7 +130,44 @@ pub use self::func::{
     ComponentNamedList, ComponentType, Func, Lift, Lower, TypedFunc, WasmList, WasmStr,
 };
 pub use self::has_data::*;
+pub use self::guest_memory::{GuestMemory, GuestMemoryMut};
 pub use self::instance::{Instance, InstancePre};
+/// enclave/SET: the embedder-facing half of shared-everything-threads spawning.
+#[cfg(all(feature = "std", feature = "threads"))]
+pub use crate::runtime::vm::component::{
+    set_reaper_drain, SetThreadGroup, SetWorkerHost, SetWorkerRequest,
+};
+
+/// enclave/SET: the PROCESS-wide live-thread ceiling shared-everything-threads
+/// spawning enforces.
+///
+/// Exposed because OS threads are a node-wide kernel resource, so any other
+/// thread-spawning path in the same process (the CLI's wasi-threads p1 host,
+/// for instance) must bound itself against the SAME number rather than
+/// inventing a second, independent one.
+pub fn max_live_set_threads() -> usize {
+    crate::runtime::vm::component::max_live_threads()
+}
+
+/// enclave/SET: take one token from the PROCESS-wide thread-creation rate
+/// limiter, or report that the limit is in force.
+///
+/// Exposed for the same reason as [`max_live_set_threads`], and it is the more
+/// important of the two: a cap on how many threads EXIST does not bound how
+/// many are MADE, and a guest that spawns and immediately exits stays under any
+/// concurrency cap while costing the node a thread creation per iteration. Any
+/// other thread-spawning path in the process (the CLI's wasi-threads p1 host)
+/// must draw from this same bucket.
+pub fn take_set_spawn_token() -> bool {
+    crate::runtime::vm::component::take_spawn_token()
+}
+
+/// enclave/SET: put back a token taken by [`take_set_spawn_token`] for a spawn
+/// that was then refused for another reason. No thread was created, so it cost
+/// the node nothing.
+pub fn refund_set_spawn_token() {
+    crate::runtime::vm::component::refund_spawn_token()
+}
 pub use self::linker::{Linker, LinkerInstance};
 pub use self::resource_table::{ResourceTable, ResourceTableError};
 pub use self::resources::{Resource, ResourceAny, ResourceDynamic};
