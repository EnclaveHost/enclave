+        // check makes the invariant hold regardless of which module shapes
+        // the spawn guards happen to enumerate.
+        //
+        // Read with pure pointer arithmetic: forming `&Instance` before the
+        // check would itself alias the owning thread's `&mut`.
+        #[cfg(all(feature = "std", feature = "threads"))]
+        {
+            // SAFETY: `vmctx` is valid per this function's contract, and the
+            // store-context slot is written once at instantiation.
+            let own = unsafe {
+                vmctx
+                    .byte_add(usize::from(HostPtr.vmctx_store_context()))
+                    .cast::<VmPtr<VMStoreContext>>()
