+/// enclave/SET: the `VMStoreContext` of the store whose wasm is currently
+/// executing on THIS thread, if any. Reads only thread-local state — safe to
+/// call without any store borrow, which is exactly what the cross-thread
+/// entry guard in `ComponentInstance::enter_host_from_wasm` needs.
+pub(crate) fn current_vm_store_context() -> Option<NonNull<VMStoreContext>> {
+    tls::with(|info| info.map(|info| info.vm_store_context.get()))
+}
+
+/// enclave/SET: record a pending trap against THIS thread's in-flight wasm
+/// call, without a store.
+///
+/// Callers must return their ABI's unwind sentinel immediately afterwards
+/// (see `HostResult::unwind_sentinel`), exactly as
+/// `catch_unwind_and_record_trap` does — Cranelift-generated code tests for
+/// the sentinel and then raises the recorded unwind.
+///
+/// The point of not taking a store is the cross-thread guard in
+/// `ComponentInstance::enter_host_from_wasm`: it fires precisely when
+/// touching the relevant store would be a data race.
+#[cfg(all(feature = "std", feature = "threads"))]
+pub(crate) fn record_unwind_on_this_thread(err: crate::Error) {
+    tls::with(|info| {
+        if let Some(info) = info {
+            info.record_unwind(UnwindReason::from(err));
+        }
+    })
+}
