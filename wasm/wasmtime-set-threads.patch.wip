+/// enclave/SET: the parts every worker of this server needs, built once.
+#[cfg(feature = "threads")]
+struct SetWorkerShared {
+    cmd: ServeCommand,
+    engine: Engine,
+    pre: wasmtime::component::InstancePre<Host>,
+}
+
+/// enclave/SET: runs one spawned worker for `wasmtime serve`.
+///
+/// A worker gets a store built exactly the way a request's store is built —
+/// its own `WasiCtx`, resource table and HTTP context — because component
+/// resource handles are per-instance and cannot be shared across threads. What
+/// IS shared is linear memory, which is what pthreads needs.
+///
