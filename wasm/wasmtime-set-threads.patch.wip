new file mode 100644
index 0000000..6a700ea
--- /dev/null
+++ b/crates/wasmtime/src/runtime/component/guest_memory.rs
@@ -0,0 +1,280 @@
+//! enclave/SET: copy-safe access to the canonical ABI's linear memory.
+//!
+//! # Why this exists
+//!
+//! Upstream's canonical ABI reaches guest memory by forming a Rust slice over
+//! it — `core::slice::from_raw_parts(base, len)` — and then validating bytes
+//! in place: `str::from_utf8(&memory[ptr..][..len])`, `decode_utf16`, and so
+//! on. That is sound exactly as long as no one else can write those bytes
+//! while the host holds the slice, which upstream guarantees by refusing a
+//! `shared` memory for the canonical ABI outright.
+//!
+//! Shared-everything-threads breaks that guarantee. A threaded component's
+//! only memory IS `shared` (the validator relaxation that lets it use the
+//! canonical ABI at all), and its worker threads run on real cores. So while
+//! the host lifts a string on one thread, a worker can be writing the same
+//! bytes on another. Two things then go wrong, and only one of them is
+//! theoretical:
+//!
+//! * it is a data race on a Rust reference, which is undefined behaviour
+//!   regardless of what the bytes turn out to be; and
+//! * `str::from_utf8` validates the bytes and hands back a `&str` *aliasing
+//!   them*, so a guest that flips a byte after validation and before use has
+//!   manufactured an invalid `str` inside safe host code — a violated library
+//!   invariant, i.e. UB with real consequences, not a wrong answer.
+//!
+//! "The base never moves" (true — shared memories are reserved to their
+//! maximum) rules out the pointer going stale. It says nothing about the
+//! contents, which is the actual hazard.
+//!
+//! # What this does instead
+//!
+//! For a shared memory, the host never forms a reference into it. Bytes are
+//! copied out into a host-owned buffer through `read_volatile`, and validated
+//! on the copy — so whatever the guest does afterwards cannot reach anything
+//! the host has already checked. Writes go the other way, byte at a time
+//! through `write_volatile`. The guest may still observe or produce torn
+//! values, which is its own affair: the ABI contract is that a racing guest
+//! gets garbage, not that the host does.
+//!
+//! For an unshared memory — every component on the fleet today — `read`
+//! returns `Cow::Borrowed` over the same slice upstream would have formed, and
+//! writes are a plain `copy_from_slice`. That path is unchanged, and
+//! deliberately so: it is the one that has to stay fast.
+//!
+//! # Why volatile and not atomics
+//!
+//! Rust has no "atomic memcpy". Per-byte `AtomicU8` loads would be defined
+//! under the memory model but compile to the same instructions as volatile
+//! byte loads while blocking vectorisation just as thoroughly, and the
+//! canonical ABI has no ordering requirement to express — the guest
+//! synchronises through its own atomics. `read_volatile` is what wasmtime's
+//! own `Memory::data` documentation points embedders at for exactly this
+//! situation, and it is what keeps the compiler from assuming the bytes are
+//! stable across the copy.
+
+use crate::prelude::*;
+use alloc::borrow::Cow;
+use crate::runtime::vm::VMMemoryDefinition;
+use core::marker::PhantomData;
+use core::ptr::NonNull;
+
+/// The canonical ABI's read view of guest linear memory.
+///
+/// Cheap to copy; carries no borrow of the memory itself, only the store
+/// lifetime that keeps the allocation alive.
+#[derive(Copy, Clone)]
+pub struct GuestMemory<'a> {
+    base: *mut u8,
+    len: usize,
+    shared: bool,
+    _marker: PhantomData<&'a [u8]>,
+}
+
+impl<'a> GuestMemory<'a> {
+    /// # Safety
+    ///
+    /// `memory` must point at a live `VMMemoryDefinition` owned by the store
+    /// whose borrow `'a` is derived from.
+    pub(crate) unsafe fn new(memory: NonNull<VMMemoryDefinition>, shared: bool) -> GuestMemory<'a> {
+        let (base, len) = unsafe {
+            let memory = memory.as_ref();
+            (memory.base.as_ptr(), memory.current_length())
+        };
+        GuestMemory {
+            base,
+            len,
+            shared,
+            _marker: PhantomData,
+        }
+    }
+
+    pub(crate) fn empty() -> GuestMemory<'a> {
+        GuestMemory {
+            base: core::ptr::null_mut(),
+            len: 0,
+            shared: false,
+            _marker: PhantomData,
+        }
+    }
+
+    /// Total size of linear memory, in bytes. This is what bounds checks are
+    /// performed against, exactly as before.
+    #[inline]
+    pub fn len(&self) -> usize {
+        self.len
+    }
+
+    /// Whether reads from this memory must be copied rather than borrowed.
+    #[inline]
+    pub fn is_shared(&self) -> bool {
+        self.shared
+    }
+
+    /// Reads `len` bytes at `offset`.
+    ///
+    /// Borrowed (zero-copy) for an unshared memory; an owned copy taken
+    /// through volatile reads for a shared one. Callers validate the RESULT,
+    /// which for a shared memory is a host-owned buffer no guest thread can
+    /// subsequently change.
+    ///
+    /// # Panics
+    ///
+    /// Panics if the range is out of bounds, matching the panicking indexing
+    /// this replaces (every caller has already bounds-checked against `len`).
+    #[inline]
+    pub fn read(&self, offset: usize, len: usize) -> Cow<'a, [u8]> {
+        let end = offset.checked_add(len).expect("guest memory range overflow");
+        assert!(end <= self.len, "guest memory range out of bounds");
+        if !self.shared {
+            // An empty range is handled without touching `base`: a
+            // zero-length memory's base is the dangling `empty()` sentinel,
+            // and `from_raw_parts` requires a non-null, aligned pointer even
+            // when the length is 0.
+            if len == 0 {
+                return Cow::Borrowed(&[]);
+            }
+            // SAFETY: bounds-checked above, and `'a` keeps the allocation
+            // alive. Nothing else can write an unshared memory while the store
+            // is borrowed.
+            return Cow::Borrowed(unsafe {
+                core::slice::from_raw_parts(self.base.add(offset), len)
+            });
+        }
+        let mut out = Vec::with_capacity(len);
+        // SAFETY: bounds-checked above. Volatile keeps the compiler from
+        // assuming the bytes are stable across the loop or from merging this
+        // with later reads of the same addresses.
+        unsafe {
+            let src = self.base.add(offset);
+            for i in 0..len {
+                out.push(core::ptr::read_volatile(src.add(i)));
+            }
+        }
+        Cow::Owned(out)
+    }
+
+    /// The whole memory as a slice, for paths that cannot support a shared
+    /// memory and must refuse one.
+    pub fn as_unshared_slice(&self) -> Result<&'a [u8]> {
+        if self.shared {
+            bail!(
+                "this canonical-ABI operation does not support a `shared` linear \
+                 memory (shared-everything-threads): the host would have to hold \
+                 a reference into memory another thread can write"
+            );
+        }
+        if self.base.is_null() {
+            return Ok(&[]);
+        }
+        // SAFETY: not shared, so nothing else writes it while the store is
+        // borrowed; `'a` keeps the allocation alive.
+        Ok(unsafe { core::slice::from_raw_parts(self.base, self.len) })
+    }
+}
+
+/// The canonical ABI's write view of guest linear memory.
+pub struct GuestMemoryMut<'a> {
+    base: *mut u8,
+    len: usize,
+    shared: bool,
+    _marker: PhantomData<&'a mut [u8]>,
+}
+
+impl<'a> GuestMemoryMut<'a> {
+    /// # Safety
+    ///
+    /// As [`GuestMemory::new`], and additionally the caller must hold the
+    /// store mutably for `'a`.
+    pub(crate) unsafe fn new(
+        memory: NonNull<VMMemoryDefinition>,
+        shared: bool,
+    ) -> GuestMemoryMut<'a> {
+        let (base, len) = unsafe {
+            let memory = memory.as_ref();
+            (memory.base.as_ptr(), memory.current_length())
+        };
+        GuestMemoryMut {
+            base,
+            len,
+            shared,
+            _marker: PhantomData,
+        }
+    }
+
+    pub(crate) fn empty() -> GuestMemoryMut<'a> {
+        GuestMemoryMut {
+            base: core::ptr::null_mut(),
+            len: 0,
+            shared: false,
+            _marker: PhantomData,
+        }
+    }
+
+    /// Size of linear memory, in bytes.
+    #[inline]
+    pub fn len(&self) -> usize {
+        self.len
+    }
+
+    /// Writes `bytes` at `offset`.
+    ///
+    /// # Panics
+    ///
+    /// Panics if the range is out of bounds, matching the indexing it
+    /// replaces.
+    #[inline]
+    pub fn write(&mut self, offset: usize, bytes: &[u8]) {
+        let end = offset
+            .checked_add(bytes.len())
+            .expect("guest memory range overflow");
+        assert!(end <= self.len, "guest memory range out of bounds");
+        // SAFETY: bounds-checked above.
+        unsafe {
+            let dst = self.base.add(offset);
+            if !self.shared {
+                core::ptr::copy_nonoverlapping(bytes.as_ptr(), dst, bytes.len());
+                return;
+            }
+            for (i, b) in bytes.iter().enumerate() {
+                core::ptr::write_volatile(dst.add(i), *b);
+            }
+        }
+    }
+
+    /// Writes a fixed-size value at `offset`.
+    #[inline]
+    pub fn put<const N: usize>(&mut self, offset: usize, bytes: [u8; N]) {
+        self.write(offset, &bytes);
+    }
+
+    /// Reads back through a write view, for the few lowering paths that need
+    /// to inspect what they have written (and for `realloc` bounds checks).
+    #[inline]
+    pub fn read(&self, offset: usize, len: usize) -> Cow<'_, [u8]> {
+        GuestMemory {
+            base: self.base,
+            len: self.len,
+            shared: self.shared,
+            _marker: PhantomData,
+        }
+        .read(offset, len)
+    }
+
+    /// The whole memory as a mutable slice, for paths that cannot support a
+    /// shared memory and must refuse one.
+    pub fn into_unshared_slice(self) -> Result<&'a mut [u8]> {
+        if self.shared {
+            bail!(
+                "this canonical-ABI operation does not support a `shared` linear \
+                 memory (shared-everything-threads): the host would have to hold \
+                 a mutable reference into memory another thread can write"
+            );
+        }
+        if self.base.is_null() {
+            return Ok(&mut []);
+        }
+        // SAFETY: not shared, and the store is held mutably for `'a`.
+        Ok(unsafe { core::slice::from_raw_parts_mut(self.base, self.len) })
+    }
+}
