     }
     Some(out)
 }
+
+/// enclave/SET: whether shared-everything-threads is enabled for this run.
+///
+/// **Not** `wasm.shared_everything_threads == Some(true)`, which is what every
+/// SET-conditional branch used to test and which `-W all-proposals=y` walks
+/// straight past: the `all` fallback is applied when the flags are turned into
+/// an engine `Config` (`cli-flags`'s `handle_conditionally_compiled!`), so the
+/// ENGINE gets SET while the option itself stays `None`. That produced four
+/// real worker threads with no epoch interruption, no ticker, no stop callback
+/// and blocking WASI inline — every safety mechanism off, silently.
+pub fn set_threads_enabled(common: &CommonOptions) -> bool {
+    common
+        .wasm
+        .shared_everything_threads
+        .or(common.wasm.all_proposals)
+        == Some(true)
+}
+
+/// enclave/SET: how often the shared-everything-threads epoch ticker bumps the
+/// engine epoch.
+///
+/// This is a STOP latency, not a run-time budget: a worker's epoch callback
+/// reads its group's stop flag and either continues or traps. 10 ms means a
+/// runaway worker stops within ~10 ms of teardown asking it to, at the cost of
+/// one atomic load per worker per tick.
+#[cfg(all(feature = "component-model", feature = "threads"))]
+pub const SET_EPOCH_PERIOD: Duration = Duration::from_millis(10);
+
+/// enclave/SET: a periodic `Engine::increment_epoch` ticker, joined on drop.
+///
+/// Shared-everything-threads REQUIRES one. A worker is stopped at an epoch
+/// check; with no ticker the epoch never advances, no check ever fires, and a
+/// guest thread that does not yield cannot be stopped by anything short of
+/// killing the process — which is a node-wide denial of service from a few
+/// lines of guest wasm, or from an ordinary program that detaches a compute
+/// thread and returns from `main`.
+///
+/// `--wasm timeout` is NOT a substitute: it bumps the epoch exactly once.
+#[cfg(all(feature = "component-model", feature = "threads"))]
+pub struct SetEpochTicker {
+    shutdown: std::sync::Arc<std::sync::atomic::AtomicBool>,
+    handle: Option<std::thread::JoinHandle<()>>,
+}
+
+#[cfg(all(feature = "component-model", feature = "threads"))]
+impl SetEpochTicker {
+    /// Start a ticker if `-W shared-everything-threads` is on, otherwise
+    /// nothing: engines that cannot spawn SET workers pay no epoch cost.
+    /// Start the ticker if SET is enabled; if `stop_at` is given, the ticker
+    /// also asks that group to stop when the deadline passes.
+    ///
+    /// That is how `--wasm timeout` reaches a WORKER. The primary's epoch
+    /// callback checks the wall clock, but a callback only runs when the
+    /// primary is executing compiled code — and the ordinary pthread shape has
+    /// the main thread parked in `pthread_join`, where it runs none. Measured:
+    /// spinning workers plus a parked main survived `--wasm timeout=2s` for 25s
+    /// with two cores pinned, until SIGTERM. A thread that is already awake and
+    /// holds a clock is the right place to enforce a deadline.
+    pub fn maybe_spawn_with(
+        common: &CommonOptions,
+        engine: &Engine,
+        stop_at: Option<(
+            Duration,
+            std::sync::Arc<wasmtime::component::SetThreadGroup>,
+        )>,
+    ) -> Result<Option<SetEpochTicker>> {
+        if !set_threads_enabled(common) {
+            return Ok(None);
+        }
+        let shutdown = std::sync::Arc::new(std::sync::atomic::AtomicBool::new(false));
+        let handle = {
+            let shutdown = shutdown.clone();
+            let engine = engine.clone();
+            std::thread::Builder::new()
+                .name("set-epoch-ticker".to_string())
+                .spawn(move || {
+                    let deadline = stop_at
+                        .as_ref()
+                        .map(|(d, _)| std::time::Instant::now() + *d);
+                    while !shutdown.load(std::sync::atomic::Ordering::Relaxed) {
+                        std::thread::sleep(SET_EPOCH_PERIOD);
+                        engine.increment_epoch();
+                        if let (Some(deadline), Some((_, group))) = (deadline, stop_at.as_ref()) {
+                            if std::time::Instant::now() >= deadline {
+                                group.request_stop();
+                            }
+                        }
+                    }
+                })
+                // Fail CLOSED. Swallowing this left the engine with epoch
+                // interruption on and nothing advancing the epoch, so no
+                // worker's stop check ever fired and every one of them was
+                // detached at teardown to spin forever. And the condition that
+                // makes `spawn` fail is EAGAIN under thread pressure — which is
+                // precisely what a SET tenant creates.
+                .context(
+                    "shared-everything-threads needs a periodic epoch ticker and its thread \
+                     could not be created; without it a guest thread that does not yield \
+                     cannot be stopped",
+                )?
+        };
+        Ok(Some(SetEpochTicker {
+            shutdown,
+            handle: Some(handle),
+        }))
+    }
+}
+
+#[cfg(all(feature = "component-model", feature = "threads"))]
+impl Drop for SetEpochTicker {
+    fn drop(&mut self) {
+        self.shutdown
+            .store(true, std::sync::atomic::Ordering::Relaxed);
+        if let Some(handle) = self.handle.take() {
+            let _ = handle.join();
+        }
+    }
+}
