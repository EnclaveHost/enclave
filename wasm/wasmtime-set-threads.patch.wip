+    /// accessors those interfaces were registered with `unwrap()` the context
+    /// they need. A worker `Host` missing one is not a missing feature, it is a
+    /// guest-triggerable panic — and, before `worker_main` stopped converting
+    /// panics into `process::abort()`, a guest-triggerable process kill. Three
+    /// instructions under `-S http` were enough to demonstrate it.
+    ///
+    /// So: add a context here, or a worker will not have it.
+    fn build_host(run: &RunCommon, argv: &[String], cli: Option<bool>) -> Result<Host> {
+        let mut host = Host::default();
+        host.limits = run.store_limits();
+
