+// enclave/SET: cancellation for shared-everything-threads workers.
+//
+// A SET worker parked in `memory.atomic.wait` (the primitive under every SET
+// mutex/condvar) is invisible to epoch interruption — epochs are only observed
+// at wasm execution checkpoints, and a parked thread is not executing. Store
+// teardown joins every worker, so a worker parked forever would hang teardown
+// forever (and, under `wasmtime serve`, leak the tokio worker driving it).
+//
+// The fix: while a SET worker runs, it installs a teardown-cancellation flag in
+// this thread-local. `wait()` polls it on a bounded quantum, so a parked worker
+// wakes within `SET_CANCEL_POLL` of the flag being set (teardown also unparks
+// it for immediacy), removes itself from the wait queue, and reports
+// cancellation to the caller, which turns it into an interrupt trap so the
+// worker unwinds out of its own store. Non-worker threads never install the
+// flag, so their wait path is byte-for-byte unchanged.
+const SET_CANCEL_POLL: Duration = Duration::from_millis(50);
+
+thread_local! {
+    /// The running SET worker's teardown-cancellation flag, or `None` on every
+    /// non-worker thread. Installed by `set_threads::run_view`.
+    static SET_WORKER_CANCEL: RefCell<Option<Arc<AtomicBool>>> = const { RefCell::new(None) };
+    /// Set by `wait()` when it returned because the cancel flag fired; read and
+    /// cleared by the atomic-wait caller, which maps it to an interrupt trap.
+    static SET_WORKER_CANCELLED: Cell<bool> = const { Cell::new(false) };
+}
+
+/// enclave/SET: install (or clear, with `None`) this thread's teardown
+/// cancellation flag. A worker calls this around its guest execution.
+pub fn set_worker_cancel(flag: Option<Arc<AtomicBool>>) {
+    SET_WORKER_CANCEL.with(|c| *c.borrow_mut() = flag);
+}
+
+fn worker_cancel_flag() -> Option<Arc<AtomicBool>> {
+    SET_WORKER_CANCEL.with(|c| c.borrow().clone())
+}
+
+/// enclave/SET: read and clear the "the last wait was cancelled at teardown"
+/// flag. The atomic-wait host call turns a `true` here into an interrupt trap,
+/// so a cancelled worker unwinds out of its store instead of returning to the
+/// guest (which would re-check its condition and re-park).
+pub fn take_worker_cancelled() -> bool {
+    SET_WORKER_CANCELLED.with(|c| c.replace(false))
+}
