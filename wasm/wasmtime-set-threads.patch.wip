+        // `VMComponentOffsets::vm_store_context()` is not `const`, so
+        // `const _: () = assert!(..)` is not available. Not a `debug_assert!`
+        // either -- the release build is exactly where a silent layout drift
+        // would re-arm the UB, and this runs once per component instantiation.
+        #[cfg(all(feature = "std", feature = "threads"))]
+        assert_eq!(
+            usize::try_from(offset).unwrap(),
+            SET_VMCOMPONENT_STORE_CONTEXT_OFFSET,
+            "enclave/SET: VMComponentContext layout moved; the cross-thread \
+             entry guard in `enter_host_from_wasm` reads `vm_store_context` at a \
+             hardcoded offset and would now read the wrong field"
+        );
         unsafe {
             *self.as_mut().vmctx_plus_offset_mut(offset) =
                 VmPtr::from(self.store.0.as_ref().vm_store_context_ptr());
@@ -926,6 +1092,21 @@ impl ComponentInstance {
         self.instances[idx]
     }
 
+    /// enclave/SET: the inverse of `instance` — which runtime instance index
+    /// this core instance was pushed at, if any.
+    ///
+    /// Spawn needs this to describe the start function to a worker in terms
+    /// the worker's OWN component instantiation can resolve: a raw `InstanceId`
+    /// belongs to the primary store and is meaningless in another, but
+    /// `(RuntimeInstanceIndex, FuncIndex)` names the same function in every
+    /// instantiation of the same component.
+    pub fn runtime_instance_index_of(&self, id: InstanceId) -> Option<RuntimeInstanceIndex> {
+        self.instances
+            .iter()
+            .find(|(_, candidate)| **candidate == id)
+            .map(|(idx, _)| idx)
+    }
+
     fn instances_mut(self: Pin<&mut Self>) -> &mut TryPrimaryMap<RuntimeInstanceIndex, InstanceId> {
         // SAFETY: we've chosen the `Pin` guarantee of `Self` to not apply to
         // the map returned.
diff --git a/crates/wasmtime/src/runtime/vm/component/libcalls.rs b/crates/wasmtime/src/runtime/vm/component/libcalls.rs
index f62ea58..7ed3b91 100644
--- a/crates/wasmtime/src/runtime/vm/component/libcalls.rs
+++ b/crates/wasmtime/src/runtime/vm/component/libcalls.rs
@@ -693,6 +693,127 @@ fn exit_sync_call(store: &mut dyn VMStore, instance: Instance) -> Result<()> {
     store.exit_guest_sync_call()
 }
 
+// enclave/SET: `thread.available-parallelism`.
+//
+// How many threads can ACTUALLY run at once. On a multi-tenant node the honest
+// answer is not the host's core count — a guest that sizes its pool from
+// `nproc` on a 32-core box while holding a 0.25 share just builds 32 threads
+// to contend over 8 cores' worth of cgroup weight. So the tenant's slice wins
+// when the embedder tells us what it is: ENCLAVE_AVAILABLE_PARALLELISM is set
+// per-deployment by the app manager from the purchased cpuShare (the same
+// shape as the MPS/VRAM caps it already passes). Absent that, fall back to the
+// host's parallelism, which is the right answer for a plain `wasmtime run`.
+//
+// Never returns 0: a guest that reads 0 typically divides by it.
+//
+// Cached: this is read on every call of a guest-facing intrinsic, and
+// `std::env::var` allocates and takes a lock.
+pub(crate) fn available_parallelism() -> u32 {
+    use std::sync::OnceLock;
+    static CACHED: OnceLock<u32> = OnceLock::new();
+    *CACHED.get_or_init(|| {
+        let n = match std::env::var("ENCLAVE_AVAILABLE_PARALLELISM") {
+            Ok(v) => v.trim().parse::<u32>().unwrap_or(0),
+            Err(_) => 0,
+        };
+        if n > 0 {
+            return n;
+        }
+        std::thread::available_parallelism()
+            .map(|n| n.get() as u32)
+            .unwrap_or(1)
+    })
+}
+
+fn thread_available_parallelism(_store: &mut dyn VMStore, _instance: Instance) -> Result<u32> {
+    Ok(available_parallelism())
+}
+
+// enclave/SET: `thread.spawn-ref` / `thread.spawn-indirect`.
+//
+// REAL OS threads: each spawned thread runs the shared start function in a
+// per-thread execution view of the defining instance — its own `Store` (so
+// per-execution state stays exclusive by construction), its own vmctx, and
+// the PRIMARY's `SharedMemory` re-pointed into it so linear memory is
+// physically shared. Design, guards and soundness argument live in
+// `super::set_threads`; the measured result lives in docs/wasm-parallelism.md.
+//
+// Returns the new thread's id (>= 1), or -1 ("spawn failed", which the ABI
+// defines and guests are required to handle) for module shapes the view
+// cannot faithfully represent yet — those log a diagnostic. Traps only on
+// guest bugs (null/ill-typed start function).
+//
+// The result type is NOT `Result<u32>`: its unwind sentinel is `u64::MAX`,
+// aka -1, which the NegativeTwo trampoline arm would pass through to the
+// guest as a fake "spawn failed" while leaving the recorded trap pending in
+// TLS. `ThreadSpawnResult` puts the unwind sentinel at `u64::MAX - 1` (-2),
+// matching the trampoline.
+#[derive(Copy, Clone)]
+pub(crate) struct ThreadSpawnResult(pub i32);
+
+impl ThreadSpawnResult {
+    pub(crate) const FAILED: ThreadSpawnResult = ThreadSpawnResult(-1);
+}
+
+unsafe impl crate::runtime::vm::HostResultHasUnwindSentinel for ThreadSpawnResult {
+    type Abi = u64;
+    const SENTINEL: u64 = u64::MAX - 1;
+    fn into_abi(self) -> u64 {
+        // Zero-extend the i32: -1 becomes 0xFFFF_FFFF, which the trampoline
+        // truncates back to the guest-visible i32 -1 and which can never
+        // collide with the trap sentinel above.
+        self.0 as u32 as u64
+    }
+}
+
+#[cfg(all(feature = "std", feature = "threads"))]
+fn thread_spawn_ref(
+    store: &mut dyn VMStore,
+    instance: Instance,
+    funcref: *mut u8,
+    arg: u32,
+) -> Result<ThreadSpawnResult> {
+    super::set_threads::spawn_ref(store, instance, funcref, arg)
+}
+
+#[cfg(all(feature = "std", feature = "threads"))]
+fn thread_spawn_indirect(
+    store: &mut dyn VMStore,
+    instance: Instance,
+    table: u32,
+    elem: u32,
+    arg: u32,
+) -> Result<ThreadSpawnResult> {
+    super::set_threads::spawn_indirect(
+        store,
+        instance,
+        wasmtime_environ::component::RuntimeTableIndex::from_u32(table),
+        elem,
+        arg,
+    )
+}
+
+#[cfg(not(all(feature = "std", feature = "threads")))]
+fn thread_spawn_ref(
+    _store: &mut dyn VMStore,
+    _instance: Instance,
+    _funcref: *mut u8,
+    _arg: u32,
+) -> Result<ThreadSpawnResult> {
+    Ok(ThreadSpawnResult::FAILED)
+}
+
+#[cfg(not(all(feature = "std", feature = "threads")))]
+fn thread_spawn_indirect(
+    _store: &mut dyn VMStore,
+    _instance: Instance,
+    _table: u32,
+    _elem: u32,
+    _arg: u32,
+) -> Result<ThreadSpawnResult> {
+    Ok(ThreadSpawnResult::FAILED)
+}
+
 #[cfg(feature = "component-model-async")]
 fn backpressure_modify(
     store: &mut dyn VMStore,
diff --git a/crates/wasmtime/src/runtime/vm/component/set_threads.rs b/crates/wasmtime/src/runtime/vm/component/set_threads.rs
new file mode 100644
index 0000000..d25e2c6
--- /dev/null
+++ b/crates/wasmtime/src/runtime/vm/component/set_threads.rs
@@ -0,0 +1,1955 @@
+//! enclave/SET: real OS-thread spawning for the shared-everything-threads
+//! `thread.spawn-ref` / `thread.spawn-indirect` component intrinsics.
+//!
+//! # Design: one whole component instance per spawned thread
+//!
+//! Wasmtime's execution model requires `&mut Store` to enter guest code, and
+//! per-execution state (stack limits, last-wasm entry/exit SP+FP, the epoch
+//! deadline, fuel) lives in the store's `VMStoreContext`, reached from the
+//! instance's vmctx. Two OS threads through one vmctx would therefore corrupt
+//! each other's execution state — that, not codegen, is what makes a naive
+//! "share the Store" implementation unsound, and `unsafe impl Sync for Store`
+//! would merely hide it.
+//!
+//! So each spawned thread gets its OWN `Store` (the borrow checker keeps
+//! enforcing execution exclusivity everywhere, unchanged) containing a FULL
+//! instantiation of the same component:
+//!
+//! * the worker instantiates the same `Component` in its own store, with its
+//!   own embedder context `T`, its own vmctxs, tables, globals and component
+//!   resource tables;
+//! * the spawning core instance's defined memories are re-pointed at the
+//!   primary's `SharedMemory` (an `Arc` whose `VMMemoryDefinition` all
+//!   instances share, with growth behind a lock — the exact mechanism
+//!   wasmtime already uses for shared memories between stores) BEFORE that
+//!   instance's startup function runs, so linear memory is PHYSICALLY the
+//!   same memory and `__wasm_init_memory` sees the shared once-flag;
+//! * the start function is named component-relatively, as
+//!   `(RuntimeInstanceIndex, FuncIndex)`, so it resolves in any
+//!   instantiation, and is entered through the WORKER's own funcref with the
+//!   same `enter_guest_sync_call` bookkeeping the primary uses for a core
+//!   `start`. Traps, backtraces, signals and epochs work because
+//!   N threads × N stores is already-supported wasmtime usage.
+//!
+//! **Import substitution is not an option, and this is the reason the design
+//! looks like this.** An earlier revision instantiated one core module with
+//! stub imports that trapped, on the theory that a worker simply could not
+//! reach host APIs. That is silently unsound: Cranelift devirtualizes a call
+//! to a statically-known import into a DIRECT call to the callee's compiled
+//! body while still loading the callee vmctx out of the import slot, so a
+//! worker ran the PRIMARY's compiled code with a foreign vmctx. See
+//! `tools/parallelism-probe/set-worker-import-foreign.wat` in the enclave
+//! repo. Anything less than a whole instantiation reintroduces that.
+//!
+//! Sharedness of the state a *valid* SET guest can actually reach from a
+//! spawned function on this engine:
+//!
+//! * memory: physically shared (above);
+//! * tables: per-worker, materialized from the same initializers. Cranelift
+//!   rejects `table.atomic.*` ("not yet implemented" upstream), so no guest
+//!   this engine can compile is able to express cross-thread table mutation;
+//! * globals: per-worker, at their INITIAL values — nothing is snapshotted
+//!   from the spawner, because under SET an unshared global is per-thread
+//!   state (canonically `__stack_pointer`) and inheriting the spawner's value
+//!   would put two threads on one C shadow stack. `global.atomic.*` equally
+//!   does not compile, and modules with MUTABLE `shared` globals are refused
+//!   at spawn (below) rather than silently diverging;
+//! * WASI: per-worker. Component resource handles are per-instance, so a
+//!   handle cached in shared memory names nothing in another thread; the SET
+//!   libc keeps its descriptor table, stdio streams and preopens in TLS to
+//!   match. An fd opened on one thread is not usable from another — the same
+//!   limitation the wasi-threads (p1) path documents.
+//!
+//! # Lifetime / soundness invariants
+//!
+//! A worker deliberately holds NO raw pointers into the primary store: the
+//! component is a refcounted handle and the shared memories are `Arc`s, so
+//! `SetWorkerRequest` is `Send` without a single `unsafe impl`.
+//!
+//! Be precise about what that buys, because the next reader will lean on it:
+//! `Send` proves the REQUEST can cross a thread boundary. It says nothing about
+//! what the worker's `Store<T>`, its embedder data `T`, or the embedder's
+//! `SetWorkerHost` reach once teardown has DETACHED the worker. That is an
+//! EMBEDDER OBLIGATION, stated on [`SetWorkerHost`]: everything a detached
+//! worker can still touch must outlive it or be refcounted. Both CLI embedders
+//! satisfy it (the worker's store owns an `Engine` clone, the `Component` Arc
+//! and the `SharedMemory` Arcs; the primary frees nothing the worker reaches).
+//! With that obligation held, this follows:
+//!
+//! 1. **Teardown does not have to block.** `Drop for Store<T>` asks every
+//!    worker to stop and joins with a bound; a worker that has still not
+//!    stopped is DETACHED with a loud diagnostic rather than wedging the
+//!    process, because nothing it can reach is being deallocated. See
+//!    `SetThreadGroup` and `StoreOpaque::join_set_threads`.
+//! 2. **Stopping is actively driven, three ways at once**, because each one
+//!    alone has a hole: the group's `stop` flag (polled by the parking spot,
+//!    so a worker parked in `memory.atomic.wait` wakes), an engine epoch bump
+//!    (so a worker spinning in pure compute traps at its next epoch check),
+//!    and dropping the worker's guest future (so a worker blocked in a HOST
+//!    call — which is now possible, since workers do real WASI — unwinds
+//!    instead of holding a core until the syscall returns).
+//! 3. **A worker never re-enters the primary store**: BOTH
+//!    `Instance::enter_host_from_wasm` and
+//!    `ComponentInstance::enter_host_from_wasm` compare the executing
+//!    thread's `VMStoreContext` and TRAP the worker (on its own thread,
+//!    without touching the other store) on mismatch. Defense in depth: with a
+//!    whole instantiation per worker there is no legitimate path there.
+//!
+//! **Epoch interruption is a REQUIREMENT, not a nicety.** A worker's deadline
+//! bounds nothing unless the embedder both enables `Config::epoch_interruption`
+//! (otherwise compiled code carries no epoch checks at all) and runs a
+//! PERIODIC ticker (a single-shot bump, which is all `wasmtime --wasm timeout`
+//! does, can trip a deadline of 1 but never a larger one, and never trips a
+//! worker that starts after it fired). The wasmtime CLI turns both on
+//! automatically whenever `-W shared-everything-threads` is enabled; an
+//! embedder that does neither is relying on process supervision alone, and
+//! `spawn` says so on stderr the first time it is asked.
+//!
+//! Spawn refuses (returns the ABI's `-1` failure, with a diagnostic on
+//! stderr) any module shape whose worker would NOT faithfully share state:
+//! non-shared defined memories, no shared memory at all, imported
+//! tables/globals/memories/tags, mutable `shared` globals, segmented memory
+//! initialization, or GC use — and any spawn beyond the live-thread cap
+//! (`max_live_threads`), which bounds how many threads EXIST but not how many
+//! are MADE — nothing bounds creation by default, see `max_spawn_rate`. A guest `start` section is ALLOWED and runs once per worker — the
+//! `wasm-ld --shared-memory` ABI (`__wasm_init_memory` behind an atomic
+//! once-flag in shared memory) is designed for exactly this
+//! instantiation-per-thread pattern; see the guard comment in
+//! `spawn_funcref`.
+
+use crate::prelude::*;
+use crate::runtime::component::RuntimeInstance;
+use crate::runtime::vm::component::libcalls::ThreadSpawnResult;
+use crate::runtime::vm::memory::SharedMemory;
+use crate::runtime::vm::{Instance as VmInstance, VMFuncRef, VMStore};
+use crate::store::StoreOpaque;
+use crate::{AsContextMut, Store, Val};
+use core::pin::Pin;
+use core::ptr::NonNull;
+use core::sync::atomic::{AtomicBool, AtomicI64, AtomicU64, AtomicUsize, Ordering};
+use std::sync::Arc;
+use wasmtime_environ::component::{
+    RuntimeComponentInstanceIndex, RuntimeInstanceIndex, RuntimeTableIndex,
+};
+use wasmtime_environ::{DefinedMemoryIndex, FuncIndex, VMCONTEXT_MAGIC};
+
+/// How many workers one store may have running at once.
+///
+/// OS threads are a NODE-WIDE kernel resource (`threads-max`, pid space), and
+/// the cgroup controls this platform applies (`cpu.weight`, `cpu.max`) bound a
+/// tenant's CPU share but not its thread count — so an uncapped guest loop
+/// degrades every tenant on the box, not just its own. Measured before this
+/// cap existed: 200 spawn calls produced 234 live OS threads with no refusal,
+/// at ~2.3 MB of stack address space each; the binding resource is the thread
+/// count itself, not memory.
+///
+/// The bound is PROCESS-global, not per-store, and that matters: under
+/// `wasmtime serve` a fresh `Store` is created per HTTP request (wasip2
+/// reuses an instance once) with up to 1000 concurrent requests, so a
+/// per-store cap would have been a 1000x under-count of the real thread
+/// ceiling.
+///
+/// It is sized from `thread.available_parallelism`, which reports the
+/// tenant's purchased slice when the embedder sets
+/// `ENCLAVE_AVAILABLE_PARALLELISM` and the HOST core count otherwise. The
+/// enclave platform sets it per launch from the purchased `cpuShare`
+/// (`wasm_manager.py::_available_parallelism_for`), so on-fleet this derives
+/// from the tenant's share; an embedder that does not set it gets the node's
+/// core count, which is a much weaker bound. The 4x headroom is for pools
+/// whose threads block rather than compute.
+/// `ENCLAVE_MAX_SET_THREADS` overrides it; the floor of 4 keeps a
+/// single-core tenant able to express a small pool.
+///
+/// Exceeding it returns the ABI's documented `-1` ("spawn failed"), which SET
+/// guests are already required to handle — the same graceful path an
+/// unsupported module shape takes.
+pub fn max_live_threads() -> usize {
+    use std::sync::OnceLock;
+    static CACHED: OnceLock<usize> = OnceLock::new();
+    *CACHED.get_or_init(|| {
+        if let Ok(v) = std::env::var("ENCLAVE_MAX_SET_THREADS") {
+            if let Ok(n) = v.trim().parse::<usize>() {
+                if n > 0 {
+                    return n;
+                }
+            }
+        }
+        let par = super::libcalls::available_parallelism() as usize;
+        par.saturating_mul(4).max(4)
+    })
+}
+
+/// Epoch ticks between two consecutive checks of the group's `stop` flag on a
+/// running worker.
+///
+/// This is NOT a run-time budget — a worker is not killed for taking too long,
+/// only for still running once its group has been asked to stop. So the value
+/// wants to be SMALL (the callback is an atomic load and a deadline update),
+/// and the default of 1 means "look at the stop flag at every epoch tick".
+/// With the CLI's 10 ms ticker that is a ~10 ms worst-case stop latency at
+/// negligible cost.
+///
+/// An earlier revision used this as a deadline of 600 ticks and trapped on it.
+/// That was wrong in both directions: it killed long-running healthy workers
+/// on a 1 s ticker, and — because `--wasm timeout` bumps the engine epoch
+/// exactly ONCE — it never fired for the runaway worker it was meant to stop.
+fn set_worker_epoch_ticks() -> u64 {
+    use std::sync::OnceLock;
+    static CACHED: OnceLock<u64> = OnceLock::new();
+    *CACHED.get_or_init(|| {
+        std::env::var("ENCLAVE_SET_EPOCH_TICKS")
+            .ok()
+            .and_then(|v| v.trim().parse::<u64>().ok())
+            .filter(|n| *n > 0)
+            .unwrap_or(1)
+    })
+}
+
+/// How long `join_set_threads` waits for a worker to stop before detaching it.
+///
+/// Detaching is SOUND (a worker holds no pointers into the primary store — see
+/// the module header), so the only question is how long to wait before
+/// preferring a leaked thread to a wedged process. `ENCLAVE_SET_JOIN_TIMEOUT_MS`
+/// overrides; `0` restores the old unbounded join.
+pub fn set_join_timeout() -> std::time::Duration {
+    use std::sync::OnceLock;
+    static CACHED: OnceLock<u64> = OnceLock::new();
+    let ms = *CACHED.get_or_init(|| {
+        std::env::var("ENCLAVE_SET_JOIN_TIMEOUT_MS")
+            .ok()
+            .and_then(|v| v.trim().parse::<u64>().ok())
+            .unwrap_or(2_000)
+    });
+    std::time::Duration::from_millis(ms)
+}
+
+/// enclave/SET: the PROCESS-GLOBAL teardown reaper.
+///
+/// `StoreOpaque::join_set_threads` runs from `Drop`, which under
+/// `wasmtime serve` is a tokio worker, and `Drop` cannot `await`. So a store
+/// that still has a live worker hands the wait here instead of performing it
+/// inline. Measured: against a guest that detaches an unstoppable worker per
+/// request, moving the wait off the caller took throughput from 51 to 2236
+/// rps and the worst latency from 2006 ms to 60 ms.
+///
+/// ONE thread for the process, not one per teardown. The first version of this
+/// spawned a reaper per store and measured ~1950 engine-created OS threads per
+/// second under an ordinary load — and every one of them was invisible to
+/// `ENCLAVE_MAX_SET_THREADS`, to `ENCLAVE_MAX_SET_SPAWN_RATE` and to the RAM
+/// ledger, because the ENGINE created them rather than the guest. Round 4
+/// established that thread creation is a node-wide cost that must be bounded;
+/// a guest-drivable creation path that no limiter can see is that lesson
+/// unlearned. It also made the spawn-failure diagnostic guest-reachable and
+/// un-rate-limited, i.e. a way to flood the tenant's log.
+///
+/// The queue is unbounded, which is the right trade here: an entry is three
+/// pointers and a deadline, entries drain at their own timeout, and dropping
+/// one would leak the thread it was meant to reap. Backpressure would have to
+/// block the caller, which is the thing this exists to stop.
+#[cfg(all(feature = "std", feature = "threads"))]
+mod reaper {
+    use super::SetThreadGroup;
+    // `Vec`/`ToString` come from the crate prelude: this crate is no_std-capable.
+    use crate::prelude::*;
+    use core::sync::atomic::{AtomicUsize, Ordering};
+    use std::sync::mpsc::{Receiver, Sender};
+    use std::sync::{Arc, Mutex, OnceLock};
+    use std::thread::JoinHandle;
+    use std::time::{Duration, Instant};
+
+    pub(super) struct Job {
+        pub group: Option<Arc<SetThreadGroup>>,
+        pub engine: crate::Engine,
+        pub joins: Vec<JoinHandle<()>>,
+        pub deadline: Instant,
+    }
+
+    fn live_is_zero(group: &Option<Arc<SetThreadGroup>>) -> bool {
+        group.as_ref().is_some_and(|g| g.live_workers() == 0)
+    }
+
+    /// Jobs submitted but not yet finished. Lets `wasmtime run` wait for the
+    /// reaper before the process exits (see `drain`); `serve` never does.
+    pub(super) static PENDING: AtomicUsize = AtomicUsize::new(0);
+
+    /// Resolve what can be resolved; return the job if anything is left.
+    ///
+    /// `past_deadline` is the ONLY thing that authorises a detach, and it is
+    /// checked per handle. Round 12's version took `Job` by value, joined
+    /// unconditionally whenever the group read zero live workers, and had no
+    /// deadline on that arm at all -- while the comment beside it claimed "a
+    /// handle that is not finished yet is re-checked on the next pass; only at
+    /// the deadline is it detached", describing a mechanism that did not exist.
+    /// Measured with the OS thread held alive past its `LiveGuard` drop: the
+    /// ONE reaper serving every store in the process blocked 5.000 s against a
+    /// 2.000 s deadline, during which nothing else was dequeued, no other
+    /// deadline was honoured and no epoch was bumped.
+    fn finish(mut job: Job, past_deadline: bool) -> Option<Job> {
+        let mut unresolved = Vec::new();
+        for handle in core::mem::take(&mut job.joins) {
+            if handle.is_finished() {
+                let name = handle.thread().name().unwrap_or("set-thread").to_string();
+                if let Err(e) = handle.join() {
+                    // Downcast: `{e:?}` on a join payload renders as literally
+                    // `Any { .. }`, losing the message. Round 15 fixed the FAST
+                    // path in `store.rs` and its comment said it was doing this
+                    // "the way `reaper::finish` does" -- `finish` did no such
+                    // thing, and this is the SLOW path, which round 11 measured
+                    // as 10-41% of ordinary spawn-and-join requests. One of a
+                    // pair again.
+                    let msg = e
+                        .downcast_ref::<&str>()
+                        .map(|s| (*s).to_string())
+                        .or_else(|| e.downcast_ref::<String>().cloned())
+                        .unwrap_or_else(|| "<non-string panic payload>".to_string());
+                    log::warn!("SET worker {name} panicked: {msg}");
+                }
+            } else if past_deadline {
+                // Detached deliberately: nothing it can reach is being freed,
+                // and the alternative is blocking forever.
+                let name = handle.thread().name().unwrap_or("set-thread").to_string();
+                log::error!(
+                    "SET worker {name} did not stop within the teardown timeout and has \
+                     been detached; it still holds a live-thread slot. The guest thread \
+                     is not reaching an epoch check -- typically a synchronous host call, \
+                     or an embedder without `Config::epoch_interruption`."
+                );
+                // NOT `eprintln!`: that PANICS if the write fails, and on this
+                // platform wasmtime's stderr is the tenant's log, so an EPIPE
+                // from a log-collector restart (or ENOSPC, or EIO) killed the
+                // reaper thread outright. `TX` still held a live sender, so
+                // every later teardown detached its workers with no wait and no
+                // diagnostic, `PENDING` leaked so `set_reaper_drain` always
+                // burned its full timeout, and the epoch bumps stopped -- for
+                // the life of the process, reported through the same broken
+                // stderr. Measured: one detach with stderr closed and the
+                // reaper was gone.
+                use std::io::Write;
+                let _ = writeln!(
+                    std::io::stderr(),
+                    "wasmtime: warning: SET worker {name} did not stop at store teardown \
+                     and was detached (it still holds a live-thread slot)"
+                );
+            } else {
+                // Not finished and not past the deadline: keep it and look
+                // again next pass. NEVER block on it -- this thread services
+                // every store in the process.
+                unresolved.push(handle);
+            }
+        }
+        if unresolved.is_empty() {
+            None
+        } else {
+            job.joins = unresolved;
+            Some(job)
+        }
+    }
+
+    fn run(rx: Receiver<Job>) {
+        let mut pending: Vec<Job> = Vec::new();
+        loop {
+            if pending.is_empty() {
+                match rx.recv() {
+                    Ok(job) => pending.push(job),
+                    // Every sender is gone, which cannot happen while the
+                    // process lives (the sender is a `OnceLock` static), but
+                    // exiting is the only correct answer if it ever does.
+                    Err(_) => return,
+                }
+            } else {
+                // Poll at the same 1 ms cadence the inline wait used, picking
+                // up new work in the same breath.
+                match rx.recv_timeout(Duration::from_millis(1)) {
+                    Ok(job) => pending.push(job),
+                    Err(std::sync::mpsc::RecvTimeoutError::Timeout) => {}
+                    Err(std::sync::mpsc::RecvTimeoutError::Disconnected) => return,
+                }
+            }
+
+            let now = Instant::now();
+            let mut i = 0;
+            while i < pending.len() {
+                let past = now >= pending[i].deadline;
+                if live_is_zero(&pending[i].group) || past {
+                    let job = pending.swap_remove(i);
+                    // A panic here must not take the reaper down: it services
+                    // EVERY store for the life of the process and has no
+                    // supervisor. `finish` writes diagnostics and drops
+                    // guest-owned `Arc`s, so it is not panic-free by
+                    // construction.
+                    match std::panic::catch_unwind(std::panic::AssertUnwindSafe(|| {
+                        finish(job, past)
+                    })) {
+                        Ok(Some(job)) => pending.push(job), // still pending; PENDING unchanged
+                        Ok(None) => {
+                            PENDING.fetch_sub(1, Ordering::SeqCst);
+                        }
+                        Err(_) => {
+                            PENDING.fetch_sub(1, Ordering::SeqCst);
+                            // Deliberately NOT a log macro: the likeliest reason
+                            // a job panicked is that writing its diagnostic
+                            // failed, and a panic HERE is outside the
+                            // `catch_unwind` and kills the reaper -- which is
+                            // exactly how the unguarded `eprintln!` killed it.
+                            use std::io::Write;
+                            let _ = writeln!(
+                                std::io::stderr(),
+                                "wasmtime: warning: a SET teardown job panicked; its \
+                                 remaining workers were detached"
+                            );
+                        }
+                    }
+                } else {
+                    i += 1;
+                }
+            }
+
+            // Bump each DISTINCT engine once per pass, not once per job. All
+            // jobs normally share one `Engine`, so the previous per-job bump
+            // wrote the globally-read epoch counter N times per millisecond --
+            // measured 40 kHz at 40 pending jobs, against the CLI ticker's
+            // 100/s. Under `serve --wasm timeout` each redundant bump also
+            // yields the guest's fiber.
+            let mut bumped: Vec<&crate::Engine> = Vec::new();
+            for job in &pending {
+                if !bumped.iter().any(|e| crate::Engine::same(e, &job.engine)) {
+                    job.engine.increment_epoch();
+                    bumped.push(&job.engine);
+                }
+            }
+        }
+    }
+
+    /// `None` once we have tried and failed to start the thread, so a process
+    /// that cannot spawn does not retry on every teardown (and does not log on
+    /// every teardown either — that is guest-drivable).
+    static TX: OnceLock<Option<Mutex<Sender<Job>>>> = OnceLock::new();
+
+    pub(super) fn submit(job: Job) {
+        let tx = TX.get_or_init(|| {
+            let (tx, rx) = std::sync::mpsc::channel();
+            match std::thread::Builder::new()
+                .name("wasmtime-set-reaper".to_string())
+                .spawn(move || run(rx))
+            {
+                Ok(_handle) => Some(Mutex::new(tx)),
+                Err(e) => {
+                    // Once per process, so not rate-limited and not
+                    // guest-reachable as a log-flooding path.
+                    //
+                    // FAIL LOUD, and note what this still is: a LATCH. `TX` is
+                    // a `OnceLock`, so a spawn failure on the FIRST slow-path
+                    // teardown memoises "no reaper" for the life of the
+                    // process and every later straggler is detached with no
+                    // wait, no epoch bump and no diagnostic. The condition
+                    // that makes `spawn` fail is EAGAIN under thread pressure
+                    // -- which is precisely what a SET tenant creates, and
+                    // which is why `SetEpochTicker::maybe_spawn_with` fails
+                    // CLOSED for the same condition. Two mechanisms, same
+                    // trigger, opposite decisions; this one is the weaker and
+                    // is left as-is only because failing closed here would
+                    // mean refusing to tear a store down, which is worse.
+                    // NOT `log::error!`, and this is the THIRD time the rule has
+                    // had to be applied. (Round 15 claimed the default
+                    // `tracing` stderr writer does NOT panic; round 16 showed
+                    // that is false -- cli-flags builds through
+                    // `SubscriberBuilder::default()`, which sets
+                    // `log_internal_errors(true)`, and that arm `eprintln!`s.
+                    // `--log-to-files` is a second panicking path, not a
+                    // replacement. See the long note in `store.rs`.) `submit` is called from
+                    // `join_set_threads`, which is called from `Drop for
+                    // Store<T>`, with no `catch_unwind` anywhere on that stack.
+                    // Round 12 hardened the reaper's own writes and round 13
+                    // hardened `join_set_threads`' frame -- and both left this
+                    // one, in the function round 13's fix DELEGATES TO.
+                    //
+                    // It fails worse here than either: the panic unwinds out of
+                    // the first statement of `Drop`, so the store is never torn
+                    // down AND the reaper is never created, so `TX` stays
+                    // unset-as-failed and every later teardown in the process
+                    // detaches its workers silently. Self-cascading, and
+                    // triggered by exactly the EAGAIN-under-thread-pressure the
+                    // comment above says a SET tenant guarantees.
+                    use std::io::Write;
+                    let _ = writeln!(
+                        std::io::stderr(),
+                        "wasmtime: warning: could not start the SET teardown reaper ({e}); \
+                         for the REST OF THIS PROCESS, SET workers that outlive their \
+                         store will be detached without being joined, stopped or reported"
+                    );
+                    None
+                }
+            }
+        });
+        match tx {
+            Some(tx) => {
+                PENDING.fetch_add(1, Ordering::SeqCst);
+                // `lock()` can be poisoned and `send` can fail if the reaper is
+                // gone; either way the job is detached, and `PENDING` has to
+                // come back down or `set_reaper_drain` blocks for its whole
+                // timeout on every later run.
+                let sent = match tx.lock() {
+                    Ok(tx) => tx.send(job).is_ok(),
+                    Err(_) => false,
+                };
+                if !sent {
+                    PENDING.fetch_sub(1, Ordering::SeqCst);
+                }
+            }
+            // No reaper: drop the handles, i.e. detach. Silent on purpose --
+            // the one-time error above already said why.
+            None => drop(job),
+        }
+    }
+}
+
+/// Wait for the process-global reaper to finish everything already submitted.
+///
+/// For SINGLE-SHOT embedders (`wasmtime run`) only. `Drop` deliberately does not
+/// wait, which under `wasmtime run` meant the process exited before the reaper
+/// could report anything: a straggler was detached in SILENCE, while the module
+/// header advertised a loud diagnostic. Blocking here is correct for a CLI that
+/// is about to exit anyway and wrong for `serve`, which never calls it.
+///
+/// Bounded by the same join timeout, so a wedged worker cannot hold the process
+/// open indefinitely.
+#[cfg(all(feature = "std", feature = "threads"))]
+pub fn set_reaper_drain() {
+    use core::sync::atomic::Ordering;
+    let deadline = std::time::Instant::now() + set_join_timeout() + std::time::Duration::from_millis(50);
+    while reaper::PENDING.load(Ordering::SeqCst) != 0 {
+        if std::time::Instant::now() >= deadline {
+            break;
+        }
+        std::thread::sleep(std::time::Duration::from_millis(1));
+    }
+}
+
+/// Hand a store's still-live SET workers to the process-global reaper.
+///
+/// See the `reaper` module above for why this is one thread for the process
+/// rather than one per teardown.
+#[cfg(all(feature = "std", feature = "threads"))]
+pub(crate) fn set_reaper_submit(
+    group: Option<Arc<SetThreadGroup>>,
+    engine: crate::Engine,
+    joins: Vec<std::thread::JoinHandle<()>>,
+    deadline: std::time::Instant,
+) {
+    reaper::submit(reaper::Job {
+        group,
+        engine,
+        joins,
+        deadline,
+    });
+}
+
+/// `SetThreadGroup::exit_status` when no worker has called `proc_exit`. Out of
+/// `i32` range, so every possible exit code is representable.
+const NO_WORKER_EXIT: i64 = i64::MIN;
+
+/// Sustained thread CREATIONS per second this process will serve.
+///
+/// **What this can and cannot do, because the honest answer is not the obvious
+/// one.** A "legitimate" tight thread-per-task loop and a "hostile" fork bomb
+/// are the same workload: one thread alive at a time, created as fast as the
+/// kernel allows. Measured on this hardware they differ by less than 30%
+/// (~14,600/s vs ~19,000/s). No rate can tell them apart, and any limit tight
+/// enough to stop the second breaks the first.
+///
+/// So this is a BACKSTOP against a pathological rate, not a policy that
+/// separates intent. What actually charges a tenant for the cost is the
+/// cgroup: thread creation is kernel time in the tenant's own `cpu.weight`
+/// share, so under contention it already gets what it paid for and no more.
+/// The limiter exists so that an UNCONTENDED node cannot be pushed to ~1.3 CPU
+/// seconds per wall second of pure `clone`/exit by one guest.
+///
+/// The live-thread cap bounds CONCURRENCY, and a hostile guest simply does not
+/// hold threads concurrently: `worker(){ spawn(worker); return; }` keeps the
+/// live count at 1-2 forever while creating threads at the kernel's maximum
+/// rate. Measured on the shipped engine: 35,871 create+exit pairs in 1.5 s,
+/// ~0.9 of a core burnt in `clone`/exit — and `ENCLAVE_MAX_SET_THREADS=4` made
+/// no difference at all (35,463). Thread creation is a NODE-WIDE cost, so that
+/// is a noisy-neighbour denial of service against every other tenant, which is
+/// exactly what the concurrency cap's own comment claims to prevent.
+///
+/// So creation CAN be rate-limited too, with a token bucket whose burst is one
+/// second's worth of tokens (`spawn_burst`) — but it is OFF by default and the
+/// paragraphs below explain why. `ENCLAVE_MAX_SET_SPAWN_RATE` sets the
+/// per-second figure; `0`, THE DEFAULT, disables the limiter entirely.
+///
+/// **Off by default, after two implementations of it each made things worse.**
+/// A REFUSING limiter is cheaper for the guest than the spawn it refuses, so a
+/// guest that retries spins instead of exiting: 50.3 CPU-seconds per 2 wall
+/// seconds against 13.8 with it off, i.e. it turned a spawn-and-exit bomb into
+/// a spawn-and-spin bomb and TRIPLED the cost it existed to bound. A WAITING
+/// limiter (which replaced it) blocks inside the host call on the guest's
+/// fiber -- under `serve` that is a tokio worker: measured 101 of 2207 expected
+/// timer wakeups over a 2.2 s window, 2 s of timer lateness, and, because
+/// sleeping is not kernel time, **0.00 CPU seconds**. So `cpu.weight` charges
+/// nothing, `cpu.max` throttles nothing, and a CPU-based watchdog sees an idle,
+/// healthy process while the server answers no requests at all.
+///
+/// Both failures follow from the admission above: no rate separates the
+/// legitimate shape from the hostile one, so this can only ever be a backstop,
+/// and neither backstop was worth its price. The cgroup already charges
+/// creation to the tenant that caused it and the live cap already bounds the
+/// memory. An operator who wants the backstop anyway sets the variable; it
+/// then REFUSES, never waits, and the spin amplification is what they bought.
+fn max_spawn_rate() -> u64 {
+    use std::sync::OnceLock;
+    static CACHED: OnceLock<u64> = OnceLock::new();
+    *CACHED.get_or_init(|| {
+        if let Ok(v) = std::env::var("ENCLAVE_MAX_SET_SPAWN_RATE") {
+            if let Ok(n) = v.trim().parse::<u64>() {
+                return n;
+            }
+        }
+        // No floor, because there is no default limit to floor. The
+        // sizing analysis that used to live here (4096/s, from the ~14,600
+        // creations/s a legitimate thread-per-task loop reaches) is kept in
+        // the doc comment above as the reason an operator's chosen value has
+        // to be large, not as a default this function returns.
+        0
+    })
+}
+
+/// Put a token back, for a spawn that took one and was then refused for another
+/// reason (the live cap, or the OS declining the thread). Without this a guest
+/// sitting at its concurrency cap drains its own creation budget.
+pub fn refund_spawn_token() {
+    if max_spawn_rate() == 0 {
+        return;
+    }
+    with_spawn_bucket(|bucket, rate| {
+        bucket.tokens = (bucket.tokens + 1.0).min(spawn_burst(rate));
+    });
+}
+
+/// The token bucket behind `max_spawn_rate`. Process-global, because OS threads
+/// are.
+struct SpawnRate {
+    tokens: f64,
+    last: std::time::Instant,
+}
+
+/// Burst size: ONE second's worth, saturating.
+///
+/// Four seconds' worth made the limit invisible over any short window (a 2 s
+/// spawn bomb got 21,000 creations against a 4096/s limit, because the burst
+/// dominated). A pool filling at startup needs at most `max_live_threads`
+/// tokens — 128 on a 32-core node — so one second's worth is ample for every
+/// real shape while making the sustained rate the thing that actually binds.
+///
+/// Saturating because `max_spawn_rate` takes an arbitrary `u64` from the
+/// environment: plain `u64` arithmetic would wrap a large value to a burst of 0
+/// and then refuse every spawn forever while reporting a vast rate.
+fn spawn_burst(rate: u64) -> f64 {
+    (rate as f64).min(u32::MAX as f64)
+}
+
+fn with_spawn_bucket<R>(f: impl FnOnce(&mut SpawnRate, u64) -> R) -> R {
+    use std::sync::{Mutex, OnceLock};
+    let rate = max_spawn_rate();
+    static BUCKET: OnceLock<Mutex<SpawnRate>> = OnceLock::new();
+    let bucket = BUCKET.get_or_init(|| {
+        Mutex::new(SpawnRate {
+            tokens: spawn_burst(max_spawn_rate()),
+            last: std::time::Instant::now(),
+        })
+    });
+    let mut bucket = match bucket.lock() {
+        Ok(b) => b,
+        Err(e) => e.into_inner(),
+    };
+    f(&mut bucket, rate)
+}
+
+/// Try to take one spawn token without waiting. Returns the time until one
+/// would be available if there is none.
+fn try_take_spawn_token() -> Result<(), std::time::Duration> {
+    with_spawn_bucket(|bucket, rate| {
+        let now = std::time::Instant::now();
+        let elapsed = now.duration_since(bucket.last).as_secs_f64();
+        bucket.last = now;
+        bucket.tokens = (bucket.tokens + elapsed * rate as f64).min(spawn_burst(rate));
+        if bucket.tokens < 1.0 {
+            let short_by = 1.0 - bucket.tokens;
+            return Err(std::time::Duration::from_secs_f64(short_by / rate as f64));
+        }
+        bucket.tokens -= 1.0;
+        Ok(())
+    })
+}
+
+/// Take one spawn token, or report that the limit is in force. NEVER BLOCKS.
+///
+/// Not sleeping here is a hard constraint, not a preference. This runs in the
+/// `thread.spawn` libcall, on the guest's fiber -- under `wasmtime serve` that
+/// fiber is resumed inline on a tokio worker, so a sleep removes a worker from
+/// the runtime along with the I/O, timers and accepts it was about to poll. It
+/// is also invisible to all three stop paths: the epoch only traps compiled
+/// wasm, the parking spot only reaches a thread in `memory.atomic.wait`, and
+/// the guest future cannot be dropped while it is inside `poll`. `common.rs`
+/// disables `allow_blocking_current_thread` for precisely this reason; a host
+/// call that blocks inline defeats that decision from the inside.
+pub fn take_spawn_token() -> bool {
+    if max_spawn_rate() == 0 {
+        return true;
+    }
+    try_take_spawn_token().is_ok()
+}
+
+/// Live SET workers in this PROCESS. See `max_live_threads`.
+static LIVE_SET_THREADS: AtomicUsize = AtomicUsize::new(0);
+
+/// State shared by a primary store and every SET worker spawned from it.
+///
+/// One per store, created lazily on the first spawn. Everything a worker needs
+/// to be *stopped from the outside* lives here, plus the one piece of state a
+/// worker needs to report *upwards*: a `proc_exit`.
+pub struct SetThreadGroup {
+    /// "Stop now." Set at store teardown, and by a worker that called
+    /// `proc_exit` (under POSIX `exit()` ends the process, and a component
+    /// instance is the process).
+    ///
+    /// An `Arc<AtomicBool>` of its own because that is what the parking spot's
+    /// thread-local takes; a worker parked in `memory.atomic.wait` polls it.
+    stop: Arc<AtomicBool>,
+
+    /// The exit status of the first worker to call `proc_exit`, or
+    /// `NO_WORKER_EXIT` for "no worker has exited". Read by the primary's
+    /// embedder so a worker's `exit()` ends the component instead of silently
+    /// wedging it.
+    ///
+    /// An `i64` with an out-of-`i32`-range sentinel, NOT `code + 1` with 0
+    /// meaning none: `exit(-1)` is a perfectly ordinary thing for a program to
+    /// do, and encoding it as 0 silently downgraded it to "no exit" while the
+    /// group was still stopped — so the CLI reported "asked to stop" instead of
+    /// a status.
+    exit_status: AtomicI64,
+
+    /// Workers spawned from this store that have not yet finished. Lets
+    /// teardown wait on a *count* rather than on join handles it may have to
+    /// abandon.
+    live: AtomicUsize,
+
+    /// The shared memories these threads coordinate through, so a stop request
+    /// can unpark everything parked on them — including the MAIN thread, which
+    /// is not a worker, holds no cancellation flag, and, sitting in
+    /// `pthread_join`, reaches no epoch check either.
+    memories: std::sync::Mutex<Vec<SharedMemory>>,
+}
+
+impl SetThreadGroup {
+    pub(crate) fn new_shared() -> Arc<SetThreadGroup> {
+        Arc::new(SetThreadGroup {
+            stop: Arc::new(AtomicBool::new(false)),
+            exit_status: AtomicI64::new(NO_WORKER_EXIT),
+            live: AtomicUsize::new(0),
+            memories: std::sync::Mutex::new(Vec::new()),
+        })
+    }
+
+    /// Ask every worker in this group to stop at its next checkpoint: its next
+    /// epoch check, its next parking-spot poll, or — for a worker blocked in a
+    /// host call — the embedder dropping its guest future.
+    pub fn request_stop(&self) {
+        self.stop.store(true, Ordering::SeqCst);
+        // Wake everything parked on the shared memories so the flag is seen
+        // now rather than at the next polling quantum.
+        //
+        // Poisoning is RECOVERED FROM, not skipped. `request_stop` runs from
+        // `Drop for Store<T>`; a poisoned lock there would silently stop
+        // unparking anything for the life of the group — a stop requested and
+        // then missed, which is the exact failure this whole mechanism exists
+        // to prevent. The `Vec` is only ever appended to under this lock, so a
+        // panic cannot have left it in a state iteration minds.
+        let memories = match self.memories.lock() {
+            Ok(m) => m,
+            Err(e) => e.into_inner(),
+        };
+        for memory in memories.iter() {
+            memory.notify_all_waiters();
+        }
+    }
+
+    /// Register a shared memory this group coordinates through. Idempotent per
+    /// memory; called on each spawn, which is where the memories are known.
+    fn watch_memory(&self, memory: &SharedMemory) {
+        memory.set_group_stop_flag(self.stop.clone());
+        let mut memories = match self.memories.lock() {
+            Ok(m) => m,
+            Err(e) => e.into_inner(),
+        };
+        if !memories.iter().any(|m| SharedMemory::ptr_eq(m, memory)) {
+            memories.push(memory.clone());
+        }
+    }
+
+    /// Whether a stop has been requested. An embedder polls this to cancel a
+    /// worker that is blocked in a host call and so reaches no other checkpoint.
+    pub fn stop_requested(&self) -> bool {
+        self.stop.load(Ordering::Relaxed)
+    }
+
+    pub(crate) fn live_workers(&self) -> usize {
+        self.live.load(Ordering::Acquire)
+    }
+
+    /// The exit status a worker reported via `proc_exit`, if any.
+    pub fn worker_exit_status(&self) -> Option<i32> {
+        match self.exit_status.load(Ordering::Acquire) {
+            NO_WORKER_EXIT => None,
+            n => Some(n as i32),
+        }
+    }
+
+    /// Record a worker's `proc_exit` and stop the rest of the group. First
+    /// writer wins, matching POSIX (the first thread to call `exit` decides).
+    ///
+    /// Called by the EMBEDDER from its [`SetWorkerHost::run_worker`], because
+    /// only the embedder can recognise its own exit error type.
+    pub fn record_worker_exit(&self, code: i32) {
+        let _ = self.exit_status.compare_exchange(
+            NO_WORKER_EXIT,
+            i64::from(code),
+            Ordering::AcqRel,
+            Ordering::Relaxed,
+        );
+        self.request_stop();
+    }
+}
+
+/// Monotonic SET thread ids handed back to guests. Non-negative i32 range;
+/// starts at 1 (0 is reserved by convention for "the main thread").
+static NEXT_SET_THREAD_ID: AtomicU64 = AtomicU64::new(1);
+
+/// How often one refusal reason may print its diagnostic.
+const REFUSAL_DIAGNOSTIC_PERIOD_SECS: u64 = 10;
+
+/// Process start, so the rate limiter can hold a monotonic `u64` rather than an
+/// `Instant` (which is not `const`-constructible for a `static`).
+fn process_uptime_secs() -> u64 {
+    use std::sync::OnceLock;
+    use std::time::Instant;
+    static START: OnceLock<Instant> = OnceLock::new();
+    START.get_or_init(Instant::now).elapsed().as_secs()
+}
+
+/// True at most once per `REFUSAL_DIAGNOSTIC_PERIOD_SECS` for the given site.
+///
+/// `LAST` holds "the uptime second at which this site last printed, plus one",
+/// so the zero-initialized state means "never printed".
+fn refusal_diagnostic_due(last: &AtomicU64) -> bool {
+    let now = process_uptime_secs() + 1;
+    let prev = last.load(Ordering::Relaxed);
+    if prev != 0 && now.saturating_sub(prev) < REFUSAL_DIAGNOSTIC_PERIOD_SECS {
+        return false;
+    }
+    last.compare_exchange(prev, now, Ordering::AcqRel, Ordering::Relaxed)
+        .is_ok()
+}
+
+/// Which core instance of a worker's component instantiation shares memory with
+/// the primary, and which memories those are.
+///
+/// A worker is a full re-instantiation of the SAME component in its own store.
+/// Everything in it is the worker's own except the linear memories named here,
+/// which are re-pointed at the primary's `SharedMemory` before that core
+/// instance's startup function runs.
+///
+/// `RuntimeInstanceIndex` is deliberately how the target is named: an
+/// `InstanceId` belongs to the primary store and means nothing in another one,
+/// while a runtime instance index names the same core instance in every
+/// instantiation of the same component.
+pub struct SetViewPlan {
+    instance_index: RuntimeInstanceIndex,
+    shared_memories: Vec<(DefinedMemoryIndex, SharedMemory)>,
+}
+
+impl SetViewPlan {
+    /// Whether the core instance about to be created is the one to swap.
+    pub(crate) fn targets(&self, idx: RuntimeInstanceIndex) -> bool {
+        self.instance_index == idx
+    }
+
+    /// Re-point the freshly allocated instance's defined memories at the
+    /// primary's shared memories. Runs BEFORE any compiled wasm executes in
+    /// this instance.
+    pub(crate) fn install(
+        &self,
+        opaque: &mut StoreOpaque,
+        instance: crate::Instance,
+    ) -> Result<()> {
+        // The preconditions of `replace_defined_memory_with_shared` are checked
+        // HERE, not with a `debug_assert!`, because a release build is exactly
+        // where a mismatch would go unnoticed and write a `VMMemoryDefinition`
+        // pointer into a slot that holds an inline definition. They cannot fail
+        // for a plan built by `spawn_funcref` against the same component —
+        // which is the point: if they ever do, an assumption has changed and
+        // the worker must not run. Checked in full before anything is written,
+        // so a failure leaves the instance untouched.
+        {
+            let vminstance = opaque.instance(instance.id());
+            let module = vminstance.env_module();
+            for (index, shared) in &self.shared_memories {
+                let mem_index = module.memory_index(*index);
+                let declared = module.memories.get(mem_index).ok_or_else(|| {
+                    crate::format_err!(
+                        "SET worker: memory {} does not exist in this instantiation",
+                        index.as_u32()
+                    )
+                })?;
+                if !declared.shared {
+                    bail!(
+                        "SET worker: memory {} is not declared `shared` in this \
+                         instantiation; refusing to install the spawning thread's \
+                         shared memory",
+                        index.as_u32()
+                    );
+                }
+                if declared != shared.ty() {
+                    bail!(
+                        "SET worker: memory {} has a different type in this \
+                         instantiation than in the spawning one",
+                        index.as_u32()
+                    );
+                }
+            }
+        }
+        let mut vminstance: Pin<&mut VmInstance> = opaque.instance_mut(instance.id());
+        for (index, shared) in &self.shared_memories {
+            // SAFETY: no guest code has run in this instance yet — this hook is
+            // invoked before the startup function — and the memory is declared
+            // shared (checked directly above), so the vmctx slot is the
+            // out-of-line pointer form.
+            unsafe {
+                vminstance
+                    .as_mut()
+                    .replace_defined_memory_with_shared(*index, shared.clone());
+            }
+        }
+        Ok(())
+    }
+}
+
+/// Everything a worker thread needs to build and run its component instance.
+///
+/// Deliberately contains NO raw pointers into the primary store: the component
+/// is a refcounted handle, and the shared memories are `Arc`s (the one piece of
+/// state a worker genuinely shares). `SetWorkerRequest` is therefore `Send`
+/// without a single `unsafe impl` and the compiler proves it. That is what
+/// makes a bounded, detach-on-timeout teardown sound.
+///
+/// Handed to the embedder's [`SetWorkerHost`], because building a store means
+/// building an embedder context of type `T`, which the runtime layer cannot do
+/// generically.
+pub struct SetWorkerRequest {
+    component: crate::component::Component,
+    plan: SetViewPlan,
+    /// Where the start function lives, named so any instantiation can resolve
+    /// it: the core instance's runtime index plus the function's index within
+    /// that instance's module.
+    start_instance: RuntimeInstanceIndex,
+    /// The component instance owning `start_instance`, for the sync-call
+    /// bookkeeping a guest entry needs (mirrors what the primary does when it
+    /// runs a core instance's `start` function).
+    start_component_instance: Option<RuntimeComponentInstanceIndex>,
+    func_index: FuncIndex,
+    start_arg: i32,
+    thread_id: i64,
+    /// The group this worker belongs to: the stop flag every stop path drives,
+    /// the live-worker count teardown waits on, and the slot a `proc_exit` is
+    /// reported through. Shared with the primary store and every sibling.
+    group: Arc<SetThreadGroup>,
+    /// The embedder hook itself, so a worker can spawn workers of its own.
+    host: Arc<dyn SetWorkerHost>,
+}
+
+/// Embedder hook that turns a [`SetWorkerRequest`] into a running thread.
+///
+/// A worker needs a `Store<T>` and an `InstancePre<T>` — both parameterised by
+/// the embedder's data type, which the runtime layer cannot construct. The
+/// embedder registers one of these on the primary store with
+/// [`Store::set_set_worker_host`](crate::Store::set_set_worker_host); spawn
+/// refuses (ABI `-1`) if none is registered, so an embedder that has not opted
+/// in gets the guest's sequential fallback rather than a broken thread.
+///
+/// The implementation runs on the WORKER's own OS thread and should:
+/// build a fresh embedder context, create a `Store` from it, and call
+/// [`SetWorkerRequest::run_async`] on its own async executor.
+pub trait SetWorkerHost: Send + Sync + 'static {
+    /// Run one worker to completion on the calling (worker) OS thread.
+    ///
+    /// # Embedder obligation
+    ///
+    /// Store teardown BOUNDS its wait and then DETACHES a worker that has not
+    /// stopped (see `StoreOpaque::join_set_threads`). So everything this
+    /// function's `Store<T>`, its `T`, and this host itself can reach must
+    /// either outlive the primary store or be refcounted. Nothing in the type
+    /// system checks that: `SetWorkerRequest: Send` covers the hand-off, not
+    /// the lifetime afterwards. If your embedder cannot meet it, set
+    /// `ENCLAVE_SET_JOIN_TIMEOUT_MS=0` to restore an unbounded join and accept
+    /// that a non-returning guest thread wedges teardown.
+    fn run_worker(&self, req: SetWorkerRequest) -> Result<()>;
+
+    /// Recognise the embedder's own "the guest called `proc_exit`" error.
+    ///
+    /// The runtime layer cannot: the WASI error type
+    /// (`wasmtime_wasi::I32Exit`) lives in a crate this one does not depend on.
+    /// But the distinction is not cosmetic — a worker that EXITED is ending the
+    /// whole component, so its siblings are stopped and the guest's thread-death
+    /// hook is deliberately NOT run. Running it would release a joiner and let
+    /// the main thread carry on past an `exit()`, which is precisely the wedge
+    /// this is here to remove.
+    ///
+    /// The default says "never an exit", which is safe: a worker's failure is
+    /// then treated as a trap, and only that worker dies.
+    fn exit_status(&self, _err: &crate::Error) -> Option<i32> {
+        None
+    }
+}
+
+/// `thread.spawn-ref`: `funcref` is the guest's `(ref null (shared func))`
+/// argument, passed by the trampoline as a raw pointer.
+pub(crate) fn spawn_ref(
+    store: &mut dyn VMStore,
+    instance: crate::component::Instance,
+    funcref: *mut u8,
+    arg: u32,
+) -> Result<ThreadSpawnResult> {
+    let Some(funcref) = NonNull::new(funcref.cast::<VMFuncRef>()) else {
+        // A null start function can never run; the ABI's failure result is
+        // reserved for resource exhaustion, so this is a guest bug => trap.
+        bail!("thread.spawn-ref: start function reference is null");
+    };
+    spawn_funcref(store.store_opaque_mut(), instance, funcref, arg)
+}
+
+/// `thread.spawn-indirect`: resolve `elem` in the canon-declared table, on
+/// the calling (store-owning) thread, then spawn like `spawn-ref`.
+pub(crate) fn spawn_indirect(
+    store: &mut dyn VMStore,
+    instance: crate::component::Instance,
+    table: RuntimeTableIndex,
+    elem: u32,
+    arg: u32,
+) -> Result<ThreadSpawnResult> {
+    let store = store.store_opaque_mut();
+    let func = {
+        let (component, registry) = instance.id().get_mut_and_registry(store);
+        component.index_runtime_func_table(registry, table, u64::from(elem))?
+    };
+    let Some(func) = func else {
+        bail!("thread.spawn-indirect: table element {elem} is uninitialized");
+    };
+    let funcref = func.vm_func_ref(store);
+    spawn_funcref(store, instance, funcref, arg)
+}
+
+/// Common spawn path. Runs on the thread that owns the primary store, with
+/// `&mut StoreOpaque` legally held — every read of primary state happens
+/// here, not on the worker.
+fn spawn_funcref(
+    store: &mut StoreOpaque,
+    instance: crate::component::Instance,
+    funcref: NonNull<VMFuncRef>,
+    arg: u32,
+) -> Result<ThreadSpawnResult> {
+    // The ABI's graceful failure: log why, hand the guest -1, let it take its
+    // sequential fallback.
+    //
+    // The diagnostic is rate-limited per REFUSAL REASON rather than printed
+    // once: a guest whose module shape is unsupported typically calls spawn in
+    // a loop, and an unbounded `log::warn!`/`eprintln!` stream is a free
+    // log-volume amplifier — but a process that serves many instances over
+    // time (`wasmtime serve` builds a fresh store per request) must not have
+    // its second tenant's diagnostic swallowed by its first, which a plain
+    // `Once` did.
+    macro_rules! refuse {
+        ($($msg:tt)*) => {{
+            // The `static` lives in the macro body, so each expansion site gets
+            // its own clock and one refusal reason never silences another.
+            static LAST: AtomicU64 = AtomicU64::new(0);
+            if refusal_diagnostic_due(&LAST) {
+                log::warn!($($msg)*);
+                eprintln!(
+                    "wasmtime: thread.spawn refused: {} (identical refusals are \
+                     rate-limited to one per {REFUSAL_DIAGNOSTIC_PERIOD_SECS}s)",
+                    format_args!($($msg)*),
+                );
+            }
+            return Ok(ThreadSpawnResult::FAILED);
+        }};
+    }
+
+    // Everything up to the ownership check below reads through RAW POINTERS.
+    // A `VMFuncRef` for an escaped function lives inside its defining
+    // instance's vmctx allocation, so `funcref.as_ref()` before that check
+    // would form a `&` into an allocation that — on the very path the check
+    // exists to catch — another thread may hold `&mut` to. Round 4 fixed this
+    // for the `Instance` and left the funcref itself; same rule, same fix.
+    //
+    // SAFETY: `funcref` is a live `VMFuncRef` per this function's contract, and
+    // these fields are written once at instantiation.
+    let raw_vmctx = unsafe { core::ptr::addr_of!((*funcref.as_ptr()).vmctx).read() };
+    let type_index = unsafe { core::ptr::addr_of!((*funcref.as_ptr()).type_index).read() };
+
+    // The start function must be plain core wasm — a component trampoline or
+    // host function cannot be the body of a spawned thread.
+    let vmctx_magic = unsafe { raw_vmctx.as_non_null().cast::<u32>().read() };
+    if vmctx_magic != VMCONTEXT_MAGIC {
+        bail!("thread.spawn: start function is not a core wasm function");
+    }
+
+    // Signature check: the SET spawn ABI start type is `(func (param i32))`.
+    {
+        let ty = crate::FuncType::from_shared_type_index(store.engine(), type_index);
+        let ok = ty.results().len() == 0
+            && ty.params().len() == 1
+            && matches!(ty.params().next(), Some(crate::ValType::I32));
+        if !ok {
+            bail!("thread.spawn: start function must have type (param i32) -> ()");
+        }
+    }
+
+    // SAFETY: the magic check above proved this is a core-module vmctx.
+    let defining: NonNull<VmInstance> =
+        unsafe { VmInstance::from_vmctx(raw_vmctx.as_non_null().cast()) };
+    // Ownership is established BEFORE any reference is formed. A funcref from a
+    // foreign store would belong to an allocation another thread may hold `&mut`
+    // to, so `as_ref()`-then-check would commit the very violation it reports —
+    // the same rule `ComponentInstance::enter_host_from_wasm` follows.
+    // SAFETY: the pointer is derived from a live vmctx of a core module.
+    if !unsafe { VmInstance::ptr_belongs_to_store(defining, store) } {
+        bail!("thread.spawn: start function belongs to a different store");
+    }
+    // SAFETY: it is this store's instance, and we hold `&mut StoreOpaque`, so no
+    // other thread can be executing in it.
+    let defining = unsafe { defining.as_ref() };
+
+    let Some(func_index) = defining.func_index_of_func_ref(funcref) else {
+        refuse!("start funcref is not one of its defining instance's escaped functions");
+    };
+
+    // ---- v1 module-shape guards: refuse any shape whose execution view ----
+    // ---- would not faithfully share state with the primary instance.  ----
+    let module = defining.env_module();
+
+    // A guest `start` section is ALLOWED, and runs once per worker.
+    //
+    // This is a deliberate semantic choice, not an oversight. `wasm-ld
+    // --shared-memory` always emits `__wasm_init_memory` as the start
+    // function, and that ABI was designed for instantiation-per-thread
+    // hosts (wasi-threads): the initializer takes an atomic once-flag IN THE
+    // SHARED MEMORY, so the primary's run initializes and every worker's
+    // re-run observes the flag and skips — a no-op by the very contract the
+    // linker emits it under. Refusing here (as an earlier revision did) would
+    // refuse every module `clang -pthread` can produce.
+    //
+    // The residual, stated plainly: a HAND-WRITTEN start section that mutates
+    // shared memory without such a guard re-runs per worker and can corrupt
+    // the guest's own shared state. That is in-sandbox, self-inflicted, and
+    // the same contract wasi-threads (p1) already imposes on start sections in
+    // shared-memory modules.
+    if module.needs_gc_heap {
+        refuse!("module requires a GC heap (unsupported on SET threads)");
+    }
+    // Refuse SEGMENTED memory initialization. wasmtime's synthesized startup
+    // applies active data segments through a compiled `memory.init` whose only
+    // guard is a null-check on the segment base, and that base is nulled only
+    // for a `Static` (CoW) image — NOT for a `Segmented` module. So a worker's
+    // startup would re-copy active-segment bytes into the now-swapped-in
+    // SHARED memory on every spawn, clobbering data the primary (and live
+    // siblings) already wrote. `wasm-ld --shared-memory` output is NOT
+    // segmented — it uses passive segments driven by `__wasm_init_memory`
+    // behind the shared once-flag above — so the real toolchain is unaffected;
+    // a hand-written or non-lld guest with an active data segment (offset via
+    // `global.get`, extended-const arithmetic, or a >16 MiB sparse span) gets
+    // the sequential fallback rather than silent shared-memory corruption.
+    // This is the fail-closed posture the rest of these guards take: a shape
+    // we cannot execute faithfully is refused, never approximated.
+    if module.memory_initialization.is_segmented() {
+        refuse!(
+            "module uses segmented memory initialization (active data segments); \
+             their re-init would clobber the shared memory on each spawn \
+             (unsupported on SET threads)"
+        );
+    }
+    for (idx, mem) in module.memories.iter() {
+        if !mem.shared {
+            refuse!(
+                "memory {} is not `shared`; every memory of a module spawning \
+                 SET threads must be shared",
+                idx.as_u32()
+            );
+        }
+    }
+    if module.num_imported_tables != 0 {
+        refuse!("module imports a table (unsupported on SET threads)");
+    }
+    if module.num_imported_globals != 0 {
+        refuse!("module imports a global (unsupported on SET threads)");
+    }
+    // An IMPORTED memory is the dangerous one, not merely unsupported:
+    // `memory.grow` and `memory.atomic.wait*`/`notify` on an imported memory
+    // are lowered to call the builtin with the DEFINING instance's vmctx, so
+    // a worker's futex wait would re-enter the primary store. The core-side
+    // guard in `Instance::enter_host_from_wasm` now catches that too, but
+    // refusing here means such a guest gets its sequential fallback instead
+    // of a trap on its first mutex acquisition.
+    if module.num_imported_memories != 0 {
+        refuse!(
+            "module imports a memory; memory operations on it resolve through \
+             the defining instance (unsupported on SET threads)"
+        );
+    }
+    if module.num_imported_tags != 0 {
+        refuse!("module imports a tag (unsupported on SET threads)");
+    }
+    // Requiring a DECLARED table maximum bounds a worker's `table.grow` to a
+    // static property of the module the primary already validated. The
+    // embedder's dynamic cap (`-W max-table-elements`) still applies to a
+    // worker whose store installs a limiter — the CLI's does — but it applies
+    // PER STORE, so the group total is up to `1 + max_live_threads()` times it.
+    // That multiplication is real and is documented in the module header;
+    // this static bound is what keeps it finite even without a limiter.
+    for (idx, table) in module.tables.iter() {
+        if table.limits.max.is_none() {
+            refuse!(
+                "table {} has no declared maximum; unbounded growth on a worker \
+                 would escape the embedder's table limit",
+                idx.as_u32()
+            );
+        }
+    }
+    for (idx, global) in module.globals.iter() {
+        if global.shared && global.mutability {
+            refuse!(
+                "global {} is mutable and `shared`; cross-thread global \
+                 mutation is not implemented (guests coordinate through \
+                 shared memory)",
+                idx.as_u32()
+            );
+        }
+    }
+    if defining.runtime_module().is_none() {
+        refuse!("cannot spawn from a synthetic module");
+    }
+    // A worker shares exactly one thing with its spawner: the linear memories
+    // named by the plan. If the spawning core instance defines none, a worker
+    // would share NOTHING — every memory in its instantiation would be private
+    // — and a guest that believes it has threads over shared memory would get
+    // silent divergence instead. Refuse; the guest takes its sequential
+    // fallback. (The loop above already rejected a defined memory that is not
+    // `shared`, so "none shared" here means "none at all".)
+    let shared_memories = defining.defined_shared_memories_cloned();
+    if shared_memories.is_empty() {
+        refuse!(
+            "the spawning core instance defines no `shared` memory; a worker \
+             would share no state with the thread that spawned it"
+        );
+    }
+
+    // ---- locate the start function in COMPONENT-RELATIVE terms ----
+    //
+    // A worker re-instantiates the whole component in its own store, so the
+    // start function must be named by something that resolves in ANY
+    // instantiation: the core instance's `RuntimeInstanceIndex` plus the
+    // function's index inside that instance's module. An `InstanceId` would
+    // not do — it belongs to this store.
+    //
+    // (Why not import substitution instead of a whole instantiation: see the
+    // module header. Short version — Cranelift bakes the call address in, so
+    // substituting the import only changes which vmctx the primary's code is
+    // handed.)
+    let component_instance = instance.id().get(store);
+    let component = component_instance.component().clone();
+    let Some(start_instance) = component_instance.runtime_instance_index_of(defining.id()) else {
+        refuse!("start function's core instance does not belong to this component instance");
+    };
+    // The component instance owning that core instance, for the same sync-call
+    // bookkeeping the primary performs when it runs a core `start` function.
+    let start_component_instance = {
+        let env = component.env_component();
+        env.initializers
+            .iter()
+            .filter_map(|init| match init {
+                wasmtime_environ::component::GlobalInitializer::InstantiateModule(_, ci) => {
+                    Some(*ci)
+                }
+                _ => None,
+            })
+            .nth(start_instance.as_u32() as usize)
+            .flatten()
+    };
+
+    // The embedder must have opted in: building a worker store means building
+    // an embedder context of type `T`, which this layer cannot do generically.
+    // Without a host, refuse (ABI `-1`) so the guest takes its sequential
+    // fallback — never a half-built thread.
+    let Some(host) = store.set_worker_host() else {
+        refuse!(
+            "no SET worker host is registered on this store; the embedder must call \
+             `Store::set_set_worker_host` to enable shared-everything-threads spawning"
+        );
+    };
+
+    // Not a refusal, but the single most consequential misconfiguration there
+    // is, so it is said out loud once. Without `Config::epoch_interruption` the
+    // compiled code carries no epoch checks at all, so a worker spinning in
+    // pure compute cannot be stopped by anything short of killing the process:
+    // teardown's stop flag is only observed at a parking spot or a host call.
+    // The wasmtime CLI enables epochs and a periodic ticker automatically when
+    // `-W shared-everything-threads` is on; other embedders must.
+    if !store.engine().get_epoch_interruption() {
+        static LAST: AtomicU64 = AtomicU64::new(0);
+        if refusal_diagnostic_due(&LAST) {
+            let msg = "shared-everything-threads is spawning workers on an engine \
+                       WITHOUT `Config::epoch_interruption`; a worker that never \
+                       yields cannot be interrupted, and store teardown will detach \
+                       it rather than block. Enable epoch interruption and run a \
+                       periodic `Engine::increment_epoch` ticker.";
+            log::warn!("{msg}");
+            eprintln!("wasmtime: warning: {msg}");
+        }
+    }
+
+    // ---- refuse once this group is stopping ----
+    //
+    // Two things depend on this, and both were reachable without it.
+    //
+    // Teardown asks the group to stop and then waits for its live count to
+    // reach zero. A worker that keeps spawning keeps that count above zero, so
+    // the wait can never be satisfied and every teardown ends on the detach
+    // path. Worse, the guest's thread-death hook runs on the WORKER's store,
+    // which has this same host and group registered — so a hook that spawns a
+    // thread that traps gets another hook, unboundedly, and a component can
+    // outlive the store that created it with a full complement of threads.
+    //
+    // Checked BEFORE the counters are touched, so a refusal leaves nothing to
+    // unwind, and last among the guards so a stopping group still reports the
+    // more informative reason for an unsupported module shape.
+    //
+    // NARROWED, not closed, and worth saying so: this check and the
+    // `live.fetch_add` below are not one atomic step, so a NESTED spawn racing
+    // the primary's `Drop` can read "not stopping", let teardown observe
+    // `live == 0`, and only then register. The consequence is bounded — that
+    // worker holds only `Arc`s, and it sees the stop flag at its first epoch
+    // check or its 5 ms cancel poll — but teardown may return before it does.
+    if group_if_any(store).is_some_and(|g| g.stop_requested()) {
+        refuse!(
+            "this component's thread group is stopping (store teardown, or another \
+             thread called `proc_exit`); no new threads are started"
+        );
+    }
+
+    // ---- and never from inside the guest's thread-death hook ----
+    //
+    // The hook is the one window where guest code runs with every stop path
+    // disarmed (a plain trap deadline replaces the stop-flag callback), so it
+    // must not be able to create the next window. Refusing only while the group
+    // was STOPPING was not enough: a hook that spawns a thread that traps gets
+    // another hook, and the chain reached depth 64 in ~4 s bounded by nothing
+    // but the creation-rate bucket, each link holding a cap slot until teardown.
+    if in_guest_thread_died_hook() {
+        refuse!(
+            "`{GUEST_THREAD_DIED_EXPORT}` may not spawn threads; it is an epilogue \
+             that runs with interruption disarmed"
+        );
+    }
+
+    // ---- rate-limit thread CREATION, which the live cap does not bound ----
+    //
+    // A fast cap check runs FIRST, deliberately. A guest parked at its
+    // concurrency cap is also the one most likely to find the bucket empty,
+    // and taking a token only to hand it straight back at the cap made the
+    // "a hostile guest is throttled" claim false for exactly the shape that
+    // reaches the cap: measured 2.3 MILLION refused spawns per second, with
+    // the limiter contributing 18%. The authoritative compare-exchange below
+    // still decides; this only avoids paying for a token first.
+    if LIVE_SET_THREADS.load(Ordering::Acquire) >= max_live_threads() {
+        refuse!(
+            "live SET thread cap reached ({}); raise ENCLAVE_MAX_SET_THREADS \
+             or lower the guest's pool size",
+            max_live_threads()
+        );
+    }
+    if !take_spawn_token() {
+        refuse!(
+            "SET thread creation rate limit reached ({}/s); a guest that spawns and \
+             immediately exits is not bounded by the live-thread cap. Raise \
+             ENCLAVE_MAX_SET_SPAWN_RATE, or 0 to disable (0 is the default)",
+            max_spawn_rate()
+        );
+    }
+
+    // ---- reserve a slot under the live-thread cap ----
+    //
+    // A compare-exchange loop rather than a blind increment, so a refusal
+    // never leaves the counter above the cap (which would wedge the store
+    // into refusing forever).
+    let cap = max_live_threads();
+    loop {
+        let cur = LIVE_SET_THREADS.load(Ordering::Acquire);
+        if cur >= cap {
+            refund_spawn_token();
+            refuse!(
+                "live SET thread cap reached ({cap}); raise ENCLAVE_MAX_SET_THREADS \
+                 or lower the guest's pool size"
+            );
+        }
+        if LIVE_SET_THREADS
+            .compare_exchange_weak(cur, cur + 1, Ordering::AcqRel, Ordering::Acquire)
+            .is_ok()
+        {
+            break;
+        }
+    }
+    // From here on every early return MUST release the slot.
+    let slot = SlotGuard(true);
+
+    // ---- capture ----
+    // WRAPS rather than latching. The ABI wants a non-negative i32; it does not
+    // want uniqueness for the life of the process. An earlier revision let the
+    // counter run past `i32::MAX` and then refused EVERY spawn forever — a
+    // permanent, process-wide latch reachable by a long-lived `wasmtime serve`,
+    // and one no tenant could recover from.
+    let thread_id = i64::from(
+        (NEXT_SET_THREAD_ID.fetch_add(1, Ordering::Relaxed) % (i32::MAX as u64)) as i32 + 1,
+    );
+    // This store's thread group: the stop flag every stop path drives, the
+    // live count teardown waits on, and where a worker's `proc_exit` lands.
+    // Created on the first spawn and shared by every worker of this store.
+    let group = store.set_thread_group();
+    for (_, memory) in &shared_memories {
+        group.watch_memory(memory);
+    }
+    group.live.fetch_add(1, Ordering::AcqRel);
+    let live = LiveGuard(Some(group.clone()));
+    let payload = SetWorkerRequest {
+        component,
+        plan: SetViewPlan {
+            instance_index: start_instance,
+            shared_memories,
+        },
+        start_instance,
+        start_component_instance,
+        func_index,
+        start_arg: arg as i32,
+        thread_id,
+        group: group.clone(),
+        host,
+    };
+
+    // Size the worker stack from the engine's wasm-stack limit rather than
+    // taking Rust's 2 MiB default. The limit is computed as
+    // `stack_pointer - max_wasm_stack` at entry, so if an embedder raises
+    // `max_wasm_stack` above the thread's real stack, the guard-page check
+    // never fires and deep guest recursion runs off the end of the stack
+    // instead of trapping cleanly.
+    let stack_size = store
+        .engine()
+        .config()
+        .max_wasm_stack
+        .saturating_add(512 * 1024)
+        .max(2 * 1024 * 1024);
+    let handle = std::thread::Builder::new()
+        .name(format!("set-thread-{thread_id}"))
+        .stack_size(stack_size)
+        .spawn(move || worker_main(payload));
+    match handle {
+        Ok(handle) => {
+            // The worker owns both counters now and releases them when it exits.
+            slot.into_worker();
+            live.into_worker();
+            store.push_set_thread_join(handle);
+            Ok(ThreadSpawnResult(thread_id as i32))
+        }
+        Err(e) => {
+            // `slot` and `live` release on drop, so a failed spawn leaks
+            // neither a cap slot nor a live-worker count teardown would wait on.
+            // The rate token goes back too: the thread was never created, so it
+            // cost the node nothing.
+            refund_spawn_token();
+            log::warn!("thread.spawn: OS thread creation failed: {e}");
+            Ok(ThreadSpawnResult::FAILED)
+        }
+    }
+}
+
+/// This store's thread group, WITHOUT creating one. Used by the spawn path to
+/// ask "is this group stopping?" without manufacturing a group for a store that
+/// has never spawned.
+fn group_if_any(store: &StoreOpaque) -> Option<Arc<SetThreadGroup>> {
+    store.set_thread_group_if_any()
+}
+
+/// Clears the parking-spot cancellation thread-local when the worker exits, so
+/// a recycled OS thread (there are none today, but be defensive) never inherits
+/// a stale flag.
+struct ClearWorkerCancelOnDrop;
+impl Drop for ClearWorkerCancelOnDrop {
+    fn drop(&mut self) {
+        crate::runtime::vm::parking_spot::set_worker_cancel(None);
+    }
+}
+
+/// Releases a reserved slot unless ownership was handed to a worker. Exists so
+/// that every early return between reservation and a successful
+/// `thread::spawn` — including a `?` or a panic — cannot leak a slot and
+/// permanently shrink the cap.
+struct SlotGuard(bool);
+
+impl SlotGuard {
+    /// The worker thread now owns this slot and will release it on exit.
+    fn into_worker(mut self) {
+        self.0 = false;
+    }
+}
+
+impl Drop for SlotGuard {
+    fn drop(&mut self) {
+        if self.0 {
+            LIVE_SET_THREADS.fetch_sub(1, Ordering::AcqRel);
+        }
+    }
+}
+
+/// The same idea for the group's live-worker count, which teardown waits on:
+/// a spawn that fails after incrementing it must not leave teardown waiting
+/// for a thread that was never created.
+struct LiveGuard(Option<Arc<SetThreadGroup>>);
+
+impl LiveGuard {
+    fn into_worker(mut self) {
+        self.0 = None;
+    }
+}
+
+impl Drop for LiveGuard {
+    fn drop(&mut self) {
+        if let Some(group) = self.0.take() {
+            group.live.fetch_sub(1, Ordering::AcqRel);
+        }
+    }
+}
+
+/// Body of a spawned SET thread: hand the request to the embedder's host,
+/// which builds a store and runs the worker's component instance in it.
+fn worker_main(payload: SetWorkerRequest) {
+    let thread_id = payload.thread_id;
+    let group = payload.group.clone();
+    // Release this worker's cap slot and its entry in the group's live count
+    // however it exits — normal return, guest trap, or panic. Declared before
+    // the work so they drop last.
+    let _slot = SlotGuard(true);
+    let _live = LiveGuard(Some(group.clone()));
+
+    // Install this worker's stop flag in the parking-spot thread-local, so a
+    // futex parked forever wakes and unwinds when teardown (or a sibling's
+    // `proc_exit`) sets it. Cleared on the way out (thread-local, so it never
+    // outlives this thread, but be explicit).
+    crate::runtime::vm::parking_spot::set_worker_cancel(Some(group.stop.clone()));
+    let _clear_cancel = ClearWorkerCancelOnDrop;
+
+    // A guest TRAP is normal operation: it unwinds out of the worker's own
+    // store and arrives here as `Err`.
+    //
+    // A Rust PANIC is an engine or embedder bug. It used to `process::abort()`
+    // here, on the reasoning that the shared linear memory's invariants were
+    // then unknown. That reasoning does not survive contact with where panics
+    // actually come from: the embedder's own store-building code runs on this
+    // thread, and a CLI accessor that `unwrap()`s an unconfigured WASI context
+    // turned three guest instructions into a whole-process kill. A panic is
+    // also not a memory-state event — it unwinds through wasmtime's own
+    // machinery, which restores the store, and the shared memory is left
+    // exactly as a trap would leave it: consistent as far as the HOST is
+    // concerned, and the guest's own problem beyond that.
+    //
+    // So a panicking worker now dies exactly like a trapping one: alone, with
+    // a loud diagnostic. The residual is the guest's, and it is the same
+    // residual a trap has when the guest ships no death hook — a joining
+    // sibling may block.
+    let host = payload.host.clone();
+    let result =
+        std::panic::catch_unwind(std::panic::AssertUnwindSafe(|| host.run_worker(payload)));
+    match result {
+        Ok(Ok(())) => {}
+        Ok(Err(e)) => {
+            // A worker that called `proc_exit` is not a trap and must not be
+            // reported as one: `exit()` on any thread ends the process under
+            // POSIX, and a component instance is the process. The EMBEDDER
+            // classifies it (only it knows the WASI error type) and calls
+            // `SetThreadGroup::record_worker_exit`, which stops the rest of the
+            // group; here we only stay quiet about it.
+            // A stop request is ordinary shutdown, not a fault: at every clean
+            // store teardown every live worker ends this way, and on this
+            // platform stderr IS the tenant's log — a 32-thread program was
+            // printing 32 spurious "trapped" lines per run.
+            if group.stop_requested() {
+                log::debug!("set-thread-{thread_id} ended because the group is stopping: {e:?}");
+                return;
+            }
+            // A guest TRAP kills only this worker. Earlier this called
+            // `process::exit(1)` on the wasi-threads precedent that a trapping
+            // thread ends the program — but that made a single `unreachable`,
+            // an out-of-bounds load, or a nested `thread.spawn` into a
+            // whole-process kill, and `exit` runs atexit handlers while sibling
+            // threads still hold the shared-memory lock and malloc arenas,
+            // which can hang instead of dying.
+            //
+            // Dying alone would strand any sibling parked on this thread's
+            // futex, so the worker is given a chance to run the guest's own
+            // thread-death hook before its store goes away — see
+            // `SetWorkerRequest::run_async`. If the guest has no such hook, the
+            // residual stands and is the guest's own bug to handle.
+            // Rate-limited for the same reason spawn refusals are: 20,000
+            // immediately-trapping workers produced 3.8 MB of stderr, and on
+            // this platform stderr is the tenant's log. The FIRST trap in each
+            // window carries the backtrace, which is what a developer needs.
+            static LAST_TRAP: AtomicU64 = AtomicU64::new(0);
+            if refusal_diagnostic_due(&LAST_TRAP) {
+                eprintln!(
+                    "set-thread-{thread_id} trapped (thread ends; siblings continue; \
+                     further traps are rate-limited to one per \
+                     {REFUSAL_DIAGNOSTIC_PERIOD_SECS}s): {e:?}"
+                );
+            } else {
+                log::debug!("set-thread-{thread_id} trapped: {e:?}");
+            }
+        }
+        Err(_) => {
+            // The default panic hook has already printed the payload and
+            // location by this point.
+            eprintln!(
+                "wasmtime: error: panic on shared-everything-threads worker \
+                 set-thread-{thread_id}; that thread is dead, the process continues. \
+                 A sibling joining it may block."
+            );
+        }
+    }
+}
+
+impl SetWorkerRequest {
+    /// The component this worker is a view of. An embedder MUST instantiate
+    /// exactly this component (see `run_async`, which enforces it).
+    pub fn component(&self) -> &crate::component::Component {
+        &self.component
+    }
+
+    /// Guest-visible id of this thread, for diagnostics.
+    pub fn thread_id(&self) -> i64 {
+        self.thread_id
+    }
+
+    /// The group this worker shares with the store that spawned it and with
+    /// every sibling.
+    ///
+    /// Recording a `proc_exit` is NOT one of them: [`run_async`](Self::run_async)
+    /// already does that, through [`SetWorkerHost::exit_status`]. Calling
+    /// [`SetThreadGroup::record_worker_exit`] as well is harmless (first writer
+    /// wins) but redundant. What an embedder legitimately wants this for is
+    /// [`SetThreadGroup::stop_requested`], to cancel a worker that is blocked in
+    /// a host call and so reaches no other stop checkpoint.
+    pub fn thread_group(&self) -> &Arc<SetThreadGroup> {
+        &self.group
+    }
+
+    /// Build this worker's execution view in `store` and run its start
+    /// function to completion.
+    ///
+    /// The embedder supplies a fresh `Store<T>` and an `InstancePre<T>` for the
+    /// SAME component (a fresh embedder context per worker: its own WASI ctx,
+    /// its own resource tables). Everything else — the shared-memory swap, the
+    /// epoch policy, the nested-spawn registration, entering and leaving the
+    /// guest correctly, and the guest's thread-death hook on a trap — is done
+    /// here so no embedder has to get it right.
+    ///
+    /// Threads share LINEAR MEMORY, which is what pthreads needs. They do NOT
+    /// share a WASI context or a component resource table: those are per-store
+    /// by construction, and the guest libc is responsible for keeping its
+    /// descriptor state per-thread to match. An fd opened on one thread is not
+    /// usable from another — the same honest limitation the wasi-threads (p1)
+    /// path documents.
+    #[cfg(feature = "async")]
+    pub async fn run_async<T: Send + 'static>(
+        &self,
+        store: &mut Store<T>,
+        pre: &crate::component::InstancePre<T>,
+    ) -> Result<()> {
+        // Every error out of this worker is classified, not just the one from
+        // the start function's own call. A guest `start` section runs during
+        // `instantiate_set_worker_async` below and can call `proc_exit`; so can
+        // anything the sync-call bookkeeping touches. Those used to propagate
+        // with `?` before any classification, so the exit was lost, the group
+        // never stopped, and the primary hung exactly as if the fix were absent.
+        let result = self.run_inner(store, pre).await;
+        if let Err(e) = &result {
+            if let Some(code) = self.host.exit_status(e) {
+                self.group.record_worker_exit(code);
+            }
+        }
+        result
+    }
+
+    #[cfg(feature = "async")]
+    async fn run_inner<T: Send + 'static>(
+        &self,
+        store: &mut Store<T>,
+        pre: &crate::component::InstancePre<T>,
+    ) -> Result<()> {
+        // The start function is named by `(RuntimeInstanceIndex, FuncIndex)`,
+        // which only resolves against the component it was captured from.
+        // Instantiating a DIFFERENT component here would silently run whatever
+        // function happened to sit at those indices, so this is a hard check,
+        // not a debug assertion.
+        if !crate::component::Component::ptr_eq(pre.component(), &self.component) {
+            bail!(
+                "SET worker host instantiated a different component than the one \
+                 that spawned this thread"
+            );
+        }
+
+        // The epoch is how a RUNNING worker is stopped, and the policy is
+        // "check the group's stop flag, do not impose a budget".
+        //
+        // An earlier revision gave a worker a finite deadline
+        // (`ENCLAVE_SET_EPOCH_TICKS`, then 600) and trapped on it. That was
+        // wrong twice over. It killed healthy long-running workers for no
+        // reason; and it never fired for the runaway worker it existed to
+        // stop, because `wasmtime --wasm timeout` bumps the engine epoch
+        // exactly ONCE — enough for a deadline of 1 (the main thread's), never
+        // for 600. Measured: `-W timeout=2s` hung at exit 124 with the default
+        // and exited at 2.0s with `ENCLAVE_SET_EPOCH_TICKS=1`.
+        //
+        // Now the deadline is a POLLING INTERVAL. Every `set_worker_epoch_ticks`
+        // epochs the callback runs, reads one atomic, and either trap-stops the
+        // worker (the group was asked to stop: teardown, or a sibling's
+        // `proc_exit`) or extends the deadline again. A worker is never killed
+        // for running long, and a worker that must stop does so at its next
+        // epoch check.
+        //
+        // This bounds only workers spinning in compiled code. A worker parked
+        // in `memory.atomic.wait` is stopped by the parking spot polling the
+        // same flag, and a worker blocked in a HOST call is stopped by the
+        // embedder dropping this future. All three are needed; none subsumes
+        // the others.
+        let group = self.group.clone();
+        let ticks = set_worker_epoch_ticks();
+        store.set_epoch_deadline(ticks);
+        store.epoch_deadline_callback(move |_| {
+            if group.stop_requested() {
+                Err(crate::format_err!(
+                    "shared-everything-threads worker stopped: its store is being \
+                     torn down, or another thread called `proc_exit`"
+                ))
+            } else {
+                Ok(crate::UpdateDeadline::Continue(ticks))
+            }
+        });
+
+        // Nested spawn: a worker that calls `pthread_create` needs the same host
+        // AND the same group on its own store. Without the group the nested
+        // worker would land in a fresh one, invisible to the primary's stop
+        // request and to its teardown wait.
+        store.set_set_worker_host(self.host.clone());
+        store.adopt_set_thread_group(self.group.clone());
+
+        let instance = pre.instantiate_set_worker_async(&mut *store, &self.plan).await?;
+
+        // Resolve the start function through the WORKER's own instance, so every
+        // frame the worker runs — including the direct calls Cranelift baked in
+        // for statically-known imports — carries the worker's vmctx.
+        let (func, runtime_instance, core_id) = {
+            let opaque = store.as_context_mut().0.store_opaque_mut();
+            let component_instance = instance.id().get(opaque);
+            let core_id = component_instance.instance(self.start_instance);
+            let runtime_instance = self.start_component_instance.map(|index| RuntimeInstance {
+                instance: instance.id().instance(),
+                index,
+            });
+            let store_id = opaque.id();
+            let (vminstance, registry) = opaque.instance_and_module_registry_mut(core_id);
+            let funcref = vminstance
+                .get_func_ref(registry, self.func_index)
+                .ok_or_else(|| {
+                    crate::format_err!("SET worker: start function is not an escaped funcref")
+                })?;
+            // SAFETY: the funcref lives in an instance owned by this store.
+            (
+                unsafe { crate::Func::from_vm_func_ref(store_id, funcref) },
+                runtime_instance,
+                core_id,
+            )
+        };
+
+        // Enter the guest the way the primary does when it runs a core
+        // instance's `start`: the canonical-ABI machinery a lowered import
+        // touches (resource tables, scope ids, the current task) expects a
+        // guest call to be in progress.
+        let entered = match runtime_instance {
+            Some(rt) => {
+                store.as_context_mut().0.enter_guest_sync_call(None, false, rt)?;
+                true
+            }
+            None => false,
+        };
+        let args = [Val::I32(self.start_arg)];
+        let result = func.call_async(&mut *store, &args, &mut []).await;
+        // Leave the sync call on EVERY path that entered it, not only the
+        // successful one: the error path below runs the guest's death hook,
+        // which is another guest entry and expects the bookkeeping to be
+        // balanced. (A failure to leave is reported but never displaces the
+        // guest's original trap, which is the more informative error.)
+        if entered {
+            if let Err(e) = store.as_context_mut().0.exit_guest_sync_call() {
+                if result.is_ok() {
+                    return Err(e);
+                }
+                log::warn!("set-thread-{}: exit_guest_sync_call failed: {e:?}", self.thread_id);
+            }
+        }
+
+        if let Err(e) = result {
+            // `exit()` on any thread ends the process under POSIX, and the
+            // component instance is the process. `run_async` records the status;
+            // here we only decline to run the death hook, deliberately: it would
+            // release a joiner, and the main thread would then sail past an
+            // `exit()` that was supposed to end it. The main thread is instead
+            // stopped where it actually is, by the group's stop flag (parked in
+            // `pthread_join`) or by its epoch callback (running).
+            if self.host.exit_status(&e).is_some() {
+                return Err(e);
+            }
+
+            // The guest's thread epilogue (release `__thread_list_lock`, set
+            // `detach_state`, wake joiners) runs only on the NORMAL return
+            // path, so a trapped worker would otherwise strand every sibling
+            // parked on its futex — including the main thread inside
+            // `pthread_join`, which hangs the whole process. Give the guest a
+            // chance to declare this thread dead. Best-effort by design: the
+            // export is optional, it runs on the worker's own (unwound but
+            // otherwise healthy) store, and any failure is reported without
+            // displacing the original trap.
+            //
+            // The hook gets a FRESH, SMALL epoch budget that a stop request
+            // cannot immediately revoke. On the path that matters most — a
+            // runaway worker being stopped at teardown — the store arrives here
+            // with its deadline already expired and its callback armed to stop
+            // again, so the hook would trap at its own function entry and do
+            // nothing at all.
+            //
+            // The budget is deliberately tiny. This window is the one place
+            // where guest code runs with the stop-flag callback replaced by a
+            // plain trap deadline, so its size bounds how long a trapping
+            // worker running COMPILED CODE can ignore teardown. The epilogue it
+            // exists for — release the thread-list lock, wake joiners — is a
+            // few hundred instructions; anything beyond that is a guest abusing
+            // it. Spawning from the hook is separately refused (see
+            // `spawn_funcref`), which is what stops the window from being
+            // renewable.
+            //
+            // What the budget does NOT bound: a hook that BLOCKS in a host call
+            // or parks in `memory.atomic.wait`. Epoch deadlines fire at checks
+            // in compiled code, and a parked thread reaches none. Such a hook
+            // holds its thread and its process-wide cap slot until the store is
+            // torn down. That is a documented residual, not a bound.
+            store.set_epoch_deadline(GUEST_THREAD_DIED_EPOCH_BUDGET);
+            store.epoch_deadline_trap();
+            // Fuel needs the same treatment for the same reason, and missing it
+            // put the hang straight back: a worker that traps by EXHAUSTING its
+            // fuel arrives here with zero, so the hook traps out of fuel at its
+            // own entry, no joiner is released, and the main thread parks in
+            // `pthread_join` forever. `set_fuel` errors when the engine is not
+            // metering fuel at all, which is the common case and not a problem.
+            if store.get_fuel().is_ok() {
+                let _ = store.set_fuel(GUEST_THREAD_DIED_FUEL_BUDGET);
+            }
+            notify_guest_thread_died(store, core_id, self.start_arg, self.thread_id).await;
+            return Err(e);
+        }
+        Ok(())
+    }
+}
+
+/// Call the guest's optional `__enclave_set_thread_died` export so that joiners
+/// of a TRAPPED worker are released instead of parking forever.
+///
+/// This is a plain CORE export of the module that defines the thread entry
+/// point, reached through the worker's own core instance — deliberately not a
+/// component export, so the componentizer needs no extra canon and a guest
+/// without the hook simply does not have it.
+#[cfg(feature = "async")]
+async fn notify_guest_thread_died<T: Send + 'static>(
+    store: &mut Store<T>,
+    core_id: crate::store::InstanceId,
+    start_arg: i32,
+    thread_id: i64,
+) {
+    let instance = {
+        let opaque = store.as_context_mut().0.store_opaque_mut();
+        crate::Instance::from_wasmtime(core_id, opaque)
+    };
+    let Some(func) = instance.get_func(&mut *store, GUEST_THREAD_DIED_EXPORT) else {
+        return;
+    };
+    let _in_hook = InThreadDiedHook::enter();
+    let args = [Val::I32(start_arg)];
+    if let Err(e) = func.call_async(&mut *store, &args, &mut []).await {
+        eprintln!(
+            "set-thread-{thread_id}: guest `{GUEST_THREAD_DIED_EXPORT}` hook failed \
+             (siblings joining this thread may block): {e:?}"
+        );
+    }
+}
+
+/// Epoch ticks the guest's death hook is allowed, independent of any stop
+/// request.
+///
+/// This is the only window in which guest code runs with every stop path
+/// disarmed, so it is a hard bound on how long a trapping worker can ignore
+/// teardown: `GUEST_THREAD_DIED_EPOCH_BUDGET x <the embedder's ticker period>`
+/// (0.2s with the wasmtime CLI's 10ms ticker). The epilogue it exists for is a
+/// few hundred instructions.
+#[cfg(feature = "async")]
+const GUEST_THREAD_DIED_EPOCH_BUDGET: u64 = 20;
+
+/// Fuel the guest's death hook is allowed when the embedder meters fuel. Sized
+/// for a fixed epilogue, not for guest logic.
+#[cfg(feature = "async")]
+const GUEST_THREAD_DIED_FUEL_BUDGET: u64 = 10_000_000;
+
+thread_local! {
+    /// Whether this thread is currently inside the guest's death hook. See the
+    /// refusal in `spawn_funcref`.
+    static IN_THREAD_DIED_HOOK: core::cell::Cell<bool> = const { core::cell::Cell::new(false) };
+}
+
+fn in_guest_thread_died_hook() -> bool {
+    IN_THREAD_DIED_HOOK.with(|c| c.get())
+}
+
+/// Sets the flag for the duration of the hook, and clears it however the hook
+/// ends (return, trap, or panic).
+struct InThreadDiedHook;
+
+impl InThreadDiedHook {
+    fn enter() -> InThreadDiedHook {
+        IN_THREAD_DIED_HOOK.with(|c| c.set(true));
+        InThreadDiedHook
+    }
+}
+
+impl Drop for InThreadDiedHook {
+    fn drop(&mut self) {
+        IN_THREAD_DIED_HOOK.with(|c| c.set(false));
+    }
+}
+
+/// Optional guest export called when a worker dies by TRAP rather than by
+/// returning. Takes the same `i32` the start function was given (the libc's
+/// `start_args` pointer), from which the guest can find the dying thread's
+/// `pthread_t` and release whatever a normal exit would have released.
+const GUEST_THREAD_DIED_EXPORT: &str = "__enclave_set_thread_died";
diff --git a/crates/wasmtime/src/runtime/vm/instance.rs b/crates/wasmtime/src/runtime/vm/instance.rs
index 06ba7e4..51d06e5 100644
--- a/crates/wasmtime/src/runtime/vm/instance.rs
+++ b/crates/wasmtime/src/runtime/vm/instance.rs
@@ -324,6 +324,60 @@ impl Instance {
     where
         R: HostResult,
     {
+        // enclave/SET: the cross-thread guard, mirroring the one in
+        // `ComponentInstance::enter_host_from_wasm`. It has to be HERE too,
+        // not only there: Cranelift lowers `memory.grow` and
+        // `memory.atomic.wait*`/`notify` on an IMPORTED memory by calling the
+        // builtin with the *defining* instance's vmctx (see
+        // `func_environ::memory_vmctx_and_defined_index`), and tag imports do
+        // the same. A shared-everything-threads worker executing a futex wait
+        // on an imported shared memory would therefore land here holding the
+        // PRIMARY store's vmctx and materialize `&mut dyn VMStore` on it from
+        // the wrong thread — the exact race the per-thread-Store design
+        // exists to prevent, on the single most common SET code path.
+        //
+        // Spawn also refuses modules with imported memories/tags, but that is
+        // a deny-list and deny-lists are how this class of bug returns. This
+        // check makes the invariant hold regardless of which module shapes
+        // the spawn guards happen to enumerate.
+        //
+        // Read with pure pointer arithmetic: forming `&Instance` before the
+        // check would itself alias the owning thread's `&mut`.
+        #[cfg(all(feature = "std", feature = "threads"))]
+        {
+            // SAFETY: `vmctx` is valid per this function's contract, and the
+            // store-context slot is written once at instantiation.
+            let own = unsafe {
+                vmctx
+                    .byte_add(usize::from(HostPtr.vmctx_store_context()))
+                    .cast::<VmPtr<VMStoreContext>>()
