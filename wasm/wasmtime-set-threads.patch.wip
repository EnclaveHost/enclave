+
+    /// enclave/SET: stop and join every worker spawned from this store.
+    ///
+    /// Called from `Drop for Store<T>` BEFORE the embedder's `T` is destroyed,
+    /// and again from `StoreOpaque::drop` for stores torn down by other paths.
+    /// Draining makes the second call a no-op.
+    ///
+    /// **The join is bounded, and that is sound**, because a worker holds NO
+    /// pointers into this store: its component is a refcounted handle, its
+    /// shared memories are `Arc`s, and its own store owns everything else. An
+    /// unbounded join was the old design's rule, inherited from the revision
+    /// where workers really did borrow the primary's import records; keeping it
+    /// after that stopped being true turned any non-returning worker into a
+    /// permanent wedge — and an ORDINARY program reaches that state, by
+    /// detaching a compute thread and returning from `main`.
+    ///
+    /// Stopping is driven three ways, because each alone has a hole:
+    ///
+    /// * the group's stop flag, which the parking spot polls, wakes a worker
+    ///   parked in `memory.atomic.wait` (every SET mutex);
+    /// * repeated engine epoch bumps make a worker spinning in compiled code
+    ///   reach its epoch callback, which reads the same flag and traps. This
+    ///   only works if the embedder enabled `Config::epoch_interruption` —
+    ///   spawn warns loudly when it did not;
+    /// * `unpark` for immediacy, so a worker in a bounded park does not have to
+    ///   wait out its polling quantum.
+    ///
+    /// The wait is on the group's LIVE COUNT, not on these handles, because a
+    /// worker's own nested spawns are registered with the worker's store rather
+    /// than this one. Once the count reaches zero (or the timeout expires) the
+    /// handles are joined, which no longer blocks.
+    ///
+    /// A worker still running after `ENCLAVE_SET_JOIN_TIMEOUT_MS` (default 2s;
+    /// `0` restores the unbounded join) is DETACHED with a diagnostic. It keeps
+    /// its process-wide cap slot until it really exits, so a process leaking
+    /// workers this way stops being able to spawn new ones rather than silently
+    /// accumulating them.
+    ///
+    /// **This function does not block.** It is reached from `Drop for Store`,
+    /// which under `wasmtime serve` runs INLINE ON A TOKIO WORKER for every
+    /// request whose guest spawned. The wait used to be a
+    /// `std::thread::sleep(1ms)` loop right here, bounded only by the join
+    /// timeout — the same shape round 8 called CRITICAL and removed from
+    /// `take_spawn_token`, where a `sleep` on a fiber parked the executor
+    /// thread running it. `Drop` cannot `await`, so the wait cannot be made
+    /// cooperative; it has to move off this thread instead. It does, to a
+    /// reaper (see `spawn_set_reaper`), and only in the case that would
+    /// actually have waited.
+    ///
+    /// Honest scope: I could not measure a stall from the old shape. With the
+    /// stop flag and the epoch bumps both landing, workers stop in
+    /// microseconds, and 400 requests at 128-way concurrency against a guest
+    /// that detaches a spinning worker per request ran in 0.508 s with zero
+    /// detach diagnostics. What is fixed here is the shape — an unbounded-ish
+    /// blocking wait on an executor thread — not a demonstrated outage.
+    #[cfg(all(feature = "std", feature = "threads"))]
+    pub(crate) fn join_set_threads(&mut self) {
+        let joins = mem::take(&mut self.set_thread_joins);
+        if joins.is_empty() {
+            return;
+        }
+
+        // A worker's store detaches its nested children instead of waiting: a
+        // thread finishing does not end the threads it created, and they hold
+        // nothing of this store. The group's owner stops and waits for all of
+        // them, this one included.
+        #[cfg(feature = "component-model")]
+        if !self.owns_set_thread_group {
+            drop(joins);
+            return;
+        }
+
+        // Whatever the reaper has to hold to answer "is anything still live?".
+        // With the component model that is the group; without it there is no
+        // group at all and `live_is_zero` is always false, so the reaper simply
+        // runs out its timeout.
+        #[cfg(feature = "component-model")]
+        type SetReaperGroup = Option<std::sync::Arc<crate::runtime::vm::component::SetThreadGroup>>;
+        #[cfg(not(feature = "component-model"))]
+        type SetReaperGroup = Option<core::convert::Infallible>;
+
+        #[cfg(feature = "component-model")]
+        let group = self.set_thread_group.clone();
+        #[cfg(not(feature = "component-model"))]
+        let group: SetReaperGroup = None;
+
+        #[cfg(feature = "component-model")]
+        if let Some(group) = &group {
+            group.request_stop();
+        }
+        for handle in &joins {
+            handle.thread().unpark();
+        }
+
+        #[cfg(feature = "component-model")]
+        fn live_is_zero(
+            group: &Option<std::sync::Arc<crate::runtime::vm::component::SetThreadGroup>>,
+        ) -> bool {
+            // `is_some_and`, NOT `map(..).unwrap_or(0) == 0`: with no group
+            // there is nothing that can report progress, and answering "zero
+            // live" would send a store with live handles down the fast path to
+            // an unbounded, unbumped, undetachable inline `join()` -- the exact
+            // wedge this mechanism exists to remove. Unreachable today (every
+            // caller of `push_set_thread_join` sets the group first), which is
+            // precisely why it must not fail OPEN if that ever changes.
+            group.as_ref().is_some_and(|g| g.live_workers() == 0)
+        }
+        #[cfg(not(feature = "component-model"))]
+        fn live_is_zero<T>(_: &T) -> bool {
+            false
+        }
+
+        /// Join a worker the live count says has already dropped its
+        /// `LiveGuard`.
+        ///
+        /// The count reaching zero happens inside `worker_main` a few
+        /// instructions before the thread really ends, so `is_finished()` can
+        /// still be false here. Racing the two used to report a cleanly exited
+        /// worker as a leaked one and drop its handle unjoined; once the count
