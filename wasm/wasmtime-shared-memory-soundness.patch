+/// A drop-in for `AtomicUN::from_ptr` over guest memory, with the same method names and the same
+/// `Ordering` arguments, so the instruction bodies below keep saying what they mean. The orderings
+/// are accepted and ignored: the guard already provides SeqCst, and no wasm atomic asks for less.
+struct Shared<T> {
+    ptr: *mut T,
+}
+
+macro_rules! shared_int {
+    ($($t:ty),*) => {$(
+        impl Shared<$t> {
+            /// # Safety
+            ///
+            /// `ptr` must be a valid, aligned pointer into guest memory that stays valid for as
+            /// long as this value is used - the same contract `AtomicUN::from_ptr` has, and the
+            /// reason the instruction bodies keep their `unsafe` block.
+            #[inline]
+            unsafe fn from_ptr(ptr: *mut $t) -> Self { Self { ptr } }
+
+            #[inline]
+            fn load(&self, _: Ordering) -> $t {
+                let _g = shared_lock(self.ptr as usize);
+                unsafe { race_read(self.ptr) }
+            }
+
+            #[inline]
+            fn store(&self, val: $t, _: Ordering) {
+                let _g = shared_lock(self.ptr as usize);
+                unsafe { race_write(self.ptr, val) }
+            }
+
+            /// Read-modify-write under one guard. Every operation below is this with a different
+            /// `f`, which is the whole reason a lock can stand in for the hardware primitive.
+            #[inline]
+            fn rmw(&self, f: impl FnOnce($t) -> $t) -> $t {
+                let _g = shared_lock(self.ptr as usize);
+                let old = unsafe { race_read(self.ptr) };
+                unsafe { race_write(self.ptr, f(old)) };
+                old
+            }
+
+            #[inline] fn swap(&self, val: $t, _: Ordering) -> $t { self.rmw(|_| val) }
+            #[inline] fn fetch_add(&self, val: $t, _: Ordering) -> $t { self.rmw(|x| x.wrapping_add(val)) }
+            #[inline] fn fetch_sub(&self, val: $t, _: Ordering) -> $t { self.rmw(|x| x.wrapping_sub(val)) }
