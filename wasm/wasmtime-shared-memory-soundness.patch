+// Implementation of `memory.copy` where either side may be a SHARED memory.
+//
+// Byte-wise RELAXED atomic accesses, for the reason `race_read` in the Pulley interpreter spells
+// out at length: a guest may legally race an ordinary access against another thread's atomic one,
+// the wasm memory model says the result is some value, and Rust's model says a non-atomic race is
+// UNDEFINED. One byte is also the only width at which two accesses to the same address can never
+// disagree about their size, which is why this cannot be "wider chunks when aligned".
+//
+// It is NOT atomic as a whole, and must not be: `memory.copy` on a shared memory is a sequence of
+// ordinary byte accesses in the spec too, and a guest that needs more uses the atomic
+// instructions. All this removes is the undefined behaviour.
+unsafe fn shared_memory_copy(
+    _store: &mut dyn VMStore,
+    _instance: InstanceId,
+    dst: *mut u8,
+    src: *mut u8,
+    len: usize,
+) {
+    use core::sync::atomic::{AtomicU8, Ordering::Relaxed};
+    unsafe {
+        let get = |k: usize| (*src.add(k).cast::<AtomicU8>()).load(Relaxed);
+        let put = |k: usize, v: u8| (*dst.add(k).cast::<AtomicU8>()).store(v, Relaxed);
+        // memmove, not memcpy: the ranges may overlap, and the direction is what preserves the
+        // "as if the source were read first" result for a single thread.
+        if (dst as usize) <= (src as usize) {
+            let mut k = 0;
+            while k < len { put(k, get(k)); k += 1; }
+        } else {
+            let mut k = len;
+            while k > 0 { k -= 1; put(k, get(k)); }
+        }
+    }
+}
+
+// Implementation of `memory.fill` on a SHARED memory; see `shared_memory_copy`.
+unsafe fn shared_memory_fill(
+    _store: &mut dyn VMStore,
+    _instance: InstanceId,
+    dst: *mut u8,
+    val: u32,
+    len: usize,
+) {
+    use core::sync::atomic::{AtomicU8, Ordering::Relaxed};
+    #[expect(
+        clippy::cast_possible_truncation,
+        reason = "the libcall intentionally takes the raw 32-bit value, \
+                  and semantically that's intentionally truncated"
+    )]
+    let byte = val as u8;
+    unsafe {
+        let mut k = 0;
+        while k < len {
+            (*dst.add(k).cast::<AtomicU8>()).store(byte, Relaxed);
+            k += 1;
+        }
+    }
+}
