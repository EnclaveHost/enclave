+/// Read a guest word the way the wasm ATOMIC instructions do: under the stripe lock that covers
+/// its address, through the same byte-wise accesses everything else uses.
+///
+/// Exported because `memory.atomic.wait32/64` lives in wasmtime, not here, and its value check has
+/// to be atomic with respect to the guest's own atomics. Reading it with `AtomicU32::load` instead
+/// - which is what upstream does, correctly, for a native backend - would be a wide atomic over
+/// bytes this interpreter writes one at a time: the very mixed-size overlap the byte-wise rule
+/// exists to remove, reintroduced on the one path that is hardest to test.
+///
+/// # Safety
+///
+/// `ptr` must be a valid, aligned pointer into guest memory.
+#[doc(hidden)]
+#[inline]
+pub unsafe fn shared_load_u32(ptr: *mut u32) -> u32 {
+    unsafe { Shared::<u32>::from_ptr(ptr) }.load(Ordering::SeqCst)
+}
+
+/// Write a guest word under the same stripe lock and byte-wise discipline as [`shared_load_u32`].
+///
+/// Exported for the same reason: a caller outside this crate that touches guest memory a Pulley
+/// guest also touches must do it the same way, or it is the wide half of a mixed-size overlap.
+///
+/// # Safety
+///
+/// `ptr` must be a valid, aligned pointer into guest memory.
+#[doc(hidden)]
