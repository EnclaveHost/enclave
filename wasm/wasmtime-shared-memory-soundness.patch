+    fn overlapping_mixed_width_accesses_are_defined() {
+        with_mem(|m| {
+            unsafe { race_write(m.at::<u32>(32), 0u32) };
+            std::thread::scope(|s| {
+                s.spawn(move || {
+                    for _ in 0..SCALE / 4 {
