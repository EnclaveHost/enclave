+/// A spin lock, for the short critical sections inside this crate.
+///
+/// Spinning is right HERE and wrong for a guest's wait: these sections are a linked-list splice or
+/// a map lookup, tens of instructions, never a guest's arbitrary wait. A blocking lock would need
+/// the park hook and would then be re-entrant with the thing it protects.
+pub struct Mutex<T> {
+    locked: AtomicBool,
+    data: UnsafeCell<T>,
+}
+
+unsafe impl<T: Send> Send for Mutex<T> {}
+unsafe impl<T: Send> Sync for Mutex<T> {}
+
+pub struct MutexGuard<'a, T> {
+    lock: &'a Mutex<T>,
+}
+
+impl<T> Mutex<T> {
+    pub const fn new(data: T) -> Mutex<T> {
+        Mutex {
+            locked: AtomicBool::new(false),
+            data: UnsafeCell::new(data),
+        }
+    }
+
+    pub fn lock(&self) -> MutexGuard<'_, T> {
+        while self
+            .locked
+            .compare_exchange_weak(false, true, Ordering::Acquire, Ordering::Relaxed)
+            .is_err()
+        {
+            core::hint::spin_loop();
+        }
+        MutexGuard { lock: self }
+    }
+}
+
+impl<T> Deref for MutexGuard<'_, T> {
+    type Target = T;
+    fn deref(&self) -> &T {
+        unsafe { &*self.lock.data.get() }
+    }
+}
+
+impl<T> DerefMut for MutexGuard<'_, T> {
+    fn deref_mut(&mut self) -> &mut T {
+        unsafe { &mut *self.lock.data.get() }
+    }
+}
+
+impl<T> Drop for MutexGuard<'_, T> {
+    fn drop(&mut self) {
+        self.lock.locked.store(false, Ordering::Release);
+    }
+}
+
+/// A spin reader-writer lock, for the shared memory's definition.
+///
+/// Writers are rare (only `memory.grow`), readers are every access to the definition, so this
+/// favours readers and accepts that a writer can be starved by a steady stream of them. A guest
+/// that grows a memory in a tight loop while others read it will make progress slowly; a guest
+/// that does that is already pathological.
+pub struct RwLock<T> {
+    /// `u32::MAX` = a writer holds it, otherwise the number of readers.
+    state: AtomicU32,
+    data: UnsafeCell<T>,
+}
+
+unsafe impl<T: Send> Send for RwLock<T> {}
+unsafe impl<T: Send + Sync> Sync for RwLock<T> {}
+
+pub struct RwLockReadGuard<'a, T> {
+    lock: &'a RwLock<T>,
+}
+pub struct RwLockWriteGuard<'a, T> {
+    lock: &'a RwLock<T>,
+}
+
+impl<T> RwLock<T> {
+    pub const fn new(data: T) -> RwLock<T> {
+        RwLock {
+            state: AtomicU32::new(0),
+            data: UnsafeCell::new(data),
+        }
+    }
+
+    pub fn read(&self) -> RwLockReadGuard<'_, T> {
+        loop {
+            let s = self.state.load(Ordering::Relaxed);
+            if s != u32::MAX
+                && self
+                    .state
+                    .compare_exchange_weak(s, s + 1, Ordering::Acquire, Ordering::Relaxed)
+                    .is_ok()
+            {
+                return RwLockReadGuard { lock: self };
+            }
+            core::hint::spin_loop();
+        }
+    }
+
+    pub fn write(&self) -> RwLockWriteGuard<'_, T> {
+        while self
+            .state
+            .compare_exchange_weak(0, u32::MAX, Ordering::Acquire, Ordering::Relaxed)
+            .is_err()
+        {
+            core::hint::spin_loop();
+        }
+        RwLockWriteGuard { lock: self }
+    }
+}
+
+impl<T> Deref for RwLockReadGuard<'_, T> {
+    type Target = T;
+    fn deref(&self) -> &T {
+        unsafe { &*self.lock.data.get() }
+    }
+}
+
+impl<T> Drop for RwLockReadGuard<'_, T> {
+    fn drop(&mut self) {
+        self.lock.state.fetch_sub(1, Ordering::Release);
+    }
+}
+
+impl<T> Deref for RwLockWriteGuard<'_, T> {
+    type Target = T;
+    fn deref(&self) -> &T {
+        unsafe { &*self.lock.data.get() }
+    }
+}
+
+impl<T> DerefMut for RwLockWriteGuard<'_, T> {
+    fn deref_mut(&mut self) -> &mut T {
+        unsafe { &mut *self.lock.data.get() }
+    }
+}
+
+impl<T> Drop for RwLockWriteGuard<'_, T> {
+    fn drop(&mut self) {
+        self.lock.state.store(0, Ordering::Release);
+    }
+}
+
+/// How long a `wait` may still block, or `None` if its deadline has passed.
+#[inline]
+pub fn remaining(deadline: Option<Instant>) -> Option<Duration> {
+    let d = deadline?;
+    Some(d.saturating_duration_since(Instant::now()))
+}
+
+/// The most threads this module can account for. It is the embedder's business to stay under it -
+/// the enclave's host refuses to start with more call-out slots than park semaphores - and going
+/// over is a panic rather than silent corruption.
+pub const MAX_THREADS: usize = 256;
+
+/// What `thread_local!` would give, for a target that has no stable way to say it.
+///
+/// Keyed by the park token, which is unique among LIVE threads. The slot is entered without a lock
+/// because exactly one thread can ever hold a given token, and that is the same argument
+/// thread-local storage makes.
+///
+/// Tokens ARE recycled - a thread that exits gives its token back, and the enclave would otherwise
+/// die on the 97th thread of its life even if they ran one at a time. So each slot records the
+/// EPOCH it was filled under, and a slot from an earlier incarnation is discarded rather than
+/// inherited. An earlier version of this relied on tokens never being reused; that was both a
+/// stability bug and, once an untrusted host could choose the token, a soundness one.
+pub struct PerThread<T> {
+    slots: [UnsafeCell<Option<(u64, T)>>; MAX_THREADS],
+}
+
+unsafe impl<T: Send> Sync for PerThread<T> {}
+
+impl<T> PerThread<T> {
+    pub const fn new() -> PerThread<T> {
+        PerThread {
+            slots: [const { UnsafeCell::new(None) }; MAX_THREADS],
+        }
+    }
+
+    /// Run `f` on this thread's value, creating it with `init` the first time - and again if the
+    /// token has changed hands since, which is what the epoch detects.
+    ///
+    /// `f` gets a SHARED reference, and this function never forms a `&mut` to the slot's contents.
+    /// That is not a stylistic choice. An earlier version took `&mut` and `LocalKey::with` handed
+    /// out a `&T` derived from it, so a NESTED `with` on the same key made a second exclusive
+    /// reference while the outer shared one was still usable - aliasing undefined behaviour, from
+    /// nothing worse than a re-entrant callback. The declarations that use this wrap their state
+    /// in `Cell`/`RefCell` exactly as they do with `std`'s `thread_local!`, so shared access is
+    /// all they ever needed.
+    pub fn with<R>(&self, init: impl FnOnce() -> T, f: impl FnOnce(&T) -> R) -> R {
+        let i = ThreadToken::current().0 as usize;
+        assert!(
+            i < MAX_THREADS,
+            "park token {i} is past MAX_THREADS: the embedder handed out more threads than this \
+             build accounts for"
+        );
+        let epoch = ThreadToken::epoch();
+        let p = self.slots[i].get();
+        // SAFETY: one thread per token at a time, so no other thread can reach this slot. The
+        // reference below is SHARED; nothing here creates a `&mut`.
+        if let Some((e, v)) = unsafe { &*p } {
+            if *e == epoch {
+                return f(v);
+            }
+        }
+        // (Re)initialise. `init()` runs BEFORE the slot is touched, and the write goes through the
+        // raw pointer rather than a `&mut`, so no exclusive reference is ever created here either.
+        let v = init();
+        // REPLACE, then drop what was there. This is a SEMANTIC choice, not a soundness fix, and
+        // the distinction is worth stating because I first wrote it down as the latter: a plain
+        // `*p = ...` drops the old value BEFORE installing the new one, so the slot holds a valid
+        // (not half-written) value throughout, and Miri finds both forms defined. The test below
+        // passes either way.
+        //
+        // What `replace` changes is what a re-entrant access DURING that drop observes - the new,
+        // already-installed value rather than one that is on its way out. A displaced per-thread
+        // value is exactly the sort of thing that has a destructor, and a destructor that reaches
+        // back into its own key should not see a corpse.
+        //
+        // SAFETY: no reference into this slot is live at this point - the fast path above
+        // returned, and `f` has not been called.
+        let displaced = unsafe { core::ptr::replace(p, Some((epoch, v))) };
+        drop(displaced);
+        // SAFETY: just written; shared again.
+        match unsafe { &*p } {
+            Some((_, v)) => f(v),
+            None => unreachable!("just initialised"),
+        }
+    }
+}
+
+/// A monotonically increasing counter, for handing out fresh keys without an allocator.
+pub struct Counter(AtomicU64);
+
+impl Counter {
+    pub const fn new() -> Counter {
+        Counter(AtomicU64::new(0))
+    }
+    #[inline]
+    pub fn next(&self) -> u64 {
+        self.0.fetch_add(1, Ordering::Relaxed)
+    }
+}
+
+/// A `std`-shaped view of everything above, so the code that uses it does not have to change.
+///
+/// `parking_spot.rs` and `shared_memory.rs` are upstream files with upstream churn. Rewriting
+/// their every `std::sync::Mutex` and `std::thread::park_timeout` would make every future merge a
+/// conflict for no gain, so instead they say
+///
+/// ```ignore
+/// #[cfg(not(feature = "std"))]
+/// use crate::runtime::vm::nostd_threads::shim as std;
+/// ```
+///
+/// and their existing `use std::...` lines resolve here. The names and signatures below therefore
+/// match `std`'s deliberately, including `Mutex::lock` returning a `Result` that is always `Ok` -
+/// a lock that cannot be poisoned still has to be *spelled* like one that can.
+pub mod shim {
+    pub mod sync {
+        pub use alloc::sync::Arc;
+        pub use core::sync::atomic;
+
+        /// `std::sync::Mutex`'s shape over the spin lock above.
+        pub struct Mutex<T>(super::super::Mutex<T>);
+
+        impl<T> Mutex<T> {
+            pub const fn new(t: T) -> Mutex<T> {
+                Mutex(super::super::Mutex::new(t))
+            }
+            /// Always `Ok`: there is no poisoning without unwinding, and this target aborts.
+            pub fn lock(
+                &self,
+            ) -> Result<super::super::MutexGuard<'_, T>, PoisonError<super::super::MutexGuard<'_, T>>>
+            {
+                Ok(self.0.lock())
+            }
+        }
+
+        impl<T> core::fmt::Debug for Mutex<T> {
+            fn fmt(&self, f: &mut core::fmt::Formatter<'_>) -> core::fmt::Result {
+                f.write_str("Mutex { .. }")
+            }
+        }
+
+        impl<T: Default> Default for Mutex<T> {
+            fn default() -> Mutex<T> {
+                Mutex::new(T::default())
+            }
+        }
+
+        /// The error `lock()` never returns, present so callers may name it - and so the
+        /// `unwrap_or_else(|e| e.into_inner())` idiom, which is how careful code handles poisoning
+        /// it cannot do anything about, still compiles.
+        pub struct PoisonError<T>(T);
+
+        impl<T> PoisonError<T> {
+            pub fn into_inner(self) -> T {
+                self.0
+            }
+        }
+
+        impl<T> core::fmt::Debug for PoisonError<T> {
+            fn fmt(&self, f: &mut core::fmt::Formatter<'_>) -> core::fmt::Result {
+                f.write_str("PoisonError")
+            }
+        }
+
+        /// `std::sync::RwLock`'s shape over the spin reader-writer lock above.
+        pub struct RwLock<T>(super::super::RwLock<T>);
+
+        impl<T> RwLock<T> {
+            pub const fn new(t: T) -> RwLock<T> {
+                RwLock(super::super::RwLock::new(t))
+            }
+            pub fn read(
+                &self,
+            ) -> Result<
+                super::super::RwLockReadGuard<'_, T>,
+                PoisonError<super::super::RwLockReadGuard<'_, T>>,
+            > {
+                Ok(self.0.read())
+            }
+            pub fn write(
+                &self,
+            ) -> Result<
+                super::super::RwLockWriteGuard<'_, T>,
+                PoisonError<super::super::RwLockWriteGuard<'_, T>>,
+            > {
+                Ok(self.0.write())
+            }
+        }
+
+        impl<T> core::fmt::Debug for RwLock<T> {
+            fn fmt(&self, f: &mut core::fmt::Formatter<'_>) -> core::fmt::Result {
+                f.write_str("RwLock { .. }")
+            }
+        }
+
+        impl<T: Default> Default for RwLock<T> {
+            fn default() -> RwLock<T> {
+                RwLock::new(T::default())
+            }
+        }
+
+        /// `std::sync::OnceLock`, spin-initialised. The initialiser may run on more than one
+        /// thread under contention; the first value to be stored wins and the others are dropped,
+        /// which is `OnceLock`'s contract too.
+        pub struct OnceLock<T> {
+            state: atomic::AtomicU8,
+            value: core::cell::UnsafeCell<Option<T>>,
+        }
+
+        unsafe impl<T: Send + Sync> Sync for OnceLock<T> {}
+        unsafe impl<T: Send> Send for OnceLock<T> {}
+
+        const ONCE_EMPTY: u8 = 0;
+        const ONCE_BUSY: u8 = 1;
+        const ONCE_READY: u8 = 2;
+
+        impl<T> OnceLock<T> {
+            pub const fn new() -> OnceLock<T> {
+                OnceLock {
+                    state: atomic::AtomicU8::new(ONCE_EMPTY),
+                    value: core::cell::UnsafeCell::new(None),
+                }
+            }
+
+            pub fn get(&self) -> Option<&T> {
+                if self.state.load(atomic::Ordering::Acquire) != ONCE_READY {
+                    return None;
+                }
+                // SAFETY: READY is only published after the value is written, with a Release.
+                unsafe { (*self.value.get()).as_ref() }
+            }
+
+            /// `Err(value)` when it was already initialised, as `std`'s is.
+            pub fn set(&self, value: T) -> Result<(), T> {
+                if self
+                    .state
+                    .compare_exchange(
+                        ONCE_EMPTY,
+                        ONCE_BUSY,
+                        atomic::Ordering::Acquire,
+                        atomic::Ordering::Acquire,
+                    )
+                    .is_err()
+                {
+                    return Err(value);
+                }
+                // SAFETY: BUSY is exclusive.
+                unsafe { *self.value.get() = Some(value) };
+                self.state.store(ONCE_READY, atomic::Ordering::Release);
+                Ok(())
+            }
+
+            pub fn get_or_init(&self, f: impl FnOnce() -> T) -> &T {
+                if let Some(v) = self.get() {
+                    return v;
+                }
+                let v = f();
+                if self
+                    .state
+                    .compare_exchange(
+                        ONCE_EMPTY,
+                        ONCE_BUSY,
+                        atomic::Ordering::Acquire,
+                        atomic::Ordering::Acquire,
+                    )
+                    .is_ok()
+                {
+                    // SAFETY: BUSY is exclusive - exactly one thread wins the exchange.
+                    unsafe { *self.value.get() = Some(v) };
+                    self.state.store(ONCE_READY, atomic::Ordering::Release);
+                } else {
+                    // Somebody else is initialising or has: drop ours and wait for theirs.
+                    drop(v);
+                    while self.state.load(atomic::Ordering::Acquire) != ONCE_READY {
+                        core::hint::spin_loop();
+                    }
+                }
+                self.get().unwrap()
+            }
+        }
+
+        impl<T> core::fmt::Debug for OnceLock<T> {
+            fn fmt(&self, f: &mut core::fmt::Formatter<'_>) -> core::fmt::Result {
+                f.write_str("OnceLock { .. }")
+            }
+        }
+
+        impl<T> Default for OnceLock<T> {
+            fn default() -> OnceLock<T> {
+                OnceLock::new()
+            }
+        }
+    }
+
+    pub mod time {
