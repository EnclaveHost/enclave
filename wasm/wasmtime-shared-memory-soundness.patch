+    fn atomic_beside_ordinary_accesses_is_defined() {
+        let iters = SCALE / 2;
+        with_mem(|m| {
+            unsafe { race_write(m.at::<u64>(64), 0u64) };
+            std::thread::scope(|s| {
+                s.spawn(move || {
