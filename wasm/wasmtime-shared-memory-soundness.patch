+            #[inline] fn fetch_xor(&self, val: $t, _: Ordering) -> $t { self.rmw(|x| x ^ val) }
+
+            /// The signature `AtomicUN::fetch_update` has. The closure cannot decline here - the
+            /// callers below always return `Some` - but the shape is kept so their code is
+            /// unchanged and so a future caller that does decline still behaves.
+            #[inline]
+            fn fetch_update(
+                &self,
+                _: Ordering,
+                _: Ordering,
+                mut f: impl FnMut($t) -> Option<$t>,
+            ) -> Result<$t, $t> {
