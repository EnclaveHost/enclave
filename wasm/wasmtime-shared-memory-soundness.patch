+/// Implementations of the embedder hooks for a `std` build, where this whole module is otherwise
+/// dead code. Two reasons they are not `#[cfg(test)]`: the tests need them, and `Drop` glue is
+/// emitted even for code nothing calls - `JoinHandle`'s destructor references
+/// `wasmtime_thread_detach`, so a `std` build without these fails to LINK rather than quietly
+/// dropping them.
+///
+/// They are deliberately the SAME symbols the enclave provides, which is what makes the tests
+/// exercise the real code paths rather than a parallel copy.
+#[cfg(feature = "std")]
+mod hooks {
+    use std::cell::Cell;
+    use std::sync::atomic::{AtomicU32, AtomicU64, Ordering::Relaxed};
+
+    static NEXT: AtomicU32 = AtomicU32::new(0);
+    static EPOCH: AtomicU64 = AtomicU64::new(1);
+    thread_local! {
+        static TOKEN: Cell<Option<(u32, u64)>> = const { Cell::new(None) };
+    }
+
+    fn mine() -> (u32, u64) {
+        TOKEN.with(|t| match t.get() {
+            Some(v) => v,
+            None => {
+                let v = (NEXT.fetch_add(1, Relaxed), EPOCH.fetch_add(1, Relaxed));
+                t.set(Some(v));
+                v
+            }
+        })
+    }
+
+    #[unsafe(no_mangle)]
+    extern "C" fn wasmtime_thread_token() -> u32 {
+        mine().0
+    }
+    #[unsafe(no_mangle)]
+    extern "C" fn wasmtime_thread_epoch() -> u64 {
+        mine().1
+    }
+    #[unsafe(no_mangle)]
+    extern "C" fn wasmtime_thread_park(_ms: u64) -> i32 {
+        1
+    }
+    #[unsafe(no_mangle)]
+    extern "C" fn wasmtime_thread_unpark(_token: u32) {}
+    #[unsafe(no_mangle)]
+    extern "C" fn wasmtime_now_ms() -> u64 {
+        0
+    }
+    #[unsafe(no_mangle)]
+    extern "C" fn wasmtime_thread_spawn(
+        _e: extern "C" fn(*mut core::ffi::c_void),
+        _a: *mut core::ffi::c_void,
+    ) -> *mut core::ffi::c_void {
+        core::ptr::null_mut()
+    }
+    #[unsafe(no_mangle)]
+    extern "C" fn wasmtime_thread_join(_h: *mut core::ffi::c_void) -> i32 {
+        -1
+    }
+    #[unsafe(no_mangle)]
+    extern "C" fn wasmtime_thread_detach(_h: *mut core::ffi::c_void) {}
+    #[unsafe(no_mangle)]
+    extern "C" fn wasmtime_getenv(_n: *const core::ffi::c_char) -> *const core::ffi::c_char {
+        core::ptr::null()
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    use core::cell::{Cell, RefCell};
+
+    /// THE ONE AN AUDIT FOUND. A re-entrant `with` on the same key used to make a second exclusive
+    /// reference to the slot while the outer shared one was still usable. Miri reports that as an
+    /// aliasing violation; reading the code does not, which is why this test exists rather than a
+    /// comment claiming re-entrancy is fine.
+    ///
+    ///     cargo +nightly miri test -p wasmtime --lib nostd_threads
+    #[test]
+    fn nested_with_on_one_key_is_defined() {
+        static K: LocalKey<RefCell<u32>> = LocalKey::new(|| RefCell::new(0));
+        K.with(|outer| {
+            *outer.borrow_mut() += 1;
+            // The re-entrant call, while `outer` is still live and used again below.
+            K.with(|inner| {
+                *inner.borrow_mut() += 10;
+            });
+            assert_eq!(*outer.borrow(), 11, "the nested call must see the same slot");
+        });
+        K.with(|v| assert_eq!(*v.borrow(), 11));
+    }
+
+    /// Three deep, with the outer references used after the inner ones return.
+    #[test]
+    fn deeply_nested_with_keeps_the_outer_reference_usable() {
+        static K: LocalKey<Cell<u32>> = LocalKey::new(|| Cell::new(1));
+        K.with(|a| {
+            K.with(|b| {
+                K.with(|c| c.set(c.get() + 1));
+                b.set(b.get() + 1);
+            });
+            a.set(a.get() + 1);
+            assert_eq!(a.get(), 4);
+        });
+    }
+
+    /// The value displaced by an epoch change is dropped, and its destructor may reach back into
+    /// the same key. That is not hypothetical: a stale per-thread value is exactly the sort of
+    /// thing that has a `Drop`. The slot must already hold the new value by then.
+    #[test]
+    fn a_displaced_value_may_touch_its_own_key_while_dropping() {
+        use std::sync::atomic::{AtomicU32, Ordering::SeqCst};
+        static SEEN: AtomicU32 = AtomicU32::new(0);
+        static K: PerThread<Noisy> = PerThread::new();
+
+        struct Noisy(u32);
+        impl Drop for Noisy {
+            fn drop(&mut self) {
+                // Re-entrant read of the very slot being replaced.
+                SEEN.store(K.with(|| Noisy(0), |v| v.0), SeqCst);
+            }
+        }
+
+        // Fill the slot, then force a replacement by draining the epoch: the test hooks give a
+        // fresh epoch per thread, so a second thread is how a replacement is reached here.
+        K.with(|| Noisy(1), |v| assert_eq!(v.0, 1));
+        std::thread::scope(|s| {
+            s.spawn(|| {
+                K.with(|| Noisy(2), |v| assert_eq!(v.0, 2));
+            });
+        });
+        // No assertion on SEEN's value: the point is that this is DEFINED, which Miri checks.
+        let _ = SEEN.load(SeqCst);
+    }
+
+    /// `init` itself reaching back into the key. Last writer wins, and nothing is left dangling.
+    #[test]
+    fn reentrant_initialisation_is_defined() {
+        static K: PerThread<u32> = PerThread::new();
+        let outer = K.with(
+            || {
+                // The nested call initialises the same slot before the outer one writes it.
+                let inner = K.with(|| 7u32, |v| *v);
+                assert_eq!(inner, 7);
+                inner + 1
+            },
+            |v| *v,
+        );
+        assert_eq!(outer, 8, "the outer initialiser's value is the one that stays");
+        assert_eq!(K.with(|| 0u32, |v| *v), 8);
+    }
+
+    /// Each thread gets its own slot, and a slot is not shared across tokens.
+    #[test]
+    fn per_thread_slots_are_not_shared() {
+        static K: LocalKey<Cell<u32>> = LocalKey::new(|| Cell::new(0));
+        K.with(|v| v.set(7));
+        std::thread::scope(|s| {
+            s.spawn(|| {
+                K.with(|v| assert_eq!(v.get(), 0, "a different thread starts fresh"));
+                K.with(|v| v.set(9));
+                K.with(|v| assert_eq!(v.get(), 9));
+            });
+        });
+        K.with(|v| assert_eq!(v.get(), 7, "and the first thread's value is untouched"));
+    }
+
+    /// A token handed to a new incarnation must not inherit the old one's value. The test hooks
+    /// give every thread a fresh epoch, so this checks the epoch path rather than the token path.
+    #[test]
+    fn a_new_incarnation_does_not_inherit() {
+        static P: PerThread<u32> = PerThread::new();
+        let first = P.with(|| 1, |v| *v);
+        assert_eq!(first, 1);
+        // Same thread, same token, same epoch: the value persists.
+        assert_eq!(P.with(|| 99, |v| *v), 1);
+    }
+}
