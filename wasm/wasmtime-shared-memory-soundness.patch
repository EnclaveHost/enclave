+//! The blocking and timing primitives the threads proposal needs, for a target with no `std`.
+//!
+//! # Why this exists
+//!
+//! `threads = ["std"]` in wasmtime's manifest, and everything behind it assumes an OS: the shared
+//! memory's `RwLock`, the parking spot's `Mutex` and `std::thread::park`, and `Instant`. A VBS
+//! enclave has none of those. It has no scheduler at all - an enclave "thread" is a host thread
+//! that called in - so the one thing that cannot be emulated in here is BLOCKING, and blocking is
+//! exactly what `memory.atomic.wait` is.
+//!
+//! # The shape
+//!
+//! Four hooks the embedder provides. Everything else in this module is built on them in plain
+//! `core` + `alloc`, so the only enclave-specific code is four C functions.
+//!
+//! Spinning instead of blocking is not an option for `atomic.wait`: a guest may wait indefinitely,
+//! and a spinning enclave thread holds a core for as long as it does. The short spins in the locks
+//! below are a different matter - they guard a handful of instructions, never a guest's wait.
+//!
+//! # The park contract
+//!
+//! `park` takes a PERMIT, and `unpark` leaves one. A permit released before its park is remembered
+//! rather than lost, which is what makes the classic register-then-block race harmless: the wait
+//! queue lives in here where the embedder cannot see it, so the embedder has no condition to
+//! re-check and a bare wakeup signal would race registration every time. This is exactly
+//! `std::thread::park`/`unpark`'s contract, and it is deliberate that it matches.
+#![cfg_attr(feature = "std", allow(dead_code))]
+
+use core::cell::UnsafeCell;
+use core::ops::{Deref, DerefMut};
+use core::sync::atomic::{AtomicBool, AtomicU32, AtomicU64, Ordering};
+use core::time::Duration;
+
+unsafe extern "C" {
+    /// Block this thread until a permit is available or `timeout_ms` elapses (0 = forever).
+    /// Returns 0 when a permit was taken, 1 on timeout, negative on failure.
+    fn wasmtime_thread_park(timeout_ms: u64) -> i32;
+    /// Leave a permit for `token`, waking it if it is parked. Safe when it is not parked.
+    fn wasmtime_thread_unpark(token: u32);
+    /// This thread's park token, stable for the life of the thread and unique among live threads.
+    ///
+    /// It must come from state the EMBEDDER controls and an untrusted party cannot write. On a
+    /// VBS enclave the call-out header lives in host memory, so the number in it is the host's to
+    /// change; reading identity from there would let the host rename a thread or give two live
+    /// threads the same name, and [`PerThread`] hands out unsynchronised `&mut` on the strength of
+    /// that name being unique.
+    fn wasmtime_thread_token() -> u32;
+    /// The incarnation of this thread's token, which MUST change whenever a token is handed to a
+    /// different thread. A token is a small index and is reused when its thread exits; without
+    /// this, per-thread state cached under the index would be inherited by the next thread to get
+    /// it.
+    fn wasmtime_thread_epoch() -> u64;
+    /// A monotonic clock in milliseconds. Need not be wall-clock, only monotonic.
+    fn wasmtime_now_ms() -> u64;
+    /// Start a thread running `entry(arg)`. Returns an opaque handle, or null on failure.
+    fn wasmtime_thread_spawn(entry: extern "C" fn(*mut core::ffi::c_void), arg: *mut core::ffi::c_void) -> *mut core::ffi::c_void;
+    /// Block until that thread's body returns, then release the handle. 0 on success.
+    fn wasmtime_thread_join(handle: *mut core::ffi::c_void) -> i32;
+    /// Release the handle without waiting.
+    fn wasmtime_thread_detach(handle: *mut core::ffi::c_void);
+    /// Look up an environment variable by NUL-terminated name. Returns a NUL-terminated value
+    /// owned by the embedder and valid for the life of the process, or null when unset.
+    fn wasmtime_getenv(name: *const core::ffi::c_char) -> *const core::ffi::c_char;
+}
+
+/// `std::thread::spawn`'s shape over the embedder's threads.
+///
+/// The closure is boxed and handed across the FFI boundary as a raw pointer; the trampoline owns
+/// it from there. `'static` and `Send` are required for the usual reason, and are the same bounds
+/// `std::thread::spawn` asks for.
+pub fn spawn<F: FnOnce() + Send + 'static>(f: F) -> Result<JoinHandle, SpawnError> {
+    extern "C" fn tramp(arg: *mut core::ffi::c_void) {
+        // SAFETY: `arg` is the box `spawn` leaked, and this runs exactly once for it.
+        let f: alloc::boxed::Box<alloc::boxed::Box<dyn FnOnce() + Send>> =
+            unsafe { alloc::boxed::Box::from_raw(arg.cast()) };
+        f();
+    }
+    let boxed: alloc::boxed::Box<dyn FnOnce() + Send> = alloc::boxed::Box::new(f);
+    let arg = alloc::boxed::Box::into_raw(alloc::boxed::Box::new(boxed)).cast();
+    let handle = unsafe { wasmtime_thread_spawn(tramp, arg) };
+    if handle.is_null() {
+        // The embedder refused: take the closure back so it is dropped rather than leaked.
+        drop(unsafe {
+            alloc::boxed::Box::from_raw(arg.cast::<alloc::boxed::Box<dyn FnOnce() + Send>>())
+        });
+        return Err(SpawnError);
+    }
+    Ok(JoinHandle(handle))
+}
+
+/// The embedder would not start a thread - out of slots, or out of memory.
+#[derive(Debug)]
+pub struct SpawnError;
+
+/// `std::thread::JoinHandle`'s shape. Dropping it DETACHES, as `std`'s does.
+pub struct JoinHandle(*mut core::ffi::c_void);
+
+unsafe impl Send for JoinHandle {}
+unsafe impl Sync for JoinHandle {}
+
+impl JoinHandle {
+    /// Block until the thread's body returns.
+    pub fn join(mut self) -> Result<(), SpawnError> {
+        let h = core::mem::replace(&mut self.0, core::ptr::null_mut());
+        core::mem::forget(self);
+        if unsafe { wasmtime_thread_join(h) } == 0 {
+            Ok(())
+        } else {
+            Err(SpawnError)
+        }
+    }
+}
+
+impl Drop for JoinHandle {
+    fn drop(&mut self) {
+        if !self.0.is_null() {
+            unsafe { wasmtime_thread_detach(self.0) }
+        }
+    }
+}
+
+/// A thread's identity, as far as this module is concerned: the token to unpark it by.
+///
+/// This replaces `std::thread::Thread`, and it is a `u32` rather than a handle for a reason - it
+/// is also the index of that thread's slot in the tables that used to be `thread_local!`, which
+/// `no_std` has no stable way to express.
+#[derive(Clone, Copy, PartialEq, Eq, Debug)]
+pub struct ThreadToken(pub u32);
+
+impl ThreadToken {
+    #[inline]
+    pub fn current() -> ThreadToken {
+        ThreadToken(unsafe { wasmtime_thread_token() })
+    }
+
+    #[inline]
+    pub fn unpark(self) {
+        unsafe { wasmtime_thread_unpark(self.0) }
+    }
+
+    /// This thread's incarnation; see `wasmtime_thread_epoch`.
+    #[inline]
+    pub fn epoch() -> u64 {
+        unsafe { wasmtime_thread_epoch() }
+    }
+}
+
+/// Park until a permit arrives. See the module docs for why this is a permit.
+#[inline]
+pub fn park() {
+    let _ = unsafe { wasmtime_thread_park(0) };
+}
+
+/// Park until a permit arrives or `dur` elapses.
+#[inline]
+pub fn park_timeout(dur: Duration) {
+    // Round UP, and never to zero: a zero timeout means "forever" to the hook, and a sub-
+    // millisecond wait that became an infinite one would be a hang rather than a slow test.
+    let ms = dur.as_millis().min(u128::from(u64::MAX - 1)) as u64;
+    let _ = unsafe { wasmtime_thread_park(ms.max(1)) };
+}
+
+/// A monotonic instant, in milliseconds since whatever the embedder counts from.
+///
+/// Millisecond resolution is coarse for a clock but not for what it is used for here: the deadline
+/// of a guest's `memory.atomic.wait`, which the spec gives in nanoseconds and every implementation
+/// rounds.
+#[derive(Clone, Copy, PartialEq, Eq, PartialOrd, Ord, Debug)]
+pub struct Instant(u64);
+
+impl Instant {
+    #[inline]
+    pub fn now() -> Instant {
+        Instant(unsafe { wasmtime_now_ms() })
+    }
+
+    #[inline]
+    pub fn checked_add(&self, dur: Duration) -> Option<Instant> {
+        let ms = u64::try_from(dur.as_millis()).ok()?;
+        self.0.checked_add(ms).map(Instant)
+    }
+
+    /// `None` once the deadline has passed.
+    #[inline]
+    pub fn checked_duration_since(&self, earlier: Instant) -> Option<Duration> {
+        self.0
+            .checked_sub(earlier.0)
+            .map(Duration::from_millis)
+    }
+
+    /// How long since this instant.
+    #[inline]
+    pub fn elapsed(&self) -> Duration {
+        Instant::now().saturating_duration_since(*self)
+    }
+
+    /// Saturating, unlike `std`'s, which panics when `earlier` is later. A monotonic clock cannot
+    /// produce that, and a panic in an enclave has nowhere to go.
+    #[inline]
+    pub fn duration_since(&self, earlier: Instant) -> Duration {
+        self.saturating_duration_since(earlier)
+    }
+
+    #[inline]
+    pub fn saturating_duration_since(&self, earlier: Instant) -> Duration {
+        Duration::from_millis(self.0.saturating_sub(earlier.0))
+    }
+}
+
+/// `later - earlier`, saturating at zero rather than panicking as `std`'s does. A clock that only
+/// moves forward cannot produce a negative interval, and a panic in an enclave has nowhere to go.
+impl core::ops::Sub for Instant {
+    type Output = Duration;
+    fn sub(self, earlier: Instant) -> Duration {
+        self.saturating_duration_since(earlier)
+    }
+}
+
+impl core::ops::Add<Duration> for Instant {
+    type Output = Instant;
+    fn add(self, dur: Duration) -> Instant {
+        self.checked_add(dur).expect("instant overflowed")
+    }
+}
