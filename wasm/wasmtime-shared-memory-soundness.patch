+/// STRIPED LOCKS: what gives the wasm atomic instructions their atomicity now that every ordinary
+/// access is byte-wise.
+///
+/// [`race_read`] explains why one byte is the only width at which two accesses to the same address
+/// can never disagree about their size. That rule applies to the atomic instructions too: an
+/// `AtomicU32` RMW beside a byte-wise ordinary store to the same word is exactly the mixed-size
+/// overlap Rust's model forbids, so the hardware's lock-free RMW is not available here.
+///
+/// So atomicity comes from mutual exclusion instead. An atomic instruction takes a lock, moves its
+/// bytes through the same byte-wise relaxed accesses everything else uses, and releases it. The
+/// locks are STRIPED by 8-byte block of the HOST address: a wasm atomic is aligned (the frontend
+/// emits an explicit alignment check and traps before reaching here) and at most 8 bytes wide, so
+/// it lies inside one block and one stripe suffices. Two overlapping atomics always hash to the
+/// same stripe, which is the property that matters; two disjoint ones sometimes do, which only
+/// costs contention.
+///
+/// What this does NOT lock against is an ordinary access racing an atomic one. That is deliberate
+/// and is what the wasm memory model asks for: such a race is a race, and the ordinary side may
+/// read a torn value. Making ordinary accesses take the lock would be both far slower and wrong.
+///
+/// Ordering: the guard is Acquire/Release, and a SeqCst fence at each end lifts the critical
+/// section to the sequential consistency the wasm atomics specify.
+const SHARED_STRIPES: usize = 1024;
+static SHARED_LOCKS: [core::sync::atomic::AtomicBool; SHARED_STRIPES] =
+    [const { core::sync::atomic::AtomicBool::new(false) }; SHARED_STRIPES];
+
+struct SharedGuard(usize);
+
+impl Drop for SharedGuard {
+    fn drop(&mut self) {
+        core::sync::atomic::fence(Ordering::SeqCst);
+        SHARED_LOCKS[self.0].store(false, Ordering::Release);
+    }
+}
+
+/// Take the stripe covering `addr`. `addr` is a host address, so unrelated memories cannot collide
+/// by having the same guest offset.
+#[inline]
+fn shared_lock(addr: usize) -> SharedGuard {
+    // Mix the block index: guest allocations are page-aligned and access patterns are strided, so
+    // the low bits alone would pile every hot address onto a handful of stripes.
+    let block = (addr >> 3) as u64;
+    let i = (block.wrapping_mul(0x9E3779B97F4A7C15) >> 32) as usize % SHARED_STRIPES;
+    while SHARED_LOCKS[i]
+        .compare_exchange_weak(false, true, Ordering::Acquire, Ordering::Relaxed)
+        .is_err()
+    {
+        core::hint::spin_loop();
+    }
+    core::sync::atomic::fence(Ordering::SeqCst);
+    SharedGuard(i)
+}
