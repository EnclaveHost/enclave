+
+/// Copy a validated UTF-8 snapshot without making Rust references to guest
+/// memory, which a SET worker may mutate concurrently. Generated FACT code
+/// has already bounds-checked both regions and shared memory never relocates.
+/// Using the same path for owned memories keeps the helper independent of
+/// memory metadata and prevents a caller from selecting an unsafe variant.
+unsafe fn copy_utf8_snapshot(src: *mut u8, len: usize, dst: *mut u8) -> Result<()> {
+    use core::sync::atomic::{AtomicU8, Ordering};
+    let src_end = (src as usize).checked_add(len).ok_or_else(|| format_err!("source range overflow"))?;
+    let dst_end = (dst as usize).checked_add(len).ok_or_else(|| format_err!("destination range overflow"))?;
+    ensure!(src_end <= dst as usize || dst_end <= src as usize, "overlapping string regions");
+    let mut snapshot = Vec::new();
+    snapshot.try_reserve_exact(len).map_err(|_| format_err!("UTF-8 snapshot allocation failed"))?;
+    for i in 0..len {
+        snapshot.push(unsafe { AtomicU8::from_ptr(src.add(i)).load(Ordering::Relaxed) });
+    }
+    core::str::from_utf8(&snapshot).map_err(|_| format_err!("invalid utf8 encoding"))?;
+    for (i, byte) in snapshot.into_iter().enumerate() {
+        unsafe { AtomicU8::from_ptr(dst.add(i)).store(byte, Ordering::Relaxed) };
+    }
     Ok(())
 }
 
