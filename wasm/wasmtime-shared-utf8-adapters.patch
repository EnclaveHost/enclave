+#[cfg(test)]
+mod shared_utf8_tests {
+    use super::copy_utf8_snapshot;
+    use core::sync::atomic::{AtomicU8, Ordering};
+
+    #[test]
+    fn shared_utf8_validates_before_publishing() {
+        let mut src = "Doom — 音楽".as_bytes().to_vec();
+        let mut dst = vec![0; src.len()];
+        unsafe { copy_utf8_snapshot(src.as_mut_ptr(), src.len(), dst.as_mut_ptr()) }.unwrap();
+        assert_eq!(src, dst);
+        src[0] = 0xff;
+        let before = dst.clone();
+        assert!(unsafe { copy_utf8_snapshot(src.as_mut_ptr(), src.len(), dst.as_mut_ptr()) }.is_err());
+        assert_eq!(dst, before);
+    }
+
+    #[test]
+    fn shared_utf8_racing_source_never_publishes_invalid_text() {
+        let source = [AtomicU8::new(b'A'), AtomicU8::new(b'B')];
+        std::thread::scope(|scope| {
+            scope.spawn(|| {
+                for i in 0..100_000 {
+                    source[0].store(if i % 2 == 0 { b'A' } else { 0xff }, Ordering::Relaxed);
+                }
+            });
+            let mut dst = [0u8; 2];
+            for _ in 0..1_000 {
+                let result = unsafe { copy_utf8_snapshot(source[0].as_ptr(), 2, dst.as_mut_ptr()) };
+                if result.is_ok() {
+                    assert!(core::str::from_utf8(&dst).is_ok());
+                    assert_eq!(dst[1], b'B');
+                }
+            }
+        });
+    }
+}
