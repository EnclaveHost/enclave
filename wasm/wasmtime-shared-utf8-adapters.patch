+#[test]
+fn shared_utf8_roundtrip_and_encoding_guard() -> Result<()> {
+    let mut config = Config::new();
+    config.wasm_component_model(true);
+    config.wasm_component_model_threading(true);
+    config.wasm_shared_everything_threads(true);
+    config.wasm_threads(true);
+    config.shared_memory(true);
+    for debug in [false, true] {
+        config.debug_adapter_modules(debug);
+        let engine = Engine::new(&config)?;
+        test_roundtrip(&engine, "utf8", "utf8", true)?;
+        for (src, dst) in [("utf8", "utf16"), ("utf16", "utf8"), ("latin1+utf16", "utf8")] {
+            let error = test_roundtrip(&engine, src, dst, true).unwrap_err();
+            assert!(format!("{error:#}").contains("requires UTF-8 on both sides"));
+        }
+    }
+    Ok(())
