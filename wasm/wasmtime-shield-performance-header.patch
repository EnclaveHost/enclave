+// Explicit diagnostic opt-in. Only fixed aggregate integer counters leave the
+// per-app engine; no stderr, model values, prompts, credentials or file contents.
+// Never load an arbitrary library or wait for an in-flight graph.
+#[cfg(target_os = "linux")]
+fn shield_performance_header() -> Option<HeaderValue> {
+    use std::ffi::{c_char, c_int, c_void, CString};
+    #[link(name = "dl")]
+    unsafe extern "C" {
+        fn dlopen(path: *const c_char, flags: c_int) -> *mut c_void;
+        fn dlsym(handle: *mut c_void, name: *const c_char) -> *mut c_void;
+        fn dlclose(handle: *mut c_void) -> c_int;
+    }
+    let root = std::env::var("ENCLAVE_GGML_BACKEND_DIR").ok()?;
+    let path = CString::new(format!("{root}/libggml-shielded.so")).ok()?;
+    unsafe {
+        let handle = dlopen(path.as_ptr(), 2 | 4); // RTLD_NOW | RTLD_NOLOAD
+        if handle.is_null() { return None; }
+        let sym = dlsym(handle, c"ggml_backend_shielded_profile_snapshot".as_ptr());
+        let mut values = [0u64; 24];
+        let ok = if sym.is_null() { false } else {
+            let snapshot: unsafe extern "C" fn(*mut u64, usize) -> c_int = std::mem::transmute(sym);
+            snapshot(values.as_mut_ptr(), values.len()) == 1
+        };
+        dlclose(handle);
+        if !ok || values[0] != 1 { return None; }
+        let text = values.iter().map(u64::to_string).collect::<Vec<_>>().join(",");
+        HeaderValue::from_str(&text).ok()
+    }
+}
+
+#[cfg(target_os = "linux")]
+fn cpu_performance_header() -> Option<HeaderValue> {
+    use std::ffi::{c_char, c_int, c_void, CString};
+    #[link(name = "dl")]
+    unsafe extern "C" {
+        fn dlopen(path: *const c_char, flags: c_int) -> *mut c_void;
+        fn dlsym(handle: *mut c_void, name: *const c_char) -> *mut c_void;
+        fn dlclose(handle: *mut c_void) -> c_int;
+    }
+    let root = std::env::var("ENCLAVE_GGML_BACKEND_DIR").ok()?;
+    let path = CString::new(format!("{root}/libggml-cpu.so")).ok()?;
+    unsafe {
+        let handle = dlopen(path.as_ptr(), 2 | 4); // RTLD_NOW | RTLD_NOLOAD
+        if handle.is_null() { return None; }
+        let sym = dlsym(handle, c"ggml_backend_cpu_profile_snapshot".as_ptr());
+        let mut values = [0u64; 1024];
+        let ok = if sym.is_null() { false } else {
+            let snapshot: unsafe extern "C" fn(*mut u64, usize) -> c_int = std::mem::transmute(sym);
+            snapshot(values.as_mut_ptr(), values.len()) > 0
+        };
+        dlclose(handle);
+        if !ok || values[0] != 1 { return None; }
+        let buckets = usize::try_from(values[1]).ok()?;
+        if buckets > (values.len()-2)/6 { return None; }
+        let mut text = String::from("1");
+        for i in 0..buckets {
+            let row = &values[2+i*6..2+(i+1)*6];
+            if row[0] != 0 {
+                text.push_str(&format!(";{}:{}", i, row.iter().map(u64::to_string).collect::<Vec<_>>().join(":")));
+            }
+        }
+        HeaderValue::from_str(&text).ok()
     }
 }
 
