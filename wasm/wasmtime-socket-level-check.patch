+/// Does the KERNEL consider this socket ready for `flags` right now?
+///
+/// tokio's `try_read`/`try_write`/`poll_*_ready` consult a readiness CACHE
+/// that is only refreshed when the runtime's I/O driver dispatches an
+/// edge-triggered epoll event. A readiness edge consumed at the wrong moment
+/// (an interleaving the sync-mode guest surface makes likely: guest threads
+/// clear readiness from `try_io` EAGAINs concurrently with driver dispatch)
+/// never re-fires — a socket that stays writable generates no new edges — so
+/// the cache can say "not ready" for an arbitrarily long time about a socket
+/// the kernel would happily serve. Measured on risc-box under load: 0.2-1s
+/// collective write stalls locally, 0.5-14s on a contended fleet box.
+///
+/// This is the level-triggered escape hatch: one non-blocking poll(2). Used
+/// only on the paths a sync guest spins on, and only after the cached path
+/// has already said "not ready" — the cache stays the fast path.
+fn kernel_ready(fd: &impl rustix::fd::AsFd, flags: rustix::event::PollFlags) -> bool {
+    use rustix::event::{PollFd, poll};
+    let mut fds = [PollFd::new(fd, flags)];
+    // Zero timeout: a level check, never a wait.
+    match poll(&mut fds, Some(&rustix::time::Timespec::default())) {
+        Ok(n) => n > 0 && !fds[0].revents().is_empty(),
+        Err(_) => false,
+    }
+}
