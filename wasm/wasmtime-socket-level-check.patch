+/// ENCLAVE_SOCKDBG=1 instrumentation: is the tunnel-stall debug on?
+pub(crate) fn sockdbg() -> bool {
+    static ON: std::sync::LazyLock<bool> =
+        std::sync::LazyLock::new(|| std::env::var("ENCLAVE_SOCKDBG").is_ok());
+    if *ON {
+        sockdbg_ticker();
+    }
+    *ON
+}
+
+/// sockdbg: a 10ms heartbeat task on the ambient runtime. A logged gap means
+/// the runtime's workers (and so its I/O + time drivers) went unscheduled for
+/// that long — separating "driver starved" from "readiness cache anomaly".
+fn sockdbg_ticker() {
+    static ONCE: std::sync::Once = std::sync::Once::new();
+    ONCE.call_once(|| {
+        let handle = crate::runtime::spawn(async {
+            let mut last = std::time::Instant::now();
+            loop {
+                tokio::time::sleep(std::time::Duration::from_millis(10)).await;
+                let now = std::time::Instant::now();
+                let gap = now.duration_since(last).as_millis();
+                if gap > 100 {
+                    eprintln!("[sockdbg {}] runtime-tick gap {}ms", now_ms(), gap);
+                }
+                last = now;
+            }
+        });
+        std::mem::forget(handle);
+    });
+}
+
+pub(crate) fn now_ms() -> u128 {
+    std::time::SystemTime::now()
+        .duration_since(std::time::UNIX_EPOCH)
+        .unwrap()
+        .as_millis()
+}
