+/// sockdbg: tracks how long check_write has been returning 0 budget.
+#[derive(Default)]
+struct WDbg {
+    zero_since: Option<std::time::Instant>,
+    last_log: Option<std::time::Instant>,
+}
+impl WDbg {
+    fn note(&mut self, budget: &StreamResult<usize>, variant: &'static str, peer: &str) {
+        let now = std::time::Instant::now();
+        match budget {
+            Ok(0) => {
+                let since = *self.zero_since.get_or_insert(now);
+                let ms = now.duration_since(since).as_millis();
+                if ms < 200 {
+                    return;
+                }
+                if let Some(last) = self.last_log {
+                    if now.duration_since(last).as_millis() < 500 {
+                        return;
+                    }
+                }
+                self.last_log = Some(now);
+                eprintln!(
+                    "[sockdbg {}] check_write=0 for {ms}ms state={variant} peer={peer}",
+                    crate::sockets::now_ms()
+                );
+            }
+            Ok(_) => {
+                if let Some(since) = self.zero_since.take() {
+                    let ms = since.elapsed().as_millis();
+                    if ms >= 200 {
+                        eprintln!(
+                            "[sockdbg {}] write-unblocked after {ms}ms state={variant} peer={peer}",
+                            crate::sockets::now_ms()
+                        );
+                    }
+                }
+                self.last_log = None;
+            }
+            Err(_) => {
+                self.zero_since = None;
+                self.last_log = None;
+            }
+        }
+    }
+}
