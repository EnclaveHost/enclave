{
 "type": "enclave-vbslike-package/1",
 "name": "nucbox-ownguest",
 "version": 1,
 "about": "Everything nucbox-k11 needs to boot OUR guest (the isolation/m3 monitor image) and serve one small app: the OpenHCL IGVM (profile igvm, the target, blocked on the Hyper-V role) and the same monitor image on the WSL kernel under the box's own launcher (profile hcs-dev, runnable today, development only). Built from existing artifacts; no build was run for it. windows/vbslike/pkg/README.md.",
 "owners": {
  "package": "enclave-53",
  "integration": "enclave-d1 (manager, launcher, igvm recipe, every NucBox host action)",
  "guestRuntime": "enclave-5d (isolation/m3, the datapath)",
  "tests": "enclave-99"
 },
 "tier": {
  "name": "T0-hv",
  "hostExcluded": false,
  "snp": false,
  "vmpl": "n/a",
  "attested": false,
  "note": "A Ryzen with no SEV-SNP. The root partition can read every guest's memory and the launcher signs the reports. Nothing served from this package is verified or host-excluded capacity."
 },
 "runtime": {
  "file": "guest/runtime.json",
  "runtimeId": "ccadb38a6779615597f0614311a631c70810916c1bbeb9f5706ee3a637fd90c8"
 },
 "profiles": {
  "hcs-dev": {
   "status": "needs only Virtual Machine Platform and vmcompute: no role, no reboot; check.ps1 reports whether this host has them",
   "boundary": "an HCS child partition: separated from other partitions, NOT from this host; development path only",
   "launcher": "control/vbslike-host.exe",
   "kernel": "guest/wsl-kernel",
   "initrd": "guest/mon.cpio.gz",
   "cmdline": "console=ttyS0 rdinit=/init loglevel=3 report_host=9001"
  },
  "igvm": {
   "status": "needs the Hyper-V role (vmms, root\\virtualization\\v2 with Msvm_VirtualSystemSettingData.FirmwareFile, Get-VM); check.ps1 reports whether this host has it",
   "boundary": "not established: this image has never been loaded (windows/vbslike/evidence/igvm-never-loaded-2026-09-24.md on windows/custom-vbs-like-hyperv)",
   "image": "guest/openhcl-ownguest.bin",
   "launcher": "windows/vbslike/manager/wmi-launcher.mjs (Msvm_VirtualSystemSettingData.FirmwareFile over root\\virtualization\\v2)"
  }
 },
 "console": {
  "expect": [
   "MON boundary tier=t0-hv",
   "MON ready control_port=9000"
  ],
  "source": "enclave-d1, the monitor on an HCS child 2026-09-24"
 },
 "control": {
  "manager": "control/windows/vbslike/manager/main.mjs",
  "fetcher": "control/windows/node/fetch-cid.py"
 },
 "vmWorkerRead": [
  "guest/openhcl-ownguest.bin"
 ],
 "hostChecks": {
  "hcs-dev": {
   "features": {
    "VirtualMachinePlatform": "Enabled"
   },
   "services": {
    "vmcompute": "Running"
   }
  },
  "igvm": {
   "features": {
    "Microsoft-Hyper-V-Hypervisor": "Enabled",
    "Microsoft-Hyper-V-Services": "Enabled",
    "Microsoft-Hyper-V-Management-PowerShell": "Enabled",
    "VirtualMachinePlatform": "Enabled"
   },
   "services": {
    "vmms": "Running"
   },
   "wmi": {
    "namespace": "root\\virtualization\\v2",
    "class": "Msvm_VirtualSystemSettingData",
    "property": "FirmwareFile"
   },
   "commands": [
    "Get-VM"
   ]
  }
 },
