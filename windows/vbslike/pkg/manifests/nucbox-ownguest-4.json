{
 "type": "enclave-vbslike-package/1",
 "name": "nucbox-ownguest",
 "version": 4,
 "about": "Everything nucbox-k11 needs to boot OUR guest (the isolation/m3 monitor image) and serve one small app: the OpenHCL IGVM (profile igvm, the target, blocked on the Hyper-V role) and the same monitor image on the WSL kernel under the box's own launcher (profile hcs-dev, runnable today, development only). Version 4 = version 3 with enclave-d1's manager at f4f10c84 (it creates the VM with -GuestStateIsolationType OpenHCL; ready.mjs) and the launcher rebuilt at 55494efa (/2 bundles load); the Hyper-V registry opt-in is a gating host check. Version 3 = version 2 with enclave-5d's datapath at 09b67414 (route identity from the view's tier; any safe id, the manager owning its ids). Version 2: the guest is enclave-5d's initrd 4610d594 (aef54ff7: /2 run mode, readiness, a launcher-named certificate name) and the IGVM around it; the app's answer is pinned to the byte; the datapath is pinned; the domain's attestation document is judged with enclave-d1's judge-hv. Built from existing artifacts plus igvmfilegen (seconds). windows/vbslike/pkg/README.md.",
 "owners": {
  "package": "enclave-53",
  "integration": "enclave-d1 (manager, launcher, igvm recipe, every NucBox host action)",
  "guestRuntime": "enclave-5d (isolation/m3, the datapath)",
  "tests": "enclave-99"
 },
 "tier": {
  "name": "T0-hv",
  "hostExcluded": false,
  "snp": false,
  "vmpl": "n/a",
  "attested": false,
  "note": "A Ryzen with no SEV-SNP. The root partition can read every guest's memory and the launcher signs the reports. Nothing served from this package is verified or host-excluded capacity."
 },
 "runtime": {
  "file": "guest/runtime.json",
  "runtimeId": "ccadb38a6779615597f0614311a631c70810916c1bbeb9f5706ee3a637fd90c8"
 },
 "profiles": {
  "hcs-dev": {
   "status": "needs only Virtual Machine Platform and vmcompute: no role, no reboot; check.ps1 reports whether this host has them",
   "boundary": "an HCS child partition: separated from other partitions, NOT from this host; development path only",
   "launcher": "control/vbslike-host.exe",
   "kernel": "guest/wsl-kernel",
   "initrd": "guest/mon.cpio.gz",
   "cmdline": "console=ttyS0 rdinit=/init loglevel=3 report_host=9001"
  },
  "igvm": {
   "status": "needs the Hyper-V role (vmms, root\\virtualization\\v2 with Msvm_VirtualSystemSettingData.FirmwareFile, Get-VM) AND the host's AllowFirmwareLoadFromFile opt-in (Steven's decision); check.ps1 reports whether this host has them",
   "boundary": "not established: this image has never been loaded (windows/vbslike/evidence/igvm-never-loaded-2026-09-24.md on windows/custom-vbs-like-hyperv)",
   "image": "guest/openhcl-ownguest.bin",
   "launcher": "windows/vbslike/manager/wmi-launcher.mjs (Msvm_VirtualSystemSettingData.FirmwareFile over root\\virtualization\\v2)",
   "manager": {
    "check": "win/manager-check.mjs",
    "must": "the manager's own start() issues New-VM with -GuestStateIsolationType OpenHCL or TrustedLaunch (checked on a recording host by pkg.mjs verify and by check.ps1)"
   },
   "measured": [
    "A Generation 2 VM created WITHOUT -GuestStateIsolationType accepts the FirmwareFile pin (ModifySystemSettings returnValue 0), reads it back, starts, and boots nothing: the worker never logs an IGVM load and nothing anywhere says why (enclave-d1, nucbox-k11, 2026-09-24).",
    "Created WITH -GuestStateIsolationType OpenHCL or TrustedLaunch, the worker tries, and Worker-Admin event 5142 says: failed to load custom IGVM file because AllowFirmwareLoadFromFile registry key is not set (0x80070032).",
    "IsolationType on Msvm_VirtualSystemSettingData reads EMPTY even for a VM created with an isolation type, so it cannot detect this.",
    "Secure Boot is not a factor: pinned VMs fail identically with it on and off. The manager turns it off, as the upstream guide does, because a guest image may need that."
   ]
  }
 },
 "console": {
  "expect": [
   "MON boundary tier=t0-hv",
   "MON ready control_port=9000"
  ],
  "source": "enclave-d1, the monitor on an HCS child 2026-09-24"
 },
 "control": {
  "manager": "control/windows/vbslike/manager/main.mjs",
  "fetcher": "control/windows/node/fetch-cid.py"
 },
 "vmWorkerRead": [
  "guest/openhcl-ownguest.bin"
 ],
 "hostChecks": {
  "hcs-dev": {
   "features": {
    "VirtualMachinePlatform": "Enabled"
   },
   "services": {
    "vmcompute": "Running"
   }
  },
  "igvm": {
   "features": {
    "Microsoft-Hyper-V-Hypervisor": "Enabled",
    "Microsoft-Hyper-V-Services": "Enabled",
    "Microsoft-Hyper-V-Management-PowerShell": "Enabled",
    "VirtualMachinePlatform": "Enabled"
   },
   "services": {
    "vmms": "Running"
   },
   "wmi": {
    "namespace": "root\\virtualization\\v2",
    "class": "Msvm_VirtualSystemSettingData",
    "property": "FirmwareFile"
   },
   "commands": [
    "Get-VM"
   ],
   "registry": [
    {
     "path": "HKLM:\\SOFTWARE\\Microsoft\\Windows NT\\CurrentVersion\\Virtualization",
     "name": "AllowFirmwareLoadFromFile",
     "value": 1,
     "why": "Hyper-V names it (Worker-Admin 5142, 0x80070032). Setting it lets Hyper-V load unsigned firmware from a file for any VM on this host: Steven's decision; no script here sets it"
    }
   ]
  }
 },
