 ],
 "slots": [
  {
   "role": "control.datapath",
   "owner": "enclave-5d",
   "state": "pinned",
   "for": "serving on the igvm profile: enclave-splice/1 to one partition's domain. Pinned, and imported by NOTHING on the box yet (the manager has no datapath client). On hcs-dev the box's launcher loads and relays itself."
  }
 ],
